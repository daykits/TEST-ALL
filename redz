ChestBP = t1.Main:AddToggle({
	Name = "Auto Chest Bypass",
	Description = "",
	Default = false,
	Callback = function(p9)
		_G.AutoChestBP = p9

		if p9 then
			local LocalPlayer = game:GetService("Players").LocalPlayer
			local u37 = false
			local t3 = {}
			local u39 = true

			local function v40()
				if not LocalPlayer.Character then
					LocalPlayer.CharacterAdded:Wait()
				end

				LocalPlayer.Character:WaitForChild("HumanoidRootPart")

				return LocalPlayer.Character
			end
			local function v41()
				if u39 then
					u39 = false

					for _, descendant in pairs(game:GetDescendants()) do
						if descendant.Name:find("Chest") and descendant.ClassName == "Part" then
							table.insert(t3, descendant)
						end
					end
				end

				local t4 = {}

				for _, v in pairs(t3) do
					if v:FindFirstChild("TouchInterest") then
						table.insert(t4, v)
					end
				end

				local LowerTorso = v40().LowerTorso

				table.sort(t4, function(p10, p11)
					return (LowerTorso.Position - p10.Position).Magnitude < (LowerTorso.Position - p11.Position).Magnitude
				end)

				return t4
			end
			local function v48()
				if u37 then
					return
				end

				u37 = true
				task.spawn(function()
					while _G.AutoChestBP and LocalPlayer.Character and LocalPlayer.Character.Parent do
						local v49 = v41()

						if #v49 > 0 then
							v40().HumanoidRootPart.CFrame = v49[1].CFrame
						end

						task.wait(0.1)
					end

					u37 = false
				end)
			end

			LocalPlayer.CharacterAdded:Connect(function()
				v40()
				task.wait(0.5)

				if _G.AutoChestBP then
					v48()
				end
			end)
			v48()
		end
	end
})
