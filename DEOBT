function Hub:FishControlStep()
    if not self.Alive or self.ActiveMode ~= "Fish" or self.Config.Fish ~= true or self.Config["Fishing Mode"] ~= "Legit" then
        if self.FishInputDown then self:FishInput(false) end
        return
    end
    local _, fish, zone = self:FishGui()
    if not fish or not zone then
        if self.FishPhase == "minigame" and self.FishInputDown then self:FishInput(false) end
        self.FishControlX, self.FishControlAt = nil, nil
        return
    end
    self.FishPhase = "minigame"
    local now = os.clock()
    local fishX = fish.AbsolutePosition.X + fish.AbsoluteSize.X * 0.5
    local zoneX = zone.AbsolutePosition.X + zone.AbsoluteSize.X * 0.5
    local velocity = 0
    if self.FishControlX and self.FishControlAt and now > self.FishControlAt then
        velocity = (zoneX - self.FishControlX) / (now - self.FishControlAt)
    end
    self.FishControlX, self.FishControlAt = zoneX, now
    local predicted = zoneX + velocity * 0.08
    local deadzone = math.max(2, zone.AbsoluteSize.X * 0.08)
    if fishX > predicted + deadzone then
        self:FishInput(true)
    elseif fishX < predicted - deadzone then
        self:FishInput(false)
    end
end

function Hub:FishRemoteCastPosition(root)
    local direction, water = self:FishDirection(root.Position, root.CFrame.LookVector)
    if not direction then return nil end
    local position = root.Position + direction * 25
    water = self:WaterHeight(position) or water
    if type(water) ~= "number" then return nil end
    return Vector3.new(position.X, water, position.Z)
end

function Hub:FishRemoteReset(rf, delay)
    pcall(rf.InvokeServer, rf, "Catching", false)
    pcall(rf.InvokeServer, rf, "ReeledIn")
    pcall(rf.InvokeServer, rf, "RemoveBobberFish")
    self.FishBiteAt, self.FishData, self.FishReeledAt = nil, nil, nil
    self.FishCastAt = os.clock() + (delay or 1.5)
    self.FishPhase = "remote-start"
end

function Hub:FishRemoteStep(rf, root, phase)
    local now = os.clock()
    if phase == "remote-start" then
        if now < (self.FishCastAt or 0) then return end
        if self.FishSpot then root.CFrame = self.FishSpot end
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        local ok = pcall(rf.InvokeServer, rf, "StartCasting")
        if not ok then
            self.FishCastAt = now + 1.5
            return
        end
        self.FishRemoteReleaseAt = now + 0.3
        self.FishPhase = "remote-launch"
        return
    end
    if phase == "remote-launch" then
        if now < (self.FishRemoteReleaseAt or math.huge) then return end
        local position = self:FishRemoteCastPosition(root)
        if not position then
            self:FishRemoteReset(rf, 2)
            return
        end
        local ok, bobberId, rejected = pcall(rf.InvokeServer, rf, "CastLineAtLocation", position, 85, true, nil, nil)
        if ok and bobberId and rejected ~= true then
            self.FishBiteAt, self.FishData, self.FishReeledAt = nil, nil, nil
            self.FishWaitDeadline = now + 75
            self.FishPhase = "remote-wait"
        else
            self:FishRemoteReset(rf, 1.5)
        end
        return
    end
    if phase == "remote-wait" then
        if self.FishBiteAt then
            self.FishBiteAt = nil
            local ok = pcall(rf.InvokeServer, rf, "Catching", true, { fastBite = true })
            if ok then
                self.FishRemoteCatchAt = now + 4.2
                self.FishPhase = "remote-catch"
            else
                self:FishRemoteReset(rf, 1.5)
            end
        elseif now >= (self.FishWaitDeadline or math.huge) then
            self:FishRemoteReset(rf, 1.5)
        end
        return
    end
    if phase == "remote-catch" then
        if now < (self.FishRemoteCatchAt or math.huge) then return end
        local ok, caught = pcall(rf.InvokeServer, rf, "Catch", 1, 0, 1)
        pcall(rf.InvokeServer, rf, "ReeledIn")
        pcall(rf.InvokeServer, rf, "RemoveBobberFish")
        self.FishBiteAt, self.FishData, self.FishReeledAt = nil, nil, nil
        self.FishCastAt = now + ((ok and caught ~= false) and 1.2 or 2)
        self.FishPhase = "remote-cooldown"
        return
    end
    if phase == "remote-cooldown" then
        if now >= (self.FishCastAt or 0) then self.FishPhase = "remote-start" end
        return
    end
    self.FishPhase = "remote-start"
end

function Hub:FishCleanup()
    self:FishClientCast(false)
    self:FishInput(false)
    self.FishCastDriver = nil
    local rf = self.FishingRequest
    if rf and rf.Parent then
        pcall(rf.InvokeServer, rf, "Catching", false)
        pcall(rf.InvokeServer, rf, "ReeledIn")
    end
    if self.FishPlatform then pcall(self.FishPlatform.Destroy, self.FishPlatform); self.FishPlatform = nil end
    self.FishPhase, self.FishBiteAt, self.FishData, self.FishSpot = nil, nil, nil, nil
    self.FishCastAt, self.FishLaunchDeadline, self.FishWaitDeadline, self.FishResultAt = nil, nil, nil, nil
    self.FishRemoteReleaseAt, self.FishRemoteCatchAt, self.FishRuntimeMode = nil, nil, nil
    self.FishControlX, self.FishControlAt, self.FishReeledAt = nil, nil, nil
    self:SetInfo("FishStatus", "Idle")
end

