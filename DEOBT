function Hub:FishDirection(position, preferred)
    preferred = preferred * Vector3.new(1, 0, 1)
    if preferred.Magnitude < 0.01 then preferred = Vector3.new(0, 0, -1) end
    preferred = preferred.Unit
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filters = { Player.Character }
    if self.FishPlatform then filters[#filters + 1] = self.FishPlatform end
    params.FilterDescendantsInstances = filters
    for _, angle in ipairs({ 0, 45, -45, 90, -90, 135, -135, 180 }) do
        local direction = (CFrame.lookAt(Vector3.zero, preferred) * CFrame.Angles(0, math.rad(angle), 0)).LookVector
        direction = (direction * Vector3.new(1, 0, 1)).Unit
        local target = position + direction * 25
        local water = self:WaterHeight(target)
        local hit = Services.Workspace:Raycast(target + Vector3.new(0, 80, 0), Vector3.new(0, -200, 0), params)
        local tagged = hit and Services.CollectionService:HasTag(hit.Instance, "WaterBody")
        if tagged or (water and (not hit or hit.Position.Y <= water + 1.5)) then return direction, water end
    end
    return preferred, self:WaterHeight(position + preferred * 25)
end

function Hub:FishSpotAtDock()
    local dock = self:NearestDock()
    if not dock then return nil end
    local water = self:WaterHeight(dock.Position)
    local y = water and water + 4 or dock.Position.Y + 4
    local position = Vector3.new(dock.Position.X, y, dock.Position.Z)
    local direction = self:FishDirection(position, dock.LookVector)
    return CFrame.lookAt(position, position + direction)
end

