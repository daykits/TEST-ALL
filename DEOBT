function Hub:FruitDealerStep()
    if not self.Config["Fruit Dealer Watch"] then return end
    if os.clock() < (self.DealerNext or 0) then return end
    self.DealerNext = os.clock() + 90
    local names = {}
    local function collect(value, depth)
        if depth > 4 then return end
        if type(value) == "string" then
            names[value] = true
        elseif type(value) == "table" then
            for k, v in pairs(value) do
                if type(k) == "string" then names[k] = true end
                collect(v, depth + 1)
            end
        end
    end
    local ok, stock = self:Comm("FruitShop", "FruitDealer")
    if ok then collect(stock, 0) end
    if self.Sea ~= "Sea1" then
        local ok2, stock2 = self:Comm("FruitShop", "AdvancedFruitDealer")
        if ok2 then collect(stock2, 0) end
    end
    local found = {}
    for name in pairs(names) do table.insert(found, name) end
    if #found == 0 then return end
    table.sort(found)
    self:Log("dealer", "Stock: " .. table.concat(found, ", "):sub(1, 300), 120)
    local wishlist = {}
    for token in tostring(self.Config["Fruit Dealer Wishlist"] or ""):gmatch("[^,]+") do
        local clean = token:gsub("^%s+", ""):gsub("%s+$", ""):lower()
        if clean ~= "" then table.insert(wishlist, clean) end
    end
    local hits, hitSet = {}, {}
    for _, name in ipairs(found) do
        local lower = name:lower()
        for _, want in ipairs(wishlist) do
            if lower:find(want, 1, true) then
                table.insert(hits, name)
                hitSet[name] = true
                break
            end
        end
    end
    local fresh = {}
    for _, name in ipairs(hits) do
        if not (self.DealerHits and self.DealerHits[name]) then table.insert(fresh, name) end
    end
    self.DealerHits = hitSet
    if #fresh == 0 then return end
    self:Notify("Fruit Dealer", "In stock: " .. table.concat(fresh, ", "))
    if self:WebhookOn("Fruit Dealer Stock") then
        self:WebhookSend("Fruit Dealer Stock", "Wishlist fruit in stock:\n- " .. table.concat(fresh, "\n- "), 15844367, self:WebhookStatFields())
    end
    if self.Config["Fruit Dealer Auto Buy"] then
        for _, name in ipairs(fresh) do
            local bought, result = self:Comm("PurchaseRawFruit", name, false, nil)
            if bought and result then
                self:Notify("Fruit Dealer", "Bought " .. name)
                break
            end
            local bought2, result2 = self:Comm("PurchaseRawFruit", name, true, nil)
            if bought2 and result2 then
                self:Notify("Fruit Dealer", "Bought " .. name)
                break
            end
        end
    end
end

