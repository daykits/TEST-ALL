    if not controller or type(controller.Open) ~= "function" then
        self:Notify(key, "Unavailable.")
        return false
    end
    local args = table.pack(...)
    local ok, result = self:Call("open:" .. key, 12, 1, function()
        return controller:Open(table.unpack(args, 1, args.n))
    end)
    if not ok then self:Notify(key, result) end
    return ok
end

function Hub:ClaimGuideReward(group, silent)
    if type(group) ~= "string" then return false end
    self.RewardRequests = self.RewardRequests or {}
    if os.clock() < (self.RewardRequests[group] or 0) then return false end
    self.RewardRequests[group] = os.clock() + 15
    local ok, reply = self:NetCall("BonusMomentsGuide", "InteractQuestGiver", group)
    if not silent then
        local lines = type(reply) == "table" and reply.OpeningDialogue
        self:Response("Island Rewards", ok, type(lines) == "table" and table.concat(lines, "\n") or reply)
