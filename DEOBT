function Hub:AutoStatsStep()
    local available = self:Value({ "Data", "Points" })
    local cap = Player:GetAttribute("LevelCap")
    if type(available) ~= "number" or available <= 0 or type(cap) ~= "number" then return end
    local stats = { { "Melee", "Auto Melee" }, { "Defense", "Auto Defense" }, { "Sword", "Auto Sword" },
        { "Gun", "Auto Gun" }, { "Demon Fruit", "Auto Fruit" } }
    local start = self.NextStat or 1
    for offset = 0, #stats - 1 do
        local index = (start + offset - 1) % #stats + 1
        local entry = stats[index]
        local level = self:Value({ "Data", "Stats", entry[1], "Level" })
        if self.Config[entry[2]] and type(level) == "number" and level < cap then
            local amount = math.floor(math.min(available, cap - level, self.Config.StatBatch))
            if amount > 0 then
                self:Comm("AddPoint", entry[1], amount)
                self.NextStat = index % #stats + 1
                return
            end
        end
    end
end

