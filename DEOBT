-- AUTO KAITUN MAIN FLOW

-- ============================================================

local KT = { running = false, loopID = 0 }

function H.startKaitunFarm()

	if KT.running then return end

	notify("Kaitun", "Start clicked | Level: " .. tostring(getLevel()) .. " | PlaceId: " .. tostring(game.PlaceId), 5)

	if IS_LOGIN_PLACE then

		startAutoJoinSea2(getActivePSCode())

		return

	end

	KT.running = true

	KT.loopID = KT.loopID + 1

	getgenv().KaitunFarm = true

	startUtilityLoops()

	H.autoAdsEnabled = true

	H.autoStatsEnabled = true

	setNoclip(true)

	H.teleportSpeed = DefaultConfig.MAIN.TWEEN_SPEED or 70

	task.spawn(function()

		local ok, err = pcall(function()

			if shouldForceMainMenuFromCurrentPlace() then

				teleportToMainMenuForPS()

				return

			end

			if IS_SEA2_PLACE then

				H.startSea2Farm()

				while KT.running and getgenv().Sea2Farm do

					if getLevel() >= (DefaultConfig.MAIN.LEVEL or 675) then

						H.stopSea2Farm()

						break

					end

					task.wait(3)

				end

			else

				local level = getLevel()

				notify("Kaitun", "Main flow running | Level: " .. tostring(level), 5)

				if level < 425 then

					notify("Kaitun", "Level < 425, starting Fishman farm.", 5)

					phase1FishmanFarm()

				else

					notify("Kaitun", "Level >= 425, skipping Fishman farm.", 5)

				end

				if KT.running and configFlag("STYLE", "Geppo", true) then

					getgenv().KaitunFarm = true

					ensureEscapedFishman("Before Geppo")

					phase2Geppo()

				end

				if KT.running and configFlag("HAKI", "Buso", true) then

					getgenv().KaitunFarm = true

					ensureEscapedFishman("Before Haki")

					phase3Haki()

				end

				if KT.running and configFlag("ITEM", "World Scroll", true) then

					getgenv().KaitunFarm = true

					ensureEscapedFishman("Before World Scroll")

					phase4WorldScroll()

				end

				if KT.running then

					getgenv().KaitunFarm = true

					phase5MainMenuSea2()

				end

			end

		end)

		KT.running = false

		getgenv().KaitunFarm = false

		H.autoAdsEnabled = false

		H.autoStatsEnabled = false

		releaseMovementKeys()

		if ok then

			notify("Kaitun", "Stopped.", 4)

		else

			notify("Kaitun ERROR", tostring(err), 10)

		end

	end)

end

function H.stopKaitunFarm()

	KT.running = false

	getgenv().KaitunFarm = false

	H.autoAdsEnabled = false

	H.autoStatsEnabled = false

	H.tpToken = H.tpToken + 1

	if H.stopSea2Farm then H.stopSea2Farm() end

	releaseMovementKeys()

	notify("Kaitun", "Stopped manually.", 4)

end

