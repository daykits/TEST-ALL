    elseif mode == "Sea Danger" then self:SeaDangerStep()
    elseif mode == "Auto Halloween" then self:HalloweenStep()
    elseif mode == "Auto Great Pumpkin" then self:HalloweenGreatPumpkinFarmStep()
    elseif mode == "Auto Progression" then self:ProgressionStep()
    elseif mode == "Auto Observation V2" then self:ObservationV2Step()
    elseif mode == "Fully Soul Reaper" then self:FullySoulReaperStep()
    elseif mode == "Fully Cake Prince" then self:FullyCakePrinceStep()
