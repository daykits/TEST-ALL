-- TOGGLE -----------------------------------------------------------------
function ComponentFactory.Toggle(section, cfg)
    cfg = cfg or {}
    local theme = CurrentTheme
    local comp = { _type = "Toggle", _enabled = true, _value = cfg.Default or false }
    local row = MakeRow(section.List, 44)
    comp.Container = row

    MakeTitleText(row, cfg.Name or "Toggle", cfg.Description)

    local switch = New("Frame", {
        BackgroundColor3 = theme.Border,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(42, 22),
        Position = UDim2.new(1, -42, 0.5, -11),
        ZIndex = 5,
        Parent = row,
    })
    Corner(11).Parent = switch
    comp.Switch = switch

    comp.Knob = New("Frame", {
        BackgroundColor3 = theme.Text,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.fromOffset(3, 3),
        ZIndex = 6,
        Parent = switch,
    })
    Corner(8).Parent = comp.Knob

    comp.Btn = New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 7,
        Parent = switch,
    })

    local function applyVisual(state, animate)
        local targetColor = state and theme.Accent or theme.Border
        local targetPos = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3)
        local targetKnob = state and theme.Background or theme.Text
        if animate then
            GlobalAnimations:Play(switch, { BackgroundColor3 = targetColor })
            GlobalAnimations:Play(comp.Knob, { Position = targetPos, BackgroundColor3 = targetKnob })
        else
            switch.BackgroundColor3 = targetColor
            comp.Knob.Position = targetPos
            comp.Knob.BackgroundColor3 = targetKnob
        end
    end

    applyVisual(comp._value, false)

    comp.Btn.MouseButton1Click:Connect(function()
        if not comp._enabled then return end
        comp._value = not comp._value
        applyVisual(comp._value, true)
        SafeCall(cfg.Callback, comp._value)
    end)

    function comp.SetValue(v)
        v = v and true or false
        comp._value = v
        applyVisual(v, true)
    end
    function comp.GetValue() return comp._value end
    function comp.SetCallback(fn) cfg.Callback = fn end
    function comp.SetEnabled(b)
        comp._enabled = b and true or false
        comp.Container.BackgroundTransparency = b and 0 or 0.5
    end
    function comp.Destroy()
        comp.Container:Destroy()
    end
    function comp:_ApplyTheme(t)
        applyVisual(comp._value, false)
    end

    table.insert(section.Components, comp)
    return comp
end

-- SLIDER -----------------------------------------------------------------
function ComponentFactory.Slider(section, cfg)
    cfg = cfg or {}
    local theme = CurrentTheme
    local minV = tonumber(cfg.Min) or 0
    local maxV = tonumber(cfg.Max) or 100
    local stepV = tonumber(cfg.Step) or 1
    if maxV <= minV then maxV = minV + 1 end
    local value = Clamp(tonumber(cfg.Default) or minV, minV, maxV)
    value = Round(value, stepV)

    local comp = { _type = "Slider", _enabled = true }
    local row = MakeRow(section.List, 56)
    comp.Container = row

    MakeTitleText(row, cfg.Name or "Slider")

    comp.ValueLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(value),
        Font = Enum.Font.GothamMedium,
        TextColor3 = theme.Accent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Position = UDim2.new(1, -100, 0, 0),
        Size = UDim2.fromOffset(100, 20),
        ZIndex = 5,
        Parent = row,
    })

    local track = New("Frame", {
        BackgroundColor3 = theme.Border,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 38),
        Size = UDim2.new(1, 0, 0, 6),
        ZIndex = 5,
        Parent = row,
    })
    Corner(3).Parent = track

    local fill = New("Frame", {
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        ZIndex = 6,
        Parent = track,
    })
    Corner(3).Parent = fill
    comp.Fill = fill

    local knob = New("Frame", {
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        ZIndex = 7,
        Parent = track,
    })
    Corner(7).Parent = knob
    comp.Knob = knob

    local function applyFromValue(val)
        val = Clamp(val, minV, maxV)
        val = Round(val, stepV)
        local ratio = (val - minV) / (maxV - minV)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        comp.ValueLabel.Text = tostring(val)
        return val
    end

    applyFromValue(value)

    local function userSet(val, fire)
        local prev = value
        value = applyFromValue(val)
        if fire and prev ~= value then
            SafeCall(cfg.Callback, value)
        end
    end

    local dragging = false
    local function updateFromInput(inputX)
        local trackAbsX = track.AbsolutePosition.X
        local trackW = track.AbsoluteSize.X
        local ratio = Clamp((inputX - trackAbsX) / math.max(trackW, 1), 0, 1)
        local v = minV + ratio * (maxV - minV)
        userSet(v, true)
    end

    local button = New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.fromOffset(0, -5),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 8,
        Parent = track,
    })
    button.MouseButton1Down:Connect(function()
        if not comp._enabled then return end
        dragging = true
        updateFromInput(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input.Position.X)
        end
    end)
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input.Position.X)
        end
    end)

    function comp.SetValue(v) userSet(v, false) end
    function comp.GetValue() return value end
    function comp.SetMin(v) minV = tonumber(v) or minV; userSet(value, false) end
    function comp.SetMax(v) maxV = tonumber(v) or maxV; userSet(value, false) end
    function comp.SetCallback(fn) cfg.Callback = fn end
    function comp.SetEnabled(b) comp._enabled = b and true or false; knob.Visible = comp._enabled end
    function comp.Destroy() comp.Container:Destroy() end
    function comp:_ApplyTheme(t)
        track.BackgroundColor3 = t.Border
        fill.BackgroundColor3 = t.Accent
        knob.BackgroundColor3 = t.Accent
        comp.ValueLabel.TextColor3 = t.Accent
    end

    table.insert(section.Components, comp)
    return comp
end

