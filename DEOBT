        for _, name in ipairs({ "HellfireBossRealm", "HellfireBossArena" }) do
            local model = map:FindFirstChild(name)
            if model and model:IsA("Model") then
                local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
                if ok and cf and size then table.insert(boxes, { CFrame = cf, Size = size }) end
            end
        end
        for _, model in ipairs(map:GetChildren()) do
            if model:IsA("Model") then
                local lname = model.Name:lower()
                if lname:find("realm", 1, true) and (lname:find("boss", 1, true) or lname:find("wolf", 1, true) or lname:find("hellfire", 1, true)) then
                    local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
                    if ok and cf and size then table.insert(boxes, { CFrame = cf, Size = size }) end
                end
            end
        end
    end
    self.HalloweenRealmCache, self.HalloweenRealmCacheUntil = boxes, os.clock() + 5
    return boxes
end

function Hub:HalloweenRealmState()
    if self.HalloweenRealmStateAt and os.clock() - self.HalloweenRealmStateAt < 0.25 then
        return self.HalloweenRealmHellfire == true, self.HalloweenRealmDapper == true
    end
    self.HalloweenRealmStateAt = os.clock()
    local hellfire, dapper = false, false
    local _, _, root = self:Character()
    if root then
        for _, box in ipairs(self:HalloweenRealmBoxes()) do
            local localPos = box.CFrame:PointToObjectSpace(root.Position)
            if math.abs(localPos.X) <= box.Size.X / 2 and math.abs(localPos.Y) <= box.Size.Y / 2
                and math.abs(localPos.Z) <= box.Size.Z / 2 then
                hellfire = true
                break
            end
        end
        local center = self:HalloweenDapperCenter()
        if center then
            local dx, dz = root.Position.X - center.X, root.Position.Z - center.Z
            if math.sqrt(dx * dx + dz * dz) <= 360 and math.abs(root.Position.Y - center.Y) <= 420 then
                dapper = true
            end
        end
    end
    self.HalloweenRealmHellfire, self.HalloweenRealmDapper = hellfire, dapper
    return hellfire, dapper
end

function Hub:HalloweenInHellfireRealm()
    local hellfire = self:HalloweenRealmState()
    return hellfire
end

function Hub:HalloweenPointInRealm(position)
    for _, box in ipairs(self:HalloweenRealmBoxes()) do
        local localPos = box.CFrame:PointToObjectSpace(position)
        if math.abs(localPos.X) <= box.Size.X / 2 and math.abs(localPos.Y) <= box.Size.Y / 2
            and math.abs(localPos.Z) <= box.Size.Z / 2 then
            return true
        end
    end
    return false
end

function Hub:HalloweenPointInDapper(position)
    local center = self:HalloweenDapperCenter()
    if not center then return false end
    local dx, dz = position.X - center.X, position.Z - center.Z
    return math.sqrt(dx * dx + dz * dz) <= 360 and math.abs(position.Y - center.Y) <= 420
end

function Hub:TryHalloweenRoute(target)
    local _, humanoid, root = self:Character()
    if not root then return false end
    local position = target.Position
    local inDapper = self:HalloweenInDapperArena()
    local wantDapper = self:HalloweenPointInDapper(position)
    if wantDapper and not inDapper then
        if not (self:HalloweenDapperActive() or self.HalloweenRitualActive == true) then return true end
        local spot = self:HalloweenDapperSpot()
        if not spot then return true end
        local prompt = self:HalloweenDapperPrompt()
        local promptCFrame = prompt and Compat.cframe(prompt.Parent) or nil
        local goal = promptCFrame and promptCFrame.Position or spot
        local range = prompt and math.min(prompt.MaxActivationDistance or 10, 10) or 14
        if (root.Position - goal).Magnitude > range then
            self:TweenTo(CFrame.new(goal + Vector3.new(0, 3, 0)))
            return true
        end
        if prompt and prompt.Enabled and os.clock() >= (self.HalloweenRoutePromptAt or 0) then
            self.HalloweenRoutePromptAt = os.clock() + 8
            self:CancelMove()
            self:FirePrompt(prompt)
        end
        self:HalloweenHold()
        return true
    end
    if inDapper and not wantDapper then
        if not self:HalloweenDapperStep() then self:HalloweenHold() end
        return true
    end
    local inRealm = self:HalloweenInHellfireRealm()
    local wantRealm = self:HalloweenPointInRealm(position)
    if wantRealm and not inRealm then
        local session = self.HalloweenBossSession
        local door = session and session.Door and session.Door.Parent and session.Door or nil
        if not door then
            local entry = self:HalloweenActiveBossDoor()
            door = entry and entry.Door or nil
        end
        local part = door and door:FindFirstChild("Part") or nil
        if not (part and part:IsA("BasePart")) then return true end
        if session and os.clock() < (session.EnterAt or 0) then
            self:HalloweenHold()
            return true
        end
        local portal = part.CFrame * CFrame.new(0, 2, -(part.Size.Z / 2 + 0.5))
        if (root.Position - portal.Position).Magnitude > 2.5 then
            self:TweenTo(portal)
        else
            self:CancelMove()
            if humanoid then pcall(function() humanoid:MoveTo(part.Position) end) end
        end
        return true
    end
    if inRealm and not wantRealm then
        local session = self.HalloweenBossSession
        local doorActive = false
        pcall(function() doorActive = session and session.Door and session.Door.Parent and session.Door:GetAttribute("BOSS_ACTIVE_SERVER") == true or false end)
        local sawBoss = (session and session.SawBoss) or self.HalloweenHellfireSawBoss
        if sawBoss and not doorActive and not self:HalloweenEnemy() then
            self:HalloweenResetCharacter("Hellfire Boss")
            return true
        end
        self:HalloweenHold()
        return true
    end
    return false
end

function Hub:HalloweenCardStep()
    local folder = Services.Workspace:FindFirstChild("DapperJackRewardFx")
    local card = folder and folder:FindFirstChild("RewardCard") or nil
    if not (card and card:IsA("BasePart")) then return false end
    local _, _, root = self:Character()
    if not root then return false end
    self.HalloweenArenaIdleSince = nil
    local delta = root.Position - card.Position
    local flat = Vector3.new(delta.X, 0, delta.Z).Magnitude
    if flat <= 10 and math.abs(delta.Y) <= 16 then
        self:CancelMove()
        self:HalloweenHold()
        self:HalloweenStatus("Great Pumpkin | Claiming reward card")
    else
        self:HalloweenStatus("Great Pumpkin | Going to the reward card")
        self:MoveTo(card.CFrame)
    end
    return true
end

function Hub:HalloweenInDapperArena()
    local _, dapper = self:HalloweenRealmState()
    return dapper
end

function Hub:HalloweenBossSessionStart(entry)
    if not entry or not entry.Door then return end
    local delay = 8
    pcall(function()
        if Services.CollectionService:HasTag(entry.Door, "HellfireBossDoor") then
            delay = 3
        elseif Services.CollectionService:HasTag(entry.Door, "WerewolfBossDoor") then
            delay = 15
        end
    end)
    if entry.Door:GetAttribute("BOSS_ACTIVE_SERVER") == true then delay = math.min(delay, 1) end
    self.HalloweenBossSession = {
        Door = entry.Door, Entry = entry, Started = os.clock(),
        EnterAt = os.clock() + delay, SawBoss = false, IdleSince = nil
    }
end

function Hub:HalloweenDoors()
    local now = os.clock()
    if self.HalloweenDoorCache and now - (self.HalloweenDoorCacheAt or -100) < 4 then return self.HalloweenDoorCache end
    self.HalloweenDoorCacheAt = now
    local doors = {}
    local map = Services.Workspace:FindFirstChild("Map")
    if map then
        for _, object in ipairs(map:GetDescendants()) do
            if object.Name == "HalloweenDoor" then
                local prompt = object:FindFirstChildWhichIsA("ProximityPrompt", true)
                local cf = Compat.cframe(object)
                if prompt and cf then table.insert(doors, { Door = object, Prompt = prompt, CFrame = cf }) end
            end
        end
    end
    self.HalloweenDoorCache = doors
    return doors
end

function Hub:HalloweenDoorReady(entry)
    local door, prompt = entry.Door, entry.Prompt
    if not door.Parent or not prompt.Parent or not prompt.Enabled then return false end
    if door:GetAttribute("DoorOpen") == true then return false end
    local cooldown = door:GetAttribute("CooldownUntil")
    if type(cooldown) == "number" and Services.Workspace:GetServerTimeNow() < cooldown then return false end
    return not self.HalloweenTried or os.clock() >= (self.HalloweenTried[door] or 0)
end

function Hub:HalloweenBossDoor(entry)
    local door = entry and entry.Door
    if not door or not door.Parent then return false end
    local ok, result = pcall(function()
        if door:GetAttribute("WerewolfBossDoor") == true then return true end
        if door:GetAttribute("BOSS_ACTIVE_SERVER") == true then return true end
        if Services.CollectionService:HasTag(door, "WerewolfBossDoor") then return true end
        if Services.CollectionService:HasTag(door, "HellfireBossDoor") then return true end
        for _, child in ipairs(door:GetChildren()) do
            if Services.CollectionService:HasTag(child, "WerewolfBossDoor") or Services.CollectionService:HasTag(child, "HellfireBossDoor") then return true end
        end
        for key, value in pairs(door:GetAttributes()) do
            local name = tostring(key):lower()
            if value == true and (name:find("bossdoor", 1, true) or name == "boss" or name == "isboss") then return true end
        end
        for _, tag in ipairs(Services.CollectionService:GetTags(door)) do
            if tostring(tag):lower():find("bossdoor", 1, true) then return true end
        end
        return false
    end)
    return ok and result == true
end

function Hub:HalloweenPortalEntry()
    local _, _, root = self:Character()
    if not root then return nil end
    local ok, tagged = pcall(function() return Services.CollectionService:GetTagged("HalloweenPortal") end)
    if not ok or type(tagged) ~= "table" then return nil end
    local best, bestDistance
    for _, portal in ipairs(tagged) do
        local valid = false
        pcall(function() valid = portal ~= nil and portal:IsDescendantOf(Services.Workspace) and portal:GetAttribute("Enabled") ~= false end)
        if valid then
            local part
            pcall(function() part = portal:IsA("BasePart") and portal or portal.PrimaryPart end)
            local cf = Compat.cframe(part) or Compat.cframe(portal)
            if cf then
                local distance = (root.Position - cf.Position).Magnitude
                if not bestDistance or distance < bestDistance then
                    best, bestDistance = { Portal = portal, Part = part, CFrame = cf }, distance
                end
            end
        end
    end
    return best, bestDistance
end

function Hub:HalloweenClickGui(button)
    if typeof(button) ~= "Instance" or not button.Parent then return false end
    if type(firesignal) == "function" then
        if pcall(firesignal, button.MouseButton1Click) then return true end
        if pcall(firesignal, button.Activated) then return true end
    end
    local ok, vim = pcall(game.GetService, game, "VirtualInputManager")
    if not ok or not vim then return false end
    local size = button.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return false end
    local position = button.AbsolutePosition
    local x, y = position.X + size.X / 2, position.Y + size.Y / 2
    return pcall(function()
        vim:SendMouseMoveEvent(x, y, game)
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.06)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

function Hub:HalloweenGatewayPick(entry)
    local gui = Player:FindFirstChild("PlayerGui")
    local main = gui and gui:FindFirstChild("Main")
    if not main then return false end
    local target = entry and entry.CFrame or nil
    local bestButton, bestScore, bestLabel, visibleCount
    visibleCount = 0
    for _, windowName in ipairs({ "Gateway", "Gateway3" }) do
        local window = main:FindFirstChild(windowName)
        if window then
            for _, object in ipairs(window:GetDescendants()) do
                if object:IsA("GuiButton") and object.Visible and object.AbsoluteSize.X > 20 and object.AbsoluteSize.Y > 12 then
                    local label = ""
                    local textName = object:FindFirstChild("TextName", true)
                    if textName and (textName:IsA("TextLabel") or textName:IsA("TextButton") or textName:IsA("TextBox")) then label = textName.Text end
                    if label == "" and object:IsA("TextButton") then label = object.Text end
                    if label == "" then
                        local textLabel = object:FindFirstChildWhichIsA("TextLabel", true)
                        if textLabel then label = textLabel.Text end
                    end
                    label = tostring(label or ""):gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", "")
                    local lower = label:lower()
                    if label ~= "" and lower ~= "x" and not lower:find("close", 1, true) and not lower:find("exit", 1, true) then
                        visibleCount += 1
                        local score
                        if target then
                            local destination = self:WorldPortalDestination(label)
                            if destination then score = (destination.Position - target.Position).Magnitude end
                        end
                        local eventish = lower:find("halloween", 1, true) or lower:find("trick", 1, true)
                            or lower:find("pumpkin", 1, true) or lower:find("haunted", 1, true)
                        if score == nil and eventish then score = 0 end
                        if score ~= nil and (bestScore == nil or score < bestScore) then
                            bestButton, bestScore, bestLabel = object, score, label
                        end
                    end
                end
            end
        end
    end
    if not bestButton then
        if visibleCount > 0 then self:HalloweenStatus("Halloween Portal | Choose the event destination") end
        return false
    end
    if target and bestScore and bestScore > 1800 then
        self:HalloweenStatus("Halloween Portal | No matching event destination")
        return false
    end
    if os.clock() < (self.HalloweenGatewayAt or 0) then return true end
    self.HalloweenGatewayAt = os.clock() + 2
    if self:HalloweenClickGui(bestButton) then
        self:HalloweenStatus("Halloween Portal | Traveling to " .. bestLabel)
        return true
    end
    self:HalloweenStatus("Halloween Portal | Click unavailable")
    return false
end

function Hub:HalloweenPortalStep(entry)
    if not self.Config["Halloween Use Portal"] then return false end
    local _, _, root = self:Character()
    if not root then return false end
    local waitState = self.HalloweenPortalWait
    if waitState then
        local target = entry or waitState.Entry
        if target and target.Door and target.Door.Parent then target.CFrame = Compat.cframe(target.Door) or target.CFrame end
        local arrived = (root.Position - waitState.From).Magnitude > 300
            or (target ~= nil and target.CFrame ~= nil and (root.Position - target.CFrame.Position).Magnitude <= 1000)
        if arrived then
            self.HalloweenPortalWait = nil
            self:HalloweenStatus("Halloween Portal | Arrived")
            return false
        end
        if os.clock() >= waitState.Until then
            self.HalloweenPortalWait = nil
            self.HalloweenPortalBlockedUntil = os.clock() + 30
            self:HalloweenStatus("Halloween Portal | Timed out; using direct route")
            return false
        end
        if self.Tween then self:CancelMove() end
        if not self:HalloweenGatewayPick(target) then
            if not self.HalloweenStatusText or not self.HalloweenStatusText:find("Halloween Portal", 1, true) then
                self:HalloweenStatus("Halloween Portal | Waiting for destination list")
            end
        end
        return true
    end
    if os.clock() < (self.HalloweenPortalBlockedUntil or 0) then return false end
    local portal, portalDistance = self:HalloweenPortalEntry()
    if not portal then return false end
    local doorDistance = entry and entry.CFrame and (root.Position - entry.CFrame.Position).Magnitude or math.huge
    if entry and doorDistance <= 2000 then return false end
    if entry and portalDistance + 800 >= doorDistance then return false end
    if not entry and portalDistance > 3000 then return false end
    self.Target = nil
    if portalDistance > 10 then
        self:HalloweenStatus("Moving to Halloween Portal | " .. math.floor(portalDistance) .. " studs")
        self:MoveTo(portal.CFrame)
        return true
    end
    self:CancelMove()
    self.HalloweenPortalWait = { Until = os.clock() + 20, Entry = entry, From = root.Position }
    self:HalloweenStatus("Halloween Portal | Waiting for destination list")
    return true
end

function Hub:HalloweenPortalTravel(entry)
    if not self.Config["Halloween Use Portal"] then return false end
    local _, _, root = self:Character()
    if not root then return false end
    local portal, portalDistance = self:HalloweenPortalEntry()
    if not portal then return false end
    local doorDistance = entry and entry.CFrame and (root.Position - entry.CFrame.Position).Magnitude or math.huge
    if doorDistance <= 2000 or portalDistance + 800 >= doorDistance then return false end
    self:Notify("Halloween", "Traveling via Halloween Portal.")
    local reached = self:MoveUntil(portal.CFrame, function() return self.Alive and not self:HalloweenBusy() end, 45)
    if not reached then return false end
    self:CancelMove()
    _, _, root = self:Character()
    if not root then return false end
    local from = root.Position
    local deadline = os.clock() + 20
    while self.Alive and os.clock() < deadline do
        self:HalloweenGatewayPick(entry)
        _, _, root = self:Character()
        if not root then return false end
        if entry and entry.Door and entry.Door.Parent then entry.CFrame = Compat.cframe(entry.Door) or entry.CFrame end
        if (root.Position - from).Magnitude > 300 then return true end
        if entry and entry.CFrame and (root.Position - entry.CFrame.Position).Magnitude <= 1000 then return true end
        task.wait(0.3)
    end
    return false
end

function Hub:HalloweenOwnEnemy(model)
    if not model or not model.Parent then return false end
    local function claim(reason)
        self.HalloweenOwnMobs = self.HalloweenOwnMobs or setmetatable({}, { __mode = "k" })
        if not self.HalloweenOwnMobs[model] then
            self.HalloweenOwnMobs[model] = true
            self:Log("halloween-own", model.Name .. " <- " .. reason, 2)
        end
        return true
    end
    local owner = model:GetAttribute("LocalEnemy")
    if owner ~= nil and owner ~= Player.Name then return false end
    if self.HalloweenOwnMobs and self.HalloweenOwnMobs[model] then return true end
    local lower = model.Name:lower()
    if lower == "hellfire gas" then return true end
    if lower == "dapper jack" then return self:HalloweenInDapperArena() end
    local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not part then return false end
    if lower == "pumpkin snowman" and self.Config["Auto Great Pumpkin"] then return claim("snowman contest") end
    local ownDoor = self.HalloweenOwnDoor
    if ownDoor and ownDoor.Door and ownDoor.Door.Parent and os.clock() - (ownDoor.At or 0) <= 75
        and not (ownDoor.Ignore and ownDoor.Ignore[model])
        and (ownDoor.Door:GetAttribute("DoorOpen") == true or os.clock() < (self.HalloweenSceneHoldUntil or 0) or os.clock() < (self.HalloweenKnockWaitUntil or 0)) then
        local cf = Compat.cframe(ownDoor.Door)
        if cf and (part.Position - cf.Position).Magnitude <= 100 then return claim("my door spawn") end
    end
    local spot = self.HalloweenPumpkinSpot
    if spot and (lower == "jack o' lantern" or lower == "pumpkin snowman")
        and os.clock() - (spot.At or 0) <= 15 and (part.Position - spot.Position).Magnitude <= 60 then
        return claim("my cracked pumpkin")
    end
    local session = self.HalloweenBossSession
    local sessionFresh = session and os.clock() - (session.Started or 0) <= 150
    local inRealm = self:HalloweenInHellfireRealm()
    if sessionFresh or inRealm then
        local function realmClaim(reason)
            if session then session.Started = os.clock() end
            return claim(reason)
        end
        for _, key in ipairs(self.HalloweenMobKeys) do
            if lower:find(key, 1, true) then return realmClaim("boss realm") end
        end
        if inRealm and owner == Player.Name then return realmClaim("boss realm assigned") end
        if sessionFresh and session.Door then
            local cf = Compat.cframe(session.Door)
            if cf and (part.Position - cf.Position).Magnitude <= 160 then return realmClaim("boss door area") end
        end
    end
    if owner == Player.Name then
        for _, key in ipairs(self.HalloweenMobKeys) do
            if lower:find(key, 1, true) then return claim("assigned to me") end
        end
    end
    return false
end

function Hub:HalloweenEventEnemies()
    return self:Enemies(function(model)
        return self:HalloweenOwnEnemy(model)
    end, 400)
