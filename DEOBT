function Hub:CDKPedestalStep(good, evil)
    local cursed = Compat.find(Services.Workspace, { "Map", "Turtle", "Cursed" })
    if not cursed then self:ProgressStatus("Waiting for CDK temple"); return true end
    if good == 3 then
        local pedestal = cursed:FindFirstChild("Pedestal1", true)
        if pedestal then self:ProgressStatus("Placing Tushita shard"); self:ProgressMoveTouch(pedestal); return true end
    end
    if evil == 3 then
        local pedestal = cursed:FindFirstChild("Pedestal2", true)
        if pedestal then self:ProgressStatus("Placing Yama shard"); self:ProgressMoveTouch(pedestal); return true end
    end
    if good == 4 and evil == 4 then
        local boss = self:Enemies("Cursed Skeleton Boss")[1]
        if boss then self.ForcedWeapon = "Yama"; self:ProgressStatus("CDK final boss"); self:Fight(boss, boss.Name, false); return true end
        local opened, state = self:Comm("CDKQuest", "OpenDoor")
        if opened and state == "can" then self:Comm("CDKQuest", "OpenDoor", true); self:ProgressStatus("Opening CDK crypt"); return true end
        local pedestal = cursed:FindFirstChild("Pedestal3", true)
        if pedestal then
            local _, _, root = self:Character()
            local part = pedestal:FindFirstChildWhichIsA("BasePart", true)
            if root and part and (root.Position - part.Position).Magnitude > 8 then self:ProgressStatus("Moving to Alucard pedestal"); self:MoveTo(part.CFrame + Vector3.new(0, 3, 0)); return true end
            self:Comm("CDKQuest", "StartTrial", "Boss")
            self:Comm("CDKQuest", "SpawnBoss")
            self:ProgressStatus("Spawning CDK final boss")
            return true
        end
    end
    return false
end

function Hub:CDKStep()
    if self.Sea ~= "Sea3" then self:ProgressStatus("Cursed Dual Katana requires Third Sea"); return end
    if self:ProgressHas("Cursed Dual Katana") or self:ProgressHas("Dual Cursed Katana") then return self:ProgressDone("Cursed Dual Katana") end
    for _, sword in ipairs({ "Yama", "Tushita" }) do
        if not self:ProgressHas(sword) then if sword == "Yama" then self:YamaStep() else self:TushitaStep() end; return end
        local level, tool = self:ProgressToolLevel(sword)
        if not tool then self:Comm("LoadItem", sword); self:ProgressStatus("Loading " .. sword .. " mastery"); return end
        if (level or 0) < 350 then
            self.ForcedWeapon = sword
            self:ProgressStatus(sword .. " mastery " .. tostring(level or 0) .. "/350")
            self:FarmLevelStep()
            return
        end
    end
    local okProgress, progress = self:Comm("CDKQuest", "Progress", "Good")
    if not okProgress or type(progress) ~= "table" then self:ProgressStatus("CDK progress unavailable"); return end
    local good, evil = tonumber(progress.Good), tonumber(progress.Evil)
    if good == nil or evil == nil then self:ProgressStatus("CDK invalid progress"); return end
    if self:CDKPedestalStep(good, evil) then return end
    local side, state
    if evil ~= -2 and evil ~= 3 and evil ~= 4 then side, state = "Evil", evil else side, state = "Good", good end
    if state >= 0 then
        self:Comm("CDKQuest", "StartTrial", side)
        self:ProgressStatus("Starting CDK " .. side .. " trial")
        return
    end
    if side == "Evil" and state == -3 then
        local pirate = self:Enemies("Forest Pirate")[1]
        if pirate then
            local part = pirate:FindFirstChild("HumanoidRootPart") or pirate.PrimaryPart
            self.ForcedWeapon, self.Target = nil, nil
            if part then self:ProgressStatus("CDK Pain and Suffering"); self:MoveTo(part.CFrame + part.CFrame.LookVector * 3) end
        else self:ProgressFightBoss({ "Forest Pirate" }, "CDK Pain and Suffering") end
    elseif side == "Evil" and state == -4 then self:CDKHazeStep()
    elseif side == "Evil" and state == -5 then
        if self:CDKDimensionStep("HellDimension") then return end
        local reaper = self:Enemies("Soul Reaper")[1]
        if reaper then
            local part = reaper:FindFirstChild("HumanoidRootPart") or reaper.PrimaryPart
            self.ForcedWeapon, self.Target = nil, nil
            if part then self:ProgressStatus("CDK Fear the Reaper"); self:MoveTo(part.CFrame + part.CFrame.LookVector * 4) end
        else self:FullySoulReaperStep(); self:ProgressStatus("Summoning Soul Reaper for CDK") end
    elseif side == "Good" and state == -3 then self:CDKBoatStep()
    elseif side == "Good" and state == -4 then self:ProgressFarm({ "Mythological Pirate", "Forest Pirate", "Jungle Pirate" }, "CDK Pirate Raid at Castle", 1800)
    elseif side == "Good" and state == -5 then
        if self:CDKDimensionStep("HeavenlyDimension") then return end
        self:ProgressFightBoss({ "Cake Queen" }, "CDK Soulless: Cake Queen")
    else self:ProgressStatus("CDK " .. side .. " state " .. tostring(state)) end
end

function Hub:SoulGuitarStep()
