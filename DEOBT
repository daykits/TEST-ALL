function Hub:WebhookStats(force)
    if not force and not self:WebhookOn("Stats Report (5 min)") then return end
    local lines = { "**" .. Player.Name .. "** inventory:" }
    local inventory = self:Inventory(true)
    if type(inventory) == "table" and #inventory > 0 then
        local rows = {}
        for _, item in ipairs(inventory) do table.insert(rows, item) end
        table.sort(rows, function(a, b) return tostring(a.Name) < tostring(b.Name) end)
        local shown = math.min(#rows, 25)
        for index = 1, shown do
            local item = rows[index]
            local quantity = type(item.Quantity) == "number" and item.Quantity or 1
            table.insert(lines, "- " .. tostring(item.Name) .. (quantity > 1 and (" x" .. quantity) or ""))
        end
        if #rows > shown then table.insert(lines, "- ... and " .. (#rows - shown) .. " more items") end
    else
        table.insert(lines, "- Inventory unavailable")
    end
    self:WebhookSend("Stats Report", table.concat(lines, "\n"), 5793266, self:WebhookStatFields())
end

