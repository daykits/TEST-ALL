function Hub:RaceV2Flowers()
    if self.Sea ~= "Sea2" then return end
    local ok, state = self:RaceV2Query(1)
    if not ok then return end
    self.RaceV2Started = state == 1 or state == 2
    if state == -2 or Compat.find(Player, { "Data", "Race", "Evolved" }) then self.RaceV2Started = false; return end
    if state == -1 then self:Log("racev2", "Race V2 needs $500,000."); return end
    if state == 0 then
        local started, _, verified = self:RaceV2Start()
        self.RaceV2Started = started == true and (verified == 1 or verified == 2)
        if self.RaceV2Started then self:Log("racev2", "Race V2 flower quest started.") end
        return
    end
    if state == 2 or self:RaceV2HasAllFlowers() then
        local traded, _, verified = self:RaceV2Trade()
        if traded and (verified == -2 or Compat.find(Player, { "Data", "Race", "Evolved" })) then
            self.RaceV2Started = false
            self.InventoryTime = -100
            self:Log("racev2", "Race V2 completed.")
        elseif traded and verified == -1 then
            self:Log("racev2", "Race V2 needs $500,000.")
        end
        return
    end
    if state ~= 1 then return end
    if not self:RaceV2HasFlower(2) then
        local flower = Services.Workspace:FindFirstChild("Flower2", true) or Services.Workspace:FindFirstChild("Flower 2", true)
        if flower then
            local cf = Compat.cframe(flower)
            if cf then self:MoveTo(cf) end
        else
            self:Log("racev2", "Flower 2 not spawned.")
        end
        return
    end
    local flower1 = Services.Workspace:FindFirstChild("Flower1", true) or Services.Workspace:FindFirstChild("Flower 1", true)
    if not self:RaceV2HasFlower(1) and flower1 and (not Compat.isA(flower1, "BasePart") or flower1.Transparency ~= 1) then
        local cf = Compat.cframe(flower1)
        if cf then self:MoveTo(cf) end
        return
    end
    if not self:RaceV2HasFlower(3) then
        self:FarmGroup({ "Ship Deckhand", "Ship Engineer", "Ship Steward", "Ship Officer" })
    end
end

