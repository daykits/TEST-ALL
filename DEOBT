function Hub:ClaimTreat()
    if not self:HalloweenActive() then self:Notify("Halloween", "Halloween event is not active."); return end
    if self:HalloweenDialogue(true) or self:HalloweenBusy() then
        self:Notify("Halloween", "Door event is already in progress.")
        return
    end
    local _, _, root = self:Character()
    if not root then return end
    local best, bestScore
    for _, entry in ipairs(self:HalloweenDoors()) do
        if self:HalloweenDoorReady(entry) then
            entry.CFrame = Compat.cframe(entry.Door) or entry.CFrame
            local score = (root.Position - entry.CFrame.Position).Magnitude
            if self.Config["Halloween Boss Priority"] and self:HalloweenBossDoor(entry) then score -= 100000 end
            if not bestScore or score < bestScore then best, bestScore = entry, score end
        end
    end
    if not best then self:Notify("Halloween", "No ready Halloween door."); return end
    self.Target = nil
    local activation = math.min(best.Prompt.MaxActivationDistance or 10, 12)
    local distance = (root.Position - best.CFrame.Position).Magnitude
    if distance > 2000 and self:HalloweenPortalTravel(best) then
        _, _, root = self:Character()
        if not root then return end
        best.CFrame = Compat.cframe(best.Door) or best.CFrame
        distance = (root.Position - best.CFrame.Position).Magnitude
    end
    if distance > activation then
        local reached, problem = self:MoveUntil(best.CFrame + Vector3.new(0, 3, 0), function() return self.Alive and not self:HalloweenBusy() end, 60)
        if not reached then self:Notify("Halloween", tostring(problem or "Could not reach the door.")); return end
        _, _, root = self:Character()
        if not root then return end
        distance = (root.Position - best.CFrame.Position).Magnitude
        if distance > activation + 2 then self:Notify("Halloween", "Door is out of range."); return end
    end
    if os.clock() < (self.HalloweenNextKnock or 0) then self:Notify("Halloween", "Door knock is on cooldown."); return end
    self.HalloweenNextKnock = os.clock() + 5
    self.HalloweenKnockWaitUntil = os.clock() + 5
    self.HalloweenTried = self.HalloweenTried or setmetatable({}, { __mode = "k" })
    self.HalloweenTried[best.Door] = os.clock() + 20
    self.HalloweenCurrentDoor = best
    if self:HalloweenBossDoor(best) then self:HalloweenBossSessionStart(best) end
    self:CancelMove()
    if self:FirePrompt(best.Prompt) then
        self:Notify("Halloween", "Knocked door; waiting for the event.")
        return
    end
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", "HalloweenFunction" })
    if not Compat.isA(remote, "RemoteFunction") then self:Notify("Halloween", "HalloweenFunction unavailable."); return end
    local ok, result = pcall(remote.InvokeServer, remote, best.Door)
    if not ok then self:Notify("Halloween", "HalloweenFunction failed: " .. tostring(result)); return end
    if result == nil or result == false then
        self:Notify("Halloween", "Nobody is home or the door rejected the knock.")
    else
        self:Notify("Halloween", "Door answered; event started.")
    end
end

