function Hub:HalloweenNPCDestination(name)
    local normalized = tostring(name):lower():gsub("[%s%-_]", "")
    local folder = Services.Workspace:FindFirstChild("NPCs")
    if folder then
        local exact = folder:FindFirstChild(name)
        local cf = Compat.cframe(exact)
        if cf then return cf end
        for _, npc in ipairs(folder:GetChildren()) do
            if npc.Name:lower():gsub("[%s%-_]", "") == normalized then
                cf = Compat.cframe(npc)
                if cf then return cf end
            end
        end
        if #normalized >= 4 then
            for _, npc in ipairs(folder:GetChildren()) do
                if npc.Name:lower():gsub("[%s%-_]", ""):find(normalized, 1, true) then
                    cf = Compat.cframe(npc)
                    if cf then return cf end
                end
            end
        end
    end
    local cf = self:FindNPC(name)
    if cf then return cf end
    local guide = self:Guide()
    local list = guide and guide.Data and guide.Data.NPCList
    if type(list) == "table" then
        for _, npc in pairs(list) do
            if type(npc) == "table" and type(npc.NPCName) == "string"
                and (npc.NPCName == name or npc.NPCName:lower():gsub("[%s%-_]", "") == normalized) then
                return Compat.cframe(npc.Position)
            end
        end
    end
    if normalized == "witch" or normalized == "halloweenwitch" then
        local _, cauldronCFrame = self:HalloweenDapperCauldron()
        if cauldronCFrame then return cauldronCFrame end
    end
    return nil
end

function Hub:HalloweenGoNPC(name, auto, force)
    local destination = self:HalloweenNPCDestination(name)
    if not destination then return false, name .. " is unavailable in this place" end
    local _, _, root = self:Character()
    if not root then return false, "Character is not ready" end
    local cached, cachedAt = destination, 0
    local function flatDistance()
        local _, _, nowRoot = self:Character()
        if not nowRoot then return math.huge end
        if os.clock() - cachedAt > 1 then
            cached = self:HalloweenNPCDestination(name) or cached
            cachedAt = os.clock()
        end
        local delta = cached.Position - nowRoot.Position
        return Vector3.new(delta.X, 0, delta.Z).Magnitude
    end
    if flatDistance() <= 12 then
        self:CancelMove()
        return true
    end
    self.Target = nil
    self:HalloweenStatus("Moving to " .. name .. " | " .. math.floor((root.Position - destination.Position).Magnitude) .. " studs")
    local reached, problem = self:MoveUntil(destination, function()
        if not self.Alive then return false end
        if auto and not self:HalloweenAutoOn() then return false end
        if self.HalloweenBossSession or self:HalloweenInHellfireRealm() then return false end
        if flatDistance() <= 12 then return false end
        if force then return true end
        return self:HalloweenEnemy() == nil
    end, 75)
    if not reached and flatDistance() <= 15 then reached = true end
    if reached then self:CancelMove() end
    return reached, problem
end

