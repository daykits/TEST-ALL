local function normalizePSValue(value)
	return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function normalizePSName(value)
	return normalizePSValue(value):lower()
end

local function resolvePSCode()
	local cfg = DefaultConfig.MAIN
	local psConfig = cfg.PS_CODE
	if not psConfig then return "" end


	if type(psConfig) == "string" then
		local directCode = normalizePSValue(psConfig)
		if directCode == "Public" then return "" end
		return directCode
	end

	if type(psConfig) ~= "table" then
		return ""
	end

	local myName = normalizePSName(LocalPlayer.Name)
	local matches = {}

	for psCode, bots in pairs(psConfig) do
		if type(bots) == "table" then
			for _, entry in ipairs(bots) do
				local userName, weapon

				if type(entry) == "string" then
					userName = entry
				elseif type(entry) == "table" then
					userName = entry.user or entry.username or entry.name
					weapon = entry.weapon
				end

				if normalizePSName(userName) == myName then
					local cleanCode = normalizePSValue(psCode)
					table.insert(matches, {
						code = cleanCode,
						weapon = weapon,
					})
				end
			end
		end
	end

	if #matches == 0 then
		return ""
	end

	-- Si le même username est dans plusieurs PS codes, on évite le hasard de pairs().
	-- Priorité 1: garder le code déjà actif si c'est un des codes trouvés.
	local activeCode = normalizePSValue(getgenv().KaitunSea2Code or "")
	if activeCode ~= "" then
		for _, match in ipairs(matches) do
			if match.code == activeCode then
				if match.weapon then
					DefaultConfig.MAIN.RESOLVED_WEAPON = match.weapon
				end
				if match.code == "Public" then return "" end
				return match.code
			end
		end
	end

	-- Priorité 2: choisir toujours le même code de façon déterministe.
	-- Important: le mieux reste quand même de ne pas mettre un username dans 2 PS codes.
	table.sort(matches, function(a, b)
		return tostring(a.code) < tostring(b.code)
	end)

	local chosen = matches[1]
	DefaultConfig.MAIN.PS_CODE_DUPLICATE_MATCHES = #matches
	if chosen.weapon then
		DefaultConfig.MAIN.RESOLVED_WEAPON = chosen.weapon
	end
	if chosen.code == "Public" then return "" end
	return chosen.code

end

DefaultConfig.MAIN.RESOLVED_PS_CODE = resolvePSCode()

