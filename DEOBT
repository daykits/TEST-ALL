local function unw(value)
    local kind = type(value)
    if kind ~= "table" and kind ~= "userdata" then return value end
    local isOkFn, nullableFn, unwrapFn = false, false, false
    pcall(function()
        isOkFn = type(value.isOk) == "function"
        nullableFn = type(value.asNullable) == "function"
        unwrapFn = type(value.unwrap) == "function"
    end)
    if isOkFn then
        local out
        if pcall(function() if value:isOk() then out = value:unwrap() end end) then return out end
        return nil
    end
    if nullableFn then
        local out
        if pcall(function() out = value:asNullable() end) then return out end
        return nil
    end
    if unwrapFn then
        local out
        if pcall(function() out = value:unwrap() end) and out ~= nil then return out end
    end
    return value
end
local function canon(value)
