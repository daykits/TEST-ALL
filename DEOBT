							end

							break
						end

						if exitTo4 == 1 then
							continue
						end
					end

					break
				end
			elseif exitTo == 2 then
				local exitTo6

				while true do
					_tp(CFrame.new(-5046, 314, -2960))

					local exitTo5

					while _G.TpLab do
						wait()

						if _G.TpLab then
							if World2 and _G.TpLab then
								exitTo5 = 1

								break
							elseif World3 and _G.TpLab then
								exitTo5 = 2

								break
							end
						end
					end

					if exitTo5 == 1 then
						exitTo6 = 1

						break
					elseif exitTo5 == 2 then
						continue
					end

					break
				end

				if exitTo6 == 1 then
					while true do
						_tp(CFrame.new(-6438.73535, 250.645355, -4501.50684))
						exitTo2 = nil

						while _G.TpLab do
							wait()

							if _G.TpLab then
								if World2 and _G.TpLab then
									exitTo2 = 1

									break
