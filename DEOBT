function Hub:HalloweenDapperStep()
    if not self:HalloweenInDapperArena() then
        self.HalloweenArenaSince, self.HalloweenArenaIdleSince, self.HalloweenArenaSawBoss, self.HalloweenArenaExitSince, self.HalloweenArenaExiting = nil, nil, nil, nil, nil
        self.HalloweenArenaBossGoneSince, self.HalloweenArenaLootSeen = nil, nil
        return false
    end
    self.HalloweenArenaSince = self.HalloweenArenaSince or os.clock()
    if self:HalloweenBossEnemy() or self:HalloweenEnemy() then
        self.HalloweenArenaSawBoss = true
        self.HalloweenArenaIdleSince = nil
        self.HalloweenArenaBossGoneSince = nil
        return false
    end
    if self.HalloweenArenaSawBoss then
        self.HalloweenArenaBossGoneSince = self.HalloweenArenaBossGoneSince or os.clock()
    end
    local bossGoneFor = self.HalloweenArenaBossGoneSince and os.clock() - self.HalloweenArenaBossGoneSince or 0
    local cardPresent, candyPresent = self:HalloweenArenaLootPresent()
    if cardPresent or candyPresent then self.HalloweenArenaLootSeen = true end
    if self:HalloweenCardStep() then return true end
    if self:HalloweenCandySpillStep(true) then
        self.HalloweenArenaIdleSince = nil
        return true
    end
    if (cardPresent or candyPresent) and bossGoneFor <= 120 then
        self.HalloweenArenaIdleSince = nil
        self:HalloweenHold()
        self:HalloweenStatus("Great Pumpkin | Collecting arena loot before reset")
        return true
    end
    local active = false
    pcall(function() active = Services.Workspace:GetAttribute("DapperJackActive") == true end)
    if active and not self.HalloweenArenaSawBoss then
        self.HalloweenArenaIdleSince = nil
        self:HalloweenStatus("Great Pumpkin | Inside arena; waiting for Dapper Jack")
        return true
    end
    self.HalloweenRitualActive = false
    self.HalloweenArenaIdleSince = self.HalloweenArenaIdleSince or os.clock()
    local idleFor = os.clock() - self.HalloweenArenaIdleSince
    local insideFor = os.clock() - (self.HalloweenArenaSince or os.clock())
    if self.HalloweenArenaSawBoss and not self.HalloweenArenaLootSeen and bossGoneFor <= 15 then
        self:HalloweenStatus("Great Pumpkin | Waiting for boss loot")
        return true
    end
    if (self.HalloweenArenaSawBoss and idleFor <= 8) or (not self.HalloweenArenaSawBoss and insideFor <= 12) then
        self:HalloweenStatus("Great Pumpkin | Arena clear; waiting to return")
        return true
    end
    if self.HalloweenArenaSawBoss and not self:HalloweenPortalOpen() and self.HalloweenArenaDoneFor == nil then
        self.HalloweenArenaDoneFor = self:HalloweenRitualStart() or false
        self.HalloweenArenaDoneAt = os.clock()
    end
    if not active or (self.HalloweenArenaSawBoss and idleFor > 20) then
        self.HalloweenArenaExiting = true
        self.HalloweenArenaExitSince = self.HalloweenArenaExitSince or os.clock()
        self:HalloweenResetCharacter("Great Pumpkin")
        return true
    end
    self:HalloweenStatus("Great Pumpkin | Arena clear; waiting to return")
    return true
end

