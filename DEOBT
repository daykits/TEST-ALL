        self:ProgressStatus("Buying Draco V4 upgrade")
    else self:ProgressStatus("Draco V4 state " .. stage) end
end

function Hub:DracoStep()
    if self.Sea ~= "Sea3" then self:ProgressStatus("Draco requires Third Sea"); return end
    if self:DracoTrialStep() then return end
    local ok, data = self:NetCall("DragonWizard", { Command = "Speak" })
    if not ok or type(data) ~= "table" then self:ProgressStatus("Dragon Wizard unavailable"); return end
    if data.Race ~= "Draco" and data.CanTransform then
        self:NetCall("DragonWizard", { Command = "DragonRace" })
        self:ProgressStatus("Transforming into Draco")
        return
    end
    if data.CanLearnTether then self:NetCall("DragonWizard", { Command = "LearnTether" }); self:ProgressStatus("Learning Dragon Tether"); return end
    local quest = data.AvailableVQuest
    if quest == "V2" or quest == "V3" then
        self:NetCall("DragonWizard", { Command = "Ascension", Action = "Begin" })
        self:ProgressStatus("Starting Draco " .. quest)
    elseif quest == "V2TurnInReady" or quest == "V3TurnInReady" then
        self:NetCall("DragonWizard", { Command = "Ascension", Action = "Complete" })
        self:ProgressStatus("Completing Draco " .. quest:sub(1, 2))
    elseif quest == "V2InProgress" then
        local flower = Services.Workspace:FindFirstChild("Fire Flower", true) or Services.Workspace:FindFirstChild("FireFlower", true)
        if flower then self:ProgressStatus("Draco V2: collecting Fire Flower"); self:ProgressMoveTouch(flower)
        else self:ProgressFarm({ "Mythological Pirate", "Forest Pirate", "Fishman Raider", "Fishman Captain" }, "Draco V2: Fire Flowers", 2600); self:ProgressHopStep("Fire Flower cooldown", 330) end
    elseif data.V4 then self:DracoV4Step()
    elseif data.Race == "Draco" then self:ProgressStatus("Complete Dragon Dojo and Draco V3 before V4")
    end
end

function Hub:SubclassProgressStep()
    if self.Sea ~= "Sea3" then self:ProgressStatus("Subclass requires Third Sea"); return end
    local state = self:RefreshSubclasses(true)
    if not state then self:ProgressStatus("Subclass data unavailable"); return end
    if type(state.Owned) ~= "table" then
        local ok, stage = self:NetCall("InteractSubclassQuest", state.Name)
        if not ok then self:ProgressStatus("Subclass quest unavailable"); return end
        if stage == 1 then self:NetCall("StartSubclassQuest", state.Name); self:ProgressStatus("Starting " .. state.Name .. " quest")
        elseif stage == 2 then self:SubclassCall("PurchaseSubclass", state.Name); self:ProgressStatus("Purchasing " .. state.Name)
        else self:ProgressStatus(state.Name .. " quest locked") end
        return
    end
    if state.PlayerData.Equipped ~= state.Name then self:SubclassCall("EquipSubclass", state.Name); self:ProgressStatus("Equipping " .. state.Name); return end
    if self.Config["Auto Subclass Passives"] then
        for label in pairs(self.PassiveOptions or {}) do
            self:SetConfig("Selected Passive", label)
            local offer = self:PassiveOffer()
            if offer then
                local enough = self:CanAfford(offer.Cost)
                if enough then self:SubclassCall("PurchasePassive", offer.Name, offer.Key); self:ProgressStatus("Upgrading " .. tostring(offer.Definition.DisplayName or offer.Key)); return end
            end
        end
    end
    return self:ProgressDone(state.Name .. " subclass")
end

function Hub:ProgressRouteGoal()
    if self.Sea == "Sea2" then
        local ok, bartilo = self:Comm("BartiloQuestProgress", "Bartilo")
        if not ok or bartilo ~= 3 then return "Bartilo" end
        local raceOk, raceState = self:RaceV2Query(1)
        if raceOk and (raceState == -1 or raceState == 0 or raceState == 1 or raceState == 2) then return "Race V2" end
        local trevorOk, trevor = self:Comm("TalkTrevor", "1")
        if not trevorOk or trevor ~= 0 then return "Trevor" end
        if not self:ProgressHas("True Triple Katana") then return "True Triple Katana" end
        return "Fighting Style"
    elseif self.Sea == "Sea3" then
        local ok, citizen = self:Comm("CitizenQuestProgress", "Citizen")
        if not ok or citizen ~= 3 and citizen ~= 4 then return "Citizen" end
        if not self:ProgressHas("Yama") then return "Yama" end
        if not self:ProgressHas("Tushita") then return "Tushita" end
        if not self:ProgressHas("Cursed Dual Katana") and not self:ProgressHas("Dual Cursed Katana") then return "Cursed Dual Katana" end
        if not self:ProgressHas("Skull Guitar") and not self:ProgressHas("Soul Guitar") then return "Soul Guitar" end
        return "Fighting Style"
    end
    return "Fighting Style"
end

function Hub:RaceV4ProgressionStep()
    if self.Sea ~= "Sea3" then self:ProgressStatus("Race V4 requires Third Sea"); return end
    local ok, state = self:Comm("RaceV4Progress", "Check")
    self:ProgressStatus("Race V4 state " .. tostring(ok and state or "sync"))
    if ok and type(state) == "number" and state >= 1 and state <= 3 then self:RaceV4Step(); return end
    if state == 4 then
        local _, opened = self:Comm("CheckTempleDoor")
        if opened then self:RaceV4Step(); return end
        if not self:ProgressHas("Mirror Fractal") then self:DoughKingStep(); return end
        if not self:ProgressHas("Valkyrie Helm") and not self:ProgressHas("Valkyrie Helmet") then self:RipIndraStep(false); return end
        return
    end
    self:TrialStep()
end

function Hub:ProgressionStep()
    self.ForcedWeapon = nil
    local goal = self.Config["Progress Goal"]
    if goal == "Auto Route" then goal = self:ProgressRouteGoal() end
    local steps = {
        Bartilo = self.BartiloStep, Citizen = self.CitizenStep, Trevor = self.TrevorStep,
        ["Race V2"] = self.RaceV2ProgressStep, ["True Triple Katana"] = self.TTKStep,
        Cyborg = self.CyborgStep, Ghoul = self.GhoulStep, ["Phoenix Raid"] = self.PhoenixStep,
        ["Fighting Style"] = self.FightingStyleStep, Yama = self.YamaStep, Tushita = self.TushitaStep,
        ["Cursed Dual Katana"] = self.CDKStep, ["Soul Guitar"] = self.SoulGuitarStep,
        rip_indra = function(hub) hub:RipIndraStep(false) end, ["Dough King"] = self.DoughKingStep,
        ["Dark Blade"] = self.DarkBladeStep, ["Dragon Dojo"] = self.DojoStep, ["Dragon Hunter"] = self.DragonHunterStep,
        ["Race V3"] = function(hub) hub:ProgressStatus("Race V3 active"); hub:RaceV3Step() end,
        ["Race V4"] = self.RaceV4ProgressionStep,
        Draco = self.DracoStep, Subclass = self.SubclassProgressStep,
    }
    local step = steps[goal]
    if step then step(self) else self:ProgressStatus("Unsupported goal: " .. tostring(goal)) end
end

function Hub:SeaCancelBoatTween()
    local tween = self.SeaBoatTween
    local connection = self.SeaBoatTweenConnection
    local seat = self.SeaBoatTweenSeat
    self.SeaBoatTween = nil
    self.SeaBoatTweenConnection = nil
    self.SeaBoatTweenSeat = nil
    self.SeaBoatTweenBoat = nil
    self.SeaBoatTweenTarget = nil
    if connection then pcall(connection.Disconnect, connection) end
    if tween then pcall(tween.Cancel, tween) end
    if seat and seat.Parent then
        pcall(function()
            seat.AssemblyLinearVelocity = Vector3.zero
            seat.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

function Hub:SeaStopBoatControls()
    self:SeaCancelBoatTween()
    local boat = self:OwnBoat()
    local seat = boat and boat:FindFirstChild("VehicleSeat", true)
    if seat then seat.ThrottleFloat = 0; seat.SteerFloat = 0 end
    pcall(function()
        local input = game:GetService("VirtualInputManager")
        for _, key in ipairs({ Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.D }) do input:SendKeyEvent(false, key, false, game) end
    end)
end

function Hub:SeaBoatCruiseY(seat)
    local boat = seat and seat:FindFirstAncestorOfClass("Model")
    local height = tonumber(self.Config["Sea Boat Height"]) or 12
    if self.SeaBoatLaneBoat ~= boat or type(self.SeaBoatLaneY) ~= "number" then
        self.SeaBoatLaneBoat = boat
        self.SeaBoatLaneY = seat.Position.Y
    elseif not self.SeaBoatTween and math.abs(seat.Position.Y - (self.SeaBoatLaneY + height)) > 80 then
        self.SeaBoatLaneY = seat.Position.Y
    end
    return self.SeaBoatLaneY + height
end

function Hub:SeaBoatDrive(seat, destination)
    local targetCFrame = Compat.cframe(destination)
    local char, humanoid = self:Character()
    if not Compat.isA(seat, "VehicleSeat") or not targetCFrame or not humanoid or humanoid.SeatPart ~= seat then
        self:SeaCancelBoatTween()
        return false
    end
    local requestedPosition = targetCFrame.Position
    local target = Vector3.new(requestedPosition.X, self:SeaBoatCruiseY(seat), requestedPosition.Z)
    local delta = target - seat.Position
    if delta.Magnitude < 30 then self:SeaStopBoatControls(); return true end
    local flat = Vector3.new(delta.X, 0, delta.Z)
    if flat.Magnitude > 1 then targetCFrame = CFrame.lookAt(target, target + flat.Unit) end
    if self.SeaBoatTween and self.SeaBoatTweenSeat == seat and self.SeaBoatTweenTarget then
        local remaining = self.SeaBoatTweenTarget - seat.Position
        local requested = target - seat.Position
        local sameHeight = math.abs(self.SeaBoatTweenTarget.Y - target.Y) < 1
        local sameTarget = sameHeight and (self.SeaBoatTweenTarget - target).Magnitude < 100
        local samePath = sameHeight and remaining.Magnitude > 100 and requested.Magnitude > 100 and remaining.Unit:Dot(requested.Unit) > 0.97
        if sameTarget or samePath then return false end
    end
    self:SeaCancelBoatTween()
    seat.ThrottleFloat = 0
    seat.SteerFloat = 0
    pcall(function()
        local input = game:GetService("VirtualInputManager")
        for _, key in ipairs({ Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.D }) do input:SendKeyEvent(false, key, false, game) end
    end)
    local distance = (target - seat.Position).Magnitude
    local tween = Services.TweenService:Create(seat, TweenInfo.new(math.max(distance / 300, 0.05), Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    self.SeaBoatTween = tween
    self.SeaBoatTweenSeat = seat
    self.SeaBoatTweenBoat = seat:FindFirstAncestorOfClass("Model")
    self.SeaBoatTweenTarget = target
    self.SeaBoatTweenConnection = tween.Completed:Connect(function()
        if self.SeaBoatTween ~= tween then return end
        local connection = self.SeaBoatTweenConnection
        self.SeaBoatTween = nil
        self.SeaBoatTweenConnection = nil
        self.SeaBoatTweenSeat = nil
        self.SeaBoatTweenBoat = nil
        self.SeaBoatTweenTarget = nil
        if connection then connection:Disconnect() end
        if seat.Parent then
            seat.ThrottleFloat = 0
            seat.SteerFloat = 0
            seat.AssemblyLinearVelocity = Vector3.zero
            seat.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    tween:Play()
    return false
end

function Hub:AutoCraftRecipe(name)
    local checked, recipe = self:NetCall("Craft", "Check", name)
    if not checked or type(recipe) ~= "table" or type(recipe.Required) ~= "table" then return false end
    for _, row in ipairs(self:CostRows(recipe.Required)) do
        local amount = self:ItemQuantity(row.Name) or 0
        if amount < row.Amount then return false end
    end
    local ok, result = self:NetCall("Craft", "Craft", name, 1, recipe.Required)
    if ok and result ~= false then self.InventoryTime = -100; return true end
    return false
end

function Hub:RecipeMissingMaterial(name)
    local checked, recipe = self:NetCall("Craft", "Check", name)
    if not checked or type(recipe) ~= "table" then return nil end
    for _, row in ipairs(self:CostRows(recipe.Required or {})) do
        local amount = self:ItemQuantity(row.Name) or 0
        if amount < row.Amount then return row.Name, amount, row.Amount end
    end
    return nil
end

