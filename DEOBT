			local hum = npc:FindFirstChild("Humanoid")

			local hrp = npc:FindFirstChild("HumanoidRootPart")

			if hum and hum.Health > 0 and hrp then

				local y = hrp.Position.Y

				if y >= H.YETI_MIN_SAFE_Y and y <= H.YETI_MAX_SAFE_Y then

					table.insert(result, { npc = npc, hrp = hrp })

				end

			end

		end

	end

	return result

end

local function getTargetedYetis()

	local result = {}

	local used = {}

	for _, spot in ipairs(H.YETI_TARGET_SPOTS or {}) do

		if typeof(spot) == "Vector3" then

			local bestNpc = nil

			local bestDist = math.huge

			for _, d in ipairs(getAllYetis()) do

				if d.npc and d.hrp and not used[d.npc] and isInsideYetiZone(d.hrp.Position) then

					local hum = d.npc:FindFirstChild("Humanoid")

					if hum and hum.Health > 0 then

						local dist = (spot - d.hrp.Position).Magnitude

						if dist < bestDist then

							bestDist = dist

							bestNpc = d.npc

						end

					end

				end

			end

			if bestNpc and bestDist <= (H.YETI_TARGET_MAX_DISTANCE or 45) then

				used[bestNpc] = true

				table.insert(result, bestNpc)

			end

		end

	end

	return result

end

local function getClosestYeti()

	local rp = getHRP()

	if not rp then return nil end

	local closest, bestDist = nil, math.huge

	for _, npc in ipairs(getTargetedYetis()) do

		local hrp = npc and npc:FindFirstChild("HumanoidRootPart")

		local hum = npc and npc:FindFirstChild("Humanoid")

		if hrp and hum and hum.Health > 0 then

			local dist = (rp.Position - hrp.Position).Magnitude

			if dist < bestDist then

				closest = npc

				bestDist = dist

			end

		end

	end

	return closest

end

local function shouldAbandonYeti(yetiHrp)

	if not yetiHrp then return true end

	local bestSpotDist = math.huge

	local closestSpot = nil

	for _, spot in ipairs(H.YETI_TARGET_SPOTS or {}) do

		if typeof(spot) == "Vector3" then

			local flatDist = Vector3.new(

				yetiHrp.Position.X - spot.X,

				0,

				yetiHrp.Position.Z - spot.Z

			).Magnitude

			if flatDist < bestSpotDist then

				bestSpotDist = flatDist

				closestSpot = spot

			end

		end

	end

	if not closestSpot then

		return false

	end

	if bestSpotDist > (H.YETI_ABANDON_DISTANCE or 38) then

		return true

	end

	if yetiHrp.Position.Y < closestSpot.Y - (H.YETI_ABANDON_Y_DROP or 25) then

		return true

	end

	return false

end

local function attackYeti(yeti)

	setNoclip(true)

	if not yeti then return false end

	local hum = yeti:FindFirstChild("Humanoid")

	local firstHrp = yeti:FindFirstChild("HumanoidRootPart")

	if not hum or hum.Health <= 0 or not firstHrp then return false end

	local hoverHeight = H.YETI_HOVER_HEIGHT or 8.3

	-- Verrou permanent pendant tout le combat: tant que ce Yeti est vivant,

	-- on reste colle a lui et on continue les combos sans retourner au farmPos.

	local lockActive = true

	local humSelf = getHumanoid()

	if humSelf then humSelf.AutoRotate = false end

	local lockConn = RunService.Heartbeat:Connect(function()

		if not lockActive then return end

		local liveHrp = yeti and yeti:FindFirstChild("HumanoidRootPart")

		local liveHum = yeti and yeti:FindFirstChild("Humanoid")

		local rp = getHRP()

		local hs = getHumanoid()

		if not rp or not hs or hs.Health <= 0 or not liveHrp or not liveHum or liveHum.Health <= 0 then return end

		setNoclip(true)

		hs.AutoRotate = false

		local liveCombatY = liveHrp.Position.Y + hoverHeight

		local cf = getYetiCombatCFrame(liveHrp, liveCombatY, rp)

		if cf then

			local clampedPos = clampToYetiZone(cf.Position)

			local clampedCf = cf - cf.Position + clampedPos

			rp.CFrame = clampedCf

			rp.AssemblyLinearVelocity = Vector3.zero

			rp.AssemblyAngularVelocity = Vector3.zero

		end

	end)

	local killed = false

	local combo = 1

	while getgenv().KaitunFarm and not hasHaki() do

		setNoclip(true)

		local hrp = yeti:FindFirstChild("HumanoidRootPart")

		hum = yeti:FindFirstChild("Humanoid")

		local rp = getHRP()

		if not hrp or not rp or not hum then

			break

		end

		if hum.Health <= 0 then

			killed = true

			break

		end

		local selfHum = getHumanoid()

		if selfHum and selfHum.Health <= (H.HAKI_LOW_HP_THRESHOLD or 100) then

			break

		end

		if shouldAbandonYeti(hrp) then

			break

		end

		local hrpList = { hrp }

		local npcIDs = {}

		local id = getNPCID(yeti)

		if id then table.insert(npcIDs, id) end

		pcall(function()

			local current = getHRP()

			if current then

				local liveCombatY = hrp.Position.Y + hoverHeight

				local cf = getYetiCombatCFrame(hrp, liveCombatY, current)

				if cf then

					current.CFrame = cf - cf.Position + clampToYetiZone(cf.Position)

					current.AssemblyLinearVelocity = Vector3.zero

					current.AssemblyAngularVelocity = Vector3.zero

				end

			end

			combatRegister:InvokeServer({

				[1] = "swingsfx", [2] = "Melee", [3] = combo,

				[4] = "Ground", [5] = false, [6] = CombatAnims[combo],

				[7] = 2, [8] = 1.5,

			})

			current = getHRP()

			local packet = {

				[1] = {

					[1] = "damage", [2] = hrpList, [3] = "Melee",

					[4] = { combo, "Ground", "Melee" }, [5] = true,

					[6] = current and current.CFrame or CFrame.new(hrp.Position.X, hrp.Position.Y + hoverHeight, hrp.Position.Z),

					aircombo = "Ground",

				}

			}

			if #npcIDs > 0 then packet[1].NPCIDs = npcIDs end

			combatRegister:InvokeServer(unpack(packet))

		end)

		combo = combo % 5 + 1

		task.wait(0.18)

	end

	task.wait(0.25)

	lockActive = false

	if lockConn then lockConn:Disconnect() end

	local humEnd = getHumanoid()

	if humEnd then humEnd.AutoRotate = true end

	local after = yeti:FindFirstChild("Humanoid")

	return killed or not after or after.Health <= 0

end

