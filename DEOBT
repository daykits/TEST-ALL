	local questName = "Road to Armament"

	local currentQuest = getQuest()

	local maxKills = 50

	local questKills = nil

	local debugSource = nil

	local function scanText(t, sourceName)

		if type(t) ~= "string" or t == "" then return end

		-- Match "X / Y" avec espaces optionnels et n'importe quel suffixe

		-- (ex: "1 / 50 Yeti", "1/50", "Beat Yetis: 1/50").

		local a, b = t:match("(%d+)%s*/%s*(%d+)")

		a, b = tonumber(a), tonumber(b)

		if a and b and b > 0 and b <= 100 then

			local newKills = math.clamp(math.floor(a), 0, b)

			if not questKills or newKills > questKills then

				questKills = newKills

				maxKills = math.clamp(math.floor(b), 1, 100)

				debugSource = sourceName or "?"

			end

		end

	end

	local function scanInstanceText(inst)

		if not inst then return end

		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then

			scanText(inst.Text, inst:GetFullName())

		end

	end

	-- 1) Source la plus fiable : le GUI de quete PlayerGui.Quest.Main.Misc.

	--    BusoMastery sert d'ancre, et le texte "11 / 50 Yeti" est scanne

	--    dans le meme bloc Quest.

	pcall(function()

		local pg = LocalPlayer:FindFirstChild("PlayerGui")

		if not pg then return end

		local questGui = pg:FindFirstChild("Quest")

		if not questGui then return end

		local main = questGui:FindFirstChild("Main")

		local misc = main and main:FindFirstChild("Misc")

		local busoMastery = misc and misc:FindFirstChild("BusoMastery")

		if misc then

			for _, d in ipairs(misc:GetDescendants()) do

				scanInstanceText(d)

			end

		end

		if main then

			for _, d in ipairs(main:GetDescendants()) do

				scanInstanceText(d)

			end

		end

		if busoMastery then

			scanInstanceText(busoMastery)

			for _, d in ipairs(busoMastery:GetDescendants()) do

				scanInstanceText(d)

			end

		end

		for _, d in ipairs(questGui:GetDescendants()) do

			scanInstanceText(d)

		end

	end)

	-- 2) Fallback : lire le dossier Quest cÃ´tÃ© ReplicatedStorage si le GUI

	--    n'a rien donnÃ©.

	if not questKills then

		local root = getStatsRoot()

		local questFolder = root and root:FindFirstChild("Quest")

		if questFolder then

			for _, obj in ipairs(questFolder:GetDescendants()) do

				if obj:IsA("IntValue") or obj:IsA("NumberValue") then

					local name = string.lower(obj.Name or "")

					local value = tonumber(obj.Value)

					if value then

						if name:find("progress") or name:find("kill") or name:find("count")

							or name:find("amount") or name:find("current") or name == "value" then

							if value >= 0 and value <= 50 then

								questKills = math.max(questKills or 0, math.floor(value))

								debugSource = "RS:" .. obj:GetFullName()

							end

						elseif name:find("required") or name:find("needed") or name:find("need")

							or name:find("max") or name:find("total") or name:find("goal") then

							if value > 0 and value <= 100 then

								maxKills = math.floor(value)

							end

						end

					end

				elseif obj:IsA("StringValue") then

					scanText(tostring(obj.Value or ""), "RS:" .. obj:GetFullName())

				end

			end

		end

	end

	-- 3) Si on n'a rien trouvÃ© cette fois-ci (PlayerGui pas encore prÃªt

	--    juste aprÃ¨s le respawn par exemple), on garde la derniÃ¨re valeur

	--    connue plutÃ´t que de retomber Ã  0.

	if questKills then

		H.lastQuestProgressKills = questKills

		H.lastQuestProgressMax = maxKills

		H.lastQuestProgressSource = debugSource

	else

		if H.lastQuestProgressKills then

			questKills = H.lastQuestProgressKills

			maxKills = H.lastQuestProgressMax or maxKills

			H.lastQuestProgressSource = (H.lastQuestProgressSource or "?") .. " (cached)"

		else

			H.lastQuestProgressSource = nil

		end

	end

	return questKills or fallbackKills or 0, maxKills

end

local function setNoclip(state)

	H.noclipActive = state == true

	if H.noclipActive and not H.noclipConn then

		local cachedChar = nil

		local cachedParts = {}

		local lastCacheTime = 0

		H.noclipConn = RunService.Stepped:Connect(function()

			if not H.noclipActive then return end

			local char = getCharacter()

			if not char then return end

			local now = tick()

			if char ~= cachedChar or now - lastCacheTime >= 2 then

				cachedChar = char

				cachedParts = {}

				lastCacheTime = now

				for _, obj in ipairs(char:GetDescendants()) do

					if obj:IsA("BasePart") then

						table.insert(cachedParts, obj)

					end

				end

			end

			for _, obj in ipairs(cachedParts) do

				if obj and obj.Parent then obj.CanCollide = false end

			end

			if now - (H.lastNoclipTakeStam or 0) >= 0.30 then

				H.lastNoclipTakeStam = now

				fireTakeStamDash()

			end

		end)

	elseif not H.noclipActive and H.noclipConn then

		H.noclipConn:Disconnect()

		H.noclipConn = nil

	end

end

