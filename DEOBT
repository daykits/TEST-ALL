    end

    local function sliderScale(minimum, maximum, default)
        local function whole(n) return type(n) ~= "number" or n == math.floor(n) end
        if whole(minimum) and whole(maximum) and whole(default) then return 1 end
        return (maximum - minimum) <= 1 and 100 or 10
    end

    local function makeTab(title)
        local page = window:AddTab(title)
        local tab, current = {}, nil
        local function target()
            if not current then current = newSection(page, title) end
            return current
        end

        function tab:AddSection(name)
            current = newSection(page, name)
            return tab
        end

        function tab:AddToggle(opts)
            local control, silent = { Value = opts.Default == true }, false
            local inner = target():AddToggle(nil, {
                Title = opts.Title, Desc = opts.Description, Default = control.Value,
                Callback = function(value)
                    control.Value = value
                    if not silent and opts.Callback then opts.Callback(value) end
                end,
            })
            function control:SetValue(value)
                value = value == true
                if control.Value == value then return end
                silent = true
                pcall(inner.SetStage, value)
                silent = false
                control.Value = value
            end
            return control
        end

        function tab:AddButton(opts)
            local cooldown, last = tonumber(opts.Cooldown) or 0, 0
            return target():AddButton({
                Title = opts.Title, Desc = opts.Description,
                Callback = function()
                    if cooldown > 0 then
                        local now = os.clock()
                        if now - last < cooldown then return end
                        last = now
                    end
                    if opts.Callback then opts.Callback() end
                end,
            })
        end

        function tab:AddDropdown(opts)
            local values = {}
            for _, value in ipairs(opts.Options or {}) do table.insert(values, tostring(value)) end
            local control = { Value = nil }
            local default = opts.Default ~= nil and tostring(opts.Default) or nil
            if default and table.find(values, default) then control.Value = default else default = nil end
            local inner = target():AddDropdown(nil, {
                Title = opts.Title, Values = values, Default = default,
                Search = #values == 0 or #values > 8,
                Callback = function(value)
                    control.Value = value
                    if opts.Callback then opts.Callback(value) end
                end,
            })
            function control:NewOptions(...)
                local list = {}
                for _, value in ipairs({ ... }) do table.insert(list, tostring(value)) end
                inner:GetNewList(list)
                if control.Value and table.find(list, control.Value) then
                    pcall(inner.ClearText, inner, control.Value)
                else
                    control.Value = nil
                end
            end
            function control:Clear()
                inner:GetNewList({})
                control.Value = nil
            end
            function control:SetValue(value) pcall(inner.SetValue, inner, value) end
            function control:GetValue() return control.Value end
            return control
        end

        function tab:AddInput(opts)
            local control = { Value = opts.Default and tostring(opts.Default) or "" }
            local inner = target():AddInput(nil, {
                Text = opts.Title, Placeholder = opts.Placeholder or "",
                Default = control.Value ~= "" and control.Value or false,
                Callback = function(value)
                    control.Value = tostring(value or "")
                    if opts.Callback then pcall(opts.Callback, control.Value) end
                end,
            })
            function control:SetValue(value)
                control.Value = tostring(value or "")
                if inner and type(inner.SetValue) == "function" then pcall(inner.SetValue, control.Value) end
            end
            return control
        end

        function tab:AddSlider(opts)
            local minimum, maximum = tonumber(opts.Min) or 0, tonumber(opts.Max) or 100
            local default = tonumber(opts.Default) or minimum
            local scale = sliderScale(minimum, maximum, default)
            local lastValue
            local label = opts.Title
            if scale ~= 1 then label = string.format("%s (x%d)", tostring(opts.Title), scale) end
            local inner = target():AddSlider({
                Title = label,
                Min = math.floor(minimum * scale + 0.5), Max = math.floor(maximum * scale + 0.5),
                Default = math.floor(default * scale + 0.5),
                Callback = function(value)
                    if type(value) ~= "number" then return end
                    value = value / scale
                    if value == lastValue then return end
                    lastValue = value
                    if opts.Callback then opts.Callback(value) end
                end,
            })
            return { SetValue = function(_, value) pcall(inner.SetValue, value * scale) end }
        end

        function tab:AddParagraph(title, content)
            local control, heading, body = {}, tostring(title or ""), tostring(content or "")
            local function compose()
                if body == "" then return heading end
                if body:find("\n", 1, true) then return heading .. ":\n" .. body end
                return heading .. ": " .. body
            end
            local inner = target():AddLabel(compose())
            function control:SetDescription(text)
                body = tostring(text or "")
                pcall(inner.SetText, inner, compose())
            end
            function control:SetTitle(text)
                heading = tostring(text or "")
                pcall(inner.SetText, inner, compose())
            end
            return control
        end

        function tab:AddDiscordInvite(opts)
            tab:AddSection(opts.Title or "Discord")
