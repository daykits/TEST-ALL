        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 4,
        Parent = row,
    })

    local svBox = New("Frame", {
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 60),
        ZIndex = 5,
        Parent = editor,
    })
    Corner(6).Parent = svBox
    -- White gradient overlay
    New("UIGradient", {
        Color = ColorSequence.new(Color3.new(1,1,1), Color3.fromHSV(h, 1, 1)),
        Rotation = 0,
        Parent = svBox,
    })
    -- Black vertical
    local black = New("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 6,
        Parent = svBox,
    })
    New("UIGradient", {
        Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(0,0,0)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Rotation = 90,
        Parent = black,
    })
    Corner(6).Parent = black

    local svCursor = New("Frame", {
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(10, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(s, 0, 1 - v, 0),
        ZIndex = 7,
        Parent = svBox,
    })
    Corner(5).Parent = svCursor
    Stroke(Color3.new(0,0,0), 1).Parent = svCursor

    local hueBar = New("Frame", {
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 14),
        Position = UDim2.new(0, 0, 0, 66),
        ZIndex = 5,
        Parent = editor,
    })
    Corner(7).Parent = hueBar
    New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromHSV(0.00, 1, 1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
            ColorSequenceKeypoint.new(0.50, Color3.fromHSV(0.50, 1, 1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
            ColorSequenceKeypoint.new(1.00, Color3.fromHSV(1.00, 1, 1)),
        }),
        Parent = hueBar,
    })
    local hueCursor = New("Frame", {
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(6, 18),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(h, 0, 0.5, 0),
        ZIndex = 7,
        Parent = hueBar,
    })
    Corner(3).Parent = hueCursor

    local hexBox = New("TextBox", {
        BackgroundColor3 = theme.Secondary,
        BorderSizePixel = 0,
        Text = Color3ToHex(color),
        Font = Enum.Font.Code,
        TextSize = 12,
        TextColor3 = theme.Text,
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 0, 88),
        ClearTextOnFocus = false,
        ZIndex = 5,
        Parent = editor,
    })
    Corner(6).Parent = hexBox
    Padding(0, 0, 8, 0).Parent = hexBox

    local function updateFromHSV(fire)
        color = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = color
        svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
        hexBox.Text = Color3ToHex(color)
        if fire then SafeCall(cfg.Callback, color) end
    end

    local function bindDrag(region, onMove)
        local dragging = false
        region.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                onMove(input.Position)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                onMove(input.Position)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    bindDrag(svBox, function(pos)
        local ap, as = svBox.AbsolutePosition, svBox.AbsoluteSize
        s = Clamp((pos.X - ap.X) / math.max(as.X, 1), 0, 1)
        v = 1 - Clamp((pos.Y - ap.Y) / math.max(as.Y, 1), 0, 1)
        updateFromHSV(true)
    end)

    bindDrag(hueBar, function(pos)
        local ap, as = hueBar.AbsolutePosition, hueBar.AbsoluteSize
        h = Clamp((pos.X - ap.X) / math.max(as.X, 1), 0, 1)
        updateFromHSV(true)
    end)

    hexBox.FocusLost:Connect(function()
        local c = HexToColor3(hexBox.Text)
        if c then
            h, s, v = c:ToHSV()
            updateFromHSV(true)
        else
            hexBox.Text = Color3ToHex(color)
        end
    end)

    expandBtn.MouseButton1Click:Connect(function()
        expanded = not expanded
        editor.Visible = expanded
    end)

    function comp.SetColor(c)
        if typeof(c) ~= "Color3" then return end
        color = c
        h, s, v = c:ToHSV()
        updateFromHSV(false)
    end
    function comp.GetColor() return color end
    function comp.SetCallback(fn) cfg.Callback = fn end
    function comp.SetEnabled(b) comp._enabled = b and true or false end
    function comp.Destroy() comp.Container:Destroy() end
    function comp:_ApplyTheme(t)
        swatch.BackgroundColor3 = color
        hexBox.BackgroundColor3 = t.Secondary
        hexBox.TextColor3 = t.Text
    end

    table.insert(section.Components, comp)
    return comp
end

