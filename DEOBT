    button(settings, "Discord", function() self:Clipboard("https://discord.gg/vE4rd6cwe2") end)
    button(settings, "Unload", function() self:Stop() end)
    self:Connect(Services.UserInputService.JumpRequest, function()
        if self.Config["Inf Jump"] then
            local _, hum = self:Character()
            if hum then pcall(hum.ChangeState, hum, Enum.HumanoidStateType.Jumping) end
        end
    end)
    self:Connect(Services.RunService.Stepped, function()
        if not self.Config["Anti Stun"] and not self.Config["Noclip"] and not self.NoclipWasOn then return end
        if self.Config["Anti Stun"] then
            local _, hum = self:Character()
            if hum then
                if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
                if hum.JumpPower < 50 then hum.JumpPower = 50 end
            end
            local char = Player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, item in ipairs(root:GetChildren()) do
                    if item.Name ~= "BaconHubBodyClip" and (item:IsA("BodyVelocity") or item:IsA("BodyPosition")
                        or item:IsA("BodyForce") or item:IsA("LinearVelocity") or item:IsA("AlignPosition")) then
                        pcall(item.Destroy, item)
                    end
                end
            end
        end
        if self.Config["Noclip"] then
            self.NoclipWasOn = true
            local char = Player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        elseif self.NoclipWasOn then
            self.NoclipWasOn = nil
            local char = Player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
                end
            end
        end
    end)
    self:Connect(Services.RunService.RenderStepped, function()
        if not self.Config["Walk Speed"] and not self.Config["Power Jump"] and not self.Config["SpinBot"]
            and not self.SpeedWasOn and not self.JumpWasOn then return end
        local _, hum = self:Character()
        if self.Config["Walk Speed"] then
            self.SpeedWasOn = true
            if hum then hum.WalkSpeed = self.Config["Speed Value"] end
        elseif self.SpeedWasOn then
            self.SpeedWasOn = nil
            if hum then hum.WalkSpeed = 16 end
        end
        if self.Config["Power Jump"] then
            self.JumpWasOn = true
            if hum then hum.JumpPower = self.Config["Jump Value"] end
        elseif self.JumpWasOn then
            self.JumpWasOn = nil
            if hum then hum.JumpPower = 50 end
        end
        if self.Config["SpinBot"] and not self.Tween then
            local _, _, root = self:Character()
            if root then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(self.Config["Spin Speed"] or 20), 0) end
        end
    end)
    self:InstallSilentHook()
    self.BuildingUI = false
    if self.SeaConfigDirty then self.SeaConfigDirty = nil; self:SaveConfig() end
    return true
end

