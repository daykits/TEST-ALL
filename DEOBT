function Hub:SecretEscape(row, moment, handler, state)
    local _, _, root = self:Character()
    state = state or self.SecretActions[row.Address] or {}
    local locked = state.EscapeTarget
    local lockedHumanoid = locked and locked:FindFirstChildOfClass("Humanoid")
    if lockedHumanoid and lockedHumanoid.Health <= 0 then
        state.EscapeTarget, state.EscapeOrigin, state.EscapeKey, state.EscapeWaitUntil = nil, nil, nil, nil
        self.Target = nil
        self:SecretStatus(row, "Prisoner | Defeated")
        return true
    end
    if not self:AliveEnemy(locked) and state.EscapeOrigin then
        local best, bestDistance
        for _, enemy in ipairs(self:Enemies(handler.Enemies, 5000)) do
            local part = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
            local distance = part and (part.Position - state.EscapeOrigin).Magnitude or math.huge
            if distance <= 140 and (not bestDistance or distance < bestDistance) then best, bestDistance = enemy, distance end
        end
        if best then state.EscapeTarget, locked = best, best end
    end
    if self:AliveEnemy(locked) then
        local humanoid = locked:FindFirstChildOfClass("Humanoid")
        self.SecretCombatAllowed = true
        self:Fight(locked, locked.Name, false)
        self:SecretStatus(row, "Prisoner | Locked " .. tostring(state.EscapeKey or locked.Name) .. " | " .. tostring(math.floor(humanoid and humanoid.Health or 0)) .. " HP")
        return true
    end
    if state.EscapeTarget then
        if os.clock() < (state.EscapeWaitUntil or 0) then
            local part = self:SecretObjectPart(state.EscapeTarget)
            if part and root and (root.Position - part.Position).Magnitude > 18 then self:MoveTo(part.CFrame + Vector3.new(0, 3, 0)) end
            self:SecretStatus(row, "Prisoner | Waiting for hostile spawn " .. tostring(state.EscapeKey or ""))
            return true
        end
        state.EscapeTarget, state.EscapeOrigin, state.EscapeKey, state.EscapeWaitUntil = nil, nil, nil, nil
        self.Target = nil
        return true
    end
    local prisoners = moment and moment.MiscData and moment.MiscData.Prisoners
    if root and type(prisoners) == "table" then
        local chosenKey, chosenData, chosenPart, chosenDistance
        for key, data in pairs(prisoners) do
            local model = type(data) == "table" and data.Model or nil
            local part = self:SecretObjectPart(model)
            if type(key) == "string" and part and data.Confronted ~= true then
                local distance = (root.Position - part.Position).Magnitude
                if not chosenDistance or distance < chosenDistance then
                    chosenKey, chosenData, chosenPart, chosenDistance = key, data, part, distance
                end
            end
        end
        if chosenPart then
            if chosenDistance > 15 then
                self:MoveTo(chosenPart.CFrame + Vector3.new(0, 2, 0))
                self:SecretStatus(row, "Prisoner | Approach " .. chosenKey)
            else
                local ok, reply = self:SecretRemote(row, moment, "Provoke", true, 1, chosenKey)
                if ok and reply ~= false then
                    chosenData.Confronted = true
                    state.EscapeTarget = chosenData.Model
                    state.EscapeOrigin = chosenPart.Position
                    state.EscapeKey = chosenKey
                    state.EscapeWaitUntil = os.clock() + 8
                    self.Target = chosenData.Model
                end
                self:SecretStatus(row, "Prisoner | Provoke " .. chosenKey)
            end
            return true
        end
    end
    local enemy = self:Enemies(handler.Enemies, 5000)[1]
    if enemy then
        local part = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
        state.EscapeTarget = enemy
        state.EscapeOrigin = part and part.Position or nil
        state.EscapeKey = enemy.Name
        state.EscapeWaitUntil = os.clock() + 8
        self.SecretCombatAllowed = true
        self:Fight(enemy, enemy.Name, false)
        self:SecretStatus(row, "Prisoner | Locked " .. enemy.Name)
        return true
    end
    self:SecretStatus(row, "Prisoner | Waiting for verified runtime state")
    return true
end

