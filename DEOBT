function Hub:BlueMoonStep()
    if not self:BlueMoonActive() then
        if self.BlueMoonSession then self:BlueMoonEnd() end
        self:BlueMoonStatus("Waiting for Blue Moon")
        return
    end
    if self.Sea ~= "Sea3" then
        self:BlueMoonStatus("Blue Moon active - go to Third Sea")
        if not self.BlueMoonSeaNotified then
            self.BlueMoonSeaNotified = true
            if self:WebhookOn("Blue Moon") then self:WebhookSend("Blue Moon Started", "Blue Moon is active, but you are not in the Third Sea.", 5793266, nil) end
        end
        return
    end
    self.BlueMoonSeaNotified = nil
    local island, shrineCF, islandCF = self:BlueMoonIsland()
    if not island then
        self:BlueMoonStatus("Blue Moon active - Kitsune Island not spawned")
        return
    end
    local _, _, root = self:Character()
    if not root then return end
    if not self.BlueMoonSession then
        self.BlueMoonSession = { Started = os.clock(), Embers0 = self:BlueMoonEmbers(), Offered = 0 }
        if self:WebhookOn("Blue Moon") then self:WebhookSend("Blue Moon Started", "Kitsune Island found - farming Azure Embers.", 5793266, self:WebhookStatFields()) end
    end
    local session = self.BlueMoonSession
    if (root.Position - islandCF.Position).Magnitude > 900 then
        self:BlueMoonStatus("Traveling to Kitsune Island")
        self:MoveTo(islandCF + Vector3.new(0, 30, 0))
        return
    end
    local embers = self:BlueMoonEmbers()
    if session.Offering then
        if (root.Position - shrineCF.Position).Magnitude > 14 then
            self:MoveTo(shrineCF + Vector3.new(0, 3, 0))
            return
        end
        if not session.OfferPromptAt or os.clock() - session.OfferPromptAt > 1.5 then
            session.OfferPromptAt = os.clock()
            self:InteractNearestPrompt()
        end
        if os.clock() >= session.Offering then
            local nowEmbers = self:BlueMoonEmbers()
            local delta = (session.PreOffer or nowEmbers) - nowEmbers
            if delta > 0 then
                session.Offered += delta
            else
                session.OfferFails = (session.OfferFails or 0) + 1
                if session.OfferFails >= 2 then
                    session.NoOffer = true
                    self:Log("bluemoon", "Shrine offering had no effect; collecting only.", 10)
                end
            end
            session.Offering, session.PreOffer, session.OfferPromptAt = nil, nil, nil
        end
        self:BlueMoonStatus("Offering at Kitsune Shrine | " .. embers .. " embers")
        return
    end
    if embers >= 15 and not session.NoOffer then
        session.PreOffer = embers
        session.Offering = os.clock() + 6
        return
    end
    self:BlueMoonStatus("Collecting | " .. embers .. " embers | Offered " .. session.Offered)
    self:CollectEmberStep()
end

