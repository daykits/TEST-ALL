	function checkBlobmanStatus()
		currentTime = tick()

		if not (currentTime - lastBlobmanCheck >= checkInterval) then
			return
		end

		lastBlobmanCheck = currentTime

		local Character = localPlayer.Character

		if Character then
			Character = localPlayer.Character:FindFirstChild("Humanoid")
		end

		humanoid = Character

		if not humanoid then
			return
		end

		wasOnBlobman = currentBlobS ~= nil
		isOnBlobman = updateCurrentBlobmanF()

		if isOnBlobman or not wasOnBlobman then
			if not isOnBlobman then
				return
			end

			if serverKickEnabled and not serverKickCoroutine then
				serverKickCoroutine = coroutine.create(function()
					while serverKickEnabled and updateCurrentBlobmanF() do
						pcall(kickServer)
						task.wait(0.5)
					end
				end)
				coroutine.resume(serverKickCoroutine)
			end

			if blobLoopT and not (serverLoopCoroutine or loopRunning) then
				loopRunning = true
				serverLoopCoroutine = coroutine.create(function()
					while blobLoopT and updateCurrentBlobmanF() do
						pcall(function()
							for _, v in ipairs(playersInLoop2V) do
								player = Players:FindFirstChild(v)

								if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
									loopPlayer(v)
									task.wait(0.05)
								end
							end
						end)
						task.wait(delayV)
					end

					loopRunning = false
				end)
				coroutine.resume(serverLoopCoroutine)
			end

			if not (serverLoopEnabled and not (serverLoopCoroutine or loopRunning)) then
				return
			end

			loopRunning = true
			serverLoopCoroutine = coroutine.create(function()
				while serverLoopEnabled and updateCurrentBlobmanF() do
					pcall(loopServer)
					task.wait(5)
				end

				loopRunning = false
