local function shouldUseTravelFaceMouse(startPos, targetPos, noArc)

	if H.fishmanEscaping then

		return false

	end

	if isFishmanRegionPosition(startPos) then

		return false

	end

	if typeof(startPos) ~= "Vector3" or typeof(targetPos) ~= "Vector3" then

		return false

	end

	local dist = (startPos - targetPos).Magnitude

	local yDiff = math.abs(startPos.Y - targetPos.Y)

	return dist >= 400 or yDiff >= 80 or not noArc

end

local function shouldUseTravelArc(startPos, targetPos, noArc)

	if typeof(startPos) ~= "Vector3" or typeof(targetPos) ~= "Vector3" then

		return false

	end

	local dist = (startPos - targetPos).Magnitude

	if dist < 300 then

		return false

	end

	if not noArc then

		return true

	end

	return dist >= 1000 or startPos.Y < -500 or targetPos.Y < -500

end

local function setWaterDiveAssist(rp, hum, enabled, targetY)

	if not rp then return end

	local diveBv = rp:FindFirstChild("KT_WaterDiveBV")

	if enabled then

		if hum then

			pcall(function()

				hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)

			end)

			pcall(function()

				hum:ChangeState(Enum.HumanoidStateType.Freefall)

			end)

		end

		if not diveBv then

			diveBv = Instance.new("BodyVelocity")

			diveBv.Name = "KT_WaterDiveBV"

			diveBv.Parent = rp

		end

		diveBv.MaxForce = Vector3.new(0, 1e9, 0)

		diveBv.P = 1e7

		diveBv.Velocity = Vector3.new(0, -math.clamp(math.abs(rp.Position.Y - (targetY or rp.Position.Y)) + 20, 35, 140), 0)

	else

		if diveBv then diveBv:Destroy() end

		if hum then

			pcall(function()

				hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)

			end)

		end

	end

end

local function DoSafeTeleport(targetPos, noArc, allowNoclip)

	if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end

	if typeof(targetPos) ~= "Vector3" then return end

	local rp = getHRP()

	local hum = getHumanoid()

	if not rp or not hum or hum.Health <= 0 then return end

	H.tpToken = H.tpToken + 1

	local myToken = H.tpToken

	local startPos = rp.Position

	local dist = (startPos - targetPos).Magnitude

	local useTravelFaceMouse = shouldUseTravelFaceMouse(startPos, targetPos, noArc)

	local useTravelArc = shouldUseTravelArc(startPos, targetPos, noArc)

	local holdForwardKey = useTravelFaceMouse or useTravelArc

	if allowNoclip == false then

		setNoclip(false)

	else

		setNoclip(true)

	end

	releaseMovementKeys()

	if holdForwardKey then

		pcall(function()

			VirtualInput:SendKeyEvent(true, Enum.KeyCode.W, false, game)

		end)

	end

	local route = {}

	if useTravelArc then

		local safeAlt = math.max(startPos.Y, targetPos.Y) + 2500

		table.insert(route, Vector3.new(startPos.X, safeAlt, startPos.Z))

		table.insert(route, Vector3.new(targetPos.X, safeAlt, targetPos.Z))

		if targetPos.Y < -500 then

			table.insert(route, Vector3.new(targetPos.X, (safeAlt + targetPos.Y) / 2, targetPos.Z))

		end

	end

	table.insert(route, targetPos)

	local floor = Instance.new("Part")

	floor.Name = "KaitunInvisibleFloor"

	floor.Size = Vector3.new(10, 1, 10)

	floor.Transparency = 1

	floor.Anchored = true

	floor.CanCollide = true

	floor.Parent = workspace

	local moving = true

	task.spawn(function()

		local lastFaceMouse = 0

		while moving and H.tpToken == myToken do

			fireTakeStamDash()

			if useTravelFaceMouse and tick() - lastFaceMouse >= 0.10 then

				lastFaceMouse = tick()

				fireFaceMouse()

			end

			task.wait(0.08)

		end

	end)

	for wpIndex, wp in ipairs(route) do

		if useTravelFaceMouse then

			fireFaceMouse()

		end

		while H.tpToken == myToken do

			rp = getHRP()

			hum = getHumanoid()

			if not rp or not hum or hum.Health <= 0 then break end

			local currentDist = (rp.Position - wp).Magnitude

			local isLastWaypoint = wpIndex == #route

			local reachDistance = isLastWaypoint and 2.5 or 15

			local shouldDiveNow = isLastWaypoint and wp.Y < (rp.Position.Y - 4) and (targetPos.Y < 25 or rp.Position.Y < 25)

			setWaterDiveAssist(rp, hum, shouldDiveNow, wp.Y)

			if currentDist <= reachDistance then

				setWaterDiveAssist(rp, hum, false, wp.Y)

				rp.AssemblyLinearVelocity = Vector3.zero

				rp.AssemblyAngularVelocity = Vector3.zero

				break

			end

			local dt = RunService.Heartbeat:Wait()

			local dir = (wp - rp.Position).Unit

			local step = math.min((H.teleportSpeed or 70) * dt, currentDist)

			if useTravelFaceMouse then

				fireFaceMouse()

			end

			rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * step)

			rp.AssemblyLinearVelocity = Vector3.zero

			rp.AssemblyAngularVelocity = Vector3.zero

			if floor and floor.Parent then

				floor.CFrame = rp.CFrame * CFrame.new(0, -3.1, 0)

			end

		end

	end

	moving = false

	if floor then floor:Destroy() end

	pcall(function()

		local endRp = getHRP()

		local endHum = getHumanoid()

		if endRp then

			setWaterDiveAssist(endRp, endHum, false, targetPos.Y)

		end

	end)

	releaseMovementKeys()

end

local function DoHakiSafeTeleport(targetPos, finalHoverY)

	if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end

	if typeof(targetPos) ~= "Vector3" then return end

	if tick() < (H.respawnGraceUntil or 0) then

		waitUntilAliveStable(H.RESPAWN_WAIT_SECONDS + 5)

		task.wait(0.5)

	end

	local rp = getHRP()

	local hum = getHumanoid()

	if not rp or not hum or hum.Health <= 0 then return end

	if targetPos.Y < H.YETI_MIN_SAFE_Y then

		targetPos = Vector3.new(targetPos.X, H.YETI_MIN_SAFE_Y + H.YETI_HOVER_HEIGHT, targetPos.Z)

	end

	if finalHoverY and finalHoverY < H.YETI_MIN_SAFE_Y then

		finalHoverY = H.YETI_MIN_SAFE_Y + H.YETI_HOVER_HEIGHT

	end

	setNoclip(true)

	releaseMovementKeys()

	local startPos = rp.Position

	local finalPos = finalHoverY and Vector3.new(targetPos.X, finalHoverY, targetPos.Z) or targetPos

	local flatDist = Vector3.new(targetPos.X - startPos.X, 0, targetPos.Z - startPos.Z).Magnitude

	local yDist = math.abs((finalHoverY or targetPos.Y) - startPos.Y)

	local route = {}

	if flatDist <= 120 and yDist <= 90 then

		table.insert(route, finalPos)

	else

		local safeY = math.max(startPos.Y, targetPos.Y, finalHoverY or targetPos.Y) + 80

		if safeY < 140 then safeY = 140 end

		table.insert(route, Vector3.new(startPos.X, safeY, startPos.Z))

		table.insert(route, Vector3.new(targetPos.X, safeY, targetPos.Z))

		table.insert(route, finalPos)

	end

	for _, wp in ipairs(route) do

		if not getgenv().KaitunFarm then break end

		DoSafeTeleport(wp, true, true)

		task.wait(0.08)

	end

end

