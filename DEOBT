    self:OpenController("SubclassMenu", { "Controllers", "UI", "SubclassMenu" }, state.Name)
end

function Hub:PassiveOffer()
    local state = self.SubclassState
    local entry = self.PassiveOptions and self.PassiveOptions[self.Config["Selected Passive"]]
    if not state or type(state.Owned) ~= "table" or not entry then return nil, "Class not owned." end
    local owned = state.Owned
    if type(owned.Passives) ~= "table" or type(owned.Level) ~= "number" then return nil, "Progress unavailable." end
    local definition = entry.Definition
    if type(definition.LevelRequirement) ~= "number" or owned.Level < definition.LevelRequirement then return nil, "Class level required." end
    local current = owned.Passives[entry.Key]
    local level = 0
    if current ~= nil then
        if type(current) ~= "table" or type(current.Level) ~= "number" or current.Level % 1 ~= 0 or current.Level < 1 then
            return nil, "Passive level unavailable."
        end
        level = current.Level
    end
    if level >= #definition.Levels then return nil, "Max level." end
    local prerequisite
    for key, other in pairs(state.Definition.Passives) do
        if type(other.UnlockOrder) == "number" and type(definition.UnlockOrder) == "number" and other.UnlockOrder < definition.UnlockOrder then
            if not prerequisite or other.UnlockOrder > prerequisite.Order then prerequisite = { Key = key, Order = other.UnlockOrder } end
        end
    end
    if not current and prerequisite and owned.Passives[prerequisite.Key] == nil then return nil, "Previous passive required." end
    local nextLevel = definition.Levels[level + 1]
    if type(nextLevel) ~= "table" or type(nextLevel.Cost) ~= "table" then return nil, "Cost unavailable." end
    return { Name = state.Name, Key = entry.Key, Definition = definition, Level = level + 1, Cost = nextLevel.Cost }
end

function Hub:RenderPassive()
    local offer, problem = self:PassiveOffer()
