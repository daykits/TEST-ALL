function Hub:BuySubclass()
    local state, stage = self:SubclassQuest()
    if not state then return end
    if type(state.Owned) == "table" then self:Notify("Subclass", "Already owned."); return end
    if stage ~= 2 then self:Notify("Subclass", "Complete the class quest first."); return end
    local base = state.Definition.Passives and state.Definition.Passives.Base
    local cost = base and base.Levels and base.Levels[1] and base.Levels[1].Cost
    if type(cost) ~= "table" or type(cost.Fragments) ~= "number" then self:Notify("Subclass", "Cost unavailable."); return end
    local enough, problem = self:CanAfford(cost)
    if not enough then self:Notify("Subclass", problem); return end
    local ok, response = self:SubclassCall("PurchaseSubclass", state.Name)
    self:Response("Subclass", ok, response)
end

