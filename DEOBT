function Hub:MasteryWeak(model)
    local hum = model and model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.MaxHealth <= 0 then return false end
    return hum.Health / hum.MaxHealth * 100 <= (self.Config["Mastery Health"] or 30)
end

function Hub:MasteryWeapons()
    local names, seen = {}, {}
    for _, parent in ipairs({ Player.Character, Player:FindFirstChild("Backpack") }) do
        for _, tool in ipairs(parent and parent:GetChildren() or {}) do
            if Compat.isA(tool, "Tool") and not seen[tool.Name] then
                seen[tool.Name] = true
                table.insert(names, tool.Name)
            end
        end
    end
    table.sort(names)
    return names
end

function Hub:MasteryStep()
    if not self:MasteryActive() then return false end
    local weak = self:Enemies(function(target) return self:MasteryWeak(target) end,
        self.Config["Fast Range"] + 40)[1]
    if not weak then return false end
    local root = weak:FindFirstChild("HumanoidRootPart") or weak.PrimaryPart
    if not Compat.isA(root, "BasePart") then return false end
    local char, _, myRoot = self:Character()
    if not char or not myRoot then return false end
    local weapon = self.Config["Mastery Weapon"]
    if weapon ~= "" then pcall(function() self:Equip(weapon) end) end
    if not char:FindFirstChild("HasBuso") then self:Comm("Buso") end
    local point = self:AimPoint(weak) or root.Position
    local goal = CFrame.lookAt(point + Vector3.new(0, self.Config["Pos y (Farm)"], 4), point)
    if (goal.Position - myRoot.Position).Magnitude > 14 then
        self:MoveTo(goal)
        return true
    end
    myRoot.CFrame = CFrame.lookAt(myRoot.Position, point)
    if os.clock() - (self.MasterySkillAt or 0) > 0.6 then
        self.MasterySkillAt = os.clock()
        local keys = string.split(self.Config["Mastery Skills"], ",")
        if #keys > 0 then
            self.MasterySkillIndex = (self.MasterySkillIndex or 0) % #keys + 1
            self:PressKey((keys[self.MasterySkillIndex] or ""):gsub("%s", ""))
        end
    end
    return true
end

function Hub:DoctorStep()
    if os.clock() - (self.DoctorAt or 0) < 1 then return end
    self.DoctorAt = os.clock()
    local _, _, root = self:Character()
    local questText = "off"
    if self.Config["Auto Quest"] then
        local data, known = self:QuestState()
        if not known then questText = "unknown"
        elseif not data then questText = "none"
        else
            local progress = Compat.questProgress(data)
            questText = tostring(data.InternalQuestName or data.QuestName or "?")
            if progress then questText = questText .. " " .. progress.Current .. "/" .. progress.Total end
        end
    end
    local targetText = "-"
    local target = self.Target
    if target and self:AliveEnemy(target) then
        local hum = target:FindFirstChildOfClass("Humanoid")
        local part = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
        local dist = (root and part) and math.floor((part.Position - root.Position).Magnitude) or 0
        targetText = target.Name .. " " .. dist .. "m" .. (hum and (" " .. math.floor(hum.Health)) or "")
    elseif target then targetText = "stale" end
    local moveText = "idle"
    if self.Tween then moveText = "tween"
    elseif self.Route then moveText = "portal"
    elseif self.ManualDestination then moveText = "manual" end
    local fastText = "off"
    if self.Config["Fast Attack"] then
        local age = self.FastLastBatch and math.floor(os.clock() - self.FastLastBatch) or -1
        fastText = (self.FastBatches or 0) .. "x" .. (age >= 0 and (" " .. age .. "s ago") or " never")
        if self.FastLastFail then fastText = fastText .. " | FAIL: " .. tostring(self.FastLastFail) end
    end
    local pos = root
        and (math.floor(root.Position.X) .. "," .. math.floor(root.Position.Y) .. "," .. math.floor(root.Position.Z))
        or "-"
    self:SetInfo("DoctorStatus", (self.ActiveMode or "Idle") .. " | Q:" .. questText .. " | T:" .. targetText
        .. " | M:" .. moveText .. " | F:" .. fastText .. " | " .. pos)
    local err = self.LastLoopError
    if err then self:SetInfo("ErrorStatus", err.Name .. ": " .. tostring(err.Message):sub(1, 120))
    else self:SetInfo("ErrorStatus", "None") end
end

