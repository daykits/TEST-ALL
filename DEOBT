    if self:AliveEnemy(enemy) then
        self.SecretCombatAllowed = true
        self:Fight(enemy, enemy.Name, false)
        self:SecretStatus(row, "Objective | Farm " .. enemy.Name)
        return true
    end
    local prompt = object:IsA("ProximityPrompt") and object or object:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled then return self:SecretUsePrompt(row, prompt) end
    local click = object:IsA("ClickDetector") and object or object:FindFirstChildWhichIsA("ClickDetector", true)
    if click and type(fireclickdetector) == "function" then
        local part = self:SecretObjectPart(click.Parent)
