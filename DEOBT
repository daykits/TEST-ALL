function Hub:RequestEntrance(name)
    local alternatives = { name }
    if name == "WaterfallBossHitbox" then alternatives[2] = "TurtleEntranceBoss"
    elseif name == "TurtleEntranceBoss" then alternatives[2] = "WaterfallBossHitbox" end
    local function enter(point)
        local _, _, root = self:Character()
        if not root then return false end
        self:StopAutomation()
        self:CancelMove()
        root.CFrame = CFrame.new(point)
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        return true
    end
    local function attempt(payload)
        local okCall, ok, point = pcall(self.Comm, self, "requestEntrance", payload)
        if okCall and ok and typeof(point) == "Vector3" then return enter(point) end
        return false
    end
    for _, label in ipairs(alternatives) do
        if attempt(label) then self:Notify(name, "Entered."); return end
    end
    local _, _, root = self:Character()
    if not root then return end
    local doors = self:FindBossDoors()
    table.sort(doors, function(a, b)
        return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
    end)
    local door = doors[1]
    if not door then self:Notify(name, "Entrance unavailable."); return end
    self:Notify(name, "Going to the door.")
    self:MoveUntil(door.CFrame + Vector3.new(0, 3, 0), function() return self.Alive end, 90)
    for _, label in ipairs(alternatives) do
        if attempt(label) then self:Notify(name, "Entered."); return end
    end
    if attempt(door.Position) or attempt(door) then self:Notify(name, "Entered."); return end
    self:Notify(name, "Entrance unavailable.")
end

