    end
end

function Hub:Log(key, message, interval)
    local now = os.clock()
    local entry = self.Logs[key]
    if not entry then entry = { Count = 0, Time = -math.huge }; self.Logs[key] = entry end
    entry.Count += 1
    entry.Message = tostring(message)
    if now - entry.Time >= (interval or 10) then
        entry.Time = now
        warn("[Bacon Hub / " .. key .. "] " .. entry.Message)
    end
end

function Hub:Notify(title, content)
    if not self.Alive then return end
    content = tostring(content or "")
    if self.Library and type(self.Library.Notify) == "function" then
        local safe = content:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
        local ok = pcall(function() self.Library:Notify({ Title = title, Description = safe, Duration = 6 }, true) end)
        if ok then return end
    end
    self:Log(title, content, 2)
end

function Hub:Connect(signal, callback)
    if not signal then return nil end
    local ok, connection = pcall(function()
        return signal:Connect(function(...)
            if not self.Alive then return end
            local passed, problem = pcall(callback, ...)
            if not passed then self:Log("signal", problem) end
        end)
    end)
    if ok then table.insert(self.Connections, connection); return connection end
    return nil
end

function Hub:Loop(name, interval, callback)
    local thread = task.spawn(function()
        while self.Alive do
            local ok, problem = pcall(callback)
            if not ok then
                self:Log(name, problem)
                self.LastLoopError = { Name = name, Message = tostring(problem), Time = os.time() }
            end
            task.wait(interval)
        end
    end)
    table.insert(self.Jobs, thread)
    return thread
end

function Hub:Call(key, timeout, cooldown, callback)
    if not self.Alive then return false, "Stopped" end
    local now = os.clock()
    local state = self.Calls[key]
    if state and state.Busy then return false, "Request still pending: " .. key end
    if state and now < state.Next then return false, "Cooldown: " .. key end
    state = { Busy = true, Next = now + (cooldown or 0), Result = nil }
    self.Calls[key] = state
    task.spawn(function()
        state.Result = self.Alive and table.pack(pcall(callback)) or table.pack(false, "Stopped")
        state.Busy = false
    end)
    local deadline = now + (timeout or 8)
    while self.Alive and state.Busy and os.clock() < deadline do task.wait(0.05) end
    if not self.Alive then return false, "Stopped" end
    if state.Busy then
        self:Log("timeout:" .. key, "Request timed out.")
        return false, "Request timed out."
    end
    return table.unpack(state.Result, 1, state.Result.n)
end

function Hub:Module(key, path)
    if self.Modules[key] ~= nil then return self.Modules[key] end
    if os.clock() < (self.ModuleRetry[key] or 0) then return nil end
    local instance = Compat.find(Services.ReplicatedStorage, path)
    if not Compat.isA(instance, "ModuleScript") then
        self.ModuleRetry[key] = os.clock() + 2
        return nil
    end
    local ok, result = self:Call("module:" .. key, 10, 0.5, function() return require(instance) end)
    if ok and (type(result) == "table" or type(result) == "function") then
        self.Modules[key] = result
        return result
    end
    self.ModuleRetry[key] = os.clock() + 5
    self:Log("module:" .. key, result or "Module unavailable")
    return nil
end

function Hub:NetRemote(kind, name)
    local remote = Compat.find(Services.ReplicatedStorage, { "Modules", "Net", kind .. "/" .. name })
    local class = kind == "RF" and "RemoteFunction" or "RemoteEvent"
    if Compat.isA(remote, class) then return remote end
    if kind == "RE" and Compat.isA(remote, "UnreliableRemoteEvent") then return remote end
    return nil
end

function Hub:InvokeNet(name, payload, cooldown)
    local remote = self:NetRemote("RF", name)
    if not remote then return false, "Missing RF/" .. name end
    local action = "call"
    if type(payload) == "table" then
        action = tostring(payload.Type or payload.Context or payload.Command or "call")
        for _, key in ipairs({ "NPC", "AbilityName", "IslandKey" }) do
            if type(payload[key]) == "string" then action ..= ":" .. key .. "=" .. payload[key] end
        end
    end
    return self:Call("RF:" .. name .. ":" .. action, 8, cooldown or 0.75, function() return remote:InvokeServer(payload) end)
end

function Hub:Comm(command, ...)
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", "CommF_" })
    if not Compat.isA(remote, "RemoteFunction") then return false, "CommF_ is not ready" end
    local args = table.pack(...)
    local actionParts = {}
    for index = 1, math.min(args.n, 2) do
        local value = args[index]
        local kind = type(value)
        if kind == "string" or kind == "number" or kind == "boolean" or value == nil then
            table.insert(actionParts, kind .. "=" .. tostring(value))
        end
    end
    local action = #actionParts > 0 and (":" .. table.concat(actionParts, ":")) or ""
    local cooldown = 0.8
    if command == "Buso" then cooldown = 3 end
    if command == "SetSpawnPoint" or command == "SetLastSpawnPoint" then cooldown = 0 end
    return self:Call("CommF:" .. command .. action, 8, cooldown, function()
        return remote:InvokeServer(command, table.unpack(args, 1, args.n))
    end)
end

function Hub:CommE(...)
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", "CommE" })
    if not Compat.isA(remote, "RemoteEvent") then return false end
    local args = table.pack(...)
    return pcall(remote.FireServer, remote, table.unpack(args, 1, args.n))
end

function Hub:CommRaw(command, ...)
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", "CommF_" })
    if not Compat.isA(remote, "RemoteFunction") then return false end
    local args = table.pack(...)
    local results = table.pack(pcall(remote.InvokeServer, remote, command, table.unpack(args, 1, args.n)))
    if results[1] ~= true then return false end
    return true, table.unpack(results, 2, results.n)
end

function Hub:LoadConfig()
    local saved
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, value = pcall(function()
            if isfile(self.ConfigFile) then return Services.HttpService:JSONDecode(readfile(self.ConfigFile)) end
            return nil
        end)
        if ok then saved = value else self:Log("config", "Invalid saved config; using defaults.") end
    end
    self.Config = Compat.config(self.Defaults, saved)

    self:MirrorConfig()
end

function Hub:MirrorConfig()
    for key, global in pairs(self.GlobalNames) do _G[global] = self.Config[key] end
    _G._B = self.Config["ON Bring"]
    Environment.ShowItems = self.Config.ShowItems
end

function Hub:SaveConfig()
    if self.SavePending or type(writefile) ~= "function" then return end
    self.SavePending = true
    task.delay(0.35, function()
        self.SavePending = false
        if not self.Alive then return end
        local ok, problem = pcall(function()
            if type(isfolder) == "function" and type(makefolder) == "function" then
                local built
                for segment in self.ConfigFolder:gmatch("[^/]+") do
                    built = built and (built .. "/" .. segment) or segment
                    if not isfolder(built) then makefolder(built) end
                end
            end
            writefile(self.ConfigFile, Services.HttpService:JSONEncode(self.Config))
        end)
        if not ok then self:Log("config-save", problem) end
    end)
end

function Hub:SetConfig(key, value)
    if self.Defaults[key] == nil or type(value) ~= type(self.Defaults[key]) then return end
    if not self.BuildingUI and value == true and table.find(self.FarmKeys, key) then
        self.ElectricState = nil
        self.ForcedWeapon = nil
        self:CancelMove()
        self.Route = nil
        self.WorldPortalRoute = nil
        self.SubmergedTransitUntil = nil
    end
    if key == "Fishing Mode" and self.Config[key] ~= value and not self.BuildingUI and self.FishCleanup then self:FishCleanup() end
    self.Config[key] = value
    if key == "Smart Portal" and not value then
        self.Route = nil
        self.WorldPortalRoute = nil
        if not self.BuildingUI then self:CancelMove() end
    end
    if key == "Sea Boat Height" and self.SeaCancelBoatTween then self:SeaCancelBoatTween() end
    if (key == "Backpack Bypass" or key == "Fast Attack") and not value and self.ReleaseBackpackEquip then self:ReleaseBackpackEquip() end
    if self.ResetFastAttack and (key == "Fast Packet" or key == "Fast Attack" or table.find(self.FarmKeys, key)) then
        self:ResetFastAttack()
    end
    if key == "Auto Secrets" and not value and self.ResetSecretAutomation then self:ResetSecretAutomation() end
    if not value and self.ResetFullyBossState and (key == "Fully Soul Reaper" or key == "Fully Cake Prince"
        or key == "Fully Tyrant of the Skies") then self:ResetFullyBossState(key) end
    local mirrors = self.ToggleMirrors and self.ToggleMirrors[key]
    if mirrors then
        for _, option in ipairs(mirrors) do
            if type(option.SetValue) == "function" and option.Value ~= value then
                pcall(option.SetValue, option, value)
            end
        end
    else
        local option = self.Toggles and self.Toggles[key]
        if option and type(option.SetValue) == "function" and option.Value ~= value then pcall(option.SetValue, option, value) end
    end
    self:MirrorConfig()
    if key == "ShowItems" then
        if self.ItemsGui then self.ItemsGui.Enabled = value end
        if value and not self.BuildingUI then self:Action("Items", function() self:BuildItemsUI() end) end
    end
    if not self.BuildingUI then self:SaveConfig() end
end

