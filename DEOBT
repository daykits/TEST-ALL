		while hakiEquipLoop and getgenv().KaitunFarm and not hasHaki() do

			equipMelee()

			task.wait(0.35)

		end

	end)

	local hakiRemote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Haki")

	local questName = "Road to Armament"

	local questPos = Vector3.new(-4246.068, 169.782, -2990.422)

	local farmPos = Vector3.new(-4475.706, 80.982, -2964.551)

	local function waitAtHakiSpotIfLowHP()

		local hum = getHumanoid()

		if not hum or hum.Health <= 0 then

			return false

		end

		if hum.Health > (H.HAKI_LOW_HP_THRESHOLD or 100) then

			return false

		end

		setHakiStatus("tweening")

		H.tpToken = H.tpToken + 1

		setNoclip(true)

		releaseMovementKeys()

		DoSafeTeleport(farmPos, false, true)

		local rp = getHRP()

		if rp then

			enableAirHold(rp, farmPos)

		end

		local waitUntil = tick() + (H.HAKI_LOW_HP_WAIT or 8)

		while getgenv().KaitunFarm and not hasHaki() and tick() < waitUntil do

			rp = getHRP()

			if rp then

				enableAirHold(rp, farmPos)

				rp.CFrame = CFrame.new(farmPos)

				rp.AssemblyLinearVelocity = Vector3.zero

				rp.AssemblyAngularVelocity = Vector3.zero

			end

			task.wait(0.2)

		end

		return true

	end

	local hakiQuestTried = false

	if getQuest() ~= questName then

		cancelQuestIfDifferent(questName)

		setHakiStatus("tweening")

		DoSafeTeleport(questPos, false, true)

		task.wait(1)

		if getQuest() ~= questName then

			hakiQuestTried = true

			setHakiStatus("taking quest")

			pcall(function()

				questEvent:InvokeServer({ [1] = "takequest", [2] = questName })

			end)

			task.wait(1)

		end

	end

	setHakiStatus("tweening")

	DoSafeTeleport(farmPos, false, true)

	task.wait(0.5)

	-- Synchronise immÃ©diatement le compteur avec la progression cÃ´tÃ© serveur

	-- (utile quand la quÃªte a dÃ©jÃ  des kills enregistrÃ©s, ex. aprÃ¨s un relog).

	local initialKills, initialMax = getHakiQuestProgress(0)

	local kills = initialKills or 0

	setHakiKills(kills, initialMax or 50)

	while getgenv().KaitunFarm and not hasHaki() and kills < 50 do

		local questKills, questMax = getHakiQuestProgress(kills)

		kills = math.max(kills, questKills or 0)

		setHakiKills(kills, questMax or 50)

		if kills >= (questMax or 50) then

			hideHakiOverlay()

			break

		end

		if waitAtHakiSpotIfLowHP() then

			continue

		end

		if markDeathGraceIfNeeded() then

			notify("Kaitun", "Death detected. Waiting 5s before any movement...", 6)

			setHakiStatus("respawning")

			H.tpToken = H.tpToken + 1

			setNoclip(false)

			releaseMovementKeys()

			task.wait(5)

			waitUntilAliveStable(5)

			releaseMovementKeys()

			if not getgenv().KaitunFarm or hasHaki() then break end

			if isOnFishmanIsland() then

				ensureEscapedFishman("Haki respawn")

				if not getgenv().KaitunFarm or hasHaki() then break end

			end

			-- Tween de retour vers Yeti Island, jamais d'instant TP.

			setNoclip(true)

			setHakiStatus("tweening")

			DoSafeTeleport(farmPos, false, true)

			task.wait(0.5)

			continue

		end

		if isOnFishmanIsland() then

			setHakiStatus("respawning")

			ensureEscapedFishman("Haki respawn")

			if not getgenv().KaitunFarm or hasHaki() then break end

			setHakiStatus("tweening")

			DoSafeTeleport(farmPos, false, true)

			task.wait(0.5)

			continue

		end

		if getQuest() ~= questName and not hakiQuestTried then

			hakiQuestTried = true

			cancelQuestIfDifferent(questName)

			setHakiStatus("tweening")

			DoSafeTeleport(questPos, false, true)

			task.wait(1)

			setHakiStatus("taking quest")

			pcall(function()

				questEvent:InvokeServer({ [1] = "takequest", [2] = questName })

			end)

			task.wait(1)

			setHakiStatus("tweening")

			DoSafeTeleport(farmPos, false, true)

		end

		setNoclip(true)

		equipMelee()

		pcall(function() hakiRemote:FireServer("Buso") end)

		if tick() < (H.respawnGraceUntil or 0) then

			releaseMovementKeys()

			task.wait(0.5)

			continue

		end

		local yeti = getClosestYeti()

		if not yeti then

			if isOnFishmanIsland() then

				setHakiStatus("respawning")

				ensureEscapedFishman("Haki no Yeti")

				if not getgenv().KaitunFarm or hasHaki() then break end

			end

			setHakiStatus("tweening")

			DoSafeTeleport(farmPos, false, true)

			task.wait(2)

			continue

		end

		local hrp = yeti:FindFirstChild("HumanoidRootPart")

		if hrp then

			if hrp.Position.Y < H.YETI_MIN_SAFE_Y or hrp.Position.Y > H.YETI_MAX_SAFE_Y then

				task.wait(0.5)

				continue

			end

			-- Tween simple de yeti en yeti (pas d'instant TP, pas d'arc).

			setHakiStatus("tweening")

			local hoverPos = Vector3.new(hrp.Position.X, hrp.Position.Y + (H.YETI_HOVER_HEIGHT or 8.3), hrp.Position.Z)

			DoHakiTween(hoverPos)

			setHakiStatus("killing yeti")

			local killed = attackYeti(yeti)

			if waitAtHakiSpotIfLowHP() then

				continue

			end

			if killed then

				kills = kills + 1

				local questKills2, qmax2 = getHakiQuestProgress(kills)

				kills = math.max(kills, questKills2 or kills)

				setHakiKills(kills, qmax2 or 50)

			end

		end

		task.wait(0.21)

	end

	hakiEquipLoop = false

	setNoclip(false)

	hideHakiOverlay()

end

-- ============================================================

-- PHASE 4: WORLD SCROLL

-- ============================================================

local function phase4WorldScroll()

	if not getgenv().KaitunFarm then return end

	if not configFlag("ITEM", "World Scroll", true) then

		notify("Kaitun", "World Scroll disabled by config.", 4)

		return

	end

	ensureEscapedFishman("World Scroll")

	if hasWorldScroll() then

		notify("Kaitun", "World Scroll already owned.", 4)

		return

	end

	local scrollPos = Vector3.new(-7348.136, 3.274, -14951.547)

	local attempts = 0

	while getgenv().KaitunFarm and not hasWorldScroll() do

		attempts = attempts + 1

		if markDeathGraceIfNeeded() then

			notify("World Scroll", "Death detected. Waiting 10s, then retrying World Scroll...", 6)

			H.tpToken = H.tpToken + 1

			setNoclip(false)

			releaseMovementKeys()

			task.wait(10)

			waitUntilAliveStable(5)

			releaseMovementKeys()

		end

		if isOnFishmanIsland() then

			ensureEscapedFishman("World Scroll respawn")

			if not getgenv().KaitunFarm then break end

		end

		if hasWorldScroll() then break end

		notify("Kaitun", "Getting World Scroll... Attempt " .. tostring(attempts), 5)

		DoSafeTeleport(scrollPos)

		task.wait(0.5)

		if markDeathGraceIfNeeded() then

			notify("World Scroll", "Died during World Scroll path. Retrying after respawn...", 6)

			H.tpToken = H.tpToken + 1

			setNoclip(false)

			releaseMovementKeys()

			task.wait(10)

			waitUntilAliveStable(5)

			releaseMovementKeys()

			continue

		end

		pcall(function()

			VirtualInput:SendKeyEvent(true, Enum.KeyCode.LeftAlt, false, game)

			task.wait(3)

			VirtualInput:SendKeyEvent(false, Enum.KeyCode.LeftAlt, false, game)

		end)

		task.wait(1)

	end

	if hasWorldScroll() then

		notify("Kaitun", "World Scroll obtained.", 5)

	else

		notify("Kaitun", "World Scroll not confirmed. Staying in World Scroll phase, no main menu.", 8)

		getgenv().KaitunFarm = false

	end

end

