		end

		local hrpList, npcIDs = collectNPCPacket(npc.Name, packetCenter, 22)

		if #hrpList == 0 then

			hrpList = { liveHrp or hrp }

			if id then npcIDs = { id } end

		end

		local packet = {

			[1] = {

				[1] = "damage", [2] = hrpList, [3] = "Melee",

				[4] = { 1, "Ground", "Melee" }, [5] = true,

				[6] = current and current.CFrame or CFrame.new(hrp.Position.X, fixedCombatY, hrp.Position.Z),

				aircombo = "Ground",

			}

		}

		if #npcIDs > 0 then packet[1].NPCIDs = npcIDs end

		combatRegister:InvokeServer(unpack(packet))

	end)

	lockAboveNPC(npc, hoverHeight, 0.45, fixedCombatY)

end

