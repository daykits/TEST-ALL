        elseif problem == "missing" then
            self:Notify("Webhook", "Executor has no getclipboard. Type or paste into the Webhook URL box above.")
        else
            self:Notify("Webhook", "Clipboard is empty or unreadable. Copy the Discord webhook URL first.")
        end
        self:RenderWebhookSettings()
    end)
