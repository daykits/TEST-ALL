function Hub:ModeReady(mode)
    if mode == "Collect Fruits" then return self:SmartFruitNear(4000) end
    if mode == "Farm Elites" then return self:ElitePresent() end
    if mode == "Farm Factory" then return self.Sea == "Sea2" and self:Enemies("Core")[1] ~= nil end
    if mode == "Farm Pirate Raid" then return self.Sea == "Sea3" and self:PirateRaidNear() end
    if mode == "Auto Cannon" then local _, hum = self:Character(); return hum ~= nil and hum.Sit == true end
    if mode == "Auto Raid" then
        if self:RaidTimerVisible() or self:HasChip() then return true end
        return #self:PhysicalFruits() > 0 or self:CheapStoredFruit() ~= nil
    end
    if mode == "Auto Trial" then
        if self:RaidTimerVisible() then return true end
        local stage = self:TrialStageCached()
        if stage == nil or stage == 5 then return false end
        if stage ~= 0 then return true end
        local first = Services.Players:FindFirstChild(self.Config["Trial Player 1"])
        local second = Services.Players:FindFirstChild(self.Config["Trial Player 2"])
        return first ~= nil and second ~= nil and self:IsNearEntrance(first) and self:IsNearEntrance(second)
    end
    if mode == "Race V3" then return not self:IsRaceV3() end
    if mode == "Auto Great Pumpkin" then
        if not self:HalloweenActive() then return false end
        if self.HalloweenRitualBusy or self:HalloweenDapperActive() or self:HalloweenInDapperArena() then return true end
        local gpBoss = self:HalloweenBossEnemy()
        if gpBoss and gpBoss.Name:lower():find("dapper", 1, true) then return true end
        local pumpkinFolder = Services.Workspace:FindFirstChild("PumpkinHunt")
        if pumpkinFolder and #pumpkinFolder:GetChildren() > 0 then return true end
        return os.clock() >= (self.HalloweenRitualNext or 0)
    end
    if mode == "Auto Halloween" then
        if not self:HalloweenActive() then return false end
        if self.Config["Auto Great Pumpkin"] and (self:HalloweenInDapperArena() or self:HalloweenDapperActive() or self.HalloweenRitualBusy) then return false end
        if self:HalloweenBusy() then return true end
        if self.HalloweenPortalWait then return true end
        if self.HalloweenGachaBusy then return true end
        if self.HalloweenTarotArmed or self.HalloweenBossSession then return true end
        if self:HalloweenActiveBossDoor() then return true end
        for _, entry in ipairs(self:HalloweenDoors()) do
            if self:HalloweenDoorReady(entry) then return true end
        end
        return false
    end
    if mode == "Auto Blue Moon" then return self:BlueMoonActive() end
    if mode == "Sea Danger" then return self.Sea == "Sea2" or self.Sea == "Sea3" end
    return true
end

function Hub:PickStackMode(enabled)
    self:SetInfo("StackListInfo", #enabled == 0 and "Empty" or table.concat(enabled, ", "))
    if #enabled == 0 then
        self:SetInfo("StackStatus", "Idle")
        return nil
    end
    if #enabled == 1 then
        self:SetInfo("StackStatus", enabled[1])
        return enabled[1]
    end
    local on = {}
    for _, key in ipairs(enabled) do on[key] = true end
    if self:RaidTimerVisible() then
        if on["Auto Raid"] then self:SetInfo("StackStatus", "Auto Raid"); return "Auto Raid" end
        if on["Auto Trial"] then self:SetInfo("StackStatus", "Auto Trial"); return "Auto Trial" end
    end
    if on["Auto Halloween"] and on["Auto Great Pumpkin"] then
        if self:HalloweenInDapperArena() or self:HalloweenDapperActive() or self.HalloweenRitualBusy then
            self:SetInfo("StackStatus", "Auto Great Pumpkin (boss)")
            return "Auto Great Pumpkin"
        end
        if self.HalloweenGachaBusy or self.HalloweenTarotArmed or self:HalloweenBusy() then
            self:SetInfo("StackStatus", "Auto Halloween (door)")
            return "Auto Halloween"
        end
        if (self.ActiveMode == "Auto Halloween" or self.ActiveMode == "Auto Great Pumpkin")
            and os.clock() < (self.HalloweenStackHoldUntil or 0) then
            self:SetInfo("StackStatus", self.ActiveMode .. " (stacked)")
            return self.ActiveMode
        end
        if self:ModeReady("Auto Halloween") then
            if self.ActiveMode ~= "Auto Halloween" then self.HalloweenStackHoldUntil = os.clock() + 4 end
            self:SetInfo("StackStatus", "Auto Halloween (stacked)")
            return "Auto Halloween"
        end
        if self:ModeReady("Auto Great Pumpkin") then
            if self.ActiveMode ~= "Auto Great Pumpkin" then self.HalloweenStackHoldUntil = os.clock() + 4 end
            self:SetInfo("StackStatus", "Auto Great Pumpkin (stacked)")
            return "Auto Great Pumpkin"
        end
    end
    for _, key in ipairs(self.StackOpportunistic) do
        if on[key] and self:ModeReady(key) then
            self:SetInfo("StackStatus", key .. " (stacked)")
            return key
        end
    end
    for _, key in ipairs(self.StackGoals) do
        if on[key] and self:ModeReady(key) then
            self:SetInfo("StackStatus", key .. " (stacked)")
            return key
        end
    end
    local grind = {}
    for _, key in ipairs(self.StackGrind) do if on[key] then table.insert(grind, key) end end
    if #grind > 0 then
        local pick = grind[(math.floor(os.clock() / 60) % #grind) + 1]
        self:SetInfo("StackStatus", pick .. " (" .. #enabled .. " stacked)")
        return pick
    end
    self:SetInfo("StackStatus", "Waiting (" .. #enabled .. " stacked)")
    return nil
end

