function Compat.selectQuest(quests, npcList, level, allowedMobs, blacklist, options)
    if type(quests) ~= "table" or type(npcList) ~= "table" or type(level) ~= "number" then return nil end
    local best
    for _, npc in pairs(npcList) do
        if type(npc) == "table" and type(npc.InternalQuestName) == "string" then
            local groupName = npc.InternalQuestName
            local group = quests[groupName]
            if type(group) == "table" then
                for id, quest in pairs(group) do
                    if type(quest) == "table" and type(quest.LevelReq) == "number"
                        and quest.LevelReq <= level and type(quest.Task) == "table"
                        and quest.Job ~= true and (type(id) == "number" or type(id) == "string") then
                        local key = groupName .. ":" .. tostring(id)
                        if not blacklist or not blacklist[key] then
                            local names = {}
                            for mob, amount in pairs(quest.Task) do
                                if type(mob) == "string" and type(amount) == "number"
                                    and (amount > 1 or (options and options.AllowSingle and amount == 1))
                                    and (not options or not options.BossOnly or amount == 1)
                                    and (allowedMobs == nil or Compat.nameMatches(mob, allowedMobs)) then
                                    table.insert(names, mob)
                                end
                            end
                            table.sort(names)
                            if #names > 0 and (not best or quest.LevelReq > best.LevelReq
                                or (quest.LevelReq == best.LevelReq and key < best.Key)) then
                                best = {
                                    Key = key, QuestName = groupName, QuestId = id,
                                    MobName = names[1], Mobs = names, LevelReq = quest.LevelReq,
                                    Info = quest, NPCName = npc.NPCName, Position = npc.Position,
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

function Compat.questProgress(data)
    if type(data) ~= "table" or type(data.Info) ~= "table" or type(data.Info.Task) ~= "table" then return nil end
    local progress = type(data.Progress) == "table" and data.Progress or {}
    local current, total, objectives = 0, 0, 0
    for name, taskInfo in pairs(data.Info.Task) do
        local amount = type(taskInfo) == "number" and taskInfo
            or (type(taskInfo) == "table" and taskInfo.Amount or nil)
        local goal = type(amount) == "number" and amount > 0 and amount or 1
        local value = progress[name]
        local count = value == true and goal
            or (type(amount) == "number" and amount > 0 and type(value) == "number"
                and math.clamp(value, 0, goal) or 0)
        current += count
        total += goal
        objectives += 1
    end
    return { Current = current, Total = total, Done = objectives > 0 and current >= total }
end

function Compat.progressState(progress, address)
    if type(progress) ~= "table" then return "Unknown" end
    if progress[address] == true then return "Completed" end
    if progress[address] == false then return "Incomplete" end
    return "Unknown"
end

function Compat.decodeProgress(reply)
    if type(reply) ~= "table" or reply.Type ~= "GetMomentProgress" or type(reply.Data) ~= "table" then
        return nil, "Unexpected GetMomentProgress response"
    end
    local copy = {}
    for address, completed in pairs(reply.Data) do
        if type(address) == "string" and type(completed) == "boolean" then copy[address] = completed end
    end
    return copy
end

function Compat.summarize(catalog, progress)
    local result = { Total = 0, Completed = 0, Incomplete = 0, Unknown = 0,
        Repeatable = 0, AwakenedBossBattle = 0, Islands = {}, CompleteIslands = 0 }
    for _, row in ipairs(catalog) do
        result.Total += 1
        local status = Compat.progressState(progress, row.Address)
        result[status] += 1
        local island = result.Islands[row.Island] or { Total = 0, Completed = 0 }
        result.Islands[row.Island] = island
        island.Total += 1
        if status == "Completed" then island.Completed += 1 end
        for _, tag in ipairs(row.Tags or {}) do
            if tag == "Repeatable" then result.Repeatable += 1 end
            if tag == "AwakenedBossBattle" then result.AwakenedBossBattle += 1 end
        end
    end
    for _, island in pairs(result.Islands) do
        if island.Total > 0 and island.Completed == island.Total then result.CompleteIslands += 1 end
    end
    return result
end

function Compat.islandCFrame(definition)
    if type(definition) ~= "table" then return nil end
    for _, point in ipairs(definition.TeleportPoints or {}) do
        local cf = type(point) == "table" and Compat.cframe(point.Position)
        if cf then return cf end
    end
    local world = definition.World
    if type(world) ~= "table" then return nil end
    return Compat.cframe(world.BackendPosition) or Compat.cframe(world.Position)
end

function Compat.portalRoute(origin, destination, pairsList, minimumSaving)
    local direct = (destination - origin).Magnitude
    local saving = tonumber(minimumSaving) or 700
    if direct < saving + 250 then return nil end
    local best, bestCost
    for _, pair in ipairs(pairsList) do
        for _, reverse in ipairs({ false, true }) do
            local source = reverse and pair.Exit or pair.Entrance
            local target = reverse and pair.Entrance or pair.Exit
            local from, to = Compat.cframe(source), Compat.cframe(target)
            if from and to then
                local cost = (origin - from.Position).Magnitude + (destination - to.Position).Magnitude + 150
                if cost + saving < direct and (not bestCost or cost < bestCost) then
                    bestCost = cost
                    best = { Source = source, Destination = target, From = from, To = to }
                end
            end
        end
    end
    return best
end

return Compat

