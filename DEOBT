	-- et renvoyer main menu meme quand tu rejoins normalement ton PS.

	local now = os.time()

	getgenv().KaitunForceMainMenuAfterRejoinAt = now

	pcall(function()

		if writefile then

			writefile(REJOIN_MAIN_MENU_FLAG_FILE, tostring(now))

		end

	end)

end

local function clearMainMenuAfterRejoin()

	getgenv().KaitunForceMainMenuAfterRejoin = nil

	getgenv().KaitunForceMainMenuAfterRejoinAt = nil

	pcall(function()

		if delfile and isfile and isfile(REJOIN_MAIN_MENU_FLAG_FILE) then

			delfile(REJOIN_MAIN_MENU_FLAG_FILE)

		elseif writefile then

			writefile(REJOIN_MAIN_MENU_FLAG_FILE, "")

		end

	end)

end

local function hasMainMenuAfterRejoinFlag()

	local now = os.time()

	local stamp = tonumber(getgenv().KaitunForceMainMenuAfterRejoinAt)

	if not stamp then

		local ok, value = pcall(function()

			if isfile and readfile and isfile(REJOIN_MAIN_MENU_FLAG_FILE) then

				return tostring(readfile(REJOIN_MAIN_MENU_FLAG_FILE) or "")

			end

			return ""

		end)

		if ok then

			stamp = tonumber(tostring(value or ""):match("%d+"))

		end

	end

	-- Ancien bug: le fichier contenait "true" et restait permanent.

	-- Si ce n'est pas un timestamp valide, on le supprime et on n'agit pas.

	if not stamp then

		clearMainMenuAfterRejoin()

		return false

	end

	-- Flag valide uniquement juste apres Fatal Error / 267 / ErrorPrompt.

	-- Si tu relances le script plus tard ou arrives normalement dans ton PS,

	-- il est ignore et supprime.

	if now - stamp > REJOIN_FLAG_TTL_SECONDS then

		clearMainMenuAfterRejoin()

		return false

	end

	return true

end

