function Hub:RaceV2ProgressStep()
    if self.Sea ~= "Sea2" then self:ProgressStatus("Race V2 requires Second Sea"); return end
    local ok, state = self:RaceV2Query(1)
    if not ok then self:ProgressStatus("Alchemist syncing"); return end
    if state == -2 or Compat.find(Player, { "Data", "Race", "Evolved" }) then return self:ProgressDone("Race V2") end
    if state == -1 then self:ProgressStatus("Race V2 needs $500,000"); return end
    if state == 0 then
        local started, _, verified = self:RaceV2Start()
        if started and (verified == 1 or verified == 2) then self:ProgressStatus("Race V2 flower quest started")
        else self:ProgressStatus("Alchemist syncing") end
        return
    end
    if state == 2 or self:RaceV2HasAllFlowers() then
        local traded, _, verified = self:RaceV2Trade()
        if traded and (verified == -2 or Compat.find(Player, { "Data", "Race", "Evolved" })) then return self:ProgressDone("Race V2") end
        if traded and verified == -1 then self:ProgressStatus("Race V2 needs $500,000")
        else self:ProgressStatus("Trading all three flowers") end
        return
    end
    if state ~= 1 then self:ProgressStatus("Race V2 state " .. tostring(state)); return end
    for index = 1, 2 do
        local name = "Flower " .. index
        if not self:RaceV2HasFlower(index) then
            local flower = Services.Workspace:FindFirstChild("Flower" .. index, true) or Services.Workspace:FindFirstChild(name, true)
            if flower then self:ProgressStatus("Collecting " .. name); self:ProgressMoveTouch(flower)
            else self:ProgressStatus("Waiting for " .. name) end
