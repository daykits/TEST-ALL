local function isInsideYetiZone(pos)

	if typeof(pos) ~= "Vector3" then return false end

	if not H.YETI_ZONE_ENABLED then return true end

	return pos.X >= H.YETI_ZONE_MIN_X and pos.X <= H.YETI_ZONE_MAX_X

		and pos.Z >= H.YETI_ZONE_MIN_Z and pos.Z <= H.YETI_ZONE_MAX_Z

		and pos.Y >= H.YETI_MIN_SAFE_Y and pos.Y <= H.YETI_MAX_SAFE_Y

end

-- Clamp un Vector3 Ã  l'intÃ©rieur de la boÃ®te Yeti.

local function clampToYetiZone(pos)

	if typeof(pos) ~= "Vector3" then return pos end

	if not H.YETI_ZONE_ENABLED then return pos end

	local x = math.clamp(pos.X, H.YETI_ZONE_MIN_X, H.YETI_ZONE_MAX_X)

	local y = math.clamp(pos.Y, H.YETI_MIN_SAFE_Y, H.YETI_MAX_SAFE_Y)

	local z = math.clamp(pos.Z, H.YETI_ZONE_MIN_Z, H.YETI_ZONE_MAX_Z)

	return Vector3.new(x, y, z)

end

