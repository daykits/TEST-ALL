local function waitUntilAliveStable(timeout)

	timeout = timeout or 8

	local start = tick()

	while tick() - start < timeout do

		local hum = getHumanoid()

		local rp = getHRP()

		if hum and rp and hum.Health > 0 then

			releaseMovementKeys()

			task.wait(0.45)

			return true

		end

		task.wait(0.2)

	end

	return false

end

local function markDeathGraceIfNeeded()

	local hum = getHumanoid()

	if hum and hum.Health <= 0 then

		H.lastDeathTime = tick()

		H.respawnGraceUntil = tick() + H.RESPAWN_WAIT_SECONDS + 3

		H.tpToken = H.tpToken + 1

		releaseMovementKeys()

		return true

	end

	return false

end

