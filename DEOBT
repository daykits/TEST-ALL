function Hub:SecretRewardTarget(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 5 then return nil end
    local cf = Compat.cframe(value)
    if cf then return cf, value end
    if type(value) ~= "table" or seen[value] then return nil end
    seen[value] = true
    for _, key in ipairs({ "Target", "CFrame", "Position" }) do
        if value[key] ~= nil then
            local targetCF, target = self:SecretRewardTarget(value[key], depth + 1, seen)
            if targetCF then return targetCF, target end
        end
    end
    for _, child in pairs(value) do
        local targetCF, target = self:SecretRewardTarget(child, depth + 1, seen)
        if targetCF then return targetCF, target end
    end
    return nil
end

function Hub:SecretRewardStrings(value, result, depth, seen)
    result = result or {}
    depth = depth or 0
    seen = seen or {}
    if depth > 5 then return result end
    if type(value) == "string" then result[value] = true; return result end
    if type(value) ~= "table" or seen[value] then return result end
    seen[value] = true
    for key, child in pairs(value) do
        if type(key) == "string" then result[key] = true end
        self:SecretRewardStrings(child, result, depth + 1, seen)
    end
    return result
end

function Hub:SecretRewardNPC(tracker, cf)
    local guide = self:Guide()
    local list = guide and guide.Data and guide.Data.NPCList or {}
    local strings = self:SecretRewardStrings(tracker)
    for _, npc in pairs(list) do
        if type(npc) == "table" and type(npc.InternalQuestName) == "string"
            and (strings[npc.InternalQuestName] or type(npc.NPCName) == "string" and strings[npc.NPCName]) then
            return npc.InternalQuestName, npc
        end
    end
    if cf then return self:SecretNPCNear(cf, 120) end
    return nil
end

function Hub:RefreshSecretRewardTracker(force)
    if not force and os.clock() < (self.SecretRewardTrackerNext or 0) then return self.SecretRewardTracker end
    self.SecretRewardTrackerNext = os.clock() + 3
    local ok, tracker = self:NetCall("BonusMomentsGuide", "GetRewardTracker")
    if ok then
        self.SecretRewardTrackerKnown = true
        self.SecretRewardTracker = tracker ~= nil and tracker ~= false and tracker or nil
    end
    return self.SecretRewardTracker
end

function Hub:AutoSecretRewardStep()
    local tracker = self:RefreshSecretRewardTracker(false)
    if not tracker then return false end
    local cf = self:SecretRewardTarget(tracker)
    local group, entry = self:SecretRewardNPC(tracker, cf)
    if not group or not entry then
        self.SecretRewardTracker = nil
        self.SecretRewardTrackerNext = os.clock() + 3
        return false
    end
    local npcCF = type(entry.NPCName) == "string" and self:LiveSecretNPC(entry.NPCName) or nil
    local target = npcCF or Compat.cframe(entry.Position) or cf
    if not target then
        self.SecretRewardTracker = nil
        self.SecretRewardTrackerNext = os.clock() + 3
        return false
    end
    local _, _, root = self:Character()
    if not root then return true end
    if (root.Position - target.Position).Magnitude > 18 then
        self:MoveTo(target)
        self:SecretStatus(nil, "Turn-in | " .. tostring(entry.NPCName or group))
        return true
    end
    local ok, reply = self:ClaimGuideReward(group, true)
    if ok and reply ~= nil and reply ~= false then
        self.SecretRewardTracker = nil
        self.SecretRewardTrackerNext = 0
        self:RefreshSecrets(true)
    end
    self:SecretStatus(nil, "Turn-in | Claiming " .. tostring(entry.NPCName or group))
    return true
end

