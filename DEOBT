local Compat = {}

function Compat.find(root, path)
    if root == nil or type(path) ~= "table" then return nil end
    local current = root
    for _, name in ipairs(path) do
        if current == nil or type(name) ~= "string" then return nil end
        local ok, child = pcall(function() return current:FindFirstChild(name) end)
        if not ok or child == nil then return nil end
        current = child
    end
    return current
end

function Compat.isA(value, className)
    if value == nil then return false end
    local ok, result = pcall(function() return value:IsA(className) end)
    return ok and result == true
end

function Compat.cframe(value)
    local kind = typeof(value)
    if kind == "CFrame" then return value end
    if kind == "Vector3" then return CFrame.new(value) end
    if kind == "Instance" then
        local ok, result = pcall(function()
            if value:IsA("BasePart") then return value.CFrame end
            if value:IsA("Model") then return value:GetPivot() end
            if value:IsA("Attachment") then return value.WorldCFrame end
            return nil
        end)
        if ok and typeof(result) == "CFrame" then return result end
    end
    return nil
end

function Compat.number(value, fallback, minimum, maximum)
    if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
    return math.clamp(value, minimum, maximum)
end

function Compat.normalizeName(name)
    if type(name) ~= "string" then return "" end
    local result = name:lower():gsub("%s*%[lv%.?%s*%d+%]", "")
    result = result:gsub("%s*%[[^%]]+%]", "")
    result = result:gsub("^%s+", ""):gsub("%s+$", "")

    if result == "possessed mummy" then return "posessed mummy" end
    return result
end

function Compat.nameMatches(name, query)
    if query == nil or query == "*" then return true end
    local normalized = Compat.normalizeName(name)
    if type(query) == "string" then return normalized == Compat.normalizeName(query) end
    if type(query) == "table" then
        for _, candidate in pairs(query) do
            if type(candidate) == "string" and normalized == Compat.normalizeName(candidate) then return true end
        end
    end
    return false
end

