function Hub:HalloweenBossEnemy()
    local found = self:Enemies(function(model)
        local name = model.Name:lower()
        if name == "dapper jack" then return true end
        if name:find("pumpkin", 1, true) or name:find("dapper", 1, true) then return true end
        if model:GetAttribute("LocalEnemy") == Player.Name and (name:find("jack", 1, true)
            or model:GetAttribute("HalloweenBoss") == true or model:GetAttribute("Boss") == true or model:GetAttribute("IsBoss") == true) then return true end
        return false
    end)
