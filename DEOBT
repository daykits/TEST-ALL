    if not boat then
        if os.clock() - (self.V3BoatAt or 0) > 10 then self.V3BoatAt = os.clock(); self:BuyBoat() end
        return
    end
    local seat = boat:FindFirstChild("VehicleSeat")
    local char, hum, root = self:Character()
    if not char or not hum or not root or not seat then return end
    if hum.SeatPart ~= seat then
        if not self:MoveTo(seat.CFrame + Vector3.new(0, 4, 0)) then return end
        pcall(seat.Sit, seat, hum)
        return
    end
    local folder = Services.Workspace:FindFirstChild("SeaBeasts")
    local best, distance
    for _, beast in ipairs(folder and folder:GetChildren() or {}) do
        local part = beast:FindFirstChild("HumanoidRootPart") or beast.PrimaryPart
        local health = beast:FindFirstChild("Health")
        if part and health and (health.Value or 0) > 0 then
            local d = (part.Position - root.Position).Magnitude
            if not distance or d < distance then best, distance = beast, d end
        end
    end
    if best then
        local part = best:FindFirstChild("HumanoidRootPart") or best.PrimaryPart
        self:SeaCancelBoatTween()
        hum.Sit = false
        if part then self:MoveTo(part.CFrame + Vector3.new(0, 45, 0)) end
        local tool = self:SelectTool()
        if tool then pcall(tool.Activate, tool) end
        return
    end
    local destination = self.Sea == "Sea2" and Vector3.new(-3500, 5, -3500) or Vector3.new(0, 5, 0)
    self:SeaBoatDrive(seat, destination)
end

function Hub:RaceV3Step()
    if self:IsRaceV3() then
        self:Log("racev3", "V3 already unlocked.")
        self:SetConfig("Race V3", false)
        return
    end
    if not Compat.find(Player, { "Data", "Race", "Evolved" }) then self:RaceV2Flowers(); return end
    local ok, start = self:Comm("Wenlocktoad", "1")
    if not ok then return end
    if start == 0 then self:Comm("Wenlocktoad", "2"); return end
    if start == 2 then self:Comm("Wenlocktoad", "3"); return end
    if start ~= 1 then return end
    local race = self:PlayerRace(Player)
    if race == "Human" then self:V3Human()
    elseif race == "Mink" then self:ChestStep()
    elseif race == "Cyborg" then
        if #self:PhysicalFruits() == 0 then
            local cheap = self:CheapStoredFruit()
            if cheap then self:Comm("LoadFruit", cheap) else self:Log("racev3", "Need a fruit to sacrifice.") end
        else
            self:Comm("Wenlocktoad", "3")
        end
    elseif race == "Fishman" then self:V3Fishman()
    elseif race == "Skypiea" or race == "Ghoul" then self:V3Pvp(race)
    else self:Log("racev3", "Unsupported race.") end
end

function Hub:RaceV4Step()
    if self.Sea ~= "Sea3" then self:Log("racev4", "Third Sea required."); return end
    local ok, state = self:Comm("RaceV4Progress", "Check")
    if not ok or type(state) ~= "number" then return end
    if state == 1 then
        self:Comm("RaceV4Progress", "Begin")
    elseif state == 2 then
        if not self:MoveTo(CFrame.new(3034.70, 2281.37, -7323.57)) then return end
        for _ = 1, 3 do self:CommRaw("RaceV4Progress", "Teleport"); task.wait(0.2) end
    elseif state == 3 then
        self:Comm("RaceV4Progress", "Continue")
    elseif state == 4 then
        local _, opened = self:Comm("CheckTempleDoor")
        if opened then
            self:Comm("requestEntrance", Vector3.new(28286.36, 14896.51, 102.62))
            self:MoveTo(CFrame.new(29551.47, 15068.72, -84.87))
            self:ChooseGear()
        else
            self:Log("racev4", "Need Mirror Fractal, Valkyrie Helm and Mirage gear.")
        end
    else
        self:Log("racev4", "Unrecognized progress state.")
    end
end

function Hub:RaceAutoTick()
    if os.clock() - (self.RaceAutoAt or 0) < 1 then return end
    self.RaceAutoAt = os.clock()
    local char = Player.Character
    if not char then return end
    if self.Config["Auto V4"] then
        local energy = char:FindFirstChild("RaceEnergy")
        local transformed = char:FindFirstChild("RaceTransformed")
        if energy and energy.Value >= 1 and transformed and transformed.Value == false then
            local backpack = Player:FindFirstChild("Backpack")
            local tool = char:FindFirstChild("Awakening") or (backpack and backpack:FindFirstChild("Awakening"))
            local rf = tool and tool:FindFirstChild("RemoteFunction")
            if rf then pcall(rf.InvokeServer, rf, true) end
        end
    end
    if self.Config["Auto V3"] then
        local race = self:PlayerRace(Player)
        local skill = race and self.V3Skills[race]
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and skill and not root:FindFirstChild(skill) and hum.MaxHealth > 0 then
            if hum.Health / hum.MaxHealth * 100 <= self.Config["V3 Min Health"] then
                if os.clock() - (self.V3UseAt or 0) > 30 then
                    self.V3UseAt = os.clock()
                    self:CommE("ActivateAbility")
                end
            end
        end
    end
end

