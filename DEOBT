function Hub:HalloweenMysteryStart(entry)
    if not entry or not entry.Door then return end
    local current = self.HalloweenMystery
    if current and current.Active and current.Door == entry.Door then return end
    local mysteryState = {
        Door = entry.Door, Active = true, Prev = {}, Seq = {}, LastRoom = {}, LastName = {},
        LastEntryAt = {}, LastActive = {}, Started = os.clock()
    }
    self.HalloweenMystery = mysteryState
    self.HalloweenMysteryPending = nil
    task.spawn(function()
        while self.Alive and mysteryState.Active and self.HalloweenMystery == mysteryState and os.clock() - mysteryState.Started < 600 do
            self:HalloweenMysterySample(mysteryState)
            task.wait(0.06)
        end
        mysteryState.Active = false
    end)
end

function Hub:HalloweenMysteryStage(part)
    if not part or not part:IsA("BasePart") then return nil end
    local origin = part.CFrame
    local candidates = {}
    local function consider(scope)
        if not scope then return end
        for _, descendant in ipairs(scope:GetDescendants()) do
            if descendant:IsA("Model") and descendant.Name == "MysteryHall" then
                local score = 0
                for _, child in ipairs(descendant:GetChildren()) do
                    if child:IsA("Model") and (child.Name == "Detective" or self.HalloweenMysteryCast[child.Name]) then
                        score += 1
                    end
                end
                if score > 0 then table.insert(candidates, { Stage = descendant, Score = score }) end
            end
        end
    end
    consider(Player:FindFirstChild("PlayerGui"))
    local door = part.Parent
    if door then consider(door) end
    table.sort(candidates, function(a, b) return a.Score > b.Score end)
    local function fits(stage, name, minZ)
        local rig = stage:FindFirstChild(name)
        local rigRoot = rig and rig:FindFirstChild("HumanoidRootPart")
        if not rigRoot or not rigRoot:IsA("BasePart") then return false end
        local localPos = origin:PointToObjectSpace(rigRoot.Position)
        return math.abs(localPos.X) <= 24 and localPos.Z >= minZ and localPos.Z <= 58 and localPos.Y > -30
    end
    for _, candidate in ipairs(candidates) do
        if fits(candidate.Stage, "Detective", 30) then return candidate.Stage end
    end
    for _, candidate in ipairs(candidates) do
        for _, name in ipairs(self.HalloweenMysteryCastList) do
            if fits(candidate.Stage, name, 8) then return candidate.Stage end
        end
    end
    return candidates[1] and candidates[1].Stage or nil
end

function Hub:HalloweenMysterySample(mysteryState)
    local door = mysteryState.Door
    if not door or not door.Parent then mysteryState.Active = false; return end
    if door:GetAttribute("DoorOpen") == false and os.clock() - mysteryState.Started > 5 then
        mysteryState.Active = false
        return
    end
    local part = door:FindFirstChild("Part")
    if not part or not part:IsA("BasePart") then return end
    local stage = mysteryState.Stage
    if stage and not stage.Parent then stage = nil; mysteryState.Stage = nil end
    if not stage and os.clock() >= (mysteryState.NextStageSearch or 0) then
        mysteryState.NextStageSearch = os.clock() + 0.5
        stage = self:HalloweenMysteryStage(part)
        mysteryState.Stage = stage
    end
    if not stage then return end
    local origin = part.CFrame
    local activeNow, activeCount = {}, 0
    for _, child in ipairs(stage:GetChildren()) do
        if child:IsA("Model") and self.HalloweenMysteryCast[child.Name] then
            local rigRoot = child:FindFirstChild("HumanoidRootPart")
            if rigRoot and rigRoot:IsA("BasePart") then
                local localPos = origin:PointToObjectSpace(rigRoot.Position)
                if localPos.Y > -30 then
                    activeNow[child.Name] = true
                    activeCount += 1
                    local zone, room = "Hall", nil
                    for index, data in ipairs(self.HalloweenMysteryRooms) do
                        local dx, dz = localPos.X - data[1], localPos.Z - data[2]
                        local distance = math.sqrt(dx * dx + dz * dz)
                        local signed = dx * data[3] + dz * data[4]
                        if distance <= 3.2 and signed < 0.2 then
                            zone, room = "Inside", index
                            break
                        elseif distance <= 4.5 and signed >= 0.2 and zone == "Hall" then
                            zone, room = "Front", index
                        end
                    end
                    local prev = mysteryState.Prev[child.Name]
                    if zone == "Inside" and (not prev or prev.Zone ~= "Inside") then
                        mysteryState.Seq[child.Name] = mysteryState.Seq[child.Name] or {}
                        local seq = mysteryState.Seq[child.Name]
                        if seq[#seq] ~= room or os.clock() - (mysteryState.LastEntryAt[child.Name] or 0) > 1 then
                            table.insert(seq, room)
                            mysteryState.LastRoom[child.Name] = room
                            mysteryState.LastName[room] = child.Name
                            mysteryState.LastEntryAt[child.Name] = os.clock()
                        end
                    end
                    mysteryState.Prev[child.Name] = { Zone = zone, Room = room, At = os.clock() }
                else
                    mysteryState.Prev[child.Name] = { Zone = "Park", At = os.clock() }
                end
            end
        end
    end
    if activeCount >= 2 then mysteryState.LastActive = activeNow end
    if mysteryState.CaptureUntil and os.clock() < mysteryState.CaptureUntil then
        mysteryState.BeforeSet = mysteryState.BeforeSet or {}
        for name in pairs(activeNow) do mysteryState.BeforeSet[name] = true end
    end
end

function Hub:HalloweenMysteryObserve(text)
    local mysteryState = self.HalloweenMystery
    if not mysteryState or not mysteryState.Active or type(text) ~= "string" or text == "" then return end
    local lower = text:lower()
    local function newRound(kind)
        if mysteryState.Round == kind and os.clock() - (mysteryState.RoundAt or 0) < 3 then return end
        mysteryState.Round, mysteryState.RoundAt = kind, os.clock()
        mysteryState.Seq, mysteryState.LastRoom, mysteryState.LastName = {}, {}, {}
        for name, prev in pairs(mysteryState.Prev or {}) do
            if prev.Zone == "Inside" and prev.Room then
                mysteryState.Seq[name] = { prev.Room }
                mysteryState.LastRoom[name] = prev.Room
                mysteryState.LastName[prev.Room] = name
            end
        end
    end
    if lower:find("keep an eye on the", 1, true) then
        newRound("Track")
    elseif lower:find("switching rooms again", 1, true) then
        newRound("WhoWent")
    elseif lower:find("making a run for it", 1, true) then
        newRound("Sequence")
    elseif lower:find("study these faces carefully", 1, true) then
        newRound("Impostor")
        mysteryState.CaptureUntil = os.clock() + 1.2
    end
end

function Hub:HalloweenMysteryAnswer(options, text)
    local mysteryState = self.HalloweenMystery
    if not mysteryState or not mysteryState.Active then return nil end
    local lower = (text or ""):lower()
    local function castIn(value)
        return self:HalloweenMysteryCastOf(value)
    end
    if lower:find("which room did the", 1, true) then
        local name = castIn(lower)
        local room = name and mysteryState.LastRoom[name] or nil
        if room then
            local exact = self:HalloweenFindOption(options, "Room " .. tostring(room))
            if exact then return exact end
            for _, entry in ipairs(options) do
                local digits = {}
                for digit in entry.Label:gmatch("%d+") do table.insert(digits, tonumber(digit)) end
                if #digits == 1 and digits[1] == room then return entry end
            end
        end
    elseif lower:find("last to enter room", 1, true) then
        local number = tonumber(lower:match("room%s*(%d+)"))
        local name = number and mysteryState.LastName[number] or nil
        if name then return self:HalloweenMysteryFindCastOption(options, name) or self:HalloweenFindOption(options, name) end
    elseif lower:find("which doors did the", 1, true) then
        local name = castIn(lower)
        local seq = name and mysteryState.Seq[name] or nil
        if seq and #seq > 0 then
            local best, bestCount, bestFull = nil, 0, false
            for _, entry in ipairs(options) do
                local digits = {}
                for digit in entry.Label:gmatch("%d+") do table.insert(digits, tonumber(digit)) end
                for offset = 0, math.max(0, #digits - #seq) do
                    local matched = 0
                    for index = 1, #seq do
                        if digits[offset + index] == seq[index] then matched += 1 end
                    end
                    local full = matched == #seq
                    if matched > bestCount or (full and not bestFull) then
                        best, bestCount, bestFull = entry, matched, full
                    end
                end
            end
            if best and (bestFull or bestCount >= 3) then return best end
        end
    elseif lower:find("here before", 1, true) then
        if mysteryState.BeforeSet then
            for name in pairs(mysteryState.LastActive) do
                if not mysteryState.BeforeSet[name] then
                    local found = self:HalloweenMysteryFindCastOption(options, name) or self:HalloweenFindOption(options, name)
                    if found then return found end
                end
            end
            for _, entry in ipairs(options) do
                local name = castIn(entry.Lower)
                if name and not mysteryState.BeforeSet[name] then return entry end
            end
        end
    end
    return nil
end

