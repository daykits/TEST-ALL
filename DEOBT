function Hub:HalloweenTarotButtons()
    local map, list = {}, {}
    local gui = Player:FindFirstChild("PlayerGui")
    local rootGui = gui and gui:FindFirstChild("ConcentrationGameRoot") or nil
    if not rootGui then return map, list, nil end
    local scope = rootGui
    local layout = rootGui:FindFirstChildWhichIsA("UIGridLayout", true)
    if layout and layout.Parent then scope = layout.Parent end
    for _, object in ipairs(scope:GetDescendants()) do
        if object:IsA("GuiButton") and object.Visible then
            local index
            local current = object
            for _ = 1, 6 do
                if not current then break end
                local namedIndex = tonumber(tostring(current.Name):match("^Card(%d+)$"))
                if namedIndex then index = namedIndex; break end
                if current:IsA("GuiObject") and current.LayoutOrder and current.LayoutOrder > 0 then
                    index = current.LayoutOrder
                    break
                end
                current = current.Parent
            end
            table.insert(list, { Button = object, Index = index })
            if index and not map[index] then map[index] = object end
        end
    end
    return map, list, rootGui
end

function Hub:HalloweenTarotButton(index)
    if type(index) ~= "number" then return nil end
    local map, list = self:HalloweenTarotButtons()
    if typeof(map[index]) == "Instance" then return map[index] end
    local buttons = {}
    for _, entry in ipairs(list) do
        if entry.Button.AbsoluteSize.X > 16 and entry.Button.AbsoluteSize.Y > 16 then
            table.insert(buttons, entry.Button)
        end
    end
    table.sort(buttons, function(a, b)
        if math.abs(a.AbsolutePosition.Y - b.AbsolutePosition.Y) > 24 then return a.AbsolutePosition.Y < b.AbsolutePosition.Y end
        return a.AbsolutePosition.X < b.AbsolutePosition.X
    end)
    return buttons[index]
end

function Hub:HalloweenTarotClick(button, method)
    if type(button) == "number" then button = self:HalloweenTarotButton(button) end
    if typeof(button) ~= "Instance" or not button.Parent then return false end
    if method == 1 and type(firesignal) == "function" then
        return pcall(firesignal, button.Activated)
    end
    if method == 2 then
        local ok, vim = pcall(game.GetService, game, "VirtualInputManager")
        if ok and vim and button.AbsoluteSize.X > 0 and button.AbsoluteSize.Y > 0 then
            local size = button.AbsoluteSize
            local position = button.AbsolutePosition
            local x, y = position.X + size.X / 2, position.Y + size.Y / 2
            return pcall(function()
                vim:SendMouseMoveEvent(x, y, game)
                vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
                task.wait(0.06)
                vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end)
        end
        return false
    end
    if type(firesignal) == "function" then
        local fired = pcall(firesignal, button.MouseButton1Click)
        local firedDown = pcall(firesignal, button.MouseButton1Down)
        local firedUp = pcall(firesignal, button.MouseButton1Up)
        return fired or firedDown or firedUp
    end
    return self:HalloweenClickGui(button)
end

function Hub:HalloweenTarotStep()
    if self.Config["Halloween Tarot"] == "Nevermind (skip)" then return false end
    if not self.HalloweenTarotArmed then
        local _, list = self:HalloweenTarotButtons()
        if #list < 4 then return false end
        self.HalloweenTarotArmed = true
        self.HalloweenTarotWasOpen = false
        self.HalloweenTarotKnown = self.HalloweenTarotKnown or {}
    end
    local cg = self:HalloweenTarotModule()
    if not cg then
        local gui = Player:FindFirstChild("PlayerGui")
        if gui and gui:FindFirstChild("ConcentrationGameRoot") then
            self:CancelMove()
            self:HalloweenStatus("Tarot | Controller loading")
            return true
        end
        return false
    end
    local open, board, busy = self:HalloweenTarotState(cg)
    if not open then
        if self.HalloweenTarotWasOpen then
            self.HalloweenTarotWasOpen = false
            self.HalloweenTarotArmed = false
            self.HalloweenTarotKnown = nil
            self.HalloweenTarotPending = nil
        end
        return false
    end
    self.HalloweenTarotWasOpen = true
    self:CancelMove()
    if type(board) ~= "table" or type(board.Cells) ~= "table" then
        self:HalloweenStatus("Tarot | Waiting for the cards")
        return true
    end
    self.HalloweenTarotKnown = self.HalloweenTarotKnown or {}
    local known = self.HalloweenTarotKnown
    local revealed, unmatched = {}, {}
    for index, cell in ipairs(board.Cells) do
        if type(cell) == "table" then
            if cell.Id ~= nil and cell.State ~= "Hidden" then known[index] = cell.Id end
            if cell.State == "Revealed" then table.insert(revealed, index) end
            if cell.State ~= "Matched" then table.insert(unmatched, index) end
        end
    end
    if #unmatched == 0 then
        self.HalloweenTarotPending = nil
        self:HalloweenStatus("Tarot | Matching complete")
        return true
    end
    local pending = self.HalloweenTarotPending
    if pending then
        local flipCount = board.FlipCount or 0
        local cellNow = board.Cells[pending.Index]
        local progressed = flipCount > (pending.FlipCount or 0)
            or (type(cellNow) == "table" and cellNow.State ~= pending.State)
        if progressed then
            self.HalloweenTarotMethod = pending.Method
            self.HalloweenTarotPending = nil
            pending = nil
        elseif busy or os.clock() - pending.At < 1.4 then
            self:HalloweenStatus("Tarot | Flipping card " .. tostring(pending.Index))
            return true
        elseif pending.Tries >= 3 then
            self.HalloweenTarotPending = nil
            self.HalloweenTarotAt = os.clock() + 3
            self:HalloweenStatus("Tarot | Clicks not registering; tap a card manually once")
            return true
        else
            local nextMethod = pending.Method % 3 + 1
            local button = self:HalloweenTarotButton(pending.Index)
            if button then self:HalloweenTarotClick(button, nextMethod) end
            pending.Method = nextMethod
            pending.Tries += 1
            pending.At = os.clock()
            pending.FlipCount = flipCount
            pending.State = type(cellNow) == "table" and cellNow.State or nil
            self:HalloweenStatus("Tarot | Retrying card " .. tostring(pending.Index) .. " (method " .. tostring(nextMethod) .. ")")
            return true
        end
    end
    if busy or os.clock() < (self.HalloweenTarotAt or 0) then
        self:HalloweenStatus("Tarot | Matching cards (" .. tostring(board.MatchCount or 0) .. "/" .. tostring(board.PairCount or "?") .. " pairs)")
        return true
    end
    local function isRevealed(index)
        for _, value in ipairs(revealed) do if value == index then return true end end
        return false
    end
    local target
    if #revealed == 1 then
        local id = known[revealed[1]]
        if id ~= nil then
            for _, index in ipairs(unmatched) do
                if index ~= revealed[1] and known[index] == id then target = index; break end
            end
        end
    else
        local seen = {}
        for _, index in ipairs(unmatched) do
            local id = known[index]
            if id ~= nil and not isRevealed(index) then
                if seen[id] then target = seen[id]; break end
                seen[id] = index
            end
        end
    end
    if not target then
        local special = board.SpecialRewardIndex
        if type(special) == "number" and known[special] == nil and not isRevealed(special)
            and type(board.Cells[special]) == "table" and board.Cells[special].State == "Hidden" then
            target = special
        end
    end
    if not target then
        for _, index in ipairs(unmatched) do
            if known[index] == nil and not isRevealed(index) then target = index; break end
        end
    end
    if not target then
        for _, index in ipairs(unmatched) do
            if not isRevealed(index) then target = index; break end
        end
    end
    if not target then return true end
    local button = self:HalloweenTarotButton(target)
    if not button then
        self.HalloweenTarotAt = os.clock() + 2
        self:HalloweenStatus("Tarot | Card buttons not found; solve manually or set Tarot to Nevermind")
        return true
    end
    local method = self.HalloweenTarotMethod or 1
    local cell = board.Cells[target]
    self:HalloweenTarotClick(button, method)
    self.HalloweenTarotPending = {
        Index = target, FlipCount = board.FlipCount or 0,
        State = type(cell) == "table" and cell.State or nil,
        At = os.clock(), Method = method, Tries = 1
    }
    self.HalloweenTarotAt = os.clock() + 0.6
    self:HalloweenStatus("Tarot | Flipping card " .. tostring(target))
    return true
end


