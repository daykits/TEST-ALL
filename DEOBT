function Hub:WebhookSetURL(raw, quiet)
    local text = type(raw) == "string" and raw or ""
    local found = text:match("https://%S+")
    if found then found = found:gsub("[\"'%)%]>`,;]+$", "") end
    if not found then
        if not quiet then self:Notify("Webhook", "No URL found. Copy the Discord webhook URL first.") end
        return false
    end
    self:SetConfig("Webhook URL", found:sub(1, 300))
    self:RenderWebhookSettings()
    if self:WebhookURL() then
        if not quiet then self:Notify("Webhook", "Webhook URL saved (..." .. found:sub(-6) .. ").") end
        return true
    end
    if not quiet then self:Notify("Webhook", "That does not look like a Discord webhook URL.") end
    return false
end

