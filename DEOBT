function Hub:HopPublicServer(reason, cooldown)
    if os.clock() < (self.PublicHopAt or 0) then return false end
    self.PublicHopAt = os.clock() + (cooldown or 25)
    local ok, data = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"
        return Services.HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok or type(data) ~= "table" or type(data.data) ~= "table" then return false end
    for _, server in ipairs(data.data) do
        if type(server) == "table" and type(server.id) == "string" and server.id ~= game.JobId and (server.playing or 0) < (server.maxPlayers or math.huge) then
            local browser = Services.ReplicatedStorage:FindFirstChild("__ServerBrowser")
            if browser and browser:IsA("RemoteFunction") then
                self:Log("hop", "Server hopping: " .. tostring(reason), 5)
                pcall(browser.InvokeServer, browser, "teleport", server.id)
                return true
            end
        end
    end
    return false
end

function Hub:KenPointsStep()
    if os.clock() - (self.KenPointsAt or 0) < 3 then return end
    self.KenPointsAt = os.clock()
    local ok, result = self:Comm("KenTalk", "Status")
    local points = ok and tonumber(string.match(tostring(result), "%d+"))
    self:SetInfo("KenPointsInfo", "Dodge points: " .. tostring(points or "no data"))
end

function Hub:ObservationFarm(hop)
    local _, hum, root = self:Character()
    if not hum or not root then return false end
    self:KenRefresh()
    local mobName = self.KenFarmMobs[self.Sea]
    if not mobName then self:SetInfo("KenStatusInfo", "Unsupported sea"); return false end
    local dodges = Player:GetAttribute("KenDodgesLeft")
    local depleted = type(dodges) == "number" and dodges <= 0
    if depleted and hop then
        self:SetInfo("KenStatusInfo", "No dodges left | hopping")
        self:HopPublicServer("Observation dodges", 25)
    end
    local mob = self:Enemies(mobName, 3000)[1]
    local part = mob and (mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart)
    if not part then
        self:SetInfo("KenStatusInfo", "Waiting for " .. mobName)
        if not self:MoveToSpawn(mobName) and self.KenFarmSpots[self.Sea] then self:MoveTo(self.KenFarmSpots[self.Sea]) end
        return true
    end
    self.KenFarming = true
    if depleted then self:MoveTo(part.CFrame * CFrame.new(0, 50, 0))
    else self:MoveTo(part.CFrame * CFrame.new(3, 0, 0)) end
    if os.clock() - (self.KenInfoAt or 0) > 1 then
        self.KenInfoAt = os.clock()
        self:SetInfo("KenStatusInfo", (depleted and "Safe (no dodges) | " or "Training | ") .. mobName .. " | " .. math.floor(hum.Health) .. " HP")
    end
    return true
end

function Hub:KenFarmStep()
    self.KenFarming = false
    self:KenPointsStep()
    if not self.Config["Farm Ken"] then
        if self.KenWasOn then self.KenWasOn = nil; self:SetInfo("KenStatusInfo", "Off") end
        return
    end
    if not self:HasKen() then
        self:SetConfig("Farm Ken", false)
        self:Notify("Farm Observation", "Need Observation Haki first.")
        return
    end
    local _, hum, root = self:Character()
    if not hum or not root then return end
    if hum.Health / hum.MaxHealth < 0.25 then
        self:SetConfig("Farm Ken", false)
        self:CancelMove()
        self:Notify("Farm Observation", "HP low, stopped.")
        return
    end
    self.KenWasOn = true
    self:ObservationFarm(false)
end

