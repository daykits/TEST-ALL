function Hub:SeaDangerStep()
    local char, hum, root = self:Character()
    if not char or not root then return end
    local target, part, isEnemy = self:SeaTarget()
    if self.SeaEngaged and target ~= self.SeaEngaged then
        local name = self.SeaEngagedName or "Sea Beast"
        self.SeaEngaged, self.SeaEngagedName = nil, nil
        self.SeaKills = (self.SeaKills or 0) + 1
        if name:lower():find("leviathan", 1, true) then
            if self:WebhookOn("Leviathan") then self:WebhookSend("Leviathan Defeated", name .. " was defeated at sea.", 15158332, self:WebhookStatFields()) end
        elseif self:WebhookOn("Sea Event Kill") then
            self:WebhookSend("Sea Event Kill", name .. " defeated (total " .. self.SeaKills .. ").", 3066993, self:WebhookStatFields())
        end
    end
    if target and part then
        if self.SeaEngaged ~= target then self.SeaEngaged, self.SeaEngagedName = target, target.Name end
        self:SeaCancelBoatTween()
        if hum then hum.Sit = false end
        self:SeaStatus("Fighting " .. target.Name)
        if isEnemy then
            self:Fight(target, target.Name, false)
        else
            if (root.Position - part.Position).Magnitude > 20 then self:MoveTo(part.CFrame + Vector3.new(0, 45, 0)); return end
            local tool = self:SelectTool()
            if tool then pcall(tool.Activate, tool) end
        end
        return
    end
    local boat = self:OwnBoat()
    if not boat then
        self:SeaStatus("Buying a boat")
        if os.clock() - (self.SeaBoatAt or 0) > 10 then self.SeaBoatAt = os.clock(); self:BuyBoat() end
        return
    end
    local seat = boat:FindFirstChild("VehicleSeat")
    if not seat or not hum then return end
    if hum.SeatPart ~= seat then
        self:SeaStatus("Boarding boat")
        if not self:MoveTo(seat.CFrame + Vector3.new(0, 4, 0)) then return end
        pcall(seat.Sit, seat, hum)
        return
    end
    local points = self.Sea == "Sea2" and { Vector3.new(-3500, 5, -3500), Vector3.new(3500, 5, 3500), Vector3.new(-3500, 5, 3500) } or { Vector3.new(0, 5, 0), Vector3.new(6500, 5, -6500), Vector3.new(-6500, 5, 6500), Vector3.new(6500, 5, 6500) }
    self.SeaPoint = self.SeaPoint or 1
    local dest = points[self.SeaPoint]
    if (seat.Position - dest).Magnitude < 120 then
        self.SeaPoint = self.SeaPoint % #points + 1
        dest = points[self.SeaPoint]
    end
    self:SeaStatus("Sailing danger zones | Kills " .. (self.SeaKills or 0))
    self:SeaBoatDrive(seat, dest)
end

