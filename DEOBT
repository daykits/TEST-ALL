-- 7) THEME MANAGER
--=====================================================================
local ThemeManager = {
    _listeners = {},
}
ThemeManager.__index = ThemeManager

function ThemeManager:Get()
    return CurrentTheme
end

function ThemeManager:Register(listener)
    table.insert(self._listeners, listener)
end

function ThemeManager:Set(name)
    local t = Themes[name]
    if not t then return false end
    CurrentThemeName = name
    CurrentTheme = t
    for _, cb in ipairs(self._listeners) do
        pcall(cb, CurrentTheme)
    end
    return true
end

function ThemeManager:SetAccent(color)
    if typeof(color) ~= "Color3" then return false end
    CurrentTheme.Accent = color
    local h = color:Lerp(Color3.new(1, 1, 1), 0.15)
    CurrentTheme.AccentHover = h
    for _, cb in ipairs(self._listeners) do
        pcall(cb, CurrentTheme)
    end
    return true
end

function ThemeManager:Names()
    local names = {}
    for k in pairs(Themes) do table.insert(names, k) end
    return names
end

