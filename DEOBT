local NotificationEngine = {}
NotificationEngine.__index = NotificationEngine

function NotificationEngine.new(rootGui, cleanup)
    return setmetatable({
        RootGui = rootGui,
        Cleanup = cleanup,
        Stack   = {},
    }, NotificationEngine)
end

function NotificationEngine:_Layout()
    local y = 16
    for _, n in ipairs(self.Stack) do
        local target = UDim2.new(1, -32, 0, y)
        GlobalAnimations:Play(n.Frame, { Position = target }, TweenInfo.new(0.25, Enum.EasingStyle.Quart))
        y = y + n.Frame.AbsoluteSize.Y + 8
    end
end

function NotificationEngine:Push(cfg)
    cfg = cfg or {}
    local theme = CurrentTheme
    local color = theme.Accent
    local icon  = "ℹ"
    local ntype = cfg.Type or "Info"
    if ntype == "Success" then color, icon = theme.Success, "✓"
    elseif ntype == "Warning" then color, icon = theme.Warning, "⚠"
    elseif ntype == "Error" then color, icon = theme.Error, "✕" end

    local frame = New("Frame", {
        BackgroundColor3 = theme.Card,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 300, 0, 70),
        Position = UDim2.new(1, 340, 0, 16),
        ZIndex = 100,
        Parent = self.RootGui,
    })
    Corner(10).Parent = frame
    Stroke(theme.Border, 1).Parent = frame
    New("Frame", {
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 3, 1, -14),
        Position = UDim2.fromOffset(6, 7),
        ZIndex = 101,
        Parent = frame,
    }):SetAttribute("Ignore", true)

    New("TextLabel", {
        BackgroundTransparency = 1,
        Text = icon,
        Font = Enum.Font.GothamBold,
        TextColor3 = color,
        TextSize = 16,
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.fromOffset(16, 10),
        ZIndex = 101,
        Parent = frame,
    })
    New("TextLabel", {
        BackgroundTransparency = 1,
        Text = cfg.Title or "Notification",
        Font = Enum.Font.GothamBold,
        TextColor3 = theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.fromOffset(48, 10),
        Size = UDim2.new(1, -60, 0, 16),
        ZIndex = 101,
        Parent = frame,
    })
    New("TextLabel", {
        BackgroundTransparency = 1,
        Text = cfg.Content or "",
        Font = Enum.Font.Gotham,
        TextColor3 = theme.TextSecondary,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Position = UDim2.fromOffset(48, 28),
        Size = UDim2.new(1, -60, 0, 34),
        ZIndex = 101,
        Parent = frame,
    })

    local entry = { Frame = frame }
    table.insert(self.Stack, entry)

    -- Enforce limit
    while #self.Stack > NOTIFY_LIMIT do
        local old = table.remove(self.Stack, 1)
        if old then old.Frame:Destroy() end
    end

    self:_Layout()

    -- Animate in
    GlobalAnimations:Play(frame, {
        Position = UDim2.new(1, -316, 0, frame.Position.Y.Offset),
    }, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out))

    local duration = tonumber(cfg.Duration) or 3
    task.delay(duration, function()
        if not frame.Parent then return end
        self:_Dismiss(entry)
    end)

    return entry
end

function NotificationEngine:_Dismiss(entry)
    for i, n in ipairs(self.Stack) do
        if n == entry then table.remove(self.Stack, i); break end
    end
    GlobalAnimations:Play(entry.Frame, {
        Position = UDim2.new(1, 340, 0, entry.Frame.Position.Y.Offset),
    }, TweenInfo.new(0.3, Enum.EasingStyle.Quart))
    task.delay(0.35, function()
        if entry.Frame.Parent then entry.Frame:Destroy() end
        self:_Layout()
    end)
end

--=====================================================================
-- 14) CONFIG ENGINE
--=====================================================================
local ConfigEngine = {}
ConfigEngine.__index = ConfigEngine

function ConfigEngine.new()
    return setmetatable({
        Store = {},           -- in-memory: name -> { ComponentRegistry }
        Registry = {},        -- component -> key
    }, ConfigEngine)
end

function ConfigEngine:Register(component, key)
    self.Registry[component] = key
end

function ConfigEngine:CollectSnapshot()
    local snap = {}
    for comp, key in pairs(self.Registry) do
        local entry
        if comp._type == "Toggle" then entry = { Type = "Toggle", Value = comp.GetValue() }
        elseif comp._type == "Slider" then entry = { Type = "Slider", Value = comp.GetValue() }
        elseif comp._type == "Dropdown" then entry = { Type = "Dropdown", Value = comp.GetValue() }
        elseif comp._type == "MultiDropdown" then entry = { Type = "MultiDropdown", Value = comp.GetValues() }
        elseif comp._type == "Textbox" then entry = { Type = "Textbox", Value = comp.GetText() }
        elseif comp._type == "Keybind" then entry = { Type = "Keybind", Value = comp.GetKey().Name }
        elseif comp._type == "ColorPicker" then entry = { Type = "ColorPicker", Value = Color3ToHex(comp.GetColor()) }
        end
        if entry then snap[key] = entry end
    end
    return snap
end

function ConfigEngine:ApplySnapshot(snap, compMap)
    for key, data in pairs(snap or {}) do
        local comp = compMap[key]
        if comp then
            pcall(function()
                if data.Type == "Toggle" then comp.SetValue(data.Value)
                elseif data.Type == "Slider" then comp.SetValue(tonumber(data.Value) or 0)
                elseif data.Type == "Dropdown" then comp.SetValue(data.Value)
                elseif data.Type == "MultiDropdown" then comp.SetValues(data.Value or {})
                elseif data.Type == "Textbox" then comp.SetText(data.Value)
                elseif data.Type == "Keybind" then
                    local kc = Enum.KeyCode[tostring(data.Value)]
                    if kc then comp.SetKey(kc) end
                elseif data.Type == "ColorPicker" then
                    local c = HexToColor3(tostring(data.Value))
                    if c then comp.SetColor(c) end
                end
            end)
        end
    end
end

--=====================================================================
-- 15) PUBLIC API
--=====================================================================
local windows = {}

function BananaUI:CreateWindow(cfg)
    local w = Window.new(cfg or {})
    w.NotifyEngine = NotificationEngine.new(w.RootGui, w.Cleanup)
    w.ConfigEngine = ConfigEngine.new()
    table.insert(windows, w)
    return w
end

function BananaUI:Notify(cfg)
    -- Use the most recently created window's notify engine
    local w = windows[#windows]
    if not w then
        warn("[BananaUI] No window to notify.")
        return
    end
    return w.NotifyEngine:Push(cfg)
end

function BananaUI:SetTheme(name)
    return ThemeManager:Set(name)
end

function BananaUI:SetAccentColor(color)
    return ThemeManager:SetAccent(color)
end

function BananaUI:GetThemeNames()
    return ThemeManager:Names()
end

function BananaUI:SetAnimationDuration(sec)
    AnimationEngine.Default = TweenInfo.new(tonumber(sec) or 0.22,
        AnimationEngine.Default.EasingStyle, AnimationEngine.Default.EasingDirection)
end

function BananaUI:GetWindows()
    return windows
end

