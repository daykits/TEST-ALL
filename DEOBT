	radius = radius or 30

	for _, d in ipairs(getAllNPCs(targetName)) do

		local hum = d.npc and d.npc:FindFirstChild("Humanoid")

		if d.hrp and hum and hum.Health > 0 then

			local dist = (d.hrp.Position - centerPos).Magnitude

			if dist <= radius and dist < bestDist then

				closest = d.npc

				bestDist = dist

			end

		end

	end

	return closest

end

local AIR_HOLD_BV_NAME = "KT_AirHoldBV"

local AIR_HOLD_BP_NAME = "KT_AirHoldBP"

local function enableAirHold(rp, targetPos)

	if not rp then return end

	targetPos = targetPos or rp.Position

	local bv = rp:FindFirstChild(AIR_HOLD_BV_NAME)

	if not bv then

		bv = Instance.new("BodyVelocity")

		bv.Name = AIR_HOLD_BV_NAME

		bv.Parent = rp

	end

	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)

	bv.P = 1e7

	bv.Velocity = Vector3.zero

	local bp = rp:FindFirstChild(AIR_HOLD_BP_NAME)

	if not bp then

		bp = Instance.new("BodyPosition")

		bp.Name = AIR_HOLD_BP_NAME

		bp.Parent = rp

	end

	bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)

	bp.P = 1e7

	bp.D = 1000

	bp.Position = targetPos

end

local function disableAirHold()

	local rp = getHRP()

	if not rp then return end

	local bv = rp:FindFirstChild(AIR_HOLD_BV_NAME)

	if bv then bv:Destroy() end

	local bp = rp:FindFirstChild(AIR_HOLD_BP_NAME)

	if bp then bp:Destroy() end

end

local function hardLockRoot(rp, hum, cf)

	if not rp or not hum then return end

	enableAirHold(rp, cf.Position)

	hum.PlatformStand = false

	hum.Sit = false

	hum.AutoRotate = false

	hum:ChangeState(Enum.HumanoidStateType.Freefall)

	rp.CFrame = cf

	rp.AssemblyLinearVelocity = Vector3.zero

	rp.AssemblyAngularVelocity = Vector3.zero

	rp.Velocity = Vector3.zero

end

local function lockAbovePosition(pos, duration)

	if typeof(pos) ~= "Vector3" then return end

	local untilTime = tick() + (duration or 0.25)

	while tick() < untilTime do

		local rp = getHRP()

		local hum = getHumanoid()

		if not rp or not hum or hum.Health <= 0 then break end

		hardLockRoot(rp, hum, CFrame.new(pos))

		RunService.Heartbeat:Wait()

	end

end

-- Calcule la CFrame de combat pour les yetis : on reste centre au-dessus

-- du yeti Ã  hauteur fixedY, sans rotation couchÃ©e.

local function getYetiCombatCFrame(yetiHrp, fixedY, currentRp)

	if not yetiHrp then return nil end

	local dist = tonumber(H.YETI_HIT_DISTANCE) or 8.5

	local hoverY = fixedY or (yetiHrp.Position.Y + (tonumber(H.YETI_HOVER_HEIGHT) or 8.3))

	local pos

	if dist <= 0 then

		pos = Vector3.new(yetiHrp.Position.X, hoverY, yetiHrp.Position.Z)

	else

		local away

		if currentRp then

			away = Vector3.new(

				currentRp.Position.X - yetiHrp.Position.X,

				0,

				currentRp.Position.Z - yetiHrp.Position.Z

			)

		end

		if not away or away.Magnitude <= 0.05 then

			local a = math.rad(tonumber(H.YETI_HIT_ROTATION_Y) or 0)

			away = Vector3.new(math.sin(a), 0, math.cos(a))

		else

			away = away.Unit

		end

		pos = Vector3.new(

			yetiHrp.Position.X + away.X * dist,

			hoverY,

			yetiHrp.Position.Z + away.Z * dist

		)

	end

	local rotX = math.rad(tonumber(H.YETI_HIT_ROTATION_X) or 0)

	local rotY = math.rad(tonumber(H.YETI_HIT_ROTATION_Y) or 0)

	local rotZ = math.rad(tonumber(H.YETI_HIT_ROTATION_Z) or 0)

	return CFrame.new(pos) * CFrame.Angles(rotX, rotY, rotZ)

end

local function lockAboveNPC(npc, hoverHeight, duration, fixedY)

	hoverHeight = hoverHeight or 8.6

	local untilTime = tick() + (duration or 0.25)

	local isYeti = npc and npc.Name == "Yeti"

	while tick() < untilTime do

		local rp = getHRP()

		local humSelf = getHumanoid()

		local hrp = npc and npc:FindFirstChild("HumanoidRootPart")

		local hum = npc and npc:FindFirstChild("Humanoid")

		if not rp or not humSelf or humSelf.Health <= 0 or not hrp or not hum or hum.Health <= 0 then

			break

		end

		local y = fixedY or (hrp.Position.Y + hoverHeight)

		local cf

		if isYeti then

			cf = getYetiCombatCFrame(hrp, y, rp) or CFrame.new(hrp.Position.X, y, hrp.Position.Z)

		else

			cf = CFrame.new(hrp.Position.X, y, hrp.Position.Z)

		end

		hardLockRoot(rp, humSelf, cf)

		RunService.Heartbeat:Wait()

	end

end

local function doDamageCombo(targetName, centerPos, lockPos, radius)

	local rp = getHRP()

	if not rp then return end

	equipMelee()

	local hoverHeight = 8.6

	if lockPos and typeof(lockPos) == "Vector3" then

		hoverHeight = math.max(2, lockPos.Y - centerPos.Y)

	end

	for combo = 1, 5 do

		if not getgenv().KaitunFarm and not getgenv().Sea2Farm then break end

		local followNpc = getClosestNPCToPosition(targetName, centerPos, radius or 30)

		local fixedCombatY = lockPos and lockPos.Y or (centerPos.Y + hoverHeight)

		local clusterCenterPos = centerPos

		if followNpc then

			lockAboveNPC(followNpc, hoverHeight, 0.08, fixedCombatY)

		elseif lockPos then

			lockAbovePosition(lockPos, 0.08)

		end

		pcall(function()

			local current = getHRP()

			local followHrp = followNpc and followNpc:FindFirstChild("HumanoidRootPart")

			local followHum = followNpc and followNpc:FindFirstChild("Humanoid")

			local clusterRadius = math.max(radius or 24, 36)

			if current and followHrp and followHum and followHum.Health > 0 then

				clusterCenterPos = followHrp.Position

				current.CFrame = CFrame.new(followHrp.Position.X, fixedCombatY, followHrp.Position.Z)

				current.AssemblyLinearVelocity = Vector3.zero

				current.AssemblyAngularVelocity = Vector3.zero

			elseif current and lockPos then

				current.CFrame = CFrame.new(lockPos)

				current.AssemblyLinearVelocity = Vector3.zero

				current.AssemblyAngularVelocity = Vector3.zero

			end

			local hrpList, npcIDs = collectNPCPacket(targetName, clusterCenterPos, clusterRadius)

			if #hrpList == 0 and followHrp then

				hrpList = { followHrp }

				local id = getNPCID(followNpc)

				if id then npcIDs = { id } end

			end

			if #hrpList == 0 then return end

			combatRegister:InvokeServer({

				[1] = "swingsfx", [2] = "Melee", [3] = combo,

				[4] = "Ground", [5] = false, [6] = CombatAnims[combo],

				[7] = 2, [8] = 1.5,

			})

			current = getHRP()

			followHrp = followNpc and followNpc:FindFirstChild("HumanoidRootPart")

			followHum = followNpc and followNpc:FindFirstChild("Humanoid")

			if current and followHrp and followHum and followHum.Health > 0 then

				clusterCenterPos = followHrp.Position

				current.CFrame = CFrame.new(followHrp.Position.X, fixedCombatY, followHrp.Position.Z)

				current.AssemblyLinearVelocity = Vector3.zero

				current.AssemblyAngularVelocity = Vector3.zero

			elseif current and lockPos then

				current.CFrame = CFrame.new(lockPos)

				current.AssemblyLinearVelocity = Vector3.zero

				current.AssemblyAngularVelocity = Vector3.zero

			end

			local packet = {

				[1] = {

					[1] = "damage", [2] = hrpList, [3] = "Melee",

					[4] = { combo, "Ground", "Melee" }, [5] = true,

					[6] = current and current.CFrame or CFrame.new(lockPos or centerPos),

					aircombo = "Ground",

				}

			}

			if #npcIDs > 0 then packet[1].NPCIDs = npcIDs end

			combatRegister:InvokeServer(unpack(packet))

		end)

		if followNpc then

			lockAboveNPC(followNpc, hoverHeight, 0.05, fixedCombatY)

		elseif lockPos then

			lockAbovePosition(lockPos, 0.05)

		else

			task.wait(0.21)

		end

	end

	local finalNpc = getClosestNPCToPosition(targetName, centerPos, radius or 30)

	if finalNpc then

		local fixedFinalY = lockPos and lockPos.Y or (centerPos.Y + hoverHeight)

		lockAboveNPC(finalNpc, hoverHeight, 1, fixedFinalY)

	elseif lockPos then

		lockAbovePosition(lockPos, 1)

	else

		task.wait(1)

	end

end

