function Hub:SubclassCall(name, ...)
    local allowed = { GetPlayerData = true, GetUnlockedClasses = true, PurchaseSubclass = true,
        EquipSubclass = true, PurchasePassive = true, UseSubclass = true }
    if not allowed[name] then return false, "Unsupported action." end
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", "SubclassNetwork", name })
    if not Compat.isA(remote, "RemoteFunction") then return false, "Subclass service unavailable." end
    local args, parts = table.pack(...), {}
    for index = 1, math.min(args.n, 2) do
        if type(args[index]) == "string" or type(args[index]) == "number" then parts[#parts + 1] = tostring(args[index]) end
    end
    return self:Call("subclass:" .. name .. ":" .. table.concat(parts, ":"), 8, 1, function()
        return remote:InvokeServer(table.unpack(args, 1, args.n))
    end)
end

function Hub:RefreshSubclasses(silent, selected)
    local module = self:Module("SubclassDefinitions", { "Modules", "Data", "Subclasses" })
    if not module or type(module.Data) ~= "table" then
        if not silent then self:Notify("Subclass", "Definitions unavailable.") end
        return nil
    end
    local names = {}
    for name, definition in pairs(module.Data) do
        if type(name) == "string" and type(definition) == "table" and type(definition.Passives) == "table" then
            names[#names + 1] = name
        end
    end
    table.sort(names)
    self.SubclassDefinitions = module.Data
    self:SetOptions("SubclassDropdown", names)
    selected = selected or self.Config["Selected Subclass"]
    if module.Data[selected] == nil then
        selected = names[1]
        if selected then self:SetConfig("Selected Subclass", selected) end
    end
    if not selected then return nil end
    local ok, data = self:SubclassCall("GetPlayerData")
    if not ok or type(data) ~= "table" or type(data.Purchased) ~= "table" then
        if not silent then self:Notify("Subclass", "Player data unavailable.") end
        return nil
    end
    local state = { Name = selected, Definition = module.Data[selected], PlayerData = data,
        Owned = data.Purchased[selected] }
    self.SubclassState = state
    local passiveNames, passiveOptions = {}, {}
    for key, passive in pairs(state.Definition.Passives) do
        if type(key) == "string" and type(passive) == "table" and type(passive.Levels) == "table" then
            local label = passive.DisplayName or key
            if passiveOptions[label] then label ..= " [" .. key .. "]" end
            passiveOptions[label] = { Key = key, Definition = passive }
            passiveNames[#passiveNames + 1] = label
        end
    end
    table.sort(passiveNames)
    self.PassiveOptions = passiveOptions
    self:SetOptions("PassiveDropdown", passiveNames)
    if not passiveOptions[self.Config["Selected Passive"]] and passiveNames[1] then self:SetConfig("Selected Passive", passiveNames[1]) end
    self:RenderSubclass()
    return state
end

function Hub:RenderSubclass()
    local state = self.SubclassState
    if not state then return end
    local text = state.Definition.DisplayName or state.Name
    local owned = state.Owned
    if type(owned) == "table" then
        text ..= " | Level " .. tostring(owned.Level or "?")
        text ..= state.PlayerData.Equipped == state.Name and " | Equipped" or " | Owned"
    else text ..= " | " .. self:CostText(state.Definition.Cost) end
    self:SetInfo("SubclassStatus", text)
    self:RenderPassive()
end

function Hub:SubclassQuest()
