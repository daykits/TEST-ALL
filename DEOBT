function Hub:CakePortal(silent)
    if self.Sea ~= "Sea3" then
        if not silent then self:Notify("Cake Portal", "Third Sea required.") end
        return true, false, "Third Sea required"
    end
    local now = os.clock()
    if now < (self.NextCakeCheck or 0) then
        return self.CakePortalReady == true, false, self.CakePortalReply
    end
    self.NextCakeCheck = now + 2.5
    local ok, result = self:Comm("CakePrinceSpawner", true)
    self.CakePortalReply = result
    if not ok or type(result) ~= "string" then
        self.CakePortalReady = false
        if not silent then self:Response("Cake Portal", ok, result) end
        return false, false, result
    end
    local ready = result:lower():find("open the portal now", 1, true) ~= nil
    self.CakePortalReady = ready
    if not ready then
        if not silent then self:Response("Cake Portal", true, result) end
        return false, false, result
    end
    if self:FindTool("Sweet Chalice") then
        self.CakePortalReply = "Sweet Chalice detected; Cake Prince summon blocked"
        self:Log("fully-cake", self.CakePortalReply, 8)
        if not silent then self:Notify("Cake Portal", self.CakePortalReply) end
        return true, false, self.CakePortalReply
    end
    local npc = self:FindNPC("drip_mama")
    local _, _, root = self:Character()
    if npc and root and (npc.Position - root.Position).Magnitude > 40 then
        self.NextCakeCheck = now + 0.5
        self.Target = nil
        self:MoveTo(npc)
        return true, false, result
    end
    local sent, reply = self:Comm("CakePrinceSpawner")
    self.CakePortalReady = false
    self.CakePortalReply = reply
    self.NextCakeCheck = now + 3
    if sent then self.CakeSpawnAwaitUntil = now + 12 end
    if not silent then self:Response("Cake Portal", sent, reply) end
    return true, sent, reply
end

