function Hub:DetectSea(fast)
    local ids = { [2753915549] = "Sea1", [85211729168715] = "Sea1", [4442272183] = "Sea2",
        [79091703265657] = "Sea2", [7449423635] = "Sea3", [100117331123089] = "Sea3" }
    local before = self.Sea
    self.Sea = ids[game.PlaceId] or self.Sea
    if not fast then
        local realm = self:Module("Realm", { "Util", "Realm" })
        if realm and type(realm.safeGetCurrentSeaAsync) == "function" then
            local ok, value = self:Call("realm", 8, 15, realm.safeGetCurrentSeaAsync)
