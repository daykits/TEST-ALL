function Hub:HalloweenFightBoss(boss, manual)
    if not boss or not self:AliveEnemy(boss) then return false end
    if boss.Name:lower():find("dapper", 1, true) and not self:HalloweenInDapperArena() then
        self:HalloweenStatus("Great Pumpkin | Boss is up; entering the arena first")
        return self:HalloweenEnterRitualPortal(manual)
    end
    self.HalloweenRitualBossSeen = true
    if self:HalloweenInDapperArena() then self.HalloweenArenaSawBoss = true end
    self:HalloweenStatus("Fighting boss | " .. boss.Name)
    if not manual then
        self:Fight(boss, boss.Name, false)
        return true
    end
    local deadline = os.clock() + 240
    while self.Alive and os.clock() < deadline do
        if self:HalloweenBreakFreeStep() then
            task.wait(0.2)
        elseif self:HalloweenDialogue(true) then
            task.wait(0.3)
        else
            if not self:AliveEnemy(boss) then boss = self:HalloweenBossEnemy() end
            if not boss then break end
            if boss.Name:lower():find("dapper", 1, true) and not self:HalloweenInDapperArena() then
                self:HalloweenStatus("Great Pumpkin | Boss is up; entering the arena first")
                self:HalloweenEnterRitualPortal(true)
                boss = self:HalloweenBossEnemy()
                if not boss then break end
            end
            self:HalloweenStatus("Fighting boss | " .. boss.Name)
            self:Fight(boss, boss.Name, false)
            task.wait(0.3)
        end
    end
    if not boss or not self:AliveEnemy(boss) then
        self.HalloweenRitualActive = false
        self.HalloweenRitualBossSeen = false
        self.HalloweenRitualStatusCache, self.HalloweenRitualStatusUntil = nil, nil
        self.HalloweenRitualNext = os.clock() + 5
        self:HalloweenStatus("Great Pumpkin | Boss defeated or despawned")
    end
    return true
end

function Hub:HalloweenRitualModule()
    if type(self.HalloweenRitualShared) == "table" then return self.HalloweenRitualShared end
    if os.clock() < (self.HalloweenRitualModuleRetry or 0) then return nil end
    local instance = Compat.find(Player, { "PlayerScripts", "HalloweenLocal", "DapperJackArena" })
    if not Compat.isA(instance, "ModuleScript") then
        self.HalloweenRitualModuleRetry = os.clock() + 10
        return nil
    end
    local ok, module = self:Call("module:DapperJackArena", 8, 2, function() return require(instance) end)
    if ok and type(module) == "table" and type(module.RITUAL_REMOTE) == "string"
        and type(module.RITUAL_COMMANDS) == "table" and module.RITUAL_COMMANDS.Status ~= nil and module.RITUAL_COMMANDS.Summon ~= nil then
        self.HalloweenRitualShared = module
        return module
    end
    self.HalloweenRitualModuleRetry = os.clock() + 15
    self:Log("halloween-ritual", module or "DapperJackArena has no ritual constants", 10)
    return nil
end

function Hub:HalloweenRitualStatus(force)
    if not force and type(self.HalloweenRitualStatusCache) == "table" and os.clock() < (self.HalloweenRitualStatusUntil or 0) then
        return self.HalloweenRitualStatusCache
    end
    local shared = self:HalloweenRitualModule()
    if not shared then return nil, "DapperJackArena unavailable" end
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", shared.RITUAL_REMOTE })
    if not Compat.isA(remote, "RemoteFunction") then return nil, "Ritual remote unavailable" end
    local invoked, status = self:Call("halloween-ritual-status", 8, 0.25, function()
        return remote:InvokeServer(shared.RITUAL_COMMANDS.Status)
    end)
    if invoked and type(status) == "table" then
        self.HalloweenRitualStatusCache, self.HalloweenRitualStatusUntil = status, os.clock() + 8
        local gatewayActive = false
        pcall(function() gatewayActive = Services.Workspace:GetAttribute("DapperJackActive") == true end)
        self.HalloweenRitualActive = status.Active == true or gatewayActive
        return status
    end
    return nil, status
end

function Hub:HalloweenRitualAffordable(status)
    if type(status) ~= "table" or type(status.Costs) ~= "table" then return false end
    for _, cost in pairs(status.Costs) do
        if type(cost) == "table" and type(cost.Have) == "number" and type(cost.Amount) == "number" and cost.Have < cost.Amount then
            return false
        end
    end
    return true
end

function Hub:HalloweenRitualSummon()
    local shared = self:HalloweenRitualModule()
    if not shared then return nil end
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", shared.RITUAL_REMOTE })
    if not Compat.isA(remote, "RemoteFunction") then return nil end
    local invoked, result = self:Call("halloween-ritual-summon", 8, 0.25, function()
        return remote:InvokeServer(shared.RITUAL_COMMANDS.Summon)
    end)
    return invoked and result or nil
end

function Hub:HalloweenDapperCauldron()
    local tagged = {}
    pcall(function() tagged = Services.CollectionService:GetTagged("DapperJackCauldron") end)
    for _, object in ipairs(tagged) do
        if object and object.Parent then
            local inside = false
            pcall(function() inside = object:IsDescendantOf(Services.Workspace) end)
            if inside then
                local cf = Compat.cframe(object)
                if cf then return object, cf end
            end
        end
    end
    return nil
end

function Hub:HalloweenDapperSpot()
    local compass = Services.Workspace:FindFirstChild("GreatPumpkinCompass") or Services.Workspace:FindFirstChild("GreatPumpkinCompass", true)
    local compassCFrame = Compat.cframe(compass)
    if compassCFrame then return compassCFrame.Position end
    local prompt = self:HalloweenDapperPrompt()
    local promptCFrame = prompt and Compat.cframe(prompt.Parent) or nil
    if promptCFrame then return promptCFrame.Position end
    local spot
    pcall(function() spot = Services.Workspace:GetAttribute("DapperJackGateway") end)
    if typeof(spot) == "Vector3" then return spot end
    local _, cf = self:HalloweenDapperCauldron()
    return cf and cf.Position or nil
end

function Hub:HalloweenDapperPrompt()
    local folder = Services.Workspace:FindFirstChild("DapperJackGateway")
    local prompt = folder and folder:FindFirstChildWhichIsA("ProximityPrompt", true) or nil
    if prompt then return prompt end
    local compass = Services.Workspace:FindFirstChild("GreatPumpkinCompass") or Services.Workspace:FindFirstChild("GreatPumpkinCompass", true)
    if compass then
        if compass:IsA("ProximityPrompt") then return compass end
        prompt = compass:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then return prompt end
        local parent = compass.Parent
        if parent and parent ~= Services.Workspace then
            prompt = parent:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then return prompt end
        end
    end
    local tagged = {}
    pcall(function() tagged = Services.CollectionService:GetTagged("ProximityPrompt") end)
    for _, candidate in ipairs(tagged) do
        if candidate:IsA("ProximityPrompt") then
            local objectText = ""
            pcall(function() objectText = candidate.ObjectText or "" end)
            if objectText:lower():find("great pumpkin", 1, true) then return candidate end
        end
    end
    return nil
end

