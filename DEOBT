function Hub:SecretNativeQuest(row)
    local data, known = self:QuestState()
    if not known or type(data) ~= "table" or type(data.Info) ~= "table" or data.Info.Job then return nil end
    local matches = data.InternalQuestName == row.Name or data.InternalQuestName == row.Address
        or data.Info.Name == row.Name or data.Info.CustomTitle == row.Name
    if not matches then return nil end
    local progress = Compat.questProgress(data)
    if not progress or progress.Done then return nil end
    local targets = self:QuestTargets(data)
    return #targets > 0 and targets or nil
end

function Hub:SecretNativeCompletion(row)
    local data, known = self:QuestState()
    if not known or type(data) ~= "table" or type(data.Info) ~= "table" or data.Info.Job then return false end
    local matches = data.InternalQuestName == row.Name or data.InternalQuestName == row.Address
        or data.Info.Name == row.Name or data.Info.CustomTitle == row.Name
    if not matches then return false end
    local progress = Compat.questProgress(data)
    return progress and progress.Done == true or false
end

function Hub:InstallSecretMomentEvents()
    if self.SecretMomentEventsInstalled then return end
    local remotes = Services.ReplicatedStorage:FindFirstChild("Remotes")
    local remote = remotes and remotes:FindFirstChild("BonusMomentsRemoteEvent")
    if not Compat.isA(remote, "RemoteEvent") then return end
    self.SecretMomentEventsInstalled = true
    self:Connect(remote.OnClientEvent, function(momentName, eventName, ...)
        local args = table.pack(...)
        if type(momentName) == "string" then
            local packet = { Event = eventName, Args = args, At = os.clock() }
            self.SecretMomentPackets = self.SecretMomentPackets or {}
            self.SecretMomentStates = self.SecretMomentStates or {}
            self.SecretMomentPackets[momentName] = packet
            if eventName == "Setup" or eventName == "Reset" or eventName == "ResetProgress" then
                self.SecretMomentStates[momentName] = {}
            end
            local history = self.SecretMomentStates[momentName] or {}
            self.SecretMomentStates[momentName] = history
            history[eventName] = packet
            if eventName == "Setup" or eventName == "State" or eventName == "Init" or eventName == "Availability" then
                self.SecretPriorityMoment, self.SecretPriorityAt = momentName, os.clock()
            end
            local actionState, actionAddress
            for _, row in ipairs(self.Catalog) do
                if row.Name == momentName then
                    actionAddress = row.Address
                    actionState = self.SecretActions and self.SecretActions[actionAddress]
                    break
                end
            end
            if eventName == "SetActive" and args[1] == true then
                self.SecretSkip = self.SecretSkip or {}
                if actionAddress then self.SecretSkip[actionAddress] = nil end
                self.SecretPriorityMoment, self.SecretPriorityAt = momentName, os.clock()
            end
            if eventName == "PodiumLit" and typeof(args[1]) == "Instance" then
                self.SecretActions = self.SecretActions or {}
                actionState = actionState or {}
                if actionAddress then self.SecretActions[actionAddress] = actionState end
                actionState.ResolvedObjects = actionState.ResolvedObjects or {}
                actionState.StatueDoneTypes = actionState.StatueDoneTypes or {}
                actionState.ResolvedObjects[args[1]] = true
                local podiumClient = self:Module("PodiumClient", { "ClientComponents", "PodiumClient" })
                local podium
                if podiumClient and type(podiumClient.FromInstance) == "function" then
                    local ok, value = pcall(podiumClient.FromInstance, podiumClient, args[1])
                    if ok then podium = value end
                end
                if podium then
                    if type(podium.PodiumType) == "string" then actionState.StatueDoneTypes[podium.PodiumType] = true end
                    local ok, model = pcall(podium.GetModel, podium)
                    if ok and typeof(model) == "Instance" then actionState.ResolvedObjects[model] = true end
                end
                actionState.StatueTargetType, actionState.RequiredWeaponType = nil, nil
            end
            if momentName == "Legendary Creator Statues" and eventName == "AllLit" and actionState then
                actionState.CompletionPending = true
                actionState.CompletionAt = os.clock()
            end
            if momentName == "Temple Intel" and eventName == "Reveal" and actionState then
                actionState.TempleClicks, actionState.TempleNextClick, actionState.TempleSolved = nil, nil, nil
            end
            if momentName == "Evil Slimes" and eventName == "BattleStarted" then
                if actionState then actionState.ObjectTarget, actionState.ObjectSwitchAt = nil, nil end
                self.SecretScan = nil
            end
            if eventName == "Completed" or eventName == "Complete" or eventName == "OnComplete" then
                self.SecretActions = self.SecretActions or {}
                for _, row in ipairs(self.Catalog) do
                    if row.Name == momentName then
                        local completedState = self.SecretActions[row.Address] or {}
                        self.SecretActions[row.Address] = completedState
                        completedState.CompletionPending = true
                        completedState.CompletionAt = os.clock()
                        break
                    end
                end
                self.SecretPriorityMoment, self.SecretPriorityAt = momentName, os.clock()
                self.SecretScan, self.SecretPromptScan, self.SecretStrikeTarget = nil, nil, nil
                self.SecretRefreshAt = 0
            end
        end
        if momentName ~= "Echoes Through the Clouds" then return end
        if eventName == "Listen" and type(args[1]) == "table" and type(args[2]) == "number" and type(args[3]) == "number" then
            self.SecretEchoRound = { Notes = table.clone(args[1]), Start = args[2], Beat = args[3], Good = type(args[5]) == "number" and args[5] or 0.38, Index = 1 }
        elseif eventName == "Note" and args[2] == false then
            self.SecretEchoRound = nil
        elseif eventName == "Finale" or eventName == "Completed" then
            self.SecretEchoRound = nil
        end
    end)
end

function Hub:InstallSecretGuide()
    self.SecretGuideTargets = self.SecretGuideTargets or {}
    local tracker = self:Module("SecretCompassTracker", { "GuideModule", "CompassTracker" })
    if tracker and type(tracker.createTracker) == "function" and not self.SecretCompassPatch then
        local originalCreate, originalRemove = tracker.createTracker, tracker.removeTracker
        local createPatch = function(id, payload, ...)
            if type(id) == "string" and type(payload) == "table" then
                self.SecretGuideTargets[id] = { Target = payload.Target, Time = os.clock() }
            end
            return originalCreate(id, payload, ...)
        end
        local removePatch = function(id, ...)
            if type(id) == "string" then self.SecretGuideTargets[id] = nil end
            if type(originalRemove) == "function" then return originalRemove(id, ...) end
        end
        local ok = pcall(function()
            tracker.createTracker = createPatch
            if type(originalRemove) == "function" then tracker.removeTracker = removePatch end
        end)
        if ok then
            self.SecretCompassPatch = { Module = tracker, Create = originalCreate, Remove = originalRemove, CreatePatch = createPatch, RemovePatch = removePatch }
        end
    end
    local remote = self:NetRemote("RE", "GuideTracker")
    if not remote or remote == self.GuideTrackRemote then return end
    if self.GuideTrackConnection then self.GuideTrackConnection:Disconnect() end
    self.GuideTrackRemote = remote
    self.GuideTrackConnection = self:Connect(remote.OnClientEvent, function(id, kind, payload)
        if type(id) ~= "string" then return end
        if type(kind) == "table" then payload, kind = kind, "Create" end
        if kind == "Remove" or kind == "Destroy" or kind == "ClearDefaultOverride" then
            self.SecretGuideTargets[id] = nil
        elseif (kind == "Create" or kind == "Update" or kind == "SetDefaultOverride") and type(payload) == "table" then
            self.SecretGuideTargets[id] = { Target = payload.Target, Time = os.clock() }
        end
    end)
end

function Hub:SecretGuide(row, force)
    if not force and not self.Config["Follow Secret Guide"] then return nil end
    local keys = { row.Address, row.Name }
    local handler = self.SecretHandlers[row.Name]
    for _, id in ipairs(handler and handler.Trackers or {}) do table.insert(keys, id) end
    local entry, selectedId
    for _, id in ipairs(keys) do
        local candidate = self.SecretGuideTargets and self.SecretGuideTargets[id]
        if candidate and (not entry or (candidate.Time or 0) > (entry.Time or 0)) then entry, selectedId = candidate, id end
    end
    if not entry then return nil end
    local target = entry.Target
    if type(target) == "function" then
        local ok, value = pcall(target)
        if not ok then return nil end
        target = value
    end
    if type(target) == "table" and target.Target ~= nil then target = target.Target end
    if typeof(target) == "Instance" and target.Parent == nil then
        if selectedId and self.SecretGuideTargets then self.SecretGuideTargets[selectedId] = nil end
        return nil
    end
    if Compat.isA(target, "Vector3Value") then target = target.Value end
    local cf = Compat.cframe(target)
    if not cf then return nil end
    return cf, typeof(target) == "Instance" and target or nil, selectedId
end

function Hub:LiveSecretNPC(name)
    local folder = Services.Workspace:FindFirstChild("NPCs")
    if not folder or type(name) ~= "string" then return nil end
    local wanted = Compat.normalizeName(name):gsub("[%s%-_]", "")
    for _, npc in ipairs(folder:GetDescendants()) do
        if npc:IsA("Model") and Compat.normalizeName(npc.Name):gsub("[%s%-_]", "") == wanted then return Compat.cframe(npc), npc end
    end
    return nil
end

function Hub:SecretNPCEntry(row)
    local handler = self.SecretHandlers[row.Name] or {}
    local list = self:Guide()
    list = list and list.Data and list.Data.NPCList or {}
    local wantedGroup = handler.Group
    local wantedNpc = handler.NPC and Compat.normalizeName(handler.NPC) or nil
    local rowName = Compat.normalizeName(row.Name):gsub("[%s%-_]", "")
    local fallback
    for _, npc in pairs(list) do
        if type(npc) == "table" then
            if wantedGroup and npc.InternalQuestName == wantedGroup then return npc.InternalQuestName, npc end
            if wantedNpc and Compat.normalizeName(npc.NPCName) == wantedNpc then return npc.InternalQuestName, npc end
            if type(npc.InternalQuestName) == "string" and Compat.normalizeName(npc.InternalQuestName):gsub("[%s%-_]", "") == rowName then fallback = npc end
        end
    end
    if fallback then return fallback.InternalQuestName, fallback end
    return wantedGroup, nil
end

function Hub:SecretNPCNear(value, radius)
    local cf = Compat.cframe(value)
    if not cf then return nil end
    local guide = self:Guide()
    local best, distance
    for _, npc in pairs(guide and guide.Data and guide.Data.NPCList or {}) do
        if type(npc) == "table" and type(npc.InternalQuestName) == "string" then
            local live = type(npc.NPCName) == "string" and self:LiveSecretNPC(npc.NPCName) or nil
            local npcCF = live or Compat.cframe(npc.Position)
            if npcCF then
                local current = (npcCF.Position - cf.Position).Magnitude
                if current <= (radius or 30) and (not distance or current < distance) then best, distance = npc, current end
            end
        end
    end
    return best and best.InternalQuestName or nil, best
end

function Hub:SecretDestination(row)
    local handler = self.SecretHandlers[row.Name]
    local state = self.SecretActions and self.SecretActions[row.Address]
    if not state or not state.Accepted then
        local npcName = handler and handler.NPC
        local group, entry = self:SecretNPCEntry(row)
        npcName = npcName or (entry and entry.NPCName)
        local cf = npcName and self:LiveSecretNPC(npcName) or nil
        cf = cf or (entry and Compat.cframe(entry.Position))
        if cf then return cf, true, group end
    end
    local definition = self.IslandDefinitions and self.IslandDefinitions[row.Island]
    return Compat.islandCFrame(definition) or self.SecretIslandCFrames[row.Island], false
end

function Hub:SecretHasTag(row, wanted)
    for _, tag in ipairs(row and row.Tags or {}) do if tag == wanted then return true end end
    return false
end

function Hub:SecretIsEvent(row)
    return self:SecretHasTag(row, "AwakenedBossBattle")
end

function Hub:SecretAutomatable(row)
    local handler = row and self.SecretHandlers[row.Name]
    return handler ~= nil and handler.Action ~= "Observe"
end

function Hub:SecretPendingKinds()
    local normal, events, unsupported = 0, 0, 0
    for _, row in ipairs(self.Catalog or {}) do
        if Compat.progressState(self.Progress, row.Address) == "Incomplete" then
            if self:SecretIsEvent(row) then events += 1
            elseif self:SecretAutomatable(row) then normal += 1
            else unsupported += 1 end
        end
    end
    return normal, events, unsupported
end

function Hub:SecretActiveEvent()
    for _, row in ipairs(self.Catalog or {}) do
        local moment = self:SecretIsEvent(row) and self:GetMoment(row.Name) or nil
        if moment and moment.Active == true and Compat.progressState(self.Progress, row.Address) == "Incomplete" then return row end
    end
    return nil
end

function Hub:SecretHintRow(hint)
    if type(hint) ~= "table" then return nil end
    local boss = Compat.normalizeName(hint.Boss):gsub("[%s%-_]", "")
    local island = Compat.normalizeName(hint.Island):gsub("[%s%-_]", "")
    if boss == "" or island == "" then return nil end
    for _, row in ipairs(self.Catalog) do
        if self:SecretHasTag(row, "AwakenedBossBattle") then
            local islandMatch = Compat.normalizeName(row.Island):gsub("[%s%-_]", "") == island
            for _, alias in ipairs(self.SecretIslandAliases[row.Island] or {}) do
                local key = Compat.normalizeName(alias):gsub("[%s%-_]", "")
                if key == island or key:find(island, 1, true) or island:find(key, 1, true) then islandMatch = true; break end
            end
            local bossMatch = false
            for _, name in ipairs(self.SecretHandlers[row.Name] and self.SecretHandlers[row.Name].Enemies or {}) do
                local key = Compat.normalizeName(name):gsub("[%s%-_]", "")
                if key == boss or key:find(boss, 1, true) or boss:find(key, 1, true) then bossMatch = true; break end
            end
            if islandMatch and bossMatch then return row end
        end
    end
    return nil
end

function Hub:RefreshSecretRaidHint(silent)
    local now = os.clock()
    if now < (self.SecretRaidHintNext or 0) then return self.SecretRaidHint end
    self.SecretRaidHintNext = now + 5
    local remote = self:NetRemote("RF", "RequestNextRaidHint")
    local ok, hint = false, nil
    if remote then ok, hint = self:Call("secret:raid-hint", 8, 0, function() return remote:InvokeServer() end) end
    if not ok then
        self.SecretRaidHintNext = now + 2
        return self.SecretRaidHint
    end
    if type(hint) ~= "table" then hint = nil end
    self.SecretRaidHint = hint
    self.SecretRaidHintAt = now
    local row = self:SecretHintRow(hint)
    local state = hint and tostring(hint.State or "") or ""
    local active = state == "Arming" or state == "Armed" or state == "Triggered"
    local runtimeActive = row and self:GetMoment(row.Name)
    runtimeActive = runtimeActive and runtimeActive.Active == true or false
    if runtimeActive and row then
        self.SecretRaidPriority = row.Name
        self.SecretPriorityMoment, self.SecretPriorityAt = row.Name, now
    elseif self.SecretRaidPriority then
        if self.SecretPriorityMoment == self.SecretRaidPriority then self.SecretPriorityMoment = nil end
        self.SecretRaidPriority = nil
    end
    local activeEvent = self:SecretActiveEvent()
    if activeEvent then self.SecretPriorityMoment, self.SecretPriorityAt = activeEvent.Name, now end
    local seconds = hint and tonumber(hint.Seconds)
    local identity = hint and table.concat({ tostring(hint.Boss), tostring(hint.Island), state, tostring(math.floor((seconds or 0) / 30)) }, "|") or "none"
    if identity ~= self.SecretRaidIdentity then
        self.SecretRaidIdentity = identity
        for _, other in ipairs(self.Catalog) do
            if self:SecretHasTag(other, "AwakenedBossBattle") and (not active or other ~= row) and self.SecretMomentPackets then
                self.SecretMomentPackets[other.Name] = nil
            end
        end
        self.SecretScan, self.SecretPromptScan = nil, nil
    end
    if identity ~= self.SecretRaidNoticeKey and not silent then
        self.SecretRaidNoticeKey = identity
        if not hint then
            local normal = self:SecretPendingKinds()
            if activeEvent then
                self.SecretPriorityMoment, self.SecretPriorityAt = activeEvent.Name, now
                self:Notify("Secret Event", activeEvent.Name .. " đang active")
            elseif normal > 0 then
                self:Notify("Auto Secrets", "Không có Secret Event; tiếp tục " .. tostring(normal) .. " quest thường")
            else
                self:Notify("Secret Event", "không có event nào")
            end
        else
            local title = row and row.Name or (tostring(hint.Boss) .. " @ " .. tostring(hint.Island))
            if runtimeActive then
                self:Notify("Secret Event", title .. " đang active")
            elseif active then
                self:Notify("Secret Event", title .. " raid hint | " .. state .. " | chưa có runtime event")
            elseif state == "Deferred" then
                self:Notify("Secret Event", title .. " upcoming | đang bị event khác chặn")
            else
                local minutes = math.max(1, math.ceil((seconds or 0) / 60))
                self:Notify("Secret Event", title .. " upcoming | khoảng " .. minutes .. " phút")
            end
        end
    end
    return hint
end

function Hub:SecretRaidReady(row, moment)
    if moment and moment.Active == true then return true end
    if not self:SecretHasTag(row, "AwakenedBossBattle") then return true end
    local hint = self.SecretRaidHint
    if not hint or self:SecretHintRow(hint) ~= row then return false, "không có event active cho " .. row.Name end
    local state = tostring(hint.State or "")
    if state == "Arming" or state == "Armed" or state == "Triggered" then
        return false, row.Name .. " có raid hint " .. state .. " nhưng runtime event chưa active"
    end
    if state == "Deferred" then return false, row.Name .. " upcoming nhưng đang bị event khác chặn" end
    local minutes = math.max(1, math.ceil((tonumber(hint.Seconds) or 0) / 60))
    return false, row.Name .. " upcoming khoảng " .. minutes .. " phút"
end

function Hub:SecretAvailable(row)
    if not row or Compat.progressState(self.Progress, row.Address) ~= "Incomplete" then return false end
    local actionState = self.SecretActions and self.SecretActions[row.Address]
    local moment = self:GetMoment(row.Name)
    if actionState and actionState.CompletionPending or self:SecretNativeCompletion(row)
        or moment and moment.Completed == true then return true, "Turn-in" end
    if self:SecretIsEvent(row) then
        if moment and moment.Active == true then return true, "Event" end
        return false, "Event"
    end
    if self:SecretNativeQuest(row) then return true, "Quest" end
    if self:SecretGuide(row, true) then return true, "Tracker" end
    if not self:SecretAutomatable(row) then return false, "Unsupported" end
    if moment then return true, "Quest" end
    local destination = self:SecretDestination(row)
    if destination then return true, "Normal" end
    return false, "Normal"
end

function Hub:ChooseSecret()
    local _, _, root = self:Character()
    if not root then return nil end
    self:RefreshSecretRaidHint(false)
    self.SecretSkip = self.SecretSkip or {}
    if self.Config["Secrets Scope"] == "Selected" then
        local row = self:SelectedSecret()
        if row and os.clock() >= (self.SecretSkip[row.Address] or 0) and Compat.progressState(self.Progress, row.Address) == "Incomplete" then
            local ready, reason = self:SecretRaidReady(row, self:GetMoment(row.Name))
            if ready then return row end
            if os.clock() >= (self.SecretUnavailableNoticeAt or 0) then
                self.SecretUnavailableNoticeAt = os.clock() + 12
                self:Notify("Secret Event", reason or (row.Name .. " chưa khả dụng"))
            end
        end
        return nil
    end
    local priority = self.SecretPriorityMoment and os.clock() - (self.SecretPriorityAt or 0) < 20 and self.SecretPriorityMoment or nil
    local best, score
    for _, row in ipairs(self.Catalog) do
        if Compat.progressState(self.Progress, row.Address) == "Incomplete" and self:SecretAvailable(row)
            and os.clock() >= (self.SecretSkip[row.Address] or 0) then
            local cf = self:SecretDestination(row)
            local distance = cf and (root.Position - cf.Position).Magnitude or math.huge
            local moment = self:GetMoment(row.Name)
            if moment then distance = -220 end
            if self:SecretNativeQuest(row) then distance = -260
            elseif self:SecretGuide(row) then distance = -240 end
            if priority == row.Name then distance = -300 end
            if row.Name == "Rescue Hasan" and moment and moment.Progress == 1 then distance = -320 end
            if not best or distance < score then best, score = row, distance end
        end
    end
    return best
end

function Hub:PauseSecret(row, message, seconds)
    self.SecretCombatAllowed = false
    self.Target = nil
    self:CancelMove()
    self:SecretStatus(row, message)
    if self.Config["Secrets Scope"] == "Available" then
        self.SecretSkip = self.SecretSkip or {}
        self.SecretSkip[row.Address] = os.clock() + (seconds or 30)
        if self.SecretActions then self.SecretActions[row.Address] = nil end
        self.SecretScan, self.SecretPromptScan = nil, nil
        self.SecretCurrent, self.SecretStartedAt, self.SecretCurrentKind = nil, nil, nil
    else
        self.SecretStartedAt = os.clock()
    end
end

function Hub:SkipSecret()
    local row = self.SecretCurrent or self:SelectedSecret()
    if row then
        self.SecretSkip = self.SecretSkip or {}
        self.SecretSkip[row.Address] = os.clock() + 60
        if self.SecretActions then self.SecretActions[row.Address] = nil end
    end
    self.SecretCurrent, self.SecretStartedAt, self.SecretCurrentKind = nil, nil, nil
    self.SecretCombatAllowed, self.SecretStrikeTarget, self.Target = false, nil, nil
    self.SecretScan, self.SecretPromptScan, self.SecretEchoRound = nil, nil, nil
    self:CancelMove()
end

function Hub:SecretRemote(row, moment, action, invoke, cooldown, ...)
    if not moment then return false, "Moment unavailable" end
    local args = table.pack(...)
    return self:Call("auto-secret:" .. row.Name .. ":" .. action, 8, cooldown or 0.5, function()
        if invoke then return moment:InvokeServer(action, table.unpack(args, 1, args.n)) end
        return moment:FireServer(action, table.unpack(args, 1, args.n))
    end)
end

function Hub:SecretEvent(momentName, eventName)
    local history = self.SecretMomentStates and self.SecretMomentStates[momentName]
    return history and history[eventName] or nil
end

function Hub:SecretEventInstance(momentName, eventName, index)
