    local kind = tool:GetAttribute("WeaponType") or tool.ToolTip
    return kind == "Demon Fruit" or kind == "Blox Fruit"
end

function Hub:FruitHasTap(tool)
    if not self:IsFruitTool(tool) then return false end
    self.FruitTapSupport = self.FruitTapSupport or setmetatable({}, { __mode = "k" })
    local cached = self.FruitTapSupport[tool]
    if cached and (cached.Value or os.clock() < cached.Next) then return cached.Value end
    local supported = tool:GetAttribute("MobileM1Button") == true
    if not supported then
        local skills = self:Module("FruitSkills", { "FruitSkills" })
        local variants = type(skills) == "table" and skills[tool.Name] or nil
        local moves = type(variants) == "table" and variants[tool:FindFirstChild("AwakenedMoves") and 2 or 1] or nil
        for _, move in ipairs(type(moves) == "table" and moves or {}) do
            if move == "TAP" or (type(move) == "table" and (move[1] == "TAP" or move[2] == "TAP" or move.Key == "TAP")) then supported = true; break end
        end
    end
    if not supported then
        local modules = Compat.find(Player, { "PlayerGui", "MovesetModules" })
        local names = { tool.Name }
        for _, attribute in ipairs({ "Moveset", "AwakenedMoveset" }) do
            local name = tool:GetAttribute(attribute)
            if type(name) == "string" then table.insert(names, name) end
        end
        for _, name in ipairs(names) do
            local folder = type(name) == "string" and modules and modules:FindFirstChild(name) or nil
            if folder and folder:FindFirstChild("TAP", true) then supported = true; break end
        end
    end
    self.FruitTapSupport[tool] = { Value = supported, Next = os.clock() + 2 }
    return supported
end

function Hub:FruitTapRemote()
    local _, humanoid = self:Character()
    if not humanoid then return nil end
    local remote = humanoid:FindFirstChild("")
    return Compat.isA(remote, "RemoteFunction") and remote or nil
end

function Hub:NativeFruitM1(tool, model)
    if not self:FruitHasTap(tool) or tool.Parent ~= Player.Character then return false end
    local tap = self:FruitTapRemote()
    if not tap then return false end
    if os.clock() < (self.FruitM1Next or 0) then return true end
    local interval = math.max(self.Config.AttackInterval, 0.12)
    self.FruitM1Next = os.clock() + interval
    self:InstallAimAdapter()
    self.AttackTarget = model
    local aim = self:AimPoint(model)
    if not aim then
        local _, _, root = self:Character()
        aim = root and root.Position + root.CFrame.LookVector * 100 or Vector3.zero
    end
    local aimRemote = tool.Name == "Dough-Dough" and tool:FindFirstChild("RemoteEvent") or nil
    local ok, problem = self:Call("fruit-tap:" .. tool.Name, 4, interval, function()
        if Compat.isA(aimRemote, "RemoteEvent") then
            aimRemote:FireServer(true)
            aimRemote:FireServer(aim)
            aimRemote:FireServer(false)
        end
        return tap:InvokeServer("TAP")
    end)
    if ok then
        self.FastBatches = (self.FastBatches or 0) + 1
        self.FastLastBatch = os.clock()
        self.FastLastFail = nil
    elseif type(problem) == "string" and not problem:find("Cooldown", 1, true)
        and not problem:find("pending", 1, true) then
        self.FastLastFail = problem
        self:Log("fruit-tap", problem)
    end
    return ok or type(problem) == "string" and (problem:find("Cooldown", 1, true) ~= nil or problem:find("pending", 1, true) ~= nil)
end

function Hub:AttackStep()
    if self:IsAttackSuspended() then self.AttackTarget = nil; return end
    local char = self:Character()
    if not char then return end
    local tool = self:FastWeapon()
    if not tool then return end
    local kind = tool:GetAttribute("WeaponType") or tool.ToolTip
    local enabled = self.Config["Fast Attack"] or (kind == "Gun" and self.Config.Gun)
        or ((kind == "Demon Fruit" or kind == "Blox Fruit") and self.Config["M1 Fruits"])
    if not enabled then return end
    local head, extras, model = self:FastTargets()
    if not head then return end
    if kind == "Gun" or kind == "Demon Fruit" or kind == "Blox Fruit" then
        if tool.Parent == char then
            local fruitHandled = self:IsFruitTool(tool) and self:NativeFruitM1(tool, model)
            if not fruitHandled then self:NativeM1(tool, model) end
        end
        return
    end
    if not self:IsBackpackWeapon(tool) then return end
    if os.clock() < (self.FastNext or 0) then return end
    self.FastNext = os.clock() + self.Config["Fast Rate"]
    local generation = self.FastGeneration or 0
    local transport, reason = self:FastTransport()
    if not transport then
        self.FastLastFail, self.FastFailAt = reason, os.clock()
        return
    end
    if generation ~= (self.FastGeneration or 0) or self:IsAttackSuspended() then return end
    self.AttackTarget = model
    local combo = transport.Mode == "Auto" and self:FastComboIndex(tool) or nil
    local ok, problem = pcall(function()
        if combo then transport.Attack:FireServer(0.43, combo)
        else transport.Attack:FireServer(0.43) end
        if transport.Send then transport.Send(head, extras) else transport.Hit:FireServer(head, extras) end
    end)
    if ok then
        self.FastBatches = (self.FastBatches or 0) + 1
        self.FastLastBatch = os.clock()
        self.FastLastFail = nil
        self.CombatLockAt = os.clock()
    else self:Log("fast-attack", problem) end
end

function Hub:GetFarmQuest(mobs, options)
    local definitions = self:Module("Quests", { "Quests" })
    local guide = self:Guide()
    local blacklist = {}
    for key, deadline in pairs(self.QuestBlacklist) do
        if deadline > os.clock() then blacklist[key] = true else self.QuestBlacklist[key] = nil end
    end
    return Compat.selectQuest(definitions, guide and guide.Data and guide.Data.NPCList,
        self:Level(), mobs, blacklist, options)
end

function Hub:QuestNPC(quest)
    if type(quest) ~= "table" then return nil end
    return self:FindNPC(quest.NPCName) or Compat.cframe(quest.Position)
end

function Hub:QuestTargets(data)
    if type(data) ~= "table" or type(data.Info) ~= "table" or type(data.Info.Task) ~= "table" then return {} end
    local targets = {}
    local progress = type(data.Progress) == "table" and data.Progress or {}
    for name, goal in pairs(data.Info.Task) do
        local amount = type(goal) == "number" and goal or (type(goal) == "table" and goal.Amount)
        local current = progress[name]
        if type(name) == "string" and type(amount) == "number" and amount > 0
            and current ~= true and not (type(current) == "number" and current >= amount) then
            table.insert(targets, name)
        end
    end
    table.sort(targets)
    return targets
end

function Hub:QuestBelongsHere(data)
    local name = data and data.InternalQuestName
    if type(name) ~= "string" then return false end
    local guide = self:Guide()
    for _, npc in pairs(guide and guide.Data and guide.Data.NPCList or {}) do
        if type(npc) == "table" and npc.InternalQuestName == name then return true end
    end
    return false
end

function Hub:StartFarmQuest(quest, allowStart)
    if allowStart == nil then allowStart = self.Config["Auto Quest"] end
    if not allowStart or not quest then return false end
    if os.clock() < (self.NextQuestStart or 0) then return false end
    local destination = self:QuestNPC(quest)
    local _, _, root = self:Character()
    if not destination or not root then return false end
    if (root.Position - destination.Position).Magnitude > 12 then
        self:MoveTo(destination)
        return false
    end
    self.NextQuestStart = os.clock() + 2
    if self.Config["Claim Secret Rewards"] then
        self:ClaimGuideReward(quest.QuestName, true)
    end
    if not self.Alive or not allowStart then return false end
    local ok, result = self:Comm("StartQuest", quest.QuestName, quest.QuestId)
    if not ok then return false end
    if result == nil or result == 0 or result == true then
        self.SelectedFarmQuest = quest
        self.QuestKnown = false
        return true
    end
    if result == 2 then self.QuestBlacklist[quest.Key] = os.clock() + 60 end
    self:Log("quest", quest.QuestName .. ": " .. tostring(result))
    return false
end

function Hub:ResolveFarmQuest(mobs, kind, minimum)
    local levelMode = kind == "Level"
    local currentMode = kind == "Current"
    local options = { AllowSingle = kind == "Boss" or kind == "Mob", BossOnly = kind == "Boss" }
    local candidate = not currentMode and self:GetFarmQuest(mobs, options) or nil
    local autoQuest = self.Config["Auto Quest"] or levelMode
    if not autoQuest and not currentMode then
        return levelMode and candidate and candidate.Mobs or mobs, false
    end
    local data, known = self:QuestState()
    if not known then
        if not currentMode then
            self.QuestUnknownAt = self.QuestUnknownAt or os.clock()
            if os.clock() - self.QuestUnknownAt > 10 then
                if levelMode then return nil, false end
                return mobs, false
            end
        end
        return nil, true
    end
    self.QuestUnknownAt = nil
    if data then
        local progress = Compat.questProgress(data)
        if not progress or progress.Done or data.Info.Job then
            local tag = (not progress and "bad") or (progress.Done and "done" or "job")
            local stuckKey = (data.InternalQuestName or data.QuestName or "quest") .. ":" .. tag
            if self.QuestStuckId ~= stuckKey then self.QuestStuckId, self.QuestStuckAt = stuckKey, os.clock() end
            if progress and progress.Done and not currentMode and candidate
                and os.clock() - (self.QuestStuckAt or 0) > 1 then
                self:StartFarmQuest(candidate, autoQuest)
                return nil, true
            end
            if self.Config["Replace Quest"] and os.clock() - (self.QuestAbandonAt or 0) > 3 then
                self.QuestAbandonAt = os.clock()
                self:Comm("AbandonQuest")
                self.QuestKnown = false
            end
            if not currentMode and self.QuestStuckAt and os.clock() - self.QuestStuckAt > 5 then
                if levelMode then return nil, false end
                return mobs, false
            end
            return nil, true
        end
        local targets = self:QuestTargets(data)
        local matches = currentMode or (levelMode and (not self.Config["Replace Quest"] and self:QuestBelongsHere(data) or false))
        if levelMode and self.Config["Replace Quest"] and candidate then
            for _, target in ipairs(targets) do
                if Compat.nameMatches(target, candidate.Mobs) then matches = true; break end
            end
        end
        if not matches then
            for _, target in ipairs(targets) do
                if Compat.nameMatches(target, mobs) then matches = true; break end
            end
        end
        if matches then self.QuestMismatchAt = nil; return targets, false end
        local questId = data.InternalQuestName or data.QuestName or "quest"
        if self.QuestMismatchId ~= questId then self.QuestMismatchId, self.QuestMismatchAt = questId, os.clock() end
        if self.Config["Replace Quest"] and autoQuest and candidate then
            if os.clock() - (self.QuestAbandonAt or 0) > 3 then
                self.QuestAbandonAt = os.clock()
                self:Comm("AbandonQuest")
                self.QuestKnown = false
            end
        end
        if self.QuestMismatchAt and os.clock() - self.QuestMismatchAt > 3 then return mobs, false end
        return nil, true
    end
    if currentMode then return nil, true end
    if candidate and (self:Level() or 0) >= (minimum or 0) then
        self:StartFarmQuest(candidate, autoQuest)
        return nil, true
    end
    if levelMode then return nil, false end
    return mobs, false
end

function Hub:FarmGroup(mobs, bossName, minimum, kind)
    if bossName then
        local boss = self:Enemies(bossName)[1]
        if boss then self:Fight(boss, bossName, false); return end
    end
    local targets, waiting = self:ResolveFarmQuest(mobs, kind or "Group", minimum)
    if waiting or not targets or (type(targets) == "table" and #targets == 0) then
        self.Target = nil
        return
    end
    local enemy = self:Enemies(targets)[1]
    if enemy then self:Fight(enemy, targets, kind ~= "Boss")
    else self.Target = nil; self:MoveToSpawn(targets) end
end

function Hub:EliteStep()
    if self.Sea ~= "Sea3" then self:Log("farm-elite", "Third Sea required."); return end
    if os.clock() >= (self.NextEliteTask or 0) then
        self.NextEliteTask = os.clock() + 45
        local ok, text = self:Comm("EliteHunter")
        if ok and type(text) == "string" and text ~= self.EliteTask then
            self.EliteTask = text
            self:Notify("Elite Hunter", text)
        end
        local sent, progress = self:Comm("EliteHunter", "Progress")
        if sent and type(progress) == "number" then self.EliteProgress = progress end
    end
    local elites = { "Deandre", "Urban", "Diablo" }
    local ordered = {}
    if type(self.EliteTask) == "string" then
        for _, name in ipairs(elites) do
            if self.EliteTask:find(name, 1, true) then table.insert(ordered, 1, name) end
        end
    end
    for _, name in ipairs(elites) do if not table.find(ordered, name) then table.insert(ordered, name) end end
    for _, name in ipairs(ordered) do
        local target = self:Enemies(name)[1]
        if target then self:Fight(target, name, false); return end
    end
    self.Target = nil
    self:MoveToSpawn(ordered)
end

function Hub:FarmLevelStep()
    self:FarmGroup(nil, nil, nil, "Level")
end

function Hub:RefreshFarmCatalog()
    local quests = self:Module("Quests", { "Quests" })
    local guide = self:Guide()
    if not quests or not guide or not guide.Data then return end
    local mobs, bosses, npcs, seenMobs, seenBosses, seenNPCs = {}, {}, {}, {}, {}, {}
    for _, npc in pairs(guide.Data.NPCList or {}) do
        if type(npc) == "table" then
            if type(npc.NPCName) == "string" and not seenNPCs[npc.NPCName] then
                seenNPCs[npc.NPCName] = true
                table.insert(npcs, npc.NPCName)
            end
            for _, quest in pairs(quests[npc.InternalQuestName] or {}) do
                if type(quest) == "table" and type(quest.Task) == "table" then
                    for name, amount in pairs(quest.Task) do
                        if type(name) == "string" and type(amount) == "number" and amount > 0 then
                            if not seenMobs[name] then seenMobs[name] = true; table.insert(mobs, name) end
                            if amount == 1 and not seenBosses[name] then seenBosses[name] = true; table.insert(bosses, name) end
                        end
                    end
                end
            end
        end
    end
    local enemies = Services.Workspace:FindFirstChild("Enemies")
    for _, model in ipairs(enemies and enemies:GetChildren() or {}) do
        if self:AliveEnemy(model) and not seenMobs[model.Name] then
            seenMobs[model.Name] = true
            table.insert(mobs, model.Name)
        end
    end
    local folder = Services.Workspace:FindFirstChild("NPCs")
    for _, model in ipairs(folder and folder:GetChildren() or {}) do
        if model:IsA("Model") and not seenNPCs[model.Name] then
            seenNPCs[model.Name] = true
            table.insert(npcs, model.Name)
        end
    end
    table.sort(mobs); table.sort(bosses); table.sort(npcs)
    self.MobNames, self.BossNames, self.NPCNames = mobs, bosses, npcs
    self:SetOptions("MobDropdown", mobs)
    self:SetOptions("BossDropdown", bosses)
    self:SetOptions("NPCDropdown", npcs)
end

function Hub:MoveToNPC(name)
    local destination = self:FindNPC(name)
    if not destination then
        local guide = self:Guide()
        for _, npc in pairs(guide and guide.Data and guide.Data.NPCList or {}) do
            if npc.NPCName == name then destination = Compat.cframe(npc.Position); break end
        end
    end
    if not destination then self:Notify("Travel", "NPC unavailable."); return false end
    self.ManualDestination, self.ManualDeadline = destination, os.clock() + 90
    return true
end

function Hub:RenderQuestStatus()
    if not self.QuestStatus then return end
    local data, known = self:QuestState()
    local text = known and "No active quest" or "Loading quest"
    if data then
        local progress = Compat.questProgress(data)
        local name = data.Info and data.Info.Name or data.InternalQuestName or "Quest"
        text = tostring(name)
        if progress then text ..= "  " .. progress.Current .. "/" .. progress.Total end
    end
    self.QuestStatus:SetDescription(text)
end

function Hub:RefreshCatalog()
    local definitions = self:Module("MapDefinitions", { "Definitions", "Map" })
    if not definitions or type(definitions.findMap) ~= "function" then return false end
    local ok, map = pcall(definitions.findMap, "Sea1")
    if not ok or type(map) ~= "table" or type(map.Islands) ~= "table" then return false end
    local catalog, islands = {}, {}
    for _, island in ipairs(map.Islands) do
        if type(island) == "table" and island.Index and type(island.Index.Key) == "string" then
            islands[island.Index.Key] = island
            for _, definition in ipairs(island.BonusMoments or {}) do
                if definition.Index and type(definition.Index.Key) == "string" then
                    table.insert(catalog, {
                        Address = "Sea1/" .. island.Index.Key .. "/" .. definition.Index.Key,
                        Island = island.Index.Key, Name = definition.Index.Key,
                        Tags = type(definition.Tags) == "table" and definition.Tags or {},
                        Dialogue = definition.Dialogue, Definition = definition, Source = "live-definition",
                    })
                end
            end
        end
    end
    table.sort(catalog, function(a, b) return a.Address < b.Address end)
    if #catalog == 0 then return false end
    self.Catalog, self.IslandDefinitions = catalog, islands
    return true
end

function Hub:RefreshSecrets(silent)
    self:RefreshCatalog()
    local ok, reply = self:InvokeNet("RequestBonusMomentReplication", { Type = "GetMomentProgress" }, 1)
    local progress, problem
    if ok then progress, problem = Compat.decodeProgress(reply) else problem = reply end
    if progress then
        self.Progress, self.ProgressSource = progress, "GetMomentProgress / server"
        self.ProgressTime = os.clock()
        self:RenderSecrets()
        if not silent then self:Notify("Sea1 Secrets", "Progress refreshed.") end
        return true
    end
    self:Log("secrets", problem or "Progress unavailable")
    if not silent then self:Notify("Sea1 Secrets", problem or "Progress unavailable.") end
    return false
end

function Hub:InstallSecretListener()
    local event = self:NetRemote("RE", "OnBonusMomentReplicatedChange")
    if not event or event == self.SecretRemoteEvent then return end
    if self.SecretConnection then self.SecretConnection:Disconnect() end
    self.SecretRemoteEvent = event
    self.SecretConnection = self:Connect(event.OnClientEvent, function(packet)
        if type(packet) == "table" and packet.Type == "OnCompletionChanged" and type(packet.Data) == "table" then
            local progress = Compat.decodeProgress({ Type = "GetMomentProgress", Data = packet.Data })
            if progress then
                self.Progress = progress
                self.ProgressSource = "OnBonusMomentReplicatedChange / server"
                self.ProgressTime = os.clock()
                self:RenderSecrets()
            end
        end
    end)
end

function Hub:SelectedSecret()
    for _, row in ipairs(self.Catalog) do if row.Address == self.SelectedSecretAddress then return row end end
    return self.Catalog[1]
end

function Hub:RenderSecrets()
    local summary = Compat.summarize(self.Catalog, self.Progress)
    if self.SecretSummary then
        pcall(self.SecretSummary.SetDescription, self.SecretSummary, string.format(
            "%d quests | %d complete | %d pending | %d unknown\n%d repeatable | %d awakened bosses",
            summary.Total, summary.Completed, summary.Incomplete, summary.Unknown,
            summary.Repeatable, summary.AwakenedBossBattle))
    end
    local selected = self:SelectedSecret()
    if selected and self.SecretDetail then
        local rumor = selected.Dialogue and selected.Dialogue.Rumor
        local lines = { selected.Address, "Status: " .. Compat.progressState(self.Progress, selected.Address),
            "Tags: " .. (#selected.Tags > 0 and table.concat(selected.Tags, ", ") or "-") }
        if type(rumor) == "table" and #rumor > 0 then
            table.insert(lines, "Hint:")
            for _, text in ipairs(rumor) do if type(text) == "string" then table.insert(lines, text) end end
        else table.insert(lines, "Hint unavailable.") end
        pcall(self.SecretDetail.SetDescription, self.SecretDetail, table.concat(lines, "\n"))
    end
end

function Hub:SecretsText()
    local summary = Compat.summarize(self.Catalog, self.Progress)
    local lines = { "Bacon Hub",
        string.format("Total=%d Completed=%d Incomplete=%d Unknown=%d", summary.Total, summary.Completed, summary.Incomplete, summary.Unknown) }
    for index, row in ipairs(self.Catalog) do
        table.insert(lines, string.format("%d. %s (State: %s) [%s]", index, row.Address,
            Compat.progressState(self.Progress, row.Address), table.concat(row.Tags, ", ")))
    end
    return table.concat(lines, "\n")
end

function Hub:NextBossHint()
    if not self.Progress then self:RefreshSecrets(true) end
    if Compat.summarize(self.Catalog, self.Progress).CompleteIslands < 1 then
        self:Notify("Boss hint", "Complete an island first.")
        return
    end
    local remote = self:NetRemote("RF", "RequestNextRaidHint")
    if not remote then self:Notify("Boss hint", "Boss hint unavailable."); return end
    local ok, hint = self:Call("next-raid-hint", 8, 2, function() return remote:InvokeServer() end)
    if not ok or type(hint) ~= "table" then self:Notify("Secret Event", "không có event nào"); return end
    local row = self:SecretHintRow(hint)
    local lines = { "Event: " .. (row and row.Name or "Unknown"), "State: " .. tostring(hint.State), "Island: " .. tostring(hint.Island), "Boss: " .. tostring(hint.Boss) }
    if type(hint.Seconds) == "number" then table.insert(lines, "ETA: " .. math.ceil(hint.Seconds / 60) .. " min") end
    for _, rumor in ipairs(type(hint.Rumor) == "table" and hint.Rumor or {}) do
        if type(rumor) == "string" then table.insert(lines, rumor) end
    end
    self:Notify("Secret Event", table.concat(lines, "\n"))
end

function Hub:SecretPhase()
    if not self.Progress then self:RefreshSecrets(true) end
    local summary = Compat.summarize(self.Catalog, self.Progress)
    if summary.Total == 0 or summary.Completed ~= summary.Total then
        return nil, "Complete all island secrets first."
    end
    local ok, result = self:InvokeNet("RequestSecretStories", { Type = "GetPhase" }, 1)
    if not ok or type(result) ~= "table" or type(result.Phase) ~= "string" then return nil, "Phase unavailable." end
    return result.Phase
end

function Hub:ReadSecretStories()
    local phase, problem = self:SecretPhase()
    if phase ~= "Stories" then self:Notify("Secrets Master", problem or ("Phase: " .. tostring(phase))); return end
    local ok, result = self:InvokeNet("RequestSecretStories", { Type = "RollStories" }, 2)
    if not ok or type(result) ~= "table" or type(result.Stories) ~= "table" then
        self:Notify("Secrets Master", "Stories unavailable."); return
    end
    local lines = {}
    for index, story in ipairs(result.Stories) do
        table.insert(lines, "Story " .. index)
        for _, sentence in ipairs(type(story) == "table" and story or {}) do
            if type(sentence) == "string" then table.insert(lines, sentence) end
        end
    end
    local text = table.concat(lines, "\n")
    if self.SecretDetail then self.SecretDetail:SetDescription(text) end
    self:Notify("Secrets Master", "Stories loaded.")
end

function Hub:MoveToSelectedIsland()
    if self.Sea ~= "Sea1" then self:Notify("Sea1", "First Sea required."); return end
    self:RefreshCatalog()
    local row = self:SelectedSecret()
    local definition = row and self.IslandDefinitions and self.IslandDefinitions[row.Island]
    local cf = Compat.islandCFrame(definition)
    if not cf then self:Notify("Sea1", "Island unavailable."); return end
    self.ManualDestination = cf
    self.ManualDeadline = os.clock() + 90
    self:Notify("Sea1", "Moving to " .. row.Island .. ".")
end

function Hub:GatewayLocations()
    local ok, result = self:InvokeNet("WorldTeleporter", { Type = "GetLocations" }, 1)
    if not ok then return nil, result end
    if type(result) ~= "table" or result.Type ~= "GetLocations" or result.WasSuccess ~= true or type(result.Locations) ~= "table" then
        return nil, type(result) == "table" and result.ErrMessage or "WorldTeleporter response unavailable"
    end
    local locations = {}
    for _, name in ipairs(result.Locations) do if type(name) == "string" then table.insert(locations, name) end end
    return locations
end

function Hub:NearGateway()
    local char, _, root = self:Character()
    if not char or Player:GetAttribute("UnlockedGateways") ~= true then return false end
    local busy = char:FindFirstChild("Busy")
    if not busy or busy.Value then return false end
    for _, teleporter in ipairs(Services.CollectionService:GetTagged("WORLD_TELEPORTER")) do
        if Compat.isA(teleporter, "Model") and teleporter.Parent then
            local smokes = teleporter:FindFirstChild("Smokes")
            if Compat.isA(smokes, "BasePart") then
                local flat = Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(smokes.Position.X, 0, smokes.Position.Z)
                if math.abs(root.Position.Y - smokes.Position.Y) <= smokes.Size.Y / 2 and flat.Magnitude <= 25 then return true end
            else
                local ok, cf, size = pcall(teleporter.GetBoundingBox, teleporter)
                if ok and cf and size then
                    local a = Vector3.new(root.Position.X, 0, root.Position.Z)
                    local b = Vector3.new(cf.Position.X, 0, cf.Position.Z)
                    if math.abs(root.Position.Y - cf.Position.Y) <= size.Y / 2
                        and (a - b).Magnitude <= math.min(size.X, size.Z) / 2 then return true end
                end
            end
        end
    end
    return false
end

function Hub:GatewayTeleport()
    if self.Sea ~= "Sea1" then self:Notify("Gateway", "First Sea required."); return end
    if not self:NearGateway() then self:Notify("Gateway", "Enter an unlocked gateway."); return end
    local row = self:SelectedSecret()
    local locations, problem = self:GatewayLocations()
    if not row or not locations then self:Notify("Gateway", problem or "No destination."); return end
    if not table.find(locations, row.Island) then self:Notify("Gateway", "Destination locked: " .. row.Island); return end
    local ok, result = self:InvokeNet("WorldTeleporter", { Type = "TeleportTo", IslandKey = row.Island }, 2)
    if ok and type(result) == "table" and result.Type == "TeleportTo" and result.WasSuccess == true then
        self:Notify("Gateway", "Teleported.")
    else self:Notify("Gateway", type(result) == "table" and result.ErrMessage or "Teleport unavailable.") end
end

function Hub:TravelSubmerged()
    if self.Sea ~= "Sea3" then self:Notify("Submarine", "Third Sea required."); return end
    if self:HasRestrictedItem() then self:Notify("Submarine", "Store quest items first."); return end
    local remote = self:NetRemote("RF", "SubmarineWorkerSpeak")
    if not remote then self:Notify("Submarine", "Submarine unavailable."); return end
    local ok, result = self:Call("submarine-check", 8, 2, function() return remote:InvokeServer("AskKilledTikiBoss") end)
    if not ok then self:Notify("Submarine", result); return end

    local sent, response = self:Call("submarine-travel", 8, 5, function() return remote:InvokeServer("TravelToSubmergedIsland") end)
    self:Notify("Submarine", sent and ("Server response: " .. tostring(response)) or response)
end

function Hub:NetCall(name, ...)
    local remote = self:NetRemote("RF", name)
    if not remote then return false, name .. " unavailable." end
    local args, parts = table.pack(...), {}
    for index = 1, math.min(args.n, 4) do
        local value = args[index]
        if type(value) == "string" or type(value) == "number" or type(value) == "boolean" then
            table.insert(parts, type(value) .. "=" .. tostring(value))
        end
    end
    return self:Call("net:" .. name .. ":" .. table.concat(parts, ":"), 8, 1, function()
        return remote:InvokeServer(table.unpack(args, 1, args.n))
    end)
end

function Hub:Response(title, ok, value)
    if not ok then self:Notify(title, value or "Unavailable."); return end
    if type(value) == "string" then self:Notify(title, value)
    elseif type(value) == "table" then
        self:Notify(title, value.ErrMessage or value.Reason or value.Message
            or (value.Success ~= nil and (value.Success and "Success." or "Unavailable.")) or "Received.")
    elseif value == false then self:Notify(title, "Unavailable.")
    elseif value == nil then self:Notify(title, "Request sent.")
    else self:Notify(title, "Result: " .. tostring(value)) end
end

function Hub:Value(path)
