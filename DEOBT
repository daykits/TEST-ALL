-- ============================================
-- SCRIPT AUTO TELEPORT LẤY TRỨNG + AUTO E + SAFE ZONE (V2)
-- ============================================

local Workspace        = game:GetService("Workspace")
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local VirtualInput     = game:GetService("VirtualInputManager")
local LocalPlayer      = Players.LocalPlayer

-- Bật = true, Tắt = false
getgenv().InstantPickup   = true   
getgenv().AutoPressE      = true   
getgenv().AutoPressDelay  = 0.05   
getgenv().AutoPressRadius = 15     

-- ============================================
-- CẤU HÌNH TỌA ĐỘ
-- ============================================
-- Tọa độ an toàn (Safe Zone / Chuồng - Ảnh số 4)
local SAFE_POS = Vector3.new(198.70, 4.00, 294.73)

-- Danh sách tọa độ trứng (Từ ảnh 1, 2, 3)
local EggPositions = {
    Vector3.new(164.25, 4.00, -9690.22), -- Ảnh 1
    Vector3.new(168.35, 4.00, -9726.47), -- Ảnh 2
    Vector3.new(180.08, 4.00, -9708.28)  -- Ảnh 3
}

-- Cấu hình thời gian chờ (Nếu game lag, hãy tăng số này lên)
local WAIT_AT_EGG_TIME = 2.0 -- Đứng ở chỗ trứng 2 giây để nhặt

-- ============================================
-- PHẦN 1: HỆ THỐNG AUTO E & INSTANT PICKUP (GIỮ NGUYÊN)
-- ============================================
local function makeInstant(prompt)
    if not getgenv().InstantPickup then return end
    if prompt:IsA("ProximityPrompt") then
        pcall(function()
            prompt.HoldDuration         = 0
            prompt.RequiresLineOfSight  = false
        end)
    end
end

local function scanAll()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        makeInstant(obj)
    end
end

scanAll()

Workspace.DescendantAdded:Connect(function(obj)
    makeInstant(obj)
    if obj:IsA("ProximityPrompt") then
        obj:GetPropertyChangedSignal("HoldDuration"):Connect(function()
            if getgenv().InstantPickup and obj.HoldDuration ~= 0 then
                obj.HoldDuration = 0
            end
        end)
    end
end)

task.spawn(function()
    while task.wait(1) do
        if getgenv().InstantPickup then pcall(scanAll) end
    end
end)

local function pressE()
    pcall(function()
        VirtualInput:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function firePrompt(prompt)
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        elseif prompt and prompt.Triggered then
            prompt:InputHoldBegin()
        end
    end)
end

task.spawn(function()
    while task.wait(getgenv().AutoPressDelay) do
        if not getgenv().AutoPressE then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        for _, prompt in ipairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function()
                    local parent = prompt.Parent
                    if parent and parent:IsA("BasePart") then
                        local dist = (parent.Position - root.Position).Magnitude
                        if dist <= getgenv().AutoPressRadius then
                            pressE()
                            firePrompt(prompt)
                        end
                    end
                end)
            end
        end
    end
end)

-- ============================================
-- PHẦN 2: LOGIC TELEPORT & CHECK TÚI ĐỒ (BACKPACK)
-- ============================================

-- Hàm dịch chuyển nhân vật
local function TeleportTo(pos)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    hrp.CFrame = CFrame.new(pos)
    task.wait(0.2) -- Đợi 0.2s để server load vị trí
end

-- Hàm đếm số lượng vật phẩm (Trứng) trong Backpack
-- Nếu game bạn có tên Tool chứa chữ "Egg" hoặc "Trứng", hãy thêm tên đó vào đây
local function GetEggCount()
    local count = 0
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    
    -- Quét trong Backpack
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                -- MẸO: Nếu biết chính xác tên trứng, sửa dòng dưới thành: if string.find(item.Name, "TênTrứng") then
                -- Ở đây mình đếm TẤT CẢ các Tool (vì bạn chỉ đi trộm trứng)
                count = count + 1 
            end
        end
    end
    
    -- Quét trong Character (phòng trường hợp đang cầm trên tay)
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                count = count + 1
            end
        end
    end
    
    return count
end

-- Vòng lặp chính: Trộm trứng -> Check túi -> Về chuồng
task.spawn(function()
    while task.wait(1) do
        if not getgenv().AutoPressE then continue end
        
        -- Lấy số lượng trứng ban đầu
        local initialEggCount = GetEggCount()
        
        -- Lặp qua từng tọa độ trứng
        for i, pos in ipairs(EggPositions) do
            -- Nếu đang giữ nhiều hơn lúc đầu (tức là đã nhặt được) thì dừng vòng lặp này
            if GetEggCount() > initialEggCount then break end 
            
            print("[Hệ Thống] Đang di chuyển đến trứng số " .. i)
            TeleportTo(pos)
            
            -- Đứng tại chỗ để Auto E hoạt động (Tăng thời gian này nếu mạng lag)
            task.wait(WAIT_AT_EGG_TIME) 
        end
        
        -- BƯỚC KIỂM TRA CUỐI: Nếu túi đồ có nhiều hơn ban đầu => Đã trộm thành công
        if GetEggCount() > initialEggCount then
            print("[Hệ Thống] Đã trộm được trứng! Đang quay về chuồng...")
            
            -- Dịch chuyển về Safe Zone (Chuồng)
            TeleportTo(SAFE_POS)
            
            -- Đứng chờ ở chuồng 3 giây để game cập nhật (cất trứng, reset)
            task.wait(3) 
        end
    end
end)

-- ============================================
-- PHẦN 3: BẬT/TẮT BẰNG PHÍM RightControl
-- ============================================
local UserInput = game:GetService("UserInputService")
UserInput.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        getgenv().AutoPressE = not getgenv().AutoPressE
        print("[AutoPressE + Teleport] " .. (getgenv().AutoPressE and "BẬT" or "TẮT"))
    end
end)

print("[Hệ Thống] Script V2 đã chạy! Sẽ tự động về chuồng khi nhặt được trứng.")
print("Bấm RightCtrl để bật/tắt toàn bộ.")
