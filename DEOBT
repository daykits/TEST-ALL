                if p1:IsA("Decal") or p1:IsA("Texture") and decalsyeeted then
                    p1.Transparency = 1
                end
                if (p1:IsA("ParticleEmitter") or p1:IsA("Trail")) and p1.Parent.Name ~= "RelicFire" then
                    p1.Enabled = false
                    p1.Lifetime = NumberRange.new(0)
                end
                if p1:IsA("Explosion") then
                    p1.Enabled = false
                    p1.BlastPressure = 1
                    p1.BlastRadius = 1
                end
                if p1:IsA("Fire") or p1:IsA("SpotLight") or p1:IsA("Smoke") or p1:IsA("Sparkles") then
                    p1.Enabled = false
                end
                if p1:IsA("MeshPart") then
                    p1.Transparency = 1
                    p1.Material = "Plastic"
                    p1.Reflectance = 0
                    p1.TextureID = 1.0385902758728956e+16
                end
            end)
        end)
    else
        return game.Players.LocalPlayer:Kick("Buy Premium or wait until free again")
    end
else
    return print("Double UI")
end
