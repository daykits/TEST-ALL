function Hub:SilentEnemy(other)
    if self.Config["Aimbot All Teams"] then return true end
    local myTeam, team = Player.Team, other.Team
    if myTeam and team then
        if myTeam.Name == "Pirates" and team.Name == "Marines" then return true end
        if myTeam.Name == "Marines" and team.Name == "Pirates" then return true end
        if myTeam.Name == "Pirates" and team.Name == "Pirates" then return not self:SilentAlly(other) end
        if myTeam.Name == "Marines" and team.Name == "Marines" then return false end
    end
    return true
end

function Hub:SilentAlly(other)
    local ok, ally = pcall(function()
        local frame = Player.PlayerGui.Main.Allies.Container.Allies.ScrollingFrame
        for _, item in pairs(frame:GetDescendants()) do
            if item:IsA("ImageButton") and item.Name == other.Name then return true end
        end
        return false
    end)
    return ok and ally == true
end

function Hub:SilentPoint(model)
    local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
    if not Compat.isA(root, "BasePart") then return nil end
    local pos = root.Position
    if not self.Config["Silent Prediction"] then return pos end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.WalkSpeed < 5 then return pos end
    local ping = 0
    pcall(function() ping = Player:GetNetworkPing() end)
    local t = (self.Config["Prediction Amount"] or 0.1) + ping
    return pos + root.AssemblyLinearVelocity * t + Vector3.new(0, -4.9 * t * t, 0)
end

function Hub:SilentPlayerTarget(mine)
    local limit = self.Config["Silent Distance"] or 1000
    local selected = self:SelectedPlayerChar()
    if selected then
        local root = selected:FindFirstChild("HumanoidRootPart") or selected.PrimaryPart
        if root and (root.Position - mine.Position).Magnitude <= limit then return selected end
    end
    local best, bestDist
    for _, other in ipairs(Services.Players:GetPlayers()) do
        if other ~= Player and self:SilentEnemy(other) then
            local char = other.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
            if self:AliveEnemy(char) and root then
                local dist = (root.Position - mine.Position).Magnitude
                if dist <= limit and (not bestDist or dist < bestDist) then best, bestDist = char, dist end
            end
        end
    end
    return best
end

function Hub:SilentMobTarget(mine)
    local limit = self.Config["Silent Distance"] or 1000
    local best, bestDist
    local folder = Services.Workspace:FindFirstChild("Enemies")
    for _, model in ipairs(folder and folder:GetChildren() or {}) do
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if self:AliveEnemy(model) and root then
            local dist = (root.Position - mine.Position).Magnitude
            if dist <= limit and (not bestDist or dist < bestDist) then best, bestDist = model, dist end
        end
    end
    return best
end

function Hub:SilentStep()
    self.SilentPlayerPos, self.SilentNPCPos = nil, nil
    self.SilentBuddy, self.SilentFace, self.SilentRoot = nil, nil, nil
    self.SilentNoCD = self.Config["No Cooldown"] or nil
    local _, _, mine = self:Character()
    if not mine then return end
    if self.Config["Silent Players"] then
        local target = self:SilentPlayerTarget(mine)
        if target then self.SilentPlayerPos = self:SilentPoint(target) end
    end
    if self.Config["Silent NPCs"] then
        local mob = self:SilentMobTarget(mine)
        if mob then self.SilentNPCPos = self:SilentPoint(mob) end
    end
    if self.Config["ZV Skill Aimbot"] and (self.SilentPlayerPos or self.SilentNPCPos) then
        self.SilentFace = self.SilentPlayerPos or self.SilentNPCPos
        self.SilentRoot = mine
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool and tool.Name == "Buddy Sword" then self.SilentBuddy = true end
    end
end

function Hub:InstallSilentHook()
    if typeof(hookmetamethod) ~= "function" then return end
    if getgenv and getgenv().BaconSilentHook then self.SilentHooked = true; return end
    local ok = pcall(function()
        local mt
        if typeof(getrawmetatable) == "function" then
            mt = getrawmetatable(game)
            if typeof(setreadonly) == "function" and mt then setreadonly(mt, false) end
        end
        local old
        old = hookmetamethod(game, "__namecall", function(obj, ...)
            local method = ""
            if typeof(getnamecallmethod) == "function" then
                local okMethod, name = pcall(getnamecallmethod)
                if okMethod and type(name) == "string" then method = string.upper(name) end
            end
            if method == "FIRESERVER" and tostring(obj) == "RemoteEvent" then
                local arg1 = ...
                if typeof(arg1) == "Vector3" then
                    if self.SilentPlayerPos then return old(obj, self.SilentPlayerPos, select(2, ...)) end
                    if self.SilentNPCPos then return old(obj, self.SilentNPCPos, select(2, ...)) end
                end
            elseif method == "INVOKESERVER" then
                local arg1 = ...
                if self.SilentBuddy and type(arg1) == "string" and arg1 == "X" then
                    local pos = self.SilentPlayerPos or self.SilentNPCPos
                    if pos then return old(obj, arg1, pos, nil, select(3, ...)) end
                end
                if self.SilentNoCD and tostring(obj) == "CommF_" and arg1 == "Notification" then return nil end
                if self.SilentFace and self.SilentRoot and type(arg1) == "string" then
                    local key = string.upper(arg1)
                    if key == "Z" or key == "X" or key == "C" or key == "V" then
                        local face, root = self.SilentFace, self.SilentRoot
                        root.CFrame = CFrame.new(root.Position, Vector3.new(face.X, root.Position.Y, face.Z))
                    end
                end
            end
            return old(obj, ...)
        end)
        if typeof(setreadonly) == "function" and mt then setreadonly(mt, true) end
    end)
    if ok then
        self.SilentHooked = true
        if getgenv then getgenv().BaconSilentHook = true end
    end
end

function Hub:HackerReady()
    return typeof(Drawing) == "table" and typeof(Drawing.new) == "function"
end

function Hub:HackerGet(model)
    self.HackerDrawings = self.HackerDrawings or {}
    local set = self.HackerDrawings[model]
    if set then return set end
    local function new(kind, props)
        local ok, obj = pcall(Drawing.new, kind)
        if not ok or not obj then return nil end
        for k, v in pairs(props) do pcall(function() obj[k] = v end) end
        return obj
    end
    set = {
        BoxOut = new("Square", { Thickness = 3, Filled = false, Color = Color3.new(0, 0, 0) }),
        Box = new("Square", { Thickness = 1, Filled = false }),
        Line = new("Line", { Thickness = 1 }),
        Name = new("Text", { Size = 13, Center = true, Outline = true }),
        HPBack = new("Line", { Thickness = 4, Color = Color3.new(0, 0, 0) }),
        HP = new("Line", { Thickness = 2 }),
    }
    self.HackerDrawings[model] = set
    return set
end

function Hub:HackerDrop(model)
    local set = self.HackerDrawings and self.HackerDrawings[model]
    if not set then return end
    self.HackerDrawings[model] = nil
    for _, obj in pairs(set) do pcall(function() obj:Remove() end) end
end

function Hub:HackerHide()
    if not self.HackerDrawings then return end
    for model, set in pairs(self.HackerDrawings) do
        if not model.Parent then self:HackerDrop(model)
        else for _, obj in pairs(set) do pcall(function() obj.Visible = false end) end end
    end
    if self.FOVCircle then pcall(function() self.FOVCircle.Visible = false end) end
end

function Hub:HackerStep()
    if not self.Config["Hacker ESP"] then return end
    if not self:HackerReady() then
        if not self.HackerWarned then
            self.HackerWarned = true
            self:Notify("Hacker ESP", "Drawing unsupported.")
        end
        return
    end
    local camera = Services.Workspace.CurrentCamera
    if not camera then self:HackerHide(); return end
    local _, _, mine = self:Character()
    local seen = {}
    local list = {}
    for _, other in ipairs(Services.Players:GetPlayers()) do
        if other ~= Player and other.Character then
            local color = other.Team == Player.Team and Color3.new(0.2, 1, 0.2) or Color3.new(1, 0.15, 0.15)
            table.insert(list, { Model = other.Character, Color = color, Label = other.DisplayName })
        end
    end
    local names = {}
    for _, boss in ipairs(self.BossNames or {}) do names[boss] = true end
    if next(names) then
        local folder = Services.Workspace:FindFirstChild("Enemies")
        for _, model in ipairs(folder and folder:GetChildren() or {}) do
            if names[model.Name] then
                table.insert(list, { Model = model, Color = Color3.new(1, 0.6, 0.1), Label = model.Name })
            end
        end
    end
    local view = camera.ViewportSize
    for _, entry in ipairs(list) do
        local model = entry.Model
        local hum = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        local head = model:FindFirstChild("Head")
        if hum and hum.Health > 0 and root then
            local top3 = (head and head.Position or root.Position) + Vector3.new(0, 1, 0)
            local bot3 = root.Position - Vector3.new(0, 3, 0)
            local top, topOn = camera:WorldToViewportPoint(top3)
            local bot, botOn = camera:WorldToViewportPoint(bot3)
            if topOn and botOn then
                seen[model] = true
                local set = self:HackerGet(model)
                local height = math.abs(top.Y - bot.Y)
                local width = height / 2
                local x, y = top.X - width / 2, top.Y
                local dist = mine and math.floor((root.Position - mine.Position).Magnitude) or 0
                local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                local hpColor = Color3.new(1 - frac, frac, 0.15)
                if set.BoxOut then
                    set.BoxOut.Visible, set.BoxOut.Position, set.BoxOut.Size = true, Vector2.new(x, y), Vector2.new(width, height)
                end
                if set.Box then
                    set.Box.Visible, set.Box.Color, set.Box.Position, set.Box.Size =
                        true, entry.Color, Vector2.new(x, y), Vector2.new(width, height)
                end
                if set.Line then
                    set.Line.Visible, set.Line.Color, set.Line.From, set.Line.To =
                        true, entry.Color, Vector2.new(view.X / 2, view.Y), Vector2.new(top.X, bot.Y)
                end
                if set.Name then
                    set.Name.Visible, set.Name.Color, set.Name.Position, set.Name.Text =
                        true, entry.Color, Vector2.new(top.X, y - 16), entry.Label .. " " .. dist .. "m"
                end
                if set.HPBack then
                    set.HPBack.Visible, set.HPBack.From, set.HPBack.To =
                        true, Vector2.new(x - 5, y), Vector2.new(x - 5, y + height)
                end
                if set.HP then
                    set.HP.Visible, set.HP.Color, set.HP.From, set.HP.To =
                        true, hpColor, Vector2.new(x - 5, y + height), Vector2.new(x - 5, y + height * (1 - frac))
                end
            end
        end
    end
    for model in pairs(self.HackerDrawings or {}) do
        if not seen[model] then
            if not model.Parent then self:HackerDrop(model)
            else
                local set = self.HackerDrawings[model]
                for _, obj in pairs(set) do pcall(function() obj.Visible = false end) end
            end
        end
    end
end

function Hub:FOVStep()
    if not self.Config["FOV Circle"] or not self:HackerReady() then
        if self.FOVCircle then pcall(function() self.FOVCircle.Visible = false end) end
        return
    end
    if not self.FOVCircle then
        local ok, obj = pcall(Drawing.new, "Circle")
        if not ok or not obj then return end
        pcall(function()
            obj.Thickness, obj.Color, obj.Filled = 1, Color3.new(1, 0.2, 0.2), false
        end)
        self.FOVCircle = obj
    end
    local mouse = Player:GetMouse()
    pcall(function()
        self.FOVCircle.Visible = true
        self.FOVCircle.Radius = self.Config["FOV Radius"] or 300
        self.FOVCircle.Position = mouse and Vector2.new(mouse.X, mouse.Y) or Vector2.new(0, 0)
    end)
end

function Hub:PVPStep()
    self:AimbotStep()
    self:SilentStep()
    if self.Config["PVP Hitbox"] then self:ApplyHitbox() else self:ClearHitbox() end
    if self.Config["Ken ESP"] then self:RenderKenESP() else self:ClearKenESP() end
    if self.Config["ESP Boss"] then self:RenderBossESP() else self:ClearBossESP() end
    self:HackerStep()
    self:FOVStep()
    if not self.Config["Hacker ESP"] and not self.Config["FOV Circle"] then self:HackerHide() end
    if self.Config["Soru Spam"] and os.clock() - (self.SoruAt or 0) > 0.8 then
        self.SoruAt = os.clock()
        self:PressKey("R")
    end
    if self.Config["Auto Ken"] then self:KenRefresh() end
    if self.Config["Infinite Soru"] then
        if os.clock() - (self.SoruAttrAt or 0) > 0.5 then
            self.SoruAttrAt = os.clock()
            local char = Player.Character
            if char then pcall(char.SetAttribute, char, "FlashstepCooldown", 1) end
        end
    end
    if self.Config["Dash Length"] then
        self.DashWasOn = true
        local char = Player.Character
        if char then
            local dist = self.Config["Dash Distance"]
            pcall(char.SetAttribute, char, "DashLength", dist)
            pcall(char.SetAttribute, char, "DashLengthAir", dist)
        end
    elseif self.DashWasOn then
        self.DashWasOn = nil
        local char = Player.Character
        if char then
            pcall(char.SetAttribute, char, "DashLength", 1)
            pcall(char.SetAttribute, char, "DashLengthAir", 1)
        end
    end
    if self.Config["No Cooldown"] then
        local char = Player.Character
        if char then
            local combat = false
            pcall(function()
                local flag = Player.PlayerGui.Main.BottomHUDList.InCombat
                combat = flag and flag.Visible == true
            end)
            pcall(char.SetAttribute, char, "AllCooldown", combat and 0 or 3)
        end
    end
    if self.Config["Walk on Water"] then
        if not self.WaterBlock or not self.WaterBlock.Parent then
            local block = Instance.new("Part")
            block.Size = Vector3.new(200, 1, 200)
            block.Transparency = 1
            block.Anchored = true
            block.CanCollide = false
            block.Name = "BaconWaterBlock"
            block.Parent = Services.Workspace
            self.WaterBlock = block
        end
        local _, _, root = self:Character()
        if root then
            self.WaterBlock.Position = Vector3.new(root.Position.X, 0, root.Position.Z)
            self.WaterBlock.CanCollide = true
        end
    elseif self.WaterBlock and self.WaterBlock.Parent then
        self.WaterBlock.CanCollide = false
    end
    if os.clock() - (self.PVPPlayersAt or 0) > 5 then
        self.PVPPlayersAt = os.clock()
        self:SetOptions("PlayerDropdown", self:PlayerNames())
    end
    self:GunShootStep()
    local victim
    if self.Config["Kill Selected"] then victim = self:SelectedPlayerChar() end
    if not victim and self.Config["Auto Kill Near"] then victim = self:NearestPlayerChar() end
    if victim then
        if not self.Config["Player Targets"] then
            self:SetConfig("Player Targets", true)
            self:Notify("PvP", "Fast Attack Hits Players enabled.")
        end
        self:KillPlayerStep(victim)
    end
    self:KenFarmStep()
end

function Hub:HasKen()
    local char = Player.Character
    if not char then return false end
    local ok, has = pcall(function()
        return game:GetService("CollectionService"):HasTag(char, "Ken")
    end)
    return ok and has == true
end

function Hub:KenRefresh()
    local char = Player.Character
    if not char or not self:HasKen() then return false end
    pcall(function()
        local frame = Player.PlayerGui.MobileContextButtons.ContextButtonFrame
        local btn = frame and frame:FindFirstChild("BoundActionKen")
        if btn and btn:GetAttribute("Selected") ~= true then btn:SetAttribute("Selected", true) end
    end)
    local need = true
    pcall(function()
        local env = getrenv and getrenv()._G
        local om = env and env.OM
        if om and om.setActive then
            if om.active then need = false
            else om.radius = 0; om:setActive(true) end
        end
    end)
    if need and os.clock() - (self.KenRefreshAt or 0) > 1 then
        self.KenRefreshAt = os.clock()
        self:CommE("Ken", true)
    end
    return true
end

function Hub:SkillReady(toolName, key)
    local ok, ready = pcall(function()
        local cooldown = Player.PlayerGui.Main.Skills[toolName][key].Cooldown
        return cooldown:IsA("Frame") and cooldown.Size.X.Scale == 1
    end)
    if not ok then return true end
    return ready
end

function Hub:KillPlayerStep(target)
    if not target or not self:AliveEnemy(target) then return false end
    self:KenRefresh()
    local char = Player.Character
    if not char then return false end
    if not char:FindFirstChildOfClass("Tool") then self:SelectTool() end
    self:Fight(target, nil, false)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and os.clock() - (self.KillSkillAt or 0) > 0.8 then
        for _, key in ipairs({ "Z", "X", "C" }) do
            if self:SkillReady(tool.Name, key) then
                local levelOk = true
                pcall(function()
                    local info = tool:FindFirstChild("Data") and require(tool.Data)
                    local need = info and info.Lvl and info.Lvl[key]
                    local level = tool:FindFirstChild("Level")
                    if need and level then levelOk = level.Value >= need end
                end)
                if levelOk then
                    self.KillSkillAt = os.clock()
                    self:PressKey(key)
                    break
                end
            end
        end
    end
    return true
end

