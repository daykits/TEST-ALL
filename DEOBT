    if self.Config and before ~= self.Sea then self:SanitizeSeaConfig() end
    return self.Sea
end

function Hub:FindNPC(value)
    local cf = Compat.cframe(value)
    if cf then return cf end
    if type(value) ~= "string" then return nil end

    if value:match("^workspace%.") or value:match("^game%.") then
        local segments = string.split(value, ".")
        local base = table.remove(segments, 1) == "workspace" and Services.Workspace or game
        return Compat.cframe(Compat.find(base, segments))
    end
    local normalized = value:lower():gsub("[%s%-_]", "")
    for _, base in ipairs({ Services.Workspace, Services.ReplicatedStorage }) do
        local folder = base:FindFirstChild("NPCs")
        if folder then
            local exact = folder:FindFirstChild(value)
            cf = Compat.cframe(exact)
            if cf then return cf end
            for _, npc in ipairs(folder:GetChildren()) do
                if npc.Name:lower():gsub("[%s%-_]", "") == normalized then
                    cf = Compat.cframe(npc)
                    if cf then return cf end
                end
            end
        end
    end
    return nil
end

function Hub:RestorePhysics()
    for part, saved in pairs(self.CollisionState) do
        pcall(function() if part.Parent then part.CanCollide = saved end end)
    end
    table.clear(self.CollisionState)
    if self.BodyClip then pcall(self.BodyClip.Destroy, self.BodyClip); self.BodyClip = nil end
    if self.PhysicsHumanoid then
        pcall(function()
            if self.PhysicsHumanoid.Parent and self.PhysicsHumanoid.Health > 0 then
                self.PhysicsHumanoid.AutoRotate = true
                self.PhysicsHumanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
        self.PhysicsHumanoid = nil
    end
end

function Hub:MaintainPhysics()
    local char, humanoid, root = self:Character()
    local active = char and (self.Tween ~= nil or os.clock() - self.LastMoveRequest < 0.7)
    if not active then self:RestorePhysics(); return end
    if not self.BodyClip or self.BodyClip.Parent ~= root then
        if self.BodyClip then self.BodyClip:Destroy() end
        self.BodyClip = Instance.new("BodyVelocity")
        self.BodyClip.Name = "BaconHubBodyClip"
        self.BodyClip.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        self.BodyClip.Velocity = Vector3.zero
        self.BodyClip.Parent = root
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if self.CollisionState[part] == nil then self.CollisionState[part] = part.CanCollide end
            part.CanCollide = false

        end
    end
    self.PhysicsHumanoid = humanoid
    pcall(function() humanoid.AutoRotate = false end)
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
end

function Hub:CancelTween(restore)
    local tween = self.Tween
    self.Tween = nil
    self.TweenTarget = nil
    if self.TweenConnection then self.TweenConnection:Disconnect(); self.TweenConnection = nil end
    if tween then pcall(tween.Cancel, tween) end
    if restore then
        self.LastMoveRequest = -100
        self:RestorePhysics()
    end
end

function Hub:CancelMove()
    self:CancelTween(true)
end

function Hub:TweenTo(value, speed)
    if not self.Alive then return false end
    local target = Compat.cframe(value)
    local _, _, root = self:Character()
    if not target or not root then return false end
    local now = os.clock()
    self.LastMoveRequest = now
    local distance = (target.Position - root.Position).Magnitude
    if distance <= 7 then
        self:CancelMove()
        self.LastMoveRequest = now
        return true
    end
    local rate = speed or self.Config.TweenSpeed
    if rate <= 0 then rate = self.Config.TweenSpeed end
    if self.Tween and self.TweenTarget then
        local targetDrift = (self.TweenTarget.Position - target.Position).Magnitude
        local tolerance = math.clamp(rate * 0.1, 10, 20)
        if targetDrift <= tolerance then return false end
        self:CancelTween(false)
    end
    self.LastMoveRequest = now
    local duration = math.max(distance / rate, 0.08)
    local tween = Services.TweenService:Create(root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = target })
    self.Tween, self.TweenTarget = tween, target
    local connection
    connection = tween.Completed:Connect(function()
        if connection then connection:Disconnect() end
        if self.Tween == tween then self.Tween = nil; self.TweenTarget = nil; self.TweenConnection = nil end
    end)
    self.TweenConnection = connection
    tween:Play()
    return false
end

function Hub:GetPhysicalPortalPairs()
    if os.clock() - self.LastPortalRefresh < 2 and self.PortalPairs then return self.PortalPairs end
    self.LastPortalRefresh = os.clock()
    local pairsList = {}
    local map = Services.Workspace:FindFirstChild("Map")
    if self.Sea == "Sea1" then
        local portal = map and map:FindFirstChild("TeleportSpawn", true)
        local entrance = portal and portal:FindFirstChild("Entrance", true)
        local exit = portal and portal:FindFirstChild("Exit", true)
        if Compat.isA(entrance, "BasePart") and Compat.isA(exit, "BasePart") then
            table.insert(pairsList, { Entrance = entrance, Exit = exit })
        end
    elseif self.Sea == "Sea2" then
        local entrance = Compat.find(map, { "GhostShip", "TeleportSpawn" })
        local exit = Compat.find(map, { "GhostShipInterior", "TeleportSpawn" })
        if Compat.isA(entrance, "BasePart") and Compat.isA(exit, "BasePart") then
            table.insert(pairsList, { Entrance = entrance, Exit = exit })
        end
    end
    self.PortalPairs = pairsList
    return pairsList
end

function Hub:CombatLock()
    local now = os.clock()
    local char = Player.Character
    if char and char:GetAttribute("InCombat") == true then
        self.CombatLockAt = now
        return true
    end
    if Player:GetAttribute("InCombat") == true then
        self.CombatLockAt = now
        return true
    end
    local global = self:Module("Global", { "Global" })
    if global and global.InCombat == true then
        self.CombatLockAt = now
        return true
    end
    local ok, visible = pcall(function()
        local flag = Player.PlayerGui.Main.BottomHUDList.InCombat
        return flag ~= nil and flag.Visible == true
    end)
    if ok and visible then
        self.CombatLockAt = now
        return true
    end
    return now - (self.CombatLockAt or -100) < 5
end

function Hub:SubmarineCombatHold(label)
    if not self:CombatLock() then
        self.SubmarineHoldAt = nil
        self.SubmarineHoldGiveUp = nil
        return false
    end
    if self.SubmarineHoldGiveUp and os.clock() < self.SubmarineHoldGiveUp then return false end
    if not self.SubmarineHoldAt then self.SubmarineHoldAt = os.clock() end
    if os.clock() - self.SubmarineHoldAt > 45 then
        self.SubmarineHoldAt = nil
        self.SubmarineHoldGiveUp = os.clock() + 120
        self:Log(label, "Combat persists, resuming direct route", 6)
        return false
    end
    self:CancelTween(false)
    local mob = self:Enemies(function() return true end, 260)[1]
    if mob then
        self:Fight(mob, mob.Name, false)
        self:Log(label, "Clearing combat: " .. mob.Name, 4)
    else
        local _, _, root = self:Character()
        if root then
            self:TweenTo(CFrame.new(root.Position + Vector3.new(0, 150, 0)), 300)
            self:Log(label, "Backing off to drop combat", 4)
        end
    end
    return true
end

function Hub:WorldPortalEntry(root)
    local best, distance
    for _, portal in ipairs(Services.CollectionService:GetTagged("WORLD_TELEPORTER")) do
        local smokes = portal:IsA("Model") and portal:FindFirstChild("Smokes") or nil
        if Compat.isA(smokes, "BasePart") and smokes.Parent then
            local value = (root.Position - smokes.Position).Magnitude
            if not distance or value < distance then best, distance = smokes, value end
        end
    end
    return best, distance
end

function Hub:WorldPortalDestination(name)
    local destinations = self.TravelDestinations or {}
    local direct = destinations[name]
    if direct then return direct end
    local wanted = Compat.normalizeName(name):gsub("[%s%-_]", "")
    for key, cf in pairs(destinations) do
        if Compat.normalizeName(key):gsub("[%s%-_]", "") == wanted then return cf end
    end
    local origin = Services.Workspace:FindFirstChild("_WorldOrigin")
    local locations = origin and origin:FindFirstChild("Locations")
    for _, location in ipairs(locations and locations:GetChildren() or {}) do
        if Compat.normalizeName(location.Name):gsub("[%s%-_]", "") == wanted then return Compat.cframe(location) end
    end
    return nil
end

function Hub:WorldPortalLocations()
    if os.clock() < (self.WorldPortalLocationsUntil or 0) then return self.WorldPortalLocationCache end
    local locations = self:GatewayLocations()
    self.WorldPortalLocationCache = type(locations) == "table" and locations or nil
    self.WorldPortalLocationsUntil = os.clock() + (self.WorldPortalLocationCache and 8 or 3)
    return self.WorldPortalLocationCache
end

function Hub:TryWorldPortal(target)
    if not self.Config["Smart Portal"] or Player:GetAttribute("UnlockedGateways") ~= true or self:HasRestrictedItem() then return false end
    local char, _, root = self:Character()
    if not char or not root then return false end
    local route = self.WorldPortalRoute
    if route and (route.Goal - target.Position).Magnitude > 150 then route = nil; self.WorldPortalRoute = nil end
    if route then
        if not route.Entry.Parent or os.clock() >= route.Timeout then self.WorldPortalRoute = nil; return false end
        if route.Stage == "Wait" then
            if (root.Position - route.Entry.Position).Magnitude > 100 then self.WorldPortalRoute = nil; return false end
            self:CancelTween(false)
            return true
        end
        if (root.Position - route.Entry.Position).Magnitude > 18 then
            self:TweenTo(route.Entry.CFrame)
            return true
        end
        self:CancelTween(false)
        route.Stage = "Wait"
        local ok, response = self:InvokeNet("WorldTeleporter", { Type = "TeleportTo", IslandKey = route.IslandKey }, 2)
        if not ok or type(response) ~= "table" or response.Type ~= "TeleportTo" or response.WasSuccess ~= true then
            self.WorldPortalRoute = nil
            self.WorldPortalBlockedUntil = os.clock() + 10
            return false
        end
        route.Timeout = os.clock() + 5
        self:Log("world-portal", route.IslandKey, 1)
        return true
    end
    if os.clock() < (self.WorldPortalBlockedUntil or 0) then return false end
    local entry, entryDistance = self:WorldPortalEntry(root)
    if not entry then return false end
    local direct = (target.Position - root.Position).Magnitude
    local saving = tonumber(self.Config["Portal Min Saving"]) or 700
    local islandKey, destination, residual
    for _, name in ipairs(self:WorldPortalLocations() or {}) do
        local cf = self:WorldPortalDestination(name)
        if cf then
            local value = (target.Position - cf.Position).Magnitude
            if not residual or value < residual then islandKey, destination, residual = name, cf, value end
        end
    end
    if not islandKey or entryDistance + residual + 250 + saving >= direct then return false end
    self.WorldPortalRoute = {
        Goal = target.Position,
        Entry = entry,
        IslandKey = islandKey,
        Destination = destination,
        Stage = "Approach",
        Timeout = os.clock() + math.max(15, entryDistance / math.max(self.Config.TweenSpeed, 1) + 8),
    }
    self:Log("world-portal", "routing through " .. islandKey, 1)
    self:TweenTo(entry.CFrame)
    return true
end

function Hub:SubmergedCenter()
    local map = Services.Workspace:FindFirstChild("Map")
    local island = map and map:FindFirstChild("Submerged Island")
    local cf = Compat.cframe(island)
    if cf then return cf.Position end
    local origin = Services.Workspace:FindFirstChild("_WorldOrigin")
    local locations = origin and origin:FindFirstChild("Locations")
    local marker = locations and locations:FindFirstChild("Submerged Island")
    cf = Compat.cframe(marker)
    return cf and cf.Position or Vector3.new(11256, -2138, 9888)
end

function Hub:TrySubmergedRoute(target)
    if self.Sea ~= "Sea3" then return false end
    local _, _, root = self:Character()
    if not root then return false end
    local center = self:SubmergedCenter()
    local targetDistance = (target.Position - center).Magnitude
    local rootDistance = (root.Position - center).Magnitude
    if rootDistance < 5000 then
        if targetDistance >= 5000 then
            return self:SubmergedReturnStep(target)
        end
        self.SubmergedTransitUntil = nil
        return false
    end
    if targetDistance > 5000 then
        self.SubmergedTransitUntil = nil
        return false
    end
    if self:HasRestrictedItem() then
        self:CancelTween(false)
        self:Log("submerged-route", "Restricted item blocks submarine", 3)
        return true
    end
    if self.SubmergedTransitUntil and os.clock() < self.SubmergedTransitUntil then
        self:CancelTween(false)
        return true
    end
    self.SubmergedTransitUntil = nil
    local worker = self:FindNPC("Submarine Worker") or CFrame.new(-16269, 23, 1371)
    local direct = (target.Position - root.Position).Magnitude
    local routeCost = (target.Position - center).Magnitude + 400
    local saving = tonumber(self.Config["Portal Min Saving"]) or 700
    if routeCost + saving >= direct then return false end
    if (worker.Position - root.Position).Magnitude > 55 then
        self:TweenTo(worker + Vector3.new(0, 3, 0))
        self:Log("submerged-route", "Moving to submarine", 3)
        return true
    end
    if os.clock() < (self.SubmergedRouteRetryAt or 0) then return true end
    self.SubmergedRouteRetryAt = os.clock() + 6
    self:CancelTween(false)
    local controller = self:Module("SubmergedIslandController", { "Controllers", "MapServices", "SubmergedIslandController" })
    if controller and type(controller.LoadMap) == "function" then
        pcall(controller.LoadMap, controller)
        task.wait(0.15)
    end
    local remote = self:NetRemote("RF", "SubmarineWorkerSpeak")
    if not remote then
        self:Log("submerged-route", "SubmarineWorkerSpeak unavailable", 3)
        return true
    end
    if self:SubmarineCombatHold("submerged-route") then return true end
    local checked, killed = self:Call("submarine-check", 8, 1, function() return remote:InvokeServer("AskKilledTikiBoss") end)
    if not checked then return true end
    if killed == false then
        self.SubmergedTransitUntil = nil
        if os.clock() - (self.SubmergedIneligibleAt or -100) > 45 then
            self.SubmergedIneligibleAt = os.clock()
            self:Notify("Submerged Island", "Tyrant of the Skies not defeated yet. Auto farming the eagle boss to unlock.")
        end
        self:FullyTyrantStep()
        return true
    end
    local sent, travelReply = self:Call("submarine-travel", 8, 5, function() return remote:InvokeServer("TravelToSubmergedIsland") end)
    if sent and travelReply ~= -1 then
        self.SubmergedTransitUntil = os.clock() + 8
        self.LastMoveRequest = os.clock()
        self:Log("submerged-route", "Submarine transit", 1)
    elseif sent then
        self.CombatLockAt = os.clock()
        self:Log("submerged-route", "Submarine refused, waiting out combat", 4)
    end
    return true
end

function Hub:SubmergedReturnStep(target)
    if self.SubmergedTransitUntil and os.clock() < self.SubmergedTransitUntil then
        self:CancelTween(false)
        return true
    end
    self.SubmergedTransitUntil = nil
    self:CancelTween(false)
    self.SecretStrikeTarget, self.AttackTarget, self.Target = nil, nil, nil
    if self:SubmarineCombatHold("submerged-return") then return true end
    if os.clock() < (self.SubmergedReturnRetryAt or 0) then return true end
    local captain = self:FindNPC("Submarine Worker2") or self:FindNPC("Submarine Worker")
    local _, _, root = self:Character()
    if captain and root and (root.Position - captain.Position).Magnitude > 30 then
        self:TweenTo(captain + Vector3.new(0, 3, 0))
        self:Log("submerged-return", "Moving to submarine", 4)
        return true
    end
    self.SubmergedReturnRetryAt = os.clock() + 5
    self:CancelTween(false)
    local remote = self:NetRemote("RF", "SubmarineTransportation")
    if not remote then
        self:Log("submerged-return", "SubmarineTransportation unavailable", 5)
        return true
    end
    local ok, locations = self:Call("submerged-locations", 8, 2, function() return remote:InvokeServer("GetAvailableLocations") end)
    if not ok then return true end
    if locations == -1 then
        self.CombatLockAt = os.clock()
        self:Log("submerged-return", "Submarine refused, still in combat", 4)
        return true
    end
    if type(locations) ~= "table" or #locations == 0 then
        self:Log("submerged-return", "No submarine destinations available", 5)
        return true
    end
    local best, bestDistance
    for _, location in ipairs(locations) do
        if type(location) == "table" and type(location.Name) == "string" then
            local cf = self:WorldPortalDestination(location.Name)
            local distance = cf and (cf.Position - target.Position).Magnitude or math.huge
            if location.Name == "Tiki Outpost" then distance -= 2500 end
            if not bestDistance or distance < bestDistance then best, bestDistance = location.Name, distance end
        end
    end
    best = best or "Tiki Outpost"
    self.SecretStrikeTarget, self.AttackTarget, self.Target = nil, nil, nil
    local sent, result = self:Call("submerged-return", 10, 4, function() return remote:InvokeServer("InitiateTeleport", best) end)
    if sent and result ~= -1 and result ~= false then
        self.SubmergedTransitUntil = os.clock() + 10
        self.LastMoveRequest = os.clock()
        self:Log("submerged-return", "Submarine to " .. best, 1)
    else
        if result == -1 then self.CombatLockAt = os.clock() end
        self:Log("submerged-return", "Return rejected (" .. tostring(result) .. ")", 4)
    end
    return true
end

function Hub:MoveTo(value)
    local target = Compat.cframe(value)
    if not self.Alive or not target then return false end
    local _, humanoid, root = self:Character()
    if not root then return false end
    if humanoid and Compat.isA(humanoid.SeatPart, "VehicleSeat") then
        if self.SeaCancelBoatTween then self:SeaCancelBoatTween() end
        humanoid.Sit = false
    end
    if self.Route and (self.Route.Goal - target.Position).Magnitude > 150 then self.Route = nil end
    if not self.Route and self:TrySubmergedRoute(target) then return false end
    if not self.Route and self:TryWorldPortal(target) then return false end
    if not self.Route and self:TryHalloweenRoute(target) then return false end
    if self.Route then
        local route = self.Route
        if (root.Position - route.To.Position).Magnitude < 100 then
            self.Route = nil
        elseif route.WaitUntil then
            if os.clock() >= route.WaitUntil then
                self.Route = nil
                self.LastPortalAttempt = os.clock()
                self:Log("portal", "Portal unavailable.")
            end
            return false
        elseif not route.Source.Parent or not route.Destination.Parent then
            self.Route = nil
        else
            if self:TweenTo(route.From) then
                route.WaitUntil = os.clock() + 7
                if type(firetouchinterest) == "function" then
                    for _ = 1, 3 do
                        pcall(firetouchinterest, root, route.Source, 0)
                        task.wait(0.15)
                        pcall(firetouchinterest, root, route.Source, 1)
                        task.wait(0.3)
                        if (root.Position - route.To.Position).Magnitude < 100 then break end
                    end
                end
            end
            return false
        end
    end
    if self.Config["Smart Portal"] and not self:HasRestrictedItem() and os.clock() - self.LastPortalAttempt > 20 then
        local route = Compat.portalRoute(root.Position, target.Position, self:GetPhysicalPortalPairs(), self.Config["Portal Min Saving"])
        if route then
            route.Goal = target.Position
            self.Route = route
            self.LastPortalAttempt = os.clock()
            self:TweenTo(route.From)
            return false
        end
    end
    local rootBackend = math.abs(root.Position.X) > 30000 or math.abs(root.Position.Z) > 30000
    local targetBackend = math.abs(target.Position.X) > 30000 or math.abs(target.Position.Z) > 30000
    if self.Sea == "Sea1" and rootBackend ~= targetBackend then
        self:CancelTween(false)
        self:Log("portal", "Waiting for Underwater City portal.", 3)
        return false
    end
    local rate = self.Config.TweenSpeed
    return self:TweenTo(target, math.min(rate, 300))
end

function Hub:MoveUntil(value, predicate, timeout)
    local target = Compat.cframe(value)
    if not target then return false, "Destination is not loaded" end
    local budget = timeout or 45
    local deadline = os.clock() + budget
    local generation = self.ActionGeneration or 0
    while self.Alive and generation == (self.ActionGeneration or 0) and (not predicate or predicate()) and os.clock() < deadline do
        if self:MoveTo(target) then return true end
        local _, _, watchdog = self:Character()
        if watchdog then
            if not self.StuckAt or (watchdog.Position - (self.StuckPos or watchdog.Position)).Magnitude > 5 then
                self.StuckAt, self.StuckPos = os.clock(), watchdog.Position
            elseif os.clock() - self.StuckAt > 3 and self.Tween then
                self.StuckAt = os.clock()
                self:CancelMove()
                task.wait(0.1)
            end
        end
        task.wait(0.2)
    end
    self:CancelMove()
    return false, "Movement stopped or timed out"
end

function Hub:HasRestrictedItem()
    local backpack = Player:FindFirstChild("Backpack")
    local char = Player.Character
    for _, name in ipairs({ "God's Chalice", "Sweet Chalice", "Hallow Essence", "Red Key", "Apple", "Banana", "Pineapple", "Flower 1", "Flower 2", "Flower 3" }) do
        if (backpack and backpack:FindFirstChild(name)) or (char and char:FindFirstChild(name)) then return true end
    end
    return false
end

function Hub:Stop()
    if not self.Alive then return end
    if self.FishCleanup then self:FishCleanup() end
    if self.SeaStopBoatControls then self:SeaStopBoatControls() end
    self.Alive = false
    if self.ReleaseBackpackEquip then self:ReleaseBackpackEquip() end
    if self.ResetFastAttack then self:ResetFastAttack() end
    if self.ResetSecretAutomation then self:ResetSecretAutomation() end
    if self.RestoreSecretGuide then self:RestoreSecretGuide() end
    self.SubmergedReturnRetryAt, self.SubmergedTransitUntil = nil, nil
    self.ActionGeneration = (self.ActionGeneration or 0) + 1
    self:CancelMove()
    for _, connection in ipairs(self.Connections) do pcall(connection.Disconnect, connection) end
    for _, input in pairs(self.Inputs) do pcall(input.Release, input); pcall(input.Destroy, input) end
    if self.CombatUtil and self.TargetPatch and self.CombatUtil.GetTargetPosition == self.TargetPatch then
        pcall(function() self.CombatUtil.GetTargetPosition = self.OriginalTargetPosition end)
    end
    for humanoid, speed in pairs(self.EnemyState) do
        pcall(function() if humanoid.Parent then humanoid.WalkSpeed = speed end end)
    end
    if self.ResetVisuals then pcall(self.ResetVisuals, self) end
    if self.ItemsGui then pcall(self.ItemsGui.Destroy, self.ItemsGui) end
    if self.Library and type(self.Library.DestroyUI) == "function" then pcall(self.Library.DestroyUI) end
    _G.onfarm = false

end

