		local ok = pcall(function()
			playerObj = Players:FindFirstChild(p67)

			if playerObj and playerObj.Character then
				targetHRP = playerObj.Character:FindFirstChild("HumanoidRootPart")

				if targetHRP then
					blobman = currentBlobS
					leftDetector = blobman:FindFirstChild("LeftDetector")

