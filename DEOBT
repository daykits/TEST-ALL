function Hub:HalloweenDialogueOptions(page)
    local list = {}
    local raw = type(page) == "table" and page._options or nil
    if type(raw) ~= "table" then return list end
    for index, option in ipairs(raw) do
        local label, locked, kind = "", false, nil
        pcall(function()
            if type(option) == "string" then
                label = option
            elseif type(option) == "table" then
                local text = option._text
                if type(text) == "table" then label = tostring(text[1] or "")
                elseif type(text) == "string" then label = text end
                if label == "" then label = tostring(option.Label or option.label or option.Text or option.text or "") end
                locked = option._locked == true
                kind = option._optionType
            end
        end)
        label = self:HalloweenCleanText(tostring(label or ""))
        if label ~= "" and not locked then
            table.insert(list, { Option = option, Index = index, Label = label, Lower = label:lower(), Type = kind })
        end
    end
    return list
end

function Hub:HalloweenDialogueText(page)
    local parts = {}
    local sources = type(page) == "table" and page._textSources or nil
    if type(sources) == "table" then
        for _, text in ipairs(sources) do
            local clean = self:HalloweenCleanText(tostring(text or ""))
            if clean ~= "" then table.insert(parts, clean) end
        end
    end
    return table.concat(parts, " ")
end

