-- PHASE 5: MAIN MENU THEN SEA 2

-- ============================================================

local function phase5MainMenuSea2()

	if not getgenv().KaitunFarm then return end

	if configFlag("ITEM", "World Scroll", true) and not hasWorldScroll() then

		notify("Kaitun", "World Scroll not in inventory. Main menu blocked.", 8)

		getgenv().KaitunFarm = false

		return

	end

	local code = getActivePSCode()

	if code == "" then

		notify("Kaitun Sea 2", "No PS code set. Main menu blocked.", 8)

		getgenv().KaitunFarm = false

		return

	end

	savePSCode(code)

	getgenv().KaitunSea2Code = code

	getgenv().KaitunSea2Pending = true

	notify("Kaitun", "Going main menu for Sea 2...", 5)

	task.wait(1)

	pcall(function()

		TeleportService:Teleport(LOGIN_PLACE_ID, LocalPlayer)

	end)

end

-- ============================================================

-- SEA 2 FARM: CRAZY WOLF TO 675

-- ============================================================

local S2 = { running = false, loopID = 0, upHeight = 9, canAttack = true }

local function setSea2Spawn()

	local setSpawnRemote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("SetSpawn")

	local spawnPos = Vector3.new(7319.132, 21.723, 10561.868)

	DoSafeTeleport(spawnPos)

	task.wait(1)

	pcall(function() setSpawnRemote:FireServer() end)

	task.wait(0.5)

end

local function getCrazyWolvesNear(pos, radius)

	local result = {}

	radius = radius or 22

	for _, d in ipairs(getAllNPCs("Crazy Wolf")) do

		if d.hrp and (d.hrp.Position - pos).Magnitude <= radius then

			table.insert(result, d)

		end

	end

	return result

end

local function attackWolf(wolf)

	if not S2.canAttack then return end

	local hum = wolf and wolf:FindFirstChild("Humanoid")

	local hrp = wolf and wolf:FindFirstChild("HumanoidRootPart")

	if not hum or hum.Health <= 0 or not hrp then return end

	S2.canAttack = false

	equipMelee()

	local lockActive = true

	local lockConn = RunService.Heartbeat:Connect(function()

		if not lockActive then return end

		local liveHrp = wolf and wolf:FindFirstChild("HumanoidRootPart")

		local liveHum = wolf and wolf:FindFirstChild("Humanoid")

		local rp = getHRP()

		local selfHum = getHumanoid()

		if not liveHrp or not liveHum or liveHum.Health <= 0 or not rp or not selfHum or selfHum.Health <= 0 then

			return

		end

		setNoclip(true)

		local standPos = Vector3.new(liveHrp.Position.X, liveHrp.Position.Y + S2.upHeight, liveHrp.Position.Z)

		enableAirHold(rp, standPos)

		selfHum.AutoRotate = false

		selfHum.PlatformStand = false

		selfHum.Sit = false

		rp.CFrame = CFrame.new(standPos)

		rp.AssemblyLinearVelocity = Vector3.zero

		rp.AssemblyAngularVelocity = Vector3.zero

	end)

	for combo = 1, 5 do

		if not getgenv().Sea2Farm then break end

		hrp = wolf:FindFirstChild("HumanoidRootPart")

		hum = wolf:FindFirstChild("Humanoid")

		local rp = getHRP()

		if not hrp or not hum or hum.Health <= 0 or not rp then break end

		local npcPos = hrp.Position

		local standPos = Vector3.new(npcPos.X, npcPos.Y + S2.upHeight, npcPos.Z)

		enableAirHold(rp, standPos)

		rp.CFrame = CFrame.new(standPos)

		rp.AssemblyLinearVelocity = Vector3.zero

		rp.AssemblyAngularVelocity = Vector3.zero

		local hrpList = {}

		local npcIDs = {}

		for _, d in ipairs(getCrazyWolvesNear(npcPos, 22)) do

			table.insert(hrpList, d.hrp)

			local id = getNPCID(d.npc)

			if id then table.insert(npcIDs, id) end

		end

		if #hrpList == 0 then

			table.insert(hrpList, hrp)

			local id = getNPCID(wolf)

			if id then table.insert(npcIDs, id) end

		end

		pcall(function()

			local current = getHRP()

			local liveHrp = wolf and wolf:FindFirstChild("HumanoidRootPart")

			if current and liveHrp then

				local liveStandPos = Vector3.new(liveHrp.Position.X, liveHrp.Position.Y + S2.upHeight, liveHrp.Position.Z)

				enableAirHold(current, liveStandPos)

				current.CFrame = CFrame.new(liveStandPos)

				current.AssemblyLinearVelocity = Vector3.zero

				current.AssemblyAngularVelocity = Vector3.zero

			end

			combatRegister:InvokeServer({

				[1] = "swingsfx", [2] = "Melee", [3] = combo,

				[4] = "Ground", [5] = false, [6] = CombatAnims[combo],

				[7] = combo == 1 and 2 or 1.75, [8] = 1.5,

			})

			current = getHRP()

			liveHrp = wolf and wolf:FindFirstChild("HumanoidRootPart")

			if current and liveHrp then

				local liveStandPos = Vector3.new(liveHrp.Position.X, liveHrp.Position.Y + S2.upHeight, liveHrp.Position.Z)

				enableAirHold(current, liveStandPos)

				current.CFrame = CFrame.new(liveStandPos)

				current.AssemblyLinearVelocity = Vector3.zero

				current.AssemblyAngularVelocity = Vector3.zero

			end

			local packet = {

				[1] = {

					[1] = "damage", [2] = hrpList, [3] = "Melee",

					[4] = { combo, "Ground", "Melee" }, [5] = true,

					[6] = current and current.CFrame or rp.CFrame,

					aircombo = "Ground",

				}

			}

			if #npcIDs > 0 then packet[1].NPCIDs = npcIDs end

			combatRegister:InvokeServer(unpack(packet))

		end)

		task.wait(0.21)

	end

	lockActive = false

	if lockConn then lockConn:Disconnect() end

	local humEnd = getHumanoid()

	if humEnd then

		humEnd.AutoRotate = true

	end

	disableAirHold()

	task.wait(1)

	S2.canAttack = true

end

function H.startSea2Farm()

	if S2.running then return end

	if not IS_SEA2_PLACE then

		startAutoJoinSea2(getActivePSCode())

		return

	end

	-- Ne pas verifier PrivateServerId ici: le retour main menu est gere uniquement

	-- par le flag Fatal Error / 267 dans shouldForceMainMenuFromCurrentPlace().

	S2.running = true

	S2.loopID = S2.loopID + 1

	local loopID = S2.loopID

	getgenv().Sea2Farm = true

	H.autoAdsEnabled = true

	H.autoStatsEnabled = true

	setNoclip(true)

	H.teleportSpeed = DefaultConfig.MAIN.TWEEN_SPEED or 70

	notify("Sea 2", "Crazy Wolf farm started.", 5)

	task.spawn(function()

		setSea2Spawn()

		local questName = "Help PJ"

		local questPos = Vector3.new(7121.167, 56.273, 10553.389)

		local center = Vector3.new(7319.132, 21.723, 10561.868)

		local maxLevel = DefaultConfig.MAIN.LEVEL or 675

		while getgenv().Sea2Farm and S2.loopID == loopID do

			if not isAlive() then task.wait(0.5) continue end

			if getLevel() >= maxLevel then

				notify("Sea 2", "Level " .. tostring(maxLevel) .. " reached.", 6)

				break

			end

			equipMelee()

			if getQuest() ~= questName and getLevel() >= 425 then

				takeQuest(questName, questPos)

				task.wait(0.5)

				continue

			end

			local wolf = getClosestNPC("Crazy Wolf")

			local rp = getHRP()

			if not rp then task.wait(0.5) continue end

			if not wolf then

				local centerPos = Vector3.new(center.X, center.Y + S2.upHeight, center.Z)

				if (rp.Position - centerPos).Magnitude > 8 then

					DoSafeTeleport(centerPos, true)

				end

				task.wait(0.5)

				continue

			end

			local hrp = wolf:FindFirstChild("HumanoidRootPart")

			if hrp then

				local standPos = Vector3.new(hrp.Position.X, hrp.Position.Y + S2.upHeight, hrp.Position.Z)

				if (rp.Position - standPos).Magnitude > 8 then

					DoSafeTeleport(standPos, true)

				end

				task.wait(0.03)

				attackWolf(wolf)

			end

			task.wait(0.21)

		end

		getgenv().Sea2Farm = false

		S2.running = false

		H.autoAdsEnabled = false

		H.autoStatsEnabled = false

		notify("Sea 2", "Farm stopped.", 4)

	end)

end

function H.stopSea2Farm()

	getgenv().Sea2Farm = false

	S2.running = false

	S2.loopID = S2.loopID + 1

	S2.canAttack = true

	H.tpToken = H.tpToken + 1

end

