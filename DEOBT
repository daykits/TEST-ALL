function Hub:AliveEnemy(model)
    if not Compat.isA(model, "Model") or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    return hum ~= nil and hum.Health > 0 and Compat.isA(root, "BasePart"), hum, root
end

function Hub:Enemies(query, radius)
    local _, _, root = self:Character()
    local folder = Services.Workspace:FindFirstChild("Enemies")
    if not root or not folder then return {} end
    local candidates = {}
    for _, model in ipairs(folder:GetChildren()) do
        local alive, humanoid, part = self:AliveEnemy(model)
        if alive then
            local match = type(query) == "function" and query(model) or Compat.nameMatches(model.Name, query)
            if match then
                local distance = (part.Position - root.Position).Magnitude
                if distance <= (radius or math.huge) then
                    table.insert(candidates, { Model = model, Part = part, Humanoid = humanoid, Distance = distance, Score = distance })
                end
            end
        end
    end
    if self.Config and self.Config["Smart Farm"] then
        for _, candidate in ipairs(candidates) do
            local cluster = 0
            if #candidates <= 40 then
                for _, other in ipairs(candidates) do
                    if other ~= candidate and (other.Part.Position - candidate.Part.Position).Magnitude <= 65 then cluster += 1 end
                end
            end
            local health = candidate.Humanoid and candidate.Humanoid.Health or 0
            local maximum = candidate.Humanoid and math.max(candidate.Humanoid.MaxHealth, 1) or 1
            candidate.Score = candidate.Distance + health / maximum * 18 - math.min(cluster, 8) * 7
            if candidate.Model == self.Target then candidate.Score -= 100000 end
        end
    end
    table.sort(candidates, function(a, b)
        if a.Score == b.Score then return a.Distance < b.Distance end
        return a.Score < b.Score
    end)
    local result = {}
    for _, candidate in ipairs(candidates) do table.insert(result, candidate.Model) end
    return result
end

