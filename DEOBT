local function tweenIntoPart(part)

	if not part or not part:IsA("BasePart") then return false end

	local targetPos = part.Position

	local started = tick()

	setNoclip(true)

	releaseMovementKeys()

	while tick() - started < 4 do

		local rp = getHRP()

		local hum = getHumanoid()

		if not rp or not hum or hum.Health <= 0 then return false end

		local delta = targetPos - rp.Position

		local dist = delta.Magnitude

		if dist <= 1.2 then

			rp.AssemblyLinearVelocity = Vector3.zero

			rp.AssemblyAngularVelocity = Vector3.zero

			return true

		end

		local dt = RunService.Heartbeat:Wait()

		local step = math.min((H.teleportSpeed or 70) * dt, dist)

		rp.CFrame = CFrame.new(rp.Position + delta.Unit * step)

		rp.AssemblyLinearVelocity = Vector3.zero

		rp.AssemblyAngularVelocity = Vector3.zero

	end

	return false

end

local function DoFishmanEscapeTeleport(targetPos)

	if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end

	if typeof(targetPos) ~= "Vector3" then return false end

	local started = tick()

	setNoclip(true)

	releaseMovementKeys()

	while tick() - started < 10 do

		local rp = getHRP()

		local hum = getHumanoid()

		if not rp or not hum or hum.Health <= 0 then return false end

		local delta = targetPos - rp.Position

		local dist = delta.Magnitude

		if dist <= 2.5 then

			rp.CFrame = CFrame.new(targetPos)

			rp.AssemblyLinearVelocity = Vector3.zero

			rp.AssemblyAngularVelocity = Vector3.zero

			return true

		end

		local dt = RunService.Heartbeat:Wait()

		local step = math.min((H.teleportSpeed or 70) * dt, dist, 5)

		local dir = delta.Unit

		rp.CFrame = CFrame.new(rp.Position + dir * step)

		rp.AssemblyLinearVelocity = Vector3.zero

		rp.AssemblyAngularVelocity = Vector3.zero

	end

	return false

end

local function fishmanEscape()

	if not isInFishmanCave() and not isOnFishmanIsland() then return false end

	notify("Kaitun", "Leaving Fishman Island...", 4)

	setNoclip(true)

	H.fishmanEscaping = true

	local escapeWaitPos = Vector3.new(8588.937, -2138.832, -17086.459)

	local ok = pcall(function()

		for _, wp in ipairs(FISHMAN_ESCAPE_PATH) do

			if not getgenv().KaitunFarm and not getgenv().Sea2Farm then break end

			DoFishmanEscapeTeleport(wp)

			task.wait(0.21)

		end

		local exitPart = getFishmanExitPart()

		if exitPart then

			notify("Kaitun", "Entering Fishman Part2 teleporter...", 4)

			DoFishmanEscapeTeleport(exitPart.Position)

			tweenIntoPart(exitPart)

		else

			DoFishmanEscapeTeleport(escapeWaitPos)

		end

	end)

	releaseMovementKeys()

	H.fishmanEscaping = false

	notify("Kaitun", "Fishman teleporter reached. Waiting 4s before Geppo...", 4)

	task.wait(4)

	return ok

end

local function ensureEscapedFishman(context)

	if not isAlive() then

		waitUntilAliveStable(8)

	end

	for _ = 1, 10 do

		local rp = getHRP()

		if rp then break end

		task.wait(0.1)

	end

	if not isInFishmanCave() and not isOnFishmanIsland() then

		return false

	end

	notify("Kaitun", tostring(context or "Fishman Cave") .. ": escaping Fishman by waypoints first...", 5)

	H.tpToken = H.tpToken + 1

	setNoclip(true)

	releaseMovementKeys()

	local escaped = fishmanEscape()

	waitUntilAliveStable(5)

	releaseMovementKeys()

	return escaped

end

