function Hub:ObservationV2Step()
    local status = function(text) self:SetInfo("KenStatusInfo", "Obs V2 | " .. text) end
    if self.Sea ~= "Sea3" then status("requires Third Sea"); return end
    local _, hum, root = self:Character()
    if not hum or not root then return end
    local level = self:Value({ "Data", "Level" })
    if type(level) ~= "number" or level < 1800 then status("requires level 1800"); return end
    local flags = select(2, self:Comm("CitizenQuestProgress"))
    if type(flags) ~= "table" then return end
    if flags.KilledBandits ~= true then status("Forest Pirates quest"); self:ObsV2Kill(false); return end
    if flags.KilledBoss ~= true then status("Captain Elephant quest"); self:ObsV2Kill(true); return end
    if self:FindTool("Fruit Bowl") then
        if self.ObsV2BoughtAt and os.clock() - self.ObsV2BoughtAt < 1.5 then return end
        if self.ObsV2BoughtAt then
            self.ObsV2BoughtAt = nil
            self.InventoryTime = -100
            if not self:FindTool("Fruit Bowl") then
                self:SetConfig("Auto Observation V2", false)
                self:Notify("Observation V2", "Observation V2 purchased.")
            end
            return
        end
        local beli = self:Value({ "Data", "Beli" })
        local _, raw = self:Comm("KenTalk", "Status")
        local points = tonumber((tostring(raw):gsub("%D", "")))
        if type(beli) ~= "number" or beli < 5000000 then status("needs $5,000,000"); return end
        if not points or points < 5000 then
            if not self:HasKen() then status("need Observation Haki"); return end
            if hum.Health / hum.MaxHealth < 0.25 then self:CancelMove(); status("HP low"); return end
            self:ObservationFarm(true)
            return
        end
        if self:ObsV2Reach(self.ObsV2Spots.Buy, 10) then
            status("buying Observation V2")
            self:Comm("KenTalk2", "Start")
            self:Comm("KenTalk2", "Buy")
            self.ObsV2BoughtAt = os.clock()
        end
        return
    end
    local _, stage = self:Comm("CitizenQuestProgress", "Citizen")
    if stage == 2 then status("going to turn-in"); self:ObsV2Reach(self.ObsV2Spots.Turn, 15); return end
    if stage == 3 then
        local missing
        for _, entry in ipairs(self.ObsV2Spots.Fruits) do
            if not self:FindTool(entry[1]) then missing = entry; break end
        end
        if not missing then
            status("making Fruit Bowl")
            if self:ObsV2Reach(self.ObsV2Spots.Quest, 10) then self:Comm("CitizenQuestProgress", "Citizen") end
            return
        end
        status("collecting " .. missing[1])
        if self:ObsV2Reach(missing[2], 150) then
            local object = Services.Workspace:FindFirstChild(missing[1], true)
            local handle = object and object:FindFirstChild("Handle")
            if handle and firetouchinterest then
                handle.CFrame = root.CFrame * CFrame.new(0, 1, 5)
                pcall(firetouchinterest, root, handle, 0)
                pcall(firetouchinterest, root, handle, 1)
            end
        end
        return
    end
    status("claiming quest")
    if self:ObsV2Reach(self.ObsV2Spots.Quest, 10) then self:Comm("CitizenQuestProgress", "Citizen") end
end

function Hub:GunShootStep()
    if not self.Config["Auto Shoot Gun"] then return end
    local char = Player.Character
    local gun
    for _, tool in ipairs(char and char:GetChildren() or {}) do
        if tool:IsA("Tool") and tool.ToolTip == "Gun" then gun = tool; break end
    end
    if not gun then return end
    local target = self.AimbotCurrent or self:AimbotTarget()
    local root = target and (target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart)
    local camera = Services.Workspace.CurrentCamera
    if not root or not camera then return end
    if os.clock() - (self.GunShotAt or 0) < (gun.Name == "Dragonstorm" and 0.2 or 1) then return end
    local point, onScreen = camera:WorldToScreenPoint(root.Position)
    if not onScreen then return end
    self.GunShotAt = os.clock()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(point.X, point.Y, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(point.X, point.Y, 0, false, game, 0)
    end)
end

