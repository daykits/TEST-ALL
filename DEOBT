function Hub:BartiloStep()
    if self.Sea ~= "Sea2" then self:ProgressStatus("Bartilo requires Second Sea"); return end
    local ok, flags = self:Comm("BartiloQuestProgress")
    if ok and type(flags) == "table" then
        if flags.DidPlates then return self:ProgressDone("Bartilo") end
        if flags.KilledSpring then
            local plates = Compat.find(Services.Workspace, { "Map", "Dressrosa", "BartiloPlates" })
            if not plates then self:ProgressStatus("Waiting for Bartilo plates"); return end
            local index = math.clamp(self.BartiloPlateIndex or 1, 1, 8)
            local wanted = plates:FindFirstChild(tostring(index)) or plates:FindFirstChild("Plate" .. index)
            if wanted then
                local _, _, root = self:Character()
                local cf = Compat.cframe(wanted)
                self:ProgressStatus("Bartilo plate " .. index .. "/8")
                self:ProgressMoveTouch(wanted)
                if root and cf and (root.Position - cf.Position).Magnitude <= 6 and os.clock() >= (self.BartiloPlateAt or 0) then
                    self.BartiloPlateAt = os.clock() + 0.35
                    if index < 8 then self.BartiloPlateIndex = index + 1
                    else self:Comm("BartiloQuestProgress", "DidPlates"); self.BartiloPlateIndex = 1 end
                end
            else self:ProgressStatus("Waiting for Bartilo plate " .. index) end
            return
        end
        if flags.KilledBandits then
            if self:ProgressFightBoss({ "Jeremy" }, "Bartilo: Jeremy") == false then self:Comm("BartiloQuestProgress", "Bartilo") end
            return
        end
        if not self:QuestVisible() or not self:QuestTitle():find("Swan Pirate", 1, true) then
            self:Comm("StartQuest", "BartiloQuest", 1)
        end
        self:ProgressFarm({ "Swan Pirate" }, "Bartilo: Swan Pirates", 2200)
        return
    end
    local sent, stage = self:Comm("BartiloQuestProgress", "Bartilo")
    if sent and stage == 3 then return self:ProgressDone("Bartilo") end
    if stage == 2 then self:Comm("BartiloQuestProgress", "DidPlates")
    elseif stage == 1 then self:ProgressFightBoss({ "Jeremy" }, "Bartilo: Jeremy")
    else self:Comm("StartQuest", "BartiloQuest", 1) end
end

