function Hub:HalloweenStartDialogue(dialogue)
    local controller, state = self:HalloweenDialoguePage()
    if not controller or type(controller.start) ~= "function" or dialogue == nil then return false end
    if state then return false end
    if os.clock() < (self.HalloweenDialogueStartGate or 0) then return false end
    self.HalloweenDialogueStartGate = os.clock() + 3
    task.spawn(function()
        local ok, problem = pcall(controller.start, dialogue)
        if not ok then self:Log("halloween-dialogue", problem, 5) end
    end)
    local deadline = os.clock() + 3
    while self.Alive and os.clock() < deadline do
        local _, active = self:HalloweenDialoguePage()
        if active then return true end
        task.wait(0.1)
    end
    return false
end

function Hub:HalloweenRunDialogue(dialogue, patterns, timeout, stopPredicate)
    if not self:HalloweenStartDialogue(dialogue) then return false, "unavailable", "" end
    local deadline = os.clock() + (timeout or 20)
    local lastAction, texts, seen = 0, {}, {}
    while self.Alive and os.clock() < deadline do
        if type(stopPredicate) == "function" then
            local ok, stop = pcall(stopPredicate)
            if ok and stop then return true, "stopped", table.concat(texts, " | ") end
        end
        local controller, state, page = self:HalloweenDialoguePage()
        if not state then return true, "closed", table.concat(texts, " | ") end
        local text = self:HalloweenDialogueText(page)
        if text ~= "" and not seen[text] then seen[text] = true; table.insert(texts, text) end
        if os.clock() - lastAction >= 0.35 then
            lastAction = os.clock()
            local visible = true
            pcall(function()
                if page and type(page.areOptionsVisible) == "function" then visible = page:areOptionsVisible() == true end
            end)
            local chosen
            if visible then
                local options = self:HalloweenDialogueOptions(page)
                for _, pattern in ipairs(patterns or {}) do
                    for _, entry in ipairs(options) do
                        if entry.Lower:find(pattern, 1, true) then chosen = entry; break end
                    end
                    if chosen then break end
                end
            end
            if chosen then self:HalloweenDialogueSelect(controller, chosen)
            else self:HalloweenDialogueAdvance(controller) end
        end
        task.wait(0.12)
    end
    local controller = self:HalloweenDialoguePage()
    self:HalloweenDialogueClose(controller)
    return false, "timeout", table.concat(texts, " | ")
end

function Hub:HalloweenDialogue(force)
    if not force and not self.Config["Halloween Auto Dialogue"] then return false end
    local controller, state, page = self:HalloweenDialoguePage()
    if not state then
        self.HalloweenDialogueKey = nil
        return false
    end
    local text = self:HalloweenDialogueText(page)
    local options = self:HalloweenDialogueOptions(page)
    local keyParts = { text }
    for _, entry in ipairs(options) do table.insert(keyParts, entry.Label) end
    local key = table.concat(keyParts, "|")
    if self.HalloweenDialogueKey ~= key then
        self.HalloweenDialogueKey, self.HalloweenDialogueSince = key, os.clock()
    end
    self:HalloweenMysteryObserve(text)
    self.HalloweenDialogueSeenAt = os.clock()
    self.HalloweenSceneHoldUntil = os.clock() + 4
    if os.clock() < (self.HalloweenDialogueAt or 0) then return true end
    self.HalloweenDialogueAt = os.clock() + 0.9
    local visible = true
    pcall(function()
        if page and type(page.areOptionsVisible) == "function" then visible = page:areOptionsVisible() == true end
    end)
    if visible and #options > 0 then
        local choice = self:HalloweenEventChoice(options, text)
        if choice == "close" then
            self:HalloweenDialogueClose(controller)
            return true
        end
        if choice == "wait" then return true end
        if type(choice) == "table" then
            self:HalloweenDialogueSelect(controller, choice)
            return true
        end
        local blocked = { "double", "triple", "scam", "give me your", "give to", "trade your", "sacrifice", "robux", "pay", "buy" }
        local wanted = { "trick or treat", "stop", "accept", "teleport", "happy halloween", "yeah", "yes", "ok", "treat", "continue" }
        local safe = {}
        for _, entry in ipairs(options) do
            local bad = false
            for _, word in ipairs(blocked) do
                if entry.Lower:find(word, 1, true) then bad = true; break end
            end
            if not bad then table.insert(safe, entry) end
        end
        for _, word in ipairs(wanted) do
            for _, entry in ipairs(safe) do
                if entry.Lower:find(word, 1, true) then
                    self:HalloweenDialogueSelect(controller, entry)
                    return true
                end
            end
        end
        for _, entry in ipairs(safe) do
            if entry.Type == "Accept" then
                self:HalloweenDialogueSelect(controller, entry)
                return true
            end
        end
        if #safe == 1 and safe[1].Type ~= "Purchase" then
            self:HalloweenDialogueSelect(controller, safe[1])
            return true
        end
        if os.clock() - (self.HalloweenDialogueSince or 0) > 30 and safe[1] and safe[1].Type ~= "Purchase" then
            self:HalloweenDialogueSelect(controller, safe[1])
        end
        return true
    end
    local delay = type(page) == "table" and page._advanceDelay or nil
    if type(delay) == "number" and delay > 0 and os.clock() - (self.HalloweenDialogueSince or 0) < math.min(delay, 8) then
        return true
    end
    self:HalloweenDialogueAdvance(controller)
    return true
end

function Hub:HalloweenFindOption(options, label)
    local want = label:lower()
    for _, entry in ipairs(options) do
        if entry.Lower == want then return entry end
    end
    return nil
end

function Hub:HalloweenFindOptionPart(options, part)
    for _, entry in ipairs(options) do
        if entry.Lower:find(part, 1, true) then return entry end
    end
    return nil
end

function Hub:HalloweenEventChoice(options, text)
    local lowerText = (text or ""):lower()
    local nevermind = self:HalloweenFindOption(options, "Nevermind")
    local death = self:HalloweenFindOption(options, "Give to Death")
    local parlus = self:HalloweenFindOption(options, "Give to Suizei")
    if death or parlus then
        local mode = self.Config["Halloween parlus"]
        if mode == "Give to Suizei (triple enemies)" and parlus then return parlus end
        if mode == "Give to Death (double enemies)" and death then return death end
        return "close"
    end
    local grab = self:HalloweenFindOption(options, "Grab a handful") or self:HalloweenFindOption(options, "Grab another handful")
    local leave = grab and self:HalloweenFindOptionPart(options, "leave") or nil
    if grab and leave then
        local tracker = self.HalloweenGreedy
        if not tracker or os.clock() - (tracker.SeenAt or 0) > 30 then
            tracker = { Count = 0, LastAt = 0, SeenAt = os.clock() }
            self.HalloweenGreedy = tracker
        end
        tracker.SeenAt = os.clock()
        if tracker.Count == 0 and grab.Lower == "grab another handful" then
            local amount = tonumber(leave.Label:match("(%d+)")) or 15
            tracker.Count = math.clamp(math.floor(amount / 15 + 0.5), 1, 9)
        end
        local want = tonumber(self.Config["Halloween Greedy Grabs"]) or 4
        if tracker.Count < want then
            if os.clock() - tracker.LastAt < 1.35 then return "wait" end
            tracker.Count += 1
            tracker.LastAt = os.clock()
            return grab
        end
        tracker.Count = 0
        return leave
    end
    local candyOpt = self:HalloweenFindOption(options, "Just the candy, please")
    local rollOpt = self:HalloweenFindOption(options, "One free roll!")
    if candyOpt and rollOpt then
        return self.Config["Halloween Free Roll"] == "One free roll (troll)" and rollOpt or candyOpt
    end
    local begOpt = self:HalloweenFindOptionPart(options, "can you spare any")
    local robFruit = self:HalloweenFindOption(options, "Give me those fruits!")
    if begOpt and robFruit then
        return self.Config["Halloween Fruit Dealer"] == "Rob (fish slap)" and robFruit or begOpt
    end
    local helpOpt = self:HalloweenFindOption(options, "Help fix the car")
    local robCar = self:HalloweenFindOption(options, "Hand over the candy you stole")
    if helpOpt and robCar then
        if self.Config["Halloween Sweet Ride"] == "Help fix car (push wheel)" then
            self.HalloweenSweetHelp = true
            return helpOpt
        end
        return robCar
    end
    local playOpt = self:HalloweenFindOption(options, "Play matching!")
    if playOpt and nevermind then
        if self.Config["Halloween Tarot"] == "Nevermind (skip)" then return nevermind end
        self.HalloweenTarotArmed = true
        self.HalloweenTarotWasOpen = false
        self.HalloweenTarotKnown = {}
        return playOpt
    end
    local inOpt = self:HalloweenFindOption(options, "I'm in!")
    if inOpt and nevermind then
        if self.Config["Halloween Mystery Solver"] then
            self.HalloweenMystery = nil
            self.HalloweenMysteryPending = os.clock() + 30
            return inOpt
        end
        return nevermind
    end
    local mysteryLive = (self.HalloweenMystery and self.HalloweenMystery.Active)
        or os.clock() < (self.HalloweenMysteryPending or 0)
        or Services.Workspace:FindFirstChild("MysteryHall") ~= nil
    if mysteryLive and self.Config["Halloween Mystery Solver"] then
        local answer = self:HalloweenMysteryAnswer(options, text)
        if answer then self.HalloweenMysteryGuess = nil; return answer end
        local known = lowerText:find("which room did the", 1, true) or lowerText:find("last to enter room", 1, true)
            or lowerText:find("which doors did the", 1, true) or lowerText:find("here before", 1, true)
        local looksQuestion = known or (text and text:find("?", 1, true) and #options >= 2)
        if looksQuestion and #options > 0 then
            local parts = { lowerText }
            for _, entry in ipairs(options) do table.insert(parts, entry.Lower) end
            local key = table.concat(parts, "|")
            local guess = self.HalloweenMysteryGuess
            if not guess or guess.Key ~= key then
                guess = { Key = key, At = os.clock(), Entry = options[math.random(1, #options)] }
                self.HalloweenMysteryGuess = guess
            end
            if os.clock() - guess.At >= 2.5 then
                for _, entry in ipairs(options) do
                    if entry == guess.Entry or entry.Label == guess.Entry.Label then
                        self:HalloweenStatus("Mystery Hall | No confident answer; guessing to continue")
                        return entry
                    end
                end
                guess.Entry = options[math.random(1, #options)]
                return guess.Entry
            end
            return "wait"
        end
    end

    local graves = {}
    for _, entry in ipairs(options) do
        if entry.Lower:sub(1, 6) == "grave " then table.insert(graves, entry) end
    end
    if #graves > 0 then return graves[math.random(1, #graves)] end
    local focusOpt = self:HalloweenFindOption(options, "Focus more power!")
    if focusOpt then return focusOpt end
    local celestial = self:HalloweenFindOption(options, "Celestial (Right)")
    local oni = self:HalloweenFindOption(options, "Oni (Left)")
    if celestial and oni then
        return self.Config["Halloween Blessing"] == "Oni (Left)" and oni or celestial
    end
    return nil
end

function Hub:HalloweenStrike(model, position)
    local char, _, root = self:Character()
    if not root or not position then return false end
    if os.clock() < (self.HalloweenStrikeAt or 0) then return true end
    self.HalloweenStrikeAt = os.clock() + 0.4
    local flat = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
    if flat.Magnitude > 0.2 then
        pcall(function() root.CFrame = CFrame.lookAt(root.Position, root.Position + flat) end)
    end
    local tool = self:SelectTool() or (char and char:FindFirstChildOfClass("Tool"))
    if not tool then return false end
    if self:IsFruitTool(tool) then
        self:NativeFruitM1(tool, model)
    else
        self:NativeM1(tool, model)
    end
    self.AttackTarget = nil
    return true
end

function Hub:HalloweenGhostPosition(door)
    local leg = door:GetAttribute("GhostLeg")
    if type(leg) ~= "string" then return nil end
    local values = {}
    for value in leg:gmatch("[^,]+") do table.insert(values, tonumber(value)) end
    if #values < 8 or not values[7] or not values[8] or values[8] <= values[7] then return nil end
    local alpha = math.clamp((Services.Workspace:GetServerTimeNow() - 0.2 - values[7]) / (values[8] - values[7]), 0, 1)
    local eased = math.sin(alpha * math.pi / 2)
    return Vector3.new(values[1], values[2], values[3]):Lerp(Vector3.new(values[4], values[5], values[6]), eased)
end

function Hub:HalloweenGhostStep()
    local entry = self:HalloweenCurrentDoorEntry()
    if not entry then return false end
    local door = entry.Door
    local _, _, root = self:Character()
    if not root then return false end
    if door:GetAttribute("GhostState") == "Fleeing" then
        local folder = Services.Workspace:FindFirstChild("GhostChase")
        local model = folder and folder:FindFirstChild("ChaseGhost") or nil
        local position = self:HalloweenGhostPosition(door)
        if not position and model then
            local cf = Compat.cframe(model)
            position = cf and cf.Position or nil
        end
        if position then
            local hits = door:GetAttribute("GhostHits") or 0
            if (root.Position - position).Magnitude > 7 then
                self:HalloweenStatus("Ghost Chase | Chasing ghost (" .. tostring(hits) .. "/3 hits)")
                self:MoveTo(CFrame.new(position + Vector3.new(0, 3, 0)))
            else
                self:CancelMove()
                self:HalloweenStatus("Ghost Chase | Hitting ghost (" .. tostring(hits) .. "/3 hits)")
                self:HalloweenStrike(model, position)
            end
            return true
        end
    end
    local best, bestDistance
    pcall(function()
        for key, value in pairs(door:GetAttributes()) do
            if type(key) == "string" and key:sub(1, 11) == "GhostCandy_" and typeof(value) == "Vector3" then
                local distance = (root.Position - value).Magnitude
                if not bestDistance or distance < bestDistance then best, bestDistance = value, distance end
            end
        end
    end)
    if best then
        local flat = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(best.X, 0, best.Z)).Magnitude
        if flat <= 6 and math.abs(root.Position.Y - best.Y) <= 12 then
            self:CancelMove()
            self:HalloweenStatus("Ghost Chase | Collecting dropped candy")
        else
            self:HalloweenStatus("Ghost Chase | Moving to dropped candy")
            self:MoveTo(CFrame.new(best + Vector3.new(0, 3, 0)))
        end
        return true
    end
    return false
end

function Hub:HalloweenSweetStep()
    if not self.HalloweenSweetHelp and self.Config["Halloween Sweet Ride"] ~= "Help fix car (push wheel)" then return false end
    local folder = Services.Workspace:FindFirstChild("SweetRide")
    if not folder then self.HalloweenSweetHelp = false; return false end
    local wheel = folder:FindFirstChild("FR")
    if not wheel or not wheel:IsA("BasePart") then return false end
    local entry = self:HalloweenCurrentDoorEntry()
    local doorPart = entry and entry.Door and entry.Door:FindFirstChild("Part") or nil
    if not doorPart or not doorPart:IsA("BasePart") then return false end
    local _, humanoid, root = self:Character()
    if not humanoid or not root then return false end
    local localCenter = doorPart.CFrame:PointToObjectSpace(wheel.Position)
    if localCenter.Z > -1.4 and localCenter.Z < 1.4 and math.abs(localCenter.X) < doorPart.Size.X / 2 - 0.3 and localCenter.Y < doorPart.Size.Y / 2 then
        pcall(function() humanoid:MoveTo(root.Position) end)
        self.HalloweenSweetHelp = false
        self:HalloweenStatus("Sweet Ride | Wheel delivered")
        return true
    end
    self:CancelMove()
    pcall(function() humanoid.AutoRotate = true end)
    local radius = wheel.Size.Y / 2
    local toDoor = doorPart.Position - wheel.Position
    toDoor = Vector3.new(toDoor.X, 0, toDoor.Z)
    if toDoor.Magnitude < 0.1 then return true end
    toDoor = toDoor.Unit
    local behind = wheel.Position - toDoor * (radius + 1.1)
    local flatRoot = Vector3.new(root.Position.X, 0, root.Position.Z)
    local flatBehind = Vector3.new(behind.X, 0, behind.Z)
    if (flatRoot - flatBehind).Magnitude > 1.5 then
        pcall(function() humanoid:MoveTo(behind) end)
        self:HalloweenStatus("Sweet Ride | Getting behind the wheel")
    else
        pcall(function() humanoid:MoveTo(doorPart.Position) end)
        self:HalloweenStatus("Sweet Ride | Pushing wheel to the door")
    end
    return true
end

function Hub:HalloweenResetCharacter(reason)
    local character, humanoid = self:Character()
    if not character or not humanoid then return false end
    if self.HalloweenResetCharacterFor == character and os.clock() - (self.HalloweenResetCharacterAt or 0) < 12 then return true end
    self.HalloweenResetCharacterFor, self.HalloweenResetCharacterAt = character, os.clock()
    self:CancelMove()
    self:HalloweenStatus((reason or "Boss defeated") .. " | Resetting character to leave the arena")
    pcall(function() character:BreakJoints() end)
    pcall(function() humanoid.Health = 0 end)
    pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Dead) end)
    return true
end

function Hub:HalloweenActiveBossDoor()
    local _, _, root = self:Character()
    local best, bestDistance
    for _, entry in ipairs(self:HalloweenDoors()) do
        if entry.Door:GetAttribute("BOSS_ACTIVE_SERVER") == true then
            entry.CFrame = Compat.cframe(entry.Door) or entry.CFrame
            if entry.CFrame then
                local distance = root and (root.Position - entry.CFrame.Position).Magnitude or 0
                if not bestDistance or distance < bestDistance then best, bestDistance = entry, distance end
            end
        end
    end
    return best
end

function Hub:HalloweenBossDoorStep()
    local _, _, root = self:Character()
    if not root then return false end
    local hellfire = self:HalloweenInHellfireRealm()
    local session = self.HalloweenBossSession
    if not session and not hellfire then
        local activeEntry = self:HalloweenActiveBossDoor()
        if activeEntry then
            local current = self.HalloweenCurrentDoor
            local ownDoor = current and current.Door == activeEntry.Door
            local currentOpen = current and current.Door and current.Door.Parent and current.Door ~= activeEntry.Door
                and current.Door:GetAttribute("DoorOpen") == true
            if (self.Config["Halloween Boss Priority"] or ownDoor) and not currentOpen then
                self.HalloweenCurrentDoor = activeEntry
                self:HalloweenBossSessionStart(activeEntry)
                session = self.HalloweenBossSession
                self:HalloweenStatus("Boss Door | Traveling to the active boss door")
            end
        end
    end
    if not session then
        if hellfire and not self:HalloweenEnemy() then
            if self.HalloweenHellfireSawBoss then
                self.HalloweenHellfireIdleSince = self.HalloweenHellfireIdleSince or os.clock()
                if os.clock() - self.HalloweenHellfireIdleSince > 6 then
                    self:HalloweenResetCharacter("Hellfire Boss")
                    return true
                end
            end
            self:HalloweenStatus("Hellfire Boss | Waiting in the realm")
            return true
        end
        self.HalloweenHellfireIdleSince, self.HalloweenHellfireSawBoss = nil, nil
        return false
    end
    if not session.Door or not session.Door.Parent then self.HalloweenBossSession = nil; return false end
    if os.clock() - session.Started > 300 and not session.SawBoss then self.HalloweenBossSession = nil; return false end
    local active = session.Door:GetAttribute("BOSS_ACTIVE_SERVER") == true
    if hellfire then
        if session.SawBoss and not self:HalloweenEnemy() then
            session.IdleSince = session.IdleSince or os.clock()
            local idleFor = os.clock() - session.IdleSince
            if (not active and idleFor > 4) or idleFor > 25 then
                self:HalloweenResetCharacter("Hellfire Boss")
                return true
            end
        else
            session.IdleSince = nil
        end
        self:HalloweenStatus("Hellfire Boss | Waiting for Hellfire Gas")
        return true
    end
    if not active then
        if session.SawBoss then self.HalloweenBossSession = nil; return false end
        if os.clock() - session.Started > 60 then self.HalloweenBossSession = nil; return false end
        self:HalloweenStatus("Boss Door | Waiting for the boss portal")
        return true
    end
    if os.clock() < session.EnterAt then
        self:HalloweenStatus("Boss Door | Waiting for the boss portal")
        return true
    end
    local part = session.Door:FindFirstChild("Part")
    if part and part:IsA("BasePart") then
        local portal = part.CFrame * CFrame.new(0, 2, -(part.Size.Z / 2 + 0.5))
        if (root.Position - portal.Position).Magnitude > 2.5 then
            session.PortalSince = nil
            self:HalloweenStatus("Boss Door | Entering the boss portal")
            self:MoveTo(portal)
        else
            session.PortalSince = session.PortalSince or os.clock()
            self:CancelMove()
            if os.clock() - session.PortalSince > 2.5 then
                local _, humanoid = self:Character()
                if humanoid then pcall(function() humanoid:MoveTo(part.Position) end) end
                self:HalloweenStatus("Boss Door | Walking into the boss portal")
            else
                self:HalloweenStatus("Boss Door | Entering boss realm")
            end
        end
        return true
    end
    self:HalloweenStatus("Boss Door | Door part unavailable")
    return true
end

function Hub:HalloweenCandySpillStep(forceArena)
    if not forceArena and not self.Config["Halloween Auto Collect"] then return false end
    local _, _, root = self:Character()
    if not root then return false end
    self.HalloweenSpillSkips = self.HalloweenSpillSkips or {}
    local folders = {}
    pcall(function() folders = Services.CollectionService:GetTagged("HalloweenCandySpill") end)
    local best, bestDistance, bestReach, bestKey
    for _, folder in ipairs(folders) do
        local owner
        pcall(function() owner = folder:GetAttribute("SpillOwner") end)
        local mine = owner == Player.UserId or owner == Player.Name
        if mine or owner == nil then
            pcall(function()
                for key, value in pairs(folder:GetAttributes()) do
                    if typeof(value) == "Vector3" and type(key) == "string" then
                        local reach
                        if key:sub(1, 6) == "Chest_" then reach = 9
                        elseif key:sub(1, 6) == "Candy_" then reach = 7 end
                        if reach then
                            local pieceKey = folder.Name .. "|" .. key
                            local skipUntil = not forceArena and self.HalloweenSpillSkips[pieceKey] or nil
                            if not skipUntil or os.clock() >= skipUntil then
                                local distance = (root.Position - value).Magnitude
                                local maxDistance = mine and 1200 or 250
                                if distance <= maxDistance and (not bestDistance or distance < bestDistance) then
                                    best, bestDistance, bestReach, bestKey = value, distance, reach, pieceKey
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
    if not best then
        self.HalloweenSpillWaitKey = nil
        self.HalloweenSpillPursueKey = nil
        return false
    end
    local flat = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(best.X, 0, best.Z)).Magnitude
    if flat <= bestReach and math.abs(root.Position.Y - best.Y) <= 14 then
        self.HalloweenSpillPursueKey = nil
        if self.HalloweenSpillWaitKey ~= bestKey then
            self.HalloweenSpillWaitKey, self.HalloweenSpillWaitAt = bestKey, os.clock()
        end
        if not forceArena and os.clock() - (self.HalloweenSpillWaitAt or 0) > 5 then
            self.HalloweenSpillSkips[bestKey] = os.clock() + 60
            self.HalloweenSpillWaitKey = nil
            return false
        end
        self:CancelMove()
        self:HalloweenStatus("Candy Spill | Collecting spilled candy")
        return true
    end
    self.HalloweenSpillWaitKey = nil
    if self.HalloweenSpillPursueKey ~= bestKey then
        self.HalloweenSpillPursueKey, self.HalloweenSpillPursueAt = bestKey, os.clock()
    end
    if not forceArena and os.clock() - (self.HalloweenSpillPursueAt or 0) > 20 then
        self.HalloweenSpillSkips[bestKey] = os.clock() + 60
        self.HalloweenSpillPursueKey = nil
        return false
    end
    self:HalloweenStatus("Candy Spill | Moving to spilled candy")
    self:MoveTo(CFrame.new(best + Vector3.new(0, 3, 0)))
    return true
end

function Hub:HalloweenPumpkinHitPart(model)
    if not (model and model.Parent) then return nil end
    self.HalloweenPumpkinParts = self.HalloweenPumpkinParts or setmetatable({}, { __mode = "k" })
    local cached = self.HalloweenPumpkinParts[model]
    if cached and cached.Parent then return cached end
    local part = model.PrimaryPart
    if not Compat.isA(part, "BasePart") then
        part = nil
        local bestVolume = -1
        for _, object in ipairs(model:GetDescendants()) do
            if object:IsA("BasePart") then
                local volume = object.Size.X * object.Size.Y * object.Size.Z
                if volume > bestVolume then part, bestVolume = object, volume end
            end
        end
    end
    self.HalloweenPumpkinParts[model] = part
    return part
end

function Hub:HalloweenPumpkinStrike(model, position)
    local char, _, root = self:Character()
    if not root or not model or not model.Parent then return false end
    local part = self:HalloweenPumpkinHitPart(model)
    if not part then return false end
    local flat = Vector3.new(part.Position.X - root.Position.X, 0, part.Position.Z - root.Position.Z)
    if flat.Magnitude > 0.2 then
        pcall(function() root.CFrame = CFrame.lookAt(root.Position, root.Position + flat) end)
    end
    local tool = (char and char:FindFirstChildOfClass("Tool")) or self:SelectTool()
    if not tool then return false end
    if self:IsFruitTool(tool) and not self:FruitHasTap(tool) and not self:NativeWeaponData(tool) then
        local melee = self:SelectToolKind("Melee") or self:SelectToolKind("Sword")
        if melee then tool = melee end
    end
    if self:IsFruitTool(tool) then
        if self:NativeFruitM1(tool, model) then return true end
        self:NativeM1(tool, model)
        return true
    end
    if not self:IsBackpackWeapon(tool) then
        self:NativeM1(tool, model)
        return true
    end
    if os.clock() < (self.HalloweenPumpkinHitAt or 0) then return true end
    self.HalloweenPumpkinHitAt = os.clock() + (self.Config["Fast Rate"] or 0.036)
    local transport, reason = self:FastTransport()
    if not transport then
        self:Log("pumpkin-fast", reason, 8)
        self:NativeM1(tool, model)
        return true
    end
    self:InstallAimAdapter()
    self.AttackTarget = model
    local range = self.Config["Fast Range"] or 60
    local extras = {}
    local folder = Services.Workspace:FindFirstChild("PumpkinHunt")
    for _, other in ipairs(folder and folder:GetChildren() or {}) do
        if other ~= model and other:IsA("Model") and #extras < 9 then
            local state = other:GetAttribute("PumpkinState")
            local isPatch = other.Name == "PumpkinPatch" or other:GetAttribute("PumpkinRare") == true
            if state == "Idle" or (isPatch and state == nil) then
                local otherPart = self:HalloweenPumpkinHitPart(other)
                if otherPart and (otherPart.Position - root.Position).Magnitude <= range then
                    extras[#extras + 1] = { other, otherPart }
                end
            end
        end
    end
    local combo = transport.Mode == "Auto" and self:FastComboIndex(tool) or nil
    local ok, problem = pcall(function()
        if combo then transport.Attack:FireServer(0.43, combo) else transport.Attack:FireServer(0.43) end
        if transport.Send then transport.Send(part, extras) else transport.Hit:FireServer(part, extras) end
    end)
    if ok then
        self.FastBatches = (self.FastBatches or 0) + 1
        self.FastLastBatch = os.clock()
        self.CombatLockAt = os.clock()
    else
        self:Log("pumpkin-fast", problem, 8)
        self:NativeM1(tool, model)
    end
    return true
end

function Hub:HalloweenPumpkinStep(maxDistance, patchOnly, force)
    if not force and not self.Config["Halloween Auto Collect"] then return false end
    local folder = Services.Workspace:FindFirstChild("PumpkinHunt")
    if not folder then return false end
    local _, _, root = self:Character()
    if not root then return false end
    local best, bestPosition, bestDistance, bestPatch
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") then
            local isPatch = model.Name == "PumpkinPatch" or model:GetAttribute("PumpkinRare") == true
            local state = model:GetAttribute("PumpkinState")
            if (state == "Idle" or (isPatch and state == nil)) and (isPatch or not patchOnly) then
                local cf = Compat.cframe(model)
                if not cf then
                    local part = model:FindFirstChildWhichIsA("BasePart", true)
                    cf = part and part.CFrame or nil
                end
                if cf then
                    local distance = (root.Position - cf.Position).Magnitude
                    if distance <= (maxDistance or 1200) then
                        local better = best == nil or (isPatch and not bestPatch) or (isPatch == bestPatch and distance < bestDistance)
                        if better then best, bestPosition, bestDistance, bestPatch = model, cf.Position, distance, isPatch end
                    end
                end
            end
        end
    end
    if not best then return false end
    self.HalloweenPumpkinTrack = self.HalloweenPumpkinTrack or setmetatable({}, { __mode = "k" })
    local track = self.HalloweenPumpkinTrack[best]
    if not track then
        track = { Hits = best:GetAttribute("PumpkinHits") or 0, Close = false }
        self.HalloweenPumpkinTrack[best] = track
    end
    local hitsNow = best:GetAttribute("PumpkinHits") or 0
    if hitsNow ~= track.Hits then track.Hits, track.StrikingSince = hitsNow, os.clock() end
    local strikeRange = track.Close and 9 or (self.Config["Fast Range"] or 60)
    if bestDistance > strikeRange then
        track.StrikingSince = nil
        self:HalloweenStatus(bestPatch and "Pumpkin Hunt | Moving to stacked Pumpkin Patch" or "Pumpkin Hunt | Moving to a wild pumpkin")
        self:MoveTo(CFrame.new(bestPosition + Vector3.new(0, 3, 0)))
    else
        self:CancelTween(false)
        self:HalloweenHold()
        self.HalloweenPumpkinSpot = { Position = bestPosition, At = os.clock() }
        self:HalloweenStatus((bestPatch and "Pumpkin Hunt | Cracking stacked Pumpkin Patch (" or "Pumpkin Hunt | Cracking pumpkin (") .. tostring(hitsNow) .. "/3 hits)")
        if track.Close then
            self:HalloweenStrike(best, bestPosition)
        else
            track.StrikingSince = track.StrikingSince or os.clock()
            self:HalloweenPumpkinStrike(best, bestPosition)
            if os.clock() - track.StrikingSince > 3 then track.Close = true end
        end
    end
    return true
end

