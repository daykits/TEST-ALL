local function getInventoryString()

	local root = getStatsRoot()

	local inv = root and root:FindFirstChild("Inventory")

	if not inv then return "" end

	local ok, value = pcall(function()

		return inv.Value

	end)

	if ok and value ~= nil then

		return tostring(value)

	end

	local parts = {}

	for _, obj in ipairs(inv:GetDescendants()) do

		table.insert(parts, tostring(obj.Name))

		local ok2, v = pcall(function()

			return obj.Value

		end)

		if ok2 and v ~= nil then

			table.insert(parts, tostring(v))

		end

	end

	return table.concat(parts, " ")

end

local function hasInventoryItem(itemName)

	itemName = tostring(itemName or "")

	if itemName == "" then return false end

	local root = getStatsRoot()

	local inv = root and root:FindFirstChild("Inventory")

	if inv then

		if inv:FindFirstChild(itemName, true) then

			return true

		end

		for _, obj in ipairs(inv:GetDescendants()) do

			if tostring(obj.Name):lower() == itemName:lower() then

				return true

			end

			local ok, v = pcall(function()

				return obj.Value

			end)

			if ok and tostring(v):lower():find(itemName:lower(), 1, true) then

				return true

			end

		end

	end

	return string.find(getInventoryString():lower(), itemName:lower(), 1, true) ~= nil

end

