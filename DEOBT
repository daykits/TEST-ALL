function Hub:HalloweenGoCauldron(auto, force)
    local _, cf = self:HalloweenDapperCauldron()
    if not cf then return true end
    local _, _, root = self:Character()
    if not root then return false end
    if (root.Position - cf.Position).Magnitude <= 15 then return true end
    local reached = self:MoveUntil(cf + Vector3.new(0, 3, 0), function()
        if not self.Alive then return false end
        if auto and not self:HalloweenAutoOn() then return false end
        if force then return true end
        return self:HalloweenEnemy() == nil
    end, 25)
    return reached == true
end

function Hub:HalloweenEnterRitualPortal(manual)
    local function waitForBoss()
        self:HalloweenStatus("Great Pumpkin | Inside arena; waiting for Dapper Jack")
        if not manual then return true end
        local deadline = os.clock() + 30
        while self.Alive and os.clock() < deadline do
            local found = self:HalloweenBossEnemy() or self:HalloweenEnemy()
            if found then return self:HalloweenFightBoss(found, true) end
            task.wait(0.5)
        end
        return true
    end
    local boss
    if self:HalloweenInDapperArena() then
        boss = self:HalloweenBossEnemy()
        if boss then return self:HalloweenFightBoss(boss, manual) end
        return waitForBoss()
    end
    local liveBoss = self:HalloweenBossEnemy()
    if (liveBoss and liveBoss.Name:lower():find("dapper", 1, true)) or self:HalloweenPortalOpen() then self.HalloweenArenaDoneFor = nil end
    if not manual and self.HalloweenArenaDoneFor ~= nil then
        local startValue = self:HalloweenRitualStart()
        local sameSession
        if self.HalloweenArenaDoneFor == false or startValue == nil then
            sameSession = os.clock() - (self.HalloweenArenaDoneAt or 0) < 60
        else
            sameSession = startValue == self.HalloweenArenaDoneFor
        end
        if sameSession then
            self:HalloweenStatus("Great Pumpkin | Arena already cleared; waiting for a new ritual")
            return false
        end
        self.HalloweenArenaDoneFor = nil
    end
    local spot = self:HalloweenDapperSpot()
    if not spot then
        local reached, problem = self:HalloweenGoNPC("Witch", not manual, true)
        if not reached then reached, problem = self:HalloweenGoNPC("Halloween Witch", not manual, true) end
        if not reached then
            self.HalloweenRitualNext = os.clock() + 60
            self:HalloweenStatus("Great Pumpkin | " .. tostring(problem or "Travel failed"))
            return false
        end
        spot = self:HalloweenDapperSpot()
    end
    if not spot then
        self.HalloweenRitualNext = os.clock() + 30
        self:HalloweenStatus("Great Pumpkin | Gateway spot unavailable in this place")
        if manual then self:Notify("Great Pumpkin", "DapperJackGateway spot and cauldron were not found in this place.") end
        return false
    end
    local _, _, root = self:Character()
    if not root then return false end
    if (root.Position - spot).Magnitude > 14 then
        self:HalloweenStatus("Great Pumpkin | Going to the gateway vortex")
        local reached = self:MoveUntil(CFrame.new(spot + Vector3.new(0, 3, 0)), function()
            if not self.Alive then return false end
            if not manual and not self:HalloweenAutoOn() then return false end
            return not self:HalloweenInDapperArena()
        end, 45)
        if self:HalloweenInDapperArena() then return waitForBoss() end
        if not reached then return false end
    end
    if not manual and os.clock() < (self.HalloweenDapperRetryAt or 0) then return true end
    local prompt
    local deadline = os.clock() + (manual and 45 or 25)
    while self.Alive and os.clock() < deadline do
        if not manual and not self:HalloweenAutoOn() then return false end
        if self:HalloweenInDapperArena() then return waitForBoss() end
        prompt = self:HalloweenDapperPrompt()
        if prompt then
            local promptCFrame = Compat.cframe(prompt.Parent)
            local _, _, promptRoot = self:Character()
            local range = math.min(prompt.MaxActivationDistance or 10, 10)
            if promptCFrame and promptRoot and (promptRoot.Position - promptCFrame.Position).Magnitude > range then
                self:HalloweenStatus("Great Pumpkin | Going to the gateway vortex")
                self:MoveUntil(promptCFrame + Vector3.new(0, 2, 0), function()
                    return self.Alive and not self:HalloweenInDapperArena()
                end, 12)
                if self:HalloweenInDapperArena() then return waitForBoss() end
            end
            if prompt.Enabled then break end
            self:HalloweenHold()
            self:HalloweenStatus("Great Pumpkin | Waiting for the Enter prompt")
            prompt = nil
        elseif not self:HalloweenDapperActive() then
            self:HalloweenStatus("Great Pumpkin | Gateway not active yet")
            if not manual then
                self.HalloweenDapperRetryAt = os.clock() + 5
                return true
            end
        else
            self:HalloweenStatus("Great Pumpkin | Waiting for the Enter prompt")
            local liveSpot = self:HalloweenDapperSpot()
            local _, _, liveRoot = self:Character()
            if liveSpot and liveRoot and (liveRoot.Position - liveSpot).Magnitude > 10 then
                self:MoveUntil(CFrame.new(liveSpot + Vector3.new(0, 3, 0)), function()
                    return self.Alive and not self:HalloweenInDapperArena()
                end, 12)
                if self:HalloweenInDapperArena() then return waitForBoss() end
            else
                self:HalloweenHold()
            end
        end
        task.wait(0.4)
    end
    if not prompt then
        self.HalloweenDapperRetryAt = os.clock() + 5
        self:HalloweenStatus("Great Pumpkin | Enter prompt not ready")
        return true
    end

    if os.clock() < (self.HalloweenDapperEnterAt or 0) then return true end
    self.HalloweenDapperEnterAt = os.clock() + 8
    self:CancelMove()
    if not self:FirePrompt(prompt) then
        self:HalloweenStatus("Great Pumpkin | Executor needs fireproximityprompt")
        return true
    end
    self:HalloweenStatus("Great Pumpkin | Entering the crater")
    deadline = os.clock() + 14
    while self.Alive and os.clock() < deadline do
        if self:HalloweenInDapperArena() then return waitForBoss() end
        task.wait(0.3)
    end
    self.HalloweenDapperRetryAt = os.clock() + 5
    self:HalloweenStatus("Great Pumpkin | Entry did not teleport; retrying")
    return true
end


function Hub:HalloweenGreatPumpkinStep(manual)
    if self.HalloweenRitualBusy then return true end
    if not manual and not self.Config["Auto Great Pumpkin"] then return false end
    if not self:HalloweenActive() then
        if manual then self:Notify("Halloween", "Halloween event is not active.") end
        return false
    end
    if not manual and os.clock() < (self.HalloweenRitualNext or 0) then
        if self:HalloweenDapperActive() or self:HalloweenInDapperArena() then
            return self:HalloweenEnterRitualPortal(false)
        end
        return false
    end
    local boss = self:HalloweenBossEnemy()
    if boss and boss.Name:lower():find("dapper", 1, true) then
        if not self:HalloweenInDapperArena() then return self:HalloweenEnterRitualPortal(manual) end
        return self:HalloweenFightBoss(boss, manual)
    end
    self.HalloweenRitualBusy = true
    local function finish(value)
        self.HalloweenRitualBusy = false
        return value
    end
    local status, problem = self:HalloweenRitualStatus(manual == true)
    if not status then
        self.HalloweenRitualNext = os.clock() + 30
        self:HalloweenStatus("Great Pumpkin | " .. tostring(problem or "Status unavailable"))
        if manual then self:Notify("Great Pumpkin", tostring(problem or "Status unavailable.")) end
        return finish(false)
    end
    self.HalloweenRitualActive = status.Active == true or self:HalloweenDapperActive()
    if status.Active ~= true then self.HalloweenArenaDoneFor = nil end
    if status.Open ~= true then
        self.HalloweenRitualNext = os.clock() + 120
        self:HalloweenStatus("Great Pumpkin | Crater sealed")
        return finish(false)
    end
    if status.Active == true then
        self.HalloweenRitualNext = os.clock() + 15
        local result = self:HalloweenEnterRitualPortal(manual)
        return finish(result)
    end
    if status.Busy == true then
        self.HalloweenRitualNext = os.clock() + 15
        self:HalloweenStatus("Great Pumpkin | Ritual brewing")
        return finish(false)
    end
    if not self:HalloweenRitualAffordable(status) then
        self.HalloweenRitualNext = os.clock() + 8
        self:HalloweenStatus("Great Pumpkin | Need " .. tostring(status.CostText or "ritual ingredients"))
        return finish(false)
    end
    local atWitch = self:HalloweenGoNPC("Witch", not manual, true)
    if not atWitch then atWitch = self:HalloweenGoNPC("Halloween Witch", not manual, true) end
    local atCauldron = self:HalloweenGoCauldron(not manual, true)
    if not atWitch and not atCauldron then
        self.HalloweenRitualNext = os.clock() + 20
        self:HalloweenStatus("Great Pumpkin | Witch/cauldron unavailable in this place")
        if manual then self:Notify("Great Pumpkin", "Witch and cauldron were not found in this place.") end
        return finish(false)
    end
    local dialogue = self:Module("HalloweenWitchDialogue", { "DialoguesList", "NPCs", "HalloweenWitch" })
    local dialogueRan = false
    if dialogue then
        local ok = self:HalloweenRunDialogue(dialogue, { "here, take them", "i want to fight the great pumpkin" }, 25)
        dialogueRan = ok == true
    end
    local after = self:HalloweenRitualStatus(true)
    if after and after.Active == true then
        local result = self:HalloweenEnterRitualPortal(manual)
        return finish(result)
    end
    if not dialogueRan then
        local result = self:HalloweenRitualSummon()
        if result == "Started" or result == "Active" then
            after = self:HalloweenRitualStatus(true)
            if after and after.Active == true then
                local entered = self:HalloweenEnterRitualPortal(manual)
                return finish(entered)
            end
            self.HalloweenRitualNext = os.clock() + 8
            self:HalloweenStatus("Great Pumpkin | Ritual started")
            return finish(true)
        end
        self:HalloweenStatus("Great Pumpkin | Summon returned " .. tostring(result or "unavailable"))
    end
    self.HalloweenRitualNext = os.clock() + (after and after.Busy == true and 8 or 30)
    self:HalloweenStatus(after and after.Busy == true and "Great Pumpkin | Ritual brewing" or "Great Pumpkin | Summon pending")
    return finish(true)
end

function Hub:HalloweenGreatPumpkin()
    self:HalloweenGreatPumpkinStep(true)
end

function Hub:HalloweenHasPumpkinPatch()
    local folder = Services.Workspace:FindFirstChild("PumpkinHunt")
    if folder then
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") and (model.Name == "PumpkinPatch" or model:GetAttribute("PumpkinRare") == true) then
                return true
            end
        end
    end
    local enemies = Services.Workspace:FindFirstChild("Enemies")
    for _, model in ipairs(enemies and enemies:GetChildren() or {}) do
        if model.Name == "Pumpkin Snowman" and self:AliveEnemy(model) then return true end
    end
    return false
end

function Hub:HalloweenPatchHopStep()
    if not self.Config["Halloween Auto Hop Patch"] then
        self.HalloweenHopSince, self.HalloweenHopNotified = nil, nil
        return false
    end
    self.HalloweenHopJoinAt = self.HalloweenHopJoinAt or os.clock()
    if os.clock() - self.HalloweenHopJoinAt < 20 then return false end
    if os.clock() < (self.HalloweenHopCheckAt or 0) then return false end
    self.HalloweenHopCheckAt = os.clock() + 3
    local blocked = not self:HalloweenActive()
        or self:HalloweenInDapperArena() or self:HalloweenInHellfireRealm()
        or self.HalloweenBossSession ~= nil or self.HalloweenRitualActive == true
        or self:HalloweenPortalOpen() or self:HalloweenBossUp() or self:HalloweenBusy()
        or self.HalloweenGachaBusy or self.HalloweenRitualBusy
        or self.ManualBusy or self.ManualDestination ~= nil
    if blocked or self:HalloweenHasPumpkinPatch() then
        self.HalloweenHopSince, self.HalloweenHopNotified = nil, nil
        return false
    end
    local bits = self:ItemQuantity("Pumpkin Bits")
    local seeds = self:ItemQuantity("Cursed Pumpkin Seed")
    if type(bits) ~= "number" or type(seeds) ~= "number" or bits < 200 or seeds >= 3 then
        self.HalloweenHopSince, self.HalloweenHopNotified = nil, nil
        return false
    end
    local delay = math.clamp(tonumber(self.Config["Halloween Hop Delay"]) or 5, 0, 60) * 60
    if not self.HalloweenHopSince then
        self.HalloweenHopSince = os.clock()
        if not self.HalloweenHopNotified then
            self.HalloweenHopNotified = true
            self:Notify("Great Pumpkin", "Enough Pumpkin Bits but missing Cursed Pumpkin Seeds, and no Pumpkin Patch in this server. Hopping in " .. tostring(math.floor(delay / 60)) .. " min if none spawns - turn off Auto Hop to cancel.")
        end
        return false
    end
    local remaining = self.HalloweenHopSince + delay - os.clock()
    if remaining > 0 then
        if remaining <= 30 then
            self:HalloweenStatus("Great Pumpkin | No Pumpkin Patch: hopping in " .. math.ceil(remaining) .. "s")
        end
        return false
    end
    if self:HalloweenHasPumpkinPatch() then
        self.HalloweenHopSince, self.HalloweenHopNotified = nil, nil
        return false
    end
    self:HalloweenStatus("Great Pumpkin | Hopping server to find a Pumpkin Patch")
    if self:HopPublicServer("Great Pumpkin Patch", 45) then
        self.HalloweenHopSince = os.clock() + 600
        return true
    end
    self.HalloweenHopSince = os.clock() + 60 - delay
    self:Notify("Great Pumpkin", "Server hop failed (server browser unavailable); retrying in 60s.")
    return false
end

function Hub:HalloweenGreatPumpkinFarmStep()
    local _, _, root = self:Character()
    if not root then return end
    if self:HalloweenCloseGachaUI() then return end
    if self:HalloweenBreakFreeStep() then return end
    local inDialogue = self:HalloweenDialogue()
    if not inDialogue and not self:HalloweenInDapperArena() then
        if (self:HalloweenPortalOpen() or self.HalloweenRitualActive == true or self:HalloweenBossUp())
            and self:HalloweenEnterRitualPortal(false) then return end
    end
    if self.HalloweenRitualBossSeen then
        self.HalloweenRitualBossSeen = false
        self.HalloweenRitualActive = false
        self.HalloweenRitualStatusCache, self.HalloweenRitualStatusUntil = nil, nil
        self.HalloweenRitualNext = 0
    end
    if self:HalloweenInDapperArena() then
        local arenaEnemy = self:HalloweenEnemy()
        if not arenaEnemy then
            local boss = self:HalloweenBossEnemy()
            if boss and boss.Name:lower():find("dapper", 1, true) then arenaEnemy = boss end
        end
        if arenaEnemy then
            self.HalloweenArenaSawBoss = true
            self:HalloweenStatus("Fighting " .. arenaEnemy.Name)
            self:Fight(arenaEnemy, arenaEnemy.Name, false)
            return
        end
        self:HalloweenDapperStep()
        if not self.HalloweenArenaExiting then self:HalloweenHold() end
        return
    end
    self:HalloweenDapperStep()
    if inDialogue then
        self:HalloweenHold()
        self:HalloweenStatus("Great Pumpkin | Dialogue")
        return
    end
    if self.HalloweenGachaBusy or self.HalloweenRitualBusy then return end
    if self.Config["Halloween Auto Gacha"] and os.clock() >= (self.HalloweenGachaNext or 0) and self:HalloweenGachaStep(false) then return end
    if self:HalloweenGreatPumpkinStep(false) then return end
    local enemy = self:HalloweenEnemy()
    if enemy then
        self:HalloweenStatus("Fighting " .. enemy.Name)
        self:Fight(enemy, enemy.Name, false)
        return
    end
    if self:HalloweenCandySpillStep() then return end
    if self:HalloweenPumpkinStep(math.huge, true, true) then return end
    if self:HalloweenPumpkinStep(math.huge, false, true) then return end
    if not self:HalloweenActive() then
        self:HalloweenStatus("Halloween event is not active")
        return
    end
    if self:HalloweenPortalStep(nil) then return end
    self:HalloweenStatus("Great Pumpkin | Searching for pumpkins (materials)")
end

function Hub:HalloweenHold()
    self.LastMoveRequest = os.clock()
    if not self.Tween then
        local _, _, root = self:Character()
        if root then pcall(function() root.AssemblyLinearVelocity = Vector3.zero end) end
    end
end

function Hub:HalloweenStep()
    local _, _, root = self:Character()
    if not root then return end
    if self:HalloweenCloseGachaUI() then return end
    if self:HalloweenTarotStep() then return end
    if self:HalloweenBreakFreeStep() then return end
    local inDialogue = self:HalloweenDialogue()
    local enemy = self:HalloweenEnemy()
    if not enemy and (self:HalloweenInDapperArena() or self:HalloweenInHellfireRealm()) then
        local boss = self:HalloweenBossEnemy()
        if boss and boss.Name:lower():find("dapper", 1, true) then enemy = boss end
    end
    if not enemy then self:HalloweenSpawnWait(nil) end
    if enemy then
        if self:HalloweenSpawnWait(enemy) then return end
        if self.HalloweenBossSession then self.HalloweenBossSession.SawBoss = true end
        if self:HalloweenInHellfireRealm() then self.HalloweenHellfireSawBoss = true; self.HalloweenHellfireIdleSince = nil end
        if self:HalloweenInDapperArena() then self.HalloweenArenaSawBoss = true end
        self:HalloweenStatus("Fighting " .. enemy.Name)
        self:Fight(enemy, enemy.Name, false)
        return
    end
    if self.HalloweenRitualBossSeen then
        self.HalloweenRitualBossSeen = false
        self.HalloweenRitualActive = false
        self.HalloweenRitualStatusCache, self.HalloweenRitualStatusUntil = nil, nil
        self.HalloweenRitualNext = 0
    end
    if self:HalloweenEventActionStep(inDialogue) then return end
    if inDialogue then
        self:HalloweenHold()
        self:HalloweenStatus("Door scene | Dialogue")
        return
    end
    if self:HalloweenBusy() then
        self:HalloweenHold()
        if os.clock() < (self.HalloweenKnockWaitUntil or 0) then
            self:HalloweenStatus("Knocked door | Waiting 3s for event")
        else
            self:HalloweenStatus("Door scene | Waiting for event")
        end
        return
    end
    if self.HalloweenGachaBusy or self.HalloweenRitualBusy then return end
    if self.HalloweenPortalWait and self:HalloweenPortalStep(nil) then return end
    if self.Config["Halloween Auto Gacha"] and os.clock() >= (self.HalloweenGachaNext or 0) and self:HalloweenGachaStep(false) then return end
    if self:HalloweenCandySpillStep() then return end
    if not self:HalloweenDapperActive() and self:HalloweenPumpkinStep(1500, true) then return end
    local doors = self:HalloweenDoors()
    if #doors == 0 then
        if self:HalloweenPumpkinStep(1500) then return end
        if self:HalloweenActive() and self:HalloweenPortalStep(nil) then return end
        self:HalloweenStatus(self:HalloweenActive() and "No doors found | Go to the Trick or Treat location" or "Halloween event is not active")
        return
    end
    local best, bestScore, nearest, nearestDistance
    for _, entry in ipairs(doors) do
        entry.CFrame = Compat.cframe(entry.Door) or entry.CFrame
        local raw = (root.Position - entry.CFrame.Position).Magnitude
        if nearestDistance == nil or raw < nearestDistance then nearest, nearestDistance = entry, raw end
        if self:HalloweenDoorReady(entry) then
            local score = raw
            if self.Config["Halloween Boss Priority"] and self:HalloweenBossDoor(entry) then score -= 100000 end
            if not bestScore or score < bestScore then best, bestScore = entry, score end
        end
    end
    if not best then
        if self:HalloweenPumpkinStep(1500) then return end
        if nearest and nearestDistance and nearestDistance > 2000 and self:HalloweenPortalStep(nearest) then return end
        self:HalloweenStatus("Waiting | All doors on cooldown (" .. #doors .. " doors)")
        return
    end
    self.Target = nil
    local distance = (root.Position - best.CFrame.Position).Magnitude
    local activation = math.min(best.Prompt.MaxActivationDistance or 10, 12)
    if distance > activation then
        if distance > 600 and self:HalloweenPumpkinStep(250) then return end
        if self:HalloweenPortalStep(best) then return end
        self:HalloweenStatus("Moving to door | " .. math.floor(distance) .. " studs")
        self:MoveTo(best.CFrame + Vector3.new(0, 3, 0))
        return
    end
    if os.clock() < (self.HalloweenNextKnock or 0) then return end
    self.HalloweenNextKnock = os.clock() + 3
    self.HalloweenKnockWaitUntil = os.clock() + 3
    self.HalloweenTried = self.HalloweenTried or setmetatable({}, { __mode = "k" })
    self.HalloweenTried[best.Door] = os.clock() + 12
    local ignore = setmetatable({}, { __mode = "k" })
    local enemiesFolder = Services.Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, model in ipairs(enemiesFolder:GetChildren()) do
            local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if part and (part.Position - best.CFrame.Position).Magnitude <= 130 then ignore[model] = true end
        end
    end
    self.HalloweenOwnDoor = { Door = best.Door, At = os.clock(), Ignore = ignore }
    self:CancelMove()
    if self:FirePrompt(best.Prompt) then
        self.HalloweenCurrentDoor = best
        if self:HalloweenBossDoor(best) then self:HalloweenBossSessionStart(best) end
        self:HalloweenStatus("Knocked door | Waiting for event")
        return
    end
    local remote = Compat.find(Services.ReplicatedStorage, { "Remotes", "HalloweenFunction" })
    if Compat.isA(remote, "RemoteFunction") then
        self.HalloweenCurrentDoor = best
        if self:HalloweenBossDoor(best) then self:HalloweenBossSessionStart(best) end
        local door = best.Door
        task.spawn(function() pcall(remote.InvokeServer, remote, door) end)
        self:HalloweenStatus("Knocked door | Waiting for event")
    else
        self:HalloweenStatus("Prompt unavailable | Executor needs fireproximityprompt")
    end
end


