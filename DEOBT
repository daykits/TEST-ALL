function Hub:TrialRoomStep()
    local race = self:PlayerRace(Player)
    local _, _, root = self:Character()
    if not race or not root then return end
    if race == "Cyborg" then
        local roof = Compat.find(Services.Workspace, { "Map", "CyborgTrial", "Roof" })
        if Compat.isA(roof, "BasePart") and (root.Position - roof.Position).Magnitude < 1000 then
            root.CFrame = roof.CFrame + Vector3.new(0, 50, 0)
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        end
        return
    end
    if race == "Human" or race == "Ghoul" then
        local center = race == "Human" and Vector3.new(10044.15, 10019.37, 89.04)
            or Vector3.new(-11693.02, 10011.22, 85.40)
        local mobs = self:Enemies(function(model)
            local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            return part ~= nil and (part.Position - center).Magnitude < 1000
        end)
        if mobs[1] then self:Fight(mobs[1], nil, false) end
        return
    end
    if race == "Mink" then
        local start = Services.Workspace:FindFirstChild("StartPoint")
        local trial = Compat.find(Services.Workspace, { "Map", "MinkTrial" })
        if start and trial and (root.Position - start.Position).Magnitude < 1000 then
            if os.clock() - (self.TrialResetAt or 0) > 5 then
                self.TrialResetAt = os.clock()
                root.CFrame = start.CFrame
            end
        end
        return
    end
    if race == "Skypiea" then
        local finish = Compat.find(Services.Workspace, { "Map", "SkyTrial", "Model", "FinishPart" })
        if Compat.isA(finish, "BasePart")
            and (root.Position - Vector3.new(12004, 17013.40, 5525.27)).Magnitude < 500 then
            if os.clock() - (self.TrialResetAt or 0) > 5 then
                self.TrialResetAt = os.clock()
                root.CFrame = finish.CFrame
            end
        end
        return
    end
    if race == "Fishman" then
        local folder = Services.Workspace:FindFirstChild("SeaBeasts")
        local center = Vector3.new(25029.35, -4.25, 12478.96)
        local best, distance
        for _, beast in ipairs(folder and folder:GetChildren() or {}) do
            local part = beast:FindFirstChild("HumanoidRootPart") or beast.PrimaryPart
            local health = beast:FindFirstChild("Health")
            if part and health and (health.Value or 0) > 0 and (part.Position - center).Magnitude < 1000 then
                local d = (part.Position - root.Position).Magnitude
                if not distance or d < distance then best, distance = beast, d end
            end
        end
        if best then
            local part = best:FindFirstChild("HumanoidRootPart") or best.PrimaryPart
            if part then self:MoveTo(part.CFrame + Vector3.new(0, 40, 0)) end
        end
    end
end

function Hub:TrialStep()
    if self.Sea ~= "Sea3" then self:Log("trial", "Third Sea required."); return end
    if self:RaidTimerVisible() then self:TrialRoomStep(); return end
    local ok, stage = self:Comm("UpgradeRace", "Check")
    if not ok or type(stage) ~= "number" then return end
    if stage == 5 then self:Log("trial", "All training sessions finished."); return end
    if stage == 1 or stage == 3 or stage == 6 or stage == 8 then
        self:FarmGroup({ "Reborn Skeleton", "Living Zombie", "Demonic Soul", "Posessed Mummy", "Possessed Mummy" }, nil, 2000)
        return
    end
    if stage == 2 or stage == 4 or stage == 7 then
        if self:CheckRaceUpgrade(true) then self:BuyRaceUpgrade() end
        return
    end
    if stage ~= 0 then return end
    self:ChooseGear()
    self:TrialEntranceTP()
    if not self:IsNearEntrance(Player) then return end
    local roster = self.Config["Multi Players"]
    if type(roster) == "table" and #roster >= 2 then
        if self.Config["Trial Player 1"] == "" then self:SetConfig("Trial Player 1", roster[1]) end
        if self.Config["Trial Player 2"] == "" then self:SetConfig("Trial Player 2", roster[2]) end
    end
    local count = 0
    local first = Services.Players:FindFirstChild(self.Config["Trial Player 1"])
    local second = Services.Players:FindFirstChild(self.Config["Trial Player 2"])
    if first and self:IsNearEntrance(first) then count += 1 end
    if second and self:IsNearEntrance(second) then count += 1 end
    if count < 2 then self:Log("trial", "Waiting for trial team at entrances."); return end
    if not self:MultiSync("trial", self.Config["Multi Trial Size"]) then return end
    task.wait(0.2)
    self:CommE("ActivateAbility")
end

