    NEBULA LIBRARY - FARM EDITION
    Phục vụ: page Farming / Setting Farm / Mastery Farm / Farming Material
    Bỏ: ESP, Keybind, SliderDropdown, NotifyYesNo, Palette, About
    Tương thích adapter cũ: CreateWindow / AddTab / AddSection /
        AddToggle / AddButton / AddSlider / AddDropdown / AddParagraph / AddInput /
        Notify / Unload / Unloaded / AutoSave / Settings / BindCount

    Return: table Library (dùng với loadstring(game:HttpGet(URL))())
]]

local Players         = game:GetService("Players")
local UserInputService= game:GetService("UserInputService")
local TweenService    = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

-- ==================== THEME (Nebula Dark + Purple/Cyan) ====================
local Theme = {
    Background = Color3.fromRGB(18, 19, 28),
    Panel      = Color3.fromRGB(28, 29, 42),
    Surface    = Color3.fromRGB(35, 36, 52),
    Accent     = Color3.fromRGB(138, 75, 235),
    Accent2    = Color3.fromRGB(0, 191, 255),
    Text       = Color3.fromRGB(242, 243, 250),
    Muted      = Color3.fromRGB(157, 160, 180),
    Success    = Color3.fromRGB(0, 220, 145),
    Danger     = Color3.fromRGB(255, 83, 105),
    Off        = Color3.fromRGB(65, 67, 86),
}

-- ==================== UTIL ====================
local function create(cls, props, parent)
    local o = Instance.new(cls)
    for k, v in pairs(props or {}) do
        o[k] = v
    end
    o.Parent = parent
    return o
end

local function corner(parent, r)
    return create("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function stroke(parent, color, thickness, transparency)
    return create("UIStroke", {
        Color = color or Theme.Off,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, parent)
end

local function tween(obj, dur, props)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(dur or 0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function roundNumber(v, digits)
    digits = digits or 0
    local mult = 10 ^ digits
    return math.floor(v * mult + 0.5) / mult
end

local function formatNumber(v, digits)
    if digits <= 0 then
        return tostring(math.floor(v + 0.5))
    end
    return string.format("%." .. digits .. "f", v)
end

-- ==================== LIBRARY OBJECT ====================
local Library = {}
Library.AutoSave = false
Library.Settings = {}
Library.Unloaded = false
Library.BindCount = 0

local allConnections = {}
local windowsList = {}

local function trackConn(c)
    table.insert(allConnections, c)
    return c
end

-- ==================== NOTIFY ====================
local function getRootGui()
    for _, w in ipairs(windowsList) do
        if w.Gui and w.Gui.Parent then
            return w.Gui
        end
    end
    return nil
end

function Library:Notify(opts)
    opts = opts or {}
    local title = tostring(opts.Title or "Thông báo")
    local content = tostring(opts.Content or "")
    local duration = tonumber(opts.Duration) or 5

    local gui = getRootGui()
    if not gui then
        -- chưa có window → dùng CoreGui tạm
        local core = game:GetService("CoreGui")
        gui = core:FindFirstChild("NebulaNotifyHolder")
        if not gui then
            gui = create("ScreenGui", {
                Name = "NebulaNotifyHolder",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                DisplayOrder = 100,
            }, core)
        end
    end

    local holder = gui:FindFirstChild("NebulaNotifications")
    if not holder then
        holder = create("Frame", {
            Name = "NebulaNotifications",
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -18, 1, -18),
            Size = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 1,
        }, gui)
        local ll = create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
        }, holder)
        ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            holder.Size = UDim2.fromOffset(ll.AbsoluteContentSize.X, ll.AbsoluteContentSize.Y)
        end)
    end

    local toast = create("Frame", {
        Size = UDim2.fromOffset(260, 68),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
    }, holder)
    corner(toast, 10)
    stroke(toast, Theme.Accent, 1, 0.2)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 7),
        Size = UDim2.new(1, -24, 0, 22),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, toast)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 29),
        Size = UDim2.new(1, -24, 0, 28),
        Font = Enum.Font.Gotham,
        Text = content,
        TextColor3 = Theme.Muted,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, toast)

    tween(toast, 0.18, { BackgroundTransparency = 0 })
    task.delay(duration, function()
        if toast.Parent then
            tween(toast, 0.18, { BackgroundTransparency = 1 })
            task.wait(0.22)
            toast:Destroy()
        end
    end)
end

