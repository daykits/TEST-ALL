function Hub:InstallFruitTracker()
    if self.FruitTracking then return end
    self.FruitTracking = true
    self.WorldFruits = setmetatable({}, { __mode = "k" })
    local function track(object)
        if object:IsA("Tool") and object:FindFirstChild("EatRemote", true) then self.WorldFruits[object] = true end
        if object.Name == "EatRemote" and object:IsA("RemoteFunction") then
            local parent = object.Parent
            while parent and parent ~= Services.Workspace do
                if parent:IsA("Tool") then self.WorldFruits[parent] = true; break end
                parent = parent.Parent
            end
        end
    end
    for _, object in ipairs(Services.Workspace:GetDescendants()) do track(object) end
    self:Connect(Services.Workspace.DescendantAdded, track)
end

function Hub:IsLooseFruit(tool)
