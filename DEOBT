function Hub:SetOptions(key, values)
    local control = self[key]
    if not control or type(control.NewOptions) ~= "function" then return end
    self.OptionSignatures = self.OptionSignatures or {}
    local signature = table.concat(values, "\0")
    if self.OptionSignatures[key] == signature then return end
    self.OptionSignatures[key] = signature
    if #values > 0 then control:NewOptions(table.unpack(values))
    elseif type(control.Clear) == "function" then control:Clear() end
end

function Hub:LoadExternal(url)
    if type(loadstring) ~= "function" then return false, "Script loader unavailable." end
    return self:Call("external:" .. url, 20, 3, function()
        local source = game:HttpGet(url)
        if not self.Alive then error("Stopped") end
        if type(source) ~= "string" or source == "" then error("Empty response") end
        local chunk, problem = loadstring(source)
        if type(chunk) ~= "function" then error(problem or "Invalid script") end
        return chunk()
    end)
end

local HopServerInfo = { Uptime = "Uptime: --", Reset = "Reset In: --" }

local function hopServerUptimeClock(sec)
    sec = math.max(math.floor(tonumber(sec) or 0), 0)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function GetServerUptime()
    local worldOrigin = Services.Workspace:FindFirstChild("_WorldOrigin")
    local locations = worldOrigin and worldOrigin:FindFirstChild("Locations")
    local timeIn = nil
    if locations then
        for _, child in ipairs(locations:GetChildren()) do
            local attr = child:GetAttribute("TimeIn")
            if attr then
                timeIn = attr
                break
            end
        end
    end
    if not timeIn then
        return false, 0, 0
    end
    local uptime = os.time() - timeIn
    local has4Hours = uptime >= 14400
    local timeRemaining = 14400 - (uptime % 14400)
    return has4Hours, uptime, timeRemaining
end

local function ServerNearReset(window)
    local _, uptime, remaining = GetServerUptime()
    if uptime <= 0 then
        return false
    end
    return remaining <= (window or 300)
end

local function RefreshHopServerInfo()
    local _, uptime, remaining = GetServerUptime()
    if uptime > 0 then
        HopServerInfo.Uptime = "Uptime: " .. hopServerUptimeClock(uptime)
        HopServerInfo.Reset = "Reset In: " .. hopServerUptimeClock(remaining)
    else
        HopServerInfo.Uptime = "Uptime: --"
        HopServerInfo.Reset = "Reset In: --"
    end
end
