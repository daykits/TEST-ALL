    list.AutomaticSize = Enum.AutomaticSize.Y

    comp.List = list

    local click = New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 6,
        Parent = head,
    })

    local function closeMenu()
        comp._open = false
        list.Visible = false
        comp.Arrow.Text = "▾"
    end

    local function openMenu()
        comp._open = true
        list.Visible = true
        comp.Arrow.Text = "▴"
    end

    local function rebuildOptions()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, opt in ipairs(options) do
            local optBtn = New("TextButton", {
                BackgroundColor3 = (opt == value) and theme.Border or theme.Card,
                BackgroundTransparency = (opt == value) and 0 or 0.6,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 26),
                Text = tostring(opt),
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                LayoutOrder = i,
                ZIndex = 11,
                Parent = list,
            })
            Corner(6).Parent = optBtn
            Padding(0, 0, 8, 0).Parent = optBtn
            optBtn.MouseEnter:Connect(function()
                GlobalAnimations:Play(optBtn, { BackgroundTransparency = 0.2 })
            end)
            optBtn.MouseLeave:Connect(function()
                GlobalAnimations:Play(optBtn, { BackgroundTransparency = (opt == value) and 0 or 0.6 })
            end)
            optBtn.MouseButton1Click:Connect(function()
                value = opt
                comp.ValueLabel.Text = tostring(opt)
                rebuildOptions()
                closeMenu()
                SafeCall(cfg.Callback, opt)
            end)
        end
    end
    rebuildOptions()

    click.MouseButton1Click:Connect(function()
        if not comp._enabled then return end
        if comp._open then closeMenu() else openMenu() end
    end)

    function comp.SetOptions(opts)
        options = opts or {}
        if not table.find(options, value) then
            value = options[1]
            comp.ValueLabel.Text = tostring(value or "")
        end
        rebuildOptions()
    end
    function comp.SetValue(v)
        value = v
        comp.ValueLabel.Text = tostring(v or "")
        rebuildOptions()
    end
    function comp.GetValue() return value end
    function comp.SetCallback(fn) cfg.Callback = fn end
    function comp.SetEnabled(b) comp._enabled = b and true or false; head.BackgroundTransparency = b and 0 or 0.5 end
    function comp.Destroy() comp.Container:Destroy() end
    function comp:_ApplyTheme(t)
        head.BackgroundColor3 = t.Secondary
        comp.Label.TextColor3 = t.Text
        comp.ValueLabel.TextColor3 = t.Accent
        comp.Arrow.TextColor3 = t.TextSecondary
        list.BackgroundColor3 = t.Card
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then child.TextColor3 = t.Text end
        end
    end

    table.insert(section.Components, comp)
    return comp
end

