function ComponentFactory.Keybind(section, cfg)
    cfg = cfg or {}
    local theme = CurrentTheme
    local currentKey = cfg.Default or Enum.KeyCode.Unknown
    local active = true
    local listening = false
    local comp = { _type = "Keybind", _enabled = true }

    local row = MakeRow(section.List, 44)
    comp.Container = row
    MakeTitleText(row, cfg.Name or "Keybind")

    local btn = New("TextButton", {
        BackgroundColor3 = theme.Secondary,
        BorderSizePixel = 0,
        Text = currentKey.Name,
        Font = Enum.Font.GothamBold,
        TextColor3 = theme.Accent,
        TextSize = 12,
        Size = UDim2.fromOffset(90, 26),
        Position = UDim2.new(1, -90, 0.5, -13),
        AutoButtonColor = false,
        ZIndex = 5,
        Parent = row,
    })
    Corner(6).Parent = btn

    btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "..."
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            btn.Text = currentKey.Name
            listening = false
            SafeCall(cfg.Callback, currentKey)
        elseif active and input.KeyCode == currentKey then
            SafeCall(cfg.OnPressed, currentKey)
        end
    end)
    UserInputService.InputEnded:Connect(function(input, gp)
        if gp then return end
        if active and input.KeyCode == currentKey then
            SafeCall(cfg.OnReleased, currentKey)
        end
    end)

    function comp.SetKey(kc) currentKey = kc; btn.Text = kc.Name end
    function comp.GetKey() return currentKey end
    function comp.SetCallback(fn) cfg.Callback = fn end
    function comp.SetEnabled(b) comp._enabled = b and true or false; active = comp._enabled end
    function comp.Destroy() comp.Container:Destroy() end
    function comp:_ApplyTheme(t)
        btn.BackgroundColor3 = t.Secondary
        btn.TextColor3 = t.Accent
    end

    table.insert(section.Components, comp)
    return comp
end

