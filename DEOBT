local function cancelQuestIfDifferent(wantedQuest)

	wantedQuest = tostring(wantedQuest or "")

	local current = getQuest()

	if current == "" or current == wantedQuest then

		return false

	end

	notify("Quest", "Cancel old quest: " .. tostring(current) .. " -> " .. tostring(wantedQuest), 4)

	pcall(function()

		questEvent:InvokeServer({ [1] = "quit" })

	end)

	pcall(function()

		local args = { { "quit" } }

		questEvent:InvokeServer(unpack(args))

	end)

	task.wait(0.35)

	if getQuest() ~= "" and getQuest() ~= wantedQuest then

		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

		local quitBtn = playerGui

			and playerGui:FindFirstChild("Quest")

			and playerGui.Quest:FindFirstChild("Main")

			and playerGui.Quest.Main:FindFirstChild("Misc")

			and playerGui.Quest.Main.Misc:FindFirstChild("Quit")

		if quitBtn then

			pcall(function() quitBtn:Activate() end)

		end

	end

	task.wait(0.65)

	return true

end

local function takeQuest(questName, questPos, safeNoNoclip)

	if not questName or questName == "" then return end

	releaseMovementKeys()

	cancelQuestIfDifferent(questName)

	if getQuest() == questName then

		return

	end

	DoSafeTeleport(questPos, safeNoNoclip == true, safeNoNoclip ~= true)

	task.wait(1)

	cancelQuestIfDifferent(questName)

	pcall(function()

		questEvent:InvokeServer({ [1] = "takequest", [2] = questName })

	end)

	task.wait(1)

end

