    if variant == "Draco" then ok, stage, count, cost = self:Comm("UpgradeRace", "Check", 2)
    else ok, stage, count, cost = self:Comm("UpgradeRace", "Check") end
    if not ok or type(stage) ~= "number" then
        if not silent then self:Notify("Race V4", "Status unavailable.") end
        return nil
    end
