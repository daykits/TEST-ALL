function Window:SetActiveTab(tab)
    if self.ActiveTab == tab then return end
    local old = self.ActiveTab
    if old and old.Container then
        old.Container.Visible = false
        old.Button.BackgroundTransparency = 1
        old.NameLabel.TextColor3 = CurrentTheme.TextSecondary
        old.IconLabel.TextColor3 = CurrentTheme.TextSecondary
    end
    self.ActiveTab = tab
    if tab then
        tab.Container.Visible = true
        tab.Button.BackgroundTransparency = 0.85
        tab.Button.BackgroundColor3 = CurrentTheme.Accent
        tab.NameLabel.TextColor3 = CurrentTheme.Text
        tab.IconLabel.TextColor3 = CurrentTheme.Accent
    end
end

