function Hub:HalloweenGachaDecision(check, data)
    local cooldown = self:HalloweenField(check, "Cooldown")
    local remaining
    if type(cooldown) == "table" and type(cooldown.RollTotal) == "number" then
        remaining = math.max(0, cooldown.RollTotal - (type(cooldown.RollCount) == "number" and cooldown.RollCount or 0))
        self.HalloweenGachaRemaining = remaining
        self.HalloweenGachaRollTotal = cooldown.RollTotal
    end
    local level = self:HalloweenField(check, "Level")
    if type(level) == "table" and level.RequirementMet == false then
        return false, "Level " .. tostring(level.Value or "?") .. " required", remaining, "level", 300
    end
    local restricted = self:HalloweenField(check, "PaidRandomItemsRestricted")
    if type(restricted) == "table" and restricted.Value == true then
        return false, "Gacha is disabled in your region", remaining, "region", 300
    end
    local price = self:HalloweenField(check, "Price")
    local silver = self:HalloweenField(check, "Keys", "Silver")
    local silverReady = type(silver) == "table" and silver.RequirementMet == true
    local candyReady = type(cooldown) == "table" and cooldown.RequirementMet == true and type(price) == "table" and price.RequirementMet == true
    if candyReady and silverReady and not self.Config["Halloween Gacha Silver Key"] then
        return false, "Silver Key available; enable Allow Silver Key to roll", remaining, "silver", 300
    end
    if candyReady then return true, "Candy Corn", remaining, "candy", 0 end
    if silverReady and self.Config["Halloween Gacha Silver Key"] then return true, "Silver Key", remaining, "silver", 0 end
    if type(cooldown) == "table" and cooldown.RequirementMet == false then
        local waitSeconds = 300
        if type(cooldown.TimeEnds) == "number" then
            waitSeconds = math.clamp(cooldown.TimeEnds - Services.Workspace:GetServerTimeNow(), 30, 7200)
        end
        local label = waitSeconds >= 3600 and (tostring(math.ceil(waitSeconds / 360) / 10) .. "h") or (tostring(math.ceil(waitSeconds / 60)) .. "m")
        return false, "Cooldown " .. label, remaining, "cooldown", waitSeconds
    end
    if type(price) == "table" and price.RequirementMet == false then
        local cost = type(data) == "table" and data.ROLL_COST or nil
        local text = type(cost) == "table" and (tostring(cost.Value or "?") .. " " .. tostring(cost.Name or "Candy Corn")) or "more Candy Corn"
        return false, "Need " .. text, remaining, "price", 45
    end
    local message = type(check) == "table" and check.ErrorMessage or nil
    return false, tostring(message or "Not ready"), remaining, "other", 60
end

function Hub:HalloweenCloseGachaUI()
    if not self.Config["Halloween Auto Close Gacha UI"] then return false end
    if not (self.Config["Auto Halloween"] or self.Config["Auto Great Pumpkin"]) then return false end
    if os.clock() < (self.HalloweenGachaKeepOpenUntil or 0) then return false end
    if os.clock() < (self.HalloweenGachaCloseAt or 0) then return false end
    local closed = false
    local window = self:Module("GachaWindow", { "Controllers", "UI", "GachaWindow" })
    if type(window) == "table" and type(window.IsOpen) == "function" and type(window.Close) == "function" then
        local ok, isOpen = pcall(window.IsOpen, window)
        if ok and isOpen then
            pcall(window.Close, window, true)
            local verifyOk, stillOpen = pcall(window.IsOpen, window)
            closed = not (verifyOk and stillOpen)
        end
    end
    local spinner = self:Module("Spinner", { "Controllers", "UI", "Spinner" })
    if type(spinner) == "table" and type(spinner.IsOpen) == "function" and type(spinner.Close) == "function" then
        local ok, isOpen = pcall(spinner.IsOpen, spinner)
        if ok and isOpen then
            pcall(spinner.Close, spinner)
            local verifyOk, stillOpen = pcall(spinner.IsOpen, spinner)
            if not (verifyOk and stillOpen) then closed = true end
        end
    end
    if not closed then
        local gui = Player:FindFirstChild("PlayerGui")
        if gui then
            local hit = false
            for _, child in ipairs(gui:GetChildren()) do
                local lname = child.Name:lower()
                if child:IsA("ScreenGui") and child.Enabled and (lname:find("gacha", 1, true) or lname:find("spinner", 1, true)) then
                    hit = true
                    local clicked = false
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("GuiButton") and (desc.Name:lower():find("close", 1, true) or (desc.Parent and desc.Parent.Name:lower():find("close", 1, true))) then
                            if type(firesignal) == "function" then clicked = pcall(firesignal, desc.Activated) end
                            if not clicked then
                                local vimOk, vim = pcall(game.GetService, game, "VirtualInputManager")
                                if vimOk and vim then
                                    local pos = desc.AbsolutePosition + desc.AbsoluteSize / 2
                                    clicked = pcall(function()
                                        vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                                        task.wait(0.05)
                                        vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
                                    end)
                                end
                            end
                            break
                        end
                    end
                    if not clicked then child.Enabled = false end
                end
            end
            if hit then
                closed = true
                local locks = self:Module("Locks", { "Controllers", "Locks" })
                if type(locks) == "table" then
                    pcall(function()
                        if locks.SpinnerLock then locks.SpinnerLock:Unlock() end
                        if locks.GachaWindowLock then locks.GachaWindowLock:Unlock() end
                    end)
                end
                self:Log("gacha-ui", "Closed gacha UI via GUI fallback", 5)
            end
        end
    end
    if closed then
        self.HalloweenGachaCloseAt = os.clock() + 0.75
        self:HalloweenStatus("Spooky Gacha | Closed result menu")
    end
    return closed
end

function Hub:HalloweenWaitForSpinner(startedAt)
    local deadline = os.clock() + 9
    while self.Alive and os.clock() < deadline do
        task.wait(0.5)
        self:HalloweenCloseGachaUI()
        local spinning = false
        local gui = Player:FindFirstChild("PlayerGui")
        if gui then
            for _, child in ipairs(gui:GetChildren()) do
                if child.Name:lower():find("spinner", 1, true) and (not child:IsA("ScreenGui") or child.Enabled) then spinning = true; break end
            end
        end
        if not spinning and os.clock() - startedAt >= 3 then return end
    end
end

function Hub:HalloweenGachaStep(manual, maxRolls)
    if self.HalloweenGachaBusy then return true end
    if not manual and not self.Config["Halloween Auto Gacha"] then return false end
    if not manual and os.clock() < (self.HalloweenGachaNext or 0) then return false end
    if not self:HalloweenActive() then
        if manual then self:Notify("Halloween", "Halloween event is not active.") end
        return false
    end
    self.HalloweenGachaBusy = true
    local function finish(value)
        self.HalloweenGachaBusy = false
        return value
    end
    local data, problem = self:HalloweenGachaConfig()
    if not data then
        if type(problem) == "string" and (problem:sub(1, 9) == "Cooldown:" or problem:sub(1, 13) == "Request still") then
            self.HalloweenGachaNext = os.clock() + 2
            return finish(false)
        end
        self.HalloweenGachaNext = os.clock() + 60
        self:HalloweenStatus("Spooky Gacha | Data unavailable")
        if manual then self:Notify("Spooky Gacha", tostring(problem or "Data unavailable.")) end
        return finish(false)
    end
    if data.ENABLED == false then
        self.HalloweenGachaNext = os.clock() + 300
        self:HalloweenStatus("Spooky Gacha | Disabled")
        return finish(false)
    end
    local cost = type(data.ROLL_COST) == "table" and data.ROLL_COST or nil
    if cost and type(cost.Name) == "string" and type(cost.Value) == "number" and not self.Config["Halloween Gacha Silver Key"] then
        local quantity = self:ItemQuantity(cost.Name)
        if type(quantity) == "number" and quantity < cost.Value then
            self.HalloweenGachaNext = os.clock() + 45
            self:HalloweenStatus("Spooky Gacha | Need " .. cost.Value .. " " .. cost.Name .. " (have " .. quantity .. ")")
            return finish(false)
        end
    end
    local preCheck, preProblem = self:HalloweenGachaCheck(false)
    if not preCheck then
        if type(preProblem) == "string" and (preProblem:sub(1, 9) == "Cooldown:" or preProblem:sub(1, 13) == "Request still") then
            self.HalloweenGachaNext = os.clock() + 2
            return finish(false)
        end
        self.HalloweenGachaNext = os.clock() + 60
        self:HalloweenStatus("Spooky Gacha | " .. tostring(preProblem or "Check failed"))
        if manual then self:Notify("Spooky Gacha", tostring(preProblem or "Check failed.")) end
        return finish(false)
    end
    local preCan, preReason, _, _, preWait = self:HalloweenGachaDecision(preCheck, data)
    if not preCan then
        self.HalloweenGachaNext = os.clock() + (preWait or 60)
        self:HalloweenStatus("Spooky Gacha | " .. tostring(preReason))
        if manual then self:Notify("Spooky Gacha", tostring(preReason)) end
        return finish(false)
    end
    local reached, travelProblem = self:HalloweenGoNPC("Blox Fruit Gacha", not manual)
    if not reached then
        self.HalloweenGachaNext = os.clock() + 60
        self:HalloweenStatus("Spooky Gacha | " .. tostring(travelProblem or "Travel failed"))
        return finish(false)
    end
    local limit = maxRolls or (manual and 1 or 3)
    local rolls = 0
    local carryCheck = preCheck
    for _ = 1, limit do
        if not self.Alive then break end
        if not manual and (not self:HalloweenAutoOn() or not self.Config["Halloween Auto Gacha"]) then break end
        local check, checkProblem = carryCheck, nil
        carryCheck = nil
        if not check then check, checkProblem = self:HalloweenGachaCheck(true) end
        if not check then
            if type(checkProblem) == "string" and (checkProblem:sub(1, 9) == "Cooldown:" or checkProblem:sub(1, 13) == "Request still") then
                self.HalloweenGachaNext = os.clock() + 2
            else
                self.HalloweenGachaNext = os.clock() + 60
                self:HalloweenStatus("Spooky Gacha | Check failed")
                if manual then self:Notify("Spooky Gacha", tostring(checkProblem or "Check failed.")) end
            end
            break
        end
        local can, reason, remaining, code, waitSeconds = self:HalloweenGachaDecision(check, data)
        if not can then
            self.HalloweenGachaNext = os.clock() + (waitSeconds or 60)
            self:HalloweenStatus("Spooky Gacha | " .. tostring(reason))
            if manual then self:Notify("Spooky Gacha", tostring(reason)) end
            break
        end
        local keep = tonumber(self.Config["Halloween Gacha Keep Candy"]) or 0
        if code == "candy" and keep > 0 then
            local rollCost = type(data) == "table" and type(data.ROLL_COST) == "table" and data.ROLL_COST.Value or nil
            local candy = self:ItemQuantity("Candy Corn")
            if type(rollCost) == "number" and type(candy) == "number" and candy - rollCost < keep then
                self.HalloweenGachaNext = os.clock() + 30
                self:HalloweenStatus("Spooky Gacha | Keeping " .. keep .. " Candy Corn")
                if manual then self:Notify("Spooky Gacha", "Stopped to keep " .. keep .. " Candy Corn in reserve.") end
                break
            end
        end
        self:HalloweenStatus("Spooky Gacha | Rolling with " .. tostring(reason) .. (remaining and (" (" .. remaining .. " left)") or ""))
        local invoked, purchased, errorValue = self:InvokeNet("GachaNetworkRF", { Context = "Purchase", BoxName = self.HalloweenGachaBox }, 1)
        if not invoked or purchased ~= true then
            local message = type(errorValue) == "table" and (errorValue.ErrorMessage or errorValue.Message) or tostring(errorValue or purchased or "Purchase failed")
            self.HalloweenGachaNext = os.clock() + 60
            self:HalloweenStatus("Spooky Gacha | " .. tostring(message))
            if manual then self:Notify("Spooky Gacha", tostring(message)) end
            break
        end
        rolls += 1
        self.HalloweenGachaNext = os.clock() + 20
        self:HalloweenStatus("Spooky Gacha | Rolled " .. rolls)
        self:HalloweenWaitForSpinner(os.clock())
    end
    if rolls > 0 and manual then self:Notify("Spooky Gacha", "Roll completed.") end
    return finish(true)
end

