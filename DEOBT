function Hub:SecretTurnInAtGuide(row, id)
    local moment = self:GetMoment(row.Name)
    if row.Name == "Prickly Harvest" and moment and id == "PricklyHarvestMerchant" then
        local ok, reply = self:ClaimGuideReward("DesertMerchant", true)
        self:RefreshSecrets(true)
        return ok == true and reply ~= nil and reply ~= false
    end
    if row.Name == "Tavern Brawl" and moment and id == "TavernBrawlBartender" then
        local ok = self:SecretRemote(row, moment, "ClaimReward", false, 3)
        self:RefreshSecrets(true)
        return ok == true
    end
    local group = self:SecretNPCEntry(row)
    if group then
        local ok, reply = self:ClaimGuideReward(group, true)
        self:RefreshSecrets(true)
        return ok == true and reply ~= nil and reply ~= false
    end
    return false
end

function Hub:RunSecretGuide(row, force)
    local cf, object, id = self:SecretGuide(row, force)
    if not cf then return false end
    local enemy = object
    local enemies = Services.Workspace:FindFirstChild("Enemies")
    while enemy and enemies and enemy ~= enemies do
        if self:AliveEnemy(enemy) and enemy:IsDescendantOf(enemies) then
            self.SecretCombatAllowed = true
            self:Fight(enemy, enemy.Name, false)
            self:SecretStatus(row, "Objective | Farm " .. enemy.Name)
            return true
        end
        enemy = enemy.Parent
    end
    local _, _, root = self:Character()
    if not root then return true end
    local distance = (root.Position - cf.Position).Magnitude
    if distance > 9 then
        self:SecretStatus(row, "Guide | Moving to objective")
        self:MoveTo(cf)
        return true
    end
    if id and (id:find("REPORT", 1, true) or id == "PricklyHarvestMerchant" or id == "TavernBrawlBartender") then
        self:SecretStatus(row, "Turn-in | Reporting")
        self:SecretTurnInAtGuide(row, id)
        return true
    end
    local handler = self.SecretHandlers[row.Name]
    local localTracker = id and handler and table.find(handler.Trackers or {}, id)
    local nearbyGroup = not localTracker and self:SecretNPCNear(cf, 35) or nil
    if nearbyGroup then
        self:ClaimGuideReward(nearbyGroup, true)
        self:RefreshSecrets(true)
        self:SecretStatus(row, "Turn-in | Quest giver")
        return true
    end
    if object then
        local prompt = object:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.Enabled then
            self:SecretUsePrompt(row, prompt)
            return true
        end
        local handler = self.SecretHandlers[row.Name]
        if self:SecretInteractObject(row, handler, { Object = object, Key = "guide" }) then return true end
    end
    self:SecretStatus(row, "Guide | Objective reached")
    return false
end

function Hub:SecretObjectPart(object)
    if not object or typeof(object) ~= "Instance" or not object.Parent then return nil end
    if object:IsA("BasePart") then return object end
    if object:IsA("Attachment") then return object.Parent and object.Parent:IsA("BasePart") and object.Parent or nil end
    if object:IsA("Model") then return object.PrimaryPart or object:FindFirstChild("HumanoidRootPart") or object:FindFirstChildWhichIsA("BasePart", true) end
    return object:FindFirstChildWhichIsA("BasePart", true)
end

function Hub:SecretObjectMatches(object, handler, names)
    if not object or typeof(object) ~= "Instance" then return false end
    local value = Compat.normalizeName(object.Name):gsub("[%s%-_]", "")
    for _, name in ipairs(handler and handler.RejectNames or {}) do
        if value == Compat.normalizeName(name):gsub("[%s%-_]", "") then return false end
    end
    local ancestor = object
    while ancestor and ancestor ~= Services.Workspace do
        local ancestorName = Compat.normalizeName(ancestor.Name):gsub("[%s%-_]", "")
        for _, name in ipairs(handler and handler.IgnoreUnder or {}) do
            if ancestorName == Compat.normalizeName(name):gsub("[%s%-_]", "") then return false end
        end
        ancestor = ancestor.Parent
    end
    for _, name in ipairs(names or handler and handler.Objects or {}) do
        local wanted = Compat.normalizeName(name):gsub("[%s%-_]", "")
        if value == wanted or (#wanted >= 4 and value:find(wanted, 1, true)) then return true end
    end
    if names then return false end
    for _, attribute in ipairs(handler and handler.Attributes or {}) do
        local ok, result = pcall(object.GetAttribute, object, attribute)
        if ok and result ~= nil then return true end
    end
    return false
end

function Hub:SecretWorldRoots(row)
    local result, loose = {}, {}
    local map = Services.Workspace:FindFirstChild("Map")
    local aliases = self.SecretIslandAliases[row.Island] or { row.Island }
    for _, child in ipairs(map and map:GetChildren() or {}) do
        local value = Compat.normalizeName(child.Name):gsub("[%s%-_]", "")
        for _, alias in ipairs(aliases) do
            local wanted = Compat.normalizeName(alias):gsub("[%s%-_]", "")
            if value == wanted then table.insert(result, child); break
            elseif value:find(wanted, 1, true) then table.insert(loose, child); break end
        end
    end
    if #result == 0 then result = loose end
    if #result == 0 and map then table.insert(result, map) end
    local origin = Services.Workspace:FindFirstChild("_WorldOrigin")
    if origin then table.insert(result, origin) end
    local handler = self.SecretHandlers[row.Name]
    if handler and handler.GlobalObjects then
        for _, object in ipairs(Services.Workspace:GetChildren()) do
            if self:SecretObjectMatches(object, handler) then table.insert(result, object) end
        end
    end
    return result
end

function Hub:SecretWorldCandidates(row, handler)
    local key = row.Address
    if self.SecretScan and self.SecretScan.Key == key and os.clock() - self.SecretScan.At < 0.75 then return self.SecretScan.Values end
    local values, seen = {}, {}
    local function add(object, source)
        if typeof(object) == "Instance" and object.Parent and not seen[object] then
            seen[object] = true
            table.insert(values, { Object = object, Key = source or object.Name })
        end
    end
    for _, tag in ipairs(handler.Tags or {}) do
        for _, object in ipairs(Services.CollectionService:GetTagged(tag)) do
            add(object, "tag:" .. tag)
            for _, child in ipairs(object:GetDescendants()) do if self:SecretObjectMatches(child, handler) then add(child, child.Name) end end
        end
    end
    for _, root in ipairs(self:SecretWorldRoots(row)) do
        if self:SecretObjectMatches(root, handler) then add(root, root.Name) end
        for _, object in ipairs(root:GetDescendants()) do
            if self:SecretObjectMatches(object, handler) then add(object, object.Name) end
        end
    end
    self.SecretScan = { Key = key, At = os.clock(), Values = values }
    return values
end

function Hub:SecretMomentCandidates(moment, handler)
    local values, seenObjects, seenTables = {}, {}, {}
    local words = { "target", "objective", "enemy", "boss", "mob", "tree", "rock", "ice", "cactus", "wire", "pipe", "pickup", "key", "gate", "cape", "rope", "bell", "clam", "chest", "gem", "relic", "intel", "lever", "pillar", "podium", "hat", "snowball", "snowpile", "geyser", "fissure", "cauldron", "map", "checkpoint", "door", "statue", "tool", "hitbox", "trigger", "mound", "seat" }
    local function relevant(key)
        key = type(key) == "string" and key:lower() or ""
        for _, word in ipairs(words) do if key:find(word, 1, true) then return true end end
        return false
    end
    local function walk(value, key, depth)
        if depth > 5 then return end
        if typeof(value) == "Instance" then
            if value.Parent and not seenObjects[value] and (relevant(key) or self:SecretObjectMatches(value, handler)) then
                seenObjects[value] = true
                table.insert(values, { Object = value, Key = tostring(key or value.Name) })
            end
        elseif type(value) == "table" and not seenTables[value] then
            seenTables[value] = true
            for childKey, child in pairs(value) do walk(child, childKey, depth + 1) end
        end
    end
    if moment then
        walk(moment.MiscData, "MiscData", 0)
        walk(moment.MomentData, "MomentData", 0)
    end
    return values
end

function Hub:SecretObjectDone(row, object, handler)
    if not object or not object.Parent then return true end
    local state = row and self.SecretActions and self.SecretActions[row.Address]
    for resolved in pairs(state and state.ResolvedObjects or {}) do
        if resolved == object or object:IsDescendantOf(resolved) or resolved:IsDescendantOf(object) then return true end
    end
    local podium = self.SecretMomentStates and row and self.SecretMomentStates[row.Name]
    podium = podium and podium.PodiumLit
    local lit = podium and podium.Args and podium.Args[1]
    if typeof(lit) == "Instance" and (lit == object or object:IsDescendantOf(lit) or lit:IsDescendantOf(object)) then return true end
    for _, name in ipairs({ "Completed", "Collected", "Solved", "Repaired", "Destroyed" }) do
        local ok, value = pcall(object.GetAttribute, object, name)
        if ok and value == true then return true end
    end
    for _, name in ipairs(handler and handler.FalseDone or {}) do
        local ok, value = pcall(object.GetAttribute, object, name)
        if ok and value == false then return true end
    end
    for name, minimum in pairs(handler and handler.NumericDone or {}) do
        local ok, value = pcall(object.GetAttribute, object, name)
        if ok and type(value) == "number" and value >= minimum then return true end
    end
    if handler and handler.InvisibleDone and object:IsA("BasePart") and object.Transparency >= 0.99 then return true end
    local ok, role = pcall(object.GetAttribute, object, "FountainWireRole")
    if ok and role ~= nil and role ~= "Broken" then return true end
    return false
end

function Hub:SecretFindCandidate(row, moment, handler, names, rotate)
    local _, _, root = self:Character()
    if not root then return nil end
    local candidates = self:SecretMomentCandidates(moment, handler)
    for _, item in ipairs(self:SecretWorldCandidates(row, handler)) do table.insert(candidates, item) end
    local options, seen = {}, {}
    for _, item in ipairs(candidates) do
        local matches = names and self:SecretObjectMatches(item.Object, handler, names) or self:SecretObjectMatches(item.Object, handler)
        if not seen[item.Object] and matches and not self:SecretObjectDone(row, item.Object, handler) then
            local part = self:SecretObjectPart(item.Object)
            if part then
                seen[item.Object] = true
                table.insert(options, { Record = item, Distance = (part.Position - root.Position).Magnitude })
            end
        end
    end
    if #options == 0 then return nil end
    table.sort(options, function(a, b)
        if a.Distance ~= b.Distance then return a.Distance < b.Distance end
        return a.Record.Object:GetFullName() < b.Record.Object:GetFullName()
    end)
    if not rotate then return options[1].Record, options[1].Distance end
    self.SecretActions = self.SecretActions or {}
    local state = self.SecretActions[row.Address] or {}
    self.SecretActions[row.Address] = state
    local active = state.ObjectTarget
    if active and active.Object and active.Object.Parent and not self:SecretObjectDone(row, active.Object, handler) then
        local part = self:SecretObjectPart(active.Object)
        if part then
            local distance = (part.Position - root.Position).Magnitude
            if distance > 10 then return active, distance end
            if handler.StickyUntilDone then return active, distance end
            state.ObjectSwitchAt = state.ObjectSwitchAt or os.clock() + (handler.StickSeconds or 2)
            if os.clock() < state.ObjectSwitchAt then return active, distance end
        end
    end
    state.ObjectSwitchAt = nil
    state.ObjectIndex = (state.ObjectIndex or 0) % #options + 1
    state.ObjectTarget = options[state.ObjectIndex].Record
    return state.ObjectTarget, options[state.ObjectIndex].Distance
end

function Hub:SecretPromptAllowed(prompt, handler)
    local expected = handler.Prompts or {}
    if #expected == 0 then
        local parent = prompt.Parent
        while parent and parent ~= Services.Workspace do
            if self:SecretObjectMatches(parent, handler) then return true end
            parent = parent.Parent
        end
        return false
    end
    local text = (tostring(prompt.ActionText or "") .. " " .. tostring(prompt.ObjectText or "")):lower()
    for _, value in ipairs(expected) do if text:find(tostring(value):lower(), 1, true) then return true end end
    return false
end

function Hub:SecretFindPrompt(row, handler)
    local _, _, root = self:Character()
    if not root then return nil end
    local list
    if self.SecretPromptScan and self.SecretPromptScan.Key == row.Address and os.clock() - self.SecretPromptScan.At < 0.75 then
        list = self.SecretPromptScan.Values
    else
        list = {}
        local seen = {}
        for _, prompt in ipairs(Services.CollectionService:GetTagged("ProximityPrompt")) do
            if prompt:IsA("ProximityPrompt") then seen[prompt] = true; table.insert(list, prompt) end
        end
        for _, islandRoot in ipairs(self:SecretWorldRoots(row)) do
            for _, object in ipairs(islandRoot:GetDescendants()) do
                if object:IsA("ProximityPrompt") and not seen[object] then seen[object] = true; table.insert(list, object) end
            end
        end
        self.SecretPromptScan = { Key = row.Address, At = os.clock(), Values = list }
    end
    local definition = self.IslandDefinitions and self.IslandDefinitions[row.Island]
    local island = Compat.islandCFrame(definition)
    local best, score
    for _, prompt in ipairs(list) do
        if prompt.Parent and prompt.Enabled and self:SecretPromptAllowed(prompt, handler) then
            local part = self:SecretObjectPart(prompt.Parent)
            if part and (not island or (part.Position - island.Position).Magnitude < 1400) then
                local distance = (root.Position - part.Position).Magnitude
                if not best or distance < score then best, score = prompt, distance end
            end
        end
    end
    return best, score
end

function Hub:SecretUsePrompt(row, prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local _, _, root = self:Character()
    local part = self:SecretObjectPart(prompt.Parent)
    if not root or not part then return false end
    local range = math.max(4, math.min(prompt.MaxActivationDistance or 10, 14) - 1)
    if (root.Position - part.Position).Magnitude > range then
        self:SecretStatus(row, "Interact | " .. tostring(prompt.ObjectText ~= "" and prompt.ObjectText or prompt.ActionText))
        self:MoveTo(part.CFrame + Vector3.new(0, 2, 0))
        return true
    end
    if os.clock() < (self.NextSecretPrompt or 0) then return true end
    self.NextSecretPrompt = os.clock() + 0.8
    local used = false
    if type(fireproximityprompt) == "function" then used = pcall(fireproximityprompt, prompt) end
    if not used then
        used = pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.max(prompt.HoldDuration or 0, 0.05))
            prompt:InputHoldEnd()
        end)
    end
    self:SecretStatus(row, used and "Interact | Triggered" or "Interact | Input unavailable")
    return true
end

function Hub:SecretTool(handler, state)
    local char = Player.Character
    local backpack = Player:FindFirstChild("Backpack")
    if handler.Tool then
        local exact = (char and char:FindFirstChild(handler.Tool)) or (backpack and backpack:FindFirstChild(handler.Tool))
        if Compat.isA(exact, "Tool") then return self:Equip(exact.Name) end
        return nil
    end
    local required = state.RequiredWeaponType
    state.RequiredWeaponMissing = nil
    local wanted = required and { required } or handler.WeaponCycle or handler.WeaponTypes
    if type(wanted) == "table" and #wanted > 0 then
        local start = 1
        if handler.WeaponCycle and not required then
            state.WeaponIndex = (state.WeaponIndex or 0) % #wanted + 1
            start = state.WeaponIndex
        end
        for offset = 0, #wanted - 1 do
            local kind = wanted[(start + offset - 1) % #wanted + 1]
            for _, container in ipairs({ char, backpack }) do
                for _, tool in ipairs(container and container:GetChildren() or {}) do
                    local toolKind = tool:IsA("Tool") and (tool:GetAttribute("WeaponType") or tool.ToolTip)
                    if toolKind == kind or ((kind == "Fruit" or kind == "Demon Fruit") and (toolKind == "Fruit" or toolKind == "Blox Fruit" or toolKind == "Demon Fruit")) then return self:Equip(tool.Name) end
                end
            end
        end
    end
    if required then state.RequiredWeaponMissing = true; return nil end
    return self:SelectTool()
end

function Hub:SecretStrike(row, handler, record)
    local object = record and record.Object
    local preferred = object and handler.PreferredPart and object:FindFirstChild(handler.PreferredPart, true)
    local part = self:SecretObjectPart(preferred or object)
    local _, _, root = self:Character()
    if not part or not root then return false end
    local state = self.SecretActions[row.Address] or {}
    local tool = self:SecretTool(handler, state)
    if not tool then self:SecretStatus(row, "Objective | Weapon required"); return true end
    local kind = tool:GetAttribute("WeaponType") or tool.ToolTip
    local ranged = kind == "Gun" or kind == "Demon Fruit" or kind == "Blox Fruit"
    local range = ranged and 55 or 8
    if (root.Position - part.Position).Magnitude > range then
        local offset = ranged and 35 or 4
        local goal = CFrame.lookAt(part.Position + Vector3.new(0, 2, offset), part.Position)
        self:SecretStatus(row, "Objective | Strike " .. object.Name)
        self:MoveTo(goal)
        return true, false
    end
    if os.clock() < (state.NextStrike or 0) then return true, false end
    state.NextStrike = os.clock() + (handler.StrikeRate or 0.2)
    self.SecretStrikeTarget = part
    self:InstallAimAdapter()
    pcall(function() root.CFrame = CFrame.lookAt(root.Position, Vector3.new(part.Position.X, root.Position.Y, part.Position.Z)) end)
    local controller = self:Module("CombatController", { "Controllers", "CombatController" })
    local nativeReady = controller and type(controller.Attack) == "function" and self:NativeWeaponData(tool)
    local input = nativeReady and self:NewInput() or nil
    local ok
    if input then
        ok = self:Call("auto-secret:strike", 3, 0.12, function()
            if not self:NativeWeaponData(tool) then return false end
            return controller:Attack(tool, input)
        end)
        input:Release()
    else
        ok = pcall(tool.Activate, tool)
    end
    self.SecretStrikeTarget = nil
    self:SecretStatus(row, ok and "Objective | Striking " .. object.Name or "Objective | Attack unavailable")
    return true, ok == true
end

