do
	local v71 = GRP_Main_Tyrant_of_the_Skies:AddParagraph({
		Title = "Eyes Status",
		Content = ""
	})

	Check_Eye = function()
		local ok, result = pcall(function()
			return workspace.Map.TikiOutpost.IslandModel
		end)

		if not ok or not result then
			return 0, false
		end

		local Eye1 = result:FindFirstChild("Eye1")
		local Eye2 = result:FindFirstChild("Eye2")
		local E = result:FindFirstChild("IslandChunks") and result.IslandChunks:FindFirstChild("E")

		E = E and result.IslandChunks.E:FindFirstChild("Eye3")

		local Eye4 = result:FindFirstChild("IslandChunks") and result.IslandChunks:FindFirstChild("E") and result.IslandChunks.E:FindFirstChild("Eye4")
		local t4 = {
			Eye1,
			Eye2,
			E,
			Eye4
		}
		local n1 = 0

		for _, v in ipairs(t4) do
			if v and v.Transparency ~= 1 then
				n1 += 1
			end
		end

		return n1, n1 == 4
	end
	task.spawn(function()
		while task.wait(1) do
			pcall(function()
				local v82 = Check_Eye()

				v71:SetDesc("Eyes: " .. v82 .. "/4")
			end)
		end
	end)
end

