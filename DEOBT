function Hub:SecretStatueSkill(tool, state, target)
    if not tool or not target or os.clock() < (state.StatueSkillAt or 0) then return false end
    local keys = { "Z", "X", "C", "V", "F" }
    for offset = 1, #keys do
        local index = ((state.StatueSkillIndex or 0) + offset - 1) % #keys + 1
        local key = keys[index]
        if self:SkillReady(tool.Name, key) then
            local unlocked = true
            pcall(function()
                local info = tool:FindFirstChild("Data") and require(tool.Data)
                local required = info and info.Lvl and info.Lvl[key]
                local level = tool:FindFirstChild("Level")
                if required and level then unlocked = level.Value >= required end
            end)
            if unlocked then
                state.StatueSkillIndex = index
                state.StatueSkillAt = os.clock() + 0.7
                self.SecretStrikeTarget = target
                self:PressKey(key)
                self.SecretStrikeTarget = nil
                return true
            end
        end
    end
    state.StatueSkillAt = os.clock() + 0.4
    return false
end

function Hub:SecretStatues(row, handler, state)
    local client = self:Module("PodiumClient", { "ClientComponents", "PodiumClient" })
    local list = {}
    if client and type(client.GetAll) == "function" then
        local ok, values = pcall(client.GetAll, client)
        if ok and type(values) == "table" then list = values end
    end
    local _, _, root = self:Character()
    local options = {}
    state.StatueDoneTypes = state.StatueDoneTypes or {}
    for _, podium in pairs(list) do
        if type(podium) == "table" and type(podium.PodiumType) == "string" and podium.Freed ~= true
            and state.StatueDoneTypes[podium.PodiumType] ~= true then
            local model
            if type(podium.GetModel) == "function" then
                local ok, value = pcall(podium.GetModel, podium)
                if ok then model = value end
            end
            local object = typeof(podium.Instance) == "Instance" and podium.Instance or model
            local part = self:SecretObjectPart(object)
            if part and root and not self:SecretObjectDone(row, object, handler) then
                table.insert(options, { Podium = podium, Object = object, Part = part,
                    Type = podium.PodiumType, Distance = (part.Position - root.Position).Magnitude })
            end
        end
    end
    table.sort(options, function(a, b)
        local aPriority = a.Type == state.StatueTargetType and 0 or 1
        local bPriority = b.Type == state.StatueTargetType and 0 or 1
        if aPriority ~= bPriority then return aPriority < bPriority end
        if a.Distance ~= b.Distance then return a.Distance < b.Distance end
        return a.Type < b.Type
    end)
    local chosen = options[1]
    if not chosen then
        state.RequiredWeaponType, state.StatueTargetType = nil, nil
        self:SecretStatus(row, "Statues | Waiting for next unlit podium")
        return true
    end
    state.StatueTargetType = chosen.Type
    state.RequiredWeaponType = chosen.Type
    local handled, attacked = self:SecretStrike(row, handler, { Object = chosen.Object, Key = chosen.Type })
    local char, _, myRoot = self:Character()
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not state.RequiredWeaponMissing and myRoot and (myRoot.Position - chosen.Part.Position).Magnitude <= 55 then
        self:SecretStatueSkill(tool, state, chosen.Part)
    end
    self:SecretStatus(row, state.RequiredWeaponMissing and ("Statues | Missing " .. chosen.Type)
        or ("Statues | " .. chosen.Type .. " | M1 + skills"))
    return handled, attacked
end

