function Hub:WebhookTick()
    if not self.Config["Webhook Enabled"] or not self:WebhookURL() then return end
    self.WebhookBosses = self.WebhookBosses or {}
    local watchers = {
        { Event = "Pumpkin Boss Kill", Label = "Dapper Jack (Great Pumpkin)", Match = function(lower)
            return lower:find("dapper", 1, true) ~= nil
        end },
        { Event = "Hellfire Gas Kill", Label = "Hellfire Gas", Match = function(lower)
            return lower == "hellfire gas"
        end },
        { Event = "Wolf Boss Kill", Label = "Werewolf Boss", Match = function(lower)
            return lower:find("werewolf", 1, true) ~= nil or (lower:find("wolf", 1, true) ~= nil and not lower:find("pumpkin", 1, true))
        end },
    }
    for _, watcher in ipairs(watchers) do
        local state = self.WebhookBosses[watcher.Event]
        if state and state.Model then
            if not self:AliveEnemy(state.Model) then
                if self:WebhookOn(watcher.Event) then
                    self:WebhookSend("Boss Defeated", "**" .. watcher.Label .. "** was defeated.", 16729344, self:WebhookStatFields())
                end
                self.WebhookBosses[watcher.Event] = nil
            elseif os.clock() - (state.At or 0) > 300 then
                self.WebhookBosses[watcher.Event] = nil
            end
        elseif self:WebhookOn(watcher.Event) then
            local engaged
            if watcher.Event == "Pumpkin Boss Kill" then
                engaged = self:HalloweenInDapperArena() or self.HalloweenArenaSawBoss == true
            else
                engaged = self.HalloweenBossSession ~= nil or self:HalloweenInHellfireRealm()
            end
            if engaged then
                local found = self:Enemies(function(model) return watcher.Match(model.Name:lower()) end)
                if found[1] then
                    self.WebhookBosses[watcher.Event] = { Model = found[1], At = os.clock() }
                end
            end
        end
    end
    if self:WebhookOn("Stats Report (5 min)") and os.clock() >= (self.WebhookStatsAt or 0) then
        self.WebhookStatsAt = os.clock() + 300
        self:WebhookStats(false)
    end
end

function Hub:StoreFruits(silent)
    if self.InventoryBusy then return end
    local char, hum = self:Character()
    if not char then return end
    local fruits = self:PhysicalFruits()
    local equipped = char:FindFirstChildOfClass("Tool")
    self.FruitRetry = self.FruitRetry or setmetatable({}, { __mode = "k" })
    self.InventoryBusy = true
    local count = 0
    local storedNames = {}
    local ok, problem = pcall(function()
        for _, fruit in ipairs(fruits) do
            if not self.Alive then break end
            if os.clock() >= (self.FruitRetry[fruit] or 0) and fruit.Parent then
                self.FruitRetry[fruit] = os.clock() + 15
                if fruit.Parent ~= char then hum:EquipTool(fruit) end
                local sent, result = self:Comm("StoreFruit", fruit:GetAttribute("OriginalName"), fruit)
                if sent and result == true then count += 1; self.InventoryTime = -100; table.insert(storedNames, tostring(fruit:GetAttribute("OriginalName") or fruit.Name)) end
                if not silent and sent and type(result) == "number" then self:Notify("Fruit Storage", "Storage full.") end
            end
        end
    end)
    if equipped and equipped.Parent and self.Alive then pcall(hum.EquipTool, hum, equipped) end
    self.InventoryBusy = false
    if not ok then self:Log("fruit-storage", problem) end
    if not silent then self:Notify("Fruit Storage", count .. " stored.") end
    if #storedNames > 0 and self:WebhookOn("Store Fruit") then
        self:WebhookSend("Fruit Stored", "Stored " .. #storedNames .. " fruit(s):\n- " .. table.concat(storedNames, "\n- "), 5763719, self:WebhookStatFields())
    end
end

