function Hub:TyrantEyeCount()
    local map = Services.Workspace:FindFirstChild("Map")
    local tiki = map and (map:FindFirstChild("TikiOutpost") or map:FindFirstChild("Tiki Outpost"))
    local island = tiki and tiki:FindFirstChild("IslandModel")
    if not island then return nil, 0 end
    local chunks = island:FindFirstChild("IslandChunks")
    local east = chunks and chunks:FindFirstChild("E")
    local eyes = {
        island:FindFirstChild("Eye1"),
        island:FindFirstChild("Eye2"),
        east and east:FindFirstChild("Eye3"),
        east and east:FindFirstChild("Eye4"),
    }
    for index = 1, 4 do
        if not eyes[index] then eyes[index] = island:FindFirstChild("Eye" .. index, true) end
    end
    local count, loaded = 0, 0
    for index = 1, 4 do
        local eye = eyes[index]
        if eye then
            loaded += 1
            local visible = false
            if eye:IsA("BasePart") and eye.Transparency < 0.95 then visible = true end
            if not visible then
                for _, object in ipairs(eye:GetDescendants()) do
                    if object:IsA("BasePart") and object.Transparency < 0.95 then
                        visible = true
                        break
                    end
                end
            end
            if visible then count += 1 end
        end
    end
    return count, loaded
end

function Hub:TyrantSkillTools()
    local selected = self.Config["Select Weapon"]
    local records, seen = {}, {}
    local function category(tool)
        local kind = tool:GetAttribute("WeaponType") or tool.ToolTip
        if kind == "FightingStyle" then kind = "Melee" end
        if kind == "Melee" or kind == "Sword" or kind == "Gun" then return kind end
        return nil
    end
    for _, kind in ipairs({ selected, "Melee", "Sword", "Gun" }) do
        if kind == "Blox Fruit" then continue end
        for _, parent in ipairs({ Player.Character, Player:FindFirstChild("Backpack") }) do
            for _, tool in ipairs(parent and parent:GetChildren() or {}) do
                local toolKind = Compat.isA(tool, "Tool") and category(tool) or nil
                if toolKind == kind and not seen[toolKind] then
                    seen[toolKind] = true
                    records[#records + 1] = {
                        Tool = tool,
                        Kind = toolKind,
                        Keys = toolKind == "Melee" and { "Z", "X", "C" } or { "Z", "X" },
                    }
                    break
                end
            end
            if seen[kind] then break end
        end
    end
    return records
end

function Hub:TyrantPotStep()
    local data = self.FullyBossData.Tyrant
    local char, _, root = self:Character()
    if not char or not root then return end
    local state = self.TyrantPotState
    if not state then
        state = { Point = 1, Pass = 1, Tool = 1, Key = 1, Next = 0 }
        self.TyrantPotState = state
    end
    local point = data.Points[state.Point]
    if not point then
        state.Point = 1
        state.Pass += 1
        state.Tool = 1
        state.Key = 1
        state.Arrive = nil
        state.Next = os.clock() + 1
        point = data.Points[1]
    end
    self.Target = nil
    self.AttackTarget = nil
    self.SecretStrikeTarget = point
    self:InstallAimAdapter()
    if (root.Position - point.Position).Magnitude > 7 then
        state.Arrive = nil
        self:MoveTo(point)
        self:Log("fully-tyrant", "Breaking pots | pass " .. state.Pass .. " | " .. state.Point .. "/" .. #data.Points, 4)
        return
    end
    self:CancelTween(false)
    root.CFrame = point
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if not state.Arrive then
        state.Arrive = os.clock() + 0.18
        state.Next = state.Arrive
        return
    end
    if os.clock() < math.max(state.Next or 0, state.Arrive) then return end
    local tools = self:TyrantSkillTools()
    if #tools == 0 then
        local tool = self:SelectTool()
        if tool then
            pcall(tool.Activate, tool)
            self:PressKey("Z")
        end
        state.Next = os.clock() + 0.35
        return
    end
    if state.Tool > #tools then
        state.Point += 1
        state.Tool = 1
        state.Key = 1
        state.Arrive = nil
        state.Next = os.clock() + 0.2
        return
    end
    local record = tools[state.Tool]
    local tool = record and record.Tool
    if not tool or not tool.Parent then
        state.Tool += 1
        state.Key = 1
        return
    end
    if tool.Parent ~= char then
        self:Equip(tool.Name)
        state.Next = os.clock() + 0.18
        return
    end
    if state.Key == 1 then pcall(tool.Activate, tool) end
    local key = record.Keys[state.Key]
    if key then
        self:PressKey(key)
        state.Key += 1
        state.Next = os.clock() + 0.28
        return
    end
    state.Tool += 1
    state.Key = 1
    state.Next = os.clock() + 0.12
end

function Hub:FullyTyrantStep()
    if self.Sea ~= "Sea3" then self:Log("fully-tyrant", "Third Sea required."); return end
    local data = self.FullyBossData.Tyrant
    local boss = self:Enemies(data.Boss)[1]
    if boss then
        self.TyrantPotState = nil
        self.SecretStrikeTarget = nil
        self:Fight(boss, data.Boss, false)
        return
    end
    local eyes, loaded = self:TyrantEyeCount()
    if loaded < 4 then
        self.SecretStrikeTarget = nil
        self.Target = nil
        self:MoveTo(data.Center)
        self:Log("fully-tyrant", "Streaming Tiki eyes " .. loaded .. "/4", 5)
        return
    end
    if eyes < 4 then
        self.TyrantPotState = nil
        self.SecretStrikeTarget = nil
        local mob = self:Enemies(data.Mobs)[1]
        if mob then
            self:Fight(mob, data.Mobs, true)
            self:Log("fully-tyrant", "Charging Tiki eyes " .. eyes .. "/4", 4)
        else
            self.Target = nil
            self:MoveTo(data.Center)
            self:Log("fully-tyrant", "Waiting Tiki mobs | eyes " .. eyes .. "/4", 5)
        end
        return
    end
    self:TyrantPotStep()
end

