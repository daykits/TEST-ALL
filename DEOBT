		local v323 = false

		if match ~= "" and not match:find("-") then
			local ok, result = pcall(function()
				return match:gsub("[^ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=]", ""):gsub(".", function(p60)
					if p60 == "=" then
						return ""
					end

					local s1 = ""
					local v327 = ("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"):find(p60) - 1

					for i = 6, 1, -1 do
						if v327 % 2 ^ i - v327 % 2 ^ (i - 1) > 0 then
							s1 ..= "1"
						else
							s1 ..= "0"
						end
					end

					return s1
				end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(p61)
					if #p61 ~= 8 then
						return ""
					end

					local n7 = 0

					for i = 1, 8 do
						if p61:sub(i, i) == "1" then
							n7 += 2 ^ (8 - i)
						end
					end

					return string.char(n7)
				end)
			end)

			if ok and result and result:find("-") then
				match = result
				v323 = true
			end
		end

		if match == "" then
			_G.JobId = nil
