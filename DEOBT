Hub.BringState = setmetatable({}, { __mode = "k" })
Hub.BringOwnerSwitch = setmetatable({}, { __mode = "k" })
Hub.BringFakeOwner = false
Hub.LastBring = 0
do
    local hasNativeOwner = typeof(isnetworkowner) == "function"
    local execName = ""
    pcall(function() execName = identifyexecutor and identifyexecutor() or "" end)
    if not hasNativeOwner or string.find(string.lower(execName), "cryptic", 1, true) then
        Hub.BringFakeOwner = true
        isnetworkowner = function(part)
            local valid, result = pcall(function()
                if typeof(part) ~= "Instance" or not part:IsA("BasePart") then return false end
                if not Hub.BringOwnerSwitch[part] then Hub.BringOwnerSwitch[part] = tick() end
                if typeof(gethiddenproperty) == "function" and typeof(sethiddenproperty) == "function" then
                    local ok, rule = pcall(gethiddenproperty, part, "NetworkOwnershipRule")
                    if ok and rule == Enum.NetworkOwnership.Manual then
                        pcall(sethiddenproperty, part, "NetworkOwnershipRule", Enum.NetworkOwnership.Automatic)
                        Hub.BringOwnerSwitch[part] = tick() + 4
                    end
                end
                if Hub.BringOwnerSwitch[part] > tick() then return false end
                local grounded = false
                pcall(function() grounded = part:IsGrounded() end)
                if grounded then return false end
                local rootPart = part.AssemblyRootPart
                if rootPart == nil then return false end
                return rootPart.ReceiveAge == 0
            end)
            return valid and result == true
        end
    end
end

function Hub:_releaseBring(model, state)
    self.BringState[model] = nil
    pcall(function()
        if state.hum and state.hum.Parent then state.hum.WalkSpeed = state.walkSpeed or state.hum.WalkSpeed end
        if state.collision then
            for part, saved in pairs(state.collision) do
                pcall(function() if part.Parent then part.CanCollide = saved end end)
            end
        end
    end)
end

function Hub:Bring(target, query)
    if not self.Config["ON Bring"] or not self:AliveEnemy(target) then return end
    if os.clock() - self.LastBring < 0.1 then return end
    self.LastBring = os.clock()

    local targetRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
    if not targetRoot then return end

    local range = self.Config["Bring Range"]
    local limit = self.Config["Bring Limit"] or 20
    local spacing = self.Config["Bring Spacing"] or 2.5
    local ownershipCheck = self.Config["Ownership Check"]
    local brought, seen = 0, {}

    if isnetworkowner then
        pcall(function() if typeof(setscriptable) == "function" then setscriptable(Player, "SimulationRadius", true) end end)
        pcall(function() if typeof(sethiddenproperty) == "function" then sethiddenproperty(Player, "SimulationRadius", 9999999) end end)
    end

    for _, model in ipairs(self:Enemies(query, range + 80)) do
        if brought >= limit then break end
        if model ~= target and not model:GetAttribute("Boss") and not model:GetAttribute("IsBoss") then
            local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            local hum = model:FindFirstChildOfClass("Humanoid")
            if root and hum and (root.Position - targetRoot.Position).Magnitude <= range
                and (not ownershipCheck or not isnetworkowner or isnetworkowner(root)) then
                seen[model] = true
                brought += 1
                local state = self.BringState[model]
                if not state then
                    state = { hum = hum, walkSpeed = hum.WalkSpeed, collision = {} }
                    self.BringState[model] = state
                    pcall(function() if hum:FindFirstChild("Animator") then hum.Animator:Destroy() end end)
                end
                pcall(function()
                    for _, part in ipairs(model:GetDescendants()) do
                        if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.CanCollide and not part.Name:find("Leg") then
                            if state.collision[part] == nil then state.collision[part] = part.CanCollide end
                            part.CanCollide = false
                        end
                    end
                    hum.WalkSpeed = 0
                    local angle = math.random() * math.pi * 2
                    local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * spacing
                    root.CFrame = CFrame.new(targetRoot.Position + offset) * root.CFrame.Rotation
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    end

    for model, state in pairs(self.BringState) do
        if not seen[model] then self:_releaseBring(model, state) end
    end
end

function Hub:StopBring()
    for model, state in pairs(self.BringState) do
        self:_releaseBring(model, state)
    end
end

function Hub:FarmThreat()
    local target = self.Target
    local _, _, root = self:Character()
    if not root or not self:AliveEnemy(target) then return false end
    local enemyRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
    local humanoid = target:FindFirstChildOfClass("Humanoid")
    if not enemyRoot or not humanoid then return false end
    local delta = root.Position - enemyRoot.Position
    if delta.Magnitude > self.Config["Dodge Range"] then return false end
    local facing = delta.Magnitude < 0.1 or enemyRoot.CFrame.LookVector:Dot(delta.Unit) > -0.1
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return false end
    local dangerous = false
    pcall(function()
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local length = math.max(track.Length, 0.01)
            if track.IsPlaying and track.Priority.Value >= Enum.AnimationPriority.Action.Value
                and track.TimePosition < length * 0.88 and track.Speed > 0 then
                dangerous = true
                break
            end
        end
    end)
    return dangerous and facing, enemyRoot
end

function Hub:SurvivalStep()
    local char, humanoid, root = self:Character()
    if not char or not humanoid or not root or humanoid.Health <= 0 then return false end
    local now = os.clock()
    local maximum = math.max(humanoid.MaxHealth, 1)
    local ratio = humanoid.Health / maximum * 100
    local dropped = self.SurvivalLastHealth and self.SurvivalLastHealth - humanoid.Health > maximum * 0.025
    self.SurvivalLastHealth = humanoid.Health
    if dropped then self.CombatLockAt = now end
    local recovery = self.Config["Survival Mode"] and ratio <= self.Config["Survival Health"]
    if self.SurvivalRecovering and ratio < math.min(self.Config["Survival Health"] + 18, 92) then recovery = true end
    if recovery then
        local started = not self.SurvivalRecovering
        self.SurvivalRecovering = true
        self:KenRefresh()
        if now >= (self.SurvivalDodgeAt or 0) then
            self.SurvivalDodgeAt = now + 0.65
            self:PressKey("Q")
        end
        local target = self.Target
        local enemyRoot = self:AliveEnemy(target) and (target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart) or nil
        local base = enemyRoot and (enemyRoot.Position - root.Position).Magnitude < 120 and enemyRoot.Position or root.Position
        if started or not self.SurvivalSafeCFrame then
            self.SurvivalSafeCFrame = CFrame.new(base + Vector3.new(0, 70, 28), base)
        end
        self.EvasionUntil = now + 0.4
        self.EvasionCFrame = self.SurvivalSafeCFrame
        self:TweenTo(self.SurvivalSafeCFrame, self.Config.TweenSpeed)
        self:SetInfo("SurvivalStatus", "Recovering | " .. math.floor(ratio) .. "% HP")
        return true
    end
    if self.SurvivalRecovering then
        self.SurvivalRecovering = nil
        self.SurvivalSafeCFrame = nil
        self.EvasionUntil = nil
        self:SetInfo("SurvivalStatus", "Recovered")
    end
    if not self.Config["Auto Dodge"] or not _G.onfarm then return false end
    local threat, enemyRoot = self:FarmThreat()
    if (threat or dropped) and now >= (self.SurvivalDodgeAt or 0) then
        self.SurvivalDodgeAt = now + 0.55
        self:KenRefresh()
        self:PressKey("Q")
        if enemyRoot then
            local away = root.Position - enemyRoot.Position
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude < 0.1 then
                local look = enemyRoot.CFrame.LookVector
                away = Vector3.new(-look.X, 0, -look.Z)
            end
            if away.Magnitude < 0.1 then away = Vector3.new(0, 0, 1) end
            away = away.Unit
            local side = Vector3.new(-away.Z, 0, away.X) * ((math.floor(now * 2) % 2 == 0) and 1 or -1)
            local point = enemyRoot.Position + away * 24 + side * 18 + Vector3.new(0, 10, 0)
            self.EvasionCFrame = CFrame.lookAt(point, enemyRoot.Position)
            self.EvasionUntil = now + 0.48
            self:TweenTo(self.EvasionCFrame, self.Config.TweenSpeed)
        end
        self:SetInfo("SurvivalStatus", threat and "Dodged attack animation" or "Dodged damage spike")
    end
    return false
end

function Hub:Fight(target, query, shouldBring)
    local char = self:Character()
    if not self:AliveEnemy(target) or not char then return end
    self.CombatLockAt = os.clock()
    local root = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
    if not Compat.isA(root, "BasePart") then return end
    self.Target = target
    self:SelectTool()
    if not char:FindFirstChild("HasBuso") then
        self:Comm("Buso")
    end
    if shouldBring ~= false then self:Bring(target, query) end
    local _, _, myRoot = self:Character()
    if self.SurvivalRecovering then return end
    if self.EvasionUntil and os.clock() < self.EvasionUntil and self.EvasionCFrame then
        self:TweenTo(self.EvasionCFrame, self.Config.TweenSpeed)
        return
    end
    local height = self.Config["Pos y (Farm)"]
    local offset = Vector3.new(0, height, 4)
    if self.Config["Smart Farm"] then
        local phase = os.clock() * 1.8
        local boss = target:GetAttribute("Boss") == true or target:GetAttribute("IsBoss") == true
        local radius = boss and 9 or 5
        offset = Vector3.new(math.sin(phase) * radius, height, math.cos(phase) * radius)
    end
    local position = (root.CFrame * CFrame.new(offset)).Position
    local goal = CFrame.lookAt(position, root.Position)
    if myRoot and (goal.Position - myRoot.Position).Magnitude <= 14 then
        self:CancelTween(false)
        self.LastMoveRequest = os.clock()
        local anchor = self.FarmAnchor
        local drift = anchor and (anchor.Position - goal.Position).Magnitude or math.huge
        local turned = anchor and (anchor.LookVector - goal.LookVector).Magnitude or math.huge
        if drift > 3 or turned > 0.2 or os.clock() - (self.FarmAnchorAt or 0) > 0.45 then
            local currentDistance = (goal.Position - myRoot.Position).Magnitude
            local alpha = math.clamp(0.35 + currentDistance / 30, 0.35, 0.8)
            myRoot.CFrame = myRoot.CFrame:Lerp(goal, alpha)
            myRoot.AssemblyLinearVelocity, myRoot.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            self.FarmAnchor, self.FarmAnchorAt = goal, os.clock()
        end
        return
    end
    self.FarmAnchor = nil
    self:MoveTo(goal)
end

function Hub:RefreshSpawns()
    local origin = Services.Workspace:FindFirstChild("_WorldOrigin") or Services.Workspace:FindFirstChild("WorldOrigin")
    local folder = origin and origin:FindFirstChild("EnemySpawns")
    local function append(name, cf)
        if not cf then return end
        name = Compat.normalizeName(name)
        if name == "" then return end
        local positions = self.SpawnCache[name] or {}
        self.SpawnCache[name] = positions
        for _, old in ipairs(positions) do if (old.Position - cf.Position).Magnitude < 20 then return end end
        if #positions < 24 then table.insert(positions, cf) end
    end
    if folder then
        for _, object in ipairs(folder:GetChildren()) do append(object.Name, Compat.cframe(object)) end
    end
    local enemies = Services.Workspace:FindFirstChild("Enemies")
    if enemies then
        for _, model in ipairs(enemies:GetChildren()) do
            if self:AliveEnemy(model) then
                local key = Compat.normalizeName(model.Name)
                if not self.SpawnCache[key] or #self.SpawnCache[key] == 0 then append(model.Name, Compat.cframe(model)) end
            end
        end
    end
end

function Hub:MoveToSpawn(query)
    local _, _, root = self:Character()
    if not root or type(query) == "function" then return false end
    local best, distance
    for name, positions in pairs(self.SpawnCache) do
        if Compat.nameMatches(name, query) then
            for _, position in ipairs(positions) do
                local d = (position.Position - root.Position).Magnitude
                if not distance or d < distance then best, distance = position, d end
            end
        end
    end
    if best then self:MoveTo(best * CFrame.new(0, 15, 0)); return true end
    return false
end

function Hub:Inventory(force)
    if not force and self.InventoryCache and os.clock() - self.InventoryTime < 3 then return self.InventoryCache end
    local replication = self:Module("ItemReplicationService", { "ItemReplicationService" })
    local keys = self:Module("ItemReplicationKeys", { "ItemReplicationService", "KEYS" })
    local configs = self:Module("ItemConfig", { "ItemConfig" })
    if not replication or not keys or not configs or replication.IsInitialized ~= true then return nil, "Inventory is not initialized" end
    if type(replication.GetItems) ~= "function" or type(configs.match) ~= "function" then return nil, "Inventory API unavailable" end
    local ok, records = pcall(replication.GetItems, replication, keys.QUANTITY)
    if not ok or (records ~= nil and type(records) ~= "table") then return nil, "Inventory response unavailable" end
    local result = {}
    for _, record in pairs(records or {}) do
        if type(record) == "table" and type(record.Value) == "number" and record.Value > 0 then
            local matched, option = pcall(configs.match, record.ItemId)
            local cfg
            if matched and option and type(option.asNullable) == "function" then
                local unwrapped, value = pcall(option.asNullable, option)
                if unwrapped then cfg = value end
            end
            if cfg and cfg.Index then
                local display = cfg.Display or {}
                local title = type(display.Name) == "string" and display.Name ~= "" and display.Name or cfg.Index.StorageKey
                table.insert(result, { Name = title or "?", StorageKey = cfg.Index.StorageKey,
                    ItemId = record.ItemId, NetworkedUID = record.NetworkedUID, Quantity = record.Value, Config = cfg })
            end
        end
    end
    self.InventoryCache, self.InventoryTime = result, os.clock()
    return result
end

function Hub:FindTool(name)
    if type(name) ~= "string" then return nil end
    local normalized = Compat.normalizeName(name)
    for _, parent in ipairs({ Player.Character, Player:FindFirstChild("Backpack") }) do
        if parent then
            local exact = parent:FindFirstChild(name)
            if Compat.isA(exact, "Tool") then return exact end
            for _, tool in ipairs(parent:GetChildren()) do
                if Compat.isA(tool, "Tool") and Compat.normalizeName(tool.Name) == normalized then return tool end
            end
        end
    end
    return nil
end

function Hub:ItemQuantity(name, force)
    if self:FindTool(name) then return 1 end
    local inventory, problem = self:Inventory(force)
    if not inventory then return nil, problem end
    local normalized = Compat.normalizeName(name)
    local total = 0
    for _, item in ipairs(inventory) do
        if Compat.normalizeName(item.StorageKey) == normalized or Compat.normalizeName(item.Name) == normalized then
            total += type(item.Quantity) == "number" and item.Quantity or 1
        end
    end
    return total
end

function Hub:StyleOwned(name)
    local inventory, problem = self:Inventory()
    if not inventory then return nil, nil, problem end
    local masteryAPI = self:Module("ItemReplication", { "Util", "ItemReplication" })
    local owned, mastery = false, nil
    for _, item in ipairs(inventory) do
        if item.StorageKey == name and item.Config.Moveset and item.Config.Moveset.Type == "FightingStyle" then
            owned = true
            if masteryAPI and masteryAPI.Mastery and type(masteryAPI.Mastery.readClient) == "function" then
                local ok, value = pcall(masteryAPI.Mastery.readClient, item.ItemId, item.NetworkedUID)
                if ok and type(value) == "number" then mastery = math.max(mastery or 0, value) end
            end
        end
    end
    return owned, mastery
end

