function Hub:CDKDimensionStep(kind)
    local map = Services.Workspace:FindFirstChild("Map")
    local dimension = map and map:FindFirstChild(kind)
    if not dimension then return false end
    local center = Compat.cframe(dimension)
    local targets = {}
    for _, enemy in ipairs(Services.Workspace:FindFirstChild("Enemies") and Services.Workspace.Enemies:GetChildren() or {}) do
        local part = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
        if self:AliveEnemy(enemy) and part and (not center or (part.Position - center.Position).Magnitude < 1700) then table.insert(targets, enemy) end
    end
    table.sort(targets, function(a, b)
        local _, _, root = self:Character()
        local ap, bp = a:FindFirstChild("HumanoidRootPart") or a.PrimaryPart, b:FindFirstChild("HumanoidRootPart") or b.PrimaryPart
        return root and ap and bp and (ap.Position - root.Position).Magnitude < (bp.Position - root.Position).Magnitude
    end)
    if targets[1] then self:ProgressStatus("CDK " .. kind); self:Fight(targets[1], targets[1].Name, false); return true end
    for _, object in ipairs(dimension:GetDescendants()) do
        local prompt = object:IsA("ProximityPrompt") and object or nil
        if prompt and prompt.Enabled then
            self:ProgressStatus("CDK " .. kind .. " torch")
            local parent = prompt.Parent
            self:ProgressMoveTouch(parent)
            return true
        end
    end
    self:ProgressStatus("CDK leaving " .. kind)
    local exit = dimension:FindFirstChild("Exit", true) or dimension:FindFirstChild("Teleport", true)
    if exit then self:ProgressMoveTouch(exit) end
    return true
end

