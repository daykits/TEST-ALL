				child.Fruit:FindFirstChild("AnimationController"):LoadAnimation(child.Fruit:FindFirstChild("Idle")):Play()
			end

			child.Handle.Touched:Connect(function(part)
				if part.Parent == plr.Character then
					child.Parent = plr.Backpack
				end
			end)
		end
	end
})
