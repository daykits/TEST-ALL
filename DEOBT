function Hub:CostRows(value)
    local rows = {}
    local function add(name, amount)
        if type(name) == "string" and type(amount) == "number" and amount == amount
            and amount >= 0 and amount < math.huge then
            table.insert(rows, { Name = name, Amount = amount })
        end
    end
    if type(value) ~= "table" then return rows end
    for key, item in pairs(value) do
        if type(key) == "number" and type(item) == "table" then
            add(item.Name, item.Amount)
        elseif key == "EtcItems" and type(item) == "table" then
            for _, material in pairs(item) do
                if type(material) == "table" then add(material.Name, material.Amount) end
            end
        elseif type(key) == "string" then
            if type(item) == "number" then add(key, item)
            elseif type(item) == "table" then add(key, item.Amount) end
        end
    end
    table.sort(rows, function(a, b) return a.Name < b.Name end)
    return rows
end

function Hub:CostText(cost)
    local parts = {}
    for _, row in ipairs(self:CostRows(cost)) do
        table.insert(parts, tostring(row.Amount) .. " " .. row.Name)
    end
    return #parts > 0 and table.concat(parts, ", ") or "No listed cost"
end

function Hub:CanAfford(cost, supplied)
    local rows = self:CostRows(cost)
    local inventory, problem
    if supplied == nil then inventory, problem = self:Inventory() end
    local owned = {}
    for _, item in ipairs(inventory or {}) do
        if type(item.StorageKey) == "string" and type(item.Quantity) == "number" then
            owned[item.StorageKey] = (owned[item.StorageKey] or 0) + item.Quantity
        end
    end
    for _, row in ipairs(rows) do
        local amount
        if row.Name == "Fragments" or row.Name == "Beli" or row.Name == "Valor" then
            amount = self:Value({ "Data", row.Name })
        elseif supplied then amount = supplied[row.Name]
        elseif inventory then amount = owned[row.Name] or 0 end
        if type(amount) ~= "number" then return false, problem or "Inventory unavailable." end
        if amount < row.Amount then return false, "Need " .. row.Amount .. " " .. row.Name .. "." end
    end
    return true
end

function Hub:RefreshDojo(silent)
    local ok, data = self:InvokeNet("InteractDragonQuest", { NPC = "Dojo Trainer", Command = "RequestQuest" }, 1)
    if not ok or type(data) ~= "table" then
        self:SetInfo("DojoStatus", "Unavailable")
        if not silent then self:Notify("Dojo", "Quest unavailable.") end
        return nil
    end
    self.DojoData = data
    local quest = data.Quest
    local text = data.Completed and "Completed" or (data.Timeout and "Daily limit reached" or "Unavailable")
    if type(quest) == "table" then
        text = tostring(quest.BeltName or "Dojo") .. " | " .. tostring(quest.QuestName or "Quest")
        if type(quest.Progress) == "number" and type(quest.Goal) == "number" then
            text ..= "\n" .. quest.Progress .. "/" .. quest.Goal
        end
    end
    self:SetInfo("DojoStatus", text)
    return data
end

function Hub:ClaimDojo(silent, automatic)
    if automatic and not self.Config["Auto Dojo Claim"] then return false end
    local data = self:RefreshDojo(silent)
    local quest = data and data.Quest
    if type(quest) ~= "table" or type(quest.Progress) ~= "number" or type(quest.Goal) ~= "number"
        or quest.Goal <= 0 or quest.Progress < quest.Goal then
        if not silent then self:Notify("Dojo", "Quest not ready.") end
        return false
    end
    if automatic and not self.Config["Auto Dojo Claim"] then return false end
    local ok, result = self:InvokeNet("InteractDragonQuest", { NPC = "Dojo Trainer", Command = "ClaimQuest" }, 3)
    if ok and result == true then self:SetInfo("DojoStatus", "Reward claimed"); self.InventoryTime = -100 end
    if not silent or (ok and result == true) then self:Response("Dojo", ok, result) end
    return ok and result == true
end

function Hub:RequestDragonHunt(silent, automatic)
    if automatic and not self.Config["Auto Hunter Quest"] then return false end
    local active, known = self:QuestState()
    if not known or (automatic and active ~= nil) then return false end
    local ok, state = self:InvokeNet("DragonHunter", { Context = "Check" }, 1)
    if not ok or type(state) ~= "table" then
        self:SetInfo("HunterStatus", state == "Locked" and "Locked" or "Unavailable")
        if not silent then self:Notify("Dragon Hunter", state == "Locked" and "Locked." or "Unavailable.") end
        return false
    end
    if state.Text ~= nil then
        self:SetInfo("HunterStatus", tostring(state.Text))
        return false
    end
    if state.CancelQuest and not self.Config["Replace Quest"] then
        self:SetInfo("HunterStatus", "Current quest must be replaced")
        return false
    end
    if automatic then
        if not self.Config["Auto Hunter Quest"] then return false end
        local current, ready = self:QuestState()
        if not ready or current ~= nil then return false end
    end
    local sent, result = self:InvokeNet("DragonHunter", { Context = "RequestQuest" }, 5)
    self:SetInfo("HunterStatus", sent and "Quest requested" or tostring(result))
    if not silent then self:Response("Dragon Hunter", sent, result) end
    return sent
end

