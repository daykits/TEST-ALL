function Hub:AutomationStep()
    self:DoctorStep()
    if not self:Character() then self:SeaCancelBoatTween(); self.Target = nil; return end
    self:RaceAutoTick()
    self:MultiHeartbeat()
    if self:SurvivalStep() then return end
    if self.ManualBusy or self.InventoryBusy then return end
    if self.ManualDestination then
        self.Target = nil
        if os.clock() > self.ManualDeadline or self:MoveTo(self.ManualDestination) then
            self.ManualDestination = nil; self:CancelMove()
        end
        return
    end
    local enabled = {}
    for _, key in ipairs(self:GetSeaFarmKeys()) do if self.Config[key] then table.insert(enabled, key) end end
    local mode = self:PickStackMode(enabled)
    if self.ActiveMode ~= mode then
        if self.ActiveMode == "Fish" and mode ~= "Fish" then self:FishCleanup() end
        if self.SeaStopBoatControls then self:SeaStopBoatControls() end
        self.SecretStrikeTarget = nil
        self.ActiveMode = mode; self.Target = nil; self.Route = nil
        self.WorldPortalRoute, self.SubmergedTransitUntil = nil, nil
        self:CancelMove()
    end
    _G.onfarm = mode ~= nil
    if self:MasteryStep() then return end
    self:RunMode(mode)
end

function Hub:RestoreVisualBag(name)
    local bag = self[name]
    if not bag then return end
    for object, properties in pairs(bag) do
        if object and object.Parent then
            for property, value in pairs(properties) do pcall(function() object[property] = value end) end
        end
    end
    self[name] = nil
end

function Hub:RememberVisual(name, object, property)
    self[name] = self[name] or setmetatable({}, { __mode = "k" })
    local properties = self[name][object]
    if not properties then properties = {}; self[name][object] = properties end
    if properties[property] == nil then properties[property] = object[property] end
end

function Hub:SetLowFX(object)
    if not object or not object.Parent then return end
    if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
        or object:IsA("Smoke") or object:IsA("Fire") or object:IsA("Sparkles") then
        self:RememberVisual("VisualFXOriginal", object, "Enabled")
        object.Enabled = false
    end
end

function Hub:ResetVisuals()
    local lighting = Services.Lighting
    if self.VisualLightOriginal then
        for property, value in pairs(self.VisualLightOriginal) do pcall(function() lighting[property] = value end) end
        self.VisualLightOriginal = nil
    end
    if self.VisualFogOriginal then
        for property, value in pairs(self.VisualFogOriginal) do pcall(function() lighting[property] = value end) end
        self.VisualFogOriginal = nil
    end
    self:RestoreVisualBag("VisualAtmosphereOriginal")
    self:RestoreVisualBag("VisualBlurOriginal")
    self:RestoreVisualBag("VisualFXOriginal")
    if self.VisualGrade then self.VisualGrade:Destroy(); self.VisualGrade = nil end
    if self.VisualBloom then self.VisualBloom:Destroy(); self.VisualBloom = nil end
    if self.TargetVisual then self.TargetVisual:Destroy(); self.TargetVisual = nil end
    local camera = Services.Workspace.CurrentCamera
    if camera and self.VisualFOVOriginal then camera.FieldOfView = self.VisualFOVOriginal end
    self.VisualFOVOriginal = nil
    self.VisualFullBrightOn, self.VisualNoFogOn = nil, nil
    self.VisualNoBlurOn, self.VisualLowFXOn = nil, nil
end

function Hub:VisualStep()
    local lighting = Services.Lighting
    if self.Config["Full Bright"] then
        if not self.VisualFullBrightOn then
            self.VisualFullBrightOn = true
            self.VisualLightOriginal = {
                Brightness = lighting.Brightness, ClockTime = lighting.ClockTime,
                Ambient = lighting.Ambient, OutdoorAmbient = lighting.OutdoorAmbient,
                GlobalShadows = lighting.GlobalShadows,
            }
        end
        lighting.Brightness = 3
        lighting.ClockTime = 14
        lighting.Ambient = Color3.fromRGB(178, 178, 178)
        lighting.OutdoorAmbient = Color3.fromRGB(155, 155, 155)
        lighting.GlobalShadows = false
    elseif self.VisualFullBrightOn then
        if self.VisualLightOriginal then
            for property, value in pairs(self.VisualLightOriginal) do pcall(function() lighting[property] = value end) end
        end
        self.VisualLightOriginal, self.VisualFullBrightOn = nil, nil
    end
    if self.Config["No Fog"] then
        if not self.VisualNoFogOn then
            self.VisualNoFogOn = true
            self.VisualFogOriginal = { FogStart = lighting.FogStart, FogEnd = lighting.FogEnd, FogColor = lighting.FogColor }
        end
        lighting.FogStart = 100000
        lighting.FogEnd = 1000000
        for _, object in ipairs(lighting:GetDescendants()) do
            if object:IsA("Atmosphere") then
                self:RememberVisual("VisualAtmosphereOriginal", object, "Density")
                self:RememberVisual("VisualAtmosphereOriginal", object, "Haze")
                object.Density = 0
                object.Haze = 0
            end
        end
    elseif self.VisualNoFogOn then
        if self.VisualFogOriginal then
            for property, value in pairs(self.VisualFogOriginal) do pcall(function() lighting[property] = value end) end
        end
        self.VisualFogOriginal, self.VisualNoFogOn = nil, nil
        self:RestoreVisualBag("VisualAtmosphereOriginal")
    end
    local camera = Services.Workspace.CurrentCamera
    if self.Config["No Blur"] then
        self.VisualNoBlurOn = true
        for _, root in ipairs({ lighting, camera }) do
            for _, object in ipairs(root and root:GetDescendants() or {}) do
                if object:IsA("BlurEffect") or object:IsA("DepthOfFieldEffect") then
                    self:RememberVisual("VisualBlurOriginal", object, "Enabled")
                    object.Enabled = false
                end
            end
        end
    elseif self.VisualNoBlurOn then
        self.VisualNoBlurOn = nil
        self:RestoreVisualBag("VisualBlurOriginal")
    end
    if not self.VisualFXConnection then
        self.VisualFXConnection = self:Connect(Services.Workspace.DescendantAdded, function(object)
            if self.Config["Low FX"] then self:SetLowFX(object) end
        end)
    end
    if self.Config["Low FX"] then
        if not self.VisualLowFXOn then
            self.VisualLowFXOn = true
            for _, object in ipairs(Services.Workspace:GetDescendants()) do self:SetLowFX(object) end
        end
    elseif self.VisualLowFXOn then
        self.VisualLowFXOn = nil
        self:RestoreVisualBag("VisualFXOriginal")
    end
    if self.Config["Cinematic Color"] then
        if not self.VisualGrade then
            local grade = Instance.new("ColorCorrectionEffect")
            grade.Name = "BaconVisualGrade"
            grade.Brightness = 0.025
            grade.Contrast = 0.12
            grade.Saturation = 0.14
            grade.TintColor = Color3.fromRGB(255, 244, 229)
            grade.Parent = lighting
            self.VisualGrade = grade
        end
        if not self.VisualBloom then
            local bloom = Instance.new("BloomEffect")
            bloom.Name = "BaconVisualBloom"
            bloom.Intensity = 0.28
            bloom.Size = 28
            bloom.Threshold = 1.35
            bloom.Parent = lighting
            self.VisualBloom = bloom
        end
    else
        if self.VisualGrade then self.VisualGrade:Destroy(); self.VisualGrade = nil end
        if self.VisualBloom then self.VisualBloom:Destroy(); self.VisualBloom = nil end
    end
    if self.Config["Target Highlight"] and self:AliveEnemy(self.Target) then
        if not self.TargetVisual then
            self.TargetVisual = Instance.new("Highlight")
            self.TargetVisual.Name = "BaconTargetHighlight"
            self.TargetVisual.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            self.TargetVisual.FillTransparency = 0.72
            self.TargetVisual.OutlineTransparency = 0.08
            self.TargetVisual.Parent = Services.Workspace
        end
        local humanoid = self.Target:FindFirstChildOfClass("Humanoid")
        local ratio = humanoid and humanoid.Health / math.max(humanoid.MaxHealth, 1) or 1
        local color = Color3.fromHSV(math.clamp(ratio, 0, 1) * 0.32, 0.9, 1)
        self.TargetVisual.Adornee = self.Target
        self.TargetVisual.FillColor = color
        self.TargetVisual.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.4)
    elseif self.TargetVisual then
        self.TargetVisual:Destroy()
        self.TargetVisual = nil
    end
    if camera and self.Config["Custom FOV"] then
        if not self.VisualFOVOriginal then self.VisualFOVOriginal = camera.FieldOfView end
        camera.FieldOfView = self.Config["Camera FOV"]
    elseif camera and self.VisualFOVOriginal then
        camera.FieldOfView = self.VisualFOVOriginal
        self.VisualFOVOriginal = nil
    end
end

function Hub:GetShowItems()
    local itemConfig = self:Module("ItemConfig", { "ItemConfig" })
    local itemId = self:Module("ItemId", { "Economy", "ItemId" })
    local remoteUtil = self:Module("InventoryRemoteUtil", { "Controllers", "UI", "Inventory", "RemoteUtil" })
    local imageUtil = self:Module("ImageUtil", { "Modules", "Asset", "ImageUtil" })
    if not itemConfig or not itemId or not remoteUtil or not imageUtil then return {} end
    local ok, tiles = self:Call("show-items", 10, 0.5, function()
        local future = remoteUtil.getTiles()
        if not future or type(future.await) ~= "function" then return nil end
        return future:await()
    end)
    if not ok or type(tiles) ~= "table" then return {} end
    local items = {}
    for _, tile in pairs(tiles) do
        pcall(function()
            local data = itemId.getDataFromId(tile.ItemId)
            if not data or not data:isOk() then return end
            local itemData = data:unwrap()
            local option = itemConfig.match(tile.ItemId)
            local config = option and option:asNullable()
            if not config then return end
            local name = (config.Display and config.Display.Name) or itemData.StorageKey or "?"
            local image = imageUtil.getImageFromItemId(tile.ItemId)
            if image and image.Icon and image.Icon.Image then
                table.insert(items, {
                    name = name, imageId = image.Icon.Image,
                    imageRectOffset = image.Icon.ImageRectOffset, imageRectSize = image.Icon.ImageRectSize,
                    group = config.Moveset and config.Moveset.Type == "FightingStyle" and "Melee" or "Other",
                })
            end
        end)
    end
    table.sort(items, function(a, b) return tostring(a.name) < tostring(b.name) end)
    return items
end

function Hub:BuildItemsUI()
    if not self.Config.ShowItems then
        if self.ItemsGui then self.ItemsGui.Enabled = false end
        return
    end
    local guiParent = Player:FindFirstChild("PlayerGui")
    if not guiParent then return end
    if not self.ItemsGui or not self.ItemsGui.Parent then
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "BaconShowItemsGui"
        screenGui.ResetOnSpawn = false
        screenGui.Enabled = true
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.Parent = guiParent
        local scroll = Instance.new("ScrollingFrame")
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.Size = UDim2.new(1, 0, 1, 0)
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.ScrollBarThickness = 6
        scroll.Parent = screenGui
        self.ItemsGui, self.ItemsScroll = screenGui, scroll
        Environment._BaconShowItemsGui = screenGui
        Environment._BaconShowItemsRebuild = function()
            if self.Alive then self:Action("Items", function() self:BuildItemsUI() end) end
        end
    end
    local screenGui, scroll = self.ItemsGui, self.ItemsScroll
    screenGui.Enabled = true
  if not screenGui or not screenGui.Parent then return end
  for _, c in ipairs(scroll:GetChildren()) do c:Destroy() end
  local items = self:GetShowItems()
  local groups = {}
  for _, item in ipairs(items) do
   local g = item.group or "Other"
   groups[g] = groups[g] or {}
   table.insert(groups[g], item)
  end
  local ordered = {}
  for _, g in ipairs({"Melee", "Other"}) do
   if groups[g] and #groups[g] > 0 then
    ordered[#ordered + 1] = groups[g]
    groups[g] = nil
   end
  end
  for _, list in pairs(groups) do
   ordered[#ordered + 1] = list
  end
  local cardW, cardH, gap = 52, 58, 6
  local cols = math.max(5, math.floor(1000 / (cardW + gap)))
  local y, maxW = 0, 0
  for _, sec in ipairs(ordered) do
   y = y + 12
   local row, col = 0, 0
   for _, item in ipairs(sec) do
    local cx = col * (cardW + gap)
    local cy = y + row * (cardH + gap)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(0, cardW, 0, cardH)
    card.Position = UDim2.new(0, cx, 0, cy)
    card.BackgroundTransparency = 1
    card.ZIndex = 2
    card.Parent = scroll
    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(0, cardW - 6, 0, cardW - 6)
    img.Position = UDim2.new(0, 3, 0, 3)
    img.BackgroundTransparency = 1
    img.ScaleType = Enum.ScaleType.Stretch
    img.ZIndex = 3
    img.Image = item.imageId
    if item.imageRectOffset then img.ImageRectOffset = item.imageRectOffset end
    if item.imageRectSize then img.ImageRectSize = item.imageRectSize end
    img.Parent = card
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0.95, 0, 0.3, 0)
    nameLabel.Position = UDim2.new(0.025, 0, 0.35, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = math.max(7, math.floor(cardW / 7.5))
    nameLabel.Text = item.name
    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    nameLabel.TextYAlignment = Enum.TextYAlignment.Center
    nameLabel.TextStrokeTransparency = 0.35
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.ZIndex = 4
    nameLabel.Parent = card
    col = col + 1
    if col >= cols then
     col = 0
     row = row + 1
    end
   end
   y = y + (row + 1) * (cardH + gap) + 6
   maxW = math.max(maxW, (cols * (cardW + gap)) - gap + 10)
  end
  scroll.CanvasSize = UDim2.new(0, math.max(maxW, 1000), 0, y)
end

function Hub:StopAutomation()
    self.ActionGeneration = (self.ActionGeneration or 0) + 1
    for _, key in ipairs(self.FarmKeys) do self:SetConfig(key, false) end
    for _, key in ipairs({ "Fast Attack", "M1 Fruits", "Gun", "Auto Store Fruit", "Auto Awaken",
        "Auto Melee", "Auto Defense", "Auto Sword", "Auto Gun", "Auto Fruit", "Auto Dojo Claim", "Auto Hunter Quest",
        "Auto V3", "Auto V4" }) do
        self:SetConfig(key, false)
    end
    self.Target, self.AttackTarget, self.ForcedWeapon = nil, nil, nil
    self.ManualDestination, self.ElectricState, self.Route = nil, nil, nil
    self.WorldPortalRoute, self.SubmergedTransitUntil = nil, nil
    if self.ResetFullyBossState then self:ResetFullyBossState() end
    if self.FishCleanup then self:FishCleanup() end
    if self.SeaStopBoatControls then self:SeaStopBoatControls() end
