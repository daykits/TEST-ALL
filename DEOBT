        if key then return "K" .. key end
        local num = string.match(text, "ItemId=(%d+)")
        if num then return "I" .. num end
    end
    local out
    pcall(function()
        if type(value.StorageKey) == "string" then out = "K" .. value.StorageKey
        elseif type(value.Id) == "number" then out = "I" .. value.Id end
    end)
    return out or text
end
