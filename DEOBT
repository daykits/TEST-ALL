function Hub:InteractSelectedSecret()
    local selected = self:SelectedSecret()
    if not selected or self.Sea ~= "Sea1" then return end
    local moment = self:GetMoment(selected.Name)
    if not moment then self:Notify("Secrets", "Travel to the island first."); return end
    if selected.Name == "Rescue Hasan" then
        if moment.Progress == 1 then self:Notify("Hasan", "Waves complete; waiting for native completion"); return end
        local ok, result = self:Call("secret:Hasan", 5, 3, function() return moment:FireServer("StartWaves") end)
        self:Response("Hasan", ok, result)
    elseif selected.Name == "King's Apprentice" then
        local checked, state = self:Call("secret:ApprenticeState", 5, 1, function() return moment:InvokeServer("State") end)
        if checked and type(state) == "table" and state.Won == true then
            local group = self:SecretNPCEntry(selected)
            if group then self:ClaimGuideReward(group) else self:Notify("Arena", "Move to Colosseum Emperor") end
            return
        end
        local ok, result = self:Call("secret:Apprentice", 5, 3, function() return moment:FireServer("StartMatch") end)
        self:Response("Arena", ok, result)
    elseif selected.Name == "Prickly Harvest" then
        local group = self:SecretNPCEntry(selected)
        if group then self:ClaimGuideReward(group) else self:InteractNearestPrompt() end
    elseif selected.Name == "Lookout" then
        local dialogue = self:Module("LookoutDialogue", { "DialoguesList", "NPCs", "Lookout" })
        local controller = self:Module("DialogueController", { "DialogueController" })
        if not dialogue or not controller or type(controller.start) ~= "function" then
            self:Notify("Lookout", "Unavailable."); return
        end
        local ok, result = self:Call("secret:Lookout", 10, 2, function() return controller.start(dialogue) end)
        if not ok then self:Notify("Lookout", result) end
    else self:InteractNearestPrompt() end
end

function Hub:InteractNearestPrompt()
    local _, _, root = self:Character()
    if not root then return end
    if type(fireproximityprompt) ~= "function" then self:Notify("Interact", "Prompt input unavailable."); return end
    local best, distance
    local map = Services.Workspace:FindFirstChild("Map")
    if not map then return end
    for _, object in ipairs(map:GetDescendants()) do
        if object:IsA("ProximityPrompt") and object.Enabled then
            local cf = Compat.cframe(object.Parent)
            if cf then
                local d = (root.Position - cf.Position).Magnitude
                if d <= object.MaxActivationDistance and (not distance or d < distance) then best, distance = object, d end
            end
        end
    end
    if best then fireproximityprompt(best) else self:Notify("Interact", "No nearby prompt.") end
end

