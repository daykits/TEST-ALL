function Hub:NewInput()
    local event = Instance.new("BindableEvent")
    local input = { UserInputType = Enum.UserInputType.MouseButton1,
        UserInputState = Enum.UserInputState.Begin, KeyCode = Enum.KeyCode.ButtonR2,
        Position = Vector2.new(0, 0), Changed = event.Event, Destroyed = false }
    function input:GetPropertyChangedSignal(_) return event.Event end
    function input:Release()
        if not self.Destroyed and self.UserInputState ~= Enum.UserInputState.End then
            self.UserInputState = Enum.UserInputState.End
            event:Fire("UserInputState")
        end
    end
    function input:Destroy()
        if self.Destroyed then return end
        self:Release(); self.Destroyed = true; event:Destroy()
    end
    self.Inputs[input] = input
    task.delay(0.14, function() input:Release() end)
    task.delay(5, function() input:Destroy(); self.Inputs[input] = nil end)
    return input
end

function Hub:InstallAimAdapter()
    if self.TargetPatch then return end
    local combat = self:Module("CombatUtil", { "Modules", "CombatUtil" })
    if not combat or type(combat.GetTargetPosition) ~= "function" then return end
    local original = combat.GetTargetPosition
    local patch = function(object, origin, destination, maxRange, ...)
        local secretTarget = self.SecretStrikeTarget
        local secretCF = secretTarget and Compat.cframe(secretTarget)
        if self.Alive and secretCF then
            destination = secretCF.Position
        else
            local target = self.AttackTarget
            if self.Alive and target and target.Parent then
                local isPumpkin = target.Parent.Name == "PumpkinHunt"
                if isPumpkin or self:AliveEnemy(target) then
                    local root = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                    if not root and isPumpkin then root = self:HalloweenPumpkinHitPart(target) end
                    if root then destination = root.Position end
                end
            end
        end
        return original(object, origin, destination, maxRange, ...)
    end
    local ok = pcall(function() combat.GetTargetPosition = patch end)
    if ok then self.CombatUtil = combat; self.OriginalTargetPosition = original; self.TargetPatch = patch end
end

