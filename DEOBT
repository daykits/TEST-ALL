function Hub:TryHallowBoneTrade()
    local now = os.clock()
    if now < (self.NextSoulBoneTrade or 0) then return false, self.SoulBoneState end
    self.NextSoulBoneTrade = now + 5
    local ok, bones, shop, left, cooldown, maximum = self:Comm("Bones", "Check")
    if not ok then
        self.SoulBoneState = "Death King unavailable"
        return false, self.SoulBoneState
    end
    bones = type(bones) == "number" and bones or 0
    left = type(left) == "number" and left or 0
    maximum = type(maximum) == "number" and maximum or 0
    if left <= 0 then
        self.NextSoulBoneTrade = now + 30
        self.SoulBoneState = "Death King cooldown " .. tostring(cooldown or "?") .. "m"
        self:Log("fully-soul", self.SoulBoneState, 15)
        return false, self.SoulBoneState
    end
    local offers = type(shop) == "table" and (shop[1] or shop["1"]) or nil
    local selectedIndex, selectedEntry, selectedScore
    for index, entry in pairs(type(offers) == "table" and offers or {}) do
        if type(entry) == "table" and type(entry[1]) == "string" then
            local label = entry[1]:lower()
            local score = 0
            if label:find("hallow essence", 1, true) then score = 3
            elseif label:find("random surprise", 1, true) then score = 2
            elseif label:find("surprise", 1, true) then score = 1 end
            if score > 0 and (not selectedScore or score > selectedScore) then
                selectedIndex, selectedEntry, selectedScore = index, entry, score
            end
        end
    end
    if not selectedIndex then
        self.SoulBoneState = "Hallow roll is not offered"
        self:Log("fully-soul", self.SoulBoneState, 15)
        return false, self.SoulBoneState
    end
    local cost = type(selectedEntry[2]) == "number" and selectedEntry[2] or math.huge
    if bones < cost then
        self.SoulBoneState = tostring(bones) .. "/" .. tostring(cost) .. " Bones"
        return false, self.SoulBoneState
    end
    self.NextSoulBoneTrade = now + 1.2
    local sent, result = self:Comm("Bones", "Buy", 1, selectedIndex)
    if sent then self.InventoryTime = -100 end
    if sent and result == 1 then
        self.SoulBoneState = "Traded " .. tostring(selectedEntry[1]) .. " | " .. tostring(left - 1) .. "/" .. tostring(maximum)
        self:Log("fully-soul", self.SoulBoneState, 3)
        return true, self.SoulBoneState
    end
    self.SoulBoneState = sent and ("Death King result " .. tostring(result)) or tostring(result)
    self:Log("fully-soul", self.SoulBoneState, 8)
    return false, self.SoulBoneState
end

function Hub:FullySoulReaperStep()
    if self.Sea ~= "Sea3" then self:Log("fully-soul", "Third Sea required."); return end
    self.SecretStrikeTarget = nil
    local data = self.FullyBossData.Soul
    local boss = self:Enemies(data.Boss)[1]
    if boss then
        self.SoulSpawnStartedAt = nil
        self.SoulSpawnHadEssence = nil
        self.SoulSpawnAwaitUntil = nil
        self:Fight(boss, data.Boss, false)
        return
    end
    local char, _, root = self:Character()
    if not char or not root then return end
    local essence = self:FindTool("Hallow Essence")
    if essence then
        self.SoulSpawnHadEssence = true
        self.SoulSpawnAwaitUntil = nil
        if (root.Position - data.Altar.Position).Magnitude > 8 then
            self.Target = nil
            self:MoveTo(data.Altar)
            self:Log("fully-soul", "Moving Hallow Essence to altar", 5)
            return
        end
        self:CancelTween(false)
        self:Equip(essence.Name)
        self.SoulSpawnStartedAt = self.SoulSpawnStartedAt or os.clock()
        local elapsed = os.clock() - self.SoulSpawnStartedAt
        local phase = math.floor(elapsed * 4) % 4
        local offsets = { Vector3.new(0, 0, 0), Vector3.new(1.5, 0, 0), Vector3.new(0, 0, 1.5), Vector3.new(-1.5, 0, 0) }
        local goal = data.Altar + offsets[phase + 1]
        root.CFrame = goal
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        self.Target = nil
        self:Log("fully-soul", "Spawning Soul Reaper", 4)
        return
    end
    if self.SoulSpawnHadEssence then
        self.SoulSpawnHadEssence = nil
        self.SoulSpawnStartedAt = nil
        self.SoulSpawnAwaitUntil = os.clock() + 12
        self.InventoryTime = -100
    end
    if os.clock() < (self.SoulSpawnAwaitUntil or 0) then
        self.Target = nil
        if (root.Position - data.Altar.Position).Magnitude > 18 then self:MoveTo(data.Altar) end
        self:Log("fully-soul", "Waiting for Soul Reaper", 4)
        return
    end
    self.SoulSpawnAwaitUntil = nil
    local traded = self:TryHallowBoneTrade()
    if traded then
        self.Target = nil
        return
    end
    self:FarmGroup(data.Mobs, nil, 2000)
end

