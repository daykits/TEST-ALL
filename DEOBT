function Hub:SecretLever(row, moment, handler, state)
    if self:SecretEvent(row.Name, "BossAwakening") then
        if self:SecretEnemy(row, moment, handler) then return true end
        self:SecretStatus(row, "Jailbreak | Waiting for awakened Chief Warden")
        return true
    end
    if self:SecretEvent(row.Name, "Breach") or state.LeverSolved then
        self:SecretStatus(row, "Jailbreak | Gate breach sequence")
        return true
    end
    local map = Services.Workspace:FindFirstChild("Map")
    local prison = map and map:FindFirstChild("Prison")
    local locations = prison and prison:FindFirstChild("BonusMoment_Locations", true)
    locations = locations or map and map:FindFirstChild("BonusMoment_Locations", true)
    local folder = locations and locations:FindFirstChild("Levers")
    local levers = {}
    for _, model in ipairs(folder and folder:GetChildren() or {}) do
        local part = model:IsA("Model") and model:FindFirstChild("Lever") or nil
        if part and part:IsA("BasePart") then table.insert(levers, { Part = part, Name = model.Name }) end
    end
    table.sort(levers, function(a, b)
        local delta = a.Part.Position.X - b.Part.Position.X
        if math.abs(delta) > 0.001 then return delta < 0 end
        return a.Part.Position.Z < b.Part.Position.Z
    end)
    if #levers == 0 then
        self:SecretStatus(row, "Jailbreak | Waiting for lever setup")
        return true
    end
    state.LeverKnown = state.LeverKnown or {}
    state.LeverRejected = state.LeverRejected or {}
    local replay = state.LeverReplay
    local index, position, replaying
    if replay and replay <= #state.LeverKnown then
        index, position, replaying = state.LeverKnown[replay], replay, true
    else
        state.LeverReplay = nil
        position = #state.LeverKnown + 1
        state.LeverRejected[position] = state.LeverRejected[position] or {}
        for candidate = 1, #levers do
            if not table.find(state.LeverKnown, candidate) and not state.LeverRejected[position][candidate] then
                index = candidate
                break
            end
        end
    end
    if not index or not levers[index] then
        state.LeverKnown, state.LeverRejected, state.LeverReplay = {}, {}, nil
        self:SecretStatus(row, "Jailbreak | Sequence resync")
        return true
    end
    local _, _, root = self:Character()
    local part = levers[index].Part
    if root and (root.Position - part.Position).Magnitude > 12 then
        self:MoveTo(part.CFrame + Vector3.new(0, 2, 0))
        self:SecretStatus(row, "Jailbreak | Approach " .. levers[index].Name)
        return true
    end
    if os.clock() < (state.LeverNextAt or 0) then return true end
    state.LeverNextAt = os.clock() + 0.8
    local ok, reply = self:SecretRemote(row, moment, "Pull", true, 0.5, index)
    local result = ok and type(reply) == "table" and reply.Result or nil
    if result == "Accepted" then
        if replaying then
            state.LeverReplay = replay + 1
            if state.LeverReplay > #state.LeverKnown then state.LeverReplay = nil end
        else
            table.insert(state.LeverKnown, index)
        end
    elseif result == "Solved" then
        state.LeverSolved = true
    elseif result == "Reset" then
        if replaying then
            state.LeverKnown, state.LeverRejected, state.LeverReplay = {}, {}, nil
        else
            state.LeverRejected[position][index] = true
            state.LeverReplay = #state.LeverKnown > 0 and 1 or nil
        end
        state.LeverNextAt = os.clock() + 0.55
    elseif result == "Stuck" then
        state.LeverNextAt = os.clock() + 0.5
    end
    self:SecretStatus(row, "Jailbreak | " .. levers[index].Name .. " | " .. tostring(result or "waiting"))
    return true
end

