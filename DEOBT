function Hub:FightingStyleStep()
    local goal = self.Config["Progress Style"]
    local plan = self.ProgressStylePlan[goal]
    if not plan then self:ProgressStatus("Select a progression fighting style"); return end
    if self:ProgressHas(goal) then return self:ProgressDone(goal) end
    for _, stage in ipairs(plan) do
        local name, needed = stage[1], stage[2]
        self:ProgressBuyStyle(name)
        local level, tool = self:ProgressToolLevel(name)
        if not tool then
            if name == "Death Step" then self:ProgressFightBoss({ "Awakened Ice Admiral" }, "Farming Library Key"); self:ProgressHopStep("Library Key", 45)
            elseif name == "Sharkman Karate" then self:ProgressFightBoss({ "Tide Keeper" }, "Farming Water Key"); self:ProgressHopStep("Water Key", 45)
            elseif name == "Electric Claw" then self:ElectricClawStep(); self:ProgressStatus("Electric Claw challenge")
            elseif name == "Dragon Talon" then self:TryHallowBoneTrade(); self:ProgressStatus("Rolling Fire Essence for Dragon Talon")
            else self:ProgressStatus("Buying " .. name) end
            return
        end
        if needed > 0 and (level or 0) < needed then
            self.ForcedWeapon = tool.Name
            self:ProgressStatus(name .. " mastery " .. tostring(level or 0) .. "/" .. needed)
            self:FarmLevelStep()
            return
        end
    end
    self:ProgressStatus("Buying " .. goal)
end

