        else self:ProgressStatus("Equip Dark Blade") end
        return
    end
    if stage == 2 then self:Comm("RobotTalk"); self:ProgressStatus("Starting Robotmega mission"); return end
    if stage == 3 or stage == 4 then
        if self.Sea == "Sea3" then self:RipIndraStep(false)
        else self:ProgressStatus("Continue Robotmega mission in Third Sea") end
        return
    end
    self:ProgressStatus("Robotmega state " .. tostring(stage))
end

function Hub:DragonEmberCollector()
    if self.DragonEmberConnection then return end
    local remote = self:NetRemote("RE", "DragonDojoEmber")
    if not remote then return end
    self.DragonEmberConnection = remote.OnClientEvent:Connect(function(payload)
        if not self.Alive or not (self.Config["Auto Progression"] or self.Config["Auto Hunter Quest"] or self.Config["Auto Dojo"]) then return end
        if type(payload) ~= "table" then return end
        local amount = type(payload.Embers) == "table" and #payload.Embers or tonumber(payload.Count) or tonumber(payload[1]) or 0
        if payload.Context ~= nil and payload.Context ~= "SpawnEmber" then return end
        for _ = 1, math.clamp(math.floor(amount), 0, 100) do pcall(remote.FireServer, remote) end
    end)
    table.insert(self.Connections, self.DragonEmberConnection)
end

function Hub:DragonHunterStep()
    if self.Sea ~= "Sea3" then self:ProgressStatus("Dragon Hunter requires Third Sea"); return end
    self:DragonEmberCollector()
    local ok, payload = self:NetCall("DragonHunter", { Context = "Check" })
    if not ok or type(payload) ~= "table" then self:ProgressStatus("Dragon Hunter unavailable"); return end
    if payload.Text == nil then
        self:NetCall("DragonHunter", { Context = "RequestQuest" })
        self:ProgressStatus("Requesting Dragon Hunter quest")
        return
    end
    local text = tostring(payload.Text or payload.Message or "")
    local lower = text:lower()
    if lower:find("hydra", 1, true) then self:ProgressFarm({ "Hydra Enforcer" }, "Dragon Hunter: Hydra Enforcers", 2500)
    elseif lower:find("venom", 1, true) then self:ProgressFarm({ "Venomous Assailant" }, "Dragon Hunter: Venomous Assailants", 2500)
    elseif lower:find("tree", 1, true) then
        local _, _, root = self:Character()
        local tree, treePart, distance
        local candidates = Services.CollectionService:GetTagged("Tree")
        if #candidates == 0 then
            local map = Services.Workspace:FindFirstChild("Map")
            for _, object in ipairs(map and map:GetDescendants() or {}) do if object.Name == "Tree" then candidates[#candidates + 1] = object end end
        end
        for _, object in ipairs(candidates) do
            local part = object:IsA("BasePart") and object or object:FindFirstChildWhichIsA("BasePart", true)
            if root and part then
                local value = (part.Position - root.Position).Magnitude
                if not distance or value < distance then tree, treePart, distance = object, part, value end
            end
        end
        if tree and treePart then
            self:Comm("LoadItem", "Cannon")
            self:Equip("Cannon")
            self.SecretStrikeTarget = treePart
            if distance > 22 then self:MoveTo(treePart.CFrame + treePart.CFrame.LookVector * 12 + Vector3.new(0, 4, 0)) else self:PressMouse() end
            self:ProgressStatus("Dragon Hunter: destroying trees")
        else self:ProgressStatus("Dragon Hunter tree objective is not streamed") end
    elseif lower:find("ember", 1, true) then self:CollectEmberStep(); self:ProgressStatus("Dragon Hunter: Blaze Embers")
    else self:ProgressStatus(text ~= "" and text or "Dragon Hunter quest synced") end
end

function Hub:DracoTrialStep()
    local trial = Compat.find(Services.Workspace, { "Map", "DracoTrial" })
    if not trial then self.DracoRelicIndex, self.DracoRelicPhase = nil, nil; return false end
    local index = math.clamp(self.DracoRelicIndex or 1, 1, 3)
    local phase = self.DracoRelicPhase or "Collect"
    local object = trial:FindFirstChild((phase == "Collect" and "Relic" or "EndRelic") .. index, true)
    if object then
        self:ProgressStatus("Draco trial " .. phase:lower() .. " " .. index .. "/3")
        local _, _, root = self:Character()
        local cf = Compat.cframe(object)
        self:ProgressMoveTouch(object)
        if root and cf and (root.Position - cf.Position).Magnitude <= 7 then
            if phase == "Collect" then self.DracoRelicPhase = "Deliver"
            else self.DracoRelicPhase = "Collect"; self.DracoRelicIndex = index % 3 + 1 end
        end
        return true
    end
    local center = trial:FindFirstChild("Center", true)
    if center then self:ProgressMoveTouch(center) end
    return true
end

function Hub:DracoV4Step()
