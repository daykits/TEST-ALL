    local belt = type(quest.BeltStage) == "number" and quest.BeltStage or 0
    local label = module.BeltStages and module.BeltStages[belt]
    local text = label and label.Name or ("Belt " .. belt)
    text ..= "\n" .. upgrade.Name .. " | " .. tostring(upgrade.FragmentsCost) .. " Fragments"
    if type(owned) == "table" then text ..= " | " .. (owned.own and (owned.en and "Enabled" or "Disabled") or "Not owned") end
