        Position = UDim2.fromOffset(40, 0),
        Size = UDim2.new(1, -46, 1, 0),
        ZIndex = 5,
        Parent = t.Button,
    })

    -- Hook up click
    t.Button.MouseButton1Click:Connect(function()
        self_:SetActiveTab(t)
    end)

    -- Hover
    t.Button.MouseEnter:Connect(function()
        if self_.ActiveTab ~= t then
            self.Anim:Play(t.Button, { BackgroundTransparency = 0.5 })
        end
    end)
    t.Button.MouseLeave:Connect(function()
        if self_.ActiveTab ~= t then
            self.Anim:Play(t.Button, { BackgroundTransparency = 1 })
        end
    end)

    table.insert(self.Tabs, t)
    table.insert(self.TabOrder, t)

    -- Auto-select first tab
    if not self.ActiveTab then
        self:SetActiveTab(t)
    end

    return t
