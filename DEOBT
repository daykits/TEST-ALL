function Window:_MakeCtrlBtn(kind, theme, parent)
    local color = theme.TextSecondary
    if kind == "close" then color = theme.Error end
    local txt = kind == "min" and "—" or (kind == "max" and "▢" or "✕")
    local btn = New("TextButton", {
        BackgroundColor3 = theme.Card,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(28, 28),
        Text = txt,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = color,
        AutoButtonColor = false,
        ZIndex = 5,
        Parent = parent,
    })
    Corner(6).Parent = btn
    self.Anim:RegisterHover(btn, theme.Card, theme.AccentHover)
    return btn
end

function Window:_BindDrag()
    if not self.Draggable then return end
    local dragging, startPos, startInput = false, nil, nil
    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        startInput = input.Position
        startPos = self.Frame.Position
    end
    self.Cleanup:AddConnection(self.Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
        end
    end))
    self.Cleanup:AddConnection(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - startInput
        self.Frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end))
    self.Cleanup:AddConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Window:_BindResize()
    if not self.Resizable then return end
    local grip = self.ResizeGrip
    if not grip then return end
    local dragging, startInput, startSize = false, nil, nil
    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startSize = self.Frame.AbsoluteSize
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        local delta = input.Position - startInput
        local newW = Clamp(startSize.X + delta.X, MIN_SIZE.X, MAX_SIZE.X)
        local newH = Clamp(startSize.Y + delta.Y, MIN_SIZE.Y, MAX_SIZE.Y)
        self.Frame.Size = UDim2.fromOffset(newW, newH)
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

function Window:_RegisterTheme()
    ThemeManager:Register(function(theme)
        if self._destroyed then return end
        self.Frame.BackgroundColor3 = theme.Background
        self.Sidebar.BackgroundColor3 = theme.Secondary
        self.Header.BackgroundColor3 = theme.Secondary
        self.BrandTitle.TextColor3 = theme.Text
        self.BrandSubtitle.TextColor3 = theme.TextSecondary
        self.HeaderTitle.TextColor3 = theme.Text
        self.HeaderSubtitle.TextColor3 = theme.TextSecondary
        self.VersionLabel.TextColor3 = theme.TextSecondary
        self.StatusLabel.TextColor3 = theme.Success
        for _, child in ipairs(self.Frame:GetDescendants()) do
            if child:IsA("UIStroke") then child.Color = theme.Border end
        end
        for _, tab in ipairs(self.Tabs) do
            if tab._RefreshTheme then tab:_RefreshTheme(theme) end
        end
    end)
end

function Window:SetTitle(text)
    self.Title = tostring(text or "")
    self.BrandTitle.Text = self.Title
    self.HeaderTitle.Text = self.Title
end

function Window:SetSubtitle(text)
    self.Subtitle = tostring(text or "")
    self.BrandSubtitle.Text = self.Subtitle
    self.HeaderSubtitle.Text = self.Subtitle
end

function Window:SetVisible(v)
    self.Frame.Visible = v and true or false
    self.Overlay.Visible = self.Frame.Visible
end

function Window:SetSize(size)
    local w = Clamp(size.X.Offset, MIN_SIZE.X, MAX_SIZE.X)
    local h = Clamp(size.Y.Offset, MIN_SIZE.Y, MAX_SIZE.Y)
    self.Frame.Size = UDim2.fromOffset(w, h)
end

function Window:SetPosition(pos)
    self.Frame.Position = pos
end

function Window:Minimize()
    if self._minimized then return end
    self._minimized = true
    self.Minimized = true
    self._restoreSize = self.Frame.Size
    self.Anim:Play(self.Frame, {
        Size = UDim2.fromOffset(300, 52),
        Position = UDim2.new(0.5, 0, 0, 30),
        AnchorPoint = Vector2.new(0.5, 0),
    }, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))
    self.Content.Visible = false
end

function Window:Restore()
    if not self._minimized then return end
    self._minimized = false
    self.Minimized = false
    self.Anim:Play(self.Frame, {
        Size = self._restoreSize or UDim2.fromOffset(DEFAULT_SIZE.X, DEFAULT_SIZE.Y),
        Position = self.Position,
        AnchorPoint = Vector2.new(0.5, 0.5),
    }, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))
    self.Content.Visible = true
end

function Window:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, tab in ipairs(self.Tabs) do
        if tab.Destroy then pcall(function() tab:Destroy() end) end
    end
    self.Anim:Clear()
    self.Cleanup:Destroy()
    pcall(function() self.RootGui:Destroy() end)
end

