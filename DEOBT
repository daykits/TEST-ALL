function Hub:ProgressHopStep(reason, delay)
    if not self.Config["Progress Auto Hop"] then return false end
    local key = tostring(reason or "progress")
    self.ProgressWaits = self.ProgressWaits or {}
    self.ProgressWaits[key] = self.ProgressWaits[key] or os.clock()
    if os.clock() - self.ProgressWaits[key] < (delay or 25) or os.clock() < (self.ProgressHopAt or 0) then return false end
    self.ProgressHopAt = os.clock() + 25
    local ok, data = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"
        return Services.HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok or type(data) ~= "table" or type(data.data) ~= "table" then self:ProgressStatus("Server hop unavailable: " .. key); return false end
    for _, server in ipairs(data.data) do
        if type(server) == "table" and type(server.id) == "string" and server.id ~= game.JobId and (server.playing or 0) < (server.maxPlayers or math.huge) then
            local browser = Services.ReplicatedStorage:FindFirstChild("__ServerBrowser")
            if browser and browser:IsA("RemoteFunction") then
                self:ProgressStatus("Server hopping: " .. key)
                pcall(browser.InvokeServer, browser, "teleport", server.id)
                return true
            end
        end
    end
    return false
end

