			[1] = "swingsfx", [2] = "Melee", [3] = 1,

			[4] = "Ground", [5] = false, [6] = CombatAnims[1],

			[7] = 2, [8] = 1.5,

		})

		current = getHRP()

		liveHrp = npc and npc:FindFirstChild("HumanoidRootPart")

		liveHum = npc and npc:FindFirstChild("Humanoid")

		packetCenter = liveHrp and liveHrp.Position or packetCenter

		if current and liveHrp and liveHum and liveHum.Health > 0 then

			current.CFrame = CFrame.new(liveHrp.Position.X, fixedCombatY, liveHrp.Position.Z)

