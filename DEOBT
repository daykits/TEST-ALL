function Hub:Action(name, callback, movement)
    if self.ManualBusy and movement then self:Notify("Bacon Hub", "Movement is busy."); return end
    if movement then self.ManualBusy = true; self:CancelMove() end
    local thread = task.spawn(function()
        local ok, problem = pcall(callback)
        if movement then self.ManualBusy = false; self:CancelMove() end
        if not ok then self:Notify(name, problem); self:Log(name, problem) end
    end)
    table.insert(self.Jobs, thread)
end

function Hub:BuyMelee(name, predicate)
    if type(name) ~= "string" then self:Notify("Melee", "Select a fighting style."); return false end
    local npcName = self.MeleeData.NPCs[name]
    if not npcName then return false end
    if name == "Advanced Combat" or name == "Combat" then
        local phase, problem = self:SecretPhase()
        if phase ~= "Complete" then self:Notify("Secrets Master", problem or ("Server phase: " .. tostring(phase))); return false end
    end
    local destination = self:FindNPC(npcName)
    if not destination then self:Notify("Melee", npcName .. " is unavailable."); return false end
    local reached, problem = self:MoveUntil(destination, predicate, 45)
    if not reached then self:Notify("Melee", problem); return false end
    if not self.Alive or (predicate and not predicate()) then return false end
    if name == "Advanced Combat" or name == "Combat" then
        local ok, response = self:Comm("SetSecretStyle", name)
        self:Notify("Secrets Master", ok and ("Server response: " .. tostring(response)) or response)
        self.InventoryTime = -100
        return ok and (response == 1 or response == 2)
    end
    local commands = self.MeleeData.Remotes[name]
    if type(commands) ~= "table" then return false end
    local list = type(commands[1]) == "table" and commands or { commands }
    local success, last
    for _, args in ipairs(list) do
        if not self.Alive or (predicate and not predicate()) then return false end
        local ok, response = self:Comm(table.unpack(args))
        success, last = ok, response
        if not ok then break end
    end
    self.InventoryTime = -100
    self:Notify("Melee / " .. name, success and ("Server response: " .. tostring(last)) or tostring(last))
    return success == true
end

function Hub:ChestStep()
    local _, _, root = self:Character()
    if not root then return end
    self.ChestRetry = self.ChestRetry or setmetatable({}, { __mode = "k" })
    if self.PendingChest then
        local pending = self.PendingChest
        if not pending.Chest.Parent or pending.Chest:GetAttribute("IsDisabled") == true then
            self.ChestsObserved = (self.ChestsObserved or 0) + 1
            self.PendingChest = nil
        elseif os.clock() > pending.Deadline then
            self.ChestRetry[pending.Chest] = os.clock() + 10
            self.PendingChest = nil
        end
        return
    end
    local closest, closestCF, distance
    for _, chest in ipairs(Services.CollectionService:GetTagged("_ChestTagged")) do
        if chest.Parent and chest:GetAttribute("IsDisabled") ~= true and os.clock() >= (self.ChestRetry[chest] or 0) then
            local cf = Compat.cframe(chest)
            if cf then
                local d = (cf.Position - root.Position).Magnitude
                if not distance or d < distance then closest, closestCF, distance = chest, cf, d end
            end
        end
    end
    if not closest then self:Log("chest", "No currently streamed _ChestTagged object."); return end
    if not self:MoveTo(closestCF) then return end
    local part = Compat.isA(closest, "BasePart") and closest or closest.PrimaryPart
    if not part then part = closest:FindFirstChildWhichIsA("BasePart", true) end
    if part and type(firetouchinterest) == "function" then
        pcall(firetouchinterest, root, part, 0)
        pcall(firetouchinterest, root, part, 1)
    end
    self.PendingChest = { Chest = closest, Deadline = os.clock() + 3 }

end

function Hub:ElectricClawStep()
    if self.Sea ~= "Sea3" then self:Notify("Electric Claw", "Third Sea required."); self:SetConfig("Get Electric Claw", false); return end
    local owned, _, inventoryProblem = self:StyleOwned("Electric Claw")
    if owned == nil then self:Log("electric-claw", inventoryProblem or "Inventory pending"); return end
    if owned then
        self:Notify("Electric Claw", "Electric Claw owned.")
        self.ForcedWeapon = nil; self.ElectricState = nil; self:SetConfig("Get Electric Claw", false); return
    end
    local prerequisite, mastery = self:StyleOwned("Electro")
    if prerequisite ~= true then
        self:Notify("Electric Claw", "Electro required.")
        self:SetConfig("Get Electric Claw", false); return
    end
    if mastery == nil then self:Log("electric-claw", "Loading mastery."); return end
    if mastery < 400 then
        self.ForcedWeapon = "Electro"
        local tool = self:Equip("Electro")
        if not tool or tool.Name ~= "Electro" then self:Comm("BuyElectro"); return end
        self:FarmGroup({ "Reborn Skeleton", "Living Zombie", "Demonic Soul", "Posessed Mummy", "Possessed Mummy" }, nil, 2000)
        return
    end
    self.ForcedWeapon = nil
    local state = self.ElectricState or { Stage = "check" }
    self.ElectricState = state
    local hero = self:FindNPC("Previous Hero")
    if not hero then self:Log("electric-claw", "Previous Hero unavailable."); return end
    if state.Stage == "run" then
        if os.clock() >= state.Deadline then
            self:Notify("Electric Claw", "Challenge expired.")
            self.ElectricState = nil; self:SetConfig("Get Electric Claw", false); return
        end
        if not self:MoveTo(state.Mansion) then return end
        state.Stage = "verify"
    end
    if state.Stage == "check" or state.Stage == "verify" then
        if os.clock() < (state.NextCheck or 0) then return end
        state.NextCheck = os.clock() + 2
        local ok, code = self:Comm("BuyElectricClaw", true)
        if not ok then return end
        if type(code) == "string" then
            self:Notify("Electric Claw", code); self:SetConfig("Get Electric Claw", false); return
        end
        if code == 4 then
            if state.Stage == "verify" then
                if os.clock() >= state.Deadline then self.ElectricState = nil; self:SetConfig("Get Electric Claw", false) end
                return
            end
            state.Stage = "start"
        elseif code == 0 or code == 1 or code == 2 then state.Stage = "buy"
        elseif code == 3 then
            self:Notify("Electric Claw", "Requirements not met."); self:SetConfig("Get Electric Claw", false); return
        else self:Log("electric-claw", "Unrecognized check response: " .. tostring(code)); return end
    end
    if state.Stage == "start" then
        if not self:MoveTo(hero) then return end
        local mansion = Compat.find(Services.Workspace, { "Map", "Turtle", "IslandModel", "Mansion" })
        local region = Compat.find(Services.Workspace, { "_WorldOrigin", "Locations", "Mansion" })
        local cf = Compat.cframe(mansion) or Compat.cframe(region)
        if not cf then self:Log("electric-claw", "Mansion destination not loaded; challenge not started."); return end
        local ok = self:Comm("BuyElectricClaw", "Start")
        if ok then state.Stage = "run"; state.Mansion = cf; state.Deadline = os.clock() + 30 end
    elseif state.Stage == "buy" then
        if not self:MoveTo(hero) then return end
        local ok, code = self:Comm("BuyElectricClaw")
        if not ok then return end
        self:Notify("Electric Claw", "Server purchase response: " .. tostring(code))
        self.InventoryTime = -100
        self:SetConfig("Get Electric Claw", false)
        self.ElectricState = nil
    end
end

