    if not ok or type(progress) ~= "number" then self:SecretStatus(row, "Electric | State unavailable"); return true end
    state.Accepted = true
    if progress == 0 or progress == 5 then
        self:Comm("AcceptElectroQuest")
        self:SecretStatus(row, "Electric | Quest started")
        return true
    end
    local bolt = self:ItemQuantity("Lightning Bolt")
    if progress == 1 and bolt == 0 then
        self:SecretStatus(row, "Electric | Strike charged cloud")
        return false
    end
    if self:CombatLock() then
        state.ElectroTurnAt = os.clock() + 4
        self:SecretStatus(row, "Electric | Waiting out combat for turn-in")
        return true
    end
    local npc = self:LiveSecretNPC(handler.NPC)
    local _, _, root = self:Character()
    if npc and root and (root.Position - npc.Position).Magnitude > 15 then
        self:MoveTo(npc)
        self:SecretStatus(row, "Electric | Return to Mad Scientist")
        return true
    end
    if os.clock() < (state.ElectroTurnAt or 0) then return true end
    state.ElectroTurnAt = os.clock() + 2
    local sent, result
    if progress == 4 then
        sent, result = self:Comm("DeliverLightningBolt")
    else
        sent, result = self:Comm("BuyElectro")
    end
    if sent and (result == 1 or result == 2) then
        self:RefreshSecrets(true)
        self:SecretStatus(row, "Electric | Turn-in accepted")
        return true
    end
    self:SecretStatus(row, "Electric | Turn-in " .. tostring(result) .. (result == 3 and " | need 500k Beli" or ""))
    return true
end

function Hub:SecretFishman(row, moment, handler, state)
    if not moment then return false end
    local folder
    for _, object in ipairs(Services.CollectionService:GetTagged("FishmanKarateMoment")) do
        if object:IsDescendantOf(Services.Workspace) then folder = object; break end
    end
    if not folder then self:SecretStatus(row, "Fishman Karate | Waiting for puzzle"); return true end
    local targets = { [3] = Vector2.new(1, 2), [4] = Vector2.new(4, 2) }
    local char, _, root = self:Character()
    if not char or not root then return true end
    for index = 3, 4 do
        local pillar = folder:FindFirstChild("Pillar" .. index, true)
        local current = pillar and pillar:GetAttribute("Position")
        local target = targets[index]
        local touch = pillar and pillar:FindFirstChild("Root")
        if pillar and typeof(current) == "Vector2" and Compat.isA(touch, "BasePart") and current ~= target then
            local dx = target.X == current.X and 0 or math.sign(target.X - current.X)
            local dz = dx == 0 and math.sign(target.Y - current.Y) or 0
            local goal = CFrame.lookAt(touch.Position + Vector3.new(-dx * 5, 1, -dz * 5), touch.Position)
            if (root.Position - goal.Position).Magnitude > 3 then
                self:MoveTo(goal)
            elseif os.clock() >= (state.FishmanTouchAt or 0) then
                state.FishmanTouchAt = os.clock() + 0.6
                pcall(function() root.CFrame = goal end)
                if type(firetouchinterest) == "function" then
                    pcall(firetouchinterest, root, touch, 0)
                    pcall(firetouchinterest, root, touch, 1)
                else
                    pcall(function() root.CFrame = touch.CFrame end)
                end
            end
            self:SecretStatus(row, "Fishman Karate | Pillar " .. index .. " -> " .. target.X .. "," .. target.Y)
            return true
        end
    end
    self:SecretStatus(row, "Fishman Karate | Alignment verified")
    return true
end

function Hub:SecretCannon(row, moment, handler, state)
    if not moment then return false end
    local _, hum = self:Character()
    local seat = hum and hum.SeatPart
    if seat and seat.Parent and seat.Parent.Name == "MarineBusterCannon" then
        local enemy = self:Enemies(handler.Enemies)[1]
        local target = enemy and (enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart)
        if target and os.clock() >= (state.CannonFireAt or 0) then
            state.CannonFireAt = os.clock() + 0.25
            local camera = Services.Workspace.CurrentCamera
            if camera then pcall(function() camera.CFrame = CFrame.lookAt(camera.CFrame.Position, target.Position) end) end
            local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                vim:SendMouseButtonEvent(viewport.X * 0.5, viewport.Y * 0.5, 0, true, game, 0)
                task.wait(0.04)
                vim:SendMouseButtonEvent(viewport.X * 0.5, viewport.Y * 0.5, 0, false, game, 0)
            end)
        end
        self:SecretStatus(row, target and ("Cannon | " .. enemy.Name) or "Cannon | Waiting for verified target")
        return true
    end
    local _, _, root = self:Character()
    local cannonSeat, best
    local candidates = self:SecretMomentCandidates(moment, handler)
    for _, record in ipairs(self:SecretWorldCandidates(row, handler)) do table.insert(candidates, record) end
    for _, record in ipairs(candidates) do
        local object = record.Object
        if object and object.Parent and (object:IsA("Seat") or object:IsA("VehicleSeat"))
            and object.Parent.Name == "MarineBusterCannon" and root then
            local distance = (object.Position - root.Position).Magnitude
            if not best or distance < best then cannonSeat, best = record, distance end
        end
    end
    if cannonSeat then
        self:SecretStatus(row, "Cannon | Boarding")
        return self:SecretTouch(row, cannonSeat)
    end
    self:SecretStatus(row, "Cannon | Waiting for verified cannon")
    return true
end

function Hub:SecretClown(row, moment, handler, state)
    if not moment then return false end
    local hitbox = self:SecretFindCandidate(row, moment, handler, { "ClownJewelsChestHitbox" }, false)
    if hitbox then return self:SecretTouch(row, hitbox) end
    if self:SecretEnemy(row, moment, handler) then return true end
    local chest, distance = self:SecretFindCandidate(row, moment, handler, { "ClownJewelsChest", "Jewels" }, false)
    if chest and distance and distance > 28 then
        self:MoveTo(Compat.cframe(chest.Object), 20)
        self:SecretStatus(row, "Jewels | Moving to contest chest")
        return true
    end
    if state.ClownBeginAt and os.clock() >= state.ClownBeginAt then
        state.ClownBeginAt = nil
        self:SecretRemote(row, moment, "BeginFight", false, 2)
        self:SecretStatus(row, "Jewels | Starting verified fight")
        return true
    end
    if os.clock() < (state.ClownCheckAt or 0) then return true end
    state.ClownCheckAt = os.clock() + 3
    local checked, active = self:SecretRemote(row, moment, "IsBruteActive", true, 1)
    if checked then
        if active == true then
            self:SecretRemote(row, moment, "BeginFight", false, 2)
        else
            self:SecretRemote(row, moment, "Provoke", false, 2)
            state.ClownBeginAt = os.clock() + 1.5
        end
        self:SecretStatus(row, "Jewels | Verified contest state")
        return true
    end
    return false
end

function Hub:SecretWindmill(row, state)
    local rig = Compat.find(Services.Workspace, { "Map", "Pirate", "WindmillRig", "Windmill_rig" })
    if not rig then
        local pirate = Compat.find(Services.Workspace, { "Map", "Pirate" })
        rig = pirate and pirate:FindFirstChild("Windmill_rig", true) or nil
    end
    if not rig then self:SecretStatus(row, "Windmill | Exact rig unavailable"); return true end
    local _, _, root = self:Character()
    if not root then return true end
    local groups = {}
    for _, part in ipairs(rig:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "Ropes" and part.Transparency < 0.99 then
            local name = part.Name:gsub("%.%d+$", "")
            local group = name:match("^(Rope%d)[AB]$")
            if group then
                groups[group] = groups[group] or {}
                table.insert(groups[group], part)
            end
        end
    end
    local target = state.WindmillTarget
    if not target or not target.Parent or target.Transparency >= 0.99 then
        target = nil
        local options = {}
        for group, parts in pairs(groups) do
            table.sort(parts, function(a, b)
                local aA = a.Name:gsub("%.%d+$", ""):sub(-1) == "A" and 0 or 1
                local bA = b.Name:gsub("%.%d+$", ""):sub(-1) == "A" and 0 or 1
                if aA ~= bA then return aA < bA end
                return a.Name < b.Name
            end)
            local part = parts[1]
            if part then table.insert(options, { Part = part, Group = group, Distance = (root.Position - part.Position).Magnitude }) end
        end
        table.sort(options, function(a, b)
            local aExact = a.Part.Name:gsub("%.%d+$", "") == "Rope5A" and 0 or 1
            local bExact = b.Part.Name:gsub("%.%d+$", "") == "Rope5A" and 0 or 1
            if aExact ~= bExact then return aExact < bExact end
            if a.Distance ~= b.Distance then return a.Distance < b.Distance end
            return a.Group < b.Group
        end)
        target = options[1] and options[1].Part or nil
        state.WindmillTarget = target
    end
    if not target then
        self:SecretStatus(row, "Windmill | Waiting for server completion")
        return true
    end
    local distance = (root.Position - target.Position).Magnitude
    if distance > 45 then
        self:MoveTo(CFrame.lookAt(target.Position + Vector3.new(0, 3, 7), target.Position))
        self:SecretStatus(row, "Windmill | Moving to " .. target.Name)
        return true
    end
    local remote = self:NetRemote("RE", "RegisterHit")
    if not remote then self:SecretStatus(row, "Windmill | RegisterHit unavailable"); return true end
    self:SelectTool()
    if os.clock() >= (state.WindmillHitAt or 0) then
        state.WindmillHitAt = os.clock() + math.max(self.Config["Fast Rate"] or 0.05, 0.05)
        self.SecretStrikeTarget = target
        local ok = pcall(remote.FireServer, remote, target)
        self.SecretStrikeTarget = nil
        if ok then
            self.FastBatches = (self.FastBatches or 0) + 1
            self.FastLastBatch = os.clock()
        end
    end
    self:SecretStatus(row, "Windmill | RegisterHit " .. target.Name)
    return true
end

function Hub:SecretGeneric(row, moment, handler, state)
    local prompt = self:SecretFindPrompt(row, handler)
    if prompt then state.IdleSince = nil; return self:SecretUsePrompt(row, prompt) end
    local candidate
    if handler.InteractFirst or handler.ObjectBeforeEnemy then
        candidate = self:SecretFindCandidate(row, moment, handler, nil, true)
        if candidate and self:SecretInteractObject(row, handler, candidate) then state.IdleSince = nil; return true end
    end
    if self:SecretEnemy(row, moment, handler) then state.IdleSince = nil; return true end
    candidate = candidate or self:SecretFindCandidate(row, moment, handler, nil, true)
    if candidate and self:SecretInteractObject(row, handler, candidate) then state.IdleSince = nil; return true end
    local fallback = handler.FallbackEnemies and self:Enemies(handler.FallbackEnemies)[1] or nil
    local verifiedFallback = fallback and (fallback:GetAttribute("LocalEnemy") == Player.Name
        or fallback:GetAttribute("BonusMoment") == row.Name or fallback:GetAttribute("Awakened") == true
        or fallback:GetAttribute("IsAwakened") == true or fallback:GetAttribute("RaidBoss") == true)
    if verifiedFallback then
        self.SecretCombatAllowed = true
        self:Fight(fallback, handler.FallbackEnemies, false)
        self:SecretStatus(row, "Objective | Fallback " .. fallback.Name)
        state.IdleSince = nil
        return true
    end
    if handler.Tool then
        local tool = self:SecretTool(handler, state)
        if tool and os.clock() >= (state.NextTool or 0) then
            state.NextTool = os.clock() + 1
            pcall(tool.Activate, tool)
            state.IdleSince = nil
            self:SecretStatus(row, "Objective | Use " .. tool.Name)
            return true
        end
    end
    state.IdleSince = state.IdleSince or os.clock()
    if self.Config["Secrets Scope"] == "Available" and os.clock() - state.IdleSince > 12 then
        state.IdleSince = nil
        self:PauseSecret(row, "Objective unavailable | Checking next quest", 30)
        return true
    end
    self:SecretStatus(row, "Objective | Waiting for server-valid target")
    return false
end

function Hub:SecretAction(row, moment, handler, npcFound)
    if not self.Alive or not self.Config["Auto Secrets"] then return end
    self.SecretActions = self.SecretActions or {}
    local state = self.SecretActions[row.Address] or {}
    self.SecretActions[row.Address] = state
    if not state.Accepted then
        if npcFound then
            local group = self:SecretNPCEntry(row)
            local synced = group == nil or self:ClaimGuideReward(group, true)
            if not synced then self:SecretStatus(row, "Start | Quest giver syncing"); return end
            state.Accepted = true
            state.MomentMissingAt = nil
            self:SecretStatus(row, "Start | Quest giver synced")
            return
        elseif moment and moment.Active == true or self:SecretNativeQuest(row) then
            state.Accepted = true
        end
    end
    if handler.Action == "Observe" then self:SecretStatus(row, "Objective | Server-only client module"); return end
    if handler.Action == "Lever" then self:SecretLever(row, moment, handler, state); return end
    if handler.Action == "Don" then self:SecretDon(row, moment, handler); return end
    if handler.Action == "Statues" then self:SecretStatues(row, handler, state); return end
    if handler.Action == "Tablet" then self:SecretTablet(row, handler); return end
    if handler.Action == "Breaking" then self:SecretBreaking(row, moment, handler); return end
    if handler.Action == "Frozen" then self:SecretFrozen(row, moment, handler); return end
    if handler.Action == "Pearl" then self:SecretPearl(row, moment, handler, state); return end
    if handler.Action == "Wire" then self:SecretWire(row, moment, handler); return end
    if handler.Action == "XMarks" then self:SecretXMarks(row, moment, handler); return end
    if handler.Action == "Crowd" then self:SecretCrowd(row, moment, handler); return end
    if handler.Action == "Bubble" then self:SecretBubble(row, moment, handler); return end
    if handler.Action == "Escape" then self:SecretEscape(row, moment, handler, state); return end
    if handler.Action == "Windmill" then self:SecretWindmill(row, state); return end
    if handler.Action == "Banana" then self:SecretBanana(row, moment, handler); return end
    if handler.Action == "Monkey" then self:SecretMonkey(row, moment, handler); return end
    if handler.Action == "Zipline" then self:SecretZipline(row, moment, handler, state); return end
    if handler.Action == "Tavern" then self:SecretTavern(row, moment, handler, state); return end
    if handler.Action == "Temple" then self:SecretTemple(row, moment, state); return end
    if handler.Action == "EarlyAccess" then self:SecretEarlyAccess(row, moment, handler, state); return end
    if handler.Action == "Lookout" then self:SecretLookout(row, moment, state); return end
    if handler.Action == "Chef" and self:SecretChef(row, moment, handler, state) then return end
    if handler.Action == "Echo" then self:SecretEcho(row, moment, handler, state); return end
    if handler.Action == "Fishman" and self:SecretFishman(row, moment, handler, state) then return end
    if handler.Action == "Cannon" then self:SecretCannon(row, moment, handler, state); return end
    if handler.Action == "Clown" and self:SecretClown(row, moment, handler, state) then return end
    if handler.Action == "Unexpected" and self:SecretUnexpected(row, moment, handler, state) then return end
    if handler.Action == "Snowman" and self:SecretSnowman(row, moment, handler) then return end
    if handler.Action == "Pipe" and self:SecretPipe(row, moment, handler) then return end
    if handler.Action == "Arena" and self:SecretArena(row, moment, handler, state) then return end
    if handler.Action == "Hasan" and self:SecretHasan(row, moment, handler, state) then return end
    if handler.Action == "Flagpole" and self:SecretFlagpole(row, moment, state) then return end
    if handler.Action == "Electro" and self:SecretElectro(row, handler, state) then return end
    if not state.Accepted then
        if npcFound then
            local group = self:SecretNPCEntry(row)
            if group then self:ClaimGuideReward(group, true) end
            state.Accepted = true
            self:SecretStatus(row, "Start | Quest giver interaction")
            return
        end
        state.Accepted = true
    end
    self:SecretGeneric(row, moment, handler, state)
end

function Hub:SecretCompletion(row)
    self.SecretActions = self.SecretActions or {}
    local state = self.SecretActions[row.Address] or {}
    self.SecretActions[row.Address] = state
    if state.TurnedIn then return false end
    local handler = self.SecretHandlers[row.Name] or {}
    if row.Name == "Tavern Brawl" and not state.ExitedTavern then
        local moment = self:GetMoment(row.Name)
        if moment then self:SecretRemote(row, moment, "ExitTavern", false, 1) end
        state.ExitedTavern = true
        self:SecretStatus(row, "Tavern | ExitTavern")
        return true
    end
    local guideCF, _, guideId = self:SecretGuide(row, true)
    local reportGuide = guideId and (guideId:find("REPORT", 1, true) or guideId == "PricklyHarvestMerchant" or guideId == "TavernBrawlBartender")
    if guideCF and reportGuide then
        local _, _, root = self:Character()
        if root and (root.Position - guideCF.Position).Magnitude > 9 then
            self:MoveTo(guideCF)
            self:SecretStatus(row, "Turn-in | Moving to report tracker")
        else
            local ok = self:SecretTurnInAtGuide(row, guideId)
            if ok then state.TurnedIn = true end
            self:SecretStatus(row, "Turn-in | Reporting tracker")
        end
        return true
    end
    local group, entry = self:SecretNPCEntry(row)
    if not group then
        if self.SecretRewardTrackerKnown then state.TurnedIn = true; return false end
        self:SecretStatus(row, "Turn-in | Loading reward tracker")
        return true
    end
    local npcName = entry and entry.NPCName or handler.NPC
    local cf = self:LiveSecretNPC(npcName) or (entry and Compat.cframe(entry.Position))
    local _, _, root = self:Character()
    if cf and root and (root.Position - cf.Position).Magnitude > 18 then
        self:MoveTo(cf)
        self:SecretStatus(row, "Turn-in | Moving to quest giver")
        return true
    end
    state.TurnInStarted = state.TurnInStarted or os.clock()
    local ok, reply = self:ClaimGuideReward(group, true)
    if ok and reply ~= nil and reply ~= false then state.TurnedIn = true; self:RefreshSecrets(true) end
    self:SecretStatus(row, "Turn-in | Claiming reward")
    return true
end

function Hub:AutoSecretsStep()
    if not self.Alive or not self.Config["Auto Secrets"] then return end
    self.SecretCombatAllowed = false
    self.Target = nil
    self.SecretActions = self.SecretActions or {}
    self.SecretSkip = self.SecretSkip or {}
    if self.Sea ~= "Sea1" then self:SecretStatus(nil, "First Sea required"); return end
    local _, _, root = self:Character()
    if not root then return end
    if self:AutoSecretRewardStep() then return end
    if not self.Progress or os.clock() - (self.ProgressTime or 0) > 8 then
        local refreshed = self:RefreshSecrets(true)
        if not refreshed or not self.Progress then self:SecretStatus(nil, "Loading server progress"); return end
    end
    self:RefreshSecretRaidHint(false)
    if self.Config["Secrets Scope"] == "Selected" then
        local selected = self:SelectedSecret()
        if self.SecretCurrent and selected and self.SecretCurrent.Address ~= selected.Address then self:SkipSecret() end
    elseif self.SecretCurrent and self.SecretPriorityMoment and self.SecretPriorityMoment ~= self.SecretCurrent.Name
        and os.clock() - (self.SecretPriorityAt or 0) < 20 then
        local priorityRow
        for _, candidate in ipairs(self.Catalog) do
            if candidate.Name == self.SecretPriorityMoment then priorityRow = candidate; break end
        end
        local priorityAvailable = priorityRow and self:SecretAvailable(priorityRow)
        if priorityAvailable then self:SkipSecret() end
    end
    if self.Config["Secrets Scope"] == "Available" and self.SecretCurrent
        and Compat.progressState(self.Progress, self.SecretCurrent.Address) ~= "Completed" then
        local available, kind = self:SecretAvailable(self.SecretCurrent)
        if self.SecretCurrentKind == "Event" and kind == "Tracker" then available = false end
        if not available then
            if self.SecretCurrentKind == "Event" then
                self.SecretSkip[self.SecretCurrent.Address] = os.clock() + 30
                if os.clock() >= (self.SecretEndedNoticeAt or 0) then
                    self.SecretEndedNoticeAt = os.clock() + 10
                    self:Notify("Secret Event", self.SecretCurrent.Name .. " đã kết thúc")
                end
            end
            self.SecretActions[self.SecretCurrent.Address] = nil
            self.SecretCurrent, self.SecretStartedAt, self.SecretCurrentKind = nil, nil, nil
            self.SecretScan, self.SecretPromptScan = nil, nil
            self.Target, self.SecretStrikeTarget = nil, nil
            self:CancelMove()
        elseif kind then
            self.SecretCurrentKind = kind
        end
    end
    local row = self.SecretCurrent or self:ChooseSecret()
    if not row then
        local selected = self.Config["Secrets Scope"] == "Selected" and self:SelectedSecret() or nil
        local normal, events, unsupported = self:SecretPendingKinds()
        local message, title = "không có event nào", "Secret Event"
        if selected then
            local _, reason = self:SecretRaidReady(selected, self:GetMoment(selected.Name))
            message = reason or (selected.Name .. " chưa active")
        elseif normal > 0 then
            message = "Đang quét " .. tostring(normal) .. " quest thường khả dụng"
            title = "Auto Secrets"
        elseif events == 0 and unsupported > 0 then
            message = "Không còn quest có resolver client xác minh được"
            title = "Auto Secrets"
        end
        self:SecretStatus(nil, message)
        if os.clock() >= (self.SecretNoEventNoticeAt or 0) then
            self.SecretNoEventNoticeAt = os.clock() + 30
            self:Notify(title, message)
        end
        self.SecretLastActiveNotice = nil
        self:CancelMove()
        return
    end
    if not self.SecretCurrent then
        self.SecretCurrent, self.SecretStartedAt = row, os.clock()
        local _, kind = self:SecretAvailable(row)
        self.SecretCurrentKind = kind or "Selected"
        self.SecretNoEventNoticeAt = 0
        if self.SecretLastActiveNotice ~= row.Name then
            self.SecretLastActiveNotice = row.Name
            local message = kind == "Event" and (row.Name .. " đang active")
                or kind == "Turn-in" and (row.Name .. " đang chờ trả nhiệm vụ")
                or kind == "Quest" and (row.Name .. " quest đang chạy")
                or kind == "Tracker" and (row.Name .. " tracker đang tồn tại")
                or kind == "Normal" and (row.Name .. " quest thường khả dụng")
                or (row.Name .. " đã được chọn")
            self:Notify("Secret Event", message)
        end
    end
    local liveMoment = self:GetMoment(row.Name)
    local status = Compat.progressState(self.Progress, row.Address)
    local actionState = self.SecretActions[row.Address] or {}
    self.SecretActions[row.Address] = actionState
    if status == "Completed" or liveMoment and liveMoment.Completed == true or actionState.CompletionPending or self:SecretNativeCompletion(row) then
        if self:SecretCompletion(row) then return end
        self:SkipSecret()
        self:SecretStatus(row, "Completed")
        return
    end
    if status ~= "Incomplete" then self:PauseSecret(row, "Progress unavailable", 10); return end
    local _, _, reportGuideId = self:SecretGuide(row, true)
    if reportGuideId and (reportGuideId:find("REPORT", 1, true) or reportGuideId == "PricklyHarvestMerchant" or reportGuideId == "TavernBrawlBartender") then
        if self:RunSecretGuide(row, true) then return end
    end
    local raidReady, raidReason = self:SecretRaidReady(row, liveMoment)
    if not raidReady then
        if os.clock() >= (self.SecretUnavailableNoticeAt or 0) then
            self.SecretUnavailableNoticeAt = os.clock() + 12
            self:Notify("Secret Event", raidReason or (row.Name .. " chưa khả dụng"))
        end
        self:PauseSecret(row, raidReason or "Event không còn active", 8)
        return
    end
    if os.clock() - (self.SecretStartedAt or 0) > 600 then self:PauseSecret(row, "Objective timed out", 30); return end
    local handler = self.SecretHandlers[row.Name]
    local useNative = not handler or handler.Action == "Auto" and handler.ExactFlow ~= true
    local targets = useNative and self:SecretNativeQuest(row) or nil
    if targets then
        local enemy = self:Enemies(targets)[1]
        self:SecretStatus(row, "QuestData | " .. table.concat(targets, ", "))
        if enemy then self.SecretCombatAllowed = true; self:Fight(enemy, targets)
        else self:MoveToSpawn(targets) end
        return
    end
    if (not handler or handler.Action ~= "Windmill") and self:RunSecretGuide(row) then return end
    if not handler then self:PauseSecret(row, "No verified client resolver", 60); return end
    if liveMoment and liveMoment.Active == true or self:SecretNativeQuest(row) then actionState.Accepted = true end
    local cf, npcFound = self:SecretDestination(row)
    if not cf then self:PauseSecret(row, "Waiting for island data", 10); return end
    local travelRange = npcFound and 15 or 1000
    if (root.Position - cf.Position).Magnitude > travelRange then
        actionState.MomentMissingAt = nil
        self:SecretStatus(row, npcFound and "Start | Moving to quest giver" or "Travel | Moving to island")
        self:MoveTo(cf)
        return
    end
    local moment = liveMoment or self:GetMoment(row.Name)
    if self:SecretIsEvent(row) then
        if not moment or moment.Active ~= true then
            self:PauseSecret(row, row.Name .. " event không còn active", 12)
            return
        end
        actionState.MomentMissingAt = nil
    elseif moment then
        actionState.MomentMissingAt = nil
    else
        actionState.MomentMissingAt = actionState.MomentMissingAt or os.clock()
        local waiting = os.clock() - actionState.MomentMissingAt
        local history = self.SecretMomentStates and self.SecretMomentStates[row.Name]
        local hasHistory = false
        for eventName, packet in pairs(type(history) == "table" and history or {}) do
            local activeSignal = eventName ~= "SetActive" or packet.Args and packet.Args[1] == true
            if activeSignal and eventName ~= "Reset" and eventName ~= "ResetProgress" and eventName ~= "Clear" then hasHistory = true; break end
        end
        local runtimeEvidence = handler.NoMoment or hasHistory or self:SecretNativeQuest(row) or self:SecretGuide(row, true)
        if not runtimeEvidence and waiting >= 45 and self.Config["Secrets Scope"] == "Available" then
            self:PauseSecret(row, "Quest client chưa load | Checking next normal quest", 20)
            return
        end
        if waiting < 3 and not runtimeEvidence then self:SecretStatus(row, "Loading normal quest client") end
    end
    local interaction = self:Module("BonusMomentInteraction", { "Util", "BonusMomentInteraction" })
    if interaction and type(interaction.isTransformed) == "function" then
        local checked, transformed = pcall(interaction.isTransformed, Player.Character)
        if checked and transformed then self:PauseSecret(row, "Return to normal form", 10); return end
    end
    self:SecretAction(row, moment, handler, npcFound)
end

function Hub:ExportQuestClients()
    if self.ExportingQuests then self:Notify("Quest Clients", "Export in progress."); return end
    if type(decompile) ~= "function" or type(writefile) ~= "function" then
        self:Notify("Quest Clients", "Decompiler and file access required."); return
    end
    local folder = Services.ReplicatedStorage:FindFirstChild("BonusMoments")
    if not folder then self:Notify("Quest Clients", "BonusMoments is not loaded."); return end
    self.ExportingQuests = true
    local saved, problem = pcall(function()
        local modules = {}
        for _, object in ipairs(folder:GetDescendants()) do
            if not self.Alive then return end
            if object:IsA("ModuleScript") then
                local ok, source = self:Call("export:" .. object:GetFullName(), 12, 1, function() return decompile(object) end)
                modules[#modules + 1] = { Name = object.Name, Path = object:GetFullName(), Island = object:GetAttribute("Island"),
                    Source = ok and type(source) == "string" and source or nil, Error = not ok and tostring(source) or nil }
            end
        end
        if type(isfolder) == "function" and type(makefolder) == "function" then
            local built
            for segment in self.ConfigFolder:gmatch("[^/]+") do
                built = built and (built .. "/" .. segment) or segment
                if not isfolder(built) then makefolder(built) end
            end
        end
        local path = self.ConfigFolder .. "/QuestClients.json"
        writefile(path, Services.HttpService:JSONEncode({ PlaceId = game.PlaceId, Modules = modules }))
        self:Notify("Quest Clients", "Saved " .. path)
    end)
    self.ExportingQuests = false
    if not saved then self:Notify("Quest Clients", problem) end
end

