local function detectProfileFn(t) return isProfileTable(t) and 1 or 0 end
local function selfTarget(args)
    local other = false
    local function check(value, key, depth)
        if other or depth > 2 then return end
        if typeof(value) == "Instance" and value:IsA("Player") and value ~= P then other = true; return end
        if type(value) == "number" and (key == "UserId" or key == "TargetUserId" or depth == 0) then
            local found = Players:GetPlayerByUserId(value)
            if found and found ~= P then other = true end
            return
        end
        if type(value) == "string" then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= P and (value == plr.Name or value == plr.DisplayName) then other = true; return end
            end
            return
        end
        if type(value) == "table" then
            for k, v in pairs(value) do check(v, type(k) == "string" and k or nil, depth + 1) end
        end
    end
    for i = 1, args.n do check(args[i], nil, 0) end
    return not other
end
local function grabName(args)
