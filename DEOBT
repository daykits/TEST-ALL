function Hub:HalloweenEnemy()
    local _, _, root = self:Character()
    if not root then return nil end
    local found = self:HalloweenEventEnemies()
    local named
    for _, model in ipairs(found) do
        if model:GetAttribute("LocalEnemy") == Player.Name then return model end
        local lowerName = model.Name:lower()
        if lowerName == "hellfire gas" or lowerName == "dapper jack" or lowerName == "pumpkin snowman" then return model end
        if not named then
            local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if part and (part.Position - root.Position).Magnitude <= 150 then named = model end
        end
    end
    if not named and found[1] and (self:HalloweenBusy() or self.HalloweenBossSession or self:HalloweenInHellfireRealm()) then named = found[1] end
    return named
end

