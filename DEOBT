local function installHook()
    if Env.__BaconUnlockHookV3 == true then return true end
    if typeof(hookmetamethod) ~= "function" then log("hook: executor has no hookmetamethod"); return false end
    local ok = pcall(function()
        local mt
        if typeof(getrawmetatable) == "function" then
            mt = getrawmetatable(game)
            if typeof(setreadonly) == "function" and mt then setreadonly(mt, false) end
        end
        local old
        local hookFn = function(obj, ...)
            local st = Env.__BaconUnlockAllState
            if type(st) ~= "table" or st.Enabled ~= true then return old(obj, ...) end
            local method = ""
            if typeof(getnamecallmethod) == "function" then
                local okMethod, name = pcall(getnamecallmethod)
                if okMethod and type(name) == "string" then method = string.upper(name) end
            end
            local remoteName = ""
            pcall(function() remoteName = tostring(obj.Name) end)
            if method == "FIRESERVER" and remoteName == "UpdatePlayerProfileValue" then
                st.PH += 1
                return
            end
            if method == "INVOKE" and typeof(obj) == "Instance" and obj:IsA("BindableFunction") and string.find(string.lower(remoteName), "playerprofile", 1, true) then
                local bargs = table.pack(...)
                local results = table.pack(old(obj, ...))
                for r = 1, math.min(3, results.n) do
                    if type(results[r]) == "table" and scan(results[r], detectProfileFn) > 0 and selfTarget(bargs) then
                        scan(results[r], profileFn)
                    end
                end
                return table.unpack(results, 1, results.n)
            end
            if method ~= "INVOKESERVER" then return old(obj, ...) end
            local args = table.pack(...)
            local cmd = type(args[1]) == "string" and args[1] or ""
            if remoteName == "UpdatePlayerProfileValue" then
                st.PH += 1
                log("profile update blocked (visual): " .. tostring(args[1]) .. " " .. tostring(args[2]))
                return true
            end
            if cmd == "activateTitle" or cmd == "activateTitleColor" then
                local picked = grabName(args)
                if cmd == "activateTitle" and picked then st.FakeTitle = picked end
                if cmd == "activateTitleColor" and picked then st.FakeColor = picked end
                st.TH += 1
                log("fake title equip: " .. cmd .. " = " .. tostring(picked))
                return true
            end
            local results = table.pack(old(obj, ...))
            for r = 1, math.min(3, results.n) do
                if type(results[r]) == "table" then
                    if cmd == "getTitles" then
                        local hits = scan(results[r], titleFn)
                        if hits > 0 then st.TH += hits end
                    end
                    if scan(results[r], detectProfileFn) > 0 then
                        if selfTarget(args) then scan(results[r], profileFn) end
                    else
                        local hits = scan(results[r], fruitFn)
                        if hits > 0 then st.FH += hits end
                    end
                end
            end
            return table.unpack(results, 1, results.n)
        end
        if typeof(newcclosure) == "function" then
            local okWrap, wrapped = pcall(newcclosure, hookFn)
            if okWrap and wrapped then hookFn = wrapped end
        end
        old = hookmetamethod(game, "__namecall", hookFn)
        if typeof(setreadonly) == "function" and mt then setreadonly(mt, true) end
    end)
    if ok then
        Env.__BaconUnlockHookV3 = true
        log("hook v3 installed: fruits + titles + profile")
        return true
    end
    log("hook v3 install FAILED")
    return false
end
