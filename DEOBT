	function PlayerAuraEffect()
		localCharacter = localPlayer.Character

		if not localCharacter then
			return
		end

		localRoot = localCharacter:FindFirstChild("HumanoidRootPart")

		if not localRoot then
			return
		end

		playerPos = localRoot.Position
		players = Players:GetPlayers()
		validPlayers = {}

		for _, v in ipairs(players) do
			if v ~= localPlayer and v.Character then
				otherRoot = v.Character:FindFirstChild("HumanoidRootPart")

				if otherRoot and (otherRoot.Position - playerPos).Magnitude <= PlayerAuraSettings.MaxDistance then
					table.insert(validPlayers, v)
					SetPlayerNoclip(v.Character, true)
				end
			end

			if #validPlayers >= 10 then
				break
			end
		end

		angleOffset = #validPlayers > 0 and 360 / #validPlayers or 0

		for i, v in ipairs(validPlayers) do
			pcall(function()
				otherRoot = v.Character:FindFirstChild("HumanoidRootPart")

				if otherRoot then
					SetNetworkOwner:FireServer(otherRoot, otherRoot.CFrame)
					distanceToPlayer = (otherRoot.Position - playerPos).Magnitude
					separationAngle = (i - 1) * angleOffset
					separationRadius = PlayerAuraSettings.PlayerSeparation * (i - 1)
					baseX = playerPos.X + separationRadius * math.cos(math.rad(separationAngle))
					baseZ = playerPos.Z + separationRadius * math.sin(math.rad(separationAngle))
					approach = distanceToPlayer > PlayerAuraSettings.MinDistance

					for i2 = 1, PlayerAuraSettings.Layers do
						angle = tick() * PlayerAuraSettings.RotationSpeed + separationAngle + i2 * (360 / PlayerAuraSettings.Layers)
						radius = i2 * PlayerAuraSettings.RadiusMultiplier + separationRadius

						local v167, v168

						if approach then
							direction = (playerPos - otherRoot.Position).Unit
