		_G.AutoChestBP = p8

		if p8 then
			local LocalPlayer = game:GetService("Players").LocalPlayer
			local u40 = false
			local t3 = {}
			local u42 = true

			local function v43()
				if not LocalPlayer.Character then
					LocalPlayer.CharacterAdded:Wait()
				end

				LocalPlayer.Character:WaitForChild("HumanoidRootPart")

				return LocalPlayer.Character
			end
			local function v44()
				if u42 then
					u42 = false

					for _, descendant in pairs(game:GetDescendants()) do
						if descendant.Name:find("Chest") and descendant.ClassName == "Part" then
							table.insert(t3, descendant)
						end
					end
				end

				local t4 = {}

				for _, v in pairs(t3) do
					if v:FindFirstChild("TouchInterest") then
						table.insert(t4, v)
					end
				end

				local LowerTorso = v43().LowerTorso

				table.sort(t4, function(p9, p10)
					return (LowerTorso.Position - p9.Position).Magnitude < (LowerTorso.Position - p10.Position).Magnitude
				end)

				return t4
			end
			local function v51()
				if u40 then
					return
				end

				u40 = true
				task.spawn(function()
					while _G.AutoChestBP and LocalPlayer.Character and LocalPlayer.Character.Parent do
						local v52 = v44()

						if #v52 > 0 then
							v43().HumanoidRootPart.CFrame = v52[1].CFrame
						end

						task.wait(0.1)
					end

					u40 = false
				end)
			end
			local function v53()
				v43()
				task.wait(0.5)

				if _G.AutoChestBP then
					v51()
				end
			end

			LocalPlayer.CharacterAdded:Connect(v53)
			v51()
		end
	end
})

