local function applyLowGraphicsSettings()

	local settings = DefaultConfig.SETTINGS or {}

	local opt = settings.OPTIMIZATION or {}

	if opt.LOW_GRAPHICS ~= true and opt.UGLY_GRAPHICS ~= true then return end

	pcall(function()

		Lighting.GlobalShadows = false

		Lighting.Brightness = 0

		Lighting.EnvironmentDiffuseScale = 0

		Lighting.EnvironmentSpecularScale = 0

		Lighting.FogEnd = 9e9

		Lighting.Technology = Enum.Technology.Compatibility

	end)

	pcall(function()

		local terrain = workspace:FindFirstChild("Terrain")

		if terrain then

			terrain.WaterWaveSize = 0

			terrain.WaterWaveSpeed = 0

			terrain.WaterReflectance = 0

			terrain.WaterTransparency = 1

			terrain.Decoration = false

		end

	end)

	if not H.lowGraphicsConn then

		H.lowGraphicsConn = workspace.DescendantAdded:Connect(function(obj)

			makeObjectLowGraphics(obj)

		end)

	end

	local sweepInterval = H.lowGraphicsInitialSweepDone and (H.LOW_GRAPHICS_SWEEP_INTERVAL or 30) or 0

	if tick() - (H.lastLowGraphicsSweep or 0) >= sweepInterval then

		H.lastLowGraphicsSweep = tick()

		H.lowGraphicsInitialSweepDone = true

		for _, obj in ipairs(workspace:GetDescendants()) do

			makeObjectLowGraphics(obj)

		end

		for _, obj in ipairs(Lighting:GetDescendants()) do

			makeObjectLowGraphics(obj)

		end

	end

end

local function applyOptimizationSettings()

	local settings = DefaultConfig.SETTINGS or {}

	local opt = settings.OPTIMIZATION or {}

	local fpsCap = tonumber(opt.FPS_CAP)

	if fpsCap and fpsCap > 0 then

		pcall(function()

			if type(setfpscap) == "function" then

				setfpscap(fpsCap)

			end

		end)

	end

	pcall(function()

		if RunService.Set3dRenderingEnabled then

			RunService:Set3dRenderingEnabled(opt.DISABLE3DRENDER ~= true)

		end

	end)

	applyLowGraphicsSettings()

end

