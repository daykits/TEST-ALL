function Hub:FishClientCast(down)
    down = down == true
    if down == (self.FishClientCastDown == true) then return true end
    if down then
        local control = self:FishingControl()
        if not control then return false end
        local input = {
            UserInputType = Enum.UserInputType.MouseButton1,
            UserInputState = Enum.UserInputState.Begin,
            KeyCode = Enum.KeyCode.Unknown,
            Position = Vector3.zero,
        }
        control.ActiveInputs = control.ActiveInputs or {}
        control.ActiveInputs[input] = { startTime = tick() }
        control.numActiveInputs = (control.numActiveInputs or 0) + 1
        self.FishClientControl, self.FishClientInput, self.FishClientCastDown = control, input, true
        task.spawn(function() pcall(control.OnBegan, input) end)
        return true
    end
    local control, input = self.FishClientControl, self.FishClientInput
    self.FishClientControl, self.FishClientInput, self.FishClientCastDown = nil, nil, false
    if not control or not input then return true end
    input.UserInputState = Enum.UserInputState.End
    if control.ActiveInputs then control.ActiveInputs[input] = nil end
    control.numActiveInputs = math.max(0, (control.numActiveInputs or 1) - 1)
    task.spawn(function() pcall(control.OnEnded, input) end)
    return true
end

