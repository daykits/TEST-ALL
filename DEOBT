function Hub:SecretEarlyAccess(row, moment, handler, state)
    if not moment then return false end
    local ok, stage = self:SecretRemote(row, moment, "GetState", true, 0.8)
    if not ok or type(stage) ~= "number" then self:SecretStatus(row, "Early Access | Loading state"); return true end
    state.Accepted = true
    local action, names, fallback
    if stage == 0 then action, names = "AcceptQuest", { "QuestGiver" }
    elseif stage == 1 then action, names = "CollectKey", { "KeySpot", "MansionKey" }
    elseif stage == 2 then action, names, fallback = "InteractMansionDoor", { "RobotmegaRearDoor", "MansionDoor" }, CFrame.new(-1090.3401, 11.6863, 1805.7358)
    elseif stage == 3 then
        state.InfiltrationReady = state.InfiltrationReady or os.clock() + 8.5
        if os.clock() < state.InfiltrationReady then self:SecretStatus(row, "Early Access | Infiltration"); return true end
        self:SecretRemote(row, moment, "FinishInfiltration", true, 1)
        self:SecretStatus(row, "Early Access | Finish infiltration")
        return true
    elseif stage == 4 then action, names = "ClaimReward", { "QuestGiver" }
    else
        self:RefreshSecrets(true)
        self:SecretStatus(row, "Early Access | Completed")
        return true
    end
    local target, distance = self:SecretFindCandidate(row, moment, handler, names)
    local cf = target and Compat.cframe(self:SecretObjectPart(target.Object)) or fallback
    if stage == 0 or stage == 4 then
        local npc = self:LiveSecretNPC(handler.NPC)
        cf = npc or cf
    end
    local _, _, root = self:Character()
    if not cf or not root then self:SecretStatus(row, "Early Access | Waiting for " .. names[1]); return true end
    if (root.Position - cf.Position).Magnitude > 15 then self:MoveTo(cf); self:SecretStatus(row, "Early Access | " .. names[1]); return true end
    if stage == 0 then self:SecretRemote(row, moment, "InteractQuestGiver", true, 0.7) end
    local sent, result = self:SecretRemote(row, moment, action, true, 1)
    if stage == 2 and sent and result == "Infiltration" then state.InfiltrationReady = os.clock() + 8.5 end
    if stage == 4 and sent then self:RefreshSecrets(true) end
    self:SecretStatus(row, "Early Access | " .. action)
    return true
end

function Hub:SecretLookout(row, moment, state)
    if not moment then self:SecretStatus(row, "Lookout | Waiting for lifecycle"); return true end
    state.Accepted = true
    if state.FinaleToken then
        if os.clock() < (state.FinaleAt or 0) then self:SecretStatus(row, "Lookout | Finale"); return true end
        local ok, done = self:SecretRemote(row, moment, "FinishFinale", true, 2, state.FinaleToken)
        if ok and done == true then
            self:ClaimGuideReward("TravelDressrosa", true)
            self:RefreshSecrets(true)
            state.FinaleToken = nil
        else
            state.FinaleAt = os.clock() + 2
        end
        self:SecretStatus(row, "Lookout | Turn-in")
        return true
    end
    if not state.Round then
        local ok, progress = self:SecretRemote(row, moment, "GetProgress", true, 1)
        if not ok or type(progress) ~= "table" then self:SecretStatus(row, "Lookout | Loading progress"); return true end
        if progress.Unlocked ~= true then
            if type(progress.SecondsRemaining) == "number" and progress.SecondsRemaining > 0 then
                self:SecretStatus(row, "Lookout | Cooldown " .. math.ceil(progress.SecondsRemaining) .. "s")
            else
                self:SecretRemote(row, moment, "AdvanceIntroduction", true, 1)
                self:SecretStatus(row, "Lookout | Introduction")
            end
            return true
        end
        local started, round = self:SecretRemote(row, moment, "StartAttempt", true, 1)
        if started and type(round) == "table" and type(round.Token) == "string" and type(round.Manifest) == "table" then
            state.Round = round
            state.ReadyAt = os.clock() + 0.5
        end
        self:SecretStatus(row, "Lookout | Start observation")
        return true
    end
    if not state.Question then
        if os.clock() < (state.ReadyAt or 0) then return true end
        local ready, question = self:SecretRemote(row, moment, "ObservationFinished", true, 0.5, state.Round.Token)
        if not ready or type(question) ~= "table" then state.Round = nil; return true end
        if question.Ready == false then
            state.ReadyAt = os.clock() + math.clamp(type(question.RetryAfter) == "number" and question.RetryAfter or 0.5, 0.1, 5)
            self:SecretStatus(row, "Lookout | Watching ships")
            return true
        end
        state.Question = question
    end
    local question, round = state.Question, state.Round
    local count = 0
    for _, ship in ipairs(round.Manifest) do
        if type(ship) == "table" and ship.Boat == question.TargetBoat and ship.FlagColor == question.TargetFlagColor then count += 1 end
    end
    if type(question.AnswerChoices) ~= "table" or not table.find(question.AnswerChoices, count) then
        state.Round, state.Question = nil, nil
        self:SecretStatus(row, "Lookout | Invalid server question")
        return true
    end
    local answered, reply = self:SecretRemote(row, moment, "SubmitAnswer", true, 0.8, round.Token, count)
    if not answered or type(reply) ~= "table" then state.Round, state.Question = nil, nil; return true end
    if reply.Correct == true and type(reply.NextRound) == "table" then
        state.Round, state.Question = reply.NextRound, nil
        state.ReadyAt = os.clock() + 0.5
        self:SecretStatus(row, "Lookout | Correct, next round")
    elseif reply.Correct == true and reply.Completed == true and type(reply.FinaleToken) == "string" then
        state.Round, state.Question = nil, nil
        state.FinaleToken, state.FinaleAt = reply.FinaleToken, os.clock() + 10
        self:SecretStatus(row, "Lookout | All rounds cleared")
    else
        if type(reply.FinaleToken) == "string" then self:SecretRemote(row, moment, "FinishFinale", true, 1, reply.FinaleToken) end
        state.Round, state.Question = nil, nil
        self:SecretStatus(row, "Lookout | Attempt reset")
    end
    return true
end

