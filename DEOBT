function Hub:IsAttackSuspended()
    local mode = self.ActiveMode
    return not self.Alive or self.InventoryBusy or self.ManualBusy
        or self.ManualDestination ~= nil or mode == "Farm Berries" or mode == "Collect Fruits" or mode == "Fish"
        or mode == "Collect Eggs" or mode == "Collect Embers" or mode == "Chest" or mode == "Auto Blue Moon"
        or (self.Config["Auto Secrets"] and self.SecretCombatAllowed ~= true) or self.KenFarming == true
end

function Hub:IsBackpackWeapon(tool)
    if not Compat.isA(tool, "Tool") then return false end
    local kind = tool:GetAttribute("WeaponType") or tool.ToolTip
    return kind == "Melee" or kind == "Sword"
end

function Hub:ForceBackpackEquip(tool)
    if not self.Alive or not self.Config["Fast Attack"] or not self.Config["Backpack Bypass"]
        or not self:IsBackpackWeapon(tool) then return end
    local backpack = Player:FindFirstChild("Backpack")
    if tool.Parent ~= backpack and tool.Parent ~= Player.Character then return end
    local event = tool:FindFirstChild("EquipEvent")
    if not Compat.isA(event, "RemoteEvent") then return end
    self.FastGear = self.FastGear or setmetatable({}, { __mode = "k" })
    local record = self.FastGear[tool] or { Last = -100 }
    self.FastGear[tool] = record
    if os.clock() - record.Last < 0.2 then return end
    record.Last = os.clock()
    local ok = pcall(event.FireServer, event, true)
    if ok then record.Forced, record.Event = true, event end
end

function Hub:BindFastGear(tool)
    if not self:IsBackpackWeapon(tool) then return end
    self.FastGear = self.FastGear or setmetatable({}, { __mode = "k" })
    local record = self.FastGear[tool]
    if not record then record = { Last = -100 }; self.FastGear[tool] = record end
    if not record.Bound then
        record.Bound = true
        local ok, signal = pcall(function() return tool.Unequipped end)
        if ok then record.Connection = self:Connect(signal, function() self:ForceBackpackEquip(tool) end) end
    end
    self:ForceBackpackEquip(tool)
end

function Hub:MaintainBackpackEquip()
    if not self.Config["Fast Attack"] or not self.Config["Backpack Bypass"] then
        if self.FastBackpackConnection then self.FastBackpackConnection:Disconnect(); self.FastBackpackConnection = nil end
        self.FastBackpack = nil
        return
    end
    local backpack = Player:FindFirstChild("Backpack")
    if backpack ~= self.FastBackpack then
        if self.FastBackpackConnection then self.FastBackpackConnection:Disconnect() end
        self.FastBackpack = backpack
        if backpack then self.FastBackpackConnection = self:Connect(backpack.ChildAdded, function(tool) self:BindFastGear(tool) end) end
    end
    for index = 1, 2 do
        local parent
        if index == 1 then parent = backpack else parent = Player.Character end
        for _, tool in ipairs(parent and parent:GetChildren() or {}) do self:BindFastGear(tool) end
    end
end

function Hub:ReleaseBackpackEquip()
    local backpack = Player:FindFirstChild("Backpack")
    for tool, record in pairs(self.FastGear or {}) do
        if record.Forced and tool.Parent == backpack and record.Event and record.Event.Parent then
            pcall(record.Event.FireServer, record.Event, false)
        end
        record.Forced = false
    end
end

function Hub:FastWeapon()
    local char = Player.Character
    local equipped = char and char:FindFirstChildOfClass("Tool")
    if equipped then return equipped end
    if not self.Config["Backpack Bypass"] then return nil end
    local backpack = Player:FindFirstChild("Backpack")
    local selected = _G.SelectWeapon
    local tool = type(selected) == "string" and backpack and backpack:FindFirstChild(selected)
    if self:IsBackpackWeapon(tool) then return tool end
    for _, candidate in ipairs(backpack and backpack:GetChildren() or {}) do
        if self:IsBackpackWeapon(candidate) then return candidate end
    end
    return nil
end

function Hub:FastTargets()
    local char, _, root = self:Character()
    if not char then return nil end
    local range = self.Config["Fast Range"]
    local rows, seen = {}, {}
    local function add(model)
        if seen[model] or model == char or not self:AliveEnemy(model) then return end
        if self:MasteryActive() and self:MasteryWeak(model) then return end
        local part = model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
        local body = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if not Compat.isA(part, "BasePart") or not body then return end
        local distance = (body.Position - root.Position).Magnitude
        if distance > range then return end
        seen[model] = true
        rows[#rows + 1] = { Model = model, Part = part, Distance = distance, Priority = model == self.Target and 0 or 1 }
    end
    local enemies = Services.Workspace:FindFirstChild("Enemies")
    for _, model in ipairs(enemies and enemies:GetChildren() or {}) do add(model) end
    local pumpkinFolder = Services.Workspace:FindFirstChild("PumpkinHunt")
    for _, model in ipairs(pumpkinFolder and pumpkinFolder:GetChildren() or {}) do
        if model:IsA("Model") and not seen[model] then
            local state = model:GetAttribute("PumpkinState")
            local isPatch = model.Name == "PumpkinPatch" or model:GetAttribute("PumpkinRare") == true
            if state == "Idle" or (isPatch and state == nil) then
                local part = self:HalloweenPumpkinHitPart(model)
                if part then
                    local distance = (part.Position - root.Position).Magnitude
                    if distance <= range then
                        seen[model] = true
                        rows[#rows + 1] = { Model = model, Part = part, Distance = distance, Priority = 2 }
                    end
                end
            end
        end
    end
    if self.Config["Player Targets"] then
        local characters = Services.Workspace:FindFirstChild("Characters")
        for _, model in ipairs(characters and characters:GetChildren() or {}) do add(model) end
    end
    table.sort(rows, function(a, b)
        if a.Priority ~= b.Priority then return a.Priority < b.Priority end
        return a.Distance < b.Distance
    end)
    if #rows == 0 then return nil end
    local count = math.min(#rows, self.Config["Fast Targets"])
    local extras = {}
    for index = 2, count do extras[#extras + 1] = { rows[index].Model, rows[index].Part } end
    return rows[1].Part, extras, rows[1].Model, count
end

function Hub:FastTransport()
    if self.Config["Fast Packet"] == "Direct" then
        local directAttack = self:NetRemote("RE", "RegisterAttack")
        local directHit = self:NetRemote("RE", "RegisterHit")
        if not directAttack or not directHit then return nil, "Combat remotes unavailable" end
        return { Attack = directAttack, Hit = directHit, Mode = "Direct" }
    end
    local attackRaw = self:NetRemote("RE", "RegisterAttack")
    local hitRaw = self:NetRemote("RE", "RegisterHit")
    if not attackRaw or not hitRaw then return nil, "Combat remotes unavailable" end
    local network = self:Module("NativeNet", { "Modules", "Net" })
    if not network or type(network.RemoteEvent) ~= "function" then return nil, "Network loading" end
    local attack = attackRaw
    local hit = hitRaw
    if attackRaw:GetAttribute("Virtual") == true then
        local _, proxy = pcall(network.RemoteEvent, network, "RegisterAttack")
        if proxy and type(proxy.FireServer) == "function" then attack = proxy end
    end
    if hitRaw:GetAttribute("Virtual") == true then
        local _, proxy = pcall(network.RemoteEvent, network, "RegisterHit", true)
        if proxy and type(proxy.FireServer) == "function" then hit = proxy end
    end
    if type(hit.FireServer) ~= "function" then return nil, "Hit proxy unavailable" end
    local global = self:Module("Global", { "Global" })
    if global and type(global.SendHitsToServer) == "function" then
        return { Attack = attack, Send = global.SendHitsToServer, Mode = "Auto" }
    end
    return { Attack = attack, Hit = hit, Mode = "Auto" }
end

function Hub:FastComboIndex(tool)
    local api = self:Module("CombatUtil", { "Modules", "CombatUtil" })
    if not api or not tool then return nil end
    local ok, count = pcall(function()
        local data = api:GetWeaponData(api:GetWeaponName(tool))
        return data and data.Moveset and data.Moveset.Basic and #data.Moveset.Basic
    end)
    if not ok or type(count) ~= "number" or count < 1 then return nil end
    if self.FastTool ~= tool then self.FastCombo = 0 end
    self.FastTool = tool
    self.FastCombo = (self.FastCombo or 0) % count + 1
    return self.FastCombo
end

function Hub:NativeWeaponData(tool)
    if not Compat.isA(tool, "Tool") or tool.Parent ~= Player.Character then return nil end
    local api = self:Module("CombatUtil", { "Modules", "CombatUtil" })
    if not api or type(api.GetWeaponName) ~= "function" or type(api.GetWeaponData) ~= "function" then return nil end
    local ok, name, data = pcall(function()
        local weaponName = api:GetWeaponName(tool)
        return weaponName, api:GetWeaponData(weaponName)
    end)
    if not ok or name == nil or type(data) ~= "table" or data.WeaponType == nil then return nil end
    return data
end

function Hub:NativeM1(tool, model)
    if not self:NativeWeaponData(tool) then return end
    if os.clock() < (self.NativeNext or 0) then return end
    local controller = self:Module("CombatController", { "Controllers", "CombatController" })
    if not controller or type(controller.Attack) ~= "function" then return end
    self.NativeNext = os.clock() + self.Config.AttackInterval
    self:InstallAimAdapter()
    self.AttackTarget = model
    local input = self:NewInput()
    local ok, reason = self:Call("native-m1", 5, self.Config.AttackInterval, function()
        if not self:NativeWeaponData(tool) then return false end
        return controller:Attack(tool, input)
    end)
    input:Release()
    if not ok then self:Log("native-m1", reason) end
end

function Hub:IsFruitTool(tool)
