function Hub:SecretTavern(row, moment, handler, state)
    local setup = self:SecretEvent(row.Name, "Setup")
    if not setup or not setup.Args then
        self:SecretStatus(row, "Tavern | Waiting for Setup")
        return true
    end
    local door, bartender = setup.Args[1], setup.Args[3]
    local active, available, defeated = setup.Args[5] == true, setup.Args[6] == true, setup.Args[7] == true
    defeated = defeated or self:SecretEvent(row.Name, "BrawlersDefeated") ~= nil
    local _, _, root = self:Character()
    if defeated then
        if typeof(bartender) == "CFrame" and root and (root.Position - bartender.Position).Magnitude > 11 then
            self:MoveTo(bartender)
            self:SecretStatus(row, "Tavern | Move to bartender")
        else
            self:SecretRemote(row, moment, "ClaimReward", false, 1)
            self:SecretStatus(row, "Tavern | ClaimReward")
        end
        return true
    end
    local gang = self:SecretEvent(row.Name, "GangUp")
    if gang then
        if self:SecretEnemy(row, moment, handler) then return true end
        if os.clock() - gang.At > 2.5 and (not state.GangUpSentAt or os.clock() - state.GangUpSentAt > 4) then
            state.GangUpSentAt = os.clock()
            self:SecretRemote(row, moment, "BeginGangUp", false, 2)
        end
        self:SecretStatus(row, "Tavern | BeginGangUp")
        return true
    end
    if self:SecretEvent(row.Name, "GangUpStart") then
        self:SecretStatus(row, "Tavern | Waiting for gang-up sequence")
        return true
    end
    local fight = self:SecretEvent(row.Name, "FightStart")
    if fight then
        if self:SecretEnemy(row, moment, handler) then return true end
        if os.clock() - fight.At > 2.5 and (not state.FightSentAt or os.clock() - state.FightSentAt > 4) then
            state.FightSentAt = os.clock()
            self:SecretRemote(row, moment, "BeginFight", false, 2)
        end
        self:SecretStatus(row, "Tavern | BeginFight")
        return true
    end
    if self:SecretEvent(row.Name, "BreachStart") then
        self:SecretStatus(row, "Tavern | Client breach sequence")
        return true
    end
    if active then
        if self:SecretEnemy(row, moment, handler) then return true end
        self:SecretStatus(row, "Tavern | Active phase sync")
        return true
    end
    if available then
        if typeof(door) == "CFrame" and root and (root.Position - door.Position).Magnitude > 10 then
            self:MoveTo(door)
            self:SecretStatus(row, "Tavern | Move to breach door")
        else
            self:SecretRemote(row, moment, "Breach", false, 2)
            self:SecretStatus(row, "Tavern | Breach")
        end
        return true
    end
    self:SecretStatus(row, "Tavern | Not available")
    return true
end

function Hub:SecretTempleClick(coil, target)
    local part = self:SecretObjectPart(coil)
    local camera = Services.Workspace.CurrentCamera
    if not part or not camera then return false end
    local _, _, root = self:Character()
    if not root then return false end
    if (root.Position - part.Position).Magnitude > 29 then
        local direction = target - part.Position
        direction = direction.Magnitude > 0.01 and direction.Unit or Vector3.new(0, 0, 1)
        self:MoveTo(CFrame.lookAt(part.Position - direction * 8 + Vector3.new(0, 2, 0), part.Position))
        return nil
    end
    pcall(function() camera.CFrame = CFrame.lookAt(camera.CFrame.Position, part.Position) end)
    local point, visible = camera:WorldToViewportPoint(part.Position)
    if not visible then return false end
    local ok, vim = pcall(game.GetService, game, "VirtualInputManager")
    if not ok or not vim then return false end
    vim:SendMouseMoveEvent(point.X, point.Y, game)
    vim:SendMouseButtonEvent(point.X, point.Y, 0, true, game, 0)
    task.wait(0.05)
    vim:SendMouseButtonEvent(point.X, point.Y, 0, false, game, 0)
    return true
end

function Hub:SecretTemple(row, moment, state)
    local reveal = self:SecretEvent(row.Name, "Reveal")
    local storm = self:SecretEvent(row.Name, "Storm")
    local _, _, root = self:Character()
    local origin = Vector3.new(-7389.549, 5598.91, 338.985)
    if not reveal then
        if root and (root.Position - origin).Magnitude > 18 then self:MoveTo(CFrame.new(origin)) end
        self:SecretStatus(row, storm and storm.Args and storm.Args[1] == true and "Temple | Hold open storm position" or "Temple | Waiting for Storm")
        return true
    end
    local revealPosition = reveal.Args and reveal.Args[1]
    if typeof(revealPosition) == "Vector3" then origin = revealPosition end
    local puzzle = Services.Workspace:FindFirstChild("TeslaPuzzle", true)
    if not puzzle then
        if root and (root.Position - origin).Magnitude > 25 then self:MoveTo(CFrame.new(origin)) end
        self:SecretStatus(row, "Temple | Waiting for TeslaPuzzle")
        return true
    end
    local rotations = { 2, 0, 2, 1, 2, 0 }
    state.TempleClicks = state.TempleClicks or {}
    for index = 1, 6 do
        local needed = rotations[index]
        local done = state.TempleClicks[index] or 0
        if done < needed then
            if os.clock() < (state.TempleNextClick or 0) then return true end
            local coil = puzzle:FindFirstChild("Coil" .. index, true)
            if not coil then
                self:SecretStatus(row, "Temple | Waiting for Coil" .. index)
                return true
            end
            local clicked = self:SecretTempleClick(coil, origin)
            if clicked == nil then
                self:SecretStatus(row, "Temple | Approach Coil" .. index)
            elseif clicked then
                state.TempleClicks[index] = done + 1
                state.TempleNextClick = os.clock() + 1.65
                self:SecretStatus(row, "Temple | Coil" .. index .. " " .. state.TempleClicks[index] .. "/" .. needed)
            else
                self:SecretStatus(row, "Temple | Client raycast input unavailable")
            end
            return true
        end
    end
    state.TempleSolved = true
    if root and (root.Position - origin).Magnitude > 24 then self:MoveTo(CFrame.new(origin)) end
    self:SecretStatus(row, "Temple | Waiting for Solved and TakeIntel")
    return true
end

function Hub:SecretChef(row, moment, handler, state)
    if not moment then return false end
    local target, distance = self:SecretFindCandidate(row, moment, handler, { "Cauldron", "Cauldron_Moment", "Pot" })
    if not target then return false end
    if distance and distance > 15 then return self:SecretInteractObject(row, handler, target) end
    local ok, kitchen = self:SecretRemote(row, moment, "OpenCauldron", true, 1)
    if not ok or type(kitchen) ~= "table" then
        ok, kitchen = self:SecretRemote(row, moment, "GetState", true, 1)
    end
    if not ok or type(kitchen) ~= "table" then return false end
    if kitchen.Cooked == true then return false end
    local slots = kitchen.Slots or kitchen.Sheet
    local placed, owned, examples = kitchen.Placed or {}, kitchen.Owned or {}, kitchen.Examples or {}
    if type(slots) ~= "table" then return false end
    for _, slot in ipairs(slots) do
        if placed[slot] == nil then
            local chosen
            local inventory = type(owned[slot]) == "table" and owned[slot] or {}
            for _, item in ipairs(type(examples[slot]) == "table" and examples[slot] or {}) do
                if type(inventory[item]) == "number" and inventory[item] > 0 then chosen = item; break end
            end
            if not chosen then
                self:SecretStatus(row, "Recipe | Missing ingredient for " .. tostring(slot))
                return true
            end
            self:SecretRemote(row, moment, "Insert", true, 0.7, chosen)
            self:SecretStatus(row, "Recipe | Insert " .. tostring(chosen))
            return true
        end
    end
    local cooked, result = self:SecretRemote(row, moment, "Cook", true, 1)
    if cooked and (result == "Cooked" or result == "NoChef") then self:SecretRemote(row, moment, "CloseCauldron", false, 0.5) end
    self:SecretStatus(row, "Recipe | Cooking")
    return true
end

function Hub:SecretEcho(row, moment, handler, state)
    if self:SecretEvent(row.Name, "Finale") then
        if self:SecretEnemy(row, moment, handler) then return true end
        self:SecretStatus(row, "Objective | Waiting for awakened Wysper")
        return true
    end
    local candidate = self:SecretFindCandidate(row, moment, handler, handler.Objects, false)
    if not candidate then
        self:SecretStatus(row, "Objective | Locating Golden Bell")
        return self:MoveTo(self:SecretDestination(row), 8)
    end
    local round = self.SecretEchoRound
    local now = Services.Workspace:GetServerTimeNow()
    if type(round) == "table" and type(round.Notes) == "table" then
        local index = round.Index or 1
        local note = round.Notes[index]
        local targetAt = round.Start + (index - 1) * round.Beat
        if type(note) ~= "string" then
            self.SecretEchoRound = nil
        elseif now > targetAt + (round.Good or 0.38) then
            self.SecretEchoRound = nil
        else
            local weapon = note == "Fruit" and "Demon Fruit" or note
            local tool = self:SecretTool({ WeaponTypes = { weapon } }, state)
            if not tool then
                self:SecretStatus(row, "Objective | Missing " .. note .. " weapon")
                return false
            end
            if now < targetAt - 0.1 then
                self:MoveTo(Compat.cframe(candidate.Object), 7)
                self:SecretStatus(row, "Objective | Bell note " .. index .. "/" .. #round.Notes .. " | " .. note)
                return true
            end
            local handled, struck = self:SecretStrike(row, { WeaponTypes = { weapon }, StrikeRate = 0.08 }, candidate)
            if struck then
                round.Index = index + 1
                self:SecretStatus(row, "Objective | Bell note " .. index .. "/" .. #round.Notes .. " | " .. note)
            end
            return handled == true
        end
    end
    if os.clock() >= (state.EchoProbe or 0) then
        state.EchoProbe = os.clock() + 4
        self:SecretStatus(row, "Objective | Starting bell sequence")
        return self:SecretStrike(row, handler, candidate)
    end
    self:SecretStatus(row, "Objective | Listening for bell sequence")
    return true
end

