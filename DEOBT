    if not Compat.isA(remote, "RemoteEvent") or remote == self.QuestRemote then return end
    if self.QuestConnection then self.QuestConnection:Disconnect() end
    self.QuestRemote = remote
    self.QuestConnection = self:Connect(remote.OnClientEvent, function(data)
        self.QuestData = type(data) == "table" and data or nil
        self.QuestKnown = true
    end)
