-- Vol lÃ©ger en facemouse au lieu d'une montÃ©e haute :

--   - On grimpe juste un peu au-dessus du Y le plus haut entre dÃ©part/arrivÃ©e

--     (assez pour passer arbres bas et muret, pas un saut suspect)

--   - Mouvement direct vers la cible (pas de waypoint flat Ã  100m d'altitude)

--   - FaceMouse permanent : le perso regarde toujours oÃ¹ il va

--   - Step capÃ© par frame, vitesse rÃ©duite pour la phase Haki

-- ============================================================

local function DoHakiTween(targetPos, hoverY)

	if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end

	if typeof(targetPos) ~= "Vector3" then return end

	-- Clamp la cible dans la zone Yeti pour ne jamais sortir des limites.

	targetPos = clampToYetiZone(targetPos)

	local rp = getHRP()

	local hum = getHumanoid()

	if not rp or not hum or hum.Health <= 0 then return end

	H.tpToken = H.tpToken + 1

	local myToken = H.tpToken

	local startPos = rp.Position

	local finalPos = hoverY and Vector3.new(targetPos.X, hoverY, targetPos.Z) or targetPos

	finalPos = clampToYetiZone(finalPos)

	-- Hauteur de croisiÃ¨re LÃ‰GÃˆRE : juste assez au-dessus pour passer les

	-- petits obstacles (arbres bas, rochers, muret). On prend le max de Y

	-- entre dÃ©part et arrivÃ©e, et on ajoute 10 studs.

	local cruiseY = math.max(startPos.Y, finalPos.Y) + 10

	if cruiseY < H.YETI_MIN_SAFE_Y then cruiseY = H.YETI_MIN_SAFE_Y end

	if cruiseY > H.YETI_MAX_SAFE_Y - 5 then cruiseY = H.YETI_MAX_SAFE_Y - 5 end

	local flatDist = Vector3.new(finalPos.X - startPos.X, 0, finalPos.Z - startPos.Z).Magnitude

	-- Trajectoire :

	-- - petits dÃ©placements (< 8 studs) : direct vers la cible

	-- - sinon : un seul waypoint Ã  hauteur cruiseY juste au-dessus de la

	--   cible (X/Z de la cible, Y = cruiseY), puis la cible. Comme Ã§a on

	--   "glisse" en pente douce de notre position vers le yeti, sans monter

	--   verticalement Ã  100m+.

	local route = {}

	if flatDist > 8 then

		table.insert(route, Vector3.new(finalPos.X, cruiseY, finalPos.Z))

	end

	table.insert(route, finalPos)

	setNoclip(true)

	releaseMovementKeys()

	-- Vitesse rÃ©duite pour la phase Haki.

	local hakiSpeed = math.min(H.teleportSpeed or 70, 55)

	local MAX_STEP_PER_FRAME = 4

	local lastFaceMouse = 0

	local moving = true

	task.spawn(function()

		while moving and H.tpToken == myToken do

			fireTakeStamDash()

			task.wait(0.1)

		end

	end)

	for wpIndex, wp in ipairs(route) do

		local isLast = wpIndex == #route

		local reachDist = isLast and 2.5 or 4

		while H.tpToken == myToken do

			rp = getHRP()

			hum = getHumanoid()

			if not rp or not hum or hum.Health <= 0 then break end

			local cur = rp.Position

			local toWp = wp - cur

			local d = toWp.Magnitude

			if d <= reachDist then

				rp.AssemblyLinearVelocity = Vector3.zero

				rp.AssemblyAngularVelocity = Vector3.zero

				break

			end

			local dt = RunService.Heartbeat:Wait()

			local step = math.min(hakiSpeed * dt, d, MAX_STEP_PER_FRAME)

			local dir = toWp.Unit

			-- FaceMouse permanent (toutes les ~80ms) pour que la rotation

			-- envoyÃ©e au serveur reste cohÃ©rente avec le dÃ©placement.

			if tick() - lastFaceMouse >= 0.08 then

				lastFaceMouse = tick()

				fireFaceMouse()

			end

			local nextPos = cur + dir * step

			-- Clamp Ã  chaque frame: si un step nous fait sortir, on reste Ã 

			-- la limite. Comme Ã§a mÃªme un dt anormal ne peut pas nous Ã©jecter.

			nextPos = clampToYetiZone(nextPos)

			local lookAt = Vector3.new(nextPos.X + dir.X, nextPos.Y, nextPos.Z + dir.Z)

			rp.CFrame = CFrame.lookAt(nextPos, lookAt)

			rp.AssemblyLinearVelocity = Vector3.zero

			rp.AssemblyAngularVelocity = Vector3.zero

		end

	end

	moving = false

	pcall(function()

		local endRp = getHRP()

		local endHum = getHumanoid()

		if endRp then

			setWaterDiveAssist(endRp, endHum, false, finalPos.Y)

		end

	end)

	releaseMovementKeys()

end

local function phase3Haki()

