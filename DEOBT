    local enemy = self:Enemies(bossStep and "Captain Elephant" or "Forest Pirate", 3000)[1]
    if enemy then self:Fight(enemy, bossStep and "Captain Elephant" or "Forest Pirate", true)
    else
        self.Target = nil
        self:MoveTo(bossStep and CFrame.new(-13493.128, 318.895, -8373.791) or CFrame.new(-13277.568, 370.341, -7821.157))
