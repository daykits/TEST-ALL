    function Window:AddTab(tabOpts)
        tabOpts = tabOpts or {}
        local name = tostring(tabOpts.Title or "Tab")
        local symbol = tostring(tabOpts.Icon or "•")

        local btn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 39),
            BackgroundColor3 = Theme.Surface,
            BackgroundTransparency = 0.65,
            Text = "",
            AutoButtonColor = false,
        }, Sidebar)
        corner(btn, 8)

        local icon = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 0),
            Size = UDim2.fromOffset(25, 39),
            Font = Enum.Font.GothamBold,
            Text = symbol,
            TextColor3 = Theme.Muted,
            TextSize = 16,
        }, btn)

        local label = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(35, 0),
            Size = UDim2.new(1, -40, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = name,
            TextColor3 = Theme.Muted,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, btn)

        local page = create("ScrollingFrame", {
            Name = name .. "Page",
            Position = UDim2.fromOffset(10, 10),
            Size = UDim2.new(1, -20, 1, -20),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, Content)
        create("UIPadding", {
            PaddingRight = UDim.new(0, 5),
            PaddingBottom = UDim.new(0, 6),
        }, page)
        create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)

        local tab = {
            Button = btn,
            Icon = icon,
            Label = label,
            Page = page,
            Window = Window,
        }

        table.insert(Window.Tabs, tab)
        table.insert(Window._tabsOrder, tab)

        btn.Activated:Connect(function()
            for _, other in ipairs(Window.Tabs) do
                other.Page.Visible = false
                tween(other.Button, 0.16, {
                    BackgroundColor3 = Theme.Surface,
                    BackgroundTransparency = 0.65,
                })
                other.Icon.TextColor3 = Theme.Muted
                other.Label.TextColor3 = Theme.Muted
            end
            page.Visible = true
            tween(btn, 0.18, {
                BackgroundColor3 = Theme.Accent,
                BackgroundTransparency = 0,
            })
            icon.TextColor3 = Theme.Text
            label.TextColor3 = Theme.Text
            Window._activeTab = tab
        end)

        -- ===== TAB: AddSection =====
        function tab:AddSection(sectionName)
            local box = create("Frame", {
                Name = "Section",
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Panel,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
            }, page)
            create("UIListLayout", {
                Padding = UDim.new(0, 6),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, box)
            create("UIPadding", {
                PaddingTop = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4),
            }, box)
            create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = string.upper(tostring(sectionName or "Section")),
                TextColor3 = Theme.Muted,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, box)

            local section = { Frame = box }

            -- ===== SECTION COMPONENTS =====
            function section:AddToggle(idx, o)
                o = o or {}
                local value = o.Default == true
                local row = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 43),
                    BackgroundColor3 = Theme.Surface,
                    BackgroundTransparency = 0.2,
                    BorderSizePixel = 0,
                }, box)
                corner(row, 8)
                create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(11, 0),
                    Size = UDim2.new(1, -78, 1, 0),
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(o.Title or ""),
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, row)
                local sw = create("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(42, 22),
                    BackgroundColor3 = value and Theme.Accent or Theme.Off,
                    BorderSizePixel = 0,
                }, row)
                corner(sw, 11)
                local knob = create("Frame", {
                    Position = value and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
                    Size = UDim2.fromOffset(16, 16),
                    BackgroundColor3 = Theme.Text,
                    BorderSizePixel = 0,
                }, sw)
                corner(knob, 8)
                local hit = create("TextButton", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                }, row)

                local obj = { Value = value }
                function obj:SetValue(newVal, fire)
                    value = newVal == true
                    obj.Value = value
                    tween(sw, 0.16, {
                        BackgroundColor3 = value and Theme.Accent or Theme.Off,
                    })
                    tween(knob, 0.18, {
                        Position = value and UDim2.new(1, -19, 0.5, -8)
                            or UDim2.new(0, 3, 0.5, -8),
                    })
                    if fire ~= false and type(o.Callback) == "function" then
                        local ok, err = pcall(o.Callback, value)
                        if not ok then warn("[Nebula] Toggle callback:", err) end
                    end
                end
                hit.Activated:Connect(function()
                    obj:SetValue(not value, true)
                end)
                return obj
            end

            function section:AddButton(o)
                o = o or {}
                local btn = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 39),
                    BackgroundColor3 = Theme.Accent,
                    Text = tostring(o.Title or "Button"),
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.GothamBold,
                    TextSize = 12,
                    AutoButtonColor = false,
                }, box)
                corner(btn, 8)
                create("UIGradient", {
                    Color = ColorSequence.new(Theme.Accent, Theme.Accent2),
                }, btn)
                btn.MouseEnter:Connect(function()
                    tween(btn, 0.15, { BackgroundTransparency = 0.12 })
                end)
                btn.MouseLeave:Connect(function()
                    tween(btn, 0.15, { BackgroundTransparency = 0 })
                end)
                btn.Activated:Connect(function()
                    tween(btn, 0.08, { BackgroundTransparency = 0.25 })
                    task.delay(0.09, function()
                        if btn.Parent then
                            tween(btn, 0.12, { BackgroundTransparency = 0 })
                        end
                    end)
                    if type(o.Callback) == "function" then
                        local ok, err = pcall(o.Callback)
                        if not ok then warn("[Nebula] Button callback:", err) end
                    end
                end)
                return btn
            end

            function section:AddParagraph(o)
                o = o or {}
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Theme.Surface,
                    BackgroundTransparency = 0.2,
                    BorderSizePixel = 0,
                }, box)
                corner(frame, 8)
                local lbl = create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(11, 0),
                    Size = UDim2.new(1, -22, 1, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Font = Enum.Font.Gotham,
                    Text = tostring(o.Title or ""),
                    TextColor3 = Theme.Muted,
                    TextSize = 11,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, frame)
                create("UIPadding", {
                    PaddingTop = UDim.new(0, 10),
                    PaddingBottom = UDim.new(0, 10),
                    PaddingLeft = UDim.new(0, 11),
                    PaddingRight = UDim.new(0, 11),
                }, frame)
                local obj = {}
                function obj:SetTitle(t)
                    lbl.Text = tostring(t)
                end
                function obj:GetText()
                    return lbl.Text
                end
                return obj
            end

            function section:AddSlider(idx, o)
                o = o or {}
                local minV = tonumber(o.Min) or 0
                local maxV = tonumber(o.Max) or 100
                if maxV <= minV then maxV = minV + 1 end
                local rounding = tonumber(o.Rounding) or 0
                local step = rounding > 0 and (10 ^ -rounding) or 1
                local value = math.clamp(tonumber(o.Default) or minV, minV, maxV)

                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 58),
                    BackgroundColor3 = Theme.Surface,
                    BackgroundTransparency = 0.2,
                    BorderSizePixel = 0,
                }, box)
                corner(frame, 8)
                create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(11, 5),
                    Size = UDim2.new(1, -85, 0, 20),
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(o.Title or ""),
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, frame)
                local valueLabel = create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -65, 0, 5),
                    Size = UDim2.fromOffset(54, 20),
                    Font = Enum.Font.GothamBold,
                    Text = formatNumber(value, rounding),
                    TextColor3 = Theme.Accent2,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, frame)
                local bar = create("Frame", {
                    Position = UDim2.new(0, 11, 0, 37),
                    Size = UDim2.new(1, -22, 0, 6),
                    BackgroundColor3 = Theme.Off,
                    BorderSizePixel = 0,
                }, frame)
                corner(bar, 3)
                local ratio0 = (value - minV) / (maxV - minV)
                local fill = create("Frame", {
                    Size = UDim2.new(ratio0, 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0,
                }, bar)
                corner(fill, 3)
                local knob = create("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(ratio0, 0, 0.5, 0),
                    Size = UDim2.fromOffset(14, 14),
                    BackgroundColor3 = Theme.Text,
                    BorderSizePixel = 0,
                }, bar)
                corner(knob, 7)

                local obj = { Value = value }
                local dragging = false

                local function setVisual(v)
                    local alpha = (v - minV) / (maxV - minV)
                    valueLabel.Text = formatNumber(v, rounding)
                    fill.Size = UDim2.new(alpha, 0, 1, 0)
                    knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                end

                local function setFromX(x, fire)
                    local width = math.max(bar.AbsoluteSize.X, 1)
                    local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
                    local raw = minV + (maxV - minV) * alpha
                    local snapped = roundNumber(math.floor(raw / step + 0.5) * step, rounding)
                    snapped = math.clamp(snapped, minV, maxV)
                    if snapped ~= value then
                        value = snapped
                        obj.Value = value
                        setVisual(value)
                        if fire ~= false and type(o.Callback) == "function" then
                            local ok, err = pcall(o.Callback, value)
                            if not ok then warn("[Nebula] Slider callback:", err) end
                        end
                    else
                        setVisual(value)
                    end
                end

                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        setFromX(input.Position.X, true)
                    end
                end)
                trackConn(UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        setFromX(input.Position.X, true)
                    end
                end))
                trackConn(UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end))

                function obj:SetValue(v, fire, silent)
                    v = math.clamp(tonumber(v) or value, minV, maxV)
                    v = roundNumber(math.floor(v / step + 0.5) * step, rounding)
                    value = v
                    obj.Value = v
                    setVisual(v)
                    if not silent and fire ~= false and type(o.Callback) == "function" then
                        local ok, err = pcall(o.Callback, v)
                        if not ok then warn("[Nebula] Slider SetValue:", err) end
                    end
                end
                return obj
            end

            function section:AddDropdown(idx, o)
                o = o or {}
                local multi = o.Multi == true
                local priority = o.ClickOrder == true
                local values = {}
                if type(o.Values) == "table" then
                    if #o.Values > 0 then
                        for _, v in ipairs(o.Values) do
                            table.insert(values, tostring(v))
                        end
                    else
                        for k in pairs(o.Values) do
                            table.insert(values, tostring(k))
                        end
                        table.sort(values)
                    end
                end

                local function defaultMulti()
                    local set = {}
                    if type(o.Default) == "table" then
                        if #o.Default > 0 then
                            for _, v in ipairs(o.Default) do
                                set[tostring(v)] = true
                            end
                        else
                            for k, v in pairs(o.Default) do
                                if v then set[tostring(k)] = true end
                            end
                        end
                    end
                    return set
                end

                local initSel
                if multi then
                    if priority then
                        local list = {}
                        if type(o.Default) == "table" and #o.Default > 0 then
                            for _, v in ipairs(o.Default) do
                                if table.find(values, tostring(v)) then
                                    table.insert(list, tostring(v))
                                end
                            end
                        end
                        initSel = list
                    else
                        initSel = defaultMulti()
                    end
                else
                    local def = o.Default
                    if type(def) == "number" then
                        def = values[def]
                    elseif type(def) ~= "string" then
                        def = nil
                    end
                    initSel = def
                end

                -- UI
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 39),
                    BackgroundColor3 = Theme.Surface,
                    BackgroundTransparency = 0.2,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                }, box)
                corner(frame, 8)
                local header = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 39),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                }, frame)
                create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(11, 0),
                    Size = UDim2.new(1, -75, 1, 0),
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(o.Title or ""),
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, header)
                local display = create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -170, 0, 0),
                    Size = UDim2.fromOffset(150, 39),
                    Font = Enum.Font.Gotham,
                    Text = "",
                    TextColor3 = Theme.Accent2,
                    TextSize = 11,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, header)
                local arrow = create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -20, 0, 0),
                    Size = UDim2.fromOffset(20, 39),
                    Font = Enum.Font.GothamBold,
                    Text = "▾",
                    TextColor3 = Theme.Muted,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, header)
                local listFrame = create("ScrollingFrame", {
                    Position = UDim2.fromOffset(6, 39),
                    Size = UDim2.new(1, -12, 0, 0),
                    BackgroundColor3 = Theme.Background,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Theme.Accent,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    Visible = false,
                }, frame)
                corner(listFrame, 6)
                create("UIListLayout", {
                    Padding = UDim.new(0, 2),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }, listFrame)
                create("UIPadding", {
                    PaddingTop = UDim.new(0, 4),
                    PaddingBottom = UDim.new(0, 4),
                    PaddingLeft = UDim.new(0, 4),
                    PaddingRight = UDim.new(0, 4),
                }, listFrame)

                local obj = {
                    Values = values,
                    Value = initSel,
                    Order = priority and table.clone(initSel) or nil,
                    _listFrame = listFrame,
                    _isOpen = false,
                    _optionButtons = {},
                }

                local function refreshDisplay()
                    if multi then
                        if priority then
                            local ord = obj.Order or obj.Value
                            if type(ord) == "table" and #ord > 0 then
                                display.Text = table.concat(ord, " → ")
                            else
                                display.Text = "(none)"
                            end
                        else
                            local names = {}
                            for name, on in pairs(obj.Value or {}) do
                                if on then table.insert(names, name) end
                            end
                            table.sort(names)
                            if #names == 0 then
                                display.Text = "(none)"
                            else
                                display.Text = table.concat(names, ", ")
                            end
                        end
                    else
                        display.Text = obj.Value or "(none)"
                    end
                end

                local function renderList()
                    for _, b in ipairs(obj._optionButtons) do b:Destroy() end
                    obj._optionButtons = {}

                    local function makeRow(text)
                        local r = create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = Theme.Surface,
                            BackgroundTransparency = 0.35,
                            Text = "",
                            AutoButtonColor = false,
                        }, listFrame)
                        corner(r, 5)
                        local t = create("TextLabel", {
                            BackgroundTransparency = 1,
                            Position = UDim2.fromOffset(8, 0),
                            Size = UDim2.new(1, -16, 1, 0),
                            Font = Enum.Font.Gotham,
                            Text = text,
                            TextColor3 = Theme.Text,
                            TextSize = 11,
                            TextXAlignment = Enum.TextXAlignment.Left,
                        }, r)
                        r.MouseEnter:Connect(function()
                            tween(r, 0.1, { BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.6 })
                        end)
                        r.MouseLeave:Connect(function()
                            tween(r, 0.1, { BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.35 })
                        end)
                        table.insert(obj._optionButtons, r)
                        return r, t
                    end

                    if multi and priority then
                        -- Cột "Đã chọn" theo thứ tự + cột "Tất cả"
                        local ord = obj.Order or {}
                        for i, name in ipairs(ord) do
                            local r, t = makeRow(i .. ". " .. name .. "  ✕")
                            r.Activated:Connect(function()
                                local newOrder = {}
                                for _, n in ipairs(obj.Order) do
                                    if n ~= name then table.insert(newOrder, n) end
                                end
                                obj.Order = newOrder
                                local newMap = {}
                                for _, n in ipairs(newOrder) do newMap[n] = true end
                                obj.Value = newOrder
                                refreshDisplay()
                                renderList()
                                if type(o.Callback) == "function" then
                                    local ok, err = pcall(o.Callback, table.clone(newOrder))
                                    if not ok then warn("[Nebula] Dropdown priority:", err) end
                                end
                            end)
                        end
                        local selectedSet = {}
                        for _, n in ipairs(ord) do selectedSet[n] = true end
                        for _, name in ipairs(values) do
                            if not selectedSet[name] then
                                local r = makeRow("+ " .. name)
                                r.Activated:Connect(function()
                                    table.insert(obj.Order, name)
                                    obj.Value = obj.Order
                                    refreshDisplay()
                                    renderList()
                                    if type(o.Callback) == "function" then
                                        local ok, err = pcall(o.Callback, table.clone(obj.Order))
                                        if not ok then warn("[Nebula] Dropdown priority:", err) end
                                    end
                                end)
                            end
                        end
                    elseif multi then
                        for _, name in ipairs(values) do
                            local r, t = makeRow(name)
                            local function updateVisual()
                                local on = obj.Value[name] == true
                                t.TextColor3 = on and Theme.Accent2 or Theme.Text
                                t.Text = (on and "☑  " or "☐  ") .. name
                            end
                            updateVisual()
                            r.Activated:Connect(function()
                                local on = obj.Value[name] == true
                                obj.Value[name] = not on
                                updateVisual()
                                refreshDisplay()
                                if type(o.Callback) == "function" then
                                    local ok, err = pcall(o.Callback, table.clone(obj.Value))
                                    if not ok then warn("[Nebula] Dropdown multi:", err) end
                                end
                            end)
                        end
                    else
                        for _, name in ipairs(values) do
                            local r, t = makeRow(name)
                            if obj.Value == name then
                                t.TextColor3 = Theme.Accent2
                            end
                            r.Activated:Connect(function()
                                obj.Value = name
                                refreshDisplay()
                                renderList()
                                if type(o.Callback) == "function" then
                                    local ok, err = pcall(o.Callback, name)
                                    if not ok then warn("[Nebula] Dropdown:", err) end
                                end
                                -- đóng list
                                obj._isOpen = false
                                tween(listFrame, 0.15, { Size = UDim2.new(1, -12, 0, 0) })
                                arrow.Text = "▾"
                                task.delay(0.15, function()
                                    if not obj._isOpen then listFrame.Visible = false end
                                end)
                            end)
                        end
                    end
                end

                header.Activated:Connect(function()
                    obj._isOpen = not obj._isOpen
                    if obj._isOpen then
                        listFrame.Visible = true
                        local target = math.min(#values * 30 + 8, 180)
                        if multi and priority then
                            target = math.min((#values) * 30 + 8, 200)
                        end
                        tween(listFrame, 0.18, { Size = UDim2.new(1, -12, 0, target) })
                        tween(frame, 0.18, { Size = UDim2.new(1, 0, 0, 39 + target) })
                        arrow.Text = "▴"
                    else
                        tween(listFrame, 0.15, { Size = UDim2.new(1, -12, 0, 0) })
                        tween(frame, 0.15, { Size = UDim2.new(1, 0, 0, 39) })
                        arrow.Text = "▾"
                        task.delay(0.16, function()
                            if not obj._isOpen then listFrame.Visible = false end
                        end)
                    end
                end)

                refreshDisplay()
                renderList()

                function obj:SetValue(v)
                    if v == nil then return end
                    if multi then
                        if priority then
                            local newOrder = {}
                            if type(v) == "table" and #v > 0 then
                                for _, n in ipairs(v) do
                                    if table.find(values, tostring(n)) then
                                        table.insert(newOrder, tostring(n))
                                    end
                                end
                            elseif type(v) == "table" then
                                for _, n in ipairs(values) do
                                    if v[n] then table.insert(newOrder, n) end
                                end
                            elseif type(v) == "string" then
                                for _, n in ipairs(obj.Order or {}) do
                                    table.insert(newOrder, n)
                                end
                                if table.find(values, v) and not table.find(newOrder, v) then
                                    table.insert(newOrder, v)
                                end
                            end
                            obj.Order = newOrder
                            obj.Value = newOrder
                        else
                            local newMap = {}
                            if type(v) == "table" and #v > 0 then
                                for _, n in ipairs(v) do newMap[tostring(n)] = true end
                            elseif type(v) == "table" then
                                for k, on in pairs(v) do if on then newMap[tostring(k)] = true end end
                            elseif type(v) == "string" then
                                for k, on in pairs(obj.Value or {}) do if on then newMap[k] = true end end
                                newMap[v] = true
                            end
                            obj.Value = newMap
                        end
                    else
                        local s = tostring(v)
                        if table.find(values, s) then
                            obj.Value = s
                        end
                    end
                    refreshDisplay()
                    renderList()
                end

                function obj:GetNewList(list)
                    local ns = {}
                    if type(list) == "table" then
                        if #list > 0 then
                            for _, v in ipairs(list) do
                                table.insert(ns, tostring(v))
                            end
                        else
                            for k, on in pairs(list) do
                                if on then table.insert(ns, tostring(k)) end
                            end
                            table.sort(ns)
                        end
                    end
                    values = ns
                    obj.Values = ns
                    if multi then
                        if priority then
                            obj.Order = {}
                            obj.Value = obj.Order
                        else
                            obj.Value = {}
                        end
                    else
                        obj.Value = nil
                    end
                    refreshDisplay()
                    renderList()
                end

                return obj
            end

            function section:AddInput(idx, o)
                o = o or {}
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 43),
                    BackgroundColor3 = Theme.Surface,
                    BackgroundTransparency = 0.2,
                    BorderSizePixel = 0,
                }, box)
                corner(frame, 8)
                create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(11, 0),
                    Size = UDim2.new(1, -11, 0, 22),
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(o.Title or ""),
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, frame)
                local tb = create("TextBox", {
                    Position = UDim2.fromOffset(11, 22),
                    Size = UDim2.new(1, -22, 0, 20),
                    BackgroundColor3 = Theme.Background,
                    BorderSizePixel = 0,
                    Font = Enum.Font.Gotham,
                    PlaceholderText = tostring(o.Placeholder or ""),
                    PlaceholderColor3 = Theme.Muted,
                    Text = tostring(o.Default or ""),
                    TextColor3 = Theme.Text,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                }, frame)
                corner(tb, 4)

                local obj = { Value = tb.Text }

                local function fire()
                    if type(o.Callback) == "function" then
                        local ok, err = pcall(o.Callback, tb.Text)
                        if not ok then warn("[Nebula] Input callback:", err) end
                    end
                end

                tb.FocusLost:Connect(function(enter)
                    if enter and o.Finished then fire() end
                    if not o.Finished then fire() end
                end)
                if o.Finished then
                    -- chỉ fire khi enter
                    tb.FocusLost:Connect(function(enter) if enter then fire() end end)
                else
                    tb:GetPropertyChangedSignal("Text"):Connect(fire)
                end

                function obj:SetValue(v)
                    local s = tostring(v or "")
                    tb.Text = s
                    obj.Value = s
                    if type(o.Callback) == "function" then
                        local ok, err = pcall(o.Callback, s)
                        if not ok then warn("[Nebula] Input SetValue:", err) end
                    end
                end
                return obj
            end

            -- stub cho API không cần thiết cho page Farming
            function section:AddKeybind(idx, o)
                warn("[Nebula] AddKeybind stub — không có UI. Title:", tostring(o and o.Title))
                return {
                    SetValue = function() end,
                    GetValue = function() return "" end,
                }
            end
            function section:AddSliderDropdown(idx, o)
                warn("[Nebula] AddSliderDropdown stub — không có UI. Title:", tostring(o and o.Title))
                return {
                    Value = {},
                    Order = {},
                    SetValue = function() end,
                    SetItem = function() end,
                    GetNewList = function() end,
                }
            end

            return section
        end

        return tab
    end

    -- ===== Window.MinimizeKey =====
    Window.__minimizeConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode.Name == Window._minimizeKey then
            Main.Visible = not Main.Visible
        end
    end)
    trackConn(Window.__minimizeConn)

    -- drag
    local dragging, dragStart, startPos = false, nil, nil
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    trackConn(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end))
    trackConn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    -- minimize
    local minimized = false
    MinBtn.Activated:Connect(function()
        minimized = not minimized
        Sidebar.Visible = not minimized
        Content.Visible = not minimized
        tween(Main, 0.2, {
            Size = minimized and UDim2.fromOffset(sizeX, 54) or UDim2.fromOffset(sizeX, sizeY),
        })
        MinBtn.Text = minimized and "□" or "—"
    end)

    -- close → unload
    CloseBtn.Activated:Connect(function()
        pcall(function() Library:Unload() end)
    end)

    table.insert(windowsList, Window)
    return Window
end

-- ==================== LIBRARY API ====================
function Library:CreateWindow(opts)
    return makeWindow(opts or {})
end

function Library:Unload()
    if Library.Unloaded then return end
    Library.Unloaded = true
    for _, c in ipairs(allConnections) do
        pcall(function() c:Disconnect() end)
    end
    allConnections = {}
    for _, w in ipairs(windowsList) do
        if w.Gui then pcall(function() w.Gui:Destroy() end) end
    end
    windowsList = {}
    local core = game:GetService("CoreGui")
    local holder = core:FindFirstChild("NebulaNotifyHolder")
    if holder then holder:Destroy() end
end
Library.Destroy = Library.Unload

return Library
