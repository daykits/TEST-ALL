function Hub:ProgressMoveTouch(object, offset)
    local part = object and (object:IsA("BasePart") and object or object:FindFirstChildWhichIsA("BasePart", true))
    if not part then return false end
    local _, _, root = self:Character()
    if not root then return false end
    if (root.Position - part.Position).Magnitude > 6 then
        self:MoveTo(part.CFrame + (offset or Vector3.new(0, 3, 0)))
        return true
    end
    self:CancelTween(false)
    self:Touch(part)
    local prompt = object:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then self:FirePrompt(prompt) end
    local detector = object:FindFirstChildWhichIsA("ClickDetector", true)
