local function webhookFormatNumber(value)
    if type(value) ~= "number" then return "?" end
    local text = string.format("%d", math.floor(value))
    local out = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

function Hub:WebhookURL()
    local url = self.Config["Webhook URL"]
    if type(url) ~= "string" or url == "" then return nil end
    url = url:gsub("^%s+", ""):gsub("%s+$", "")
    if url:sub(1, 8) ~= "https://" then return nil end
    if not url:find("discord", 1, true) or not url:find("/api/webhooks/", 1, true) then return nil end
    return url
end

function Hub:WebhookOn(event)
    if not self.Config["Webhook Enabled"] then return false end
    if not self:WebhookURL() then return false end
    local list = self.Config["Webhook Events"]
    if type(list) ~= "table" then return false end
    return table.find(list, event) ~= nil
end

function Hub:WebhookRequestFn()
    if self.WebhookFn then return self.WebhookFn end
    local fn
    pcall(function()
        local env = (type(getgenv) == "function" and getgenv()) or _G
        fn = env and (env.request or env.http_request) or nil
        if type(fn) ~= "function" and type(syn) == "table" then fn = syn.request end
        if type(fn) ~= "function" and type(fluxus) == "table" then fn = fluxus.request end
    end)
    if type(fn) == "function" then self.WebhookFn = fn end
    return fn
end

function Hub:WebhookAvatarURL()
    if self.WebhookAvatar then return self.WebhookAvatar end
    if os.clock() < (self.WebhookAvatarRetry or 0) then return nil end
    self.WebhookAvatarRetry = os.clock() + 120
    local fn = self:WebhookRequestFn()
    if not fn then return nil end
    local found
    local ok, response = pcall(fn, {
        Url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. Player.UserId .. "&size=150x150&format=Png&isCircular=false",
        Method = "GET",
    })
    if ok and type(response) == "table" and type(response.Body) == "string" then
        found = response.Body:match('"imageUrl"%s*:%s*"(https://[^"]+)"')
    end
    if found then self.WebhookAvatar = found end
    return found
end

function Hub:WebhookSend(title, description, color, fields)
    local url = self:WebhookURL()
    if not url then return false end
    local fn = self:WebhookRequestFn()
    if not fn then self:Log("webhook", "Executor has no http request function.", 10); return false end
    task.spawn(function()
        local embed = {
            title = title,
            description = description,
            color = color or 16750899,
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
            footer = { text = "Bacon Hub | " .. Player.Name },
        }
        if fields then embed.fields = fields end
        local avatar = self:WebhookAvatarURL()
        if avatar then embed.thumbnail = { url = avatar } end
        local payload = { username = "Bacon Hub", embeds = { embed } }
        local ok, response = pcall(fn, {
            Url = url, Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = Services.HttpService:JSONEncode(payload),
        })
        if not ok then
            self:Log("webhook-send", response, 10)
        elseif type(response) == "table" and type(response.StatusCode) == "number" and response.StatusCode >= 300 then
            self:Log("webhook-send", "HTTP " .. response.StatusCode, 10)
        end
    end)
    return true
end

