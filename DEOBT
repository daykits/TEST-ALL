        Visible = false,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 10,
        Parent = row,
    })
    Corner(8).Parent = list
    New("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = list,
    })
    Padding(6, 6, 6, 6).Parent = list

    local click = New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 6,
        Parent = head,
    })

    local function refreshValueLabel()
        local parts = {}
        for _, opt in ipairs(options) do
            if selected[opt] then table.insert(parts, tostring(opt)) end
        end
        comp.ValueLabel.Text = #parts > 0 and table.concat(parts, ", ") or "(none)"
    end
    refreshValueLabel()

    local function closeMenu() comp._open = false; list.Visible = false; comp.Arrow.Text = "▾" end
    local function openMenu() comp._open = true; list.Visible = true; comp.Arrow.Text = "▴" end

    local function rebuildOptions()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, opt in ipairs(options) do
            local optBtn = New("TextButton", {
                BackgroundColor3 = selected[opt] and theme.Border or theme.Card,
                BackgroundTransparency = selected[opt] and 0 or 0.6,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 26),
                Text = (selected[opt] and "✓  " or "     ") .. tostring(opt),
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                LayoutOrder = i,
                ZIndex = 11,
                Parent = list,
            })
            Corner(6).Parent = optBtn
            Padding(0, 0, 8, 0).Parent = optBtn
            optBtn.MouseButton1Click:Connect(function()
                selected[opt] = not selected[opt] or nil
                rebuildOptions()
                refreshValueLabel()
                local out = {}
                for _, o in ipairs(options) do
                    if selected[o] then table.insert(out, o) end
                end
                SafeCall(cfg.Callback, out)
            end)
        end
    end
    rebuildOptions()

    click.MouseButton1Click:Connect(function()
        if not comp._enabled then return end
        if comp._open then closeMenu() else openMenu() end
    end)

    function comp.SetValues(list_)
        selected = {}
        for _, v in ipairs(list_ or {}) do selected[v] = true end
        rebuildOptions(); refreshValueLabel()
    end
    function comp.GetValues()
        local out = {}
        for _, o in ipairs(options) do
            if selected[o] then table.insert(out, o) end
        end
        return out
    end
    function comp.SetOptions(opts)
        options = opts or {}
        rebuildOptions(); refreshValueLabel()
    end
    function comp.SetCallback(fn) cfg.Callback = fn end
    function comp.SetEnabled(b) comp._enabled = b and true or false end
    function comp.Destroy() comp.Container:Destroy() end
    function comp:_ApplyTheme(t)
        head.BackgroundColor3 = t.Secondary
        comp.Label.TextColor3 = t.Text
        comp.ValueLabel.TextColor3 = t.Accent
        comp.Arrow.TextColor3 = t.TextSecondary
        list.BackgroundColor3 = t.Card
    end

    table.insert(section.Components, comp)
    return comp
end

