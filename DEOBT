local function startAutoRejoin()

	if H.autoRejoinStarted or DefaultConfig.MAIN.AUTO_REJOIN ~= true then return end

	H.autoRejoinStarted = true

	local function retryJoin()

		task.wait(2)

		-- Fatal Error / 267 / ErrorPrompt detecte:

		-- On marque le prochain lancement pendant 90 secondes max.

		-- Pas de flag permanent, sinon arrivee normale en PS = faux main menu.

		if shouldForcePSRoute() then

			markMainMenuAfterRejoin()

		end

		TeleportService:Teleport(game.PlaceId, LocalPlayer)

	end

	pcall(function()

		LocalPlayer.OnTeleport:Connect(function(state)

			if state == Enum.TeleportState.Failed then

				retryJoin()

			end

		end)

	end)

	pcall(function()

		local robloxPromptGui = CoreGui:FindFirstChild("RobloxPromptGui")

		local promptOverlay = robloxPromptGui and robloxPromptGui:FindFirstChild("promptOverlay")

		if promptOverlay then

			promptOverlay.ChildAdded:Connect(function(child)

				if child.Name == "ErrorPrompt" then

					retryJoin()

				end

			end)

		end

	end)

end

