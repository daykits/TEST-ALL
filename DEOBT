function Hub:RefreshHiddenAbilities(silent)
    local definitions = self:Module("HiddenAbilityData", { "Modules", "HiddenAbilities", "Abilities" })
    local fruit = self:Value({ "Data", "DevilFruit" })
    if not definitions or type(definitions.AbilitiesFromFruitName) ~= "function" or type(fruit) ~= "string" then
        self:SetInfo("AbilityStatus", "Fruit data unavailable")
        return nil
    end
    if table.find(definitions.ComingSoon or {}, fruit) then
        self.HiddenAbilityOptions = {}
        self:SetOptions("HiddenAbilityDropdown", {})
        self:SetInfo("AbilityStatus", "No abilities available")
        return nil
    end
    local okDefinitions, list = pcall(definitions.AbilitiesFromFruitName, fruit)
    if not okDefinitions or type(list) ~= "table" then
        self.HiddenAbilityOptions = {}
        self:SetOptions("HiddenAbilityDropdown", {})
        self:SetInfo("AbilityStatus", "No abilities available")
        return nil
    end
    local ok, data = self:InvokeNet("HiddenAbilitiesRF", { Context = "GetList" }, 0.5)
    local fruitState = ok and type(data) == "table" and type(data.FruitList) == "table" and data.FruitList[fruit]
    if type(fruitState) ~= "table" or type(fruitState.Abilities) ~= "table" then
        if not silent then self:Notify("Hidden Abilities", "State unavailable.") end
        return nil
    end
    local options, labels = {}, {}
    for _, definition in ipairs(list) do
        if type(definition) == "table" and type(definition.StorageName) == "string" then
            for _, state in pairs(fruitState.Abilities) do
                if type(state) == "table" and state.StorageName == definition.StorageName then
                    local label = type(definition.DisplayName) == "string" and definition.DisplayName or definition.StorageName
                    if options[label] then label ..= " [" .. definition.StorageName .. "]" end
                    options[label] = { Definition = definition, State = state, Fruit = fruitState, FruitName = fruit }
                    labels[#labels + 1] = label
                    break
                end
            end
        end
    end
    table.sort(labels)
    self.HiddenAbilityOptions, self.HiddenAbilityServerData = options, data
    self:SetOptions("HiddenAbilityDropdown", labels)
    if not options[self.Config["Selected Hidden Ability"]] and labels[1] then self:SetConfig("Selected Hidden Ability", labels[1]) end
    self:RenderHiddenAbility()
    return options[self.Config["Selected Hidden Ability"]]
end

function Hub:CurrentHiddenAbility()
    local entry = self.HiddenAbilityOptions and self.HiddenAbilityOptions[self.Config["Selected Hidden Ability"]]
    if not entry or entry.FruitName ~= self:Value({ "Data", "DevilFruit" }) then return nil end
    return entry
end

function Hub:RenderHiddenAbility()
    local entry = self:CurrentHiddenAbility()
    if not entry then self:SetInfo("AbilityStatus", "Select an ability"); return end
    local state, definition = entry.State, entry.Definition
    local text = definition.DisplayName or definition.StorageName
    local status = state.Owned == true and (state.Enabled == true and "Enabled" or "Disabled")
        or (state.Locked == true and "Locked" or "Not owned")
    text ..= " | " .. status
    if type(state.Progress) == "number" and type(state.Goal) == "number" then text ..= "\n" .. state.Progress .. "/" .. state.Goal end
    if type(definition.Mastery) == "number" then text ..= " | Mastery " .. definition.Mastery end
    if type(definition.Cost) == "table" then text ..= "\n" .. self:CostText(definition.Cost) end
    self:SetInfo("AbilityStatus", text)
end

function Hub:ValidateHiddenAbility(entry)
    if not entry or type(entry.State) ~= "table" or type(entry.Definition) ~= "table" then return false, "Select an ability." end
    if entry.FruitName ~= self:Value({ "Data", "DevilFruit" }) then return false, "Equip the matching fruit." end
    if entry.State.Locked ~= false then return false, "Ability locked." end
    local mastery, required = entry.Fruit.CurrentMastery, entry.Definition.Mastery
    if type(mastery) ~= "number" or type(required) ~= "number" or mastery < required then return false, "Mastery required." end
    return true
end

function Hub:ToggleHiddenAbility()
    local entry = self:RefreshHiddenAbilities(true)
    local valid, problem = self:ValidateHiddenAbility(entry)
    if not valid then self:Notify("Hidden Abilities", problem); return end
    if entry.State.Owned ~= true then self:Notify("Hidden Abilities", "Ability not owned."); return end
    local ok, enabled = self:InvokeNet("HiddenAbilitiesRF", {
        Context = "ToggleAbility", AbilityName = entry.Definition.StorageName,
    }, 2)
    if ok and type(enabled) == "boolean" then
        entry.State.Enabled = enabled
        self:RenderHiddenAbility()
        self:Notify("Hidden Abilities", enabled and "Enabled." or "Disabled.")
    else self:Notify("Hidden Abilities", "State unavailable.") end
end

function Hub:StartAbilityProject()
    local entry = self:RefreshHiddenAbilities(true)
    local valid, problem = self:ValidateHiddenAbility(entry)
    if not valid then self:Notify("Hidden Abilities", problem); return end
    local state, definition = entry.State, entry.Definition
    if state.Owned ~= false or state.CanComplete == true or type(state.Experiments) ~= "table"
        or type(definition.Experiments) ~= "table" then self:Notify("Hidden Abilities", "No project available."); return end
    local pending
    for _, step in ipairs(definition.Experiments) do
        if type(step) == "table" and type(step.ExperimentName) == "string" and type(step.Goal) == "number" then
            local current
            for _, progress in ipairs(state.Experiments) do
                if type(progress) == "table" and progress.ExperimentName == step.ExperimentName then current = progress; break end
            end
            if not current or type(current.Progress) ~= "number" then self:Notify("Hidden Abilities", "Progress unavailable."); return end
            if current.Progress < step.Goal then pending = current; break end
        end
    end
    if not pending or pending.Researching ~= false then self:Notify("Hidden Abilities", "Project already active."); return end
    self:Response("Hidden Abilities", self:InvokeNet("HiddenAbilitiesRF", {
        Context = "StartResearch", AbilityName = definition.StorageName,
    }, 3))
end

function Hub:CraftHiddenAbility()
    local entry = self:RefreshHiddenAbilities(true)
    local valid, problem = self:ValidateHiddenAbility(entry)
    if not valid then self:Notify("Hidden Abilities", problem); return end
    local state, definition = entry.State, entry.Definition
    if state.Owned ~= false or state.CanComplete ~= true or type(definition.Cost) ~= "table"
        or type(state.MaterialsOwned) ~= "table" then self:Notify("Hidden Abilities", "Ability not ready."); return end
    local affordable, reason = self:CanAfford(definition.Cost, state.MaterialsOwned)
    if not affordable then self:Notify("Hidden Abilities", reason); return end
    local ok, result = self:InvokeNet("HiddenAbilitiesRF", {
        Context = "CraftAbility", AbilityName = definition.StorageName,
    }, 3)
    if ok and result == true then self.InventoryTime = -100; self:SetInfo("AbilityStatus", "Crafted") end
    self:Response("Hidden Abilities", ok, result)
end

