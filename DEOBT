function Hub:FishStepInner()
    self:FishBiteListen()
    local rf = self:FishingRF()
    if not rf then self:SetInfo("FishStatus", "Fishing client unavailable"); return end
    local data = Compat.find(Player, { "Data", "FishingData" })
    local bait = data and data:GetAttribute("SelectedBait")
    if bait == nil or bait == "None" then self:SetInfo("FishStatus", "Equip bait first"); return end
    local char, hum, root = self:Character()
    if not char or not hum or not root then return end
    local fishingMode = self.Config["Fishing Mode"] == "Remote" and "Remote" or "Legit"
    local phase = self.FishPhase or "goto"
    self:SetInfo("FishStatus", fishingMode .. " | " .. phase)
    if phase == "goto" then
        self.FishSpot = self.FishSpot or self:FishSpotAtDock()
        if not self.FishSpot then self:Log("fish", "No streamed dock."); return end
        self:EnsureFishPlatform(self.FishSpot)
        if self:MoveTo(self.FishSpot) then
            root.CFrame = self.FishSpot
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            self.FishPhase = "equip"
            self.FishEquipAt = os.clock()
        end
        return
    end
    self:EnsureFishPlatform(self.FishSpot)
    if phase == "equip" then
        local rod = self:RodTool()
        if not rod then self:SetInfo("FishStatus", "Need a fishing rod"); return end
        if rod.Parent ~= char then
            pcall(hum.EquipTool, hum, rod)
            self.FishEquipAt = os.clock()
            return
        end
        local busy = char:FindFirstChild("Busy")
        local damaged = (char:GetAttribute("LastDamageTakenAt") or 0) + 1 > Services.Workspace:GetServerTimeNow()
        if damaged or (busy and busy.Value) then return end
        if os.clock() - (self.FishEquipAt or 0) < 0.6 then return end
        root.CFrame = self.FishSpot
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        self.FishRuntimeMode = fishingMode
        if fishingMode == "Remote" then
            self:FishInput(false)
            self.FishCastAt = os.clock()
            self.FishPhase = "remote-start"
        else
            self.FishCastDriver = self:FishClientCast(true) and "Client" or "Input"
            if self.FishCastDriver == "Input" then self:FishInput(true) end
            self.FishReleaseAt = os.clock() + 0.75
            self.FishPhase = "casting"
        end
        return
    end
    local rod = self:RodTool()
    if not rod or rod.Parent ~= char then
        self:FishClientCast(false)
        self:FishInput(false)
        self.FishCastDriver = nil
        self.FishPhase = "equip"
        self.FishEquipAt = os.clock()
        return
    end
    if self.FishRuntimeMode and self.FishRuntimeMode ~= fishingMode then
        self:FishCleanup()
        self.FishPhase = "goto"
        return
    end
    if fishingMode == "Remote" then
        self:FishRemoteStep(rf, root, phase)
        return
    end
    if phase == "casting" then
        if os.clock() >= (self.FishReleaseAt or 0) then
            if self.FishCastDriver == "Client" then self:FishClientCast(false) else self:FishInput(false) end
            self.FishCastDriver = nil
            self.FishBiteAt = nil
            self.FishLaunchDeadline = os.clock() + 6
            self.FishWaitDeadline = os.clock() + 30
            self.FishPhase = "waiting"
        end
        return
    end
    if phase == "waiting" then
        if self.FishBiteAt then
            self.FishBiteAt = nil
            self:FishTap()
            self.FishMinigameDeadline = os.clock() + 120
            self.FishReactedAt = os.clock()
            self.FishPhase = "minigame"
            return
        end
        if os.clock() >= (self.FishLaunchDeadline or math.huge) and rod:GetAttribute("State") == "ReeledIn" then
            self.FishPhase = "cooldown"
            self.FishCastAt = os.clock() + 1
        elseif os.clock() >= (self.FishWaitDeadline or math.huge) then
            self:FishCleanup()
            self.FishPhase = "goto"
        end
        return
    end
    if phase == "minigame" then
        local gui = self:FishGui()
        local state = rod:GetAttribute("State")
        if not gui and (state == "ReeledIn" or self.FishReeledAt) and os.clock() - (self.FishReactedAt or 0) > 1 then
            self:FishInput(false)
            self.FishResultAt = os.clock() + 5.5
            self.FishPhase = "result"
        elseif os.clock() >= (self.FishMinigameDeadline or math.huge) then
            self:FishCleanup()
            self.FishPhase = "goto"
        end
        return
    end
    if phase == "result" then
        if os.clock() >= (self.FishResultAt or math.huge) then
            self:FishTap()
            self.FishCastAt = os.clock() + 1.2
            self.FishPhase = "cooldown"
        end
        return
    end
    if phase == "cooldown" then
        if os.clock() >= (self.FishCastAt or 0) then
            self:FishInput(false)
            self.FishPhase = "equip"
            self.FishEquipAt = os.clock()
        end
        return
    end
    self.FishPhase = "goto"
end

function Hub:DojoStep()
    if self.Sea ~= "Sea3" then self:Log("dojo", "Third Sea required."); return end
    if os.clock() - (self.DojoDataAt or 0) > 5 then
        self.DojoDataAt = os.clock()
        self.DojoCache = self:RefreshDojo(true)
    end
    local data = self.DojoCache
    if not data then return end
    if data.Timeout or data.Completed then
        self:Log("dojo", "No dojo quest available.")
        self:SetConfig("Auto Dojo", false)
        return
    end
    local quest = data.Quest
    if type(quest) ~= "table" then return end
    if type(quest.Progress) == "number" and type(quest.Goal) == "number" and quest.Goal > 0 and quest.Progress >= quest.Goal then
        local dest = self:FindNPC("Dojo Trainer")
        if not dest then self:Log("dojo", "Dojo Trainer unavailable."); return end
        local _, _, root = self:Character()
        if root and (dest.Position - root.Position).Magnitude > 15 then
            self:MoveTo(dest + Vector3.new(0, 3, 0))
            return
        end
        if self:ClaimDojo(true) then self.DojoDataAt = 0 end
        return
    end
    if quest.BeltName == "White" then self:FarmLevelStep()
    elseif quest.BeltName == "Purple" then self:EliteStep()
    elseif quest.BeltName == "Orange" or quest.BeltName == "Blue" then
        self:SetInfo("DojoStatus", tostring(quest.BeltName) .. " | waiting for validated player objective")
        self:Log("dojo", tostring(quest.BeltName) .. " belt is waiting for a valid player objective.")
    else self:Log("dojo", tostring(quest.BeltName) .. " belt objective unavailable.") end
end

function Hub:RainbowStep()
    if self.Sea ~= "Sea3" then self:Log("rainbow", "Third Sea required."); return end
    local ok, quest = self:Comm("HornedMan")
    if not ok or type(quest) ~= "string" then return end
    if quest:find("1", 1, true) then
        self:Log("rainbow", "Rainbow Haki already owned.")
        self:SetConfig("Rainbow Haki", false)
        return
    end
    self:Comm("HornedMan", "Bet")
    for _, name in ipairs({ "Stone", "Island Empress", "Kilo Admiral", "Captain Elephant", "Beautiful Pirate" }) do
        if quest:find(name, 1, true) then
            local boss = self:Enemies(name)[1]
            if boss then self:Fight(boss, name, false); return end
            self:MoveToSpawn(name)
            return
        end
    end
end

function Hub:CannonStep()
    local char, hum = self:Character()
    if not char or not hum or hum.Sit ~= true then self:Log("cannon", "Sit in a boat cannon seat."); return end
    if os.clock() - (self.CannonAt or 0) < 0.5 then return end
    local target = self.Target
    if not target or not self:AliveEnemy(target) then target = self.AttackTarget end
    if not target or not self:AliveEnemy(target) then return end
    local aim = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
    if not aim then return end
    self.CannonAt = os.clock()
    self:Comm("FireCannon", aim.Position)
end

