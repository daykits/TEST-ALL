function Hub:NearestDock()
    local _, _, root = self:Character()
    if not root then return nil end
    local folder = Compat.find(Services.Workspace, { "_WorldOrigin", "BoatSpawns" })
    local best, distance
    for _, object in ipairs(folder and folder:GetChildren() or {}) do
        local cf = Compat.cframe(object)
        if cf then
            local d = (cf.Position - root.Position).Magnitude
            if not distance or d < distance then best, distance = cf, d end
        end
    end
    return best
end

function Hub:MoveToDock()
    local cf = self:NearestDock()
    if not cf then self:Notify("Boats", "No streamed dock."); return end
    self.ManualDestination = cf + Vector3.new(0, 5, 0)
    self.ManualDeadline = os.clock() + 90
end

function Hub:RefreshRecipes()
    local recipes = self:Module("CraftingRecipes", { "Modules", "Data", "CraftingRecipes" })
    if not recipes then self:Notify("Crafting", "Recipes unavailable."); return end
    local names, definitions = {}, {}
    for key, recipe in pairs(recipes) do
        if type(key) == "string" and type(recipe) == "table"
            and type(recipe.Ingredients) == "table" and type(recipe.Reward) == "table" then
            local reward = recipe.Reward[1]
            local label = type(reward) == "string" and reward ~= key and (reward .. " [" .. key .. "]") or key
            definitions[label] = { Key = key, Recipe = recipe }
            table.insert(names, label)
        end
    end
    table.sort(names)
    self.RecipeOptions = definitions
    self:SetOptions("RecipeDropdown", names)
    local selected = self.Config["Selected Recipe"]
    if definitions[selected] == nil and names[1] then self:SetConfig("Selected Recipe", names[1]) end
    self:RenderRecipe()
end

