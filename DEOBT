    local parent = tool.Parent
    while parent and parent ~= Services.Workspace do
        if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return false end
        parent = parent.Parent
    end
    return true
end

function Hub:CollectFruitStep()
    self:InstallFruitTracker()
    self.FruitAttempts = self.FruitAttempts or {}
    local now = os.clock()
    local _, _, root = self:Character()
    if not root then return end
    local nearest, handle, distance
    for tool in pairs(self.WorldFruits) do
        local record = self.FruitAttempts[tool]
        if self:IsLooseFruit(tool) and (not record or record.n < 5) then
            local part = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local d = (root.Position - part.Position).Magnitude
                if not distance or d < distance then nearest, handle, distance = tool, part, d end
            end
        end
    end
    if not nearest then return end
    if distance > 6 then
        local record = self.FruitAttempts[nearest] or { n = 0, t = 0 }
        if now - record.t > 3 then record.n += 1; record.t = now end
        self.FruitAttempts[nearest] = record
        self:MoveTo(handle.CFrame)
        return
    end
    self.FruitAttempts[nearest] = nil
    self:Touch(handle)
end

