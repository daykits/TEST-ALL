	function extendGrabline()
		char = localPlayer.Character

		if not char then
			return
		end

		hrp = char:WaitForChild("HumanoidRootPart")

		if inputConnection then
			inputConnection:Disconnect()
		end

		inputConnection = UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseWheel or not extendEnabled then
				return
			end

			lineDistance = math.max(30, lineDistance + (input.Position.Z > 0 and extendSpeed or -extendSpeed))
		end)

		if childAddedConnection then
			childAddedConnection:Disconnect()
		end

		childAddedConnection = workspace.ChildAdded:Connect(function(child_)
			if child_.Name ~= "GrabParts" or not (child_:IsA("Model") and extendEnabled) then
				return
			end

			grabParts = child_
			grabParts:WaitForChild("GrabPart")
			grabParts:WaitForChild("DragPart")
			dragClone = grabParts.DragPart:Clone()
			dragClone.Name = "DragPart1"
			dragClone.AlignPosition.Attachment1 = dragClone.DragAttach
			dragClone.Parent = grabParts
			dragClone.AlignOrientation.Enabled = false
			grabParts.DragPart.AlignPosition.Enabled = false
			task.spawn(function()
				while grabParts.Parent and extendEnabled do
					dragClone.Position = currentCamera.CFrame.Position + currentCamera.CFrame.LookVector * lineDistance
					task.wait()
				end

				lineDistance = 30

				if not (dragClone and dragClone.Parent) then
					return
				end

				dragClone:Destroy()
			end)
		end)
	end
