-- FIX: le perso se pose UNE FOIS sur le lockPos (centre cave + hoverHeight)

-- et n'en bouge plus. doDamageCombo frappe tout dans le rayon sans TP NPC par NPC.

-- ============================================================

local function phase1FishmanFarm()

	notify("Kaitun", "Phase 1: Fishman farm", 5)

	getgenv().KaitunFarm = true

	H.autoAdsEnabled = true

	H.autoStatsEnabled = true

	setNoclip(true)

	H.teleportSpeed = DefaultConfig.MAIN.TWEEN_SPEED or 70

	local targetName    = "Fishman Karate User"

	local questName     = "Help becky"

	local questMinLevel = 190

	local questPos      = Vector3.new(7731.026, -2175.832, -17222.637)

	local center        = Vector3.new(7736.441, -2176.832, -17308.871)

	local hoverHeight   = 8.4

	local arrivedAtCave = false

	-- Position de combat fixe : au-dessus du centre de la cave, le perso n'en bouge plus

	local lockPos = Vector3.new(center.X, center.Y + hoverHeight, center.Z)

	while getgenv().KaitunFarm do

		if not isAlive() then task.wait(0.5) continue end

		local level    = getLevel()

		local levelCap = DefaultConfig.MAIN.LEVEL or 675

		if level >= 425 then

			notify("Kaitun", "Level 425 reached. Leaving Fishman phase.", 5)

			break

		end

		if level >= levelCap then

			notify("Kaitun", "Configured level reached.", 5)

			break

		end

		equipMelee()

		local rp = getHRP()

		if not rp then task.wait(0.5) continue end

		-- Aller a la cave une seule fois via les waypoints

		if not arrivedAtCave then

			if (rp.Position - center).Magnitude > 120 then

				notify("Kaitun", "Going to Fishman cave by waypoints...", 4)

				for _, wp in ipairs(FISHMAN_CAVE_PATH) do

					if not getgenv().KaitunFarm then break end

					DoSafeTeleport(wp, true)

					task.wait(0.21)

				end

			end

			-- Se poser sur le lockPos central et y rester

			DoSafeTeleport(lockPos, true)

			task.wait(0.3)

			arrivedAtCave = true

		end

		-- Si le perso s'est eloigne du lockPos (mort/respawn/knockback), le ramener

		rp = getHRP()

		if not rp then task.wait(0.5) continue end

		if (rp.Position - lockPos).Magnitude > 20 then

			arrivedAtCave = false

			continue

		end

		-- Prendre la quete si besoin (revenir au lockPos apres)

		if level >= questMinLevel and getQuest() ~= questName then

			takeQuest(questName, questPos)

			DoSafeTeleport(lockPos, true)

			task.wait(0.5)

			continue

		end

		local npcs = getAllNPCs(targetName)

		if #npcs == 0 then

			-- Pas de NPC, rester ancre sur le lockPos en attendant le respawn

			enableAirHold(getHRP(), lockPos)

			task.wait(0.5)

			continue

		end

		-- Un seul appel : frappe tout ce qui est dans le rayon autour du centre

		-- Le perso reste sur lockPos, ne bouge plus NPC par NPC

		doDamageCombo(targetName, center, lockPos, 30)

		task.wait(0.21)

	end

end

