--=====================================================================
-- 4) UTILITY FUNCTIONS
--=====================================================================
local function New(class, props, children)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then
                pcall(function() inst[k] = v end)
            end
        end
    end
    if children then
        for _, c in ipairs(children) do
            c.Parent = inst
        end
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

local function Corner(radius)
    return New("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function Stroke(color, thickness)
    return New("UIStroke", {
        Color = color or CurrentTheme.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function Padding(t, b, l, r)
    return New("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or (t or 0)),
        PaddingLeft = UDim.new(0, l or (t or 0)),
        PaddingRight = UDim.new(0, r or (l or t or 0)),
    })
end

local function ListLayout(props)
    local base = {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
    }
    if props then
        for k, v in pairs(props) do base[k] = v end
    end
    return New("UIListLayout", base)
end

local function Scale(scale, minSize)
    return New("UIScale", { Scale = scale or 1 })
end

local function Clamp(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local function Round(v, step)
    if step and step > 0 then
        return math.floor(v / step + 0.5) * step
    end
    return v
end

local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[BananaUI] Callback error:", err)
    end
end

local function Color3ToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function HexToColor3(hex)
    hex = tostring(hex or ""):gsub("#", "")
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return Color3.fromRGB(r, g, b)
end

--=====================================================================
-- 5) CLEANUP MANAGER
--=====================================================================
local CleanupManager = {}
CleanupManager.__index = CleanupManager

function CleanupManager.new()
    return setmetatable({ _conns = {}, _insts = {}, _fns = {} }, CleanupManager)
end

function CleanupManager:AddConnection(conn)
    table.insert(self._conns, conn)
    return conn
end

function CleanupManager:AddInstance(inst)
    table.insert(self._insts, inst)
    return inst
end

function CleanupManager:AddFn(fn)
    table.insert(self._fns, fn)
    return fn
end

function CleanupManager:Destroy()
    for _, c in ipairs(self._conns) do
        pcall(function() c:Disconnect() end)
    end
    self._conns = {}

    for _, i in ipairs(self._insts) do
        pcall(function() i:Destroy() end)
    end
    self._insts = {}

    for _, f in ipairs(self._fns) do
        pcall(f)
    end
    self._fns = {}
end

--=====================================================================
-- 6) ANIMATION ENGINE
--=====================================================================
local AnimationEngine = {}
AnimationEngine.__index = AnimationEngine

AnimationEngine.Default = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

function AnimationEngine.new()
    return setmetatable({ _tweens = {} }, AnimationEngine)
end

function AnimationEngine:Play(inst, props, info)
    if not inst or not inst.Parent then return nil end
    local old = self._tweens[inst]
    if old then pcall(function() old:Cancel() end) end
    local tween = TweenService:Create(inst, info or AnimationEngine.Default, props)
    self._tweens[inst] = tween
    tween:Play()
    tween.Completed:Connect(function()
        if self._tweens[inst] == tween then
            self._tweens[inst] = nil
        end
    end)
    return tween
end

function AnimationEngine:Cancel(inst)
    local t = self._tweens[inst]
    if t then pcall(function() t:Cancel() end) end
    self._tweens[inst] = nil
end

function AnimationEngine:Clear()
    for inst, t in pairs(self._tweens) do
        pcall(function() t:Cancel() end)
    end
    self._tweens = {}
end

local GlobalAnimations = AnimationEngine.new()

