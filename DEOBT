    local ok, stage, details = self:NetCall("InteractSubclassQuest", state.Name)
    if not ok or type(stage) ~= "number" then self:Notify("Subclass", "Quest unavailable."); return nil end
    local labels = { [0] = "Locked", [1] = "Quest available", [2] = "Class available", [3] = "Quest in progress" }
    local text = labels[stage] or "Unavailable"
    if stage == 3 and type(details) == "table" and type(details[1]) == "number" then text ..= " | " .. details[1] .. " remaining" end
