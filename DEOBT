--// Tab system
local Tabs = {}
local activeTab

local function createTab(name, symbol)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.65,
        Text = "",
        AutoButtonColor = false,
    }, Sidebar)
    corner(button, 8)

    local icon = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.fromOffset(25, 39),
        Font = Enum.Font.GothamBold,
        Text = symbol,
        TextColor3 = Theme.Muted,
        TextSize = 16,
    }, button)

    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(35, 0),
        Size = UDim2.new(1, -40, 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = name,
        TextColor3 = Theme.Muted,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    local page = create("ScrollingFrame", {
        Name = name .. "Page",
        Position = UDim2.fromOffset(10, 10),
        Size = UDim2.new(1, -20, 1, -20),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, Content)

    create("UIPadding", {
        PaddingRight = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 6),
    }, page)

    create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    local tab = { Button = button, Icon = icon, Label = label, Page = page }
    table.insert(Tabs, tab)

    button.Activated:Connect(function()
        if activeTab == tab then return end
        for _, other in ipairs(Tabs) do
            other.Page.Visible = false
            tween(other.Button, 0.16, {
                BackgroundColor3 = Theme.Surface,
                BackgroundTransparency = 0.65,
            })
            other.Icon.TextColor3 = Theme.Muted
            other.Label.TextColor3 = Theme.Muted
        end
        tab.Page.Visible = true
        tween(tab.Button, 0.18, {
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0,
        })
        tab.Icon.TextColor3 = Theme.Text
        tab.Label.TextColor3 = Theme.Text
        activeTab = tab
    end)

    return tab
end

--// Components
local function createSection(parent, text)
    return create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 25),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = string.upper(text),
        TextColor3 = Theme.Muted,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

local function createInfo(parent, text)
    local frame = create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
    }, parent)
    corner(frame, 8)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(11, 0),
        Size = UDim2.new(1, -22, 1, 0),
        Font = Enum.Font.Gotham,
        Text = text,
        TextColor3 = Theme.Muted,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    return frame
end

local function createButton(parent, text, callback)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = Theme.Accent,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        AutoButtonColor = false,
    }, parent)
    corner(button, 8)
    create("UIGradient", {
        Color = ColorSequence.new(Theme.Accent, Theme.Accent2),
        Rotation = 0,
    }, button)

    button.MouseEnter:Connect(function()
        tween(button, 0.15, { BackgroundTransparency = 0.12 })
    end)
    button.MouseLeave:Connect(function()
        tween(button, 0.15, { BackgroundTransparency = 0 })
    end)
    button.Activated:Connect(function()
        tween(button, 0.08, { BackgroundTransparency = 0.25 })
        task.delay(0.09, function()
            if button.Parent then
                tween(button, 0.12, { BackgroundTransparency = 0 })
            end
        end)
        if callback then callback() end
    end)
    return button
end

local function createToggle(parent, text, defaultValue, callback)
    local value = defaultValue == true
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 43),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
    }, parent)
    corner(row, 8)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(11, 0),
        Size = UDim2.new(1, -78, 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local switch = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(42, 22),
        BackgroundColor3 = value and Theme.Accent or Theme.Off,
        BorderSizePixel = 0,
    }, row)
    corner(switch, 11)

    local knob = create("Frame", {
        Position = value and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
    }, switch)
    corner(knob, 8)

    local hitbox = create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, row)

    local function setValue(newValue, skipCallback)
        value = newValue == true
        tween(switch, 0.16, {
            BackgroundColor3 = value and Theme.Accent or Theme.Off,
        })
        tween(knob, 0.18, {
            Position = value and UDim2.new(1, -19, 0.5, -8)
                or UDim2.new(0, 3, 0.5, -8),
        })
        if callback and not skipCallback then callback(value) end
    end

    hitbox.Activated:Connect(function() setValue(not value, false) end)

    return { Frame = row, Get = function() return value end, Set = setValue }
end

local function createSlider(parent, text, minValue, maxValue, defaultValue, callback)
    local value = math.clamp(defaultValue, minValue, maxValue)
    local frame = create("Frame", {
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
    }, parent)
    corner(frame, 8)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(11, 5),
        Size = UDim2.new(1, -85, 0, 20),
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local valueLabel = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -65, 0, 5),
        Size = UDim2.fromOffset(54, 20),
        Font = Enum.Font.GothamBold,
        Text = tostring(value),
        TextColor3 = Theme.Accent2,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, frame)

    local bar = create("Frame", {
        Position = UDim2.new(0, 11, 0, 37),
        Size = UDim2.new(1, -22, 0, 6),
        BackgroundColor3 = Theme.Off,
        BorderSizePixel = 0,
    }, frame)
    corner(bar, 3)

    local ratio = (value - minValue) / (maxValue - minValue)
    local fill = create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 3)

    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(ratio, 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
    }, bar)
    corner(knob, 7)

    local dragging = false
    local function setFromX(x)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
        value = math.floor(minValue + (maxValue - minValue) * alpha + 0.5)
        valueLabel.Text = tostring(value)
        tween(fill, 0.05, { Size = UDim2.new(alpha, 0, 1, 0) })
        tween(knob, 0.05, { Position = UDim2.new(alpha, 0, 0.5, 0) })
        if callback then callback(value) end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Frame = frame,
        Get = function() return value end,
        Set = function(newValue)
            value = math.clamp(math.floor(newValue + 0.5), minValue, maxValue)
            local alpha = (value - minValue) / (maxValue - minValue)
            valueLabel.Text = tostring(value)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
            if callback then callback(value) end
        end,
    }
end

