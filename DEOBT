function Hub:ChangeSharkmanUpgrade(purchase)
    local data = self:RefreshSharkman(true)
    local index, definition = self:SelectedSharkmanUpgrade()
    local quest = data and data.QuestData and data.QuestData.SharkQuest
    local state = quest and quest.Upgrades and index and quest.Upgrades[index]
    if not index or type(state) ~= "table" or type(quest.BeltStage) ~= "number"
        or type(definition.RequiredBeltStage) ~= "number" or quest.BeltStage < definition.RequiredBeltStage then
        self:Notify("Sharkman Master", "Upgrade locked."); return
    end
    if purchase then
        if state.own == true then self:Notify("Sharkman Master", "Already owned."); return end
        if state.own ~= false or type(definition.FragmentsCost) ~= "number" then return end
        local fragments = self:Value({ "Data", "Fragments" })
        if type(fragments) ~= "number" or fragments < definition.FragmentsCost then
            self:Notify("Sharkman Master", "Not enough fragments."); return
        end
    elseif state.own ~= true then self:Notify("Sharkman Master", "Upgrade not owned."); return end
    local ok, result = self:NetCall("SharkmanMaster", "Upgrade", index, purchase and "Purchase" or "ToggleDisable")
    if ok and type(result) == "table" and result.Success == true then
        if type(result.QuestData) == "table" then self.SharkmanData.QuestData = result.QuestData end
        self:RenderSharkman()
    end
    self:Response("Sharkman Master", ok, result)
end

