function Hub:HalloweenCraftWitchPotions()
    if self.HalloweenCraftBusy then return end
    local name = self.Config["Halloween Witch Potion"] or "Pumpkin Potion"
    local amount = math.max(1, math.floor(tonumber(self.Config["Halloween Witch Potion Amount"]) or 1))
    self.HalloweenCraftBusy = true
    local function done(message)
        self.HalloweenCraftBusy = false
        if message then self:Notify("Witch Potions", message) end
    end
    if not self:HalloweenActive() then return done("Halloween event is not active.") end
    if name == "Soul Swap Potion" then self:Notify("Witch Potions", "Soul Swap consumes Cursed Pumpkin Seeds.") end
    local missing, have, need = self:RecipeMissingMaterial(name)
    if missing then return done(("Missing %s (%d/%d)."):format(missing, have or 0, need or 0)) end
    local _, cauldronCF = self:HalloweenDapperCauldron()
    if cauldronCF then self:HalloweenGoCauldron(false, true) else self:HalloweenGoNPC("Witch", false) end
    local crafted = 0
    for _ = 1, amount do
        if not self.Alive then break end
        if self:RecipeMissingMaterial(name) then break end
        if not self:AutoCraftRecipe(name) then break end
        crafted += 1
        self:HalloweenStatus("Witch Potions | Crafted " .. crafted .. "/" .. amount .. " " .. name)
        task.wait(0.35)
    end
    self.InventoryTime = -100
    done(crafted > 0 and ("Crafted " .. crafted .. "x " .. name .. ".") or ("Could not craft " .. name .. "."))
end

