	function getColorSequence(p7)
		r = math.sin(p7) * 0.5 + 0.5
		g = math.sin(p7 + 2) * 0.5 + 0.5
		b = math.sin(p7 + 4) * 0.5 + 0.5

		return ColorSequence.new(toColor3(r, g, b)), toColor3(r, g, b)
	end
