function Hub:FruitStorage()
    if self.FruitStorageCache and os.clock() - (self.FruitStorageAt or 0) < 10 then return self.FruitStorageCache end
    local ok, inventory = self:Comm("getInventory")
    local result = {}
    if ok and type(inventory) == "table" then
        for _, entry in pairs(inventory) do
            if type(entry) == "table" and entry.Type == "Blox Fruit" and (entry.Count or 0) > 0 and type(entry.Name) == "string" then
                table.insert(result, { Name = entry.Name, Value = tonumber(entry.Value) or 0 })
            end
        end
    end
    self.FruitStorageCache, self.FruitStorageAt = result, os.clock()
    return result
end

function Hub:CheapStoredFruit()
    local best, price
    for _, entry in ipairs(self:FruitStorage()) do
        if entry.Value < 1000000 and (not price or entry.Value < price) then best, price = entry.Name, entry.Value end
    end
    return best
end

function Hub:MultiFiles()
    return type(readfile) == "function" and type(writefile) == "function"
        and type(listfiles) == "function"
end

function Hub:MultiTeam()
    return tostring(self.Config["Multi Team"] or ""):gsub("[^%w]", ""):sub(1, 24)
end

function Hub:MultiCounts(kind)
    local team = self:MultiTeam()
    if team == "" or type(listfiles) ~= "function" then return 0, 0, nil end
    local ready, beats, low, now = 0, 0, nil, os.time()
    local ok, files = pcall(listfiles, "BaconMulti")
    if not ok or type(files) ~= "table" then return 0, 0, nil end
    for _, path in ipairs(files) do
        local name = tostring(path):match("([^/\\]+)$") or ""
        local beatUser = name:match("^" .. team .. "_(%d+)%.json$")
        if beatUser and name:find("_leader", 1, true) == nil then
            local fresh = false
            pcall(function()
                local data = Services.HttpService:JSONDecode(readfile(path))
                if type(data) == "table" and now - (tonumber(data.t) or 0) < 30 then fresh = true end
            end)
            if fresh then
                beats += 1
                local id = tonumber(beatUser)
                if id and (not low or id < low) then low = id end
            end
        end
        if kind and name:match("^" .. team .. "_" .. kind .. "_%d+%.txt$") then
            local stamp = 0
            pcall(function() stamp = tonumber(readfile(path)) or 0 end)
            if now - stamp < 25 then ready += 1 end
        end
    end
    return ready, beats, low
end

function Hub:MultiIsLeader()
    local _, _, low = self:MultiCounts()
    return low == nil or Player.UserId <= low
end

function Hub:RenderMultiPlayers()
    local roster = self.Config["Multi Players"]
    if type(roster) ~= "table" or #roster == 0 then self:SetInfo("MultiPlayersInfo", "Empty")
    else self:SetInfo("MultiPlayersInfo", table.concat(roster, ", ")) end
end

function Hub:MultiHeartbeat()
    local team = self:MultiTeam()
    if team == "" or not self:MultiFiles() then return end
    if os.clock() - (self.MultiBeatAt or 0) < 10 then return end
    self.MultiBeatAt = os.clock()
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("BaconMulti") then
            makefolder("BaconMulti")
        end
        writefile("BaconMulti/" .. team .. "_" .. Player.UserId .. ".json",
            Services.HttpService:JSONEncode({ t = os.time(), job = game.JobId }))
    end)
    local _, beats, low = self:MultiCounts()
    local leader = low == nil or Player.UserId <= low
    if leader then
        pcall(writefile, "BaconMulti/" .. team .. "_leader.json",
            Services.HttpService:JSONEncode({ t = os.time(), job = game.JobId }))
    end
    self:SetInfo("MultiStatus", "Team: " .. team .. " | Tabs: " .. beats .. (leader and " | Leader" or ""))
    self:RenderMultiPlayers()
    if self.Config["Auto Join Leader"] and not leader and os.clock() - (self.MultiJoinAt or 0) > 30 then
        self.MultiJoinAt = os.clock()
        self:JoinLeader(true)
    end
end

function Hub:JoinLeader(silent)
    local team = self:MultiTeam()
    if team == "" or type(readfile) ~= "function" then
        if not silent then self:Notify("Multi", "Set a team first.") end
        return
    end
    local job, stamp
    pcall(function()
        local data = Services.HttpService:JSONDecode(readfile("BaconMulti/" .. team .. "_leader.json"))
        if type(data) == "table" then job, stamp = data.job, data.t end
    end)
    if type(job) ~= "string" or job == "" or os.time() - (tonumber(stamp) or 0) > 40 then
        if not silent then self:Notify("Multi", "Leader offline.") end
        return
    end
    if job == game.JobId then return end
    local browser = Services.ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if browser then pcall(browser.InvokeServer, browser, "teleport", job) end
end

function Hub:MultiSync(kind, size)
    local team = self:MultiTeam()
    if team == "" or not self:MultiFiles() then return true end
    local now = os.time()
    self.MultiSyncStart = self.MultiSyncStart or {}
    if not self.MultiSyncStart[kind] then self.MultiSyncStart[kind] = os.clock() end
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("BaconMulti") then
            makefolder("BaconMulti")
        end
        writefile("BaconMulti/" .. team .. "_" .. kind .. "_" .. Player.UserId .. ".txt", tostring(now))
    end)
    local ready, beats = self:MultiCounts(kind)
    local need = math.clamp(size or 2, 1, 12)
    if beats > 0 then need = math.min(need, beats) end
    if ready >= need and self:MultiIsLeader() then
        pcall(writefile, "BaconMulti/" .. team .. "_" .. kind .. "_go.txt", tostring(now))
    end
    local go = 0
    pcall(function() go = tonumber(readfile("BaconMulti/" .. team .. "_" .. kind .. "_go.txt")) or 0 end)
    if now - go < 20 then self.MultiSyncStart[kind] = nil; return true end
    if os.clock() - self.MultiSyncStart[kind] > 30 then self.MultiSyncStart[kind] = nil; return true end
    return false
end

function Hub:RaidNextIsland()
    if os.clock() < (self.RaidIslandAt or 0) then return end
    local _, _, root = self:Character()
    local locations = Compat.find(Services.Workspace, { "_WorldOrigin", "Locations" })
    if not root or not locations then return end
    local best, distance
    for index = 1, 5 do
        local island = locations:FindFirstChild("Island " .. index)
        if Compat.isA(island, "BasePart") then
            local d = (island.Position - root.Position).Magnitude
            if d <= 2500 and (not distance or d < distance) then best, distance = island, d end
        end
    end
    if not best then return end
    local first = best.Name == "Island 1"
    pcall(function() best.Name = best.Name .. "Pass" end)
    if not self.Config["Raid No Delay"] and not first then
        self.RaidIslandAt = os.clock() + self.Config["Raid Island Delay"]
    else
        self.RaidIslandAt = os.clock() + 3
    end
    self.RaidHover = best.CFrame + Vector3.new(0, 60, 0)
    if first then task.wait(1) end
    self:MoveTo(self.RaidHover)
end

function Hub:RaidHoverStep()
    self:RaidNextIsland()
    local hover = self.RaidHover
    local _, _, root = self:Character()
    if hover and root and (root.Position - hover.Position).Magnitude < 150 and root.Position.Y < hover.Position.Y - 15 then
        self:MoveTo(hover)
    end
end

function Hub:RaidStep()
    if self.Sea ~= "Sea2" and self.Sea ~= "Sea3" then self:Log("raid", "Second or Third Sea required."); return end
    local level = self:Value({ "Data", "Level" })
    if type(level) ~= "number" or level < 1100 then self:Log("raid", "Level 1100 required."); return end
    if self:RaidTimerVisible() then
        self.RaidWasActive = true
        local target = self.RaidTarget
        if not target or not self:AliveEnemy(target) then
            target = self:Enemies(function() return true end, 2000)[1]
            self.RaidTarget = target
        end
        if target then
            local _, _, root = self:Character()
            local mobRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
            if root and mobRoot and (mobRoot.Position - root.Position).Magnitude > 2000 then
                self.RaidTarget = nil
                self:RaidNextIsland()
            else self:Fight(target, nil, false) end
        else self:RaidHoverStep() end
        return
    end
    if self.RaidWasActive then
        self.RaidWasActive = false
        self.RaidTarget, self.RaidHover = nil, nil
        if self.Config["Auto Awaken"] then self:Awaken(true) end
        self.RaidCooldownUntil = os.clock() + 10
        return
    end
    if os.clock() < (self.RaidCooldownUntil or 0) then return end
    if not self:HasChip() then
        local fruits = self:PhysicalFruits()
        if #fruits == 0 and self.Config["Raid Fruit Under 1M"] then
            local cheap = self:CheapStoredFruit()
            if cheap then
                self:Comm("LoadFruit", cheap)
                self.RaidCooldownUntil = os.clock() + 2
                return
            end
        end
        if #fruits == 0 then
            if not self.RaidFruitMissing then self.RaidFruitMissing = true; self:Log("raid", "Need a fruit for the chip.", 0) end
            self.RaidCooldownUntil = os.clock() + 10
            return
        end
        self.RaidFruitMissing = nil
        self:BuyRaidChip()
        self.RaidCooldownUntil = os.clock() + 3
        return
    end
    self.RaidFruitMissing = nil
    local spot
    if self.Sea == "Sea3" then
        spot = { Pos = CFrame.new(-5034.16, 314.97, -2948.15), Path = { "Map", "Boat Castle", "RaidSummon2", "Button", "Main" } }
    else
        spot = { Pos = CFrame.new(-6438.74, 250.65, -4501.51), Path = { "Map", "CircleIsland", "RaidSummon2", "Button", "Main" } }
    end
    if not self:MoveTo(spot.Pos) then return end
    local raidSize = self.Config["Multi Raid Size"]
    if self:MultiTeam() ~= "" and raidSize > 1 and not self:MultiSync("raid", raidSize) then return end
    local button = Compat.find(Services.Workspace, spot.Path)
    local detector = button and button:FindFirstChild("ClickDetector")
    if not detector then
        if os.clock() - (self.RaidButtonWarnAt or 0) > 10 then
            self.RaidButtonWarnAt = os.clock()
            self:Log("raid", "Raid button not found, waiting.")
        end
        return
    end
    if os.clock() - (self.RaidClickAt or 0) > 1.5 then
        self.RaidClickAt = os.clock()
        local _, hum = self:Character()
        if hum then pcall(hum.UnequipTools, hum) end
        pcall(fireclickdetector, detector)
    end
end

function Hub:IsNearEntrance(plr)
    local race = self:PlayerRace(plr)
    local gate = race and self.TrialEntrances[race]
    local char = plr and plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not gate or not root then return false end
    local target = gate.Second or gate.First
    return (root.Position - target.Position).Magnitude < 12
end

function Hub:TrialEntranceTP()
    local _, _, root = self:Character()
    if not root then return end
    local temple = Vector3.new(28286.36, 14896.51, 102.62)
    if (root.Position - temple).Magnitude >= 4000 then
        local entered, point = self:Comm("requestEntrance", temple)
        if entered and typeof(point) == "Vector3" then
            local _, _, now = self:Character()
            if now then now.CFrame = CFrame.new(point) end
            task.wait(0.5)
        else
            self:Log("trial", "Entrance TP unavailable, tweening to the temple.")
            self:MoveTo(CFrame.new(temple))
            return
        end
    end
    local race = self:PlayerRace(Player)
    local gate = race and self.TrialEntrances[race]
    if not gate then return end
    local function place(cf)
        local _, _, current = self:Character()
        if not current then return end
        if (current.Position - cf.Position).Magnitude > 12 then
            current.CFrame = cf
            current.AssemblyLinearVelocity, current.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            task.wait(1.2)
        end
    end
    if gate.Second then place(gate.First); place(gate.Second) else place(gate.First) end
end

