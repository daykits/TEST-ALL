function Hub:NativeFruitSkill(code)
    if not table.find({ "Z", "X", "C", "V", "F" }, code) then return false end
    local char = Player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not self:IsFruitTool(tool) then return false end
    local key = Enum.KeyCode[code]
    local global = self:Module("Global", { "Global" })
    if not key or not global or type(global.casFunc) ~= "function" then return false end
    self:InstallAimAdapter()
    if self.Target and self:AliveEnemy(self.Target) then self.AttackTarget = self.Target end
    local input = self:NewInput()
    input.KeyCode = key
    input.UserInputType = Services.UserInputService.TouchEnabled and Enum.UserInputType.Touch or Enum.UserInputType.Keyboard
    input.Position = Vector3.zero
    local ok, problem = pcall(global.casFunc, "DevilFruit", Enum.UserInputState.Begin, input, key)
    task.delay(0.18, function()
        input.UserInputState = Enum.UserInputState.End
        pcall(global.casFunc, "DevilFruit", Enum.UserInputState.End, input, key)
        input:Destroy()
        self.Inputs[input] = nil
    end)
    if not ok and os.clock() >= (self.NativeFruitSkillFailAt or 0) then
        self.NativeFruitSkillFailAt = os.clock() + 10
        self:Log("fruit-skill-client", problem)
    end
    return ok
end

function Hub:PressKey(code)
    local key = Enum.KeyCode[code]
    if not key then return false end
    if self:NativeFruitSkill(code) then return true end
    local ok = pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end)
    return ok
end

function Hub:AimPoint(model)
    local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true))
    if not Compat.isA(root, "BasePart") then return nil end
    local _, _, mine = self:Character()
    local pos = root.Position
    if not mine or not self.Config["Aimbot Prediction"] then return pos end
    local dist = (pos - mine.Position).Magnitude
    local ping = 0
    pcall(function() ping = Player:GetNetworkPing() end)
    local t = dist / 1000 + ping + 0.05
    return pos + root.AssemblyLinearVelocity * t + Vector3.new(0, -4.9 * t * t, 0)
end

function Hub:AimPool()
    local source = self.Config["Aim Source"]
    if source == "Selected Player" then
        local char = self:SelectedPlayerChar()
        if char then return { char } end
        return {}
    end
    local pool = {}
    if source == "Mobs Near" or source == "HRP Near" then
        local folder = Services.Workspace:FindFirstChild("Enemies")
        for _, model in ipairs(folder and folder:GetChildren() or {}) do
            if self:AliveEnemy(model) then table.insert(pool, model) end
        end
    end
    if source == "Players Near" or source == "HRP Near" then
        for _, other in ipairs(Services.Players:GetPlayers()) do
            if other ~= Player and (self.Config["Aimbot All Teams"] or other.Team ~= Player.Team) then
                if self:AliveEnemy(other.Character) then table.insert(pool, other.Character) end
            end
        end
    end
    return pool
end

function Hub:SelectedPlayerChar()
    local name = self.Config["Selected Player"]
    if name == "" then return nil end
    local target = Services.Players:FindFirstChild(name)
    local char = target and target.Character
    if target ~= Player and self:AliveEnemy(char) then return char end
    return nil
end

function Hub:NearestPlayerChar()
    local _, _, mine = self:Character()
    if not mine then return nil end
    local best, bestDist
    for _, other in ipairs(Services.Players:GetPlayers()) do
        if other ~= Player and (self.Config["Aimbot All Teams"] or other.Team ~= Player.Team) then
            local char = other.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
            if self:AliveEnemy(char) and root then
                local dist = (root.Position - mine.Position).Magnitude
                if not bestDist or dist < bestDist then best, bestDist = char, dist end
            end
        end
    end
    return best
end

function Hub:AimbotTarget()
    local camera = Services.Workspace.CurrentCamera
    if not camera then return nil end
    local _, _, mine = self:Character()
    local mouse = Player:GetMouse()
    local center = mouse and Vector2.new(mouse.X, mouse.Y) or camera.ViewportSize / 2
    local mode = self.Config["Aimbot Mode"]
    local best, bestScore
    for _, char in ipairs(self:AimPool()) do
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if hum and Compat.isA(root, "BasePart") then
            local score
            if mode == "Lowest Health" then
                score = hum.Health / math.max(hum.MaxHealth, 1)
            elseif mode == "Nearest" and mine then
                score = (root.Position - mine.Position).Magnitude
            else
                local point, onScreen = camera:WorldToScreenPoint(root.Position)
                if onScreen then score = (Vector2.new(point.X, point.Y) - center).Magnitude end
            end
            if score and (not bestScore or score < bestScore) then best, bestScore = char, score end
        end
    end
    return best
end

function Hub:RestoreCamera()
    if self.CameraZoom then
        pcall(function()
            Player.CameraMaxZoomDistance = self.CameraZoom.Max
            Player.CameraMinZoomDistance = self.CameraZoom.Min
        end)
        self.CameraZoom = nil
    end
end

function Hub:AimLockStep()
    local _, _, mine = self:Character()
    local limit = self.Config["Aim Max Distance"] or 500
    local locked = self.AimLock
    if locked then
        local owner = Services.Players:GetPlayerFromCharacter(locked)
        local root = locked:FindFirstChild("HumanoidRootPart") or locked.PrimaryPart
        if not owner or not self:AliveEnemy(locked) or not root or not mine
            or (root.Position - mine.Position).Magnitude > limit or not self:SilentEnemy(owner) then
            locked = nil
        end
    end
    if not locked and mine then
        local best, bestDist
        for _, other in ipairs(Services.Players:GetPlayers()) do
            if other ~= Player and self:SilentEnemy(other) then
                local char = other.Character
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
                if self:AliveEnemy(char) and root then
                    local dist = (root.Position - mine.Position).Magnitude
                    if dist <= limit and (not bestDist or dist < bestDist) then best, bestDist = char, dist end
                end
            end
        end
        locked = best
    end
    self.AimLock = locked
    return locked
end

function Hub:AimbotStep()
    if not self.Config["PVP Aimbot"] and not self.Config["Aim Lock"] then
        if self.AimbotCurrent then self.AimbotCurrent = nil; self:SetInfo("PVPStatus", "Off") end
        self.AimLock = nil
        self:RestoreCamera()
        return
    end
    local target
    if self.Config["Aim Lock"] then target = self:AimLockStep()
    else self.AimLock = nil; target = self:AimbotTarget() end
    self.AimbotCurrent = target
    local _, _, root = self:Character()
    local camera = Services.Workspace.CurrentCamera
    if target and root and camera then
        local point = self:SilentPoint(target) or self:AimPoint(target)
        if self.Config["Aim Lock"] and point then point = point + Vector3.new(0, 2.5, 0) end
        if point then
            if not self.ActiveMode then root.CFrame = CFrame.lookAt(root.Position, point) end
            pcall(function()
                if not self.CameraZoom then
                    self.CameraZoom = { Max = Player.CameraMaxZoomDistance, Min = Player.CameraMinZoomDistance }
                end
                Player.CameraMaxZoomDistance = 0
                camera.CFrame = CFrame.new(camera.CFrame.Position, point)
            end)
        end
        if os.clock() - (self.AimbotInfoAt or 0) > 0.5 then
            self.AimbotInfoAt = os.clock()
            local owner = Services.Players:GetPlayerFromCharacter(target)
            local dist = point and math.floor((point - root.Position).Magnitude) or 0
            self:SetInfo("PVPStatus", (owner and owner.DisplayName or target.Name) .. " | " .. dist .. "m")
        end
    else
        self:RestoreCamera()
        if os.clock() - (self.AimbotInfoAt or 0) > 0.5 then
            self.AimbotInfoAt = os.clock()
            self:SetInfo("PVPStatus", "Scanning")
        end
    end
end

function Hub:ApplyHitbox()
    local size = self.Config["Hitbox Size"]
    self.HitboxActive = true
    for _, other in ipairs(Services.Players:GetPlayers()) do
        if other ~= Player then
            local root = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
            if Compat.isA(root, "BasePart") and root.Size.X ~= size then
                if not root:GetAttribute("BaconHitbox") then
                    root:SetAttribute("BaconHitbox",
                        root.Size.X .. "," .. root.Size.Y .. "," .. root.Size.Z)
                end
                root.Size = Vector3.new(size, size, size)
                root.CanCollide = false
            end
        end
    end
end

function Hub:ClearHitbox()
    if not self.HitboxActive then return end
    self.HitboxActive = false
    local characters = Services.Workspace:FindFirstChild("Characters")
    for _, model in ipairs(characters and characters:GetChildren() or {}) do
        local root = model:FindFirstChild("HumanoidRootPart")
        local saved = root and root:GetAttribute("BaconHitbox")
        if Compat.isA(root, "BasePart") and type(saved) == "string" then
            local parts = string.split(saved, ",")
            root.Size = Vector3.new(tonumber(parts[1]) or 2, tonumber(parts[2]) or 2, tonumber(parts[3]) or 1)
            root:SetAttribute("BaconHitbox", nil)
        end
    end
end

