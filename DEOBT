function Hub:RefreshAppearance(silent)
    local replication = self:Module("ItemReplicationService", { "ItemReplicationService" })
    local api = self:Module("ModificationUtil", { "Util", "Modification" })
    local configs = self:Module("ItemConfig", { "ItemConfig" })
    if not replication or replication.IsInitialized ~= true or not api or not configs
        or not api.Data or not api.Data.Modification or not api.Data.Adornee then
        if not silent then self:Notify("Appearance", "Data unavailable.") end
        return nil
    end
    local ok, modifications, adornees, unlocked = pcall(function()
        local mods = api.Data.Modification.fromItemReplication(Player)
        local owners = api.Data.Adornee.fromItemReplication(Player)
        return mods, owners, api.getUnlocked(mods, owners)
    end)
    if not ok or type(unlocked) ~= "table" then
        if not silent then self:Notify("Appearance", "Items unavailable.") end
        return nil
    end
    local options, names = {}, {}
    for _, itemId in ipairs(unlocked) do
        if type(itemId) == "number" then
            local matched, entry = pcall(function()
                local config = configs.match(itemId):asNullable()
                if not config or not config.Index then return nil end
                local title = config.Display and config.Display.Name
                if type(title) ~= "string" or title == "" then title = config.Index.StorageKey or tostring(itemId) end
                local kind = tostring(config.Index.IdType or "Appearance")
                return { Id = itemId, Config = config, Name = title, Label = title .. " [" .. kind .. "]",
                    Equipped = api.getIfEquipped(itemId, modifications, adornees) == true }
            end)
            if matched and entry then
                local label = entry.Label
                if options[label] then label ..= " #" .. itemId end
                entry.Label = label
                options[label] = entry
                names[#names + 1] = label
            end
        end
    end
    table.sort(names)
    self.AppearanceOptions = options
    self.AppearanceData = { API = api, Modifications = modifications, Adornees = adornees }
    self:SetOptions("AppearanceDropdown", names)
    if not options[self.Config["Selected Appearance"]] and names[1] then self:SetConfig("Selected Appearance", names[1]) end
    self:RenderAppearance()
    return self.AppearanceData
end

function Hub:RenderAppearance()
    local entry = self.AppearanceOptions and self.AppearanceOptions[self.Config["Selected Appearance"]]
    self:SetInfo("AppearanceStatus", entry and (entry.Name .. " | " .. (entry.Equipped and "Equipped" or "Owned")) or "No owned appearances")
end

function Hub:SetAppearance(equip)
    local label = self.Config["Selected Appearance"]
    local previous = self.AppearanceOptions and self.AppearanceOptions[label]
    if not previous then self:Notify("Appearance", "Refresh and select an item."); return end
    local id = previous.Id
    local data = self:RefreshAppearance(true)
    local entry = self.AppearanceOptions and self.AppearanceOptions[label]
    if not data or not entry or entry.Id ~= id then self:Notify("Appearance", "Selection unavailable."); return end
    local method = equip and data.API.getIfCanEquip or data.API.getIfCanUnequip
    if type(method) ~= "function" then self:Notify("Appearance", "Action unavailable."); return end
    local checked, allowed, reason = pcall(method, id, data.Modifications, data.Adornees)
    if not checked or allowed ~= true then self:Notify("Appearance", type(reason) == "string" and reason or "Action not available."); return end
    local ok, result = self:InvokeNet("ModificationFunction", { Type = "SetEquip", ItemId = id, IsEquipped = equip == true }, 2)
    if ok and type(result) == "table" then
        if result.Type == "Generic" then
            self:Notify("Appearance", result.Message or (result.Success == true and "Applied." or "Unavailable."))
        elseif result.Type == "GetData" then self:Notify("Appearance", "Applied.")
        else self:Notify("Appearance", "Response unavailable.") end
    else self:Response("Appearance", ok, result) end
end

