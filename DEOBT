        return true
    end
    local source = client._sourceEndpoint and client._sourceEndpoint.Parent and client._sourceEndpoint.Position or client._sourcePosition
    local target = client._targetEndpoint and client._targetEndpoint.Parent and client._targetEndpoint.Position or client._targetPosition
    local _, _, root = self:Character()
    if typeof(source) ~= "Vector3" or typeof(target) ~= "Vector3" or not root then
        self:SecretStatus(row, "Zipline | Waiting for verified endpoints")
