--// Tab system
local Tabs = {}
local activeTab

local function createTab(name, symbol)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.65,
        Text = "",
        AutoButtonColor = false,
    }, Sidebar)
    corner(button, 8)

    local icon = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.fromOffset(25, 39),
        Font = Enum.Font.GothamBold,
        Text = symbol,
        TextColor3 = Theme.Muted,
        TextSize = 16,
    }, button)

    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(35, 0),
        Size = UDim2.new(1, -40, 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = name,
        TextColor3 = Theme.Muted,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    local page = create("ScrollingFrame", {
        Name = name .. "Page",
        Position = UDim2.fromOffset(10, 10),
        Size = UDim2.new(1, -20, 1, -20),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, Content)

    create("UIPadding", {
        PaddingRight = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 6),
    }, page)

    create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    local tab = {
        Button = button,
        Icon = icon,
        Label = label,
        Page = page,
    }
    table.insert(Tabs, tab)

    button.Activated:Connect(function()
        if activeTab == tab then
            return
        end

        for _, other in ipairs(Tabs) do
            other.Page.Visible = false
            tween(other.Button, 0.16, {
                BackgroundColor3 = Theme.Surface,
                BackgroundTransparency = 0.65,
            })
            other.Icon.TextColor3 = Theme.Muted
            other.Label.TextColor3 = Theme.Muted
        end

        tab.Page.Visible = true
        tween(tab.Button, 0.18, {
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0,
        })
        tab.Icon.TextColor3 = Theme.Text
        tab.Label.TextColor3 = Theme.Text
        activeTab = tab
    end)

    return tab
end

