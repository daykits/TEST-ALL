--// ESP implementation: only CollectionService-tagged targets in this experience
local function removeESP(model)
    local highlight = espObjects[model]
    if highlight then
        highlight:Destroy()
        espObjects[model] = nil
    end

    local root = model and (model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
    if root then
        local billboard = root:FindFirstChild("NebulaESPLabel")
        if billboard then billboard:Destroy() end
    end
end

local function addESP(model)
    if not State.ESP or not model or not model:IsA("Model") then
        return
    end
    if model == LocalPlayer.Character then
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not root then
        return
    end

    if not espObjects[model] then
        local highlight = create("Highlight", {
            Name = "NebulaESPHighlight",
            Adornee = model,
            FillColor = Theme.Accent2,
            OutlineColor = Theme.Accent,
            FillTransparency = 0.78,
            OutlineTransparency = 0.08,
            DepthMode = Enum.HighlightDepthMode.Occluded,
        }, ScreenGui)
        espObjects[model] = highlight
    end

    local billboard = root:FindFirstChild("NebulaESPLabel")
    if not billboard then
        billboard = create("BillboardGui", {
            Name = "NebulaESPLabel",
            Adornee = root,
            Size = UDim2.fromOffset(170, 34),
            StudsOffset = Vector3.new(0, 2.7, 0),
            AlwaysOnTop = false,
            MaxDistance = 250,
        }, root)

        create("TextLabel", {
            Name = "Label",
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamBold,
            TextColor3 = Theme.Text,
            TextStrokeTransparency = 0.35,
            TextSize = 12,
            Text = model.Name,
        }, billboard)
    end

    local label = billboard:FindFirstChild("Label")
    if label then
        local distanceText = ""
        local character = LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        if State.ShowDistance and myRoot then
            local distance = math.floor((myRoot.Position - root.Position).Magnitude)
            distanceText = ("  [%d studs]"):format(distance)
        end

        label.Text = (State.ShowName and model.Name or "Target") .. distanceText
        label.TextColor3 = Theme.Text
    end

    if humanoid and humanoid.Health <= 0 then
        local highlight = espObjects[model]
        if highlight then highlight.Enabled = false end
    else
        local highlight = espObjects[model]
        if highlight then highlight.Enabled = true end
    end
end

local function refreshESP()
    if not State.ESP then
        for model in pairs(espObjects) do
            removeESP(model)
        end
        return
    end

    local tagged = CollectionService:GetTagged(CONFIG.ESPTag)
    local valid = {}

    for _, instance in ipairs(tagged) do
        if instance:IsA("Model") then
            valid[instance] = true
            addESP(instance)
        end
    end

    for model in pairs(espObjects) do
        if not valid[model] or not model.Parent then
            removeESP(model)
        end
    end
end

