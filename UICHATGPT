-- Nút bấm đẹp
local function CreateButton(parent, text, callback)
    local Btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Accent,
        Text = "",
        AutoButtonColor = false,
        Parent = parent
    })
    AddCorner(Btn, 8)
    AddGradient(Btn, Theme.Accent, Theme.Accent2, 45)
    local stroke = AddStroke(Btn, Theme.Accent2, 1)
    stroke.Transparency = 0.5

    local Lbl = Create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        Parent = Btn
    })

    Btn.MouseEnter:Connect(function()
        Tween(Btn, 0.2, {Size = UDim2.new(1, 4, 0, 42)})
        stroke.Transparency = 0
    end)
    Btn.MouseLeave:Connect(function()
        Tween(Btn, 0.2, {Size = UDim2.new(1, 0, 0, 40)})
        stroke.Transparency = 0.5
    end)
    Btn.MouseButton1Click:Connect(function()
        Tween(Btn, 0.1, {Size = UDim2.new(0.96, 0, 0, 38)})
        task.wait(0.1)
        Tween(Btn, 0.15, {Size = UDim2.new(1, 0, 0, 40)})
        if callback then callback() end
    end)

    return Btn
end

-- Toggle switch
local function CreateToggle(parent, text, default, callback)
    local state = default or false

    local Frame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = parent
    })
    AddCorner(Frame, 8)

    local Lbl = Create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Frame
    })

    local Switch = Create("Frame", {
        Size = UDim2.new(0, 46, 0, 24),
        Position = UDim2.new(1, -58, 0.5, -12),
        BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff,
        BorderSizePixel = 0,
        Parent = Frame
    })
    AddCorner(Switch, 12)

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = Switch
    })
    AddCorner(Knob, 9)

    local Hit = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Frame
    })

    Hit.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Tween(Switch, 0.2, {BackgroundColor3 = Theme.ToggleOn})
            Tween(Knob, 0.25, {Position = UDim2.new(1, -21, 0.5, -9)})
        else
            Tween(Switch, 0.2, {BackgroundColor3 = Theme.ToggleOff})
            Tween(Knob, 0.25, {Position = UDim2.new(0, 3, 0.5, -9)})
        end
        if callback then callback(state) end
    end)

    return { Frame = Frame, Set = function(v) 
        state = v
        if state then
            Tween(Switch, 0.2, {BackgroundColor3 = Theme.ToggleOn})
            Tween(Knob, 0.25, {Position = UDim2.new(1, -21, 0.5, -9)})
        else
            Tween(Switch, 0.2, {BackgroundColor3 = Theme.ToggleOff})
            Tween(Knob, 0.25, {Position = UDim2.new(0, 3, 0.5, -9)})
        end
        if callback then callback(state) end
    end}
end

-- Slider
local function CreateSlider(parent, text, min, max, default, callback)
    local value = default or min

    local Frame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = parent
    })
    AddCorner(Frame, 8)

    local Lbl = Create("TextLabel", {
        Size = UDim2.new(1, -90, 0, 22),
        Position = UDim2.new(0, 12, 0, 6),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Frame
    })

    local ValLbl = Create("TextLabel", {
        Size = UDim2.new(0, 60, 0, 22),
        Position = UDim2.new(1, -72, 0, 6),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = Theme.Accent2,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = Frame
    })

    local Bar = Create("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 36),
        BackgroundColor3 = Theme.ToggleOff,
        BorderSizePixel = 0,
        Parent = Frame
    })
    AddCorner(Bar, 3)

    local Fill = Create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = Bar
    })
    AddCorner(Fill, 3)
    AddGradient(Fill, Theme.Accent, Theme.Accent2, 0)

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((value - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = Bar
    })
    AddCorner(Knob, 7)

    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * pos + 0.5)
        ValLbl.Text = tostring(value)
        Tween(Fill, 0.05, {Size = UDim2.new(pos, 0, 1, 0)})
        Tween(Knob, 0.05, {Position = UDim2.new(pos, -7, 0.5, -7)})
        if callback then callback(value) end
    end

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return { Frame = Frame, Get = function() return value end }
end

-- TextBox
local function CreateTextBox(parent, placeholder, callback)
    local Box = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = parent
    })
    AddCorner(Box, 8)
    local stroke = AddStroke(Box, Theme.Stroke, 1)

    local Input = Create("TextBox", {
        Size = UDim2.new(1, -24, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = placeholder,
        PlaceholderColor3 = Theme.SubText,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        Parent = Box
    })

    Input.Focused:Connect(function()
        Tween(stroke, 0.2, {Color = Theme.Accent, Thickness = 1.5})
    end)
    Input.FocusLost:Connect(function()
        Tween(stroke, 0.2, {Color = Theme.Stroke, Thickness = 1})
        if callback then callback(Input.Text) end
    end)

    return Input
end

