-- 1. Tải thư viện Fluent UI
local Fluent = loadstring(game:HttpGet("https://github.com/ActualMasterOogway/Fluent-Renewed/releases/latest/download/Fluent.luau"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

-- 2. Khởi tạo cửa sổ Menu
local Window = Fluent:CreateWindow({
    Title = "CHATGPT",
    SubTitle = "by AI CHATGPT",
    TabWidth = 160,
    Size = UDim2.fromOffset(500, 320),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.RightControl -- Bấm RightCtrl để ẩn/hiện menu
})

local Tabs = {
    Farm = Window:AddTab({ Title = "Auto Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Cài đặt", Icon = "settings" })
}

-- ============================================
-- 3. LOGIC CHÍNH (Từ script của bạn)
-- ============================================
local Workspace        = game:GetService("Workspace")
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local VirtualInput     = game:GetService("VirtualInputManager")
local LocalPlayer      = Players.LocalPlayer

-- Biến toàn cục lưu trạng thái
getgenv().InstantPickup   = true
getgenv().AutoPressE      = true
getgenv().AutoPressDelay  = 0.05
getgenv().AutoPressRadius = 15

-- Tọa độ từ ảnh của bạn
local TARGET_POS = Vector3.new(-176.29, 310.18, -514.13)

-- Hàm nhặt item (giữ nguyên logic của bạn)
local function makeInstant(prompt)
    if not getgenv().InstantPickup then return end
    if prompt:IsA("ProximityPrompt") then
        pcall(function()
            prompt.HoldDuration         = 0
            prompt.RequiresLineOfSight  = false
        end)
    end
end

local function scanAll()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        makeInstant(obj)
    end
end

local function pressE()
    pcall(function()
        VirtualInput:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function firePrompt(prompt)
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        elseif prompt and prompt.Triggered then
            prompt:InputHoldBegin()
        end
    end)
end

-- Khởi chạy vòng lặp auto nhặt
task.spawn(function()
    while task.wait(getgenv().AutoPressDelay) do
        if not getgenv().AutoPressE then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        for _, prompt in ipairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function()
                    local parent = prompt.Parent
                    if parent and parent:IsA("BasePart") then
                        local dist = (parent.Position - root.Position).Magnitude
                        if dist <= getgenv().AutoPressRadius then
                            pressE()
                            firePrompt(prompt)
                        end
                    end
                end)
            end
        end
    end
end)

-- Theo dõi prompt mới
Workspace.DescendantAdded:Connect(function(obj)
    makeInstant(obj)
    if obj:IsA("ProximityPrompt") then
        obj:GetPropertyChangedSignal("HoldDuration"):Connect(function()
            if getgenv().InstantPickup and obj.HoldDuration ~= 0 then
                obj.HoldDuration = 0
            end
        end)
    end
end)

-- ============================================
-- 4. GIAO DIỆN TAB FARM
-- ============================================

-- Hàm Teleport
local function TeleportToTarget()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(TARGET_POS)
        Fluent:Notify({
            Title = "Teleport",
            Content = "Đã dịch chuyển đến tọa độ farm vàng!",
            Duration = 3
        })
    else
        Fluent:Notify({
            Title = "Lỗi",
            Content = "Không tìm thấy nhân vật!",
            Duration = 3
        })
    end
end

-- Nút Teleport & Bật Auto Farm
Tabs.Farm:AddButton({
    Title = "Teleport & Farm Vàng",
    Description = "Twen đến tọa độ (-176, 310, -514) và tự động nhặt",
    Callback = function()
        TeleportToTarget()
        -- Đảm bảo auto bật khi bấm nút
        getgenv().AutoPressE = true
        getgenv().InstantPickup = true
    end
})

-- Nút bật/tắt Auto Press E
local ToggleAutoE = Tabs.Farm:AddToggle("AutoPressE", { 
    Title = "Auto Press E", 
    Default = true,
    Description = "Tự động nhấn E khi đến gần vật phẩm"
})

ToggleAutoE:OnChanged(function(Value)
    getgenv().AutoPressE = Value
end)

-- Nút bật/tắt Instant Pickup
local ToggleInstant = Tabs.Farm:AddToggle("InstantPickup", { 
    Title = "Instant Pickup", 
    Default = true,
    Description = "Đặt HoldDuration = 0 (Nhặt ngay lập tức)"
})

ToggleInstant:OnChanged(function(Value)
    getgenv().InstantPickup = Value
    if Value then scanAll() end
end)

-- Thanh trượt chỉnh bán kính nhặt
local SliderRadius = Tabs.Farm:AddSlider("Radius", {
    Title = "Bán kính nhặt (Studs)",
    Description = "Khoảng cách tối đa để tự động nhặt",
    Default = 15,
    Min = 5,
    Max = 50,
    Rounding = 1,
    Callback = function(Value)
        getgenv().AutoPressRadius = Value
    end
})

