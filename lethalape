--==================================================
-- 5. GOLD IDENTIFICATION
--==================================================

local function IsGoldObject(Object)

    if not Object then
        return false
    end

    -- Preferred method: use CollectionService tags.
    if CollectionService:HasTag(Object, Config.GoldTag) then
        return true
    end

    -- Fallback: detect by object name.
    local ObjectName = string.lower(Object.Name)

    for _, Keyword in ipairs(Config.GoldKeywords) do
        if string.find(ObjectName, Keyword, 1, true) then
            return true
        end
    end

    return false
end

--==================================================
-- 6. OBJECT POSITION
--==================================================

local function GetObjectPart(Object)

    if Object:IsA("BasePart") then
        return Object
    end

    if Object:IsA("Model") then

        if Object.PrimaryPart then
            return Object.PrimaryPart
        end

        return Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

local function GetObjectPosition(Object)

    if Object:IsA("Model") then
        return Object:GetPivot().Position
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    return nil
end

local function GetDistance(Position)

    if not HumanoidRootPart or not Position then
        return math.huge
    end

    return (HumanoidRootPart.Position - Position).Magnitude
end

--==================================================
-- 7. FIND GOLD OBJECTS
--==================================================

local function ScanGold()

    local FoundObjects = {}
    local SeenObjects = {}

    if not HumanoidRootPart then
        return
    end

    for _, Object in ipairs(Workspace:GetDescendants()) do

        if Object:IsA("Model") or Object:IsA("BasePart") then

            if IsGoldObject(Object) then

                local Root = Object

                -- Avoid detecting the same object twice.
                if Object:IsA("BasePart") then

                    local ParentModel = Object:FindFirstAncestorOfClass("Model")

                    if ParentModel and IsGoldObject(ParentModel) then
                        Root = ParentModel
                    end
                end

                if not SeenObjects[Root] then

                    SeenObjects[Root] = true

                    local Position = GetObjectPosition(Root)

                    if Position then

                        local Distance = GetDistance(Position)

                        if Distance <= Config.ScanRange then

                            table.insert(FoundObjects, {
                                Object = Root,
                                Position = Position,
                                Distance = Distance
                            })

                        end
                    end
                end
            end
        end
    end

    GoldObjects = FoundObjects

    return FoundObjects
end

--==================================================
-- 8. ESP CREATION
--==================================================

local function RemoveESP(Object)

    local Data = ESPObjects[Object]

    if not Data then
        return
    end

    if Data.Highlight then
        Data.Highlight:Destroy()
    end

    if Data.Billboard then
        Data.Billboard:Destroy()
    end

    ESPObjects[Object] = nil
end

local function CreateESP(Object)

    if ESPObjects[Object] then
        return
    end

    local Part = GetObjectPart(Object)

    if not Part then
        return
    end

    -- Highlight
    local Highlight = Instance.new("Highlight")

    Highlight.Name = "GoldHubHighlight"
    Highlight.Adornee = Object
    Highlight.FillColor = Color3.fromRGB(255, 190, 30)
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 120)
    Highlight.FillTransparency = 0.55
    Highlight.OutlineTransparency = 0

    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = PlayerGui

    -- Billboard
    local Billboard = Instance.new("BillboardGui")

    Billboard.Name = "GoldHubBillboard"
    Billboard.Adornee = Part
    Billboard.Size = UDim2.fromOffset(150, 45)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.MaxDistance = Config.ScanRange
    Billboard.Parent = PlayerGui

    -- Text
    local Label = Instance.new("TextLabel")

    Label.Size = UDim2.fromScale(1, 1)
    Label.BackgroundTransparency = 1

    Label.Text = "GOLD"
    Label.TextColor3 = Color3.fromRGB(255, 205, 55)
    Label.TextStrokeTransparency = 0.15

    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 14

    Label.Parent = Billboard

    ESPObjects[Object] = {
        Highlight = Highlight,
        Billboard = Billboard,
        Label = Label
    }
end

--==================================================
-- 9. UPDATE ESP
--==================================================

local function UpdateESP()

    if not Config.ESPEnabled then

        for Object in pairs(ESPObjects) do
            RemoveESP(Object)
        end

        return
    end

    local CurrentObjects = {}

    for _, Data in ipairs(GoldObjects) do

        local Object = Data.Object

        if Object and Object.Parent then

            local Position = GetObjectPosition(Object)

            if Position then

                local Distance = GetDistance(Position)

                if Distance <= Config.ScanRange then

                    CurrentObjects[Object] = true

                    CreateESP(Object)

                    local ESP = ESPObjects[Object]

                    if ESP then

                        ESP.Label.Text = string.format(
                            "GOLD | %d studs",
                            math.floor(Distance)
                        )

                    end
                end
            end
        end
    end

    -- Remove outdated ESP objects.
    for Object in pairs(ESPObjects) do

        if not CurrentObjects[Object] then
            RemoveESP(Object)
        end
    end
end

