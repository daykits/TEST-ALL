end)
createInfo(homeTab.Page, "Phím RightShift: ẩn/hiện menu. Kéo thanh tiêu đề để di chuyển cửa sổ.")

--// Gold Assist
createSection(assistTab.Page, "Gold Detector & Assist")
createInfo(assistTab.Page, "Detector hiển thị vật phẩm gần nhất, khoảng cách và hướng trên màn hình. Không tự di chuyển hoặc tự nhặt vật phẩm.")
createToggle(assistTab.Page, "Bật Gold Detector", false, function(enabled)
    State.Detector = enabled
    if enabled then scanGold() end
    updateDetector()
    notify("Gold Detector", enabled and "Đã bật detector." or "Đã tắt detector.")
end)
createButton(assistTab.Page, "◎  Quét vàng ngay", function()
    local found = scanGold()
    updateESP()
    updateDetector()
    notify("Đã quét", "Tìm thấy " .. #found .. " vật phẩm trong phạm vi.")
end)
createInfo(assistTab.Page, "Lưu ý: tên/tag vật phẩm tùy thuộc cấu trúc của experience. Mặc định nhận diện tag Gold hoặc tên chứa gold/coin/nugget/ingot/bullion.")

--// Gold ESP
createSection(espTab.Page, "Gold ESP")
createInfo(espTab.Page, "ESP chỉ đánh dấu vật phẩm vàng mà LocalScript nhìn thấy trong Workspace. Highlight dùng chế độ Occluded.")
createToggle(espTab.Page, "Bật Gold ESP", false, function(enabled)
    State.ESP = enabled
    if enabled then
        scanGold()
        updateESP()
        notify("Gold ESP", "Đã bật đánh dấu vật phẩm phù hợp.")
    else
        updateESP()
        notify("Gold ESP", "Đã tắt và dọn dấu ESP.")
    end
end)
createToggle(espTab.Page, "Hiển thị khoảng cách", true, function(enabled)
    State.ShowDistance = enabled
    updateESP()
end)

--// Settings
createSection(settingsTab.Page, "Scan settings")
createSlider(settingsTab.Page, "Scan range (studs)", 50, 1000, CONFIG.ScanRange, function(value)
    CONFIG.ScanRange = value
    scanGold()
    updateESP()
    updateDetector()
end)
createSlider(settingsTab.Page, "Scan interval (seconds)", 1, 5, CONFIG.ScanInterval, function(value)
    CONFIG.ScanInterval = value
end)
createSection(settingsTab.Page, "Appearance")
createButton(settingsTab.Page, "Đổi màu giao diện: " .. palettes[paletteIndex][3], function()
    local nextIndex = (paletteIndex % #palettes) + 1
    applyAccent(nextIndex)
    HeaderGradient.Color = ColorSequence.new(Theme.Accent, Theme.Accent2)
    notify("Theme", "Đã chuyển sang " .. palettes[nextIndex][3])
end)
createToggle(settingsTab.Page, "Giảm hiệu ứng chuyển động", false, function(enabled)
    State.ReduceMotion = enabled
end)
createToggle(settingsTab.Page, "Hiển thị thông báo", true, function(enabled)
    State.ShowNotifications = enabled
end)
createButton(settingsTab.Page, "Dọn toàn bộ ESP", function()
    for object in pairs(espObjects) do removeESP(object) end
    notify("ESP", "Đã dọn các dấu ESP.")
end)

--// Select first tab
homeTab.Page.Visible = true
homeTab.Button.BackgroundColor3 = Theme.Accent
homeTab.Button.BackgroundTransparency = 0
homeTab.Icon.TextColor3 = Theme.Text
homeTab.Label.TextColor3 = Theme.Text
activeTab = homeTab

--// Drag window
local dragging, dragInput, dragStart, startPosition = false, nil, nil, nil
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = Main.Position
        dragInput = input
    end
end)
connect(UserInputService.InputChanged, function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
end)
connect(UserInputService.InputEnded, function(input)
    if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        dragInput = nil
    end
end)

--// Minimize / close
local minimized = false
local expandedSize = UDim2.fromOffset(CONFIG.WindowSize.X, CONFIG.WindowSize.Y)
MinimizeButton.Activated:Connect(function()
    minimized = not minimized
    Sidebar.Visible = not minimized
    Content.Visible = not minimized
    tween(Main, 0.2, { Size = minimized and UDim2.fromOffset(CONFIG.WindowSize.X, 54) or expandedSize })
    MinimizeButton.Text = minimized and "□" or "—"
end)

local function cleanup()
    if not alive then return end
    alive = false
    for object in pairs(espObjects) do removeESP(object) end
    for _, connection in ipairs(connections) do
        if connection.Connected then connection:Disconnect() end
    end
    if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
end

CloseButton.Activated:Connect(cleanup)
connect(UserInputService.InputBegan, function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        Main.Visible = not Main.Visible
    end
end)
connect(ScreenGui.Destroying, function()
    if alive then
        alive = false
        for object in pairs(espObjects) do removeESP(object) end
        for _, connection in ipairs(connections) do
            if connection.Connected then connection:Disconnect() end
        end
    end
end)

--// Main scan loop
local lastScan = 0
task.spawn(function()
    while alive and ScreenGui.Parent do
        if os.clock() - lastScan >= CONFIG.ScanInterval then
            lastScan = os.clock()
            scanGold()
            updateESP()
            updateDetector()
        end
        task.wait(0.15)
    end
end)

--// Intro
Main.Size = UDim2.fromOffset(0, 0)
tween(Main, 0.35, { Size = expandedSize })
notify("Nebula Gold Hub", "Đã tải giao diện. RightShift để ẩn/hiện menu.")
print("[Nebula Gold Hub] Loaded successfully")
