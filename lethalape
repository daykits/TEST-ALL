-- Hiệu ứng kéo thả
local dragging, dragInput, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ==========================================
-- 2. CHỨC NĂNG TẠO NÚT (Toggle & Button)
-- ==========================================
local function CreateButton(text, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 28)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.AutoButtonColor = false
    btn.Parent = MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        -- Hiệu ứng click
        btn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
        task.wait(0.1)
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        callback()
    end)
    return btn
end

-- ==========================================
-- 3. LOGIC CHỨC NĂNG
-- ==========================================
local isNoclip = false
local noclipConn = nil
local isFloating = false

local function GetCharacterParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

-- Chức năng Noclip
local function ToggleNoclip()
    isNoclip = not isNoclip
    
    if isNoclip then
        if not noclipConn then
            noclipConn = RunService.Stepped:Connect(function()
                local char = GetCharacterParts()
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
            local char = GetCharacterParts()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end
end

-- Chức năng Lơ lửng (Float)
local function SetFloat(state)
    local _, _, hrp = GetCharacterParts()
    if not hrp then return end
    
    isFloating = state
    if state then
        if not hrp:FindFirstChild("HoverBodyPosition") then
            local bp = Instance.new("BodyPosition")
            bp.Name = "HoverBodyPosition"
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.Position = hrp.Position
            bp.Parent = hrp
        end
    else
        local bp = hrp:FindFirstChild("HoverBodyPosition")
        if bp then bp:Destroy() end
    end
end

-- Chức năng Dịch chuyển
local function TeleportToCoords()
    local _, _, hrp = GetCharacterParts()
    if not hrp then return end
    
    -- Dịch chuyển
    hrp.CFrame = CFrame.new(targetPosition)
    
    -- Nếu đang bật float thì cập nhật vị trí float
    if isFloating then
        SetFloat(false)
        task.wait(0.1)
        SetFloat(true)
    end
end

-- ==========================================
-- 4. KHỞI TẠO NÚT BẤM
-- ==========================================
CreateButton("1. Teleport Đến Tọa Độ", 35, function()
    TeleportToCoords()
end)

