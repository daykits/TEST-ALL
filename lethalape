    create("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 7),
        Size = UDim2.new(1, -24, 0, 22), Font = Enum.Font.GothamBold,
        Text = title, TextColor3 = Theme.Text, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21,
    }, toast)
    create("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 29),
        Size = UDim2.new(1, -24, 0, 28), Font = Enum.Font.Gotham,
        Text = message, TextColor3 = Theme.Muted, TextSize = 11,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21,
    }, toast)
    toast.BackgroundTransparency = 1
    tween(toast, 0.18, { BackgroundTransparency = 0 })
    task.delay(2.6, function()
        if toast.Parent then
            tween(toast, 0.18, { BackgroundTransparency = 1 })
            task.wait(0.2)
            if toast.Parent then toast:Destroy() end
        end
    end)
end

