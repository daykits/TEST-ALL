    }, frame)
    local bar = create("Frame", {
        Position = UDim2.new(0, 11, 0, 37), Size = UDim2.new(1, -22, 0, 6),
        BackgroundColor3 = Theme.Off, BorderSizePixel = 0,
    }, frame)
    corner(bar, 3)
    local ratio = (value - minValue) / (maxValue - minValue)
    local fill = create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0), BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 3)
    registerAccent(fill, "BackgroundColor3")
    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(ratio, 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Theme.Text, BorderSizePixel = 0,
    }, bar)
    corner(knob, 7)
    local dragging = false
    local function setFromX(x)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
        value = math.floor(minValue + (maxValue - minValue) * alpha + 0.5)
        valueLabel.Text = tostring(value)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        if callback then callback(value) end
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return { Frame = frame, Get = function() return value end }
end

--// Gold detection
local function getRootPart(object)
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then
        return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function getWorldPosition(object)
    if object:IsA("Model") then return object:GetPivot().Position end
    local part = getRootPart(object)
    return part and part.Position or nil
end

local function isGold(object)
    if not object or object == LocalPlayer.Character then return false end
    local ok, tagged = pcall(function()
        return CollectionService:HasTag(object, CONFIG.GoldTag)
    end)
    if ok and tagged then return true end
    local name = string.lower(object.Name)
    for _, keyword in ipairs(CONFIG.Keywords) do
        if string.find(name, keyword, 1, true) then return true end
    end
    return false
end

local function getDistance(position)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not position then return math.huge end
    return (root.Position - position).Magnitude
end

local function scanGold()
    local found, seen = {}, {}
    local descendants = Workspace:GetDescendants()
    for _, instance in ipairs(descendants) do
        if (instance:IsA("Model") or instance:IsA("BasePart")) and isGold(instance) then
            local candidate = instance
            if instance:IsA("BasePart") then
                local model = instance:FindFirstAncestorOfClass("Model")
                if model and isGold(model) then candidate = model end
            end
            if not seen[candidate] then
                seen[candidate] = true
                local position = getWorldPosition(candidate)
                local distance = getDistance(position)
                if position and distance <= CONFIG.ScanRange then
                    table.insert(found, { Object = candidate, Position = position, Distance = distance })
                end
            end
        end
    end
    table.sort(found, function(a, b) return a.Distance < b.Distance end)
    goldItems = found
    return found
end

--// ESP
local function removeESP(object)
    local data = espObjects[object]
    if not data then return end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    espObjects[object] = nil
end

local function addESP(object, distance)
    if not object or not object.Parent then return end
    local root = getRootPart(object)
    if not root then return end
    local data = espObjects[object]
    if not data then
        local highlight = create("Highlight", {
            Name = "NebulaGoldHighlight", Adornee = object,
            FillColor = Theme.Accent2, OutlineColor = Theme.Accent,
            FillTransparency = 0.55, OutlineTransparency = 0.05,
            DepthMode = Enum.HighlightDepthMode.Occluded,
        }, ScreenGui)
        local billboard = create("BillboardGui", {
            Name = "NebulaGoldLabel", Adornee = root,
            Size = UDim2.fromOffset(160, 30), StudsOffset = Vector3.new(0, 2.5, 0),
            AlwaysOnTop = false, MaxDistance = CONFIG.ScanRange,
        }, ScreenGui)
        local label = create("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(255, 210, 80),
            TextStrokeTransparency = 0.25, TextSize = 12, Text = "GOLD",
        }, billboard)
        data = { Highlight = highlight, Billboard = billboard, Label = label }
        espObjects[object] = data
    else
        data.Highlight.Adornee = object
        data.Billboard.Adornee = root
    end
    data.Label.Text = State.ShowDistance and ("GOLD  [" .. math.floor(distance) .. " studs]") or "GOLD"
end

local function updateESP()
    if not State.ESP then
        for object in pairs(espObjects) do removeESP(object) end
        return
    end
    local current = {}
    local count = 0
    for _, item in ipairs(goldItems) do
        if count >= CONFIG.MaxESPObjects then break end
        if item.Object and item.Object.Parent then
            current[item.Object] = true
            addESP(item.Object, item.Distance)
            count += 1
        end
    end
    for object in pairs(espObjects) do
        if not current[object] then removeESP(object) end
    end
end

