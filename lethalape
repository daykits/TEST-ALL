local function getDirection(position)
    local camera = Workspace.CurrentCamera
    if not camera or not position then return "UNKNOWN" end
    local screenPosition, onScreen = camera:WorldToViewportPoint(position)
    if screenPosition.Z <= 0 then return "BEHIND" end
    if not onScreen then
        if screenPosition.X < 0 then return "LEFT" end
        if screenPosition.X > camera.ViewportSize.X then return "RIGHT" end
        return screenPosition.Y < 0 and "ABOVE" or "BELOW"
    end
    local center = camera.ViewportSize / 2
    local delta = Vector2.new(screenPosition.X - center.X, screenPosition.Y - center.Y)
    if delta.Magnitude < 55 then return "AHEAD" end
    if math.abs(delta.X) > math.abs(delta.Y) then return delta.X > 0 and "RIGHT" or "LEFT" end
    return delta.Y > 0 and "DOWN" or "UP"
end

local function updateDetector()
