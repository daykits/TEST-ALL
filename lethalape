local assistTab = createTab("Gold Assist", "◎")
local espTab = createTab("Gold ESP", "◉")
local settingsTab = createTab("Cài đặt", "⚙")

--// Home
createSection(homeTab.Page, "Lethal Ape Gold Hub")
createInfo(homeTab.Page, "Nebula interface đã được tích hợp trực tiếp. Bật Detector để xem vàng gần nhất và hướng tương đối.")
local statusInfo = createInfo(homeTab.Page, "Trạng thái: Sẵn sàng | Vật phẩm vàng: 0")
