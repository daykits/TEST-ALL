-- 3. CHỨC NĂNG ESP TEAM
-- ==========================================
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "TeamESP"
ESPFolder.Parent = CoreGui

local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local espBox = Instance.new("BoxHandleAdornment")
    espBox.Name = player.Name .. "_ESP"
    espBox.Adornee = nil
    espBox.AlwaysOnTop = true
    espBox.ZIndex = 10
    espBox.Size = Vector3.new(4, 5, 1)
    espBox.Transparency = 0.5
    espBox.Color3 = Color3.fromRGB(0, 255, 0) -- Màu xanh lá
    espBox.Parent = ESPFolder

    local espName = Instance.new("BillboardGui")
    espName.Name = player.Name .. "_NameESP"
    espName.AlwaysOnTop = true
    espName.Size = UDim2.new(0, 200, 0, 50)
    espName.StudsOffset = Vector3.new(0, 3, 0)
    espName.Adornee = nil
    espName.Parent = ESPFolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    textLabel.TextStrokeTransparency = 0
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 14
    textLabel.Text = player.Name
    textLabel.Parent = espName

    task.spawn(function()
        while espEnabled and player.Parent do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                espBox.Adornee = hrp
                espName.Adornee = hrp
                
                local distance = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart").Position - hrp.Position).Magnitude or 0)
                textLabel.Text = string.format("%s [%dm]", player.Name, distance)
                
                -- Đổi màu địch (Đỏ) - đồng minh (Xanh)
                local isEnemy = (LocalPlayer.Team ~= nil and player.Team ~= nil and LocalPlayer.Team ~= player.Team)
                local color = isEnemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 0)
                espBox.Color3 = color
                textLabel.TextColor3 = color
            else
                espBox.Adornee = nil
                espName.Adornee = nil
            end
            task.wait(0.5)
        end
        espBox:Destroy()
        espName:Destroy()
    end)
end

local function ToggleESP(state)
    espEnabled = state
    if state then
        for _, player in ipairs(Players:GetPlayers()) do CreateESP(player) end
        Players.PlayerAdded:Connect(function(p) if espEnabled then CreateESP(p) end end)
    else
        for _, obj in ipairs(ESPFolder:GetChildren()) do obj:Destroy() end
    end
end

-- ==========================================
-- 4. LOGIC AUTO TEAM
-- ==========================================
local lastTeam = nil
local lastAutoTween = 0

RunService.Heartbeat:Connect(function()
    if not autoTeamEnabled then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    
    local currentTeam = LocalPlayer.Team
    
    -- 1. NẾU LÀ TEAM TRỐNG (NEUTRAL)
    if not currentTeam then
        if lastTeam ~= nil or lastTeam == nil then -- Check lần đầu
            lastTeam = nil
            if (hrp.Position - skyPosition).Magnitude > 50 then
                -- Bay lên trời và lơ lửng
                TweenToPosition(skyPosition, 5)
                SetFloat(true)
                lastTeam = "Neutral"
            end
        end
    else
        -- 2. NẾU CÓ TEAM (ĐI TÌM ĐỊCH)
        if lastTeam ~= currentTeam then
            lastTeam = currentTeam
            SetFloat(false) -- Tắt lơ lửng vì phải combat
        end
        
        -- Tự động tìm người chơi team địch gần nhất
        local closestEnemy = nil
        local shortestDist = math.huge
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Team and plr.Team ~= LocalPlayer.Team then
                local eChar = plr.Character
                local eHrp = eChar and eChar:FindFirstChild("HumanoidRootPart")
                local eHum = eChar and eChar:FindFirstChildOfClass("Humanoid")
                
                if eHrp and eHum and eHum.Health > 0 then
                    local dist = (hrp.Position - eHrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestEnemy = eHrp
                    end
                end
            end
        end
        
        -- Nếu tìm thấy địch và cách xa hơn 15 studs -> Bay tới
        if closestEnemy and shortestDist > 15 and tick() - lastAutoTween > 3 then
            lastAutoTween = tick()
            TweenToPosition(closestEnemy.Position + Vector3.new(0, 5, 0), 2) -- Bay tới vị trí địch (nhích lên 5 studs)
        end
    end
end)

