end)

local btnFloat = CreateButton("Float (Lơ Lửng): OFF", 105, function()
    SetFloat(not isFloating)
    btnFloat.Text = "Float (Lơ Lửng): " .. (isFloating and "ON" or "OFF")
    btnFloat.TextColor3 = isFloating and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 255, 255)
end)

-- Tự động dọn dẹp khi nhân vật chết để tránh lỗi
LocalPlayer.CharacterAdded:Connect(function()
    isFloating = false
    btnFloat.Text = "Float (Lơ Lửng): OFF"
    btnFloat.TextColor3 = Color3.fromRGB(255, 255, 255)
end)
