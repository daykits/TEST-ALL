-- Hàm Float
function SetFloat(state)
    local _, _, hrp = GetCharacterParts()
    if not hrp then return end
    isFloating = state
    if state then
        if not hrp:FindFirstChild("HoverBodyPosition") then
            local bp = Instance.new("BodyPosition")
            bp.Name = "HoverBodyPosition"
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.Position = hrp.Position
            bp.Parent = hrp
        end
    else
        local bp = hrp:FindFirstChild("HoverBodyPosition")
        if bp then bp:Destroy() end
    end
end

-- Hàm Tween
function TweenToPosition(targetPos, duration)
    local _, _, hrp = GetCharacterParts()
    if not hrp then return end
    if activeTween then activeTween:Cancel() end
    if isFloating then SetFloat(false) end
    local targetCFrame = CFrame.new(targetPos)
    local tweenInfo = TweenInfo.new(duration or 3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    activeTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    activeTween:Play()
    activeTween.Completed:Connect(function()
        if isFloating and autoTeamEnabled then SetFloat(true) end
        activeTween = nil
    end)
end

-- Hàm Teleport
function InstantTeleport(targetPos)
    local _, _, hrp = GetCharacterParts()
    if not hrp then return end
    if activeTween then activeTween:Cancel() end
    SetFloat(false)
    hrp.CFrame = CFrame.new(targetPos)
end

-- ESP Team Logic
local function CreateESP(player)
    if player == LocalPlayer then return end
    local espBox = Instance.new("BoxHandleAdornment")
    espBox.Name = player.Name .. "_ESP"
    espBox.Adornee = nil
    espBox.AlwaysOnTop = true
    espBox.ZIndex = 10
    espBox.Size = Vector3.new(4, 5, 1)
    espBox.Transparency = 0.5
    espBox.Color3 = Color3.fromRGB(0, 255, 0)
    espBox.Parent = ESPFolder

    local espName = Instance.new("BillboardGui")
    espName.Name = player.Name .. "_NameESP"
    espName.AlwaysOnTop = true
    espName.Size = UDim2.new(0, 200, 0, 50)
    espName.StudsOffset = Vector3.new(0, 3, 0)
    espName.Adornee = nil
    espName.Parent = ESPFolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    textLabel.TextStrokeTransparency = 0
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 14
    textLabel.Text = player.Name
    textLabel.Parent = espName

    task.spawn(function()
        while espEnabled and player.Parent do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                espBox.Adornee = hrp
                espName.Adornee = hrp
                local distance = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart").Position - hrp.Position).Magnitude or 0)
                textLabel.Text = string.format("%s [%dm]", player.Name, distance)
                local isEnemy = (LocalPlayer.Team ~= nil and player.Team ~= nil and LocalPlayer.Team ~= player.Team)
                local color = isEnemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 120)
                espBox.Color3 = color
                textLabel.TextColor3 = color
            else
                espBox.Adornee = nil
                espName.Adornee = nil
            end
            task.wait(0.5)
        end
        espBox:Destroy()
        espName:Destroy()
    end)
end

function ToggleESP(state)
    espEnabled = state
    if state then
        for _, player in ipairs(Players:GetPlayers()) do CreateESP(player) end
        Players.PlayerAdded:Connect(function(p) if espEnabled then CreateESP(p) end end)
    else
        for _, obj in ipairs(ESPFolder:GetChildren()) do obj:Destroy() end
    end
end

-- Auto Team Logic
local lastTeam = nil
local lastAutoTween = 0
RunService.Heartbeat:Connect(function()
    if not autoTeamEnabled then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local currentTeam = LocalPlayer.Team
    if not currentTeam then
        if lastTeam ~= "Neutral" then
            lastTeam = "Neutral"
            if (hrp.Position - skyPosition).Magnitude > 50 then
                local hasObstacle = false
                local rayOrigin = skyPosition + Vector3.new(0, 50, 0)
                local rayDirection = Vector3.new(0, -100, 0)
                local raycastParams = RaycastParams.new()
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
                
                local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
                if result and result.Instance then
                    local color = result.Instance.Color
                    if color.R > 0.6 and color.G > 0.6 and color.B < 0.4 then
                        hasObstacle = true
                    end
                end
                
                local targetPos = hasObstacle and skyPositionAlt or skyPosition
                TweenToPosition(targetPos, 5)
                SetFloat(true)
            end
        end
    else
        if lastTeam ~= currentTeam then
            lastTeam = currentTeam
            SetFloat(false)
        end
        local closestEnemy = nil
        local shortestDist = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Team and plr.Team ~= LocalPlayer.Team then
                local eChar = plr.Character
                local eHrp = eChar and eChar:FindFirstChild("HumanoidRootPart")
                local eHum = eChar and eChar:FindFirstChildOfClass("Humanoid")
                if eHrp and eHum and eHum.Health > 0 then
                    local dist = (hrp.Position - eHrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestEnemy = eHrp
                    end
                end
            end
        end
        if closestEnemy and shortestDist > 15 and tick() - lastAutoTween > 1 then
            lastAutoTween = tick()
            InstantTeleport(closestEnemy.Position + Vector3.new(0, 3, 0))
        end
    end
end)

