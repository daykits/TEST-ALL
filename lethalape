-- 2. BIẾN TOÀN CỤC & CHỨC NĂNG CƠ BẢN
-- ==========================================
local isNoclip = false
local noclipConn = nil
local isFloating = false
local activeTween = nil
local autoTeamEnabled = false
local espEnabled = false

local function GetCharacterParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

-- Noclip
local function ToggleNoclip()
    isNoclip = not isNoclip
    if isNoclip then
        if not noclipConn then
            noclipConn = RunService.Stepped:Connect(function()
                local char = GetCharacterParts()
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
            local char = GetCharacterParts()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end
    end
end

-- Float
local function SetFloat(state)
    local _, _, hrp = GetCharacterParts()
    if not hrp then return end
    
    isFloating = state
    if state then
        if not hrp:FindFirstChild("HoverBodyPosition") then
            local bp = Instance.new("BodyPosition")
            bp.Name = "HoverBodyPosition"
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.Position = hrp.Position
            bp.Parent = hrp
        end
    else
        local bp = hrp:FindFirstChild("HoverBodyPosition")
        if bp then bp:Destroy() end
    end
end

-- Tween đến tọa độ
local function TweenToPosition(targetPos, duration)
    local _, _, hrp = GetCharacterParts()
    if not hrp then return end
    
    if activeTween then activeTween:Cancel() end
    if isFloating then SetFloat(false) end

    local targetCFrame = CFrame.new(targetPos)
    local tweenInfo = TweenInfo.new(duration or 3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    activeTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    activeTween:Play()
    
    activeTween.Completed:Connect(function()
        if isFloating and autoTeamEnabled then
            SetFloat(true) -- Nếu ở trên trời thì bật lại float
        end
        activeTween = nil
    end)
end

