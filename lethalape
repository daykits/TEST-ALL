--==================================================
-- 11. FIND NEAREST GOLD
--==================================================

local function GetNearestGold()

    local Nearest = nil
    local NearestDistance = math.huge

    for _, Data in ipairs(GoldObjects) do

        local Object = Data.Object

        if Object and Object.Parent then

            local Position = GetObjectPosition(Object)

            if Position then

                local Distance = GetDistance(Position)

                if Distance < NearestDistance then

                    NearestDistance = Distance

                    Nearest = {
                        Object = Object,
                        Position = Position,
                        Distance = Distance
                    }

                end
            end
        end
    end

    return Nearest
end

--==================================================
-- 12. DIRECTION ASSIST
--==================================================

local function GetDirection(Position)

    local Camera = Workspace.CurrentCamera

    if not Camera or not Position then
        return "UNKNOWN"
    end

    local ScreenPosition, OnScreen =
        Camera:WorldToViewportPoint(Position)

    if ScreenPosition.Z <= 0 then
        return "BEHIND YOU"
    end

    if not OnScreen then

        if ScreenPosition.X < 0 then
            return "LEFT"
        elseif ScreenPosition.X > Camera.ViewportSize.X then
            return "RIGHT"
        end

        if ScreenPosition.Y < 0 then
            return "ABOVE"
        else
            return "BELOW"
        end
    end

    local Center = Camera.ViewportSize / 2

    local Difference = Vector2.new(
        ScreenPosition.X - Center.X,
        ScreenPosition.Y - Center.Y
    )

    if Difference.Magnitude < 60 then
        return "AHEAD"
    end

    if math.abs(Difference.X) > math.abs(Difference.Y) then

        return Difference.X > 0 and "RIGHT" or "LEFT"

    else

        return Difference.Y > 0 and "DOWN" or "UP"

    end
end

--==================================================
-- 13. UPDATE DETECTOR
--==================================================

local function UpdateDetector()

    HUD.Enabled = Config.DetectorEnabled

    if not Config.DetectorEnabled then
        return
    end

    local Nearest = GetNearestGold()

    if not Nearest then

        DetectorLabel.Text =
            "GOLD DETECTOR\nNo gold detected nearby"

        return
    end

    local Direction = GetDirection(Nearest.Position)

    DetectorLabel.Text = string.format(
        "GOLD DETECTOR\n%s | %d studs | %s",
        Nearest.Object.Name,
        math.floor(Nearest.Distance),
        Direction
    )
end

