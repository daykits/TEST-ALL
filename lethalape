        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    local valueLabel = create("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(1, -65, 0, 5),
        Size = UDim2.fromOffset(54, 20), Font = Enum.Font.GothamBold,
        Text = tostring(value), TextColor3 = Theme.Accent2, TextSize = 12,
