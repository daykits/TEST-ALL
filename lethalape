    if not State.Detector then return end
    local nearest = goldItems[1]
    if not nearest then
        DetectorText.Text = "GOLD DETECTOR\nNo matching gold item found in scan range"
        return
    end
    DetectorText.Text = string.format("GOLD DETECTOR\n%s  |  %d studs  |  %s",
        nearest.Object.Name, math.floor(nearest.Distance), getDirection(nearest.Position))
end

