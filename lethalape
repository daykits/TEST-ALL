--==================================================
-- 18. MAIN UPDATE LOOP
--==================================================

task.spawn(function()

    while Running do

        local CurrentTime = os.clock()

        if CurrentTime - LastScan >= Config.ScanInterval then

            LastScan = CurrentTime

            ScanGold()
            UpdateESP()
        end

        UpdateDetector()

        task.wait(0.2)
    end

end)

