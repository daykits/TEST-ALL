-- ============================================
-- MENU RAYFIELD - AUTO FARM VÀNG
-- ============================================

-- 1. Tải thư viện Rayfield
local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Rayfield/main/source'))()

-- 2. Khởi tạo cửa sổ Menu
local Window = Rayfield:CreateWindow({
    Name = "CHAT GPT",
    LoadingTitle = "Đang tải menu...",
    LoadingSubtitle = "by OPEN AI",
    ConfigurationSaving = {
        Enabled = false,
        FolderName = nil,
        FileName = "AutoFarmConfig"
    },
    KeySystem = false
})

-- 3. Tạo Tab
local FarmTab = Window:CreateTab("Auto Farm", 4483362458) -- Icon mặc định
local SettingsTab = Window:CreateTab("Cài đặt", 4483362458)

-- ============================================
-- 4. LOGIC CHÍNH (Giữ nguyên từ script cũ)
-- ============================================
local Workspace        = game:GetService("Workspace")
local Players          = game:GetService("Players")
local VirtualInput     = game:GetService("VirtualInputManager")
local LocalPlayer      = Players.LocalPlayer

getgenv().InstantPickup   = true
getgenv().AutoPressE      = true
getgenv().AutoPressDelay  = 0.05
getgenv().AutoPressRadius = 15

-- Tọa độ từ ảnh của bạn
local TARGET_POS = Vector3.new(-176.29, 310.18, -514.13)

local function makeInstant(prompt)
    if not getgenv().InstantPickup then return end
    if prompt:IsA("ProximityPrompt") then
        pcall(function()
            prompt.HoldDuration         = 0
            prompt.RequiresLineOfSight  = false
        end)
    end
end

local function scanAll()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        makeInstant(obj)
    end
end

local function pressE()
    pcall(function()
        VirtualInput:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function firePrompt(prompt)
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        elseif prompt and prompt.Triggered then
            prompt:InputHoldBegin()
        end
    end)
end

-- Vòng lặp auto nhặt
task.spawn(function()
    while task.wait(getgenv().AutoPressDelay) do
        if not getgenv().AutoPressE then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        for _, prompt in ipairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function()
                    local parent = prompt.Parent
                    if parent and parent:IsA("BasePart") then
                        local dist = (parent.Position - root.Position).Magnitude
                        if dist <= getgenv().AutoPressRadius then
                            pressE()
                            firePrompt(prompt)
                        end
                    end
                end)
            end
        end
    end
end)

-- Theo dõi prompt mới
Workspace.DescendantAdded:Connect(function(obj)
    makeInstant(obj)
    if obj:IsA("ProximityPrompt") then
        obj:GetPropertyChangedSignal("HoldDuration"):Connect(function()
            if getgenv().InstantPickup and obj.HoldDuration ~= 0 then
                obj.HoldDuration = 0
            end
        end)
    end
end)

-- ============================================
-- 5. GIAO DIỆN TAB FARM
-- ============================================

local function TeleportToTarget()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(TARGET_POS)
        Rayfield:Notify({
            Title = "Teleport",
            Content = "Đã đến tọa độ farm vàng!",
            Duration = 3,
            Image = 4483362458
        })
    else
        Rayfield:Notify({
            Title = "Lỗi",
            Content = "Không tìm thấy nhân vật!",
            Duration = 3,
            Image = 4483362458
        })
    end
end

-- Nút Teleport & Bật Auto Farm
FarmTab:CreateButton({
    Name = "Teleport & Farm Vàng",
    Callback = function()
        TeleportToTarget()
        getgenv().AutoPressE = true
        getgenv().InstantPickup = true
    end,
})

-- Nút bật/tắt Auto Press E
FarmTab:CreateToggle({
    Name = "Auto Press E",
    CurrentValue = true,
    Flag = "AutoPressE",
    Callback = function(Value)
        getgenv().AutoPressE = Value
    end,
})

-- Nút bật/tắt Instant Pickup
FarmTab:CreateToggle({
    Name = "Instant Pickup",
    CurrentValue = true,
    Flag = "InstantPickup",
    Callback = function(Value)
        getgenv().InstantPickup = Value
        if Value then scanAll() end
    end,
})

-- Thanh trượt chỉnh bán kính
FarmTab:CreateSlider({
    Name = "Bán kính nhặt (Studs)",
    Range = {5, 50},
    Increment = 1,
    Suffix = " studs",
    CurrentValue = 15,
    Flag = "Radius",
    Callback = function(Value)
        getgenv().AutoPressRadius = Value
    end,
})

-- ============================================
-- 6. KHỞI TẠO XONG
-- ============================================
Rayfield:LoadConfiguration()

Rayfield:Notify({
    Title = "Menu Đã Tải",
    Content = "Chọn tab Auto Farm và bấm nút để bắt đầu!",
    Duration = 5,
    Image = 4483362458
})
