local rarityColors = {
    ["Mythical Chest"]  = Color3.fromRGB(255, 50, 255),
    ["Legendary Chest"] = Color3.fromRGB(255, 215, 0),
}

local function looksLikeChest(obj)
    if not obj then return false end
    local ln = string.lower(obj.Name or "")
    if ln:find("chest") then return true end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local t = string.lower(d.ObjectText or "")
            if t:find("legendary chest") or t:find("mythical chest") then return true end
        end
    end
    return false
end

local function getChestRarity(obj)
    if not obj then return nil end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            if d.ObjectText == "Legendary Chest" then return "Legendary Chest" end
            if d.ObjectText == "Mythical Chest" then return "Mythical Chest" end
        end
    end
    return nil
end

local function createChestESP(container)
    if not container or not container.Parent then return end
    if H.chestHighlights[container] then return end
    if not looksLikeChest(container) then return end
    local rarity = getChestRarity(container)
    if not rarity then return end
    if not H.miscSelectedChests[rarity] then return end

    local root = container:IsA("Model") and (container.PrimaryPart or container:FindFirstChildWhichIsA("BasePart", true)) or container:FindFirstChildWhichIsA("BasePart", true)
    if not root then return end

    local hl = Instance.new("SelectionBox")
    hl.Name = "_ChestHL"
    hl.Adornee = root
    hl.Color3 = rarityColors[rarity] or Color3.new(1,1,1)
    hl.LineThickness = 0.05
    hl.SurfaceTransparency = 0.85
    hl.SurfaceColor3 = rarityColors[rarity] or Color3.new(1,1,1)
    hl.Parent = CoreGui

    H.chestHighlights[container] = { highlight = hl, part = root, rarity = rarity }
end

local function clearChestESP()
    for container, data in pairs(H.chestHighlights) do
        if data.highlight then data.highlight:Destroy() end
    end
    H.chestHighlights = {}
end

local function refreshChestESP()
    clearChestESP()
    if not H.chestESPEnabled then return end
    local effects = workspace:FindFirstChild("Effects")
    if not effects then return end
    for _, child in ipairs(effects:GetChildren()) do
        createChestESP(child)
        for _, sub in ipairs(child:GetDescendants()) do
            if looksLikeChest(sub) then createChestESP(sub) end
        end
    end
end
