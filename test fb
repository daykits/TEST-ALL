H.run_svc.RenderStepped:Connect(function()
    local enabled = espSettings.master_switch
    for name, d in pairs(espObjects) do
        if not enabled or not d.player or not d.player.Parent then
            d.box.Visible = false
            d.nameLabel.Visible = false
            d.healthBg.Visible = false
        else
            local char = d.player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                d.box.Visible = false
                d.nameLabel.Visible = false
                d.healthBg.Visible = false
            else
                local sp, onScreen = camera:WorldToViewportPoint(hrp.Position)
                if not onScreen then
                    d.box.Visible = false
                    d.nameLabel.Visible = false
                    d.healthBg.Visible = false
                else
                    local dist = (camera.CFrame.Position - hrp.Position).Magnitude
                    local h = math.clamp(7500 / dist, 20, 500)
                    local w = h * 0.5

                    if espSettings.boxes.enabled then
                        d.box.Visible = true
                        d.box.Size = UDim2.fromOffset(w, h)
                        d.box.Position = UDim2.fromOffset(sp.X - w/2, sp.Y - h/2)
                        d.stroke.Color = espSettings.boxes.color
                    else
                        d.box.Visible = false
                    end

                    if espSettings.names.enabled then
                        d.nameLabel.Visible = true
                        d.nameLabel.Text = d.player.Name
                        if espSettings.distance then
                            d.nameLabel.Text = d.player.Name .. " [" .. math.floor(dist) .. "m]"
                        end
                        d.nameLabel.TextColor3 = espSettings.names.color
                        d.nameLabel.Size = UDim2.fromOffset(math.max(w + 60, 100), 16)
                        d.nameLabel.Position = UDim2.fromOffset(sp.X - d.nameLabel.Size.X.Offset/2, sp.Y - h/2 - 18)
                    else
                        d.nameLabel.Visible = false
                    end

                    if espSettings.health.enabled then
                        d.healthBg.Visible = true
                        d.healthBg.Size = UDim2.fromOffset(espSettings.health.thickness + 2, h)
                        d.healthBg.Position = UDim2.fromOffset(sp.X - w/2 - espSettings.health.thickness - 6, sp.Y - h/2)
                        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        d.healthFill.Size = UDim2.fromScale(1, ratio)
                        d.healthFill.Position = UDim2.new(0, 0, 1 - ratio, 0)
                        d.healthFill.BackgroundColor3 = Color3.fromHSV(ratio * 0.3, 1, 1)
                    else
                        d.healthBg.Visible = false
                    end
                end
            end
        end
    end
end)

