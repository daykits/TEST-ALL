local MACHINE_COLOR = Color3.fromRGB(0, 170, 255)

local function normalizeMachineName(txt)
    if type(txt) ~= "string" or txt == "" then return nil end
    txt = string.lower(txt)
    if txt:find("devil") and txt:find("fruit") then return "Devil Fruit"
    elseif txt:find("fight") and txt:find("style") then return "Fighting Style"
    elseif txt:find("weapon") then return "Weapons"
    elseif txt:find("armor") or txt:find("armour") then return "Armor"
    elseif txt:find("geppo") then return "Geppo"
    elseif txt:find("drink") or txt:find("cola") then return "Drinks"
    end
    return nil
end

local function detectMachine(obj)
    if not obj then return nil end
    local attrs = {
        obj:GetAttribute("VendingType"),
        obj:GetAttribute("itemName"),
        obj:GetAttribute("ItemName"),
        obj:GetAttribute("MachineName"),
        obj.Name,
    }
    for _, v in ipairs(attrs) do
        local d = normalizeMachineName(v)
        if d then return d end
    end
    for _, ch in ipairs(obj:GetDescendants()) do
        if ch:IsA("ProximityPrompt") then
            local d = normalizeMachineName(ch.ObjectText) or normalizeMachineName(ch.ActionText)
            if d then return d end
        elseif ch:IsA("TextLabel") then
            local d = normalizeMachineName(ch.Text)
            if d then return d end
        elseif ch:IsA("StringValue") then
            local d = normalizeMachineName(ch.Value)
            if d then return d end
        end
    end
    return nil
end

local function createMachineESP(obj)
    if not obj or not obj.Parent then return end
    if H.machineHighlights[obj] then return end
    local name = detectMachine(obj)
    if not name then return end

    local root = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)) or obj:FindFirstChildWhichIsA("BasePart", true)
    if not root then return end

    local hl = Instance.new("SelectionBox")
    hl.Name = "_MachineHL"
    hl.Adornee = root
    hl.Color3 = MACHINE_COLOR
    hl.LineThickness = 0.05
    hl.SurfaceTransparency = 0.8
    hl.SurfaceColor3 = MACHINE_COLOR
    hl.Parent = CoreGui

    H.machineHighlights[obj] = { highlight = hl, name = name, root = root }
end

local function clearMachineESP()
    for obj, data in pairs(H.machineHighlights) do
        if data.highlight then data.highlight:Destroy() end
    end
    H.machineHighlights = {}
end

local function refreshMachineESP()
    clearMachineESP()
    if not H.machineESPEnabled then return end
    local env = workspace:FindFirstChild("Env")
    if not env then return end
    for _, child in ipairs(env:GetChildren()) do
        createMachineESP(child)
    end
end
