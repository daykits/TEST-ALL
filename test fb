-- ============================================================
-- START / STOP
-- ============================================================
H.startKaitunFarm = function()
    if KT.isRunning then return end
    KT.isRunning = true
    getgenv().KaitunFarm = true
    KT.LoopID = KT.LoopID + 1
    H.autoAdsEnabled = true
    H.autoStatsEnabled = true
    H.noclipActive = true

    task.spawn(function()
        local isSea2 = game.PlaceId == 7465136166

        if isSea2 then
            Core.notify("Kaitun", "Sea 2 — starting farm", 5)
            local sea2 = Core.get("farm_sea2")
            if sea2 and sea2.start then
                sea2.start()
                while getgenv().Sea2Farm do
                    if Core.getLevel() >= 675 then
                        Core.notify("Kaitun", "Lvl 675 reached!", 6)
                        if sea2.stop then sea2.stop() end
                        break
                    end
                    task.wait(5)
                end
            end
        else
            KT.status = "farming"
            phase1_farm()
            if KT.isRunning then phase2_geppo() end
            if KT.isRunning then phase3_haki() end
            if KT.isRunning then phase4_worldscroll() end
            if KT.isRunning then phase5_mainmenu() end
        end

        H.DisableForwardKey = false
        KT.status = "done"
        KT.isRunning = false
        getgenv().KaitunFarm = false
        H.autoAdsEnabled = false
        H.autoStatsEnabled = false
    end)
end

H.stopKaitunFarm = function()
    getgenv().KaitunFarm = false
    KT.isRunning = false
    KT.status = "idle"
    H.autoAdsEnabled = false
    H.autoStatsEnabled = false
    H.DisableForwardKey = false
    local haki = Core.get("haki")
    if haki and haki.isRunning() and haki.stop then haki.stop() end
    local sea2 = Core.get("farm_sea2")
    if sea2 and sea2.isRunning() and sea2.stop then sea2.stop() end
end

Core.register("kaitun", {
    start = function() H.startKaitunFarm() end,
    stop = function() H.stopKaitunFarm() end,
    isRunning = function() return KT.isRunning end,
    getStatus = function() return KT.status end,
    setSea2Code = function(c) getgenv().KaitunSea2Code = c end,
})

