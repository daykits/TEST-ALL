-- ============================================================
-- WALKSPEED
-- ============================================================
local function stopWS()
    if H.walkspeedConn then H.walkspeedConn:Disconnect(); H.walkspeedConn = nil end
end

local function startWS()
    stopWS()
    H.walkspeedConn = H.run_svc.Heartbeat:Connect(function()
        if not H.walkspeedEnabled or H.walkspeedValue <= 16 then return end
        local char = H.lp.Character or H.getCharFolder()
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local rp  = char:FindFirstChild("HumanoidRootPart")
        if not hum or not rp or hum.Health <= 0 then return end

        local camCF = workspace.CurrentCamera.CFrame
        local dir = Vector3.zero
        if H.keys[H.KC_W] then dir = dir + camCF.LookVector end
        if H.keys[H.KC_S] then dir = dir - camCF.LookVector end
        if H.keys[H.KC_A] then dir = dir - camCF.RightVector end
        if H.keys[H.KC_D] then dir = dir + camCF.RightVector end
        dir = Vector3.new(dir.X, 0, dir.Z)

        local cv = rp.AssemblyLinearVelocity
        if dir.Magnitude > 0 then
            dir = dir.Unit
            rp.AssemblyLinearVelocity = Vector3.new(dir.X * H.walkspeedValue, cv.Y, dir.Z * H.walkspeedValue)
            hum:MoveTo(rp.Position + dir * 50)
        else
            hum:MoveTo(rp.Position)
            rp.AssemblyLinearVelocity = Vector3.new(0, cv.Y, 0)
        end
    end)
end

H.startWalkSpeed = startWS
H.stopWalkSpeed  = stopWS

