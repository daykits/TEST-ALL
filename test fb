local noclipParts = {}
local noclipChar = nil
local noclipRefresh = 0
local lastNoclip = 0

local NOCLIP_RESTORE = { LowerTorso = true, UpperTorso = true, HumanoidRootPart = true }

H.run_svc.Stepped:Connect(function()
    if not H.noclipActive then return end
    local now = tick()
    if now - lastNoclip < 0.05 then return end
    lastNoclip = now

    local folder = H.getCharFolder()
    if not folder then return end

    if folder ~= noclipChar or now - noclipRefresh >= 3 then
        noclipChar = folder
        noclipRefresh = now
        noclipParts = {}
        for _, p in ipairs(folder:GetDescendants()) do
            if p:IsA("BasePart") then noclipParts[#noclipParts + 1] = p end
        end
    end
    for i = 1, #noclipParts do
        local p = noclipParts[i]
        if p and p.Parent then p.CanCollide = false end
    end
end)

