                Vector3.new(8004.085, -2153.832, -17015.412),
                Vector3.new(8003.574, -2153.832, -17146.297),
                Vector3.new(7821.529, -2176.832, -17164.508),
                Vector3.new(7763.703, -2176.832, -17175.602),
            }
            for _, p in ipairs(wp) do
                if not getgenv().KaitunFarm then break end
                H.DoSafeTeleport(p)
                task.wait(0.1)
            end
            arrivedCave = true
            continue
        end

        -- Quest
        if not questJustTaken and qn ~= "Help becky" and lvl >= 190 then
            takeQuest()
            questJustTaken = true
            questTakenTime = tick()
        else
            local npcs = getAllNPCs("Fishman Karate User")
            local cy = CFrame.new(7736.441, -2176.832, -17308.871).Y + HOVER
            local centerCF = CFrame.new(7736.441, cy, -17308.871)

            if #npcs == 0 then
                if (rp.Position - centerCF.Position).Magnitude > 6 then
                    H.DoSafeTeleport(centerCF.Position)
                end
                task.wait(0.5); continue
            end

            if (rp.Position - centerCF.Position).Magnitude > 6 then
                H.DoSafeTeleport(centerCF.Position)
            end
            attackAll("Fishman Karate User", centerCF.Position)
        end
        task.wait(0.05)
    end
    H.DisableForwardKey = false
end

