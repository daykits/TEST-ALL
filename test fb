-- MODULE REGISTRY
-- ============================================================
Core.modules = {}

function Core.register(name, mod)
    Core.modules[name] = mod
    print("[Core] Module loaded: " .. tostring(name))
end

function Core.get(name)
    return Core.modules[name]
end

function Core.start(name, ...)
    local m = Core.modules[name]
    if not m or not m.start then
        Core.notify("Core", "Module '" .. tostring(name) .. "' not found or has no start()", 4)
        return false
    end
    local ok, err = pcall(m.start, ...)
    if not ok then
        Core.notify("Core", "start() error in '" .. tostring(name) .. "': " .. tostring(err), 5)
        return false
    end
    return true
end

function Core.stop(name)
    local m = Core.modules[name]
    if not m or not m.stop then return false end
    local ok, err = pcall(m.stop)
    if not ok then
        Core.notify("Core", "stop() error in '" .. tostring(name) .. "': " .. tostring(err), 5)
        return false
    end
    return true
end

function Core.isRunning(name)
    local m = Core.modules[name]
    if m and m.isRunning then
        local ok, res = pcall(m.isRunning)
        return ok and res == true
    end
    return false
end

getgenv().PrinceCore = Core
return Core
