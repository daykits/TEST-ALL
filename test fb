function Core.DoSafeTeleport(targetPos)
    if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end
    local char = Core.lp.Character
    local rp   = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")
    if not rp or not hum or hum.Health <= 0 then return end

    local dist = (rp.Position - targetPos).Magnitude
    if dist < 5 then
        rp.CFrame = (rp.CFrame - rp.Position) + targetPos
        return
    end

    if Core.activeTpConn then Core.activeTpConn:Disconnect(); Core.activeTpConn = nil end
    if Core.invisibleFloor then Core.invisibleFloor:Destroy(); Core.invisibleFloor = nil end
    for _, bvName in ipairs({"AF_BV", "S2_BV", "AH_BV", "KT_BV"}) do
        local bv = rp:FindFirstChild(bvName)
        if bv then bv:Destroy() end
    end

    Core.isTeleporting = true
    Core.tpId = Core.tpId + 1
    local currentTpId = Core.tpId
    local speed = Core.teleportSpeed or 89
    local reached = false

    local waypoints = {}
    if dist > 300 then
        local safeAlt = math.max(rp.Position.Y, targetPos.Y) + 2500
        table.insert(waypoints, Vector3.new(rp.Position.X, safeAlt, rp.Position.Z))
        table.insert(waypoints, Vector3.new(targetPos.X, safeAlt, targetPos.Z))
        if targetPos.Y < -500 then
            table.insert(waypoints, Vector3.new(targetPos.X, (safeAlt + targetPos.Y) / 2, targetPos.Z))
        end
    end
    table.insert(waypoints, targetPos)

    local currentWp = 1

    local floor = Instance.new("Part")
    floor.Size = Vector3.new(10, 1, 10)
    floor.Transparency = 1
    floor.Anchored = true
    floor.CanCollide = true
    floor.Parent = workspace
    Core.invisibleFloor = floor

    if not Core.DisableForwardKey then
        VIM:SendKeyEvent(true, Enum.KeyCode.W, false, game)
    end

    local conn
    conn = Core.run_svc.Heartbeat:Connect(function(dt)
        if not rp or not rp.Parent or hum.Health <= 0 or Core.tpId ~= currentTpId then
            reached = true
            if conn then conn:Disconnect() end
            return
        end
        local wp = waypoints[currentWp]
        local d = (rp.Position - wp).Magnitude
        if d <= 20 then
            rp.CFrame = (rp.CFrame - rp.Position) + wp
            rp.AssemblyLinearVelocity = Vector3.zero
            currentWp = currentWp + 1
            if currentWp > #waypoints then
                rp.CFrame = (rp.CFrame - rp.Position) + targetPos
                rp.AssemblyLinearVelocity = Vector3.zero
                reached = true
                if Core.invisibleFloor then Core.invisibleFloor:Destroy(); Core.invisibleFloor = nil end
                Core.isTeleporting = false
                if conn then conn:Disconnect() end
                return
            end
            wp = waypoints[currentWp]
            d = (rp.Position - wp).Magnitude
        end
        local dir = (wp - rp.Position).Unit
        local moveStep = math.min(speed * dt, d * 0.9)
        rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * moveStep)
        rp.AssemblyLinearVelocity = Vector3.zero
        if Core.invisibleFloor and Core.invisibleFloor.Parent then
            Core.invisibleFloor.CFrame = rp.CFrame * CFrame.new(0, -3.1, 0)
        end
    end)
    Core.activeTpConn = conn

    while not reached and Core.tpId == currentTpId do
        task.wait(0.1)
    end

    if Core.tpId == currentTpId then
        VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
    end
end

