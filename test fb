-- INFINITE JUMP
-- ============================================================
local ijHum
local ijRP
local ijLastJump = 0
local ijGround = true
local ijPending = false
local IJ_COOLDOWN = 0.15
local IJ_POWER = 50

local function ijHookState(hum)
    hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
            ijGround = true
        elseif new == Enum.HumanoidStateType.Freefall or new == Enum.HumanoidStateType.Jumping then
            ijGround = false
        end
    end)
end

local function ijBind(char)
    if not char then return end
    ijHum = char:WaitForChild("Humanoid", 5)
    ijRP  = char:WaitForChild("HumanoidRootPart", 5)
    if ijHum then ijHookState(ijHum) end
end

if H.lp.Character then ijBind(H.lp.Character) end
H.lp.CharacterAdded:Connect(ijBind)

H.run_svc.Heartbeat:Connect(function()
    if not ijPending then return end
    ijPending = false
    if ijHum and ijHum.Health > 0 and ijRP then
        local v = ijRP.AssemblyLinearVelocity
        ijRP.AssemblyLinearVelocity = Vector3.new(v.X, IJ_POWER, v.Z)
        ijHum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

H.UIS.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.Space or inp.KeyCode == Enum.KeyCode.ButtonA then
        if not H.infiniteJumpEnabled or ijGround then return end
        local now = tick()
        if now - ijLastJump < IJ_COOLDOWN then return end
        ijPending = true
        ijLastJump = now
    end
end)

