H.startAutoFarm = function()
    if AF.isRunning then return end
    getgenv().LevelFarm = true
    AF.isRunning = true
    AF.LoopID = AF.LoopID + 1
    local loop = AF.LoopID

    task.spawn(function()
        local curZone = getZone(getLevel())
        local lastZone = nil
        local lastAggro = 0
        while getgenv().LevelFarm and AF.LoopID == loop do
            local lvl = getLevel()
            local qn = getQuest()
            if not curZone then curZone = getZone(lvl) end
            if not curZone then task.wait(1); continue end
            if lastZone ~= curZone.TargetName then
                lastZone = curZone.TargetName
                Core.notify("Farm", "Farming: " .. curZone.TargetName .. " (Lvl " .. lvl .. ")", 4)
            end
            local char = H.lp.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local rp  = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hum or hum.Health <= 0 or not rp then task.wait(0.5); continue end

            local reqLvl = curZone.QuestMinLevel or curZone.MinLevel
            if curZone.QuestName ~= "" and qn ~= curZone.QuestName and lvl >= reqLvl then
                takeQuest(curZone); lastAggro = 0
            else
                local offset = 8.5
                if curZone.Method == "1by1" then
                    local npc = getClosestNPC(curZone.TargetName)
                    if not npc then
                        local cy = curZone.Center.Y + offset
                        H.DoSafeTeleport(Vector3.new(curZone.Center.X, cy, curZone.Center.Z))
                        task.wait(0.5); continue
                    end
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local ly = hrp.Position.Y + offset
                        if (rp.Position - Vector3.new(hrp.Position.X, ly, hrp.Position.Z)).Magnitude > 6 then
                            H.DoSafeTeleport(Vector3.new(hrp.Position.X, ly, hrp.Position.Z))
                        end
                        task.wait(0.15)
                        attackSingle(npc, ly)
                    end
                else
                    local npcs = getAllNPCs(curZone.TargetName)
                    local cy = curZone.Center.Y + offset
                    local centerCF = CFrame.lookAt(
                        Vector3.new(curZone.Center.X, cy, curZone.Center.Z),
                        curZone.Center.Position
                    )
                    if #npcs == 0 then
                        if (rp.Position - centerCF.Position).Magnitude > 6 then
                            H.DoSafeTeleport(centerCF.Position)
                        end
                        task.wait(0.5); continue
                    end
                    if tick() - lastAggro >= 15 then
                        for _, d in ipairs(npcs) do
                            if not getgenv().LevelFarm then break end
                            if d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health > 0 then
                                local p = Vector3.new(d.hrp.Position.X, d.hrp.Position.Y + offset, d.hrp.Position.Z)
                                H.DoSafeTeleport(p)
                                rp.CFrame = CFrame.new(p)
                                task.wait(0.2)
                                attackSingle(d.npc, p.Y)
                                task.wait(0.2)
                            end
                        end
                        H.DoSafeTeleport(centerCF.Position)
                        lastAggro = tick()
                    else
                        if (rp.Position - centerCF.Position).Magnitude > 6 then
                            H.DoSafeTeleport(centerCF.Position)
                        end
                        attackAll(curZone.TargetName, centerCF)
                    end
                end
            end
            task.wait(0.05)
        end
        AF.isRunning = false
    end)
end

H.stopAutoFarm = function()
    getgenv().LevelFarm = false
    AF.isRunning = false
    AF.LoopID = AF.LoopID + 1
end

