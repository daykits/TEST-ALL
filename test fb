local Core = getgenv().PrinceCore
local UI   = getgenv().UI
local H    = Core

local RS = H.RS
local LP = H.lp
local VirtualUser = game:GetService("VirtualUser")

H.fishState = {
    autoFishing = false,
    delayed = false,
    _isCasting = false,
    waterPos = nil,
    isPaused = false,
}
H.autoBuyBaitEnabled = false
H.autoBuyBaitAmount = 1
H.autoBuyBaitInterval = 60
H.lastBaitBuy = 0
H.autoBuyRod = false
H.autoSellFishEnabled = false
H.sellFishRarities = { Common = true, Rare = true, Legendary = true }
H.peliCapEnabled = true
H.peliCapAmount = 1000000
H._peliCapSellBlocked = false

local fishFolder = RS:FindFirstChild("Fishing")
local fishRemotes = fishFolder and fishFolder:FindFirstChild("Remotes")
local FishingAction = fishRemotes and fishRemotes:FindFirstChild("Action")

local ROD_TIERS = {
    ["Devil Fruit Rod"] = 8, ["ODM Rod"] = 7, ["Jack-O'Rod"] = 6,
    ["Angler Rod"] = 5, ["Merchants Banana Rod"] = 4, ["Epic Fishing Rod"] = 3,
    ["Rare Fishing Rod"] = 2, ["Fishing Rod"] = 1,
}

local function isBlackScreen()
    local count = 0
    pcall(function()
        for _, gui in ipairs(LP.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name == "ScreenGui" and gui.Enabled then
                count = count + 1
            end
        end
    end)
    return count > 0
end

local function getInventoryCount(itemName)
    local count = 0
    local function scan(c)
        if not c then return end
        for _, obj in ipairs(c:GetChildren()) do
            if obj.Name == itemName then count = count + 1 end
        end
    end
    scan(LP:FindFirstChild("Backpack"))
    scan(LP:FindFirstChild("Inventory"))
    local stats = LP:FindFirstChild("Stats" .. LP.Name) or LP:FindFirstChild("Stats")
    if stats and stats:FindFirstChild("Inventory") then
        local item = stats.Inventory:FindFirstChild(itemName)
        if item then
            count = count + (tonumber(item.Value) or tonumber(item:GetAttribute("Amount")) or 1)
        end
    end
    return count
end

local function getRodInstance()
    local char = LP.Character
    if not char then return nil end
    local bestRod, bestTier = nil, -1
    for rodName, tier in pairs(ROD_TIERS) do
        local tool = char:FindFirstChild(rodName) or (LP:FindFirstChild("Backpack") and LP.Backpack:FindFirstChild(rodName))
        if tool and tier > bestTier then
            bestRod = tool
            bestTier = tier
        end
    end
    return bestRod
end

local rodHideConn = nil
local function hideRod(model)
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Transparency = 1
            obj.CanCollide = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("Beam") or obj:IsA("Trail") then
            obj.Enabled = false
        elseif obj:IsA("RopeConstraint") then
            obj.Visible = false
        end
    end
end

local function toggleRodHider(state)
    local charFolder = workspace:FindFirstChild("PlayerCharacters")
    if not charFolder then return end
    if state then
        if rodHideConn then return end
        local pc = charFolder:FindFirstChild(LP.Name)
        if pc then
            local function check(child)
                if child:IsA("Tool") and ROD_TIERS[child.Name] then
                    task.wait(0.2)
                    hideRod(child)
                end
            end
            rodHideConn = pc.ChildAdded:Connect(check)
            for _, c in ipairs(pc:GetChildren()) do check(c) end
        end
    else
        if rodHideConn then rodHideConn:Disconnect(); rodHideConn = nil end
    end
end

local function getCurrentPeli()
    local stats = RS:FindFirstChild("Stats" .. LP.Name)
    local peliObj = stats and stats:FindFirstChild("Stats") and stats.Stats:FindFirstChild("Peli")
    return peliObj and peliObj.Value or 0
end

local function canSellFish()
    if not H.peliCapEnabled then H._peliCapSellBlocked = false; return true end
    local cur = getCurrentPeli()
    if cur >= H.peliCapAmount then
        if not H._peliCapSellBlocked then
            H._peliCapSellBlocked = true
            Core.notify("PeliCap", "Peli >= 1,000,000. Sell paused.", 5)
        end
        return false
    end
    if H._peliCapSellBlocked then
        H._peliCapSellBlocked = false
        Core.notify("PeliCap", "Peli < 1,000,000. Sell resumed.", 4)
    end
    return true
end

local fishOnce = function()
    if not FishingAction or H.fishState.isPaused then return end
    if H.fishState.delayed then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local rod = getRodInstance()
    if not rod then return end

    if rod.Parent ~= char then
        hum:EquipTool(rod)
        task.wait(0.5)
        return
    end

    local hook = workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild(LP.Name .. "'s hook")

    if not hook then
        if H.fishState._isCasting then return end
        H.fishState._isCasting = true

        pcall(function()
            if mouse2press and mouse2release then
                mouse2press()
                task.wait(0.1)
                mouse2release()
            else
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end
        end)
        task.wait(0.6)

        local ok, goalPos = pcall(function()
            local ocean = workspace.Env.WaterStuff.Ocean
            local oceanCF, oceanSize = ocean.CFrame, ocean.Size
            local dir = hrp.CFrame.LookVector
            local castTarget = hrp.Position + (Vector3.new(dir.X, 0, dir.Z).Unit * 20)
            local localPos = oceanCF:PointToObjectSpace(castTarget)
            local waterPos = oceanCF:PointToWorldSpace(Vector3.new(
                math.clamp(localPos.X, -oceanSize.X / 2, oceanSize.X / 2),
                oceanSize.Y / 2,
                math.clamp(localPos.Z, -oceanSize.Z / 2, oceanSize.Z / 2)
            ))
            local startPos = hrp.Position
            if startPos.Y < 0 then startPos = Vector3.new(startPos.X, 10, startPos.Z) end
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Include
            rayParams.FilterDescendantsInstances = { workspace.Env.WaterStuff }
            local ray = workspace:Raycast(startPos, Vector3.new(0, -2000, 0), rayParams)
            local gp = ray and ray.Position + Vector3.new(0, 7, 0) or waterPos + Vector3.new(0, 7, 0)
            return Vector3.new(gp.X, 0, gp.Z)
        end)

        if not ok then H.fishState._isCasting = false; return end
        H.fishState.waterPos = goalPos

        local bait = "Common Fish Bait"
        if getInventoryCount("Legendary Fish Bait") > 0 then
            bait = "Legendary Fish Bait"
        elseif getInventoryCount("Rare Fish Bait") > 0 then
            bait = "Rare Fish Bait"
        end

        pcall(function() FishingAction:InvokeServer({ Goal = goalPos, Action = "Throw", Bait = bait }) end)
        task.wait(0.5)
        pcall(function() FishingAction:InvokeServer({ Action = "Landed" }) end)
        task.delay(4, function() H.fishState._isCasting = false end)
    else
        if hrp.Position.Y > 0 and hrp.Position.Y < 800 and H.fishState.waterPos then
            pcall(function() hook.CFrame = CFrame.new(H.fishState.waterPos) end)
        end
        if hook:GetAttribute("Caught") and not H.fishState.delayed then
            H.fishState.delayed = true
            task.delay(7.5, function()
                if not H.fishState.delayed or not H.fishState.autoFishing or H.fishState.isPaused then return end
                pcall(function() FishingAction:InvokeServer({ Action = "Reel" }) end)
                H.fishState.delayed = false
            end)
        elseif hook:GetAttribute("MoveMultiplier") and not hook:GetAttribute("Caught") then
            pcall(function()
                FishingAction:InvokeServer({ Action = "HookReturning" })
                FishingAction:InvokeServer({ Action = "Cancel" })
                hook:Destroy()
            end)
        end
    end
end

local fishLoopRunning = false
H.startAutoFishLoop = function()
    if fishLoopRunning then return end
    fishLoopRunning = true
    toggleRodHider(true)
    task.spawn(function()
        while task.wait() do
            if not H.fishState.autoFishing then fishLoopRunning = false; break end
            if H.fishState.isPaused then continue end
            if isBlackScreen() then
                local char = LP.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then hum:UnequipTools() end
                task.wait(1)
                continue
            end
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then task.wait(1); continue end
            fishOnce()
        end
    end)
end

H.stopAutoFishLoop = function()
    H.fishState.autoFishing = false
    H.fishState.delayed = false
    H.fishState._isCasting = false
    H.fishState.isPaused = false
    toggleRodHider(false)
    pcall(function()
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum:UnequipTools() end
    end)
end

-- Auto sell fish
task.spawn(function()
    local ShopRemote = RS:WaitForChild("FishingShopRemote", 10)
    local sellList = {
        { r = "Common", n = "Blue-Lip Grouper" }, { r = "Common", n = "Tigerfin" },
        { r = "Rare", n = "Candy Corn Squid" }, { r = "Rare", n = "Crimson Polka Puffer" },
        { r = "Rare", n = "Crimson Snapper" }, { r = "Rare", n = "Exotic Tigerfin" },
        { r = "Rare", n = "Fangfish" }, { r = "Rare", n = "Zebra Ribbon Angelfish" },
        { r = "Rare", n = "Skeletal Shark" }, { r = "Legendary", n = "Anglerfish" },
        { r = "Legendary", n = "Dark Skeletal Shark" }, { r = "Legendary", n = "Jack-O'-Bite" },
        { r = "Legendary", n = "Swordfish" }, { r = "Legendary", n = "Golden Polka Puffer" },
        { r = "Legendary", n = "Golden Ribbon Angelfish" }, { r = "Legendary", n = "Golden Tigerfin" },
    }
    local idx = 1
    while true do
        task.wait(1.5)
        if H.autoSellFishEnabled and ShopRemote and canSellFish() then
            for _ = 1, #sellList do
                local e = sellList[idx]
