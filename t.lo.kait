		local function storeFruitNow()
			local fsr = _Events and _Events:FindFirstChild("FruitStorage")
			if not fsr then return end
			local pg = _lp:FindFirstChild("PlayerGui")
			local hotbar = pg and pg:FindFirstChild("BackpackGui") and pg.BackpackGui:FindFirstChild("Hotbar")
			if not hotbar then return end

			local count = 0
			for _, slotName in ipairs(SLOT_NAMES) do
				local slot = hotbar:FindFirstChild(slotName)
				if not slot then continue end
				-- Look for the child that is the fruit name (not default children)
				local fruitChild = nil
				for _, child in ipairs(slot:GetChildren()) do
					if not IGNORED_CHILDREN[child.Name] and KNOWN_FRUITS[child.Name] then
						fruitChild = child
						break
					end
				end
				if not fruitChild then continue end
				local key = SLOT_KEYS[slotName]
				if not key then continue end
				-- Press the slot key to equip the fruit
				local vim = Instance.new("VirtualInputManager")
				vim:SendKeyEvent(true, key, false, nil)
				task.wait(0.15)
				vim:SendKeyEvent(false, key, false, nil)
				vim:Destroy()
				task.wait(0.4)
				-- Store
				pcall(function() fsr:InvokeServer(true) end)
				task.wait(0.5)
				count = count + 1
			end
			Library:Notify(count > 0 and ("Stored " .. count .. " fruit(s).") or "No fruits found.", 3)
		end

		-- Auto wrapper (checks the toggle)
		local function storeFruit()
			if not getgenv().adAutoStoreFruits then return end
			storeFruitNow()
		end

		-- Auto store loop: watches the hotbar and stores as soon as a fruit appears
		task.spawn(function()
			while true do
				task.wait(1)
				if not getgenv().adAutoStoreFruits then continue end
				local pg = _lp:FindFirstChild("PlayerGui")
				local hotbar = pg and pg:FindFirstChild("BackpackGui") and pg.BackpackGui:FindFirstChild("Hotbar")
				if not hotbar then continue end
				-- Check if a slot contains a fruit
				local hasFruit = false
				for _, slotName in ipairs(SLOT_NAMES) do
					local slot = hotbar:FindFirstChild(slotName)
					if not slot then continue end
					for _, child in ipairs(slot:GetChildren()) do
						if not IGNORED_CHILDREN[child.Name] and KNOWN_FRUITS[child.Name] then
							hasFruit = true
							break
						end
					end
					if hasFruit then break end
				end
				if hasFruit then
					storeFruitNow()
					task.wait(2) -- small delay after storing to avoid spamming
				end
			end
		end)

		-- ---- REPLAY / EXIT ----
		local function doReplay()
			if not getgenv().adAutoReplay then
				AD.status="idle"; AD.enabled=false
				if Toggles and Toggles.AutoDungeonToggle then
					Toggles.AutoDungeonToggle:SetValue(false)
				end
				return
			end
			AD.status="replay"
			task.wait(7)
			Library:Notify("Teleporting to Universe Hub...", 3)
			pcall(function()
				local TS = game:GetService("TeleportService")
				TS:TeleportToPlaceInstance(6360478118, "2c6cd3f9-8a53-4cb8-9b8e-b2c8259c29c9", _lp)
			end)
			task.wait(8)
			AD.startDungeon()
		end

		-- Quest "Head to the Exit"
		local headToExitHandled=false
		task.spawn(function()
			while true do
				task.wait(1)
				local pg=_lp:FindFirstChild("PlayerGui")
				local exitQuest=pg and pg:FindFirstChild("Objectives") and pg.Objectives:FindFirstChild("Main") and pg.Objectives.Main:FindFirstChild("Head to the Exit")
				if exitQuest and not headToExitHandled then
					headToExitHandled=true
					task.spawn(function() task.wait(5); doReplay() end)
				end
				if not exitQuest then headToExitHandled=false end
			end
		end)

		local function onDungeonComplete()
			local boss=findBossGlobal("Cupid Queen")
			local alive=boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health>0
			if alive then
				task.spawn(function() fightCupidQueen(AD.loopID); onDungeonComplete() end); return
			end
			cupidTrackActive=false; cupidTrackTarget=nil
			AD.status="replay"; lockedPosition=nil
			-- Store fruits before leaving
			if getgenv().adAutoStoreFruits then
				task.wait(2)
				storeFruit()
				task.wait(1)
			end
			-- Wait 7 seconds after Cupid Queen's death
			task.wait(7)
			if not getgenv().adAutoReplay then
				AD.status="idle"; AD.enabled=false
				if Toggles and Toggles.AutoDungeonToggle then
					Toggles.AutoDungeonToggle:SetValue(false)
				end
				return
			end
			Library:Notify("Teleporting to Universe Hub...", 3)
			pcall(function()
				local TS = game:GetService("TeleportService")
				TS:TeleportToPlaceInstance(6360478118, "2c6cd3f9-8a53-4cb8-9b8e-b2c8259c29c9", _lp)
			end)
			task.wait(8)
			AD.startDungeon()
		end

		-- ---- START / STOP ----
		AD.stopDungeon = function()
			AD.enabled=false; AD.loopID=AD.loopID+1
			tpId=tpId+1; AD.status="idle"; AD.waypointIdx=0
			stopBlock(); antiKBEnabled=false; lockedPosition=nil
			if activeTpConn then activeTpConn:Disconnect(); activeTpConn=nil end
			if invisibleFloor then invisibleFloor:Destroy(); invisibleFloor=nil end
			_VIM:SendKeyEvent(false,Enum.KeyCode.W,false,game)
			getgenv().adSkipHit=false; getgenv().adCupidPhase2Permanent=false
			cupidTrackTarget=nil; cupidTrackActive=false
			if hookedBossCleanup then hookedBossCleanup() end
			hookedBossCleanup=nil; hookedBossNPC=nil
			canAttack=true; isTeleporting=false
		end

		AD.startDungeon = function()
			if AD.enabled then return end
			AD.enabled=true; AD.loopID=AD.loopID+1
			local loopID=AD.loopID
			canAttack=true; AD.kills=0; AD.status="idle"
			getgenv().adSkipHit=false; getgenv().adCupidPhase2Permanent=false
			antiKBEnabled=false; lockedPosition=nil
			weaponEquipped = false
			-- Keep animation running throughout the dungeon
			task.spawn(function()
				while AD.enabled and AD.loopID==loopID do
					pcall(function()
						local char = _lp.Character
						local hum = char and char:FindFirstChildWhichIsA("Humanoid")
						if not hum then return end
						local anim = Instance.new("Animation")
						anim.AnimationId = "rbxassetid://13630769186"
						local track = hum:LoadAnimation(anim)
						track.Priority = Enum.AnimationPriority.Core
						track.Looped = true
						track:AdjustSpeed(1)
						track.TimePosition = 1.1125006675720215
						track:Play()
						anim:Destroy()
						task.wait(track.Length > 0 and track.Length or 1)
						track:Stop()
					end)
					task.wait(0.1)
				end
			end)
			-- 20 second delay on startup
			AD.status="waiting"
			for i=30,1,-1 do
				if not AD.enabled or AD.loopID~=loopID then return end
				Library:Notify("Auto Dungeon starts in " .. i .. "s...", 1)
				task.wait(1)
			end
			if not AD.enabled or AD.loopID~=loopID then return end
			AD.status="idle"

			local cupidNearby=findBossGlobal("Cupid Queen")
			if cupidNearby then
				local ch=cupidNearby:FindFirstChild("HumanoidRootPart"); local rp0=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart")
				if ch and rp0 and (rp0.Position-ch.Position).Magnitude<800 then
					task.spawn(function()
						fightCupidQueen(loopID)
						AD.enabled=false; task.spawn(onDungeonComplete)
					end); return
				end
			end

			local leoNearby=findBossGlobal("Leo")
			if leoNearby then
				local lh=leoNearby:FindFirstChild("HumanoidRootPart"); local rp0=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart")
				if lh and rp0 and (rp0.Position-lh.Position).Magnitude<400 then
					task.spawn(function()
						fightBoss(loopID,"Leo")
						if AD.enabled and AD.loopID==loopID then
							local function lm(pos)
								lockedPosition=nil; DoSafeTeleport(pos)
								local r=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart")
								if r then lockedPosition=r.Position end; task.wait(0.5)
							end
							lm(Vector3.new(-1091.291,506.375,-4424.925))
							if Toggles and Toggles.NoclipToggle then Toggles.NoclipToggle:SetValue(true) end
							lm(Vector3.new(-1092.546,568.555,-4497.691))
							lm(Vector3.new(-1092.954,631.463,-4588.583))
							lm(Vector3.new(-1091.032,639.903,-4747.583))
							lm(Vector3.new(-1033.052,667.073,-5048.281))
							lockedPosition=nil; fightCupidQueen(loopID)
						end
						AD.enabled=false; task.spawn(onDungeonComplete)
					end); return
				end
			end

			local startIdx=findNearestWaypointIndex()
			equipWeapon()

			task.spawn(function()
				for i=startIdx,#DUNGEON_WAYPOINTS do
					if not AD.enabled or AD.loopID~=loopID then break end
					AD.waypointIdx=i
					local wp=DUNGEON_WAYPOINTS[i]
					if wp.type=="patrol" then
						local posA=typeof(wp.posA)=="CFrame" and wp.posA.Position or wp.posA
						local posB=typeof(wp.posB)=="CFrame" and wp.posB.Position or wp.posB
						local dur=wp.duration or 30; local startT=tick(); local goB=true
						while AD.enabled and AD.loopID==loopID and (tick()-startT)<dur do
							local t=goB and posB or posA
							DoSafeTeleport(t); task.wait(0.5)
							if not AD.enabled or AD.loopID~=loopID then break end
							killAllNPCsAtPos(t,120); goB=not goB
						end
					else
						local tp=typeof(wp.pos)=="CFrame" and wp.pos.Position or wp.pos
						DoSafeTeleport(tp); task.wait(0.5)
						if not AD.enabled or AD.loopID~=loopID then break end
						killAllNPCsAtPos(tp,120); task.wait(0.5)
						if not AD.enabled or AD.loopID~=loopID then break end
						killAllNPCsAtPos(tp,120)
					end
				end
				if not AD.enabled or AD.loopID~=loopID then return end
				AD.waypointIdx=0
				fightBoss(loopID,"Leo")
				if not AD.enabled or AD.loopID~=loopID then return end
				local function lm(pos)
					lockedPosition=nil; DoSafeTeleport(pos)
					local rp2=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart")
					if rp2 then lockedPosition=rp2.Position end; task.wait(0.5)
				end
				lm(Vector3.new(-1091.291,506.375,-4424.925))
				if Toggles and Toggles.NoclipToggle then Toggles.NoclipToggle:SetValue(true) end
				lm(Vector3.new(-1092.546,568.555,-4497.691))
				lm(Vector3.new(-1092.954,631.463,-4588.583))
				lm(Vector3.new(-1091.032,639.903,-4747.583))
				lm(Vector3.new(-1033.052,667.073,-5048.281))
				lockedPosition=nil
				fightCupidQueen(loopID)
				AD.status="complete"; AD.enabled=false
				task.spawn(onDungeonComplete)
			end)
		end

		-- Expose for buildDungeonTab
		getgenv()._AD = AD
	end -- end do Auto Dungeon
end -- end if not IS_LOGIN_PLACE

-- ============================================================
-- BUILD DUNGEON TAB
-- ============================================================
local function buildDungeonTab()
	local AD = getgenv()._AD
	if not AD then return end

	local DLeft  = Tabs.Dungeon:AddLeftGroupbox('Auto Dungeon')
	local DRight = Tabs.Dungeon:AddRightGroupbox('Settings')

	-- Main toggle
	DLeft:AddToggle('AutoDungeonToggle', {
		Text    = 'Enable Auto Dungeon',
		Default = false,
		Tooltip = 'Starts/stops the full dungeon auto farm (waypoints > Leo > Cupid Queen > replay)',
		Callback = function(v)
			if v then
				AD.startDungeon()
			else
				AD.stopDungeon()
			end
		end,
	})

	DLeft:AddDivider()

	-- Weapon dropdown
	DLeft:AddDropdown('DungeonWeaponDropdown', {
		Values  = { 'Kraken Blade', "Cupid's Battleaxe", "Cupid's Chakram", "Bisento" },
		Default = 1,
		Multi   = false,
		Text    = 'Weapon',
		Tooltip = 'Weapon used to attack NPCs and bosses',
		Callback = function(v)
			AD.weapon = v
			Library:Notify('Weapon selected: ' .. v, 3)
		end,
	})

	DLeft:AddDivider()

	-- Auto Store fruits
	DLeft:AddToggle('AutoStoreFruitsToggle', {
		Text    = 'Auto Store Fruits',
		Default = true,
		Tooltip = 'Automatically stores fruits found in the hotbar during the dungeon',
		Callback = function(v)
			getgenv().adAutoStoreFruits = v
		end,
	})

	DLeft:AddDivider()

	-- Auto Equip Items
	DLeft:AddToggle('AutoEquipItemsToggle', {
		Text    = 'Auto Equip Items',
		Default = true,
		Tooltip = 'Spam equips items from the list every 3s during the dungeon (auto equips on drop)',
		Callback = function(v)
			getgenv().adAutoEquipItems = v
		end,
	})

	DRight:AddDropdown('AutoEquipItemsDropdown', {
		Values = {
			"Virtuous Cupid Queen's Outfit",
			"Virtuous Cupid Queen's Wings",
			"Leo's Blazing Scarf",
			"Love Shades",
			"Love Boppers Headband",
			"Virtuous Cupid Vanguard Helmet",
			"Worshiper's Cape",
			"Cupid Mask",
		},
		Default = {
			["Virtuous Cupid Queen's Outfit"]  = true,
			["Virtuous Cupid Queen's Wings"]   = true,
			["Leo's Blazing Scarf"]            = true,
			["Love Shades"]                    = true,
			["Love Boppers Headband"]          = true,
			["Virtuous Cupid Vanguard Helmet"] = true,
			["Worshiper's Cape"]               = true,
			["Cupid Mask"]                     = true,
		},
		Multi   = true,
		Text    = 'Items to Equip',
		Tooltip = 'Select the items to automatically equip during the dungeon',
		Callback = function(v)
			if type(v) == "table" then
				getgenv().adItemsToEquip = v
			end
		end,
	})

	-- Auto Replay
	DLeft:AddToggle('AutoReplayToggle', {
		Text    = 'Auto Replay',
		Default = true,
		Tooltip = 'Automatically restarts the dungeon after completion (Cupid Queen dead)',
		Callback = function(v)
			getgenv().adAutoReplay = v
		end,
	})

	-- ============================================================
	-- PER-ACCOUNT WEAPON LIST
	-- ============================================================
	DRight:AddDivider()

	DRight:AddToggle('ShowWeaponSlots', {
		Text    = 'Configure Per-Account Weapons',
		Default = false,
		Tooltip = 'Expand to assign a specific weapon per username',
	})

	local WeaponSlotsDepBox = DRight:AddDependencyBox()
	WeaponSlotsDepBox:SetupDependencies({{ Toggles.ShowWeaponSlots, true }})

	local WEAPON_LIST = { 'Kraken Blade', "Cupid's Battleaxe", "Cupid's Chakram", "Bisento" }

	-- Auto-select weapon based on the local player's username
	local function applyWeaponForCurrentPlayer()
		local myName = game:GetService('Players').LocalPlayer.Name
		for i = 1, 20 do
			local userOpt   = Options['WeaponSlotUser' .. i]
			local swordOpt  = Options['WeaponSlotSword' .. i]
			if userOpt and swordOpt then
				local username = (userOpt.Value or ''):lower():gsub('%s+', '')
				if username ~= '' and username == myName:lower() then
					AD.weapon = swordOpt.Value
					Library:Notify('Weapon auto-set to ' .. AD.weapon .. ' for ' .. myName, 3)
					if Options.DungeonWeaponDropdown then
						Options.DungeonWeaponDropdown:SetValue(AD.weapon)
					end
					return
				end
			end
		end
	end

	for i = 1, 20 do
		WeaponSlotsDepBox:AddInput('WeaponSlotUser' .. i, {
			Default     = '',
			Numeric     = false,
			Finished    = true,
			Text        = 'Slot ' .. i .. ' - Username',
			Placeholder = 'Username',
			Callback    = function() applyWeaponForCurrentPlayer() end,
		})
		WeaponSlotsDepBox:AddDropdown('WeaponSlotSword' .. i, {
			Values   = WEAPON_LIST,
			Default  = 1,
			Multi    = false,
			Text     = 'Slot ' .. i .. ' - Sword',
			Tooltip  = 'Weapon assigned to this username',
			Callback = function() applyWeaponForCurrentPlayer() end,
		})
		WeaponSlotsDepBox:AddDivider()
	end

	-- Apply immediately in case config was loaded before this tab built
	task.defer(applyWeaponForCurrentPlayer)

end

-- ============================================================
-- BUILD SEA 2 TAB
-- ============================================================
local function buildSea2Tab()
	local H = _G_Hub

	local S2Left  = Tabs.Sea2:AddRightGroupbox('Auto Farm Sea 2')
	local S2Right = Tabs.Sea2:AddRightGroupbox('Island Teleports')

	-- ---- KAITUN FARM ----
	local KaitunBox = Tabs.Sea2:AddLeftGroupbox('Kaitun Farm')

	KaitunBox:AddToggle('AutoFarmKaitunToggle', {
		Text    = 'Start Kaitun Farm',
		Default = false,
		Tooltip = 'Lvl 1 to 675 — runs Fishman, Geppo, Haki, World Scroll then joins Sea 2.',
		Callback = function(v)
			if v then
				if not H.startKaitunFarm then
					Library:Notify('Kaitun Farm unavailable.', 4)
					Toggles.AutoFarmKaitunToggle:SetValue(false)
					return
				end
				H.startKaitunFarm()
				Library:Notify('Kaitun Farm started.', 3)
			else
				if H.stopKaitunFarm then H.stopKaitunFarm() end
				Library:Notify('Kaitun Farm stopped.', 3)
			end
		end,
	})
	KaitunBox:AddDivider()

	-- ---- AUTO FARM SEA 1 ----
	local Sea1Box = Tabs.Sea2:AddLeftGroupbox('Auto Farm Sea 1')
	Sea1Box:AddToggle('AutoFarmToggle', {
		Text    = 'Start Sea 1 Farm',
		Default = false,
		Tooltip = 'Lvl 1 to 675 in Sea 1.',
		Callback = function(v)
			if v then H.startAutoFarm() else H.stopAutoFarm() end
		end,
	})
	Sea1Box:AddDivider()

	-- ---- KAITUN SEA 2 AUTO JOIN PS ----
	local KaitunJoinBox = Tabs.Sea2:AddLeftGroupbox('Kaitun Sea 2 Auto Join PS')

	KaitunJoinBox:AddToggle('KaitunAutoJoinSea2InGameToggle', {
		Text    = 'Auto Join Sea 2',
		Default = getgenv().KaitunSea2Pending == true,
		Tooltip = 'Enable + save in autoload to auto-join at the main menu',
		Callback = function(v)
			getgenv().KaitunSea2Pending = v
			if Toggles.KaitunAutoJoinSea2Toggle then
				Toggles.KaitunAutoJoinSea2Toggle:SetValue(v)
			end
		end,
	})

	KaitunJoinBox:AddDivider()

	-- ---- AUTO FARM ----
	S2Left:AddToggle('AutoFarmSea2Toggle', {
		Text    = 'Auto Farm Sea 2',
		Default = false,
		Tooltip = 'Automatically farms Crazy Wolf in Sea 2. Quest: Help PJ.',
		Callback = function(v)
			if v then
				if not H.startSea2Farm then
					Library:Notify('Sea 2 Farm: function unavailable.', 4)
					Toggles.AutoFarmSea2Toggle:SetValue(false)
					return
				end
				H.startSea2Farm()
				Library:Notify('Auto Farm Sea 2 started.', 3)
			else
				if H.stopSea2Farm then H.stopSea2Farm() end
				Library:Notify('Auto Farm Sea 2 stopped.', 3)
			end
		end,
	})

	S2Left:AddDivider()

	-- ---- ISLAND TELEPORTS Sea 2 ----
	local Sea2Islands = {
		["Desert Kingdom"]    = Vector3.new(-3672.473, 19.368, 402.232),
		["Reverse Mountain 2"]= Vector3.new(-6348.723, 128.017, 399.657),
		["Coliseum"]          = Vector3.new(2218.833, 4.759, 6073.599),
		["Rose Kingdom"]      = Vector3.new(9248.953, 24.973, 7841.948),
		["Roger Island"]      = Vector3.new(12562.259, 7.529, 2829.644),
		["Foro Island"]       = Vector3.new(8151.155, 6.330, 4322.578),
		["Sakura Stronghold"] = Vector3.new(6067.310, 12.542, -91.792),
		["Impel Down"]        = Vector3.new(5935.760, 5.724, -9471.919),
		["Juzo Island"]       = Vector3.new(1754.319, 19.776, -10563.824),
		["Sett's Arena"]      = Vector3.new(-7732.424, 9.979, -8120.898),
		["Thriller Bark"]     = function()
			local isle = workspace:FindFirstChild("Islands") and workspace.Islands:FindFirstChild("Thriller Bark")
			if isle then
				local pp = isle.PrimaryPart or isle:FindFirstChildWhichIsA("BasePart", true)
				return pp and pp.Position
			end
		end,
	}

	local IslandNames = {}
	for name, _ in pairs(Sea2Islands) do table.insert(IslandNames, name) end
	table.sort(IslandNames)

	S2Right:AddDropdown('Sea2IslandSelect', {
		Values  = IslandNames,
		Default = 1,
		Multi   = false,
		Text    = 'Select Island',
		Tooltip = 'Choose a Sea 2 island to teleport to',
	})

	S2Right:AddButton({
		Text = 'Teleport',
		Func = function()
			local selected = Options.Sea2IslandSelect and Options.Sea2IslandSelect.Value
			if not selected then return end
			local entry = Sea2Islands[selected]
			local pos
			if type(entry) == "function" then
				pos = entry()
				if not pos then
					Library:Notify('Island not found in workspace: ' .. selected, 4)
					return
				end
			else
				pos = entry
			end
			Library:Notify('Heading to ' .. selected .. '...', 3)
			task.spawn(function()
				H.DoSafeTeleport(pos)
				Library:Notify('Arrived at ' .. selected .. '.', 3)
			end)
		end,
		Tooltip = 'Teleport to the selected Sea 2 island',
	})
end

-- UI CALLS
buildMainTab()
if not IS_LOGIN_PLACE then
	buildFishTab()
	buildMiscTab()
	buildESPTab()
	buildDungeonTab()
	buildSea2Tab()
end
buildConfigTab()

-- ============================================================
-- BOOT
-- ============================================================

SaveManager:LoadAutoloadConfig()
Library:Notify('Prince Hub loaded.', 4)

-- ============================================================
-- KAITUN SEA 2 : auto-join at main menu
-- ============================================================
task.spawn(function()
	task.wait(3)

	local H       = _G_Hub
	local cfg     = getgenv().Config and getgenv().Config.MAIN
	local autoJoin = cfg and cfg.AUTO_JOIN_SEA2
	local kCode   = (cfg and cfg.RESOLVED_PS_CODE) or getgenv().KaitunSea2Code or ""

	-- Si pas de code depuis la config, chercher dans les slots UI
	if kCode == "" and Options then
		local myName = game:GetService("Players").LocalPlayer.Name
		for i = 1, 20 do
			local userOpt = Options["KaitunSlotUser"..i]
			local codeOpt = Options["KaitunSlotCode"..i]
			if userOpt and codeOpt and userOpt.Value ~= "" and userOpt.Value == myName then
				kCode = codeOpt.Value or ""
				break
			end
		end
	end

	-- Fallback toggles UI
	if not autoJoin then
		autoJoin = (Toggles and Toggles.KaitunAutoJoinSea2Toggle and Toggles.KaitunAutoJoinSea2Toggle.Value)
			or (Toggles and Toggles.KaitunAutoJoinSea2InGameToggle and Toggles.KaitunAutoJoinSea2InGameToggle.Value)
			or getgenv().KaitunSea2Pending
	end
	if kCode == "" then
		kCode = (Options and Options.KaitunPSCodeLogin and Options.KaitunPSCodeLogin.Value) or ""
	end

	if not autoJoin then return end
	if kCode == "" then
		H.notify("KaitunFarm", "No PS code set", 5)
		return
	end

	-- Main menu : join Sea 2
	if IS_LOGIN_PLACE then
		H.notify("KaitunFarm", "Joining Sea 2...", 5)
		task.spawn(function()
			while true do
				local result = joinOnPrivateServer(kCode, "Second Sea")
				if result == "done" then break end
				task.wait(2)
			end
		end)
		return
	end

	-- Sea 2 : start auto farm
	if not IS_SEA2_PLACE then return end
	getgenv().KaitunSea2Pending = false
	H.notify("KaitunFarm", "Sea 2 — farming", 5)
	H.autoAdsEnabled   = true
	H.autoStatsEnabled = true
	task.wait(2)

	if H.startSea2Farm then
		local s2 = getgenv()._S2
		if s2 then s2.stopLevel = 675 end
		H.startSea2Farm()
		task.spawn(function()
			while getgenv().Sea2Farm do
				local ms = game:GetService("ReplicatedStorage"):FindFirstChild("Stats" .. H.lp.Name)
				local lv = ms and ms:FindFirstChild("Stats") and ms.Stats:FindFirstChild("Level")
				if lv and lv.Value >= 675 then
					H.notify("KaitunFarm", "Lvl 675 reached", 6)
					if H.stopSea2Farm then H.stopSea2Farm() end
					H.autoAdsEnabled   = false
					H.autoStatsEnabled = false
					getgenv().KaitunFarm = false
					break
				end
				task.wait(5)
			end
		end)
	end
end)

-- Auto Hide UI: hides the menu automatically on load if enabled
task.spawn(function()
	task.wait(0.1)
	if Toggles and Toggles.AutoHideUIToggle and Toggles.AutoHideUIToggle.Value then
		Library:Toggle()
	end
end)

-- Apply Config auto-flags (AUTO_KAITUN, AUTO_JOIN_SEA2, PS_CODE)
task.spawn(function()
	task.wait(2)
	local cfg = getgenv().Config and getgenv().Config.MAIN
	if not cfg then return end

	-- Set PS code from config (resolved per-player)
	local resolvedCode = cfg.RESOLVED_PS_CODE or ""
	if resolvedCode ~= "" then
		getgenv().KaitunSea2Code = resolvedCode
		if Options and Options.KaitunPSCode then
			Options.KaitunPSCode:SetValue(resolvedCode)
		end
		if Options and Options.KaitunPSCodeLogin then
			Options.KaitunPSCodeLogin:SetValue(resolvedCode)
		end
	end

	-- White Screen
	if cfg.WHITE_SCREEN and Toggles and Toggles.WhiteScreenToggle then
		Toggles.WhiteScreenToggle:SetValue(true)
	end

	-- Auto Rejoin
	if cfg.AUTO_REJOIN and Toggles and Toggles.AutoRejoinToggle then
		Toggles.AutoRejoinToggle:SetValue(true)
	end

	-- Auto Hide UI on load + custom keybind
	if cfg.HIDE_UI_KEY and Options and Options.AutoHideUIKeybind then
		pcall(function() Options.AutoHideUIKeybind:SetValue(cfg.HIDE_UI_KEY) end)
		Library.AutoHideUIKeybind = Options.AutoHideUIKeybind
	end
	if cfg.AUTO_HIDE_UI and Toggles and Toggles.AutoHideUIToggle then
		Toggles.AutoHideUIToggle:SetValue(true)
		task.wait(0.1)
		Library:Toggle()
	end

	-- Auto Join Sea 2
	if cfg.AUTO_JOIN_SEA2 then
		getgenv().KaitunSea2Pending = true
		if Toggles and Toggles.KaitunAutoJoinSea2Toggle then
			Toggles.KaitunAutoJoinSea2Toggle:SetValue(true)
		end
		if Toggles and Toggles.KaitunAutoJoinSea2InGameToggle then
			Toggles.KaitunAutoJoinSea2InGameToggle:SetValue(true)
		end
	end

	-- Auto start Kaitun farm
	if cfg.AUTO_KAITUN and Toggles and Toggles.AutoFarmKaitunToggle then
		task.wait(1)
		Toggles.AutoFarmKaitunToggle:SetValue(true)
	end
end)

-- Auto Hide UI keybind: lets you show/hide the UI with a separate custom key
Library:GiveSignal(game:GetService('UserInputService').InputBegan:Connect(function(Input)
	local bind = Library.AutoHideUIKeybind
	if type(bind) ~= 'table' or bind.Type ~= 'KeyPicker' then
		return
	end

	local selected = bind.Value
	if not selected or selected == '' then
		return
	end

	local inputName = nil

	if Input.UserInputType == Enum.UserInputType.Keyboard then
		inputName = Input.KeyCode.Name
	elseif tostring(Input.UserInputType):find('MouseButton') then
		inputName = Input.UserInputType.Name
	end

	if not inputName then
		return
	end

	if tostring(inputName):lower() == tostring(selected):lower() then
		task.spawn(function()
			Library:Toggle()
		end)
	end
end))

task.spawn(function()
	task.wait(2)
	if Toggles and Toggles.AutoJoinOnLoad and Toggles.AutoJoinOnLoad.Value then
		Library:Notify("Auto Join is active. Connecting now...", 4)
		Toggles.AutoJoinOnLoad:SetValue(false)
		task.wait(0.1)
		Toggles.AutoJoinOnLoad:SetValue(true)
	end
end)
