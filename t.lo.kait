_G_Hub.DoGroundWalk = function(targetPos)
	local H = _G_Hub
	if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end

	local char = H.lp.Character
	local rp   = char and char:FindFirstChild("HumanoidRootPart")
	local hum  = char and char:FindFirstChild("Humanoid")
	if not rp or not hum or hum.Health <= 0 then return end

	local dist = (rp.Position - targetPos).Magnitude
	if dist < 5 then
		rp.CFrame = (rp.CFrame - rp.Position) + targetPos
		return
	end

	if H.activeTpConn then H.activeTpConn:Disconnect(); H.activeTpConn = nil end

	H.isTeleporting = true
	H.tpId = (H.tpId or 0) + 1
	local currentTpId = H.tpId

	local speed   = H.teleportSpeed or 89
	local reached = false
	local fixedY = rp.Position.Y

	local conn
	conn = H.run_svc.Heartbeat:Connect(function(dt)
		if not rp or not rp.Parent or hum.Health <= 0 or H.tpId ~= currentTpId then
			reached = true
			if conn then conn:Disconnect() end
			return
		end

		local flatTarget = Vector3.new(targetPos.X, fixedY, targetPos.Z)
		local d = (rp.Position - flatTarget).Magnitude

		if d <= 8 then
			rp.CFrame = (rp.CFrame - rp.Position) + targetPos
			rp.AssemblyLinearVelocity = Vector3.zero
			reached = true
			H.isTeleporting = false
			if conn then conn:Disconnect() end
			return
		end

		local dir      = (flatTarget - rp.Position).Unit
		local moveStep = math.min(speed * dt, d * 0.98)
		rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * moveStep)
		rp.AssemblyLinearVelocity = Vector3.zero
	end)
	H.activeTpConn = conn

	while not reached and H.tpId == currentTpId do
		task.wait(0.1)
	end
end

-- ============================================================
-- FEATURE: DANCE 1
-- ============================================================
local function createDance1Tool()
	local speaker = _G_Hub.lp
	if not speaker then return end
	local backpack = speaker:FindFirstChildOfClass("Backpack")
	local character = speaker.Character
	local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
	if not backpack or not humanoid then return end

	local existing = backpack:FindFirstChild("Dance 1") or (character and character:FindFirstChild("Dance 1"))
	if existing then existing:Destroy() end

	local function isR15(h) return h.RigType == Enum.HumanoidRigType.R15 end

	local tool = Instance.new("Tool")
	tool.Name = "Dance 1"
	tool.ToolTip = "Play Dance 1 emote"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = backpack

	local dancing = false
	local track = nil

	local function stopDance()
		dancing = false
		if track then track:Stop(); track = nil end
	end

	tool.Equipped:Connect(function()
		dancing = true
		task.spawn(function()
			while dancing do
				local hum = speaker.Character and speaker.Character:FindFirstChildWhichIsA("Humanoid")
				if not hum then break end
				if not track then
					local anim = Instance.new("Animation")
					anim.AnimationId = isR15(hum) and "rbxassetid://698251653" or "rbxassetid://72042024"
					track = hum:LoadAnimation(anim)
				end
				track:Play()
				track:AdjustSpeed(isR15(hum) and 0.7 or 0.65)
				track.TimePosition = 0.6
				task.wait(0.1)
				while track and track.TimePosition < (isR15(hum) and 0.7 or 0.65) do task.wait(0.1) end
				if track then track:Stop(); track = nil end
			end
		end)
	end)
	tool.Unequipped:Connect(stopDance)
	humanoid.Died:Connect(stopDance)
end
_G_Hub.createDance1Tool = createDance1Tool

-- ============================================================
-- FEATURE: AUTO JOIN PS LOGIC
-- ============================================================
local autoJoinRunning = false
local codeSent = false

local function joinOnPrivateServer(targetCode, seaChoice)
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local chooseTypeRemote = playerGui:FindFirstChild("chooseType") 
		and playerGui.chooseType:FindFirstChild("Frame") 
		and playerGui.chooseType.Frame:FindFirstChild("RemoteEvent")
	local confirmRemote = playerGui:FindFirstChild("ConfirmationPrompt")
		and playerGui.ConfirmationPrompt:FindFirstChild("RemoteEvent")

	if confirmRemote then
		confirmRemote:FireServer(seaChoice)
		Library:Notify(seaChoice .. " selected — teleporting now.", 4, Color3.fromRGB(0, 255, 0))
		return "done"
	elseif chooseTypeRemote then
		chooseTypeRemote:FireServer(true)
		Library:Notify("Regular clicked — waiting for confirmation...", 3, Color3.fromRGB(0, 255, 0))
		return "waiting_confirm"
	else
		if not codeSent then
			codeSent = true
			task.spawn(function()
				pcall(function() ReplicatedStorage:WaitForChild("Events"):WaitForChild("reserved"):InvokeServer(targetCode) end)
			end)
			Library:Notify("PS code sent. Waiting for the menu...", 3, Color3.fromRGB(0, 255, 0))
		end
		return "waiting_menu"
	end
end

local function CheckAndJoinPS()
	local Players = game:GetService("Players")
	local localName = Players.LocalPlayer.Name
	local targetCode = nil
	for i = 1, 40 do
		local userOpt = Options["AltUser"..i]
		local codeOpt = Options["AltCode"..i]
		if userOpt and codeOpt then
			local uVal = userOpt.Value
			local cVal = codeOpt.Value
			if uVal ~= "" and uVal:lower() == localName:lower() then
				targetCode = cVal
				break
			end
		end
	end
	if not targetCode or targetCode == "" then
		Library:Notify("No slot found for " .. localName .. " — check your config.", 5, Color3.fromRGB(255, 0, 0))
		return
	end

	Library:Notify("Found " .. localName .. ". Connecting to the private server...", 4)
	autoJoinRunning = true
	codeSent = false

	task.spawn(function()
		while autoJoinRunning do
			local seaChoice = Options.SeaChoice and Options.SeaChoice.Value or "Sea 2"
			if seaChoice == "Sea 1" then seaChoice = "First Sea"
			elseif seaChoice == "Sea 2" then seaChoice = "Second Sea" end
			local result = joinOnPrivateServer(targetCode, seaChoice)

			if result == "done" then
				autoJoinRunning = false
				codeSent = false
				break
			elseif result == "waiting_menu" then task.wait(2)
			elseif result == "waiting_confirm" then task.wait(2)
			else task.wait(1) end
		end
	end)
end

-- ============================================================
-- FEATURE: CHEST ESP
-- ============================================================
local function initChestESP()
	local H = _G_Hub
	local rarityColors = {
		["Mythical Chest"]  = {fill = Color3.fromRGB(255, 50, 255), outline = Color3.fromRGB(200, 0, 200)},
		["Legendary Chest"] = {fill = Color3.fromRGB(255, 215, 0), outline = Color3.fromRGB(200, 160, 0)},
	}
	local allowedChestNames = { ["Mythical Chest"] = true, ["Legendary Chest"] = true }

	local function getEffectsFolder() return workspace:FindFirstChild("Effects") end

	local function getVisiblePart(obj)
		if not obj then return nil end
		if obj:IsA("BasePart") then return obj end
		if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
		return obj:FindFirstChildWhichIsA("BasePart", true)
	end

	local function looksLikeChestContainer(obj)
		if not obj then return false end
		local lname = string.lower(obj.Name or "")
		if lname:find("chest") then return true end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				local txt = string.lower(d.ObjectText or "")
				if txt:find("legendary chest") or txt:find("mythical chest") then return true end
			end
		end
		return false
	end

	local function getChestLabel(obj)
		if not obj then return nil end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				local txt = d.ObjectText
				if txt == "Legendary Chest" or txt == "Mythical Chest" then return txt end
				local attr = d:GetAttribute("itemName")
				if attr == "Legendary Chest" or attr == "Mythical Chest" then return attr end
			end
		end
		local lname = string.lower(obj.Name or "")
		if lname:find("legendary") then return "Legendary Chest"
		elseif lname:find("mythical") then return "Mythical Chest" end
		return nil
	end

	local function createChestLabel(container, root, rarity)
		local existing = container:FindFirstChild("_ChestBB")
		if existing then
			local lbl = existing:FindFirstChild("ChestName")
			if lbl then
				lbl.Text = rarity
				lbl.TextColor3 = (rarityColors[rarity] and rarityColors[rarity].fill) or Color3.new(1, 1, 1)
			end
			return
		end
		local color = (rarityColors[rarity] and rarityColors[rarity].fill) or Color3.new(1, 1, 1)
		local bb = Instance.new("BillboardGui")
		bb.Name = "_ChestBB"
		bb.Adornee = root
		bb.Size = UDim2.new(0, 120, 0, 24)
		bb.StudsOffset = Vector3.new(0, 4, 0)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Parent = container

		local lbl = Instance.new("TextLabel")
		lbl.Name = "ChestName"
		lbl.Size = UDim2.new(1, 0, 0.55, 0)
		lbl.BackgroundTransparency = 1
		lbl.TextColor3 = color
		lbl.TextStrokeTransparency = 0.2
		lbl.Font = Enum.Font.SourceSansBold
		lbl.TextScaled = true
		lbl.Text = rarity
		lbl.Parent = bb

		local dl = Instance.new("TextLabel")
		dl.Name = "DistanceLabel"
		dl.Size = UDim2.new(1, 0, 0.45, 0)
		dl.Position = UDim2.new(0, 0, 0.55, 0)
		dl.BackgroundTransparency = 1
		dl.TextColor3 = Color3.fromRGB(220, 220, 220)
		dl.Font = Enum.Font.SourceSans
		dl.TextScaled = true
		dl.Text = ""
		dl.Parent = bb

		local hrp = H.getLocalHRP and H.getLocalHRP()
		if hrp and hrp.Parent then
			dl.Text = string.format("%.0f m", (hrp.Position - root.Position).Magnitude)
		end
		H.distanceLabels[dl] = root
	end

	local function destroyChestESP(container)
		local data = H.chestHighlights[container]
		if data then
			if data.highlight then data.highlight:Destroy() end
			H.chestHighlights[container] = nil
		end
		if container then
			local bb = container:FindFirstChild("_ChestBB")
			if bb then
				local dl = bb:FindFirstChild("DistanceLabel")
				if dl then H.distanceLabels[dl] = nil end
				bb:Destroy()
			end
		end
	end

	local function createChestESP(container)
		if not container or not container.Parent then return end
		if H.chestHighlights[container] then return end
		if not looksLikeChestContainer(container) then return end
		local rarity = getChestLabel(container)
		if not rarity or not allowedChestNames[rarity] then return end
		if not H.miscSelectedChests[rarity] then return end
		local root = getVisiblePart(container)
		if not root then return end

		local cols = rarityColors[rarity]
		local hl = Instance.new("SelectionBox")
		hl.Name = "_ChestHL"
		hl.Adornee = container:IsA("Model") and container or root
		hl.Color3 = (cols and cols.fill) or Color3.new(1, 1, 1)
		hl.LineThickness = 0.05
		hl.SurfaceTransparency = 0.85
		hl.SurfaceColor3 = (cols and cols.fill) or Color3.new(1, 1, 1)
		hl.Parent = H.core_gui

		createChestLabel(container, root, rarity)
		H.chestHighlights[container] = { highlight = hl, part = root, rarity = rarity }
	end

	local function clearChestESP()
		local toClear = {}
		for container in pairs(H.chestHighlights) do table.insert(toClear, container) end
		for _, container in ipairs(toClear) do destroyChestESP(container) end
	end

	local function scanCandidate(obj)
		if not obj then return end
		if looksLikeChestContainer(obj) then createChestESP(obj) end
		for _, sub in ipairs(obj:GetDescendants()) do
			if looksLikeChestContainer(sub) then createChestESP(sub) end
		end
	end

	local function refreshChestESP()
		clearChestESP()
		if not H.chestESPEnabled then return end
		local effects = getEffectsFolder()
		if not effects then return end
		for _, child in ipairs(effects:GetChildren()) do scanCandidate(child) end
	end

	H.refreshChestESP = refreshChestESP
	H.clearChestESP = clearChestESP

	local effects = getEffectsFolder()
	if effects then
		effects.ChildAdded:Connect(function(child)
			if not H.chestESPEnabled then return end
			task.delay(0.25, function()
				if child and child.Parent then scanCandidate(child) end
			end)
		end)
		effects.ChildRemoved:Connect(function(child)
			if H.chestHighlights[child] then
				destroyChestESP(child)
				return
			end
			local toRemove = {}
			for tracked in pairs(H.chestHighlights) do
				if tracked == child or tracked == nil or not tracked.Parent then
					table.insert(toRemove, tracked)
				end
			end
			for _, tracked in ipairs(toRemove) do destroyChestESP(tracked) end
		end)
	end
end

-- ============================================================
-- FEATURE: MACHINE ESP
-- ============================================================
local function initMachineESP()
	local H = _G_Hub
	local MACHINE_COLOR = Color3.fromRGB(0, 170, 255)

	local function getVisiblePart(obj)
		if not obj then return nil end
		if obj:IsA("BasePart") then return obj end
		if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
		return obj:FindFirstChildWhichIsA("BasePart", true)
	end

	local function normalizeMachineName(txt)
		if type(txt) ~= "string" or txt == "" then return nil end
		txt = string.lower(txt)
		if txt:find("devil") and txt:find("fruit") then return "Devil Fruit"
		elseif txt:find("fight") and txt:find("style") then return "Fighting Style"
		elseif txt:find("fightingstyle") then return "Fighting Style"
		elseif txt:find("weapon") then return "Weapons"
		elseif txt:find("armor") or txt:find("armour") then return "Armor"
		elseif txt:find("geppo") then return "Geppo"
		elseif txt:find("drink") or txt:find("cola") or txt:find("beverage") then return "Drinks" end
		return nil
	end

	local function detectMachineType(obj)
		if not obj then return nil end
		local attrs = { obj:GetAttribute("VendingType"), obj:GetAttribute("itemName"), obj:GetAttribute("ItemName"), obj:GetAttribute("MachineName"), obj.Name }
		for _, v in ipairs(attrs) do
			local detected = normalizeMachineName(v)
			if detected then return detected end
		end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				local detected = normalizeMachineName(d.ObjectText) or normalizeMachineName(d.ActionText)
				if detected then return detected end
			elseif d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				local detected = normalizeMachineName(d.Text)
				if detected then return detected end
			elseif d:IsA("StringValue") then
				local detected = normalizeMachineName(d.Value)
				if detected then return detected end
			end
		end
		return nil
	end

	local function createMachineLabel(obj, displayName)
		local old = obj:FindFirstChild("_MachBB")
		if old then
			local oldDL = old:FindFirstChild("DistanceLabel")
			if oldDL then H.distanceLabels[oldDL] = nil end
			old:Destroy()
		end
		local root = getVisiblePart(obj)
		if not root then return end

		local bb = Instance.new("BillboardGui")
		bb.Name = "_MachBB"
		bb.Adornee = root
		bb.Size = UDim2.new(0, 130, 0, 28)
		bb.StudsOffset = Vector3.new(0, 4, 0)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.ResetOnSpawn = false
		bb.Parent = obj

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "NameLabel"
		nameLabel.Size = UDim2.new(1, 0, 0.55, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.TextColor3 = MACHINE_COLOR
		nameLabel.TextStrokeTransparency = 0.15
		nameLabel.Font = Enum.Font.SourceSansBold
		nameLabel.TextScaled = true
		nameLabel.Text = displayName
		nameLabel.Parent = bb

		local distLabel = Instance.new("TextLabel")
		distLabel.Name = "DistanceLabel"
		distLabel.Size = UDim2.new(1, 0, 0.45, 0)
		distLabel.Position = UDim2.new(0, 0, 0.55, 0)
		distLabel.BackgroundTransparency = 1
		distLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
		distLabel.TextStrokeTransparency = 0.2
		distLabel.Font = Enum.Font.SourceSans
		distLabel.TextScaled = true
		distLabel.Parent = bb

		local hrp = H.getLocalHRP and H.getLocalHRP()
		if hrp then distLabel.Text = string.format("%.0f m", (hrp.Position - root.Position).Magnitude) else distLabel.Text = "" end
		H.distanceLabels[distLabel] = root
	end

	local function createMachineESP(obj)
		if not obj or not obj.Parent then return end
		if H.machineHighlights[obj] then return end
		local displayName = detectMachineType(obj)
		if not displayName then return end
		local root = getVisiblePart(obj)
		if not root then return end

		local hl = Instance.new("SelectionBox")
		hl.Name = "_MachineHL"
		hl.Adornee = obj:IsA("Model") and obj or root
		hl.Color3 = MACHINE_COLOR
		hl.LineThickness = 0.05
		hl.SurfaceTransparency = 0.8
		hl.SurfaceColor3 = MACHINE_COLOR
		hl.Parent = H.core_gui

		createMachineLabel(obj, displayName)
		H.machineHighlights[obj] = { highlight = hl, name = displayName, root = root }
	end

	local function removeMachineESP(obj)
		local data = H.machineHighlights[obj]
		if not data then return end
		if data.highlight then data.highlight:Destroy() end
		local bb = obj and obj:FindFirstChild("_MachBB")
		if bb then
			local dl = bb:FindFirstChild("DistanceLabel")
			if dl then H.distanceLabels[dl] = nil end
			bb:Destroy()
		end
		H.machineHighlights[obj] = nil
	end

	local function clearMachineESP()
		for obj, _ in pairs(H.machineHighlights) do removeMachineESP(obj) end
	end

	local function isMachineCandidate(obj)
		if not obj then return false end
		return detectMachineType(obj) ~= nil
	end

	local function refreshMachineESP()
		clearMachineESP()
		if not H.machineESPEnabled then return end
		local env = workspace:FindFirstChild("Env")
		if not env then return end
		for _, child in ipairs(env:GetChildren()) do
			if isMachineCandidate(child) then createMachineESP(child) end
		end
	end

	H.refreshMachineESP = refreshMachineESP
	H.clearMachineESP = clearMachineESP

	workspace.ChildRemoved:Connect(function(child)
		if H.machineHighlights[child] then removeMachineESP(child) end
	end)

	local env = workspace:FindFirstChild("Env")
	if env then
		env.ChildAdded:Connect(function(child)
			if not H.machineESPEnabled then return end
			task.delay(0.3, function()
				if child and child.Parent and isMachineCandidate(child) then createMachineESP(child) end
			end)
		end)
		env.ChildRemoved:Connect(function(child)
			if H.machineHighlights[child] then removeMachineESP(child) end
		end)
	end
end

-- ============================================================
-- FEATURE: DISTANCE LABELS LOOP
-- ============================================================
do
	local H = _G_Hub
	local lastDist = 0
	H.run_svc.Heartbeat:Connect(function()
		local now = tick()
		if now - lastDist < 0.2 then return end
		lastDist = now
		local hrp = H.getLocalHRP()
		if not hrp then return end
		local hp = hrp.Position
		for dl, part in pairs(H.distanceLabels) do
			if dl and dl.Parent and part and part.Parent then
				dl.Text = string.format("%.0f m", (hp - part.Position).Magnitude)
			else
				H.distanceLabels[dl] = nil
			end
		end
	end)
end

-- ============================================================
-- FEATURE: PLAYER ESP
-- ============================================================
local function initPlayerESP()
	local esp_library = {
		settings = {
			master_switch = false;
			boxes = {
				enabled = true;
				color  = Color3.fromRGB(255,255,255);
				gradient = {true, Color3.fromRGB(255,255,255), Color3.fromRGB(119, 120, 255)};
				filled = {
					enabled = true;
					transparency = 0.75;
					color = Color3.fromRGB(255,255,255);
				},
				animate = true;
				animatespeed = 250;
				bounding = true;
			};
			names = {
				enabled = true;
				color = Color3.fromRGB(255,255,255);
				outline = true;
				type = "lower"; 
				layout = "Center" 
			};
			flags = {
				distance = {true, Color3.fromRGB(255,255,255)};
				tool = {true, Color3.fromRGB(255,255,255)};
				state = {true, Color3.fromRGB(255,255,255)};
			};
			health_bars = {
				enabled = true;
				color = Color3.fromRGB(255, 255, 255);
				use_health_color = false;
				gradient = {true, Color3.fromRGB(255,255,255), Color3.fromRGB(119, 120, 255)};
				text = true;
				offset = 6;
				thickness = 1;
			};
		};
	};

	local workspace, run_service, players, core_gui, lighting, user_input_service = cloneref(game:GetService("Workspace")), cloneref(game:GetService("RunService")), cloneref(game:GetService("Players")), cloneref(game:GetService("CoreGui")), cloneref(game:GetService("Lighting")), game:GetService("UserInputService");
	local localplayer, camera = players.LocalPlayer, workspace.CurrentCamera;
	local world_to_viewport = camera.WorldToViewportPoint;
	local inf = math.huge;
	local _tick = tick();
	local rotation_angle = 90;
	local obj = {
		inew = Instance.new; v2new = Vector2.new; v3new = Vector3.new; cframenew = CFrame.new;
		u2new = UDim2.new; u2formscale = UDim2.fromScale; floor = math.floor; max = math.max;
		abs = math.abs; tan = math.tan; rad = math.rad; rgb = Color3.fromRGB; hsv = Color3.fromHSV;
	}

	local funcs = {};
	do
		function funcs:create(class, properties)
			local instance = obj.inew(class);
			for property, value in properties do instance[property] = value; end;
			return instance;
		end;

		function funcs:vector_2_floor(position) return obj.v2new(obj.floor(position.X), obj.floor(position.Y)) end

		function funcs:cframe_to_viewport(cframe, floor)
			local position, visible = world_to_viewport(camera, cframe * (cframe - cframe.p):ToObjectSpace(camera.CFrame - camera.CFrame.p).p)
			if floor then position = funcs:vector_2_floor(position) end
			return position, visible
		end   

		function funcs:get_box_size(position, cframe)
			if esp_library.settings.boxes.bounding then
				local size = obj.v3new(4, 5.75, 1.5)
				local x = funcs:cframe_to_viewport(cframe * obj.cframenew(size.X, 0, 0))
				local y = funcs:cframe_to_viewport(cframe * obj.cframenew(0, size.Y, 0))
				local z = funcs:cframe_to_viewport(cframe * obj.cframenew(0, 0, size.Z))
				local SizeX = obj.max(obj.abs(position.X - x.X), obj.abs(position.X - z.X))
				local SizeY = obj.max(obj.abs(position.Y - y.Y), obj.abs(position.Y - x.Y))
				return obj.v2new(math.clamp(obj.floor(SizeX), 3, inf), math.clamp(obj.floor(SizeY), 6, inf))
			else
				local distance = (camera.CFrame.p - cframe.p).magnitude
				local factor = 1 / ((distance / 3) * math.tan(math.rad(camera.FieldOfView / 2)) * 2) * 1000
				return obj.v2new(math.clamp(obj.floor(factor * 1.3), 3, inf), math.clamp(obj.floor(factor * 2.1), 6, inf))
			end
		end
	end;
	do
		do
			-- proggyclean removed (dead link)
			local _getasset = (typeof(getcustomasset) == "function" and getcustomasset) or (typeof(getsynasset) == "function" and getsynasset) or nil
			if not _getasset then
				_getasset = function(path) return "rbxasset://" .. path end
			end
			Font = setreadonly(Font, false);
			function Font:Register(Name, Weight, Style, Asset)
				if not isfile(Name .. ".font") then
					if not isfile(Asset.Id) then writefile(Asset.Id, Asset.Font); end;
					local Data = { name = Name, faces = {{ name = "Regular", weight = Weight, style = Style, assetId = _getasset(Asset.Id); }} };
					writefile(Name .. ".font", game:GetService("HttpService"):JSONEncode(Data));
					return _getasset(Name .. ".font");
				end;
			end;
			function Font:GetRegistry(Name)
				if isfile(Name .. ".font") then return _getasset(Name .. ".font"); end;
			end;
			Font:Register("proggyclean", 400, "normal", {Id = "proggyclean.ttf", Font = ""});
		end

		local _fontReg = Font:GetRegistry("proggyclean")
		local text_font = _fontReg and Font.new(_fontReg) or Font.new("rbxasset://fonts/families/RobotoMono.json");
		local screen_gui = funcs:create("ScreenGui", { Parent = core_gui, ResetOnSpawn = false, IgnoreGuiInset = true })
		_G_Hub.esp_screen_gui = screen_gui 

		local _esp_tick = tick()
		local _esp_rot  = 90
		run_service.RenderStepped:Connect(function()
			if not esp_library.settings.master_switch then
				if _G_Hub.esp_objects then
					for _, d in pairs(_G_Hub.esp_objects) do
						d.box_main.Visible = false
						d.nametag.Visible  = false
						d.behind_healthbar.Visible = false
					end
				end
				return
			end

			local lp_char = localplayer.Character
			local lp_hrp  = lp_char and lp_char:FindFirstChild("HumanoidRootPart")
			local now = tick()
			local dt  = now - _esp_tick
			_esp_tick = now

			if esp_library.settings.boxes.animate then
				_esp_rot = _esp_rot + dt * esp_library.settings.boxes.animatespeed * math.cos(math.pi / 4 * now - math.pi / 2)
			else _esp_rot = 90 end

			local sett  = esp_library.settings
			local boxes = sett.boxes
			local names = sett.names
			local flags = sett.flags
			local hbars = sett.health_bars

			local cs_box = ColorSequence.new{ ColorSequenceKeypoint.new(0, boxes.gradient[2]), ColorSequenceKeypoint.new(1, boxes.gradient[3]) }
			local cs_hp = ColorSequence.new{ ColorSequenceKeypoint.new(0, hbars.gradient[2]), ColorSequenceKeypoint.new(1, hbars.gradient[3]) }

			if not _G_Hub.esp_objects then return end

			for pName, d in pairs(_G_Hub.esp_objects) do
				local player = d.player
				if not player or not player.Parent then
					d.box_main.Visible = false; d.nametag.Visible  = false; d.behind_healthbar.Visible = false
					_G_Hub.esp_objects[pName] = nil
					local f = screen_gui:FindFirstChild(pName)
					if f then f:Destroy() end
				else
					local char = player.Character
					local hrp  = char and char:FindFirstChild("HumanoidRootPart")
					local hum  = char and char:FindFirstChild("Humanoid")

					if not hrp or not hum or hum.Health <= 0 then
						d.box_main.Visible = false; d.nametag.Visible  = false; d.behind_healthbar.Visible = false
					else
						local sp, visible = camera:WorldToViewportPoint(hrp.Position)
						if not visible then
							d.box_main.Visible = false; d.nametag.Visible  = false; d.behind_healthbar.Visible = false
						else
							local spv2    = obj.v2new(sp.X, sp.Y)
							local box_sz  = funcs:get_box_size(spv2, hrp.CFrame * obj.cframenew(0,.25,0))
							local box_pos = funcs:vector_2_floor(spv2 + obj.v2new(0,5) - box_sz / 2)

							if boxes.enabled then
								d.box_main.Visible   = true
								d.box_main.Position  = UDim2.new(0, box_pos.X, 0, box_pos.Y)
								d.box_main.Size      = UDim2.new(0, box_sz.X, 0, box_sz.Y)
								if boxes.filled.enabled then
									d.box_main.BackgroundTransparency = boxes.filled.transparency
									d.box_main.BackgroundColor3       = boxes.filled.color
								else d.box_main.BackgroundTransparency = 1 end
								d.box_outline.Enabled = true
								d.box_outline.Color   = boxes.color
								local use_grad = boxes.gradient[1]
								d.box_gradient.Enabled          = use_grad
								d.box_outline_gradient.Enabled  = use_grad
								if use_grad then
									d.box_gradient.Color         = cs_box
									d.box_outline_gradient.Color = cs_box
								end
								d.box_gradient.Rotation         = _esp_rot
								d.box_outline_gradient.Rotation = _esp_rot
							else
								d.box_main.Visible    = false
								d.box_outline.Enabled = false
							end

							if names.enabled then
								d.nametag.Visible = true
								d.nametag.TextColor3 = names.color
								d.nametag.TextStrokeTransparency = names.outline and 0 or 1
								local dName = "Unknown"
								pcall(function() dName = player.DisplayName or player.Name end)
								local lower  = string.lower(dName)
								local higher = string.upper(dName)
								d.nametag.Size     = UDim2.new(0, box_sz.X, 0, 0)
								d.nametag.Position = UDim2.new(0, box_pos.X, 0, box_pos.Y - 10)
								d.nametag.TextXAlignment = Enum.TextXAlignment[names.layout]
								if flags.distance[1] and lp_hrp then
									local dist = obj.floor((lp_hrp.Position - hrp.Position).Magnitude)
									if names.type == "lower" then d.nametag.Text = lower .. ' (<font color="rgb(119,120,255)">' .. dist .. '</font>)'
									else d.nametag.Text = higher .. ' (<font color="rgb(255,0,0)">' .. dist .. '</font>)' end
								else
									d.nametag.Text = names.type == "lower" and lower or higher
								end
							else
								d.nametag.Visible = false
							end

							if hbars.enabled then
								d.behind_healthbar.Visible  = true
								d.behind_healthbar.Size     = UDim2.new(0, hbars.thickness, 0, box_sz.Y)
								d.behind_healthbar.Position = UDim2.new(0, box_pos.X - hbars.offset, 0, box_pos.Y)
								local health = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
								d.inside_healthbar.Size = UDim2.fromScale(1, health)
								d.health_bar_text.Visible = hbars.text
								if hbars.text then
									d.health_bar_text.Text = tostring(obj.floor(health * 100 + 0.5))
									d.health_bar_text.TextColor3 = hbars.color
									d.health_bar_text.Size     = UDim2.new(1,0,0,0)
									d.health_bar_text.Position = UDim2.new(0,-25,0,0)
								end
								if hbars.use_health_color then
									d.inside_healthbar.BackgroundColor3 = Color3.fromHSV(health * 0.3, 1, 1)
									d.health_bar_gradient.Enabled = false
								else
									d.inside_healthbar.BackgroundColor3 = hbars.color
									local use_hg = hbars.gradient[1]
									d.health_bar_gradient.Enabled = use_hg
									if use_hg then d.health_bar_gradient.Color = cs_hp end
								end
							else
								d.behind_healthbar.Visible = false
							end
						end
					end
				end
			end
		end)

		local remove_esp = function(playerName)
			local pName = typeof(playerName) == "Instance" and playerName.Name or playerName
			if _G_Hub.esp_connections[pName] then
				_G_Hub.esp_connections[pName]:Disconnect()
				_G_Hub.esp_connections[pName] = nil
			end
			if _G_Hub.esp_objects and _G_Hub.esp_objects[pName] then _G_Hub.esp_objects[pName] = nil end
			if screen_gui:FindFirstChild(pName) then
				screen_gui[pName]:ClearAllChildren();
				screen_gui[pName]:Destroy();
			end;
		end;

		local create_esp = function(player)
			local playerName = player.Name
			local player_folder = funcs:create("Folder", {Parent = screen_gui, Name = playerName})
			local box_main = funcs:create("Frame", {Visible = false; Parent = player_folder, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0});
			local box_outline = funcs:create("UIStroke", {Parent = box_main, Enabled = false, Transparency = 0, Color = Color3.fromRGB(255, 255, 255)});
			local box_gradient = funcs:create("UIGradient", {Rotation = 90,Parent = box_main, Enabled = false, Color = ColorSequence.new{ColorSequenceKeypoint.new(0, esp_library.settings.boxes.gradient[2]), ColorSequenceKeypoint.new(1, esp_library.settings.boxes.gradient[3])}})
			local box_outline_gradient = funcs:create("UIGradient", {Rotation = 90,Parent = box_outline, Enabled = false, Color = ColorSequence.new{ColorSequenceKeypoint.new(0, esp_library.settings.boxes.gradient[2]), ColorSequenceKeypoint.new(1, esp_library.settings.boxes.gradient[3])}})
			local nametag = funcs:create("TextLabel", {Name = "nametag", BackgroundTransparency = 1, RichText = true, TextXAlignment = Enum.TextXAlignment.Center; BorderSizePixel = 0, Visible = false, Parent = player_folder, TextSize = 12, FontFace = text_font, TextStrokeTransparency = 0, TextColor3 = Color3.fromRGB(255,255,255), AutomaticSize = Enum.AutomaticSize.X});
			local behind_healthbar = funcs:create("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Parent = player_folder, Visible = false});
			local health_bar_outline = funcs:create("UIStroke", {Parent = behind_healthbar,Transparency = 0, Color = Color3.fromRGB(0, 0, 0)});
			local inside_healthbar = funcs:create("Frame", {Parent = behind_healthbar, AnchorPoint = obj.v2new(0,1), Position = UDim2.new(0,0,1,0), Size = UDim2.new(1,0,0,0)})
			local health_bar_gradient = funcs:create("UIGradient", {Rotation = 90,Parent = inside_healthbar, Enabled = false, Color = ColorSequence.new{ColorSequenceKeypoint.new(0, esp_library.settings.health_bars.gradient[2]), ColorSequenceKeypoint.new(1, esp_library.settings.health_bars.gradient[3])}})
			local health_bar_text = funcs:create("TextLabel", {Name = "healthtext", BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Center; BorderSizePixel = 0, Visible = false, Parent = inside_healthbar, TextSize = 12, FontFace = text_font, TextStrokeTransparency = 0, TextColor3 = Color3.fromRGB(255,255,255), AutomaticSize = Enum.AutomaticSize.X});
			_G_Hub.esp_objects = _G_Hub.esp_objects or {}
			_G_Hub.esp_objects[playerName] = {
				player               = player,
				box_main             = box_main,
				box_outline          = box_outline,
				box_gradient         = box_gradient,
				box_outline_gradient = box_outline_gradient,
				nametag              = nametag,
				behind_healthbar     = behind_healthbar,
				inside_healthbar     = inside_healthbar,
				health_bar_gradient  = health_bar_gradient,
				health_bar_text      = health_bar_text,
			}
		end;
		do
			for _, v in game:GetService("Players"):GetPlayers() do
				if v ~= localplayer then coroutine.wrap(create_esp)(v) end
			end
			game:GetService("Players").PlayerAdded:Connect(function(a) coroutine.wrap(create_esp)(a) end)
			game:GetService("Players").PlayerRemoving:Connect(function(player) coroutine.wrap(remove_esp)(player) end)
		end
	end

	_G_Hub.esp_library = esp_library
end

-- ============================================================
-- FEATURE: MOVEMENT
-- ============================================================
local function initMovement()
	local H=_G_Hub
	local function stopWS()
		if H.walkspeedConn then H.walkspeedConn:Disconnect(); H.walkspeedConn=nil end
	end
	local function startWS()
		stopWS()
		H.walkspeedConn=H.RunService.Heartbeat:Connect(function(delta)
			if not H.walkspeedEnabled or H.walkspeedValue<=16 then return end
			local char=H.lp.Character or H.getCharFolder(); if not char then return end
			local hum=char:FindFirstChild("Humanoid"); local rp=char:FindFirstChild("HumanoidRootPart")
			if not hum or not rp or hum.Health<=0 then return end

			local camCF = workspace.CurrentCamera.CFrame
			local dir = Vector3.zero
			if H.keys[H.KC_W] then dir = dir + camCF.LookVector end
			if H.keys[H.KC_S] then dir = dir - camCF.LookVector end
			if H.keys[H.KC_A] then dir = dir - camCF.RightVector end
			if H.keys[H.KC_D] then dir = dir + camCF.RightVector end
			dir = Vector3.new(dir.X, 0, dir.Z)

			local cv=rp.AssemblyLinearVelocity

			if dir.Magnitude>0 then
				dir = dir.Unit 
				rp.AssemblyLinearVelocity=Vector3.new(dir.X*H.walkspeedValue,cv.Y,dir.Z*H.walkspeedValue)
				hum:MoveTo(rp.Position+dir*50)
			else
				hum:MoveTo(rp.Position)
				rp.AssemblyLinearVelocity=Vector3.new(0,cv.Y,0)
			end
		end)
	end
	H.stopWalkSpeed=stopWS; H.startWalkSpeed=startWS

	local noclipParts={}; local noclipChar=nil; local noclipRefresh=0;
	local lastNoclip=0
	H.run_svc.Stepped:Connect(function()
		if not H.noclipActive then return end
		local now=tick(); if now-lastNoclip<0.05 then return end; lastNoclip=now
		local folder=H.getCharFolder(); if not folder then return end
		if folder~=noclipChar or now-noclipRefresh>=3 then
			noclipChar=folder; noclipRefresh=now; noclipParts={}
			for _,p in ipairs(folder:GetDescendants()) do
				if p:IsA("BasePart") then noclipParts[#noclipParts+1]=p end
			end
		end
		for i=1,#noclipParts do
			local p=noclipParts[i]; if p and p.Parent then p.CanCollide=false end
		end
	end)

	local function fireSkyWalk()
		-- no-op: removed to avoid consuming geppo server-side during fly
	end
	local function stopFly()
		if H.flyMoveConn then H.flyMoveConn:Disconnect(); H.flyMoveConn=nil end
		if H.flyStamConn then H.flyStamConn:Disconnect(); H.flyStamConn=nil end
		if H.flyBV then H.flyBV:Destroy(); H.flyBV=nil end
		if H.flyBG then H.flyBG:Destroy(); H.flyBG=nil end
	end
	local function startFly()
		stopFly()
		local folder=H.getCharFolder();
		if not folder then return end
		local hrp=folder:FindFirstChild("HumanoidRootPart");
		if not hrp then return end
		H.flyBV=Instance.new("BodyVelocity");
		H.flyBV.Velocity=Vector3.zero
		H.flyBV.MaxForce=Vector3.new(1e5,1e5,1e5); H.flyBV.Parent=hrp
		H.flyBG=Instance.new("BodyGyro");
		H.flyBG.MaxTorque=Vector3.new(1e5,1e5,1e5)
		H.flyBG.CFrame=hrp.CFrame; H.flyBG.Parent=hrp
		H.flyMoveConn=H.run_svc.RenderStepped:Connect(function()
			local cam2=workspace.CurrentCamera; local dir=Vector3.zero
			if H.UIS:IsKeyDown(H.KC_W) then dir+=cam2.CFrame.LookVector  end
			if H.UIS:IsKeyDown(H.KC_S) then dir-=cam2.CFrame.LookVector  end
			if H.UIS:IsKeyDown(H.KC_A) then dir-=cam2.CFrame.RightVector end
			if H.UIS:IsKeyDown(H.KC_D) then dir+=cam2.CFrame.RightVector end
			H.flyBV.Velocity=dir.Magnitude>0 and dir.Unit*H.flySpeed or Vector3.zero
			H.flyBG.CFrame=cam2.CFrame
		end)
		local ls=0
		H.flyStamConn=H.run_svc.Stepped:Connect(function()
			local now=tick(); if now-ls>=1 then ls=now; fireSkyWalk() end
		end)
	end
	H.stopFly=stopFly;
	H.startFly=startFly

	local ijChar=H.lp.Character or H.lp.CharacterAdded:Wait()
	local ijHum=ijChar:WaitForChild("Humanoid"); local ijRP=ijChar:WaitForChild("HumanoidRootPart")
	local ijJC=0;
	local ijLJ=0; local ijGround=true; local ijPend=false
	local ijCfg={infiniteJumps=true,maxJumps=3,jumpPower=50,jumpCooldown=0.15}
	local function ijState(hum)
		hum.StateChanged:Connect(function(_,new)
			if new==Enum.HumanoidStateType.Landed or new==Enum.HumanoidStateType.Running then ijGround=true; ijJC=0
			elseif new==Enum.HumanoidStateType.Freefall or new==Enum.HumanoidStateType.Jumping then ijGround=false end
		end)
	end
	ijState(ijHum)
	H.run_svc.Heartbeat:Connect(function()
		if not ijPend then return end; ijPend=false
		if ijHum and ijHum.Health>0 and ijRP then
			local v=ijRP.AssemblyLinearVelocity
			ijRP.AssemblyLinearVelocity=Vector3.new(v.X,ijCfg.jumpPower,v.Z)
			ijHum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
	H.UIS.InputBegan:Connect(function(inp,gp)
		if gp then return end
		if inp.KeyCode==Enum.KeyCode.Space or inp.KeyCode==Enum.KeyCode.ButtonA then
			if not H.infiniteJumpEnabled or ijGround then return end
			local now=tick();
			if now-ijLJ<ijCfg.jumpCooldown then return end
			if not ijCfg.infiniteJumps and ijJC>=ijCfg.maxJumps then return end
			ijPend=true;
			ijLJ=now; ijJC+=1
		end
	end)
	H.lp.CharacterAdded:Connect(function(nc)
		ijChar=nc; ijHum=nc:WaitForChild("Humanoid"); ijRP=nc:WaitForChild("HumanoidRootPart")
		ijJC=0; ijGround=true; ijPend=false; ijState(ijHum)
	end)
end

-- ============================================================
-- FEATURE: TAKESTAM / DASH
-- ============================================================
local function initDash()
	local H=_G_Hub
	local RS=game:GetService("ReplicatedStorage")
	local takestamEvent=RS:WaitForChild("Events"):WaitForChild("takestam")
	local function fireTakestamDirect()
		H.bypassBlock=true;
		local args = {
			0.925,
			"dash",
			CFrame.new(-2956.091552734375, 49.7537841796875, -6745.8779296875, -0.29613688588142395, -5.081314498056599e-07, 0.955145537853241, -0.0000016258290997939184, 1, 2.791561470871784e-08, -0.955145537853241, -0.0000015446364614035701, -0.29613688588142395)
		}
		takestamEvent:FireServer(unpack(args))
		H.bypassBlock=false
	end
	H.fireTakestamDirect=fireTakestamDirect
	local oldNC
	oldNC=hookmetamethod(game,"__namecall",function(self,...)
		if getnamecallmethod()=="FireServer" then
			local ok,ev=pcall(function() return RS.Events.takestam end)
			if ok and ev and self==ev then
				if not H.bypassBlock and H.blockTakestam then return end
			end
		end
		return oldNC(self,...)
	end)
	H.toggleNoDashCD=function(val)
		H.noDashCDEnabled=val
		if val then
			if H.dashHooked then return end
			local ok,DT=pcall(require,game.ReplicatedStorage.Util.Movement.DashTypes)
			if not ok or typeof(DT)~="table" then return end
			local nd=rawget(DT,"dash"); if typeof(nd)~="function" then return end
			H.DashTypes_ref=DT; H.originalDash=nd;
			H.dashHooked=true
			rawset(DT,"dash",function(...) coroutine.wrap(nd)(...) end)
		else
			if H.DashTypes_ref and H.originalDash then
				rawset(H.DashTypes_ref,"dash",H.originalDash);
				H.dashHooked=false
			end
		end
	end
end

-- ============================================================
-- FEATURE: NO STUN
-- ============================================================
local function initNoStun()
	local H = _G_Hub
	H.noStunEnabled = false
	H.run_svc.Heartbeat:Connect(function()
		if not H.noStunEnabled then return end
		local char = H.lp.Character
		if not char then return end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChild("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end

		if hrp.Anchored then hrp.Anchored = false end
		if hum.Sit then hum.Sit = false end

		local limit = 60
		if H.walkspeedEnabled and H.walkspeedValue > 60 then
			limit = H.walkspeedValue + 20
		end

		local vel = hrp.AssemblyLinearVelocity
		if Vector2.new(vel.X, vel.Z).Magnitude > limit then
			hrp.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
		end
	end)

	local function connectChar(char)
		local rp = char:WaitForChild("HumanoidRootPart")
		rp.ChildAdded:Connect(function(child)
			if not H.noStunEnabled then return end
			if child:IsA("Attachment") or child:IsA("LinearVelocity")
				or child:IsA("AngularVelocity") or child:IsA("BodyVelocity")
				or child:IsA("BodyPosition") then
				task.defer(function()
					if child and child.Parent and H.noStunEnabled then child:Destroy() end
				end)
			end
		end)
	end

	if H.lp.Character then connectChar(H.lp.Character) end
	H.lp.CharacterAdded:Connect(connectChar)
end

-- ============================================================
-- FEATURE: SKIN CHANGER
-- ============================================================
local function initSkinChanger()
	local H = _G_Hub
	H.SKIN_MATERIAL_LIST = { "Neon", "ForceField", "Glass", "SmoothPlastic", "Plastic", "Metal", "DiamondPlate", "Foil", "Cobblestone", "Concrete", "Fabric", "Grass", "Ice", "Marble", "Pebble", "Rock", "Sand", "Slate", "Wood", "WoodPlanks", }
	H.skinChangerEnabled  = false
	H.skinChangerColor    = Color3.fromRGB(255, 105, 180)
	H.skinChangerMaterial = Enum.Material.Neon
	H.skinChangerConn     = nil

	local function applyAppearance()
		local folder = H.getCharFolder()
		if not folder then return end
		for _, p in ipairs(folder:GetDescendants()) do
			if p and p.Parent and p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				pcall(function()
					p.Color    = H.skinChangerColor
					p.Material = H.skinChangerMaterial
				end)
			end
		end
	end

	H.startSkinChanger = function()
		if H.skinChangerConn then return end
		local lastSkin = 0
		H.skinChangerConn = H.run_svc.Heartbeat:Connect(function()
			local now = tick()
			if now - lastSkin < 1.0 then return end
			lastSkin = now
			applyAppearance()
		end)
	end

	H.stopSkinChanger = function()
		if H.skinChangerConn then
			H.skinChangerConn:Disconnect()
			H.skinChangerConn = nil
		end
	end

	H.applySkinAppearance = applyAppearance
end

-- ============================================================
-- FEATURE: NAME CHANGER
-- ============================================================
local function initNameChanger()
	local H=_G_Hub
	H.fakeName="";
	H.nameChangerEnabled=false
	local realName=H.lp.Name; local realDisplay=H.lp.DisplayName
	local function noccase(s)
		return (s:gsub("%a",function(c) return string.format("[%s%s]",string.lower(c),string.upper(c)) end))
	end
	local mt=getrawmetatable(game);
	local oldNewIndex=mt.__newindex
	setreadonly(mt,false)
	mt.__newindex=newcclosure(function(self,key,value)
		if not checkcaller() and H.nameChangerEnabled and H.fakeName~="" then
			if typeof(self) == "Instance" and key=="Text" then
				if self:IsA("TextLabel") or self:IsA("TextBox") or self:IsA("TextButton") then
					if type(value)=="string" then
						local lv=value:lower()
						if lv:find(realName:lower()) or lv:find(realDisplay:lower()) then
							value=value:gsub(noccase(realDisplay),H.fakeName)
							value=value:gsub(noccase(realName),H.fakeName)
						end
					end
				end
			end
		end
		return oldNewIndex(self,key,value)
	end)
	setreadonly(mt,true)
	local function sweepAndReplace(parent,oldFake)
		if not parent then return end
		pcall(function() 
			for _,obj in ipairs(parent:GetDescendants()) do
				if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
					local cur=obj.Text;
					local changed=false
					if oldFake and oldFake~="" and cur:find(oldFake,1,true) then
						local safe=oldFake:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]","%%%1")
						cur=cur:gsub(noccase(safe),H.fakeName);
						changed=true
					end
					local lc=cur:lower()
					if lc:find(realName:lower()) or lc:find(realDisplay:lower()) then
						cur=cur:gsub(noccase(realDisplay),H.fakeName)
						cur=cur:gsub(noccase(realName),H.fakeName);
						changed=true
					end
					if changed and obj.Text~=cur then pcall(function() obj.Text=cur end) end
				end
			end
		end)
	end
	H.applyNameChanger=function(newName)
		local oldFake=H.fakeName; H.fakeName=newName
		H.nameChangerEnabled=(newName~=nil and newName~="")
		if H.nameChangerEnabled then
			if H.lp.Character then sweepAndReplace(H.lp.Character,oldFake) end
			local pg=H.lp:FindFirstChild("PlayerGui");
			if pg then sweepAndReplace(pg,oldFake) end
			pcall(function() sweepAndReplace(game:GetService("CoreGui"),oldFake) end)
		end
	end
	local lastSweep=0
	H.RunService.Heartbeat:Connect(function()
		if not H.nameChangerEnabled or H.fakeName=="" then return end
		local now=tick(); if now-lastSweep<0.2 then return end; lastSweep=now
		if H.lp.Character then sweepAndReplace(H.lp.Character,nil) end
	end)
end

-- ============================================================
-- FEATURE: AUTO FARM (USING FACEMOUSE TELEPORT)
-- ============================================================
local function initAutoFarm()
	local H = _G_Hub
	local RS = game:GetService("ReplicatedStorage")
	getgenv().LevelFarm = false
	local AF = {}
	AF.isRunning        = false
	AF.meleeCheckConn   = nil
	AF.canAttack        = true
	AF.LoopID           = 0

	local GLOBAL_CONFIG = { QUEST_WAIT_TIME = 1, COMBO_DELAY = 0.21, FULL_COMBO_WAIT = 1.2, MAX_LEVEL = 675 }
	local ZONE_HEIGHT_DEFAULTS = { [1] = 8.2,  [2] = 8.4,  [3] = 8.6, [4] = 7.5,  [5] = 8.6,  [6] = 8.5 }

	local ZONES = {
		[1] = {MinLevel=1,  MaxLevel=15, TargetName="Bandit", QuestName="Help Daph", QuestPos=CFrame.new(-578.106, 5.950, -3430.464), Method="1by1", Center=CFrame.new(-641.306, 8.450, -3471.585), ZoneKey=1},
		[2] = {MinLevel=16, MaxLevel=35, TargetName="Zou Inhabitant", QuestName="Help Zen", QuestMinLevel=30, QuestPos=CFrame.new(-3172.777, 11.734, -5227.068), Method="Group", Center=CFrame.new(-3246.290, 10.609, -5255.139), ZoneKey=2},
		[3] = {MinLevel=36, MaxLevel=75, TargetName="Saw Shark Pirate", QuestName="Help Waby", QuestMinLevel=70, QuestPos=CFrame.new(-1891.602, 12.299, -10230.563), Method="Group", Center=CFrame.new(-1943.006, 10.999, -10094.187), ZoneKey=3},
		[4] = {MinLevel=76, MaxLevel=425, TargetName="Fishman Karate User", QuestName="Help becky", QuestMinLevel=190, WalkTo=CFrame.new(7772.802, -2163.832, -17144.355), QuestPos=CFrame.new(7731.026, -2175.832, -17222.637), Method="Group", Center=CFrame.new(7736.441, -2176.832, -17308.871), ZoneKey=4},

	}

	local function getZoneHeight(zoneKey) return ZONE_HEIGHT_DEFAULTS[zoneKey] or 8.6 end

	local mystats        = RS:FindFirstChild("Stats" .. H.lp.Name)
	local stats          = mystats and mystats:FindFirstChild("Stats")
	local levelValue     = stats and stats:FindFirstChild("Level")
	local currentquest   = mystats and mystats.Quest and mystats.Quest.CurrentQuest

	local combatRegister  = RS:WaitForChild("Events"):WaitForChild("CombatRegister")
	local combatAnimations= RS:WaitForChild("CombatAnimations"):WaitForChild("Melee")
	local questEvent      = RS:WaitForChild("Events"):WaitForChild("Quest")

	local CombatAnims = {
		[1] = combatAnimations.Punch1, [2] = combatAnimations.Punch2,
		[3] = combatAnimations.Punch3, [4] = combatAnimations.GroundPunch4,
		[5] = combatAnimations.GroundPunch5,
	}

	local function afFloat(bool)
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if not rp then return end
		if bool then
			if not rp:FindFirstChild("AF_BV") then
				local bv = Instance.new("BodyVelocity", rp)
				bv.Name = "AF_BV"; bv.MaxForce = Vector3.new(1e5, 1e5, 1e5); bv.Velocity = Vector3.zero
			end
		else
			local bv = rp:FindFirstChild("AF_BV")
			if bv then bv:Destroy() end
		end
	end

	local function getLevel() return levelValue and levelValue.Value or 0 end

	local function getZone(lvl)
		for _, z in ipairs(ZONES) do
			if lvl >= z.MinLevel and lvl <= z.MaxLevel then return z end
		end
	end

	local function equipMelee()
		local backpack = H.lp:FindFirstChild("Backpack")
		if not backpack then return false end
		local melee = backpack:FindFirstChild("Melee")
		if not melee then
			local char = H.lp.Character
			if char and char:FindFirstChild("Melee") then return true end
			return false
		end
		local pcFolder = workspace:FindFirstChild("PlayerCharacters")
		local pc = pcFolder and pcFolder:FindFirstChild(H.lp.Name)
		if not pc then pc = H.lp.Character end
		if pc then melee.Parent = pc; return true end
		return false
	end

	local function waitForRespawn(timeout)
		local startTime = tick()
		timeout = timeout or 15
		while tick() - startTime < timeout do
			local char = H.lp.Character
			local hum = char and char:FindFirstChild("Humanoid")
			local rp = char and char:FindFirstChild("HumanoidRootPart")
			local pcFolder = workspace:FindFirstChild("PlayerCharacters")
			local pc = pcFolder and pcFolder:FindFirstChild(H.lp.Name)
			if char and hum and hum.Health > 0 and rp and pc then return char, hum, rp end
			task.wait(0.2)
		end
		return nil
	end

	local function isMeleeEquipped()
		local pc = workspace:FindFirstChild("PlayerCharacters")
		if not pc then return false end
		local cf = pc:FindFirstChild(H.lp.Name)
		return cf and cf:FindFirstChild("Melee") ~= nil
	end

	local function getNPCID(npc)
		if not npc then return nil end
		local v = npc:FindFirstChild("NPCID")
		if v then return v.Value end
		local cfg = npc:FindFirstChild("Configuration")
		if cfg then
			v = cfg:FindFirstChild("NPCID")
			if v then return v.Value end
		end
		return npc:GetAttribute("NPCID")
	end

	local function getAllNPCs(name)
		local res = {}
		local function scanFolder(folderName)
			local folder = workspace:FindFirstChild(folderName)
			if not folder then return end
			for _, v in pairs(folder:GetChildren()) do
				if v:IsA("Model") and string.find(string.lower(v.Name), string.lower(name)) then
					local hum = v:FindFirstChild("Humanoid")
					local hrp = v:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health > 0 and hrp then
						table.insert(res, {npc=v, hrp=hrp})
					end
				end
			end
		end
		scanFolder("NPCs")
		scanFolder("Enemies")
		return res
	end

	local function getClosestNPC(name)
		local closestNPC = nil
		local shortestDistance = math.huge
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if not rp then return nil end

		local function scanFolder(folderName)
			local folder = workspace:FindFirstChild(folderName)
			if not folder then return end
			for _, v in pairs(folder:GetChildren()) do
				if v:IsA("Model") and string.find(string.lower(v.Name), string.lower(name)) then
					local hum = v:FindFirstChild("Humanoid")
					local hrp = v:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health > 0 and hrp then
						local dist = (rp.Position - hrp.Position).Magnitude
						if dist < shortestDistance then
							shortestDistance = dist;
							closestNPC = v
						end
					end
				end
			end
		end
		scanFolder("NPCs")
		scanFolder("Enemies")
		return closestNPC
	end

	local function attackAll(targetName, maxCombo, lockCF)
		if not AF.canAttack then return end
		AF.canAttack = false
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		local npcs = getAllNPCs(targetName)
		if #npcs == 0 then AF.canAttack = true; return end

		local comboLimit = maxCombo or 5
		for combo = 1, comboLimit do
			if not getgenv().LevelFarm then break end

			if rp and lockCF then
				rp.AssemblyLinearVelocity = Vector3.zero
				H.DoSafeTeleport(lockCF.Position)
			end

			local hrpList = {}
			local npcIDs = {}
			for _, d in ipairs(npcs) do
				if d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health > 0 and d.hrp then
					table.insert(hrpList, d.hrp)
					local id = getNPCID(d.npc)
					if id then table.insert(npcIDs, id) end
				end
			end

			if #hrpList == 0 then break end

			pcall(function()
				local currentAnim = CombatAnims[combo] or CombatAnims[1]
				combatRegister:InvokeServer({[1]="swingsfx",[2]="Melee",[3]=combo,[4]="Ground",[5]=false,[6]=currentAnim,[7]=2,[8]=1.5})
				local da = {[1]={[1]="damage",[2]=hrpList,[3]="Melee",[4]={combo,"Ground","Melee"},[5]=true,[6]=rp and rp.CFrame or CFrame.new(),aircombo="Ground"}}
				if #npcIDs > 0 then da[1].NPCIDs = npcIDs end
				combatRegister:InvokeServer(unpack(da))
			end)
			task.wait(GLOBAL_CONFIG.COMBO_DELAY)
		end
		task.wait(GLOBAL_CONFIG.FULL_COMBO_WAIT)
		AF.canAttack = true
	end

	local function attackSingle(npc, maxCombo, lockedY)
		if not npc then return end
		local hum = npc:FindFirstChild("Humanoid")
		local hrp = npc:FindFirstChild("HumanoidRootPart")
		if not hum or hum.Health <= 0 or not hrp then return end
		if not AF.canAttack then return end
		AF.canAttack = false
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		local id = getNPCID(npc)

		local comboLimit = maxCombo or 5
		for combo = 1, comboLimit do
			if not getgenv().LevelFarm or hum.Health <= 0 then break end

			if rp and hrp then
				rp.AssemblyLinearVelocity = Vector3.zero
				rp.CFrame = CFrame.lookAt(Vector3.new(hrp.Position.X, lockedY, hrp.Position.Z), Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)) 
			end

			pcall(function()
				local currentAnim = CombatAnims[combo] or CombatAnims[1]
				combatRegister:InvokeServer({[1]="swingsfx",[2]="Melee",[3]=combo,[4]="Ground",[5]=false,[6]=currentAnim,[7]=2,[8]=1.5})
				local da = {[1]={[1]="damage",[2]={hrp},[3]="Melee",[4]={combo,"Ground","Melee"},[5]=true,[6]=rp and rp.CFrame or CFrame.new(),aircombo="Ground"}}
				if id then da[1].NPCIDs = {id} end
				combatRegister:InvokeServer(unpack(da))
			end)
			task.wait(GLOBAL_CONFIG.COMBO_DELAY)
		end

		task.wait(GLOBAL_CONFIG.FULL_COMBO_WAIT)
		AF.canAttack = true
	end

	local function hitSingle(npc)
		if not npc then return end
		local hrp = npc:FindFirstChild("HumanoidRootPart")
		local rp  = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or not rp then return end

		pcall(function()
			combatRegister:InvokeServer({[1]="swingsfx",[2]="Melee",[3]=1,[4]="Ground",[5]=false,[6]=CombatAnims[1],[7]=2,[8]=1.5})
			local da = {[1]={[1]="damage",[2]={hrp},[3]="Melee",[4]={1,"Ground","Melee"},[5]=true,[6]=rp.CFrame,aircombo="Ground"}}
			local id = getNPCID(npc);
			if id then da[1].NPCIDs = {id} end
			combatRegister:InvokeServer(unpack(da))
		end)
	end

	local function takeQuest(zone)
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if rp then
			H.DoSafeTeleport(zone.QuestPos.Position)
		end
		task.wait(GLOBAL_CONFIG.QUEST_WAIT_TIME)

		if zone.QuestName ~= "" then
			pcall(function() 
				questEvent:InvokeServer({[1] = "takequest", [2] = zone.QuestName}) 
			end)
			task.wait(1)
		end
	end

	local function startMeleeCheck()
		if AF.meleeCheckConn then AF.meleeCheckConn:Disconnect() end
		AF.meleeCheckConn = H.run_svc.Heartbeat:Connect(function()
			if not AF.isRunning then return end
			local char = H.lp.Character
			local hum = char and char:FindFirstChild("Humanoid")
			if not char or not hum or hum.Health <= 0 then return end
			if not isMeleeEquipped() then equipMelee() end
		end)
	end

	local function stopMeleeCheck()
		if AF.meleeCheckConn then AF.meleeCheckConn:Disconnect(); AF.meleeCheckConn = nil end
	end

	H.startAutoFarm = function()
		if AF.isRunning then return end

		getgenv().LevelFarm = true
		AF.isRunning = true
		afFloat(true)
		equipMelee();
		task.wait(0.2)
		startMeleeCheck()

		AF.LoopID = AF.LoopID + 1
		local currentLoop = AF.LoopID

		pcall(function()
			local stamina = H.lp.PlayerGui.HUD.Main.Bars.Stamina
			for _, v in pairs(stamina:GetDescendants()) do
				if v:IsA("ImageLabel") then v.ImageTransparency = 1 end
			end
			for _, v in pairs(stamina:GetDescendants()) do
				if v:IsA("Frame") then v.BackgroundTransparency = 1
				elseif v:IsA("ImageLabel") then v.ImageTransparency = 1 end
				local old = v:FindFirstChildOfClass("UIStroke")
				if old then old:Destroy() end
			end

			local targetBar = nil
			for _, v in pairs(stamina:GetDescendants()) do
				if (v:IsA("Frame") or v:IsA("ImageLabel")) 
					and v.AbsoluteSize.X > 50 
					and v.AbsoluteSize.Y < 25 then
					targetBar = v; break
				end
			end

			if targetBar then
				if targetBar:IsA("Frame") then
					targetBar.BackgroundTransparency = 1
					targetBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				else
					targetBar.ImageTransparency = 1
					targetBar.ImageColor3 = Color3.fromRGB(255, 255, 255)
				end
				local stroke = Instance.new("UIStroke")
				stroke.Color = Color3.fromRGB(255, 255, 255)
				stroke.Thickness = 1.5
				stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				stroke.Parent = targetBar
			end

			local pr = Instance.new("TextLabel")
			pr.Text = "PR";
			pr.Size = UDim2.new(0, 40, 0, 20); pr.Position = UDim2.new(0, 5, 0, 2)
			pr.BackgroundTransparency = 1;
			pr.TextColor3 = Color3.fromRGB(255, 255, 255)
			pr.TextScaled = true;
			pr.Font = Enum.Font.GothamBold
			pr.TextStrokeTransparency = 0.5;
			pr.Parent = stamina 
		end)

		task.spawn(function()
			local currentZone = getZone(getLevel())
			local lastZoneName = nil
			local lastLvl = getLevel()
			local lastAggroTime = 0

			while getgenv().LevelFarm and AF.LoopID == currentLoop do
				local lvl  = getLevel()
				local qn   = currentquest and currentquest.Value or ""

				if lvl > lastLvl then lastLvl = lvl end

				if currentZone then
					if lvl > currentZone.MaxLevel then
						if currentZone.QuestName == "" or qn ~= currentZone.QuestName then
							currentZone = getZone(lvl); lastAggroTime = 0
						end
					end
				else
					currentZone = getZone(lvl)
				end

				if lvl >= GLOBAL_CONFIG.MAX_LEVEL and (currentZone and currentZone.QuestName ~= "" and qn ~= currentZone.QuestName) then
					H.notify("AutoFarm", "Max level reached! Farm complete.", 6)
					getgenv().LevelFarm = false; break
				end

				if not currentZone then
					H.notify("AutoFarm", "No zone available for your level.", 4)
					getgenv().LevelFarm = false; break
				end

				local char = H.lp.Character
				local hum  = char and char:FindFirstChild("Humanoid")
				local rp   = char and char:FindFirstChild("HumanoidRootPart")

				if not char or not hum or hum.Health <= 0 or not rp then
					task.wait(0.5); continue
				end

				if rp and (rp.Position.X ~= rp.Position.X or math.abs(rp.Position.Y) > 50000) then
					if hum then hum.Health = 0 end
					task.wait(3); continue
				end

				if lastZoneName ~= currentZone.TargetName then
					lastZoneName = currentZone.TargetName
					AF.currentTargetName = currentZone.TargetName
					H.notify("AutoFarm", "Farming: " .. currentZone.TargetName .. " (Lvl " .. lvl .. ")", 4)
				end

				if char and hum and hum.Health > 0 and rp then
					if currentZone.WalkTo and (rp.Position - currentZone.WalkTo.Position).Magnitude > 20 and (rp.Position - currentZone.Center.Position).Magnitude > 50 then
						H.DoSafeTeleport(currentZone.QuestPos.Position)
						task.wait(0.5)
						H.DoGroundWalk(currentZone.WalkTo.Position)
						task.wait(2); continue
					end

					local reqQuestLvl = currentZone.QuestMinLevel or currentZone.MinLevel
					if currentZone.QuestName ~= "" and qn ~= currentZone.QuestName and lvl >= reqQuestLvl then
						takeQuest(currentZone); lastAggroTime = 0
					else
						local zoneOffset = getZoneHeight(currentZone.ZoneKey)

						if currentZone.Method == "1by1" then
							local targetNPC = getClosestNPC(currentZone.TargetName)

							if not targetNPC then
								local lockedY = currentZone.Center.Y + zoneOffset
								local centerCF = CFrame.new(currentZone.Center.X, lockedY, currentZone.Center.Z)

								if (rp.Position - centerCF.Position).Magnitude > 6 then
									H.DoSafeTeleport(centerCF.Position)
								end
								task.wait(0.5); continue
							end

							local hrp = targetNPC:FindFirstChild("HumanoidRootPart")
							if hrp then
								local lockedY = hrp.Position.Y + zoneOffset
								local targetCF = CFrame.lookAt(Vector3.new(hrp.Position.X, lockedY, hrp.Position.Z), Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z))

								if (rp.Position - targetCF.Position).Magnitude > 6 then
									H.DoSafeTeleport(targetCF.Position)
								end

								task.wait(0.15)
								attackSingle(targetNPC, 5, lockedY)
							end

						elseif currentZone.Method == "Group" then
							local npcs = getAllNPCs(currentZone.TargetName)
							local lockedY = currentZone.Center.Y + zoneOffset
							local centerCF = CFrame.lookAt(Vector3.new(currentZone.Center.X, lockedY, currentZone.Center.Z), currentZone.Center.Position)

							if #npcs == 0 then
								if (rp.Position - centerCF.Position).Magnitude > 6 then
									H.DoSafeTeleport(centerCF.Position)
								end
								task.wait(0.5);
								continue
							end

							if tick() - lastAggroTime >= 15 then
								for _, d in ipairs(npcs) do
									if not getgenv().LevelFarm then break end
									if d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health > 0 then
										local aggroCF = p1CFrameKeepBaseRotation(rp, Vector3.new(d.hrp.Position.X, d.hrp.Position.Y + zoneOffset, d.hrp.Position.Z))
										if (rp.Position - aggroCF.Position).Magnitude > 6 then
											H.DoSafeTeleport(aggroCF.Position)
										end
										rp.AssemblyLinearVelocity = Vector3.zero
										rp.CFrame = aggroCF
										task.wait(0.2)
										hitSingle(d.npc)
										task.wait(0.2)
									end
								end
								H.DoSafeTeleport(centerCF.Position)
								lastAggroTime = tick()
								task.wait(0.5)
							else
								if (rp.Position - centerCF.Position).Magnitude > 6 then
									H.DoSafeTeleport(centerCF.Position)
								end
								attackAll(currentZone.TargetName, 5, centerCF)
							end
						end
					end
				end
				task.wait(0.05)
			end

			AF.isRunning = false
			afFloat(false)
			stopMeleeCheck()
			if Options and Options.AutoFarmToggle then
				Options.AutoFarmToggle:SetValue(false)
			end
		end)
	end

	H.stopAutoFarm = function()
		getgenv().LevelFarm = false
		H.isTeleporting = false
		AF.isRunning = false
		afFloat(false)
		stopMeleeCheck()
		AF.LoopID = AF.LoopID + 1 
	end

	H.AF = AF
	H.getZoneHeight = getZoneHeight
	H.ZONE_HEIGHT_DEFAULTS = ZONE_HEIGHT_DEFAULTS

	local deathWatchConn
	local lastAlive = true
	local respawnHandling = false
	deathWatchConn = H.run_svc.Heartbeat:Connect(function()
		if not getgenv().LevelFarm then
			lastAlive = true;
			respawnHandling = false
			return
		end

		local char = H.lp.Character
		local hum = char and char:FindFirstChild("Humanoid")
		local alive = char ~= nil and hum ~= nil and hum.Health > 0

		if not alive and lastAlive then
			lastAlive = false
			afFloat(false)
		elseif alive and not lastAlive and not respawnHandling then
			lastAlive = true
			respawnHandling = true

			task.spawn(function()
				local newChar = waitForRespawn(20)
				if newChar and getgenv().LevelFarm then
					task.wait(4.5) 
					equipMelee()
					afFloat(true)
					H.notify("AutoFarm", "Respawned. Going back to farming.", 4)
				end
				respawnHandling = false
			end)
		end
	end)
end

-- ============================================================
-- FEATURE: AUTO ADS, AUTO STATS
-- ============================================================
local function initStandaloneFeatures()
	local H = _G_Hub
	local RS = game:GetService("ReplicatedStorage")
	local VIM = game:GetService("VirtualInputManager")

	task.spawn(function()
		local adEvent = RS:WaitForChild("Events"):WaitForChild("ADShop")
		while true do
			if H.autoAdsEnabled then
				pcall(function() adEvent:FireServer(3457788725, "536248645108658") end)
			end
			task.wait(10)
		end
	end)

	task.spawn(function()
		local statsEvent = RS:WaitForChild("Events"):WaitForChild("stats")
		while true do
			if H.autoStatsEnabled then
				local mystats   = RS:FindFirstChild("Stats" .. H.lp.Name)
				local statsFolder = mystats and mystats:FindFirstChild("Stats")
				local statPoints  = statsFolder and statsFolder:FindFirstChild("SkillPoints")

				if statPoints and statPoints.Value > 0 then
					local pts = statPoints.Value
					local strengthStat = statsFolder and statsFolder:FindFirstChild("Strength")
					local currentStrength = strengthStat and strengthStat.Value or 0

					for i = 1, pts do
						if not H.autoStatsEnabled then break end
						-- Priority: 1 Strength + 1 Defense per cycle
						-- Une fois Strength cap 750, tout va en Defense
						if currentStrength < 750 then
							pcall(function() statsEvent:FireServer("Strength", nil, 1) end)
							currentStrength = currentStrength + 1
						end
						pcall(function() statsEvent:FireServer("Defense", nil, 1) end)
						task.wait(0.1)
					end
				end
			end
			task.wait(1)
		end
	end)
end

-- ============================================================
-- FEATURE: AUTO FISH
-- ============================================================
local function initAutoFish()
	local H = _G_Hub
	local RS = game:GetService("ReplicatedStorage")
	local LP = H.lp
	local VirtualUser = game:GetService("VirtualUser")

	H.fishState = { autoFishing = false, delayed = false, _isCasting = false, waterPos = nil, isPaused = false }
	H.autoBuyBaitEnabled = false
	H.autoBuyBaitAmount = 1
	H.autoBuyBaitInterval = 60
	H.lastBaitBuy = 0
	H.autoBuyRod = false

	H.autoSellFishEnabled = false

	local fishLoopRunning = false
	local sharkConn = nil
	local rodHideConn = nil

	local fishFolder = RS:FindFirstChild("Fishing")
	local fishRemotes = fishFolder and fishFolder:FindFirstChild("Remotes")
	local FishingAction = fishRemotes and fishRemotes:FindFirstChild("Action")

	local ROD_TIERS = {
		["Devil Fruit Rod"] = 8, ["ODM Rod"] = 7, ["Jack-O'Rod"] = 6,
		["Angler Rod"] = 5, ["Merchants Banana Rod"] = 4, ["Epic Fishing Rod"] = 3,
		["Rare Fishing Rod"] = 2, ["Fishing Rod"] = 1,
	}

	local function isBlackScreen()
		local count = 0
		pcall(function()
			for _, gui in ipairs(LP.PlayerGui:GetChildren()) do
				if gui:IsA("ScreenGui") and gui.Name == "ScreenGui" and gui.Enabled then
					count = count + 1
				end
			end
		end)
		return count > 0
	end

	local function getInventoryCount(itemName)
		local count = 0
		local function scan(container)
			if not container then return end
			for _, obj in ipairs(container:GetChildren()) do
				if obj.Name == itemName then count = count + 1 end
			end
		end
		scan(LP:FindFirstChild("Backpack"))
		scan(LP:FindFirstChild("Inventory"))

		local stats = LP:FindFirstChild("Stats" .. LP.Name) or LP:FindFirstChild("Stats")
		if stats and stats:FindFirstChild("Inventory") then
			local item = stats.Inventory:FindFirstChild(itemName)
			if item then
				count = count + (tonumber(item.Value) or tonumber(item:GetAttribute("Amount")) or 1)
			end
		end
		return count
	end

	local function getRodInstance()
		local char = LP.Character
		if not char then return nil end

		local bestRod, bestTier = nil, -1
		for rodName, tier in pairs(ROD_TIERS) do
			local tool = char:FindFirstChild(rodName) or (LP:FindFirstChild("Backpack") and LP.Backpack:FindFirstChild(rodName))
			if tool and tier > bestTier then
				bestRod = tool
				bestTier = tier
			end
		end
		return bestRod
	end

	local function hideRod(model)
		for _, obj in ipairs(model:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.Transparency = 1
				obj.CanCollide = false
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj.Transparency = 1
			elseif obj:IsA("Beam") or obj:IsA("Trail") then
				obj.Enabled = false
			elseif obj:IsA("RopeConstraint") then
				obj.Visible = false
			end
		end
	end

	local function toggleRodHider(state)
		local charFolder = workspace:FindFirstChild("PlayerCharacters")
		if not charFolder then return end

		if state then
			if rodHideConn then return end
			local pc = charFolder:FindFirstChild(LP.Name)
			if pc then
				local function checkAndHide(child)
					if child:IsA("Tool") and ROD_TIERS[child.Name] then
						task.wait(0.2)
						hideRod(child)
					end
				end

				rodHideConn = pc.ChildAdded:Connect(checkAndHide)
				for _, child in ipairs(pc:GetChildren()) do checkAndHide(child) end
			end
		else
			if rodHideConn then
				rodHideConn:Disconnect()
				rodHideConn = nil
			end
		end
	end

	H.pauseFishingForTask = function()
		if not H.fishState.autoFishing then return false end
		H.fishState.isPaused = true
		H.fishState.delayed = false
		H.fishState._isCasting = false

		pcall(function()
			local char = LP.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then hum:UnequipTools() end
		end)

		if FishingAction then
			pcall(function() FishingAction:InvokeServer({ Action = "Cancel" }) end)
		end

		local hook = workspace:FindFirstChild("Effects") and workspace:FindFirstChild("Effects"):FindFirstChild(LP.Name .. "'s hook")
		if hook then hook:Destroy() end

		return true
	end

	H.resumeFishingAfterTask = function(wasFishing)
		if wasFishing then
			H.fishState.isPaused = false
			H.fishState.delayed = false
			H.fishState._isCasting = false
			H.fishState.autoFishing = true

			if H.startAutoFishLoop then
				H.startAutoFishLoop()
			end
		end
	end

	local function fishOnce()
		if not FishingAction or H.fishState.isPaused then return end
		if H.fishState.delayed then return end

		local char = LP.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end

		local rod = getRodInstance()
		if not rod and H.autoBuyRod then
			if H.activeTask then return end
			H.activeTask = "BuyRod"
			local wasFishing = H.pauseFishingForTask()

			local shopPos = Vector3.new(-6509.251, 7.725, -7605.082)
			if (hrp.Position - shopPos).Magnitude > 15 then
				H.DoSafeTeleport(shopPos)
			end

			hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			if hrp and (hrp.Position - shopPos).Magnitude <= 15 then
				pcall(function()
					local buyableItems = workspace:WaitForChild("BuyableItems", 5)
					local rodItem = buyableItems and buyableItems:WaitForChild("Fishing Rod", 5)
					local events = RS:WaitForChild("Events", 5)
					local shopRemote = events and events:WaitForChild("Shop", 5)

					if rodItem and shopRemote then
						local args = { rodItem, 1 }
						shopRemote:InvokeServer(unpack(args))
						H.notify("Shop", "Fishing Rod purchased! Resuming fishing.", 3)
					end
				end)
				task.wait(1)
				H.autoBuyRod = false
				if Options and Options.AutoBuyRodToggle then Options.AutoBuyRodToggle:SetValue(false) end
			end

			H.resumeFishingAfterTask(wasFishing)
			H.activeTask = nil
			return
		end

		if not rod then return end

		if rod.Parent ~= char then
			hum:EquipTool(rod)
			task.wait(0.5)
			return
		end

		local hook = workspace:FindFirstChild("Effects") and workspace:FindFirstChild("Effects"):FindFirstChild(LP.Name .. "'s hook")

		if not hook then
			if H.fishState._isCasting then return end
			H.fishState._isCasting = true

			pcall(function()
				if mouse2press and mouse2release then
					mouse2press()
					task.wait(0.1)
					mouse2release()
				else
					VirtualUser:CaptureController()
					VirtualUser:ClickButton2(Vector2.new(0,0))
				end
			end)
			task.wait(0.6)

			local ok, goalPos = pcall(function()
				local ocean = workspace.Env.WaterStuff.Ocean
				local oceanCF, oceanSize = ocean.CFrame, ocean.Size
				local dir = hrp.CFrame.LookVector
				local castTarget = hrp.Position + (Vector3.new(dir.X, 0, dir.Z).Unit * 20)
				local localPos = oceanCF:PointToObjectSpace(castTarget)
				local waterPos = oceanCF:PointToWorldSpace(Vector3.new(
					math.clamp(localPos.X, -oceanSize.X / 2, oceanSize.X / 2),
					oceanSize.Y / 2,
					math.clamp(localPos.Z, -oceanSize.Z / 2, oceanSize.Z / 2)
					))
				local startPos = hrp.Position
				if startPos.Y < 0 then startPos = Vector3.new(startPos.X, 10, startPos.Z) end
				local rayParams = RaycastParams.new()
				rayParams.FilterType = Enum.RaycastFilterType.Include
				rayParams.FilterDescendantsInstances = { workspace.Env.WaterStuff }
				local ray = workspace:Raycast(startPos, Vector3.new(0, -2000, 0), rayParams)
				local gp = ray and ray.Position + Vector3.new(0, 7, 0) or waterPos + Vector3.new(0, 7, 0)
				return Vector3.new(gp.X, 0, gp.Z)
			end)

			if not ok then H.fishState._isCasting = false return end
			H.fishState.waterPos = goalPos

			local bait = "Common Fish Bait"
			if getInventoryCount("Legendary Fish Bait") > 0 then bait = "Legendary Fish Bait"
			elseif getInventoryCount("Rare Fish Bait") > 0 then bait = "Rare Fish Bait" end

			pcall(function() FishingAction:InvokeServer({ Goal = goalPos, Action = "Throw", Bait = bait }) end)
			task.wait(0.5)
			pcall(function() FishingAction:InvokeServer({ Action = "Landed" }) end)
			task.delay(4, function() H.fishState._isCasting = false end)
		else
			if hrp.Position.Y > 0 and hrp.Position.Y < 800 and H.fishState.waterPos then
				pcall(function() hook.CFrame = CFrame.new(H.fishState.waterPos) end)
			end

			if hook:GetAttribute("Caught") and not H.fishState.delayed then
				H.fishState.delayed = true
				task.delay(7.5, function()
					if not H.fishState.delayed or not H.fishState.autoFishing or H.fishState.isPaused then return end 
					pcall(function() FishingAction:InvokeServer({ Action = "Reel" }) end)
					H.fishState.delayed = false
				end)
			elseif hook:GetAttribute("MoveMultiplier") and not hook:GetAttribute("Caught") then
				pcall(function()
					FishingAction:InvokeServer({ Action = "HookReturning" })
					FishingAction:InvokeServer({ Action = "Cancel" })
					hook:Destroy()
				end)
			end
		end
	end

	-- ============================================================
	-- PELI CAP: auto sell pauses at or above 1,000,000 Peli and resumes below it
	-- ============================================================
	H.peliCapEnabled = true
	H.peliCapAmount  = 1000000
	H._peliCapSellBlocked = false

	local function getCurrentPeli()
		local stats = game:GetService("ReplicatedStorage"):FindFirstChild("Stats" .. LP.Name)
		local peliObj = stats and stats:FindFirstChild("Stats") and stats.Stats:FindFirstChild("Peli")
		return peliObj and peliObj.Value or 0
	end

	local function canSellFish()
		if not H.peliCapEnabled then
			H._peliCapSellBlocked = false
			return true
		end

		local currentPeli = getCurrentPeli()
		if currentPeli >= H.peliCapAmount then
			if not H._peliCapSellBlocked then
				H._peliCapSellBlocked = true
				H.notify("Peli Cap", "1,000,000 Peli reached. Auto Sell is paused until your Peli goes below the limit.", 6)
			end
			return false
		end

		if H._peliCapSellBlocked then
			H._peliCapSellBlocked = false
			H.notify("Peli Cap", "Peli is below 1,000,000 again. Auto Sell resumed.", 4)
		end

		return true
	end

	-- Instant reaction when Peli changes so Auto Sell can pause/resume automatically
	task.spawn(function()
		local RS = game:GetService("ReplicatedStorage")
		local stats = RS:WaitForChild("Stats" .. LP.Name, 30)
		if not stats then return end
		local statsFolder = stats:WaitForChild("Stats", 10)
		if not statsFolder then return end
		local peliObj = statsFolder:WaitForChild("Peli", 10)
		if not peliObj then return end

		peliObj.Changed:Connect(function()
			canSellFish()
		end)
	end)

	H.startAutoFishLoop = function()
		if fishLoopRunning then return end
		fishLoopRunning = true
		toggleRodHider(true)

		if not sharkConn then
			sharkConn = LP.PlayerGui.DescendantAdded:Connect(function(desc)
				if not H.fishState.autoFishing or H.fishState.isPaused then return end
				if desc:IsA("TextLabel") then
					local txt = tostring(desc.Text):lower()
					if txt:find("shark") then
						H.fishState.delayed = false
						H.fishState._isCasting = false
						pcall(function()
							local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
							if hum then hum:UnequipTools() end
						end)
						if FishingAction then pcall(function() FishingAction:InvokeServer({ Action = "Cancel" }) end) end
						H.fishState.isPaused = true
						task.delay(math.random(3, 6), function()
							H.fishState.isPaused = false
						end)
					elseif desc.Parent and desc.Parent.Name == "Container" then
						H.fishState.delayed = false
						H.fishState._isCasting = false
					end
				end
			end)
		end

		task.spawn(function()
			while task.wait() do
				if not H.fishState.autoFishing then fishLoopRunning = false break end
				if H.fishState.isPaused then continue end

				if isBlackScreen() then
					local char = LP.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if hum then hum:UnequipTools() end
					task.wait(1)
					continue
				end

				local char = LP.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not char or not hum or hum.Health <= 0 then task.wait(1); continue end

				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp and hrp.Velocity.Y < 0 then hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z) end

				fishOnce()
			end
		end)
	end

	H.stopAutoFishLoop = function()
		H.fishState.autoFishing = false
		H.fishState.delayed = false
		H.fishState._isCasting = false
		H.fishState.isPaused = false
		toggleRodHider(false)
		if sharkConn then sharkConn:Disconnect(); sharkConn = nil end
		pcall(function()
			local char = LP.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then hum:UnequipTools() end
		end)
	end

	task.spawn(function()
		local Events = RS:WaitForChild("Events", 10)
		local ShopRemote = Events and Events:WaitForChild("Shop", 10)

		while task.wait(1) do
			if H.autoBuyBaitEnabled and not H.activeTask then
				if tick() - H.lastBaitBuy >= H.autoBuyBaitInterval then
					local char = LP.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")

					if hrp then
						H.activeTask = "BuyBait"
						local wasFishing = false
						if H.pauseFishingForTask then 
							wasFishing = H.pauseFishingForTask() 
						end

						local shopPos = Vector3.new(-1341.070, 4.375, -4980.851)

						if (hrp.Position - shopPos).Magnitude > 15 then
							H.DoSafeTeleport(shopPos)
						end

						hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
						if hrp and (hrp.Position - shopPos).Magnitude <= 20 then

							local amtToBuy = tonumber(H.autoBuyBaitAmount) or 1
							local successCount = 0

							local buyableItems = workspace:WaitForChild("BuyableItems", 5)
							local baitItem = buyableItems and buyableItems:WaitForChild("Common Fish Bait", 5)
							local ShopEv = game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("Shop", 10)

							if baitItem and ShopEv then
								for i = 1, amtToBuy do
									if not H.autoBuyBaitEnabled then break end
									local ok = pcall(function()
										ShopEv:InvokeServer(baitItem, 1)
									end)
									if ok then successCount = successCount + 1 end
									task.wait(0.15)
								end
							end

							H.lastBaitBuy = tick()
						end

						if H.resumeFishingAfterTask then 
							H.resumeFishingAfterTask(wasFishing) 
						end
						H.activeTask = nil
					end
				end
			end
		end
	end)

	-- ============================================================
	-- AUTO SELL FISH by rarity
	-- ============================================================
	local fishByRarity = {
		Common = {
			"Blue-Lip Grouper",
			"Tigerfin",
		},
		Rare = {
			"Candy Corn Squid",
			"Crimson Polka Puffer",
			"Crimson Snapper",
			"Exotic Tigerfin",
			"Fangfish",
			"Zebra Ribbon Angelfish",
			"Skeletal Shark",
		},
		Legendary = {
			"Anglerfish",
			"Dark Skeletal Shark",
			"Jack-O'-Bite",
			"Swordfish",
			"Golden Polka Puffer",
			"Golden Ribbon Angelfish",
			"Golden Tigerfin",
		},
	}

	H.sellFishRarities = { Common = true, Rare = true, Legendary = true }

	task.spawn(function()
		local ShopRemote = game:GetService("ReplicatedStorage"):WaitForChild("FishingShopRemote", 10)
		local sellSequence = {
			{ rarity = "Common", name = "Blue-Lip Grouper" },
			{ rarity = "Common", name = "Tigerfin" },

			{ rarity = "Rare", name = "Candy Corn Squid" },
			{ rarity = "Rare", name = "Crimson Polka Puffer" },
			{ rarity = "Rare", name = "Crimson Snapper" },
			{ rarity = "Rare", name = "Exotic Tigerfin" },
			{ rarity = "Rare", name = "Fangfish" },
			{ rarity = "Rare", name = "Zebra Ribbon Angelfish" },
			{ rarity = "Rare", name = "Skeletal Shark" },

			{ rarity = "Legendary", name = "Anglerfish" },
			{ rarity = "Legendary", name = "Dark Skeletal Shark" },
			{ rarity = "Legendary", name = "Jack-O'-Bite" },
			{ rarity = "Legendary", name = "Swordfish" },
			{ rarity = "Legendary", name = "Golden Polka Puffer" },
			{ rarity = "Legendary", name = "Golden Ribbon Angelfish" },
			{ rarity = "Legendary", name = "Golden Tigerfin" },
		}

		local sellIndex = 1
		local sellDelay = 1.5

		while true do
			task.wait(sellDelay)

			if H.autoSellFishEnabled and ShopRemote then
				if canSellFish() then
					for _ = 1, #sellSequence do
						local entry = sellSequence[sellIndex]
						sellIndex = (sellIndex % #sellSequence) + 1

						if entry and H.sellFishRarities[entry.rarity] then
							pcall(function()
								ShopRemote:InvokeServer({
									Fish = entry.name,
									All = false,
									Method = "SellFish"
								})
							end)
							break
						end
					end
				end
			end
		end
	end)
end

-- ============================================================
-- FEATURE: AUTO MERCHANT (MAINTENANT UTILISE LE FACEMOUSE TP)
-- ============================================================

local function initAutoMerchant()
	local H = _G_Hub
	local RS = game:GetService("ReplicatedStorage")
	local LP = H.lp
	local HttpService = game:GetService("HttpService")

	H.autoMerchantEnabled = false
	H.merchantListSelected = {} 
	H.merchantItemAmounts  = {}
	H.merchantWaitingNext  = false
	H.lastCompletedMerchantPos = nil
	H.merchantWebhookUrl = H.merchantWebhookUrl or getgenv().__WebhookLink__ or ""
	H.merchantWebhookEnabled = true
	H.lastMerchantWebhookSignature = nil
	H.lastMerchantWebhookGui = nil
	H.lastMerchantWebhookSentAt = 0

	local QuestRemote    = RS:WaitForChild("Events"):WaitForChild("Quest")
	local MerchantRemote = RS:WaitForChild("Events"):WaitForChild("TravelingMerchentRemote")
	local CompassGuider  = RS:WaitForChild("CompassGuider")
	local RequestFn = request or http_request or (syn and syn.request) or (http and http.request)

	local merchantKnownItems = {
		"Race Reroll",
		"SP Reset Essence",
		"Dark Root",
		"Spirit Color Essence",
		"Rare Fish Bait",
		"Golden Staff",
		"Golden Hook",
		"Blossom Skirt",
		"Raylo's Outfit",
		"Desert Merchant Outfit",
		"Sea-Breeze Skirt",
		"Tari's Karoo Coat",
		"Sea-Breeze Haori",
		"Crimson Nightcoat",
		"Special Tailor Token",
		"Karoo Mount",
		"Gravity Blade",
		"Jitte",
		"Random Battle Royale Outfit",
		"Bomi's Log Pose",
		"Rare Fruit Chest",
		"Spare Fruit Bag",
		"Thrilled Ship",
		"Hunter's Journal",
		"Raiui",
		"Kessui",
		"Bisento",
		"Crab Cutlass",
		"Knight's Gauntlet",
		"Merchants Banana Rod",
		"Legendary Fish Bait",
		"Hoverboard",
		"Striker",
		"Coffin Boat",
		"Tropical Parrot",
		"Legendary Fruit Chest",
		"Mythical Fruit Chest",
	}

	local function getMerchantTargetPos()
		local guide = CompassGuider:FindFirstChild("Traveling Merchant") or CompassGuider:FindFirstChild("TravelingMerchant")
		if guide then
			if guide:IsA("Vector3Value") then return guide.Value end
			if guide:IsA("CFrameValue") then return guide.Value.Position end
			if guide:IsA("BasePart") then return guide.Position end
		end

		local npcFolder = workspace:FindFirstChild("NPCs")
		local physical = npcFolder and (npcFolder:FindFirstChild("Traveling Merchant") or npcFolder:FindFirstChild("TravelingMerchant"))
		if physical then
			return physical.PrimaryPart and physical.PrimaryPart.Position or physical:GetPivot().Position
		end

		return nil
	end

	local function getMerchantSeed()
		local function parseSeed(val)
			if type(val) == "number" and val > 100000000 then return val end
			if type(val) == "string" then
				local num = tonumber(val)
				if num and num > 100000000 then return num end
			end
			return nil
		end

		for _ = 1, 20 do
			local shopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
			if shopGui then
				local directSeed = parseSeed(shopGui:GetAttribute("Seed"))
					or parseSeed(shopGui:GetAttribute("seed"))
					or parseSeed(shopGui:GetAttribute("ShopSeed"))
				if directSeed then return directSeed end

				for _, obj in ipairs(shopGui:GetDescendants()) do
					local attrSeed = parseSeed(obj:GetAttribute("Seed"))
						or parseSeed(obj:GetAttribute("seed"))
						or parseSeed(obj:GetAttribute("ShopSeed"))
					if attrSeed then return attrSeed end

					for _, val in pairs(obj:GetAttributes()) do
						local anySeed = parseSeed(val)
						if anySeed then return anySeed end
					end

					if obj:IsA("IntValue") or obj:IsA("NumberValue") then
						local numSeed = parseSeed(obj.Value)
						if numSeed then return numSeed end
					elseif obj:IsA("StringValue") then
						local strSeed = parseSeed(obj.Value)
						if strSeed then return strSeed end
					end
				end
			end
			task.wait(0.2)
		end

		return nil
	end

	local function isMerchantShopOpen()
		local shopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
		if not shopGui then return false end

		if shopGui:IsA("ScreenGui") or shopGui:IsA("BillboardGui") then
			return shopGui.Enabled ~= false
		end

		return true
	end

	local function getSelectedMerchantItems()
		local itemsToBuy = {}
		if type(H.merchantListSelected) == "table" then
			for k, v in pairs(H.merchantListSelected) do
				if v then
					table.insert(itemsToBuy, k)
				end
			end
		elseif type(H.merchantListSelected) == "string" and H.merchantListSelected ~= "" then
			table.insert(itemsToBuy, H.merchantListSelected)
		end
		return itemsToBuy
	end

	local function getMerchantVisibleItems()
		local found = {}
		local seen = {}
		local shopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
		if not shopGui then
			return found
		end

		for _, obj in ipairs(shopGui:GetDescendants()) do
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				local txt = tostring(obj.Text or "")
				if txt ~= "" then
					local lower = txt:lower()
					for _, itemName in ipairs(merchantKnownItems) do
						if lower:find(itemName:lower(), 1, true) and not seen[itemName] then
							seen[itemName] = true
							table.insert(found, itemName)
						end
					end
				end
			end
		end

		table.sort(found)
		return found
	end

	local function formatMerchantWebhookMessage()
		local statsRoot = RS:FindFirstChild("Stats" .. LP.Name)
		local statsFolder = statsRoot and statsRoot:FindFirstChild("Stats")
		local peliValue = statsFolder and statsFolder:FindFirstChild("Peli")
		local peli = peliValue and tonumber(peliValue.Value) or 0

		local foundItems = getMerchantVisibleItems()
		local lines = {
			"⛹️ Player: `" .. LP.Name .. "`",
			"💰 Peli: `" .. tostring(peli) .. "`",
			"Items:",
		}

		if #foundItems > 0 then
			for _, itemName in ipairs(foundItems) do
				table.insert(lines, "- `" .. itemName .. "`")
			end
		end

		local signature = (#foundItems > 0 and table.concat(foundItems, "|")) or "EMPTY"
		return table.concat(lines, "\n"), signature
	end

	local function sendMerchantWebhook(message)
		local url = tostring(H.merchantWebhookUrl or "")
		if url == "" or not H.merchantWebhookEnabled or not RequestFn then
			return false
		end

		local ok = pcall(function()
			RequestFn({
				Url = url,
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json"
				},
				Body = HttpService:JSONEncode({
					username = "Prince Hub Merchant",
					avatar_url = "https://image2url.com/r2/default/images/1775915407560-4d21167f-d56c-42da-b93b-c4b6314f2f19.png",
					embeds = {{
						title = "Merchant Shop",
						description = message,
						color = 3447003
					}},
					attachments = {}
				})
			})
		end)

		return ok
	end

	H.sendCurrentMerchantWebhook = function()
		local currentShopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
		if not currentShopGui or not isMerchantShopOpen() then
			return false
		end

		local message = nil
		local signature = "EMPTY"

		for _ = 1, 16 do
			task.wait(0.25)
			currentShopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
			if not currentShopGui or not isMerchantShopOpen() then
				return false
			end

			message, signature = formatMerchantWebhookMessage()
			if signature ~= "EMPTY" then
				break
			end
		end

		if signature == "EMPTY" or not message or message == "" then
			return false
		end

		if currentShopGui == H.lastMerchantWebhookGui and signature == H.lastMerchantWebhookSignature then
			return false
		end

		if signature == H.lastMerchantWebhookSignature and (tick() - (H.lastMerchantWebhookSentAt or 0)) < 15 then
			return false
		end

		if sendMerchantWebhook(message) then
			H.lastMerchantWebhookSignature = signature
			H.lastMerchantWebhookGui = currentShopGui
			H.lastMerchantWebhookSentAt = tick()
			return true
		end

		return false
	end


	task.spawn(function()
		local lastSeenGui = nil

		while task.wait(0.5) do
			local currentShopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
			local open = currentShopGui and isMerchantShopOpen()

			if open and currentShopGui ~= lastSeenGui then
				lastSeenGui = currentShopGui
				task.spawn(function()
					if H.sendCurrentMerchantWebhook then
						pcall(H.sendCurrentMerchantWebhook)
					end
				end)
			elseif not currentShopGui then
				lastSeenGui = nil
				H.lastMerchantWebhookSignature = nil
				H.lastMerchantWebhookGui = nil
			end
		end
	end)

	H.executeMerchantTask = function()
		if H.activeTask == "Merchant" then return false end

		local targetPos = getMerchantTargetPos()
		if not targetPos or (targetPos == Vector3.new(0,0,0)) then
			return false
		end

		H.notify("Merchant", "Merchant found. Moving in...", 3)

		local char = LP.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end

		local wasFishing = false
		if H.pauseFishingForTask then 
			wasFishing = H.pauseFishingForTask() 
		end

		H.activeTask = "Merchant"

		local function moveBackToMerchant(currentTargetPos)
			local moveTo = currentTargetPos + Vector3.new(0, 3, 3)
			H.DoSafeTeleport(moveTo)
		end

		moveBackToMerchant(targetPos)

		local interactActive = true
		local interactConn = H.run_svc.Stepped:Connect(function()
			if interactActive and LP.Character then
				for _, p in ipairs(LP.Character:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide = false end
				end
			end
		end)

		task.spawn(function()
			local takestamEvent = RS:WaitForChild("Events", 5):WaitForChild("takestam", 5)
			while interactActive do
				pcall(function() takestamEvent:FireServer(0.565, "dash") end)
				task.wait(0.35)
			end
		end)

		task.wait(1.0)

		local selectedItems = getSelectedMerchantItems()
		local shopOpened = false
		local seed = nil

		for attempt = 1, 12 do
			if H.activeTask ~= "Merchant" then
				break
			end

			local currentPos = getMerchantTargetPos() or targetPos
			if currentPos and hrp and (hrp.Position - currentPos).Magnitude > 10 then
				moveBackToMerchant(currentPos)
			end

			pcall(function() QuestRemote:InvokeServer({"npcChat", true}) end)
			task.wait(0.35)

			pcall(function() MerchantRemote:InvokeServer("OpenShop") end)
			task.wait(0.6)

			if isMerchantShopOpen() then
				seed = getMerchantSeed()
				if seed then
					shopOpened = true
					break
				end
			end

			if attempt < 12 then
				H.notify("Merchant", "Shop did not open yet, retrying...", 2)
				task.wait(0.45)
			end
		end

		if not shopOpened or not seed then
			H.notify("Merchant", "Could not open the merchant shop.", 4)
		else
			local boughtAnything = false

			for _, itemName in ipairs(selectedItems) do
				local quantity = H.merchantItemAmounts[itemName] or 1
				H.notify("Merchant", "Buying " .. itemName .. " x" .. quantity, 4)

				for i = 1, quantity do
					local ok, result = pcall(function()
						return MerchantRemote:InvokeServer(itemName, seed)
					end)

					if not ok then break end
					if type(result) == "string" and result:lower():find("refresh") then break end

					task.wait(0.15)
				end
				boughtAnything = true
			end

			if boughtAnything then
				H.notify("Merchant", "Done shopping.", 5)
			else
				H.notify("Merchant", "No selected items were bought.", 3)
			end
		end

		pcall(function() MerchantRemote:InvokeServer("Close") end)
		task.wait(0.5)

		pcall(function() QuestRemote:InvokeServer({"npcChat", false}) end)
		task.wait(0.5)

		interactActive = false
		interactConn:Disconnect()

		if H.resumeFishingAfterTask then H.resumeFishingAfterTask(wasFishing) end
		H.lastCompletedMerchantPos = targetPos
		H.merchantWaitingNext = true
		H.activeTask = nil

		return true
	end

	task.spawn(function()
		local lastMerchantPos = nil
		local lastMerchantRun = 0

		while task.wait(2) do
			if not H.autoMerchantEnabled then
				lastMerchantPos = nil
				lastMerchantRun = 0
				H.merchantWaitingNext = false
				H.lastCompletedMerchantPos = nil
				continue
			end

			if H.activeTask and H.activeTask ~= "Merchant" then
				continue
			end

			local targetPos = getMerchantTargetPos()
			if not targetPos or targetPos == Vector3.new(0,0,0) then
				lastMerchantPos = nil
				lastMerchantRun = 0
				H.merchantWaitingNext = false
				H.lastCompletedMerchantPos = nil
				continue
			end

			if H.merchantWaitingNext then
				local completedPos = H.lastCompletedMerchantPos
				if completedPos and (completedPos - targetPos).Magnitude <= 25 then
					continue
				else
					H.merchantWaitingNext = false
					H.lastCompletedMerchantPos = nil
				end
			end

			if not lastMerchantPos or (lastMerchantPos - targetPos).Magnitude > 25 then
				lastMerchantPos = targetPos
				lastMerchantRun = 0
			end

			local char = LP.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then
				continue
			end

			local dist = (hrp.Position - targetPos).Magnitude
			local shouldRun = false

			if dist > 20 then
				shouldRun = true
			elseif lastMerchantRun == 0 then
				shouldRun = true
			end

			if shouldRun and tick() - lastMerchantRun >= 3 then
				local success = H.executeMerchantTask()
				if success then
					lastMerchantPos = targetPos
					lastMerchantRun = tick()
				end
			end
		end
	end)
end

-- ============================================================
-- FEATURE: AUTO MERCHANT
-- ============================================================
local function initAutoMerchantLegacy()
	local H = _G_Hub
	local RS = game:GetService("ReplicatedStorage")
	local LP = H.lp

	H.autoMerchantEnabled = false
	H.merchantListSelected = {} 
	H.merchantItemAmounts  = {}
	H.merchantWaitingNext  = false
	H.lastCompletedMerchantPos = nil

	local QuestRemote    = RS:WaitForChild("Events"):WaitForChild("Quest")
	local MerchantRemote = RS:WaitForChild("Events"):WaitForChild("TravelingMerchentRemote")
	local CompassGuider  = RS:WaitForChild("CompassGuider")

	local function getMerchantTargetPos()
		local guide = CompassGuider:FindFirstChild("Traveling Merchant") or CompassGuider:FindFirstChild("TravelingMerchant")
		if guide then
			if guide:IsA("Vector3Value") then return guide.Value end
			if guide:IsA("CFrameValue") then return guide.Value.Position end
			if guide:IsA("BasePart") then return guide.Position end
		end

		local npcFolder = workspace:FindFirstChild("NPCs")
		local physical = npcFolder and (npcFolder:FindFirstChild("Traveling Merchant") or npcFolder:FindFirstChild("TravelingMerchant"))
		if physical then
			return physical.PrimaryPart and physical.PrimaryPart.Position or physical:GetPivot().Position
		end

		return nil
	end

	local function getMerchantSeed()
		local function parseSeed(val)
			if type(val) == "number" and val > 100000000 then return val end
			if type(val) == "string" then
				local num = tonumber(val)
				if num and num > 100000000 then return num end
			end
			return nil
		end

		for _ = 1, 20 do
			local shopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
			if shopGui then
				local directSeed = parseSeed(shopGui:GetAttribute("Seed"))
					or parseSeed(shopGui:GetAttribute("seed"))
					or parseSeed(shopGui:GetAttribute("ShopSeed"))
				if directSeed then return directSeed end

				for _, obj in ipairs(shopGui:GetDescendants()) do
					local attrSeed = parseSeed(obj:GetAttribute("Seed"))
						or parseSeed(obj:GetAttribute("seed"))
						or parseSeed(obj:GetAttribute("ShopSeed"))
					if attrSeed then return attrSeed end

					for _, val in pairs(obj:GetAttributes()) do
						local anySeed = parseSeed(val)
						if anySeed then return anySeed end
					end

					if obj:IsA("IntValue") or obj:IsA("NumberValue") then
						local numSeed = parseSeed(obj.Value)
						if numSeed then return numSeed end
					elseif obj:IsA("StringValue") then
						local strSeed = parseSeed(obj.Value)
						if strSeed then return strSeed end
					end
				end
			end
			task.wait(0.2)
		end

		return nil
	end

	local function isMerchantShopOpen()
		local shopGui = LP.PlayerGui:FindFirstChild("MerchentShop")
		if not shopGui then return false end

		if shopGui:IsA("ScreenGui") or shopGui:IsA("BillboardGui") then
			return shopGui.Enabled ~= false
		end

		return true
	end

	local function getSelectedMerchantItems()
		local itemsToBuy = {}
		if type(H.merchantListSelected) == "table" then
			for k, v in pairs(H.merchantListSelected) do
				if v then
					table.insert(itemsToBuy, k)
				end
			end
		elseif type(H.merchantListSelected) == "string" and H.merchantListSelected ~= "" then
			table.insert(itemsToBuy, H.merchantListSelected)
		end
		return itemsToBuy
	end

	H.executeMerchantTask = function()
		if H.activeTask == "Merchant" then return false end

		local targetPos = getMerchantTargetPos()
		if not targetPos or (targetPos == Vector3.new(0,0,0)) then
			return false
		end

		H.notify("Merchant", "Merchant found. Moving in...", 3)

		local char = LP.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end

		local wasFishing = false
		if H.pauseFishingForTask then 
			wasFishing = H.pauseFishingForTask() 
		end

		H.activeTask = "Merchant"

		local function moveBackToMerchant(currentTargetPos)
			local moveTo = currentTargetPos + Vector3.new(0, 3, 3)
			H.DoSafeTeleport(moveTo)
		end

		moveBackToMerchant(targetPos)

		local interactActive = true
		local interactConn = H.run_svc.Stepped:Connect(function()
			if interactActive and LP.Character then
				for _, p in ipairs(LP.Character:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide = false end
				end
			end
		end)

		task.spawn(function()
			local takestamEvent = RS:WaitForChild("Events", 5):WaitForChild("takestam", 5)
			while interactActive do
				pcall(function() takestamEvent:FireServer(0.565, "dash") end)
				task.wait(0.35)
			end
		end)

		task.wait(1.0)

		local selectedItems = getSelectedMerchantItems()
		local shopOpened = false
		local seed = nil

		for attempt = 1, 12 do
			if H.activeTask ~= "Merchant" then
				break
			end

			local currentPos = getMerchantTargetPos() or targetPos
			if currentPos and hrp and (hrp.Position - currentPos).Magnitude > 10 then
				moveBackToMerchant(currentPos)
			end

			pcall(function() QuestRemote:InvokeServer({"npcChat", true}) end)
			task.wait(0.35)

			pcall(function() MerchantRemote:InvokeServer("OpenShop") end)
			task.wait(0.6)

			if isMerchantShopOpen() then
				seed = getMerchantSeed()
				if seed then
					shopOpened = true
					break
				end
			end

			if attempt < 12 then
				H.notify("Merchant", "Shop did not open yet, retrying...", 2)
				task.wait(0.45)
			end
		end

		if not shopOpened or not seed then
			H.notify("Merchant", "Could not open the merchant shop.", 4)
		else
			local boughtAnything = false

			for _, itemName in ipairs(selectedItems) do
				local quantity = H.merchantItemAmounts[itemName] or 1
				H.notify("Merchant", "Buying " .. itemName .. " x" .. quantity, 4)

				for i = 1, quantity do
					local ok, result = pcall(function()
						return MerchantRemote:InvokeServer(itemName, seed)
					end)

					if not ok then break end
					if type(result) == "string" and result:lower():find("refresh") then break end

					task.wait(0.15)
				end
				boughtAnything = true
			end

			if boughtAnything then
				H.notify("Merchant", "Done shopping.", 5)
			else
				H.notify("Merchant", "No selected items were bought.", 3)
			end
		end

		pcall(function() MerchantRemote:InvokeServer("Close") end)
		task.wait(0.5)

		pcall(function() QuestRemote:InvokeServer({"npcChat", false}) end)
		task.wait(0.5)

		interactActive = false
		interactConn:Disconnect()

		if H.resumeFishingAfterTask then H.resumeFishingAfterTask(wasFishing) end
		H.lastCompletedMerchantPos = targetPos
		H.merchantWaitingNext = true
		H.activeTask = nil

		return true
	end

	task.spawn(function()
		local lastMerchantPos = nil
		local lastMerchantRun = 0

		while task.wait(2) do
			if not H.autoMerchantEnabled then
				lastMerchantPos = nil
				lastMerchantRun = 0
				H.merchantWaitingNext = false
				H.lastCompletedMerchantPos = nil
				continue
			end

			if H.activeTask and H.activeTask ~= "Merchant" then
				continue
			end

			local targetPos = getMerchantTargetPos()
			if not targetPos or targetPos == Vector3.new(0,0,0) then
				lastMerchantPos = nil
				lastMerchantRun = 0
				H.merchantWaitingNext = false
				H.lastCompletedMerchantPos = nil
				continue
			end

			if H.merchantWaitingNext then
				local completedPos = H.lastCompletedMerchantPos
				if completedPos and (completedPos - targetPos).Magnitude <= 25 then
					continue
				else
					H.merchantWaitingNext = false
					H.lastCompletedMerchantPos = nil
				end
			end

			if not lastMerchantPos or (lastMerchantPos - targetPos).Magnitude > 25 then
				lastMerchantPos = targetPos
				lastMerchantRun = 0
			end

			local char = LP.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then
				continue
			end

			local dist = (hrp.Position - targetPos).Magnitude
			local shouldRun = false

			if dist > 20 then
				shouldRun = true
			elseif lastMerchantRun == 0 then
				shouldRun = true
			end

			if shouldRun and tick() - lastMerchantRun >= 3 then
				local success = H.executeMerchantTask()
				if success then
					lastMerchantPos = targetPos
					lastMerchantRun = tick()
				end
			end
		end
	end)
end


local function initAutoHaki()
	local H = _G_Hub
	local RS = game:GetService("ReplicatedStorage")

	H.autoHakiEnabled  = false
	H.autoHakiLoopID   = 0
	H.autoHakiUpHeight = H.autoHakiUpHeight or 8.7
	H.autoHakiKills    = H.autoHakiKills or 0
	H.autoHakiStatus   = "idle"
	H.autoHakiWHKEnabled = true

	local combatRegister   = RS:WaitForChild("Events"):WaitForChild("CombatRegister")
	local combatAnimations = RS:WaitForChild("CombatAnimations"):WaitForChild("Melee")
	local questEvent       = RS:WaitForChild("Events"):WaitForChild("Quest")
	local hakiRemote       = RS:WaitForChild("Events"):WaitForChild("Haki")

	local HAKI_POS        = Vector3.new(-4245, 170, -2989)
	local HAKI_QUEST_NAME = "Road to Armament"

	local CombatAnims = {
		combatAnimations.Punch1,
		combatAnimations.Punch2,
		combatAnimations.Punch3,
		combatAnimations.GroundPunch4,
		combatAnimations.GroundPunch5,
	}

	local mystats    = RS:FindFirstChild("Stats" .. H.lp.Name)
	local currentQuest = mystats and mystats.Quest and mystats.Quest.CurrentQuest

	local function equipMelee()
		local backpack = H.lp:FindFirstChild("Backpack")
		if not backpack then return false end
		local melee = backpack:FindFirstChild("Melee")
		if not melee then
			local char = H.lp.Character
			if char and char:FindFirstChild("Melee") then return true end
			return false
		end
		local pcFolder = workspace:FindFirstChild("PlayerCharacters")
		local pc = pcFolder and pcFolder:FindFirstChild(H.lp.Name)
		if not pc then pc = H.lp.Character end
		if pc then melee.Parent = pc; return true end
		return false
	end

	local function activateHaki()
		pcall(function() hakiRemote:FireServer("Buso") end)
	end

	local function getNPCID(npc)
		if not npc then return nil end
		local v = npc:FindFirstChild("NPCID")
		if v then return v.Value end
		local cfg = npc:FindFirstChild("Configuration")
		if cfg then
			local cv = cfg:FindFirstChild("NPCID")
			if cv then return cv.Value end
		end
		return npc:GetAttribute("NPCID")
	end

	local function getAllYetis()
		local res = {}
		local npcs = workspace:FindFirstChild("NPCs")
		if not npcs then return res end
		for _, npc in ipairs(npcs:GetChildren()) do
			if npc:IsA("Model") and npc.Name == "Yeti" then
				local hum = npc:FindFirstChild("Humanoid")
				local hrp = npc:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and hrp then
					table.insert(res, {npc=npc, hrp=hrp})
				end
			end
		end
		return res
	end

	local function getClosestYeti()
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if not rp then return nil end
		local closest, bestDist = nil, math.huge
		for _, d in ipairs(getAllYetis()) do
			local dist = (rp.Position - d.hrp.Position).Magnitude
			if dist < bestDist then
				bestDist = dist
				closest = d.npc
			end
		end
		return closest
	end

	local questTaken = false

	local function getCurrentQuestValue()
		local name = H.lp.Name
		local statsFolder = RS:FindFirstChild("Stats"..name)
		if not statsFolder then return "" end
		local questFolder = statsFolder:FindFirstChild("Quest")
		if not questFolder then return "" end
		local cq = questFolder:FindFirstChild("CurrentQuest")
		if not cq then return "" end
		return cq.Value or ""
	end

	local function ensureQuest()
		if questTaken then return end
		local qv = getCurrentQuestValue()
		if qv == HAKI_QUEST_NAME then
			questTaken = true
			return
		end
		H.autoHakiStatus = "quest"
		H.DoArcTeleport(HAKI_POS)
		task.wait(1)
		pcall(function()
			questEvent:InvokeServer({"takequest", HAKI_QUEST_NAME})
		end)
		task.wait(1)
		questTaken = true
	end

	local afFloat = function(bool)
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if not rp then return end
		if bool then
			if not rp:FindFirstChild("AH_BV") then
				local bv = Instance.new("BodyVelocity", rp)
				bv.Name = "AH_BV"
				bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
				bv.Velocity = Vector3.zero
			end
		else
			local bv = rp:FindFirstChild("AH_BV")
			if bv then bv:Destroy() end
		end
	end

	local canAttack = true

	local function attackSingle(npc, lockedY)
		if not npc then return end
		local hum = npc:FindFirstChild("Humanoid")
		local hrp = npc:FindFirstChild("HumanoidRootPart")
		if not hum or hum.Health <= 0 or not hrp then return end
		if not canAttack then return end
		canAttack = false

		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		local id = getNPCID(npc)

		for combo = 1, 5 do
			if not H.autoHakiEnabled then break end
			hum = npc:FindFirstChild("Humanoid")
			hrp = npc:FindFirstChild("HumanoidRootPart")
			if not hum or hum.Health <= 0 or not hrp then break end

			local hrpList = {}
			local npcIDs  = {}
			for _, d in ipairs(getAllYetis()) do
				if d.hrp and (d.hrp.Position - hrp.Position).Magnitude <= 20 then
					table.insert(hrpList, d.hrp)
					local did = getNPCID(d.npc)
					if did then table.insert(npcIDs, did) end
				end
			end
			if #hrpList == 0 then table.insert(hrpList, hrp) end

			if rp and hrp then
				rp.AssemblyLinearVelocity = Vector3.zero
				rp.CFrame = CFrame.lookAt(
					Vector3.new(hrp.Position.X, lockedY, hrp.Position.Z),
					Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
				)
			end

			pcall(function()
				combatRegister:InvokeServer({
					[1]="swingsfx",[2]="Melee",[3]=combo,[4]="Ground",
					[5]=false,[6]=CombatAnims[combo],[7]=1.75,[8]=1.5
				})
				local da = {[1]={
					[1]="damage",[2]=hrpList,[3]="Melee",
					[4]={combo,"Ground","Melee"},[5]=true,
					[6]=rp and rp.CFrame or CFrame.new(),
					aircombo="Ground"
				}}
				if #npcIDs > 0 then da[1].NPCIDs = npcIDs end
				combatRegister:InvokeServer(unpack(da))
			end)

			task.wait(0.21)
		end

		task.wait(1.2)
		canAttack = true
	end

	-- White screen
	local function setHakiWhiteScreen(state)
		H.autoHakiWHKEnabled = state

		if H.hakiWhiteScreenTimerConn then
			H.hakiWhiteScreenTimerConn:Disconnect()
			H.hakiWhiteScreenTimerConn = nil
		end
		if H.hakiWhiteScreenGui then
			H.hakiWhiteScreenGui:Destroy()
			H.hakiWhiteScreenGui = nil
		end
		if not state then return end

		local coreGui = game:GetService("CoreGui")

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "PrinceHubHakiWHK"
		screenGui.IgnoreGuiInset = true
		screenGui.ResetOnSpawn = false
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.DisplayOrder = 1
		pcall(function() screenGui.Parent = coreGui end)
		if not screenGui.Parent then screenGui.Parent = H.lp:WaitForChild("PlayerGui") end

		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.new(1, 1, 1)
		bg.BorderSizePixel = 0
		bg.ZIndex = 1
		bg.Parent = screenGui

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0, 70)
		title.Position = UDim2.fromScale(0, 0.32)
		title.AnchorPoint = Vector2.new(0, 0.5)
		title.BackgroundTransparency = 1
		title.Text = "PRINCE HUB"
		title.TextColor3 = Color3.fromRGB(0, 0, 0)
		title.Font = Enum.Font.GothamBlack
		title.TextScaled = true
		title.TextXAlignment = Enum.TextXAlignment.Center
		title.ZIndex = 2
		title.Parent = bg

		local subtitle = Instance.new("TextLabel")
		subtitle.Size = UDim2.new(1, 0, 0, 28)
		subtitle.Position = UDim2.fromScale(0, 0.44)
		subtitle.AnchorPoint = Vector2.new(0, 0.5)
		subtitle.BackgroundTransparency = 1
		subtitle.Text = "AUTO HAKI"
		subtitle.TextColor3 = Color3.fromRGB(30, 30, 30)
		subtitle.Font = Enum.Font.GothamBold
		subtitle.TextScaled = true
		subtitle.TextXAlignment = Enum.TextXAlignment.Center
		subtitle.ZIndex = 2
		subtitle.Parent = bg

		local statusLabel = Instance.new("TextLabel")
		statusLabel.Size = UDim2.new(1, 0, 0, 22)
		statusLabel.Position = UDim2.fromScale(0, 0.53)
		statusLabel.AnchorPoint = Vector2.new(0, 0.5)
		statusLabel.BackgroundTransparency = 1
		statusLabel.Text = "idle"
		statusLabel.TextColor3 = Color3.fromRGB(80, 80, 80)
		statusLabel.Font = Enum.Font.GothamBold
		statusLabel.TextScaled = true
		statusLabel.TextXAlignment = Enum.TextXAlignment.Center
		statusLabel.ZIndex = 2
		statusLabel.Parent = bg

		local killsLabel = Instance.new("TextLabel")
		killsLabel.Size = UDim2.new(1, 0, 0, 22)
		killsLabel.Position = UDim2.fromScale(0, 0.61)
		killsLabel.AnchorPoint = Vector2.new(0, 0.5)
		killsLabel.BackgroundTransparency = 1
		killsLabel.Text = "yetis killed: 0 / 50"
		killsLabel.TextColor3 = Color3.fromRGB(40, 40, 40)
		killsLabel.Font = Enum.Font.GothamBold
		killsLabel.TextScaled = true
		killsLabel.TextXAlignment = Enum.TextXAlignment.Center
		killsLabel.ZIndex = 2
		killsLabel.Parent = bg

		local timer = Instance.new("TextLabel")
		timer.Size = UDim2.new(1, 0, 0, 20)
		timer.Position = UDim2.fromScale(0, 0.69)
		timer.AnchorPoint = Vector2.new(0, 0.5)
		timer.BackgroundTransparency = 1
		timer.Text = "00:00"
		timer.TextColor3 = Color3.fromRGB(40, 40, 40)
		timer.Font = Enum.Font.GothamBold
		timer.TextScaled = true
		timer.TextXAlignment = Enum.TextXAlignment.Center
		timer.ZIndex = 2
		timer.Parent = bg

		H.hakiWhiteScreenGui = screenGui
		H.hakiWHKStartTime = tick()

		local statusMap = {
			idle        = "chilling...",
			teleporting = "heading to haki island",
			quest       = "grabbing the quest",
			killing     = "killing yeti",
			waiting     = "waiting for respawn",
		}

		H.hakiWhiteScreenTimerConn = game:GetService("RunService").Heartbeat:Connect(function()
			if not H.hakiWhiteScreenGui or not bg.Parent then return end
			local elapsed = tick() - H.hakiWHKStartTime
			local minutes = math.floor(elapsed / 60)
			local seconds = math.floor(elapsed % 60)
			timer.Text = string.format("%02d:%02d", minutes, seconds)
			local killCount = H.autoHakiKills or 0
			pcall(function()
				local pg = game:GetService("Players").LocalPlayer.PlayerGui
				local top = pg:FindFirstChild("Quest") and pg.Quest:FindFirstChild("Main") and pg.Quest.Main:FindFirstChild("Info") and pg.Quest.Main.Info:FindFirstChild("Top")
				if top then
					-- look for a TextLabel inside Top that contains X/50
					for _, lbl in pairs(top:GetDescendants()) do
						if lbl:IsA("TextLabel") or lbl:IsA("TextBox") then
							local n = tonumber((lbl.Text or ""):match("(%d+)%s*/%s*50"))
							if n then killCount = n; break end
							-- fallback: first number found
							local n2 = tonumber((lbl.Text or ""):match("(%d+)"))
							if n2 and n2 <= 50 then killCount = n2; break end
						end
					end
				end
			end)
			killsLabel.Text = "yetis killed: " .. killCount .. " / 50"
			statusLabel.Text = statusMap[H.autoHakiStatus or "idle"] or H.autoHakiStatus or "idle"
			if killCount >= 50 then
				H.hakiWhiteScreenTimerConn:Disconnect()
				H.hakiWhiteScreenTimerConn = nil
				if H.hakiWhiteScreenGui then H.hakiWhiteScreenGui:Destroy(); H.hakiWhiteScreenGui = nil end
			end
		end)
	end
	H.setHakiWhiteScreen = setHakiWhiteScreen

	H.startAutoHaki = function()
		if H.autoHakiEnabled then return end
		H.autoHakiEnabled = true
		H.autoHakiLoopID  = H.autoHakiLoopID + 1
		local loopID = H.autoHakiLoopID
		canAttack = true
		H.autoHakiKills = 0
		afFloat(true)
		equipMelee()
		activateHaki()

		H.autoHakiStatus = "teleporting"
		local QUEST_CF = CFrame.new(-4246.068, 169.782, -2990.422, -0.147, 0.000, 0.989, -0.000, 1.000, -0.000, -0.989, -0.000, -0.147)
		local FARM_CF  = CFrame.new(-4394.988,  77.782, -2945.237, -0.992, -0.000, 0.125, -0.000, 1.000, 0.000, -0.125, 0.000, -0.992)

		H.DoArcTeleport(QUEST_CF.Position)

		H.autoHakiStatus = "quest"
		ensureQuest()

		H.autoHakiStatus = "teleporting"
		H.DoArcTeleport(FARM_CF.Position)

		H.autoHakiStatus = "idle"

		task.spawn(function()
			while H.autoHakiEnabled and H.autoHakiLoopID == loopID do
				local char = H.lp.Character
				local hum  = char and char:FindFirstChild("Humanoid")
				local rp   = char and char:FindFirstChild("HumanoidRootPart")
				if not char or not hum or hum.Health <= 0 or not rp then
					task.wait(0.5); continue
				end

				equipMelee()

				local yeti = getClosestYeti()
				if not yeti then
					H.autoHakiStatus = "waiting"
					H.DoSafeTeleport(HAKI_POS)
					task.wait(2); continue
				end

				local hrp = yeti:FindFirstChild("HumanoidRootPart")
				if hrp then
					local lockedY = hrp.Position.Y + (H.autoHakiUpHeight or 8.4)
					local targetCF = CFrame.lookAt(
						Vector3.new(hrp.Position.X, lockedY, hrp.Position.Z),
						Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
					)

					if (rp.Position - targetCF.Position).Magnitude > 6 then
						H.autoHakiStatus = "teleporting"
						H.DoSafeTeleport(targetCF.Position)
					end

					H.autoHakiStatus = "killing"
					task.wait(0.15)
					attackSingle(yeti, lockedY)
					local yetiHumAfter = yeti:FindFirstChild("Humanoid")
					if not yetiHumAfter or yetiHumAfter.Health <= 0 then
						H.autoHakiKills = (H.autoHakiKills or 0) + 1
						if H.autoHakiKills >= 50 then
							H.autoHakiStatus = "idle"
							setHakiWhiteScreen(false)
							H.stopAutoHaki()
							if Options and Options.AutoHakiToggle then
								Options.AutoHakiToggle:SetValue(false)
							end
							Library:Notify("50 yetis killed, quest complete!", 5)
							return
						end
					end
					H.autoHakiStatus = "idle"
				end

				task.wait(0.05)
			end

			afFloat(false)
			H.autoHakiEnabled = false
		end)
	end

	H.stopAutoHaki = function()
		H.autoHakiEnabled = false
		H.autoHakiLoopID  = H.autoHakiLoopID + 1
		questTaken = false
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if rp then
			local bv = rp:FindFirstChild("AH_BV")
			if bv then bv:Destroy() end
		end
	end
end
-- ============================================================
-- FEATURE: AUTO FARM SEA 2 (USING FACEMOUSE TWEEN TELEPORT)
-- ============================================================
local function initAutoFarmSea2()
	local H   = _G_Hub
	local RS  = game:GetService("ReplicatedStorage")
	getgenv().Sea2Farm = false

	local S2 = {}
	S2.isRunning   = false
	S2.LoopID      = 0
	S2.canAttack   = true
	S2.npcDistance = 4   -- distance entre le perso et le NPC (ajustable via slider)
	S2.upHeight    = 9
	S2.lockedPos   = nil -- position locked during combat (nil = no lock)

	-- Heartbeat: keep player on the NPC position during combat
	game:GetService("RunService").Heartbeat:Connect(function()
		if not S2.isRunning or not S2.lockedPos then return end
		if H.isTeleporting then return end
		local char = H.lp.Character
		local rp   = char and char:FindFirstChild("HumanoidRootPart")
		local hum  = char and char:FindFirstChild("Humanoid")
		if not rp or not hum or hum.Health <= 0 then return end
		rp.CFrame = CFrame.new(S2.lockedPos)
		rp.AssemblyLinearVelocity  = Vector3.zero
		rp.AssemblyAngularVelocity = Vector3.zero
	end)

	local S2_CONFIG = { QUEST_WAIT_TIME = 1, COMBO_DELAY = 0.21, FULL_COMBO_WAIT = 1.2 }

	-- Sea 2 zones (extensible)
	local S2_ZONES = {
		[1] = {
			MinLevel   = 1,
			MaxLevel   = 9999,
			TargetName = "Crazy Wolf",
			QuestName  = "Help PJ",
			QuestPos   = CFrame.new(7121.167, 56.273, 10553.389),
			Center     = CFrame.new(7319.132, 21.723, 10561.868),
			Method     = "1by1",
			ZoneKey    = 1,
		},
	}

	local mystats      = RS:FindFirstChild("Stats" .. H.lp.Name)
	local stats        = mystats and mystats:FindFirstChild("Stats")
	local levelValue   = stats and stats:FindFirstChild("Level")
	local currentquest = mystats and mystats.Quest and mystats.Quest.CurrentQuest

	local combatRegister   = RS:WaitForChild("Events"):WaitForChild("CombatRegister")
	local combatAnimations = RS:WaitForChild("CombatAnimations"):WaitForChild("Melee")
	local questEvent       = RS:WaitForChild("Events"):WaitForChild("Quest")

	local CombatAnims = {
		[1] = combatAnimations.Punch1,    [2] = combatAnimations.Punch2,
		[3] = combatAnimations.Punch3,    [4] = combatAnimations.GroundPunch4,
		[5] = combatAnimations.GroundPunch5,
	}
	-- Swing speeds identiques au vrai script
	local SwingSpeeds = { 2, 1.75, 1.75, 1.75, 1.75 }

	local function s2Float(bool)
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if not rp then return end
		if bool then
			if not rp:FindFirstChild("S2_BV") then
				local bv = Instance.new("BodyVelocity", rp)
				bv.Name = "S2_BV"; bv.MaxForce = Vector3.new(1e5, 1e5, 1e5); bv.Velocity = Vector3.zero
			end
		else
			local bv = rp:FindFirstChild("S2_BV")
			if bv then bv:Destroy() end
		end
	end

	local function getLevel() return levelValue and levelValue.Value or 0 end

	local function getZone(lvl)
		for _, z in ipairs(S2_ZONES) do
			if lvl >= z.MinLevel and lvl <= z.MaxLevel then return z end
		end
		return S2_ZONES[1]
	end

	local function equipMelee()
		local backpack = H.lp:FindFirstChild("Backpack")
		if not backpack then return false end
		local melee = backpack:FindFirstChild("Melee")
		if not melee then
			local char = H.lp.Character
			if char and char:FindFirstChild("Melee") then return true end
			return false
		end
		local pcFolder = workspace:FindFirstChild("PlayerCharacters")
		local pc = pcFolder and pcFolder:FindFirstChild(H.lp.Name)
		if not pc then pc = H.lp.Character end
		if pc then melee.Parent = pc; return true end
		return false
	end

	local function getNPCID(npc)
		if not npc then return nil end
		local v = npc:FindFirstChild("NPCID")
		if v then return v.Value end
		local cfg = npc:FindFirstChild("Configuration")
		if cfg then
			local cv = cfg:FindFirstChild("NPCID")
			if cv then return cv.Value end
		end
		return npc:GetAttribute("NPCID")
	end

	-- Get all living wolves within a radius around a position
	local function getAllWolvesNearby(pos, radius)
		radius = radius or 20
		local res = {}
		local function scanFolder(folderName)
			local folder = workspace:FindFirstChild(folderName)
			if not folder then return end
			for _, v in pairs(folder:GetChildren()) do
				if v:IsA("Model") and string.find(string.lower(v.Name), string.lower("Crazy Wolf")) then
					local h   = v:FindFirstChild("Humanoid")
					local hrp = v:FindFirstChild("HumanoidRootPart")
					if h and h.Health > 0 and hrp and (hrp.Position - pos).Magnitude <= radius then
						table.insert(res, { npc = v, hrp = hrp })
					end
				end
			end
		end
		scanFolder("NPCs")
		scanFolder("Enemies")
		return res
	end

	-- -------------------------------------------------------
	-- doCombo: same format as dungeon + real auto farm
	-- swingsfx PUIS damage avec hrpList + NPCIDs
	-- Hits ALL wolves in range (not just the main target)
	-- Movement handled in main loop before call (same as Sea 1)
	-- -------------------------------------------------------
	local function doCombo(npc)
		if not S2.canAttack then return end
		local hum = npc:FindFirstChild("Humanoid")
		local hrp = npc:FindFirstChild("HumanoidRootPart")
		if not hum or hum.Health <= 0 or not hrp then return end

		local char = H.lp.Character
		local rp   = char and char:FindFirstChild("HumanoidRootPart")
		local myHum = char and char:FindFirstChild("Humanoid")
		if not rp or not myHum or myHum.Health <= 0 then return end

		S2.canAttack = false
		local id = getNPCID(npc)

		for combo = 1, 5 do
			if not getgenv().Sea2Farm then break end

			-- Re-fetch live NPC position every hit
			local liveHRP = npc:FindFirstChild("HumanoidRootPart")
			hum = npc:FindFirstChild("Humanoid")
			if not liveHRP or not liveHRP.Parent or not hum or hum.Health <= 0 then break end

			rp = char and char:FindFirstChild("HumanoidRootPart")
			if not rp then break end

			-- Move ON the NPC at current live position, no forced rotation
			local npcPos   = liveHRP.Position
			local standPos = Vector3.new(npcPos.X, npcPos.Y + S2.upHeight, npcPos.Z)
			rp.AssemblyLinearVelocity  = Vector3.zero
			rp.AssemblyAngularVelocity = Vector3.zero
			rp.CFrame = CFrame.new(standPos)
			S2.lockedPos = standPos

			-- Collect wolves in range from current NPC position
			local hrpList = {}
			local npcIDs  = {}
			for _, d in ipairs(getAllWolvesNearby(npcPos, 20)) do
				if d.hrp and d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health > 0 then
					table.insert(hrpList, d.hrp)
					local did = getNPCID(d.npc)
					if did then table.insert(npcIDs, did) end
				end
			end
			if #hrpList == 0 then
				table.insert(hrpList, liveHRP)
				if id then table.insert(npcIDs, id) end
			end

			pcall(function()
				combatRegister:InvokeServer({
					[1] = "swingsfx", [2] = "Melee", [3] = combo,
					[4] = "Ground",   [5] = false,    [6] = CombatAnims[combo],
					[7] = SwingSpeeds[combo], [8] = 1.5
				})

				-- Re-fetch after InvokeServer
				local freshHRP = npc:FindFirstChild("HumanoidRootPart")
				rp = char and char:FindFirstChild("HumanoidRootPart")
				if freshHRP and freshHRP.Parent and rp then
					local freshPos  = freshHRP.Position
					local freshStand = Vector3.new(freshPos.X, freshPos.Y + S2.upHeight, freshPos.Z)
					rp.CFrame = CFrame.new(freshStand)
					S2.lockedPos = freshStand

					-- Update hrpList with fresh position
					hrpList = {}
					npcIDs  = {}
					for _, d in ipairs(getAllWolvesNearby(freshPos, 20)) do
						if d.hrp and d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health > 0 then
							table.insert(hrpList, d.hrp)
							local did = getNPCID(d.npc)
							if did then table.insert(npcIDs, did) end
						end
					end
					if #hrpList == 0 then
						table.insert(hrpList, freshHRP)
						if id then table.insert(npcIDs, id) end
					end
				end

				local da = {
					[1] = {
						[1] = "damage", [2] = hrpList, [3] = "Melee",
						[4] = { combo, "Ground", "Melee" }, [5] = true,
						[6] = rp and rp.CFrame or CFrame.new(standPos),
						aircombo = "Ground",
					}
				}
				if #npcIDs > 0 then da[1].NPCIDs = npcIDs end
				combatRegister:InvokeServer(unpack(da))
			end)

			task.wait(S2_CONFIG.COMBO_DELAY)
		end

		task.wait(S2_CONFIG.FULL_COMBO_WAIT)
		S2.lockedPos = nil
		S2.canAttack = true
	end

	local function getClosestNPC(name)
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if not rp then return nil end
		local best, bestDist = nil, math.huge
		local function scanFolder(folderName)
			local folder = workspace:FindFirstChild(folderName)
			if not folder then return end
			for _, v in pairs(folder:GetChildren()) do
				if v:IsA("Model") and string.find(string.lower(v.Name), string.lower(name)) then
					local h = v:FindFirstChild("Humanoid")
					local hrp = v:FindFirstChild("HumanoidRootPart")
					if h and h.Health > 0 and hrp then
						local d = (rp.Position - hrp.Position).Magnitude
						if d < bestDist then bestDist = d; best = v end
					end
				end
			end
		end
		scanFolder("NPCs")
		scanFolder("Enemies")
		return best
	end

	local S2_SPAWN_POS   = Vector3.new(7319.132, 21.723, 10561.868)
	local setSpawnRemote = RS:WaitForChild("Events"):WaitForChild("SetSpawn")
	local questRemote    = RS:WaitForChild("Events"):WaitForChild("Quest")

	local function doSetSpawn()
		H.DoSafeTeleport(S2_SPAWN_POS)
		task.wait(1)
		pcall(function() setSpawnRemote:FireServer() end)
		task.wait(0.5)
	end
	-- Exposer pour initAutoFarmKaitun
	H.doSetSpawnS2 = doSetSpawn

	H.startSea2Farm = function()
		if S2.isRunning then return end
		S2.isRunning = true
		getgenv().Sea2Farm = true
		S2.LoopID = S2.LoopID + 1
		local currentLoop = S2.LoopID

		s2Float(true)
		equipMelee()

		task.spawn(function()
			-- Set spawn FIRST — float disabled during movement
			s2Float(false)
			doSetSpawn()
			s2Float(true)

			local currentZone  = getZone(getLevel())
			local lastZoneName = nil

			while getgenv().Sea2Farm and S2.LoopID == currentLoop do
				local lvl = getLevel()
				local qn  = currentquest and currentquest.Value or ""

				currentZone = getZone(lvl)

				if lastZoneName ~= currentZone.TargetName then
					lastZoneName = currentZone.TargetName
					H.notify("Sea2Farm", "Farming: " .. currentZone.TargetName, 4)
				end

				local char = H.lp.Character
				local hum  = char and char:FindFirstChild("Humanoid")
				local rp   = char and char:FindFirstChild("HumanoidRootPart")

				if not char or not hum or hum.Health <= 0 or not rp then
					task.wait(0.5); continue
				end

				-- Quete : identique a takeQuest() du Sea 1, DoSafeTeleport
				if currentZone.QuestName ~= "" and qn ~= currentZone.QuestName then
					S2.lockedPos = nil
					H.DoSafeTeleport(currentZone.QuestPos.Position)
					task.wait(S2_CONFIG.QUEST_WAIT_TIME)
					pcall(function()
						questEvent:InvokeServer({ [1] = "takequest", [2] = currentZone.QuestName })
					end)
					task.wait(1)
					continue
				end

				-- Pas de NPC : aller au centre, identique Sea 1
				local targetNPC = getClosestNPC(currentZone.TargetName)
				if not targetNPC then
					local lockedY   = currentZone.Center.Y + S2.upHeight
					local centerPos = Vector3.new(currentZone.Center.X, lockedY, currentZone.Center.Z)
					if (rp.Position - centerPos).Magnitude > 6 then
						S2.lockedPos = nil
						H.DoSafeTeleport(centerPos)
					end
					task.wait(0.5); continue
				end

				-- NPC trouve : se placer dessus exactement comme Sea 1 (DoSafeTeleport si > 6)
				local hrp2 = targetNPC:FindFirstChild("HumanoidRootPart")
				if hrp2 then
					local lockedY   = hrp2.Position.Y + S2.upHeight
					local combatPos = Vector3.new(hrp2.Position.X, lockedY, hrp2.Position.Z)
					if (rp.Position - combatPos).Magnitude > 6 then
						S2.lockedPos = nil
						H.DoSafeTeleport(combatPos)
					end
					task.wait(0.15)
					equipMelee()
					doCombo(targetNPC)
				end

				task.wait(0.05)
			end

			s2Float(false)
			S2.isRunning = false
		end)
	end

	H.stopSea2Farm = function()
		getgenv().Sea2Farm = false
		S2.LoopID = S2.LoopID + 1
		S2.isRunning = false
		S2.canAttack = true
		S2.lockedPos = nil
		s2Float(false)
	end

	-- Exposer S2 pour que le slider du tab puisse modifier npcDistance et upHeight
	getgenv()._S2 = S2
end

-- SAFE FEATURES

-- ============================================================
-- FEATURE: ISLAND ESP (Sea 1 + Sea 2)
-- ============================================================
local function initIslandESP()
	local H = _G_Hub
	local camera = workspace.CurrentCamera
	local RunService = game:GetService("RunService")
	local CoreGui = game:GetService("CoreGui")

	H.islandESP1Enabled = false
	H.islandESP2Enabled = false

	-- Sea 1 islands
	local SEA1_ISLANDS = {
		["Baratie"]            = Vector3.new(-2978.326, 52.587, -6801.332),
		["Coliseum"]           = Vector3.new(-2033.487, 6.854, -7670.064),
		["Fishman Island"]     = Vector3.new(1816.722, 4.075, -12173.344),
		["Geppo Island"]       = Vector3.new(-3087.715, 94.544, -11755.474),
		["Haki Island"]        = Vector3.new(-4380.261, 7.482, -3143.222),
		["Island of Zoo"]      = Vector3.new(-3151.212, 11.734, -5236.932),
		["Loguetown"]          = Vector3.new(-6590.296, 7.225, -7670.699),
		["Marineford F1"]      = Vector3.new(425.249, 19.452, -4478.649),
		["Marineford G1"]      = Vector3.new(-5990.909, 57.246, -11492.621),
		["Orange Town"]        = Vector3.new(-2978.326, 52.587, -6801.332),
		["Reverse Mountain"]   = Vector3.new(-8027.381, 18.727, -8767.213),
		["Sandora"]            = Vector3.new(-1540.203, 3.975, -3343.566),
		["Shell Town"]         = Vector3.new(-1297.506, 4.125, -5056.664),
		["Shrine"]             = Vector3.new(-7350.260, 3.274, -14948.746),
		["Skypiea"]            = Vector3.new(3456.082, 1438.244, -9080.484),
		["Sphinx Island"]      = Vector3.new(-4000.557, 42.166, -9152.484),
		["Town of Beginnings"] = Vector3.new(-502.381, 5.950, -3414.961),
	}

	-- Sea 2 islands
	local SEA2_ISLANDS = {
		["Desert Kingdom"]     = Vector3.new(-3672.473, 19.368, 402.232),
		["Reverse Mountain 2"] = Vector3.new(-6348.723, 128.017, 399.657),
		["Coliseum"]           = Vector3.new(2218.833, 4.759, 6073.599),
		["Rose Kingdom"]       = Vector3.new(9248.953, 24.973, 7841.948),
		["Roger Island"]       = Vector3.new(12562.259, 7.529, 2829.644),
		["Foro Island"]        = Vector3.new(8151.155, 6.330, 4322.578),
		["Sakura Stronghold"]  = Vector3.new(6067.310, 12.542, -91.792),
		["Impel Down"]         = Vector3.new(5935.760, 5.724, -9471.919),
		["Juzo Island"]        = Vector3.new(1754.319, 19.776, -10563.824),
		["Sett's Arena"]       = Vector3.new(-7732.424, 9.979, -8120.898),
		["Thriller Bark"]      = Vector3.new(0, 0, 0),
	}

	-- Resolve dynamic Sea 2 positions
	local function resolveSea2Pos(name)
		if name == "Thriller Bark" then
			local isles = workspace:FindFirstChild("Islands")
			local isle = isles and isles:FindFirstChild(name)
			if isle then
				local pp = isle.PrimaryPart or isle:FindFirstChildWhichIsA("BasePart", true)
				return pp and pp.Position
			end
		end
		return nil
	end

	-- Create dedicated ScreenGui
	local espGui = Instance.new("ScreenGui")
	espGui.Name = "IslandESPGui"
	espGui.ResetOnSpawn = false
	espGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	pcall(function()
		local pg = (protectgui or (syn and syn.protect_gui))
		if pg then pg(espGui) end
		espGui.Parent = CoreGui
	end)
	if not espGui.Parent then espGui.Parent = game:GetService("Players").LocalPlayer.PlayerGui end

	-- Label pool: two labels per island (name + distance)
	local labelPool = {}

	local function getLabels(key)
		if not labelPool[key] then
			local nameLbl = Instance.new("TextLabel")
			nameLbl.Name = "Isle_Name_" .. key
			nameLbl.BackgroundTransparency = 1
			nameLbl.TextStrokeTransparency = 0.4
			nameLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
			nameLbl.Font = Enum.Font.GothamBold
			nameLbl.TextSize = 14
			nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
			nameLbl.Size = UDim2.new(0, 180, 0, 18)
			nameLbl.AnchorPoint = Vector2.new(0.5, 1)   -- anchored bottom-center
			nameLbl.TextXAlignment = Enum.TextXAlignment.Center
			nameLbl.ZIndex = 50
			nameLbl.Parent = espGui

			local distLbl = Instance.new("TextLabel")
			distLbl.Name = "Isle_Dist_" .. key
			distLbl.BackgroundTransparency = 1
			distLbl.TextStrokeTransparency = 0.4
			distLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
			distLbl.Font = Enum.Font.GothamBold
			distLbl.TextSize = 12
			distLbl.TextColor3 = Color3.fromRGB(255, 220, 80)
			distLbl.Size = UDim2.new(0, 180, 0, 16)
			distLbl.AnchorPoint = Vector2.new(0.5, 0)   -- anchored top-center
			distLbl.TextXAlignment = Enum.TextXAlignment.Center
			distLbl.ZIndex = 50
			distLbl.Parent = espGui

			labelPool[key] = { name = nameLbl, dist = distLbl }
		end
		return labelPool[key]
	end

	local function hideAll()
		for _, pair in pairs(labelPool) do
			pair.name.Visible = false
			pair.dist.Visible = false
		end
	end

	local function updateESP(islands, resolveFunc)
		local char = H.lp.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then hideAll(); return end
		local myPos = hrp.Position

		for name, pos in pairs(islands) do
			local worldPos = pos
			if resolveFunc and (pos == Vector3.new(0,0,0)) then
				worldPos = resolveFunc(name)
				if not worldPos then
					local pair = labelPool[name]
					if pair then pair.name.Visible = false; pair.dist.Visible = false end
					continue
				end
			end

			local screenPos, onScreen = camera:WorldToViewportPoint(worldPos)
			local pair = getLabels(name)

			if onScreen and screenPos.Z > 0 then
				local dist = math.floor((myPos - worldPos).Magnitude)
				-- Name above the point
				pair.name.Text = name
				pair.name.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - 2)
				pair.name.Visible = true
				-- Distance en dessous du point
				pair.dist.Text = dist .. " m"
				pair.dist.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y + 2)
				pair.dist.Visible = true
			else
				pair.name.Visible = false
				pair.dist.Visible = false
			end
		end
	end

	-- Boucle RenderStepped
	RunService.RenderStepped:Connect(function()
		if not H.islandESP1Enabled and not H.islandESP2Enabled then
			hideAll(); return
		end

		-- Cacher d'abord tout
		for k, lbl in pairs(labelPool) do
			lbl.Visible = false
		end

		if H.islandESP1Enabled then
			updateESP(SEA1_ISLANDS, nil)
		end
		if H.islandESP2Enabled then
			updateESP(SEA2_ISLANDS, resolveSea2Pos)
		end
	end)

	espGui.AncestryChanged:Connect(function()
		if not espGui.Parent then
			labelPool = {}
		end
	end)
end

initChestESP()
initMachineESP()
initPlayerESP()
initIslandESP()
initNoStun()
initSkinChanger()
initNameChanger()

-- ============================================================
-- FEATURE: AUTO FARM KAITUN
-- Phase unique : Farm Fishman Cave / Fishman Karate User du lvl 1 au lvl 675
-- ============================================================
local function initAutoFarmKaitun()
	local H  = _G_Hub
	local RS = game:GetService("ReplicatedStorage")

	getgenv().KaitunFarm = false

	local KT = {}
	KT.isRunning = false
	KT.LoopID    = 0
	KT.status    = "idle"

	-- Dynamic resolution on each call to avoid nil on load
	local function getLevel()
		local ms = RS:FindFirstChild("Stats" .. H.lp.Name)
		local lv = ms and ms:FindFirstChild("Stats") and ms.Stats:FindFirstChild("Level")
		return lv and lv.Value or 0
	end

	local function phase1_farm()
		H.DisableForwardKey = true
		H.notify("KaitunFarm", "Kaitun Farm started", 5)

		local RS2             = game:GetService("ReplicatedStorage")
		local combatReg       = RS2:WaitForChild("Events"):WaitForChild("CombatRegister")
		local combatAnims     = RS2:WaitForChild("CombatAnimations"):WaitForChild("Melee")
		local questEvt        = RS2:WaitForChild("Events"):WaitForChild("Quest")

		local ANIMS = {
			combatAnims.Punch1, combatAnims.Punch2, combatAnims.Punch3,
			combatAnims.GroundPunch4, combatAnims.GroundPunch5,
		}
		local COMBO_DELAY    = 0.21
		local FULL_COMBO_WAIT = 1.2
		local KAITUN_HOVER_HEIGHT = 8
		local KAITUN_HIT_HEIGHT = 4.35
		local KAITUN_HIT_FORWARD_OFFSET = 0

		local function p1GetHoverHeight()
			return KAITUN_HOVER_HEIGHT
		end

		local function p1CFrameKeepBaseRotation(rp, pos)
			if not rp then return CFrame.new(pos) end
			-- Garde une orientation debout naturelle : on conserve seulement le yaw actuel.
			-- Avoids downward lookAt that caused 90° rotation.
			local _, yaw, _ = rp.CFrame:ToOrientation()
			return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
		end

		-- Fishman Cave only, from level 1 to 675.
		-- Aucun passage par Bandit / Zou / Saw Shark / Sea 2.
		local KZONE_HEIGHT_DEFAULTS = { [4] = KAITUN_HOVER_HEIGHT }
		local KZONES = {
			{MinLevel=1, MaxLevel=425, TargetName="Fishman Karate User", QuestName="Help becky", QuestMinLevel=190, WalkTo=CFrame.new(7772.802, -2163.832, -17144.355), QuestPos=CFrame.new(7731.026, -2175.832, -17222.637), Method="Group", Center=CFrame.new(7736.441, -2176.832, -17308.871), ZoneKey=4},
		}

		local canAttack = true
		local combatAnchorActive = false
		local combatHoverTarget = nil
		local combatHoverHeight = KAITUN_HOVER_HEIGHT
		local combatHoverToken = 0

		-- Release movement keys that may stay "stuck" after a TP.
		-- Releases WASD/ZQSD keys to cover all keyboard layouts.
		local function p1ReleaseMovementInputs()
			pcall(function()
				local vim = game:GetService("VirtualInputManager")
				for _ = 1, 3 do
					for _, key in ipairs({
						Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
						Enum.KeyCode.Z, Enum.KeyCode.Q, Enum.KeyCode.Up, Enum.KeyCode.Down,
						Enum.KeyCode.Left, Enum.KeyCode.Right
						}) do
						vim:SendKeyEvent(false, key, false, game)
					end
					task.wait()
				end
			end)

			local char = H.lp.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local rp = char and char:FindFirstChild("HumanoidRootPart")
			if hum then
				hum:Move(Vector3.zero, false)
				hum.PlatformStand = false
				hum.Sit = false
				hum.AutoRotate = true
			end
			if rp then
				rp.AssemblyLinearVelocity = Vector3.zero
				rp.AssemblyAngularVelocity = Vector3.zero
			end
		end

		local function p1SetCombatAnchor(enabled)
			local char = H.lp.Character
			local rp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not rp then return end

			combatAnchorActive = enabled == true
			if not combatAnchorActive then
				combatHoverToken += 1
				combatHoverTarget = nil
			end
			rp.Anchored = combatAnchorActive
			rp.AssemblyLinearVelocity = Vector3.zero
			rp.AssemblyAngularVelocity = Vector3.zero

			if hum then
				hum.PlatformStand = false
				hum.Sit = false
				hum.AutoRotate = true
				hum:Move(Vector3.zero, false)
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
			end
		end

		local function p1GetZone(lvl)
			return KZONES[1]
		end

		local function p1GetLevel()
			local ms = RS2:FindFirstChild("Stats" .. H.lp.Name)
			local lv = ms and ms:FindFirstChild("Stats") and ms.Stats:FindFirstChild("Level")
			return lv and lv.Value or 0
		end

		local function p1GetQuest()
			local ms = RS2:FindFirstChild("Stats" .. H.lp.Name)
			local cq = ms and ms:FindFirstChild("Quest") and ms.Quest:FindFirstChild("CurrentQuest")
			return cq and cq.Value or ""
		end

		local function p1GetNPCID(npc)
			if not npc then return nil end
			local v = npc:FindFirstChild("NPCID"); if v then return v.Value end
			local cfg = npc:FindFirstChild("Configuration")
			if cfg then v = cfg:FindFirstChild("NPCID"); if v then return v.Value end end
			return npc:GetAttribute("NPCID")
		end

		local function p1GetAllNPCs(name)
			local res = {}
			local function scan(fn)
				local f = workspace:FindFirstChild(fn); if not f then return end
				for _, v in pairs(f:GetChildren()) do
					if v:IsA("Model") and string.find(string.lower(v.Name), string.lower(name)) then
						local hum = v:FindFirstChild("Humanoid"); local hrp = v:FindFirstChild("HumanoidRootPart")
						if hum and hum.Health > 0 and hrp then table.insert(res, {npc=v, hrp=hrp}) end
					end
				end
			end
			scan("NPCs"); scan("Enemies")
			return res
		end

		local function p1GetClosest(name)
			local best, bestD = nil, math.huge
			local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
			if not rp then return nil end
			local function scan(fn)
				local f = workspace:FindFirstChild(fn); if not f then return end
				for _, v in pairs(f:GetChildren()) do
					if v:IsA("Model") and string.find(string.lower(v.Name), string.lower(name)) then
						local hum = v:FindFirstChild("Humanoid"); local hrp = v:FindFirstChild("HumanoidRootPart")
						if hum and hum.Health > 0 and hrp then
							local d = (rp.Position - hrp.Position).Magnitude
							if d < bestD then bestD = d; best = v end
						end
					end
				end
			end
			scan("NPCs"); scan("Enemies")
			return best
		end

		local travelCleanActive = false
		local travelCleanToken = 0

		local function p1ClearMovementLocks()
			local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
			if not rp then return end
			if not combatAnchorActive then rp.Anchored = false end
			for _, name in ipairs({"AF_BV", "S2_BV", "AH_BV"}) do
				local obj = rp:FindFirstChild(name)
				if obj then obj:Destroy() end
			end
		end

		local function p1CleanCharacterLocks()
			local char = H.lp.Character
			if not char then return end

			for _, v in ipairs(char:GetDescendants()) do
				if v:IsA("BodyVelocity")
					or v:IsA("BodyGyro")
					or v:IsA("BodyPosition")
					or v:IsA("BodyForce")
					or v:IsA("AlignPosition")
					or v:IsA("AlignOrientation")
					or v:IsA("VectorForce")
					or v:IsA("LinearVelocity")
					or v:IsA("AngularVelocity") then
					v:Destroy()
				elseif v.Name == "AF_BV"
					or v.Name == "KT_BV"
					or v.Name == "S2_BV"
					or v.Name == "AH_BV"
					or v.Name == "InvisibleFloor"
					or v.Name == "KaitunFloor" then
					v:Destroy()
				end
			end

			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.PlatformStand = false
				hum.Sit = false
				hum.AutoRotate = true
				hum:Move(Vector3.zero, false)
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
			end
		end

		local function p1StartTravelCleaner()
			if travelCleanActive then return end
			travelCleanActive = true
			travelCleanToken += 1
			local myToken = travelCleanToken
			task.spawn(function()
				while getgenv().KaitunFarm and travelCleanActive and travelCleanToken == myToken do
					p1CleanCharacterLocks()
					task.wait(0.12)
				end
			end)
		end

		local function p1StopTravelCleaner()
			if not travelCleanActive then return end
			travelCleanActive = false
			travelCleanToken += 1
			p1CleanCharacterLocks()
			p1ClearMovementLocks()
		end

		local p1FloatConn = nil
		local p1FloatTarget = nil

		local function p1Float(bool)
			local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
			if not rp then return end

			if bool then
				local bv = rp:FindFirstChild("KT_BV") or Instance.new("BodyVelocity", rp)
				bv.Name = "KT_BV"
				bv.MaxForce = Vector3.new(0, 1e5, 0)
				bv.Velocity = Vector3.zero
			else
				if p1FloatConn then p1FloatConn:Disconnect(); p1FloatConn = nil end
				local rp2 = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
				if rp2 then
					local bv = rp2:FindFirstChild("KT_BV")
					if bv then bv:Destroy() end
					local bp = rp2:FindFirstChild("KT_BP")
					if bp then bp:Destroy() end
				end
				p1FloatTarget = nil
			end
		end

		local function p1EquipMelee()
			local bp = H.lp:FindFirstChild("Backpack"); if not bp then return end
			local m  = bp:FindFirstChild("Melee"); if not m then return end
			local char = H.lp.Character
			if not char then return end
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				pcall(function() hum:EquipTool(m) end)
			else
				m.Parent = char
			end
			task.wait(0.2)
			-- Vérifie que c'est bien équipé, sinon retry
			if m.Parent ~= char then
				m.Parent = char
			end
		end

		local function p1ApplyStaticHover(lockCF)
			local char = H.lp.Character
			local rp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not rp or not lockCF then return false end

			combatAnchorActive = true
			rp.Anchored = true
			rp.AssemblyLinearVelocity = Vector3.zero
			rp.AssemblyAngularVelocity = Vector3.zero
			rp.CFrame = lockCF

			if hum then
				hum.PlatformStand = false
				hum.Sit = false
				hum.AutoRotate = true
				hum:Move(Vector3.zero, false)
			end

			return true
		end

		local function p1StartStaticHover(lockCF)
			if not lockCF then return end
			combatHoverToken += 1
			local myToken = combatHoverToken
			combatAnchorActive = true

			task.spawn(function()
				while getgenv().KaitunFarm and combatAnchorActive and combatHoverToken == myToken do
					if not p1ApplyStaticHover(lockCF) then break end
					H.RunService.Heartbeat:Wait()
				end
			end)
		end

		local function p1AttackAll(targetName, lockCF)
			if not canAttack then return end
			canAttack = false
			local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
			local npcs = p1GetAllNPCs(targetName)
			if #npcs == 0 then canAttack = true; return end

			for combo = 1, 5 do
				if not getgenv().KaitunFarm then break end
				rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
				if rp and lockCF then
					rp.AssemblyLinearVelocity = Vector3.zero
					rp.CFrame = lockCF
				end

				local hrpList, npcIDs = {}, {}
				for _, d in ipairs(npcs) do
					if d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health > 0 and d.hrp then
						table.insert(hrpList, d.hrp)
						local id = p1GetNPCID(d.npc)
						if id then table.insert(npcIDs, id) end
					end
				end
				if #hrpList == 0 then break end

				pcall(function()
					combatReg:InvokeServer({[1]="swingsfx",[2]="Melee",[3]=combo,[4]="Ground",[5]=false,[6]=ANIMS[combo],[7]=2,[8]=1.5})
					local da = {[1]={[1]="damage",[2]=hrpList,[3]="Melee",[4]={combo,"Ground","Melee"},[5]=true,[6]=rp and rp.CFrame or CFrame.new(),aircombo="Ground"}}
					if #npcIDs > 0 then da[1].NPCIDs = npcIDs end
					combatReg:InvokeServer(unpack(da))
				end)
				task.wait(COMBO_DELAY)
			end
			task.wait(FULL_COMBO_WAIT)
			canAttack = true
		end

		local function p1GetNearbyNPCs(targetName, centerPos, radius)
			local nearby = {}
			if not centerPos then return nearby end

			-- Fix hit de trop loin : l'ancien multi-hit prenait tous les Fishman dans un rayon trop large.
			-- A Fishman is only added to the packet if close to both the target and the player.
			radius = radius or 18
			local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
			local maxPlayerDistance = 24
			local maxVerticalDelta  = 14

			for _, d in ipairs(p1GetAllNPCs(targetName)) do
				local hum = d.npc:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 and d.hrp then
					local distFromTarget = (d.hrp.Position - centerPos).Magnitude
					local distFromPlayer = rp and (d.hrp.Position - rp.Position).Magnitude or math.huge
					local verticalDelta = math.abs(d.hrp.Position.Y - centerPos.Y)

					if distFromTarget <= radius and distFromPlayer <= maxPlayerDistance and verticalDelta <= maxVerticalDelta then
						table.insert(nearby, d)
					end
				end
			end

			return nearby
		end

		local function p1ApplyCombatHover(targetHRP, height)
			if not targetHRP or not targetHRP.Parent then return false end
			local char = H.lp.Character
			local rp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not rp then return false end

			local lockedY = targetHRP.Position.Y + (height or p1GetHoverHeight())
			rp.Anchored = true
			rp.AssemblyLinearVelocity = Vector3.zero
			rp.AssemblyAngularVelocity = Vector3.zero
			H.DoSafeTeleport(Vector3.new(targetHRP.Position.X, lockedY, targetHRP.Position.Z))

			if hum then
				hum.PlatformStand = false
				hum.Sit = false
				hum.AutoRotate = true
				hum:Move(Vector3.zero, false)
			end

			return true
		end

		local function p1StartCombatHover(targetHRP, height)
			combatHoverTarget = targetHRP
			combatHoverHeight = height or p1GetHoverHeight()
			combatHoverToken += 1
			local myToken = combatHoverToken
			combatAnchorActive = true

			task.spawn(function()
				while getgenv().KaitunFarm and combatAnchorActive and combatHoverToken == myToken do
					if not combatHoverTarget or not combatHoverTarget.Parent then break end
					if not p1ApplyCombatHover(combatHoverTarget, combatHoverHeight) then break end
					H.RunService.Heartbeat:Wait()
				end
			end)
		end

		local function p1HoldAbove(targetHRP, lockedY, duration)
			local untilTime = tick() + (duration or 0.15)
			combatAnchorActive = true
			while getgenv().KaitunFarm and targetHRP and targetHRP.Parent and tick() < untilTime do
				p1ApplyCombatHover(targetHRP, p1GetHoverHeight())
				H.RunService.Heartbeat:Wait()
			end
		end

		local function p1AttackSingle(targetName, npc, lockedY)
			if not npc then return end
			local hum = npc:FindFirstChild("Humanoid")
			if not hum or hum.Health <= 0 then return end
			if not canAttack then return end
			canAttack = false

			local id = p1GetNPCID(npc)
			local height = p1GetHoverHeight()

			for combo = 1, 5 do
				if not getgenv().KaitunFarm or hum.Health <= 0 then break end

				-- Re-fetch live position of NPC every hit
				local liveHRP = npc:FindFirstChild("HumanoidRootPart")
				if not liveHRP or not liveHRP.Parent then break end

				local char = H.lp.Character
				local rp = char and char:FindFirstChild("HumanoidRootPart")
				if not rp then break end

				-- Move player on top of NPC at current live position
				local npcPos  = liveHRP.Position
				local standPos = Vector3.new(npcPos.X, npcPos.Y + height, npcPos.Z)
				rp.AssemblyLinearVelocity  = Vector3.zero
				rp.AssemblyAngularVelocity = Vector3.zero
				rp.CFrame = CFrame.new(standPos)
				combatHoverTarget = liveHRP

				pcall(function()
					local currentAnim = ANIMS[combo] or ANIMS[1]
					combatReg:InvokeServer({[1]="swingsfx",[2]="Melee",[3]=combo,[4]="Ground",[5]=false,[6]=currentAnim,[7]=2,[8]=1.5})

					-- Re-fetch NPC position after InvokeServer (NPC may have moved)
					liveHRP = npc:FindFirstChild("HumanoidRootPart")
					if not liveHRP or not liveHRP.Parent then return end

					npcPos  = liveHRP.Position
					standPos = Vector3.new(npcPos.X, npcPos.Y + height, npcPos.Z)

					rp = char and char:FindFirstChild("HumanoidRootPart")
					if rp then
						rp.CFrame = CFrame.new(standPos)
						rp.AssemblyLinearVelocity  = Vector3.zero
						rp.AssemblyAngularVelocity = Vector3.zero
					end

					-- Packet damage : CFrame = position du NPC (pas du joueur)
					-- Le serveur valide le hit depuis la position du NPC
					local npcCFrame = liveHRP.CFrame
					local hrpList = {liveHRP}
					local npcIDs  = {}
					if id then table.insert(npcIDs, id) end

					-- Ajouter les NPCs proches dans le packet aussi
					local nearby = p1GetNearbyNPCs(targetName, npcPos, 18)
					for _, d in ipairs(nearby) do
						if d.hrp ~= liveHRP then
							table.insert(hrpList, d.hrp)
							local nid = p1GetNPCID(d.npc)
							if nid then table.insert(npcIDs, nid) end
						end
					end

					local da = {[1]={[1]="damage",[2]=hrpList,[3]="Melee",[4]={combo,"Ground","Melee"},[5]=true,[6]=npcCFrame,aircombo="Ground"}}
					if #npcIDs > 0 then da[1].NPCIDs = npcIDs end
					combatReg:InvokeServer(unpack(da))
				end)

				task.wait(COMBO_DELAY)
			end

			-- Cooldown: stay on the NPC if still alive
			local waitEnd = tick() + FULL_COMBO_WAIT
			while getgenv().KaitunFarm and tick() < waitEnd do
				local liveHRP = npc:FindFirstChild("HumanoidRootPart")
				if liveHRP and liveHRP.Parent and hum.Health > 0 then
					combatHoverTarget = liveHRP
					p1ApplyCombatHover(liveHRP, height)
				end
				H.RunService.Heartbeat:Wait()
			end

			canAttack = true
		end
		local function p1HitSingle(npc)
			if not npc then return end
			local hrp = npc:FindFirstChild("HumanoidRootPart")
			local rp  = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
			if not hrp or not rp then return end

			-- Snapper exactement sur le NPC avant d'envoyer le packet
			local snapPos = Vector3.new(hrp.Position.X, hrp.Position.Y + p1GetHoverHeight(), hrp.Position.Z)
			rp.CFrame = CFrame.new(snapPos)
			rp.AssemblyLinearVelocity = Vector3.zero

			pcall(function()
				combatReg:InvokeServer({[1]="swingsfx",[2]="Melee",[3]=1,[4]="Ground",[5]=false,[6]=ANIMS[1],[7]=2,[8]=1.5})
				-- Re-fetch after InvokeServer
				hrp = npc:FindFirstChild("HumanoidRootPart")
				rp  = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
				if not hrp or not rp then return end
				snapPos = Vector3.new(hrp.Position.X, hrp.Position.Y + p1GetHoverHeight(), hrp.Position.Z)
				rp.CFrame = CFrame.new(snapPos)
				local da = {[1]={[1]="damage",[2]={hrp},[3]="Melee",[4]={1,"Ground","Melee"},[5]=true,[6]=rp.CFrame,aircombo="Ground"}}
				local id = p1GetNPCID(npc)
				if id then da[1].NPCIDs = {id} end
				combatReg:InvokeServer(unpack(da))
			end)
		end

		local function p1TakeQuest(zone)
			p1ReleaseMovementInputs()
			H.DoSafeTeleport(zone.QuestPos.Position)
			task.wait(0.15)
			p1ReleaseMovementInputs()
			task.wait(0.85)
			if zone.QuestName ~= "" then
				p1ReleaseMovementInputs()
				pcall(function() questEvt:InvokeServer({[1]="takequest",[2]=zone.QuestName}) end)
				task.wait(0.15)
				p1ReleaseMovementInputs()
				task.wait(0.85)
			end
		end

		p1ClearMovementLocks()
		p1EquipMelee()
		p1Float(true)
		H.teleportSpeed = (getgenv().Config and getgenv().Config.MAIN and getgenv().Config.MAIN.TWEEN_SPEED) or 70
		H.autoAdsEnabled = true

		-- Auto Stats: cap Strength at 700
		local statsEvent2 = RS:WaitForChild("Events"):WaitForChild("stats")
		task.spawn(function()
			while getgenv().KaitunFarm do
				local mystats     = RS:FindFirstChild("Stats" .. H.lp.Name)
				local statsFolder = mystats and mystats:FindFirstChild("Stats")
				local statPoints  = statsFolder and statsFolder:FindFirstChild("SkillPoints")

				if statPoints and statPoints.Value > 0 then
					local pts             = statPoints.Value
					local strengthStat    = statsFolder and statsFolder:FindFirstChild("Strength")
					local currentStrength = strengthStat and strengthStat.Value or 0

					for i = 1, pts do
						if not getgenv().KaitunFarm then break end
						local _strCap = (getgenv().Config and getgenv().Config.MAIN and getgenv().Config.MAIN.STAT_CAP and getgenv().Config.MAIN.STAT_CAP.STRENGTH) or 700
						if currentStrength < _strCap then
							pcall(function() statsEvent2:FireServer("Strength", nil, 1) end)
							currentStrength = currentStrength + 1
						end
						pcall(function() statsEvent2:FireServer("Defense", nil, 1) end)
						task.wait(0.1)
					end
				end
				task.wait(1)
			end
		end)

		local currentZone   = p1GetZone(p1GetLevel())
		local lastZoneName  = nil
		local lastAggroTime = 0
		local questJustTaken = false
		local questTakenTime = 0
		local questWasActive = false
		local arrivedAtCave  = false  -- true une fois qu'on est dans la cave

		while getgenv().KaitunFarm do
			local lvl = p1GetLevel()
			local qn  = p1GetQuest()

			-- Reset flag once server confirms quest
			if questJustTaken then
				if qn == currentZone.QuestName or tick() - questTakenTime > 5 then
					questJustTaken = false
				end
			end

			-- Track quest active state
			if qn == currentZone.QuestName then
				questWasActive = true
			end

			-- Quest just completed (was active, now empty) → stop farm, move to next phases
			if questWasActive and qn == "" and not questJustTaken then
				H.notify("KaitunFarm", "Quest complete", 5)
				getgenv().KaitunFarm = false
				break
			end

			-- Stop at 425 only if quest is not currently active (don't interrupt mid-quest)
			local _lvlCap = (getgenv().Config and getgenv().Config.MAIN and getgenv().Config.MAIN.LEVEL) or 425
			if lvl >= 425 and lvl >= _lvlCap and qn ~= currentZone.QuestName then
				H.notify("KaitunFarm", "Lvl 425 reached", 6)
				getgenv().KaitunFarm = false
				break
			end

			-- Update zone
			if currentZone and lvl > currentZone.MaxLevel then
				if currentZone.QuestName == "" or qn ~= currentZone.QuestName then
					currentZone = p1GetZone(lvl); lastAggroTime = 0
				end
			else
				currentZone = currentZone or p1GetZone(lvl)
			end

			if not currentZone then task.wait(0.5); continue end

			if lastZoneName ~= currentZone.TargetName then
				lastZoneName = currentZone.TargetName
				H.notify("KaitunFarm", "Farming: " .. currentZone.TargetName, 4)
			end

			local char = H.lp.Character
			local hum  = char and char:FindFirstChild("Humanoid")
			local rp   = char and char:FindFirstChild("HumanoidRootPart")
			if not char or not hum or hum.Health <= 0 or not rp then task.wait(0.5); continue end

			-- Travel to Fishman Cave once if not arrived yet
			local distToCenter = (rp.Position - currentZone.Center.Position).Magnitude
			if not arrivedAtCave and distToCenter > 100 then
				arrivedAtCave = false
			elseif distToCenter <= 100 then
				arrivedAtCave = true
			end
			local travelingToFishman = currentZone.WalkTo and not arrivedAtCave

			if travelingToFishman then
				p1SetCombatAnchor(false)
				p1Float(false)
				p1ClearMovementLocks()
				p1StartTravelCleaner()
			else
				p1StopTravelCleaner()
				-- S'assurer que le float est toujours actif dans la cave
				local bv = rp:FindFirstChild("KT_BV")
				if not bv then p1Float(true) end
			end

			-- WalkTo (Fishman cave entrance)
			if travelingToFishman then
				p1SetCombatAnchor(false)
				p1ReleaseMovementInputs()

				-- Chemin vers Fishman Cave sans face mouse
				local waypoints = {
					Vector3.new(8004.085, -2153.832, -17015.412),
					Vector3.new(8003.574, -2153.832, -17146.297),
					Vector3.new(7821.529, -2176.832, -17164.508),
					Vector3.new(7763.703, -2176.832, -17175.602),
				}
				for _, wp in ipairs(waypoints) do
					if not getgenv().KaitunFarm then break end
					H.DoSafeTeleport(wp)
					task.wait(0.1)
				end
				p1ReleaseMovementInputs()
				arrivedAtCave = true
				continue
			end

			-- Quest
			local reqLvl = currentZone.QuestMinLevel or currentZone.MinLevel
			if not questJustTaken and currentZone.QuestName ~= "" and qn ~= currentZone.QuestName and lvl >= reqLvl then
				p1SetCombatAnchor(false)
				p1TakeQuest(currentZone)
				questJustTaken = true
				questTakenTime = tick()
				lastAggroTime = 0
			else
				local zoneOffset = p1GetHoverHeight()

				if currentZone.Method == "1by1" then
					local npc = p1GetClosest(currentZone.TargetName)
					if not npc then
						p1SetCombatAnchor(false)
						local lockedY = currentZone.Center.Y + zoneOffset
						local cf = CFrame.new(currentZone.Center.X, lockedY, currentZone.Center.Z)
						if (rp.Position - cf.Position).Magnitude > 6 then H.DoSafeTeleport(cf.Position); task.wait(0.05); p1ReleaseMovementInputs() end
						task.wait(0.5); continue
					end

					-- Get live NPC position
					local liveHRP = npc:FindFirstChild("HumanoidRootPart")
					local hum = npc:FindFirstChild("Humanoid")
					if not liveHRP or not liveHRP.Parent or not hum or hum.Health <= 0 then
						task.wait(0.1); continue
					end

					-- Tween toward the NPC
					local targetPos = Vector3.new(liveHRP.Position.X, liveHRP.Position.Y + zoneOffset, liveHRP.Position.Z)
					if (rp.Position - targetPos).Magnitude > 3 then
						p1SetCombatAnchor(false)
						H.DoSafeTeleport(targetPos)
					end

					-- Start attack (tracks NPC live each hit)
					p1AttackSingle(currentZone.TargetName, npc, liveHRP.Position.Y + zoneOffset)

				elseif currentZone.Method == "Group" then
					local npcs = p1GetAllNPCs(currentZone.TargetName)
					local lockedY = currentZone.Center.Y + zoneOffset
					local centerCF = CFrame.lookAt(
						Vector3.new(currentZone.Center.X, lockedY, currentZone.Center.Z),
						currentZone.Center.Position
					)

					if #npcs == 0 then
						if (rp.Position - centerCF.Position).Magnitude > 6 then
							H.DoSafeTeleport(centerCF.Position)
						end
						task.wait(0.5); continue
					end

					if tick() - lastAggroTime >= 15 then
						for _, d in ipairs(npcs) do
							if not getgenv().KaitunFarm then break end
							if d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health > 0 and d.hrp then
								local aggroCF = p1CFrameKeepBaseRotation(rp, Vector3.new(d.hrp.Position.X, d.hrp.Position.Y + zoneOffset, d.hrp.Position.Z))
								if (rp.Position - aggroCF.Position).Magnitude > 6 then
									H.DoSafeTeleport(aggroCF.Position)
								end
								rp.AssemblyLinearVelocity = Vector3.zero
								rp.CFrame = aggroCF
								task.wait(0.2)
								p1HitSingle(d.npc)
								task.wait(0.2)
							end
						end
						H.DoSafeTeleport(centerCF.Position)
						lastAggroTime = tick()
						task.wait(0.5)
					else
						if (rp.Position - centerCF.Position).Magnitude > 6 then
							H.DoSafeTeleport(centerCF.Position)
						end
						p1AttackAll(currentZone.TargetName, centerCF)
					end
				end
			end
			task.wait(0.05)
		end

		p1SetCombatAnchor(false)
		p1Float(false)
		H.teleportSpeed = 89
		H.autoAdsEnabled = false
		H.DisableForwardKey = false
	end


	local function hasSkyWalk()
		local ms = RS:FindFirstChild("Stats" .. H.lp.Name)
		local sk = ms and ms:FindFirstChild("Skills") and ms.Skills:FindFirstChild("skyWalk")
		return sk and sk.Value == true
	end

	local function hasHaki()
		local ms = RS:FindFirstChild("Stats" .. H.lp.Name)
		local bm = ms and ms:FindFirstChild("Stats") and ms.Stats:FindFirstChild("BusoMastery")
		return bm and bm.Value > 0
	end

	local function phase2_geppo()
		if not getgenv().KaitunFarm then return end

		-- Skip if Geppo already purchased
		if hasSkyWalk() then
			H.notify("KaitunFarm", "Geppo already owned", 4)
			-- Escape even if already in Fishman
			if isOnFishmanIsland() then
				fishmanEscape()
				task.wait(1)
			end
			return
		end

		H.notify("KaitunFarm", "Leaving Fishman...", 5)

		-- Utiliser le chemin d'escape si on est encore dans Fishman Island
		if isOnFishmanIsland() then
			fishmanEscape()
			task.wait(1)
		end

		H.notify("KaitunFarm", "Buying Geppo", 5)
		H.DoSafeTeleport(Vector3.new(-3087.715, 94.544, -11755.474))
		task.wait(1.5)
		pcall(function()
			RS:WaitForChild("Events"):WaitForChild("learnStyle"):FireServer("skyWalkTrainer")
		end)
		task.wait(2)
		H.notify("KaitunFarm", "Geppo bought", 4)
	end

	-- ---- PHASE 3 : Auto Haki ----
	local function phase3_haki()
		if not getgenv().KaitunFarm then return end

		-- Escape Fishman Cave si encore dedans
		if isOnFishmanIsland() then
			H.notify("KaitunFarm", "Leaving Fishman...", 4)
			fishmanEscape()
			task.wait(1)
		end

		if hasHaki() then
			H.notify("KaitunFarm", "Haki already owned", 4)
			return
		end

		H.notify("KaitunFarm", "Training Haki", 5)

		if not H.startAutoHaki then
			H.notify("KaitunFarm", "Auto Haki unavailable", 4)
			return
		end

		H.autoHakiEnabled = false
		task.wait(0.5)
		if H.setHakiWhiteScreen then H.setHakiWhiteScreen(true) end
		H.startAutoHaki()

		while getgenv().KaitunFarm do
			if not H.autoHakiEnabled then break end
			task.wait(2)
		end

		if H.setHakiWhiteScreen then H.setHakiWhiteScreen(false) end
		task.wait(1)
		H.notify("KaitunFarm", "Haki done", 4)
	end

	-- ---- PHASE 4 : Auto World Scroll ----
	local function hasWorldScroll()
		local ok, result = pcall(function()
			local pg  = game:GetService("Players").LocalPlayer.PlayerGui
			local inv = pg.Inventory

			-- Open inventory if not visible so items are populated
			local wasOpen = inv.Main.Visible
			if not wasOpen then
				inv.Main.Visible = true
				task.wait(0.2)
			end

			local found = false
			local list = inv.Main.Inventory.List
			for _, child in ipairs(list:GetDescendants()) do
				if child:IsA("ImageLabel") and child.Name == "World Scroll" then
					found = true
					break
				end
			end

			-- Close back if it was closed
			if not wasOpen then
				inv.Main.Visible = false
			end

			return found
		end)
		return ok and result == true
	end

	local function phase4_worldscroll()
		if not getgenv().KaitunFarm then return end

		if isOnFishmanIsland() then
			H.notify("KaitunFarm", "Leaving Fishman...", 4)
			fishmanEscape()
			task.wait(1)
		end

		if hasWorldScroll() then
			H.notify("KaitunFarm", "World Scroll already owned", 4)
			return
		end

		H.notify("KaitunFarm", "Grabbing World Scroll", 5)

		-- Destroy float BV directly (p1Float is out of scope here)
		local char = H.lp.Character
		local rp   = char and char:FindFirstChild("HumanoidRootPart")
		if rp then
			local bv = rp:FindFirstChild("KT_BV")
			if bv then bv:Destroy() end
			local bp = rp:FindFirstChild("KT_BP")
			if bp then bp:Destroy() end
			rp.Anchored = false
		end
		task.wait(0.3)

		-- Same code as the existing "World Scroll" button
		H.DoSafeTeleport(Vector3.new(-7348.136, 3.274, -14951.547))
		task.wait(0.5)
		local vim = Instance.new("VirtualInputManager")
		vim:SendKeyEvent(true, Enum.KeyCode.LeftAlt, false, nil)
		task.wait(2)
		vim:SendKeyEvent(false, Enum.KeyCode.LeftAlt, false, nil)
		vim:Destroy()
		task.wait(1)

		H.notify("KaitunFarm", "World Scroll picked up", 5)
	end

	-- ---- PHASE 5 : TP Main Menu → rejoin Sea 2 ----
	local function phase5_mainmenu()
		if not getgenv().KaitunFarm then return end

		local kCode = getgenv().KaitunSea2Code
			or (Options and Options.KaitunPSCodeLogin and Options.KaitunPSCodeLogin.Value)

			or ""
		if kCode ~= "" then
			getgenv().KaitunSea2Pending = true
			getgenv().KaitunSea2Code    = kCode
		end

		H.notify("KaitunFarm", "All done — main menu", 5)
		task.wait(1)
		pcall(function()
			game:GetService("TeleportService"):Teleport(1730877806, H.lp)
		end)
	end

	H.startKaitunFarm = function()
		if KT.isRunning then return end
		KT.isRunning = true
		getgenv().KaitunFarm = true
		KT.LoopID = KT.LoopID + 1

		-- Activer auto ads / auto stats + garder le Noclip du Main toujours actif pendant le Kaitun.
		H.autoAdsEnabled   = true
		H.autoStatsEnabled = true
		H.noclipActive     = true
		H.DisableForwardKey = true

		local function ForceMainNoclipOn()
			H.noclipActive = true
			if Toggles and Toggles.NoclipToggle and Toggles.NoclipToggle.Value ~= true then
				Toggles.NoclipToggle:SetValue(true)
			end
		end

		ForceMainNoclipOn()
		task.spawn(function()
			local loopId = KT.LoopID
			while getgenv().KaitunFarm and KT.isRunning and KT.LoopID == loopId do
				ForceMainNoclipOn()
				task.wait(0.35)
			end
		end)

		task.spawn(function()
			if IS_SEA2_PLACE then
				-- En Sea 2 : farm Wolf jusqu'au lvl 675
				H.notify("KaitunFarm", "Sea 2 detected — farming", 5)
				H.autoAdsEnabled   = true
				H.autoStatsEnabled = true

				if not H.startSea2Farm then
					H.notify("KaitunFarm", "Sea 2 Farm unavailable", 4)
					getgenv().KaitunFarm = false
				else
					local s2 = getgenv()._S2
					if s2 then s2.stopLevel = 675 end
					H.startSea2Farm()

					-- Block here until farm is done (lvl 675)
					while getgenv().Sea2Farm do
						local ms = game:GetService("ReplicatedStorage"):FindFirstChild("Stats" .. H.lp.Name)
						local lv = ms and ms:FindFirstChild("Stats") and ms.Stats:FindFirstChild("Level")
						if lv and lv.Value >= 675 then
							H.notify("KaitunFarm", "Lvl 675 reached", 6)
							if H.stopSea2Farm then H.stopSea2Farm() end
							H.autoAdsEnabled   = false
							H.autoStatsEnabled = false
							getgenv().KaitunFarm = false
							break
						end
						task.wait(5)
					end
				end
			else
				KT.status = "farming"
				getgenv().KaitunFarm = true

				-- Check: if already lvl 425+, verify geppo/haki/worldscroll
				-- Si tout est acquis → tp direct au main menu dans 3s
				local lvl = (function()
					local ms = game:GetService("ReplicatedStorage"):FindFirstChild("Stats" .. H.lp.Name)
					local lv = ms and ms:FindFirstChild("Stats") and ms.Stats:FindFirstChild("Level")
					return lv and lv.Value or 0
				end)()

				if lvl >= 425 then
					local geppoOk  = hasSkyWalk()
					local hakiOk   = hasHaki()
					local scrollOk = hasWorldScroll()

					if geppoOk and hakiOk and scrollOk then
						H.notify("KaitunFarm", "All requirements met — main menu in 3s", 6)
						-- Désactiver AUTO_JOIN_SEA2 dans la config maintenant qu'on est prêt
						if getgenv().Config and getgenv().Config.MAIN then
							getgenv().Config.MAIN.AUTO_JOIN_SEA2 = true  -- on veut rejoindre Sea 2
							getgenv().Config.MAIN.AUTO_KAITUN    = false -- plus besoin de relancer
						end
						task.wait(3)
						phase5_mainmenu()
						getgenv().KaitunFarm = false
					else
						-- Manque quelque chose → lancer les phases manquantes directement
						if not geppoOk then phase2_geppo() end
						if not hakiOk  then
							getgenv().KaitunFarm = true
							phase3_haki()
						end
						if not scrollOk then
							getgenv().KaitunFarm = true
							phase4_worldscroll()
						end
						getgenv().KaitunFarm = true
						phase5_mainmenu()
						getgenv().KaitunFarm = false
					end
				else
					-- Phase 1: farm Fishman Cave to lvl 425
					phase1_farm()

					-- Stop if user disabled
					if not KT.isRunning then
						getgenv().KaitunFarm = false
					else
						-- Phase 2: escape Fishman Island + auto Geppo
						getgenv().KaitunFarm = true
						phase2_geppo()

						-- Phase 3: auto Haki
						if KT.isRunning then
							getgenv().KaitunFarm = true
							phase3_haki()
						end

						-- Phase 4: World Scroll
						if KT.isRunning then
							getgenv().KaitunFarm = true
							phase4_worldscroll()
						end

						-- Phase 5: TP main menu
						if KT.isRunning then
							getgenv().KaitunFarm = true
							phase5_mainmenu()
						end

						getgenv().KaitunFarm = false
					end
				end
			end

			H.DisableForwardKey = false
			KT.status    = "done"
			KT.isRunning = false
			getgenv().KaitunFarm = false

			if Toggles and Toggles.AutoFarmKaitunToggle then
				Toggles.AutoFarmKaitunToggle:SetValue(false)
			end
		end)
	end

	H.stopKaitunFarm = function()
		getgenv().KaitunFarm = false
		KT.isRunning = false
		KT.status    = "idle"
		H.autoAdsEnabled   = false
		H.autoStatsEnabled = false
		-- Do not cut Main Noclip when Kaitun stops.
		H.noclipActive     = true
		if Toggles and Toggles.NoclipToggle and Toggles.NoclipToggle.Value ~= true then
			Toggles.NoclipToggle:SetValue(true)
		end
		H.DisableForwardKey = false

		if H.activeTpConn then H.activeTpConn:Disconnect(); H.activeTpConn = nil end
		if H.invisibleFloor then H.invisibleFloor:Destroy(); H.invisibleFloor = nil end
		local rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
		if rp then
			for _, name in ipairs({"AF_BV", "KT_BV", "S2_BV", "AH_BV"}) do
				local obj = rp:FindFirstChild(name)
				if obj then obj:Destroy() end
			end
			rp.AssemblyLinearVelocity = Vector3.zero
		end

		if H.autoHakiEnabled and H.stopAutoHaki then H.stopAutoHaki() end
		if H.setHakiWhiteScreen then H.setHakiWhiteScreen(false) end
	end

	getgenv()._KT = KT
end



-- DANGEROUS FEATURES
if not IS_LOGIN_PLACE then
	initMovement()
	initDash()
	initAutoFarm()
	initStandaloneFeatures()
	initAutoFish()
	initAutoMerchant()
	initAutoHaki()
	initAutoFarmSea2()
	initAutoFarmKaitun()
end

-- ============================================================
-- BUILD UI
-- ============================================================
local function buildMainTab()
	local H=_G_Hub

	local PSBox = Tabs.Main:AddLeftGroupbox('Auto Join PS')
	PSBox:AddDropdown('SeaChoice',{
		Values={'First Sea','Second Sea'},
		Default=1,
		Multi=false,
		Text='Sea',
		Tooltip='Sea to join after clicking Regular on the menu',
	})
	PSBox:AddToggle('AutoJoinOnLoad',{
		Text='Auto Join PS',
		Default=false,
		Tooltip='Automatically join your private server using your configured slot',
		Callback=function(value)
			if value then
				codeSent=false
				CheckAndJoinPS()
			else
				autoJoinRunning=false
				codeSent=false
				Library:Notify('Auto Join stopped.', 3, Color3.fromRGB(255, 100, 0))
			end
		end
	})
	PSBox:AddDivider()
	PSBox:AddToggle('ShowSlots',{
		Text='Configure Slots',
		Default=false,
		Tooltip='Expand to set up usernames and PS codes',
	})

	local SlotsDepBox=PSBox:AddDependencyBox()
	SlotsDepBox:SetupDependencies({{Toggles.ShowSlots,true}})

	for i=1,40 do
		SlotsDepBox:AddInput('AltUser'..i,{
			Default='',Numeric=false,Finished=true,
			Text='Slot '..i..' - Username',
			Placeholder='Username'
		})
		SlotsDepBox:AddInput('AltCode'..i,{
			Default='',Numeric=false,Finished=true,
			Text='Slot '..i..' - PS Code',
			Placeholder='Code'
		})
	end

	-- ---- AUTO BATTLE PASS ----
	local BRBox = Tabs.Main:AddRightGroupbox('Auto Battle Pass')
	BRBox:AddToggle('AutoBattleRoyaleToggle',{
		Text='Auto Battle Royale',
		Default=false,
		Tooltip='Join the Battle Royale queue when enabled',
		Callback=function(v)
			local H = _G_Hub
			if not H then return end
			H.autoBattleRoyaleEnabled = v
			if v then
				if H.joinBattleRoyale then H.joinBattleRoyale()
				else Library:Notify('Auto Battle Royale: function unavailable.', 4) end
			end
		end
	})
	BRBox:AddToggle('AutoLDBToggle',{
		Text='Auto Leaderboard',
		Default=false,
		Tooltip='Automatically clicks round report continue and play again',
		Callback=function(v)
			local H = _G_Hub
			if not H then return end
			if H.setAutoLDB then H.setAutoLDB(v)
			else Library:Notify('Auto Leaderboard: function unavailable.', 4) end
		end
	})


	-- ---- BATTLE PASS DISPLAY ----
	local BRDisplayBox = Tabs.Main:AddRightGroupbox('Display')
	BRDisplayBox:AddToggle('Graphics3DToggle',{
		Text='3DS Render',
		Default=false,
		Tooltip='Reduces graphics quality for better Battle Royale performance',
		Callback=function(v)
			local H = _G_Hub
			if not H then return end
			H.graphics3DEnabled = v
			if v then
				if H.makeBattleRoyaleGraphicsUgly then H.makeBattleRoyaleGraphicsUgly()
				else Library:Notify('3DS Render: function unavailable.', 4) end
			end
		end
	})
	BRDisplayBox:AddToggle('WhiteScreenToggle',{
		Text='White Screen',
		Default=false,
		Tooltip='Shows a white screen with elapsed time while keeping the hub UI visible',
		Callback=function(v)
			local H = _G_Hub
			if not H then return end
			if H.setWhiteScreen then H.setWhiteScreen(v)
			else Library:Notify('White Screen: function unavailable.', 4) end
		end
	})

	-- ---- LOG POSE ----
	local LogPoseBox = Tabs.Main:AddRightGroupbox('Log Pose')
	LogPoseBox:AddToggle('AutoLogPoseToggle',{
		Text='Auto Log Pose',
		Default=false,
		Tooltip='Teleports to each island and records the Log Pose automatically',
		Callback=function(v)
			local H = _G_Hub
			if not H then return end
			if v then
				if H.autoLogBusy then
					Library:Notify('Log Pose already running.', 3)
					Toggles.AutoLogPoseToggle:SetValue(false)
					return
				end
				task.spawn(function()
					H.runAutoLog()
					task.wait(0.5)
					Toggles.AutoLogPoseToggle:SetValue(false)
				end)
			end
		end
	})

	-- Auto Join Universe Hub & Cupid Dungeon (also visible on login place)
	PSBox:AddDivider()
	PSBox:AddToggle('AutoJoinUniverseHubToggle', {
		Text    = 'Auto Join Universe Hub',
		Default = false,
		Tooltip = 'Automatically joins the Universe Hub (Arena) server',
		Callback = function(v)
			if v then
				getgenv()._autoJoinUniverseHubThread = task.spawn(function()
					task.wait(2 + math.random() * 2)
					while Toggles.AutoJoinUniverseHubToggle and Toggles.AutoJoinUniverseHubToggle.Value do
						pcall(function()
							local args = { "Arena" }
							game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("playgame"):FireServer(unpack(args))
						end)
						task.wait(1.5 + math.random() * 2)
					end
				end)
				Library:Notify('Auto Join Universe Hub enabled.', 3)
			else
				if getgenv()._autoJoinUniverseHubThread then
					task.cancel(getgenv()._autoJoinUniverseHubThread)
					getgenv()._autoJoinUniverseHubThread = nil
				end
				Library:Notify('Auto Join Universe Hub disabled.', 3)
			end
		end,
	})
	PSBox:AddToggle('AutoJoinCupidDungeonToggle', {
		Text    = "Auto Join Cupid's Dungeon",
		Default = false,
		Tooltip = "Automatically joins Cupid's Dungeon queue",
		Callback = function(v)
			if v then
				getgenv()._autoJoinCupidThread = task.spawn(function()
					task.wait(2 + math.random() * 2)
					while Toggles.AutoJoinCupidDungeonToggle and Toggles.AutoJoinCupidDungeonToggle.Value do
						pcall(function()
							local args = { "Cupid's Dungeon" }
							game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("Queue"):InvokeServer(unpack(args))
						end)
						task.wait(1.5 + math.random() * 2)
					end
				end)
				Library:Notify("Auto Join Cupid's Dungeon enabled.", 3)
			else
				if getgenv()._autoJoinCupidThread then
					task.cancel(getgenv()._autoJoinCupidThread)
					getgenv()._autoJoinCupidThread = nil
				end
				Library:Notify("Auto Join Cupid's Dungeon disabled.", 3)
			end
		end,
	})

	-- Kaitun Sea 2 Auto Join — visible only at main menu
	-- (in-game, the same controls are in the Farm tab)
	if IS_LOGIN_PLACE then
		local KaitunLoginBox = Tabs.Main:AddLeftGroupbox('Kaitun Sea 2 Auto Join PS')

		KaitunLoginBox:AddInput('KaitunPSCodeLogin', {
			Default     = getgenv().KaitunSea2Code or '',
			Numeric     = false,
			Finished    = true,
			Text        = 'PS Code Sea 2',
			Placeholder = 'Private server code',
			Tooltip     = 'PS code for Sea 2 — saved in autoload',
			Callback    = function(v)
				getgenv().KaitunSea2Code = v
			end,
		})

		KaitunLoginBox:AddToggle('KaitunAutoJoinSea2Toggle', {
			Text    = 'Auto Join Sea 2',
			Default = getgenv().KaitunSea2Pending == true,
			Tooltip = 'Enable + save in autoload to auto-join at the main menu',
			Callback = function(v)
				if v then
					local code = getgenv().KaitunSea2Code
						or (Options and Options.KaitunPSCodeLogin and Options.KaitunPSCodeLogin.Value)
						or ""
					getgenv().KaitunSea2Pending = true
					if code ~= "" then getgenv().KaitunSea2Code = code end
					if IS_LOGIN_PLACE and code ~= "" then
						task.spawn(function()
							task.wait(0.5)
							local finalCode = getgenv().KaitunSea2Code
								or (Options and Options.KaitunPSCodeLogin and Options.KaitunPSCodeLogin.Value)
								or ""
							if finalCode == "" then
								Library:Notify('Enter a Sea 2 PS code first.', 4)
								Toggles.KaitunAutoJoinSea2Toggle:SetValue(false)
								return
							end
							while Toggles.KaitunAutoJoinSea2Toggle and Toggles.KaitunAutoJoinSea2Toggle.Value do
								local result = joinOnPrivateServer(finalCode, "Second Sea")
								if result == "done" then break end
								task.wait(2)
							end
						end)
					end
				else
					getgenv().KaitunSea2Pending = false
				end
			end,
		})
	end

	if IS_LOGIN_PLACE then return end

	local HakiBox = Tabs.Main:AddLeftGroupbox('Auto Haki')
	HakiBox:AddToggle('AutoHakiToggle',{
		Text='Auto Haki',
		Default=false,
		Tooltip='farms yetis one by one, grabs the quest automatically. requires level 425.',
		Callback=function(v)
			if not v then
				_G_Hub.stopAutoHaki()
				if _G_Hub.setHakiWhiteScreen then _G_Hub.setHakiWhiteScreen(false) end
				return
			end

			-- check level
			local RS = game:GetService("ReplicatedStorage")
			local mystats = RS:FindFirstChild("Stats" .. _G_Hub.lp.Name)
			local lvl = mystats and mystats.Stats and mystats.Stats.Level and mystats.Stats.Level.Value or 0
			if lvl < 470 then
				Library:Notify("you need to be level 425 to use auto haki. (current: " .. lvl .. ")", 5)
				Toggles.AutoHakiToggle:SetValue(false)
				return
			end

			-- if auto farm is active, queue it
			if getgenv().LevelFarm then
				Library:Notify("auto farm is running, auto haki will start once you hit 425.", 5)
				task.spawn(function()
					while getgenv().LevelFarm do task.wait(1) end
					if Toggles.AutoHakiToggle and Toggles.AutoHakiToggle.Value then
						if _G_Hub.setHakiWhiteScreen then _G_Hub.setHakiWhiteScreen(true) end
						_G_Hub.startAutoHaki()
					end
				end)
				return
			end
			if _G_Hub.setHakiWhiteScreen then _G_Hub.setHakiWhiteScreen(true) end
			_G_Hub.startAutoHaki()
		end
	})




	local MainLeft=Tabs.Main:AddLeftGroupbox('Movement')
	MainLeft:AddToggle('WalkspeedToggle',{
		Text='WalkSpeed',
		Default=false,
		Tooltip='Override movement speed with a custom value',
		Callback=function(v) H.walkspeedEnabled=v;
			if v then H.startWalkSpeed() else H.stopWalkSpeed() end end
	})
	MainLeft:AddSlider('WalkspeedValue',{
		Text='Speed',
		Default=45,Min=16,Max=300,Rounding=0,
		Tooltip='Speed value applied when WalkSpeed is active',
		Callback=function(v) H.walkspeedValue=v end
	})
	MainLeft:AddButton({
		Text='Reset Speed',
		Func=function()
			Options.WalkspeedValue:SetValue(16)
			H.walkspeedValue=16
		end,
		Tooltip='Reset speed to default (16)'
	})
	MainLeft:AddDivider()
	MainLeft:AddToggle('NoclipToggle',{
		Text='Noclip',
		Default=false,
		Tooltip='Pass through walls and terrain',
		Callback=function(v)
			H.noclipActive=v
			if v then
				local lf=0
				H.noclipConn=H.run_svc.Stepped:Connect(function()
					local now=tick(); if now-lf>=0.5 then lf=now; H.fireTakestamDirect() end
				end)
			else
				if H.noclipConn then H.noclipConn:Disconnect(); H.noclipConn=nil end
				local folder=H.getCharFolder()
				if folder then
					for _,p in ipairs(folder:GetDescendants()) do
						if p:IsA("BasePart") and H.NOCLIP_RESTORE_PARTS[p.Name] then p.CanCollide=true end
					end
				end
			end
		end
	})
	MainLeft:AddDivider()

	local DashBox=Tabs.Main:AddLeftGroupbox('Combat')
	DashBox:AddToggle('NoStamToggle',{
		Text='No Stamina Cost',
		Default=false,
		Tooltip='Block the stamina event when dashing',
		Callback=function(v) H.blockTakestam=v end
	})
	DashBox:AddToggle('NoStunToggle',{
		Text='No Stun / No Knockback',
		Default=false,
		Tooltip='Remove knockback and stun constraints on hit',
		Callback=function(v) H.noStunEnabled=v end
	})
	DashBox:AddDivider()

	local JumpBox=Tabs.Main:AddLeftGroupbox('Jump & Camera')
	JumpBox:AddToggle('InfJumpToggle',{
		Text='Infinite Jump',
		Default=false,
		Tooltip='Re-jump while airborne',
		Callback=function(v) H.infiniteJumpEnabled=v end
	})
	JumpBox:AddSlider('FOVSlider',{
		Text='Field of View',
		Default=70,Min=0,Max=120,Rounding=0,
		Tooltip='Adjust camera FOV (0 = default)',
		Callback=function(v) workspace.CurrentCamera.FieldOfView=v==0 and 70 or v end
	})
	JumpBox:AddDivider()
	JumpBox:AddToggle('AutoRejoinToggle',{
		Text='Auto Rejoin',
		Default=false,
		Tooltip='rejoins GPO automatically when kicked or disconnected',
		Callback=function(v)
			_G_Hub.autoRejoinEnabled = v
			if v then
				local TeleportService = game:GetService("TeleportService")
				local GPO_ID = 1730877806

				-- use TeleportInitFailed to detect kicks/disconnections
				if not _G_Hub._rejoinTeleportConn then
					_G_Hub._rejoinTeleportConn = TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage)
						if not _G_Hub.autoRejoinEnabled then return end
						if player == _G_Hub.lp then
							task.wait(2)
							pcall(function() TeleportService:Teleport(GPO_ID, _G_Hub.lp) end)
						end
					end)
				end

				-- safely detect connection errors via CoreGui
				task.spawn(function()
					while _G_Hub.autoRejoinEnabled do
						task.wait(2)
						local ok, found = pcall(function()
							local robloxGui = game:GetService("CoreGui"):FindFirstChild("RobloxPromptGui")
							if not robloxGui then return false end
							local overlay = robloxGui:FindFirstChild("promptOverlay")
							if not overlay then return false end
							local err = overlay:FindFirstChild("ErrorPrompt")
							return err ~= nil and err.Visible
						end)
						if ok and found then
							task.wait(1.5)
							pcall(function() TeleportService:Teleport(GPO_ID, _G_Hub.lp) end)
						end
					end
				end)
			end
		end
	})

	local ExtraBox=Tabs.Main:AddRightGroupbox('Utilities')
	ExtraBox:AddToggle('SkyWalkToggle',{
		Text='SkyWalk',
		Default=false,
		Tooltip='Unlock SkyWalk via server stats',
		Callback=function(v)
			-- only enable, never disable (would remove geppo)
			if not v then return end
			local ok,stats=pcall(function() return game:GetService("ReplicatedStorage"):WaitForChild("Stats"..H.lp.Name) end)
			if ok and stats then pcall(function() stats.Skills.skyWalk.Value=true end) end
		end
	})

	ExtraBox:AddToggle('AutoAdsToggle',{
		Text='Auto Ads',
		Default=false,
		Tooltip='Collect ad reward every 10 seconds automatically',
		Callback=function(v) H.autoAdsEnabled=v end,
	})
	ExtraBox:AddToggle('AutoStatsToggle',{
		Text='Auto Stats',
		Default=false,
		Tooltip='Split stat points evenly between Strength and Defense',
		Callback=function(v) H.autoStatsEnabled=v end,
	})
	ExtraBox:AddDivider()
	ExtraBox:AddButton({
		Text='Anti Shadow Ban',
		Func=function()
			Library:Notify('Anti Shadow Ban status: SECURE', 3)
		end,
		Tooltip='Bypass shadow-ban detection'
	})

	local TeleportBox=Tabs.Main:AddRightGroupbox('Island Teleports')

	local IslandsList = {
		["Baratie"]           = Vector3.new(-2978.326, 52.587, -6801.332),
		["Coliseum"]          = Vector3.new(-2033.487, 6.854, -7670.064),
		["Fishman Island"]    = Vector3.new(1816.722, 4.075, -12173.344),
		["Haki Island"]       = Vector3.new(-4380.261, 7.482, -3143.222),
		["Island of Zoo"]     = Vector3.new(-3151.212, 11.734, -5236.932),
		["Loguetown"]         = Vector3.new(-6590.296, 7.225, -7670.699),
		["Marineford F1"]     = Vector3.new(425.249, 19.452, -4478.649),
		["Marineford G1"]     = Vector3.new(-5990.909, 57.246, -11492.621),
		["Orange Town"]       = Vector3.new(-2978.326, 52.587, -6801.332),
		["Reverse Mountain"]  = Vector3.new(-8027.381, 18.727, -8767.213),
		["Sandora"]           = Vector3.new(-1540.203, 3.975, -3343.566),
		["Shell Town"]        = Vector3.new(-1297.506, 4.125, -5056.664),
		["Shrine"]            = Vector3.new(-7350.260, 3.274, -14948.746),
		["Skypiea"]           = Vector3.new(3456.082, 1438.244, -9080.484),
		["Sphinx Island"]     = Vector3.new(-4000.557, 42.166, -9152.484),
		["Town of Beginnings"]= Vector3.new(-502.381, 5.950, -3414.961),
	}

	local IslandNames = {}
	for name, _ in pairs(IslandsList) do table.insert(IslandNames, name) end
	table.sort(IslandNames)

	TeleportBox:AddDropdown('SelectIsland',{
		Values=IslandNames,
		Default=1,
		Multi=false,
		Text='Select Island',
		Tooltip='Choose the destination island',
	})
	TeleportBox:AddButton({
		Text='Teleport',
		Func=function()
			local selected=Options.SelectIsland.Value
			if selected and IslandsList[selected] then
				Library:Notify('Heading to ' .. selected .. '...', 3)
				task.spawn(function()
					H.DoSafeTeleport(IslandsList[selected])
					Library:Notify('Teleport complete.', 3)
				end)
			end
		end,
		Tooltip='Safe teleport to the selected island'
	})
	TeleportBox:AddDivider()
	TeleportBox:AddButton({
		Text='World Scroll',
		Func=function()
			task.spawn(function()
				H.DoSafeTeleport(Vector3.new(-7348.136, 3.274, -14951.547))
				task.wait(0.5)
				-- pick up the World Scroll by holding Alt
				local vim = Instance.new("VirtualInputManager")
				vim:SendKeyEvent(true, Enum.KeyCode.LeftAlt, false, nil)
				task.wait(2)
				vim:SendKeyEvent(false, Enum.KeyCode.LeftAlt, false, nil)
				vim:Destroy()
			end)
		end,
		Tooltip='Teleport directly to the World Scroll'
	})
	TeleportBox:AddToggle('AutoBuyGeppoToggle',{
		Text='Auto Buy Geppo',
		Default=false,
		Tooltip='Teleport to the Geppo trainer and buy Geppo',
		Callback=function(v)
			H.autoBuyGeppoEnabled = v
			if v then
				task.spawn(function()
					H.DoSafeTeleport(Vector3.new(-3087.715, 94.544, -11755.474))
					task.wait(1.2)
					local args = {
						"skyWalkTrainer"
					}
					game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("learnStyle"):FireServer(unpack(args))
				end)
			end
		end
	})
	-- Global teleport speed is intentionally fixed at 89 and hidden from the UI.
end

local function buildFishTab()
	local H = _G_Hub

	local FishCore = Tabs.Fish:AddLeftGroupbox('Auto Fish')
	FishCore:AddToggle('AutoFishToggle', {
		Text    = 'Enable Auto Fish',
		Default = false,
		Tooltip = 'Loop fishing (Auto cast/reel + Shark-proof)',
		Callback = function(v)
			H.fishState.autoFishing = v
			if v then
				H.startAutoFishLoop()
			else
				H.stopAutoFishLoop()
			end
		end,
	})
	FishCore:AddDivider()
	FishCore:AddDivider()

	FishCore:AddToggle('AutoBuyBaitToggle', {
		Text = 'Auto Buy Bait',
		Default = false,
		Tooltip = 'Activates automatically in the background based on the interval',
		Callback = function(v) H.autoBuyBaitEnabled = v end,
	})
	FishCore:AddSlider('BuyBaitAmountSlider', {
		Text    = 'Amount to buy',
		Default = 1, Min = 1, Max = 50, Rounding = 0,
		Tooltip = 'Amount of bait to purchase per cycle',
		Callback = function(v) H.autoBuyBaitAmount = v end,
	})
	FishCore:AddSlider('BuyBaitIntervalSlider', {
		Text    = 'Interval (seconds)',
		Default = 60, Min = 10, Max = 600, Rounding = 0,
		Tooltip = 'Delay between auto buy teleports',
		Callback = function(v) H.autoBuyBaitInterval = v end,
	})
	FishCore:AddDivider()

	FishCore:AddToggle('AutoSellFishToggle', {
		Text = 'Auto Sell Fish (Anywhere)',
		Default = false,
		Tooltip = 'Sells fish automatically based on the Common / Rare / Legendary toggles below. Auto sell pauses at 1,000,000 Peli and resumes below it.',
		Callback = function(v) H.autoSellFishEnabled = v end,
	})
	FishCore:AddToggle('SellCommonToggle', {
		Text = 'Sell Common Fish',
		Default = true,
		Tooltip = 'Sell common fish when enabled.',
		Callback = function(v) H.sellFishRarities.Common = v end,
	})
	FishCore:AddToggle('SellRareToggle', {
		Text = 'Sell Rare Fish',
		Default = true,
		Tooltip = 'Sell rare fish when enabled.',
		Callback = function(v) H.sellFishRarities.Rare = v end,
	})
	FishCore:AddToggle('SellLegendaryToggle', {
		Text = 'Sell Legendary Fish',
		Default = true,
		Tooltip = 'Sell legendary fish when enabled.',
		Callback = function(v) H.sellFishRarities.Legendary = v end,
	})
	FishCore:AddDivider()

	FishCore:AddToggle('AutoBuyRodToggle', {
		Text    = 'Auto Buy Rod',
		Default = false,
		Tooltip = 'Teleports and buys a fishing rod if you lack one during fishing',
		Callback = function(v) H.autoBuyRod = v end,
	})
	FishCore:AddDivider()

	-- AUTO MERCHANT UI
	FishCore:AddToggle('AutoMerchantToggle', {
		Text = 'Auto Merchant',
		Default = false,
		Tooltip = 'Finds the merchant, moves to him, and buys your selected items automatically.',
		Callback = function(v) H.autoMerchantEnabled = v end,
	})

	FishCore:AddInput('MerchantWebhookURL', {
		Text = 'Merchant Webhook URL',
		Default = getgenv().__WebhookLink__ or '',
		Placeholder = 'https://discord.com/api/webhooks/...',
		Finished = true,
		Tooltip = 'Automatically sends the merchant shop items to this webhook when the shop opens.',
		Callback = function(v)
			H.merchantWebhookUrl = tostring(v or '')
			H.merchantWebhookEnabled = H.merchantWebhookUrl ~= ''
			getgenv().__WebhookLink__ = H.merchantWebhookUrl
		end,
	})




	local merchantItemList = {
		"SP Reset Essence",
		"Dark Root",
		"Legendary Fruit Chest",
		"Rare Fruit Chest",
		"Merchants Banana Rod",
		"Race Reroll",
		"Mythical Fruit Chest",
		"Bisento",
		"Spare Fruit Bag",
	}

	FishCore:AddDropdown('MerchantItemDropdownV2', {
		Values = merchantItemList,
		Default = {},
		Multi = true,
		Text = 'Merchant Items (To buy)',
		Tooltip = 'Select multiple items to buy automatically.',
		Callback = function(v)
			if type(v) == "table" then
				H.merchantListSelected = v
			elseif type(v) == "string" and v ~= "" then
				H.merchantListSelected = { [v] = true }
			else
				H.merchantListSelected = {}
			end
		end,
	})

	FishCore:AddButton({ Text = 'Force Auto Merchant (Manual)', Func = function() 
		if H.executeMerchantTask then task.spawn(H.executeMerchantTask) end 
	end})

	-- Performance & Quantities (Right Side)
	local FishPerf = Tabs.Fish:AddRightGroupbox('Performance & Quantities')
	FishPerf:AddSlider('FPSCapSlider', {
		Text    = 'FPS Cap',
		Default = 244,
		Min     = 0,
		Max     = 244,
		Rounding= 0,
		Tooltip = 'Limits the game frames per second (0 = No Limit)',
		Callback = function(v)
			if setfpscap then
				pcall(function() setfpscap(v) end)
			end
		end,
	})

	FishPerf:AddDivider()
	FishPerf:AddLabel('Quantities per item:')
	for _, name in ipairs(merchantItemList) do
		local safeKey = 'MQty_' .. name:gsub("[^%w]", "_")
		FishPerf:AddSlider(safeKey, {
			Text    = name,
			Default = 1, Min = 1, Max = 10, Rounding = 0,
			Tooltip = 'Number of ' .. name .. ' to purchase',
			Callback = function(v)
				H.merchantItemAmounts[name] = v
			end,
		})
	end
end


local function buildMiscTab()
	local H=_G_Hub

	local SkinBox=Tabs.Misc:AddRightGroupbox('Appearance')
	SkinBox:AddToggle('SkinChangerToggle',{
		Text='Skin Changer',
		Default=false,
		Tooltip='Apply custom color and material to your character',
		Callback=function(v)
			H.skinChangerEnabled=v
			if v then H.startSkinChanger() else H.stopSkinChanger() end
		end
	})
	SkinBox:AddLabel('Color'):AddColorPicker('SkinColorPicker',{
		Default=Color3.fromRGB(255, 105, 180),
		Title='Skin Color',
		Callback=function(v)
			H.skinChangerColor=v
			if H.skinChangerEnabled then H.applySkinAppearance() end
		end
	})
	SkinBox:AddDropdown('SkinMaterialDropdown',{
		Text='Material',
		Values=H.SKIN_MATERIAL_LIST,
		Default=1,
		Tooltip='Material applied to your character parts',
		Callback=function(v)
			H.skinChangerMaterial=Enum.Material[v]
			if H.skinChangerEnabled then H.applySkinAppearance() end
		end
	})
	SkinBox:AddDivider()

	local NameBox=Tabs.Misc:AddRightGroupbox('Identity')
	NameBox:AddInput('FakeNameInput',{
		Default='rip_king',Numeric=false,Finished=false,
		Text='Display Name',
		Tooltip='Replaces your username in all visible UI elements',
		Placeholder='Enter fake name...'
	})
	NameBox:AddButton({
		Text='Apply Name',
		Func=function()
			local pseudo=Options.FakeNameInput.Value
			if pseudo and pseudo~="" then
				H.applyNameChanger(pseudo)
				Library:Notify('Display name set to: ' .. pseudo, 3)
			end
		end,
		Tooltip='Apply the spoofed display name'
	})

	local EmoteBox = Tabs.Misc:AddLeftGroupbox('Emotes')
	EmoteBox:AddButton({
		Text='Dance 1',
		Func=function()
			H.createDance1Tool()
			Library:Notify('Dance 1 tool added to backpack.', 3)
		end,
		Tooltip='Adds the Dance 1 emote tool to your backpack'
	})
end

local function buildESPTab()
	local H=_G_Hub
	local esp_set=H.esp_library.settings

	local ESPLeft=Tabs.ESP:AddLeftGroupbox('Player ESP')
	ESPLeft:AddToggle('ESPMaster',{
		Text='Enable ESP',
		Default=false,
		Tooltip='Master switch for all player ESP overlays',
		Callback=function(v) esp_set.master_switch=v end
	})
	ESPLeft:AddDivider()
	ESPLeft:AddToggle('ESPBox',{
		Text='Boxes',
		Default=true,
		Tooltip='Draw bounding boxes around players',
		Callback=function(v) esp_set.boxes.enabled=v end
	})
	ESPLeft:AddLabel('Box Color'):AddColorPicker('BoxColorPicker',{
		Default=Color3.fromRGB(255,255,255),
		Title='Box Color',
		Callback=function(v) esp_set.boxes.color=v end
	})

	local ESPRight=Tabs.ESP:AddRightGroupbox('Overlays')
	ESPRight:AddToggle('ESPNames',{
		Text='Names',
		Default=true,
		Tooltip='Show player names above their character',
		Callback=function(v) esp_set.names.enabled=v end
	})
	ESPRight:AddToggle('ESPDist',{
		Text='Range / Distance ESP',
		Default=true,
		Tooltip='Show player range/distance in studs next to each name',
		Callback=function(v) esp_set.flags.distance[1]=v end
	})
	ESPRight:AddToggle('ESPHealth',{
		Text='Health Bar',
		Default=true,
		Tooltip='Show a health bar on the left of each player box',
		Callback=function(v) esp_set.health_bars.enabled=v end
	})
	ESPRight:AddSlider('ESPHealthThickness',{
		Text='Bar Thickness',
		Default=1,Min=1,Max=10,Rounding=1,
		Tooltip='Pixel thickness of the health bar',
		Callback=function(v) esp_set.health_bars.thickness=v end
	})

	local WorldESP=Tabs.ESP:AddLeftGroupbox('World ESP')
	WorldESP:AddToggle('ChestESPToggle',{
		Text='Chest ESP',
		Default=false,
		Tooltip='Highlight Legendary and Mythical chests in the world',
		Callback=function(v)
			H.chestESPEnabled=v
			if v then H.miscSelectedChests={["Legendary Chest"]=true,["Mythical Chest"]=true}
			else H.miscSelectedChests={} end
			H.refreshChestESP()
		end
	}):AddKeyPicker('ChestESPKey', {
		Default = 'None',
		SyncToggleState = true,
		Mode = 'Toggle',
		Text = 'Chest ESP',
		NoUI = false
	})

	WorldESP:AddToggle('MachineESPToggle',{
		Text='Machine ESP',
		Default=false,
		Tooltip='Displays Machine ESP with absolute precision',
		Callback=function(v)
			H.machineESPEnabled=v
			H.refreshMachineESP()
		end
	})

	local IslandESP=Tabs.ESP:AddRightGroupbox('Island ESP')
	IslandESP:AddToggle('IslandESP1Toggle', {
		Text    = 'Island ESP (Sea 1)',
		Default = false,
		Tooltip = 'Show name and distance of each Sea 1 island on screen',
		Callback = function(v)
			_G_Hub.islandESP1Enabled = v
		end,
	})
	IslandESP:AddToggle('IslandESP2Toggle', {
		Text    = 'Island ESP (Sea 2)',
		Default = false,
		Tooltip = 'Show name and distance of each Sea 2 island on screen',
		Callback = function(v)
			_G_Hub.islandESP2Enabled = v
		end,
	})
end

local function buildConfigTab()
	local H=_G_Hub

	local ServerBox=Tabs.Config:AddLeftGroupbox('Server')
	ServerBox:AddButton({
		Text='Rejoin',
		Func=function()
			game:GetService("TeleportService"):Teleport(game.PlaceId,H.lp)
		end,
		Tooltip='Rejoin the current server'
	})

	local ScriptBox=Tabs.Config:AddLeftGroupbox('Script')
	ScriptBox:AddButton({
		Text='Unload',
		Func=function()
			pcall(function() H.stopAutoFarm() end)
			pcall(function() H.toggleNoDashCD(false) end)
			pcall(function() H.stopWalkSpeed() end)
			pcall(function() H.stopFly() end)
			pcall(function() H.stopSkinChanger() end)
			H.infiniteJumpEnabled=false
			H.noclipActive=false
			H.noStunEnabled=false
			if H.noclipConn then H.noclipConn:Disconnect(); H.noclipConn=nil end
			H.distanceLabels={}
			if H.esp_library then H.esp_library.settings.master_switch=false end
			if H.esp_connections then
				for _,conn in pairs(H.esp_connections) do conn:Disconnect() end
				H.esp_connections={}
			end
			if H.esp_screen_gui then
				for _,f in ipairs(H.esp_screen_gui:GetChildren()) do f:ClearAllChildren(); f:Destroy() end
			end
			pcall(function() H.clearChestESP(); H.chestESPEnabled=false end)
			pcall(function() H.clearMachineESP(); H.machineESPEnabled=false end)
			Library:Unload()
		end,
		Tooltip='Safely remove Prince Hub from memory'
	})

	local UIBox=Tabs.Config:AddRightGroupbox('Interface')
	UIBox:AddLabel('Toggle Keybind'):AddKeyPicker('MenuKeybind',{
		Default='RightShift',
		NoUI=true,
		Text='Menu keybind'
	})
	Library.ToggleKeybind=Options.MenuKeybind

	UIBox:AddLabel('Auto Hide Toggle Key'):AddKeyPicker('AutoHideUIKeybind',{
		Default='LeftAlt',
		NoUI=true,
		Text='Auto hide toggle key'
	})
	Library.AutoHideUIKeybind=Options.AutoHideUIKeybind

	UIBox:AddDivider()
	UIBox:AddToggle('AutoHideUIToggle', {
		Text    = 'Auto Hide UI On Load',
		Default = false,
		Tooltip = 'Automatically hides the Prince Hub menu on load',
		Callback = function(v) end,
	})

	ThemeManager:SetLibrary(Library); SaveManager:SetLibrary(Library)
	SaveManager:IgnoreThemeSettings(); SaveManager:SetIgnoreIndexes({'SaveManager_ConfigList', 'SaveManager_ConfigName'})
	ThemeManager:SetFolder('PrinceHub'); SaveManager:SetFolder('PrinceHub/Configs')
	SaveManager:BuildConfigSection(Tabs.Config); ThemeManager:ApplyToTab(Tabs.Config)

	-- Force apply the Default theme on every load (no other themes exist)
	pcall(function() ThemeManager:ApplyTheme('Default') end)
end

-- ============================================================
-- AUTO DUNGEON
-- Leo: block Firefly/Hiken, recul Pillar
-- Cupid Queen: circle system + block attacks
-- 100% Tween (smooth teleport)
-- ============================================================
if not IS_LOGIN_PLACE then
	do
		local AD = {}

		local _lp      = (cloneref and cloneref(game:GetService("Players")) or game:GetService("Players")).LocalPlayer
		local _RS      = game:GetService("ReplicatedStorage")
		local _run     = cloneref and cloneref(game:GetService("RunService")) or game:GetService("RunService")
		local _VIM     = game:GetService("VirtualInputManager")
		local _UIS     = game:GetService("UserInputService")

		-- Anti-AFK dungeon
		_lp.Idled:Connect(function()
			game:GetService("VirtualUser"):CaptureController()
			game:GetService("VirtualUser"):ClickButton2(Vector2.new())
		end)

		-- ---- STATE ----
		AD.enabled         = false
		AD.loopID          = 0
		AD.kills           = 0
		AD.status          = "idle"
		AD.weapon          = "Kraken Blade"
		AD.waypointIdx     = 0
		AD.comboDelay      = 0.15
		AD.comboDelayNPC   = 0.15
		AD.comboDelayLeo   = 0.20
		AD.comboDelayCupid = 0.21
		AD.fullComboWait   = 1.0
		AD.fullComboWaitCupid = 1.2
		AD.upHeight        = 10
		AD.pillarFlee      = 60

		local antiKBEnabled  = false
		local lockedPosition = nil
		local canAttack      = true
		local activeTpConn   = nil
		local invisibleFloor = nil
		local isTeleporting  = false
		local tpId           = 0
		local hookedBossNPC     = nil
		local hookedBossCleanup = nil
		local cupidTrackTarget  = nil
		local cupidTrackActive  = false
		getgenv().adSkipHit             = false
		getgenv().adStatuePhaseActive   = false
		getgenv().adCupidPhase2Permanent= false

		-- ---- ANTI-KB ----
		_run.Heartbeat:Connect(function()
			local char = _lp.Character; if not char then return end
			local rp  = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChild("Humanoid")
			if not rp or not hum then return end
			if hum.PlatformStand then hum.PlatformStand = false end
			if lockedPosition then
				local dist = (rp.Position - lockedPosition).Magnitude
				if dist > 0.5 then
					local dir = (lockedPosition - rp.Position).Unit
					local step = math.min(getgenv().adTweenSpeed * 0.016, dist)
					rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * step)
				else
					rp.CFrame = CFrame.new(lockedPosition) * CFrame.Angles(math.rad(-90),0,0)
				end
				rp.AssemblyLinearVelocity  = Vector3.zero
				rp.AssemblyAngularVelocity = Vector3.zero
				if hum.PlatformStand then hum.PlatformStand = false end
				return
			end
			if antiKBEnabled then
				rp.AssemblyLinearVelocity  = Vector3.zero
				rp.AssemblyAngularVelocity = Vector3.zero
				if hum.PlatformStand then hum.PlatformStand = false end
			end
		end)

		-- ---- TWEEN TP ----
		getgenv().adTweenSpeed = 89
		local function DoSafeTeleport(targetPos)
			if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end
			local char = _lp.Character
			local rp   = char and char:FindFirstChild("HumanoidRootPart")
			local hum  = char and char:FindFirstChild("Humanoid")
			if not rp or not hum or hum.Health <= 0 then return end
			local dist = (rp.Position - targetPos).Magnitude
			if dist < 5 then rp.CFrame = (rp.CFrame - rp.Position) + targetPos; return end
			if activeTpConn then activeTpConn:Disconnect(); activeTpConn = nil end
			if invisibleFloor then invisibleFloor:Destroy(); invisibleFloor = nil end
			isTeleporting = true; tpId = tpId + 1
			local currentTpId = tpId; local reached = false
			local floor = Instance.new("Part")
			floor.Size = Vector3.new(10,1,10); floor.Transparency = 1
			floor.Anchored = true; floor.CanCollide = true; floor.Parent = workspace
			invisibleFloor = floor
			_VIM:SendKeyEvent(true, Enum.KeyCode.W, false, game)
			task.spawn(function()
			end)
			local conn
			conn = _run.Heartbeat:Connect(function(dt)
				if not rp or not rp.Parent or hum.Health <= 0 or tpId ~= currentTpId then
					reached = true; if conn then conn:Disconnect() end; return
				end
				local currentDist = (rp.Position - targetPos).Magnitude
				if currentDist <= 5 then
					rp.CFrame = (rp.CFrame - rp.Position) + targetPos
					rp.AssemblyLinearVelocity = Vector3.zero
					reached = true
					if invisibleFloor then invisibleFloor:Destroy(); invisibleFloor = nil end
					isTeleporting = false
					if conn then conn:Disconnect() end
					return
				end
				local dir = (targetPos - rp.Position).Unit
				local moveStep = math.min(getgenv().adTweenSpeed * dt, currentDist * 0.98)
				rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * moveStep)
				rp.AssemblyLinearVelocity = Vector3.zero
				if invisibleFloor and invisibleFloor.Parent then
					invisibleFloor.CFrame = rp.CFrame * CFrame.new(0,-3.1,0)
				end
			end)
			activeTpConn = conn
			while not reached and tpId == currentTpId do task.wait(0.1) end
			_VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
		end

		-- ---- REMOTES ----
		local _Events         = _RS:WaitForChild("Events", 5)
		local combatRegister  = _Events and _Events:WaitForChild("CombatRegister", 5)
		local _combatAnimsOk, _combatAnimsVal = pcall(function() return _RS:WaitForChild("CombatAnimations",5):WaitForChild("Melee",5) end)
		local combatAnims_MB  = _combatAnimsOk and _combatAnimsVal or nil
		local blockRemote     = _Events and _Events:WaitForChild("Block", 5)
		local toolsRemote     = _Events and _Events:WaitForChild("Tools", 5)
		local hakiRemote      = _Events and _Events:WaitForChild("Haki", 5)
		local hotbarRemote    = _Events and _Events:WaitForChild("Hotbar", 5)
		local fruitStorageRem = _Events and _Events:WaitForChild("FruitStorage", 5)

		local CombatAnims = {
			combatAnims_MB.Punch1, combatAnims_MB.Punch2,
			combatAnims_MB.Punch3, combatAnims_MB.GroundPunch4,
			combatAnims_MB.GroundPunch5,
		}
		local KrakenAnims = {}; local KatanaAnims = {}; local CupidAxeAnims = {}; local ChakramAnims = {}; local BisentoAnims = {}
		local KatanaSwingSpeeds   = {1.6666666269302368,1.6666666269302368,1.6666666269302368,1.6666666269302368,2}
		local CupidAxeSwingSpeeds = {1.5196077823638916,1.470588207244873,1.470588207244873,1.470588207244873,1.470588207244873}
		local ChakramSwingSpeeds  = {1.2999999523162842,1.2999999523162842,1.2999999523162842,1.2999999523162842,1.2999999523162842}
		local BisentoSwingSpeeds  = {2.0512821674346924,1.7948716878890991,1.846153974533081,1.5384615659713745,1.5384615659713745}

		task.spawn(function()
			-- Try all Kraken Blade variants in RS.Tools
			local krakenVariants = {
				"Kraken Blade", "Kraken Blade (Gold)", "Kraken Blade (Azure)",
				"Kraken Blade (Blue)", "Kraken Blade (Green)",
				"Kraken Blade (Purple)", "Kraken Blade (Red)"
			}
			-- First try via Modules/SwordHandle/Swords
			local ok, s = pcall(function()
				local tools = _RS:WaitForChild("Modules", 5):WaitForChild("SwordHandle", 5):WaitForChild("Swords", 5)
				for _, variant in ipairs(krakenVariants) do
					local t = tools:FindFirstChild(variant)
					if t then
						local sl = t:FindFirstChild("Slashes")
						if sl then return sl end
					end
				end
				error("not found")
			end)
			if ok and s then
				for i, n in ipairs({"Slash1","Slash2","Slash3","GroundSlash4","GroundSlash5"}) do
					KrakenAnims[i] = s:WaitForChild(n)
				end
				return
			end
			-- Fallback: try via RS.Tools directly
			pcall(function()
				local tools = _RS:WaitForChild("Tools", 10)
				for _, variant in ipairs(krakenVariants) do
					local t = tools:FindFirstChild(variant)
					if t then
						local sl = t:FindFirstChild("Slashes")
						if sl then
							for i, n in ipairs({"Slash1","Slash2","Slash3","GroundSlash4","GroundSlash5"}) do
								local a = sl:FindFirstChild(n)
								if a then KrakenAnims[i] = a end
							end
							return
						end
					end
				end
			end)
		end)
		task.spawn(function()
			local ok,s=pcall(function() return _RS:WaitForChild("Modules",10):WaitForChild("SwordHandle",10):WaitForChild("Swords",10):WaitForChild("Katana",10):WaitForChild("Slashes",10) end)
			if ok and s then for i,n in ipairs({"Slash1","Slash2","Slash3","GroundSlash4","GroundSlash5"}) do KatanaAnims[i]=s:WaitForChild(n) end end
		end)
		task.spawn(function()
			local ok,s=pcall(function() return _RS:WaitForChild("Modules",10):WaitForChild("SwordHandle",10):WaitForChild("Swords",10):WaitForChild("Cupid's Battleaxe",10):WaitForChild("Slashes",10) end)
			if ok and s then for i,n in ipairs({"Slash1","Slash2","Slash3","GroundSlash4","GroundSlash5"}) do CupidAxeAnims[i]=s:WaitForChild(n) end end
		end)
		task.spawn(function()
			local ok,s=pcall(function() return _RS:WaitForChild("Modules",10):WaitForChild("SwordHandle",10):WaitForChild("Swords",10):WaitForChild("Cupid's Chakram",10):WaitForChild("Slashes",10) end)
			if ok and s then for i,n in ipairs({"Slash1","Slash2","Slash3","GroundSlash4","GroundSlash5"}) do ChakramAnims[i]=s:WaitForChild(n) end end
		end)
		task.spawn(function()
			local ok,s=pcall(function() return _RS:WaitForChild("Modules",10):WaitForChild("SwordHandle",10):WaitForChild("Swords",10):WaitForChild("Bisento",10):WaitForChild("Slashes",10) end)
			if ok and s then for i,n in ipairs({"Slash1","Slash2","Slash3","GroundSlash4","GroundSlash5"}) do BisentoAnims[i]=s:WaitForChild(n) end end
		end)


		local weaponEquipped = false

		local function equipWeapon()
			local wn = AD.weapon or "Melee"
			local char = _lp.Character
			if weaponEquipped and char then
				-- Check if a weapon matching wn is already equipped
				if wn == "Melee" then return true end
				for _, tool in ipairs(char:GetChildren()) do
					if tool:IsA("Tool") and string.lower(tool.Name):find(string.lower(wn):gsub("%(.*%)", ""):gsub("%s+$","")) then
						return true
					end
				end
			end
			weaponEquipped = false
			if wn == "Melee" then
				pcall(function() hakiRemote:FireServer("Buso") end)
				weaponEquipped = true
				return true
			end
			local keyword = string.lower(wn):gsub("%(.*%)", ""):gsub("%s+$","")
			-- Check if weapon is already equipped on the character
			if char then
				for _, tool in ipairs(char:GetChildren()) do
					if tool:IsA("Tool") and string.lower(tool.Name):find(keyword, 1, true) then
						pcall(function() hakiRemote:FireServer("Buso") end)
						weaponEquipped = true
						return true
					end
				end
			end
			-- Look for the real name in the Backpack
			local realName = wn
			local bp = _lp:FindFirstChild("Backpack")
			if bp then
				for _, tool in ipairs(bp:GetChildren()) do
					if tool:IsA("Tool") and string.lower(tool.Name):find(keyword, 1, true) then
						realName = tool.Name
						break
					end
				end
			end
			-- If not found in backpack, search in RS.Tools (all variants)
			if realName == wn then
				pcall(function()
					local rsTools = _RS:FindFirstChild("Tools")
					if rsTools then
						for _, tool in ipairs(rsTools:GetChildren()) do
							if string.lower(tool.Name):find(keyword, 1, true) then
								realName = tool.Name
								break
							end
						end
					end
				end)
			end
			-- Place the weapon in hotbar slot One using its real name
			pcall(function()
				hotbarRemote:FireServer({
					Zero="None",One=realName,Two="None",Three="None",Four="None",
					Five="None",Six="None",Seven="None",Eight="None",Nine="None"
				})
			end)
			task.wait(0.3)
			-- Click slot One to equip
			local pg = _lp:FindFirstChild("PlayerGui")
			local hotbar = pg and pg:FindFirstChild("BackpackGui") and pg.BackpackGui:FindFirstChild("Hotbar")
			if hotbar and hotbar:FindFirstChild("One") then
				local vim = Instance.new("VirtualInputManager")
				vim:SendKeyEvent(true, Enum.KeyCode.One, false, nil)
				task.wait(0.1)
				vim:SendKeyEvent(false, Enum.KeyCode.One, false, nil)
				vim:Destroy()
			end
			task.wait(0.2)
			pcall(function() hakiRemote:FireServer("Buso") end)
			weaponEquipped = true
			return true
		end

		-- ---- NPC UTILS ----
		local function getNPCID(npc)
			if not npc then return nil end
			local v = npc:FindFirstChild("NPCID"); if v then return v.Value end
			local cfg = npc:FindFirstChild("Configuration")
			if cfg then local cv = cfg:FindFirstChild("NPCID"); if cv then return cv.Value end end
			return npc:GetAttribute("NPCID")
		end

		local function getAllNearbyNPCs(pos, radius)
			local res = {}; radius = radius or 80
			local function scan(fn)
				local f = workspace:FindFirstChild(fn); if not f then return end
				for _,v in pairs(f:GetChildren()) do
					if v:IsA("Model") then
						local hum = v:FindFirstChild("Humanoid"); local hrp = v:FindFirstChild("HumanoidRootPart")
						if hum and hum.Health > 0 and hrp then
							local dx = pos.X-hrp.Position.X; local dz = pos.Z-hrp.Position.Z
							local d  = math.sqrt(dx*dx+dz*dz)
							if d <= radius then table.insert(res,{npc=v,hrp=hrp,dist=d}) end
						end
					end
				end
			end
			scan("NPCs"); scan("Enemies")
			table.sort(res, function(a,b) return a.dist<b.dist end)
			return res
		end

		local function findBossGlobal(bossName)
			local function scan(fn)
				local f = workspace:FindFirstChild(fn); if not f then return nil end
				for _,v in pairs(f:GetChildren()) do
					if v:IsA("Model") and string.lower(v.Name)==string.lower(bossName) then
						local hum=v:FindFirstChild("Humanoid"); local hrp=v:FindFirstChild("HumanoidRootPart")
						if hum and hum.Health>0 and hrp then return v end
					end
				end
				return nil
			end
			return scan("NPCs") or scan("Enemies")
		end

		-- ---- TRACKER CUPID ----
		task.spawn(function()
			while true do
				task.wait(0.05)
				if not cupidTrackActive or not AD.enabled or not cupidTrackTarget then continue end
				local hrp = cupidTrackTarget:FindFirstChild("HumanoidRootPart")
				local hum = cupidTrackTarget:FindFirstChild("Humanoid")
				if not hrp or not hum or hum.Health<=0 then
					cupidTrackTarget=nil; cupidTrackActive=false; continue
				end
				if getgenv().adStatuePhaseActive then continue end
				local rp = _lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart")
				if not rp then continue end
				local targetPos = Vector3.new(hrp.Position.X, hrp.Position.Y+AD.upHeight, hrp.Position.Z)
				if (rp.Position-targetPos).Magnitude > 5 then
					lockedPosition = nil
					DoSafeTeleport(targetPos)
				end
				lockedPosition = targetPos
			end
		end)

		-- ---- COMBAT ----
		local function attackNPC(npc)
			if not npc then return end
			local hum = npc:FindFirstChild("Humanoid"); local hrp = npc:FindFirstChild("HumanoidRootPart")
			if not hum or hum.Health<=0 or not hrp then return end
			if not canAttack then return end
			canAttack = false; antiKBEnabled = true
			local nlo    = string.lower(npc.Name)
			local isLeo  = (nlo=="leo"); local isCupid = (nlo=="cupid queen")
			local delay  = isCupid and AD.comboDelayCupid or (isLeo and AD.comboDelayLeo or AD.comboDelayNPC)
			local rp     = _lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart")
			local isKraken   = AD.weapon=="Kraken Blade"
			local isKatana   = AD.weapon=="Katana"
			local isCupidAxe = AD.weapon=="Cupid's Battleaxe"
			local isChakram  = AD.weapon=="Cupid's Chakram"
			local isBisento  = AD.weapon=="Bisento"
			local wType  = (isKraken or isKatana or isCupidAxe or isChakram or isBisento) and "Sword" or "Melee"
			local anims  = isBisento and BisentoAnims or (isChakram and ChakramAnims or (isCupidAxe and CupidAxeAnims or (isKatana and KatanaAnims or (isKraken and KrakenAnims or CombatAnims))))
			local swSp   = isBisento and BisentoSwingSpeeds[1] or (isChakram and ChakramSwingSpeeds[1] or (isCupidAxe and CupidAxeSwingSpeeds[1] or (isKatana and KatanaSwingSpeeds[1] or (isKraken and 1.4583332538604736 or 1.75))))
			for combo=1,5 do
				if not AD.enabled then break end
				if getgenv().adSkipHit and string.lower(npc.Name)~="cupid queen" then break end
				if getgenv().adStatuePhaseActive then break end
				hum=npc:FindFirstChild("Humanoid"); hrp=npc:FindFirstChild("HumanoidRootPart")
				if not hum or hum.Health<=0 or not hrp then break end
				local hrpList={}; local npcIDs={}
				local scanPos = rp and rp.Position or hrp.Position
				for _,d in ipairs(getAllNearbyNPCs(scanPos,120)) do
					if d.hrp and d.npc:FindFirstChild("Humanoid") and d.npc.Humanoid.Health>0 then
						table.insert(hrpList,d.hrp)
						local did=getNPCID(d.npc); if did then table.insert(npcIDs,did) end
					end
				end
				if #hrpList==0 then table.insert(hrpList,hrp) end
				if rp then rp.AssemblyLinearVelocity=Vector3.zero; rp.AssemblyAngularVelocity=Vector3.zero end
				local cSw = isBisento and BisentoSwingSpeeds[combo] or (isChakram and ChakramSwingSpeeds[combo] or (isCupidAxe and CupidAxeSwingSpeeds[combo] or (isKatana and KatanaSwingSpeeds[combo] or swSp)))
				pcall(function()
					combatRegister:InvokeServer({[1]="swingsfx",[2]=wType,[3]=combo,[4]="Ground",[5]=false,[6]=anims[combo],[7]=cSw,[8]=1.5})
					local da={[1]={[1]="damage",[2]=hrpList,[3]=wType,[4]={combo,"Ground",wType},[5]=true,[6]=rp and rp.CFrame or CFrame.new(),aircombo="Ground"}}
					if #npcIDs>0 then da[1].NPCIDs=npcIDs end
					combatRegister:InvokeServer(unpack(da))
				end)
				if getgenv().adStatuePhaseActive then break end
				task.wait(delay)
				if getgenv().adStatuePhaseActive then break end
			end
			local w2=0; local wt = isCupid and AD.fullComboWaitCupid or AD.fullComboWait
			while w2<wt do
				if getgenv().adStatuePhaseActive then break end
				task.wait(0.05); w2=w2+0.05
			end
			antiKBEnabled=false; canAttack=true
		end

