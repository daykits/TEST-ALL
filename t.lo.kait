	_G_Hub.whiteScreenStartTime = 0
	_G_Hub.autoLDBEnabled = false
	_G_Hub.autoLDBConn = nil

	_G_Hub.makeBattleRoyaleGraphicsUgly = function()
		local H = _G_Hub
		local Lighting = game:GetService("Lighting")

		pcall(function()
			-- Disables visual effects (without touching brightness)
			Lighting.GlobalShadows = false
			for _, effect in ipairs(Lighting:GetChildren()) do
				if effect:IsA("BlurEffect")
					or effect:IsA("BloomEffect")
					or effect:IsA("ColorCorrectionEffect")
					or effect:IsA("SunRaysEffect")
					or effect:IsA("DepthOfFieldEffect") then
					effect.Enabled = false
				end
			end
			-- Reduces material quality without changing lighting
			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.Material = Enum.Material.SmoothPlastic
					obj.Reflectance = 0
					obj.CastShadow = false
				end
			end
			-- Minimum quality
			pcall(function()
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end)
		end)
		Library:Notify("3DS Render applied.", 3)
	end

	_G_Hub.setWhiteScreen = function(state)
		local H = _G_Hub
		H.whiteScreenEnabled = state

		if H.whiteScreenTimerConn then
			H.whiteScreenTimerConn:Disconnect()
			H.whiteScreenTimerConn = nil
		end

		if H.whiteScreenGui then
			H.whiteScreenGui:Destroy()
			H.whiteScreenGui = nil
		end

		if not state then
			return
		end

		local coreGui = game:GetService("CoreGui")

		pcall(function()
			Library.ScreenGui.DisplayOrder = 100
		end)

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "PrinceHubWhiteScreen"
		screenGui.IgnoreGuiInset = true
		screenGui.ResetOnSpawn = false
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.DisplayOrder = 1
		screenGui.Parent = coreGui

		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.new(1, 1, 1)
		frame.BorderSizePixel = 0
		frame.ZIndex = 1
		frame.Parent = screenGui

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0, 80)
		title.Position = UDim2.fromScale(0, 0.33)
		title.AnchorPoint = Vector2.new(0, 0.5)
		title.BackgroundTransparency = 1
		title.Text = "CRYSTAL HUB"
		title.TextColor3 = Color3.fromRGB(0, 0, 0)
		title.Font = Enum.Font.GothamBlack
		title.TextScaled = true
		title.TextXAlignment = Enum.TextXAlignment.Center
		title.ZIndex = 2
		title.Parent = frame

		local subtitle = Instance.new("TextLabel")
		subtitle.Size = UDim2.new(1, 0, 0, 30)
		subtitle.Position = UDim2.fromScale(0, 0.46)
		subtitle.AnchorPoint = Vector2.new(0, 0.5)
		subtitle.BackgroundTransparency = 1
		subtitle.Text = "WHITE SCREEN"
		subtitle.TextColor3 = Color3.fromRGB(30, 30, 30)
		subtitle.Font = Enum.Font.GothamBold
		subtitle.TextScaled = true
		subtitle.TextXAlignment = Enum.TextXAlignment.Center
		subtitle.ZIndex = 2
		subtitle.Parent = frame

		local divider = Instance.new("Frame")
		divider.Size = UDim2.new(0, 260, 0, 2)
		divider.Position = UDim2.new(0.5, -130, 1, 6)
		divider.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		divider.BorderSizePixel = 0
		divider.ZIndex = 2
		divider.Parent = subtitle

		local timer = Instance.new("TextLabel")
		timer.Size = UDim2.new(1, 0, 0, 30)
		timer.Position = UDim2.fromScale(0, 0.56)
		timer.AnchorPoint = Vector2.new(0, 0.5)
		timer.BackgroundTransparency = 1
		timer.Text = "00:00"
		timer.TextColor3 = Color3.fromRGB(40, 40, 40)
		timer.Font = Enum.Font.GothamBold
		timer.TextScaled = true
		timer.TextXAlignment = Enum.TextXAlignment.Center
		timer.ZIndex = 2
		timer.Parent = frame

		H.whiteScreenGui = screenGui
		H.whiteScreenStartTime = tick()

		H.whiteScreenTimerConn = game:GetService("RunService").Heartbeat:Connect(function()
			if not H.whiteScreenGui or not frame.Parent then
				return
			end
			local elapsed = tick() - H.whiteScreenStartTime
			local minutes = math.floor(elapsed / 60)
			local seconds = math.floor(elapsed % 60)
			timer.Text = string.format("%02d:%02d", minutes, seconds)
		end)
	end

	_G_Hub.setAutoLDB = function(state)
		local H = _G_Hub
		H.autoLDBEnabled = state

		local function fireButton(btn)
			if not btn then
				return
			end
			local ok, conns = pcall(getconnections, btn.MouseButton1Click)
			if not ok or not conns then
				return
			end
			for _, conn in pairs(conns) do
				pcall(function()
					conn:Fire()
				end)
			end
		end

		local function handleRoundReport(child)
			if not H.autoLDBEnabled then
				return
			end
			if not child or child.Name ~= "roundreport" then
				return
			end

			local background = child:FindFirstChild("background") or child:WaitForChild("background", 10)
			if not background then return end

			local frame = background:FindFirstChild("Frame") or background:WaitForChild("Frame", 10)
			if not frame then return end

			local con = frame:FindFirstChild("con") or frame:WaitForChild("con", 10)
			if not con then return end

			for _ = 1, 8 do
				if not H.autoLDBEnabled then return end
				fireButton(con)
				task.wait(0.35)
			end

			local playerGui = H.lp and H.lp:FindFirstChild("PlayerGui")
			if not playerGui then return end

			for _ = 1, 12 do
				if not H.autoLDBEnabled then return end

				local matchmake = playerGui:FindFirstChild("Matchmake")
				local play = matchmake and matchmake:FindFirstChild("play")
				local buttons = play and play:FindFirstChild("Buttons")
				local playBtn = buttons and buttons:FindFirstChild("playButton")

				if playBtn then
					fireButton(playBtn)
				end

				local nextReport = playerGui:FindFirstChild("roundreport")
				if nextReport and nextReport ~= child then
					local nextBg = nextReport:FindFirstChild("background") or nextReport:WaitForChild("background", 2)
					local nextFrame = nextBg and (nextBg:FindFirstChild("Frame") or nextBg:WaitForChild("Frame", 2))
					local nextCon = nextFrame and (nextFrame:FindFirstChild("con") or nextFrame:WaitForChild("con", 2))
					if nextCon then
						fireButton(nextCon)
					end
				end

				task.wait(0.5)
			end
		end

		if H.autoLDBConn then
			H.autoLDBConn:Disconnect()
			H.autoLDBConn = nil
		end

		if not state then
			return
		end

		local playerGui = H.lp and H.lp:FindFirstChild("PlayerGui")
		if not playerGui then
			return
		end

		H.autoLDBConn = playerGui.ChildAdded:Connect(function(child)
			task.spawn(function()
				handleRoundReport(child)
			end)
		end)

		local existing = playerGui:FindFirstChild("roundreport")
		if existing then
			task.spawn(function()
				handleRoundReport(existing)
			end)
		end
	end

	_G_Hub.autoLogBusy = false
	_G_Hub.runAutoLog = function()
		local H = _G_Hub
		if H.autoLogBusy then
			return
		end

		H.autoLogBusy = true

		task.spawn(function()
			local positions = {
				Vector3.new(-1596.125, 12.299, -10075.196), -- Arlong Park
				Vector3.new(-1301.055, 4.125, -5060.857),   -- shell
				Vector3.new(-1545.026, 4.475, -3342.527),   -- sandora
				Vector3.new(-4379.840, 7.482, -3144.638),   -- haki island
				Vector3.new(-3144.926, 11.609, -5237.573),  -- zoo
				Vector3.new(-2954.337, 6.313, -6696.417),   -- shell town
				Vector3.new(-4463.573, 6.301, -6635.959),   -- clown
				Vector3.new(-8029.889, 18.727, -8768.631),  -- reverse
				Vector3.new(-5985.940, 57.246, -11482.729), -- marine ford
				Vector3.new(-4006.182, 42.166, -9156.647),  -- sphinx
			}

			local setSpawnRemote = game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("SetSpawn")

			for _, pos in ipairs(positions) do
				pcall(function()
					H.DoSafeTeleport(pos)
				end)

				task.wait(1.2)

				pcall(function()
					local args = {
						"Pose"
					}
					setSpawnRemote:FireServer(unpack(args))
				end)

				task.wait(0.6)
			end

			H.autoLogBusy = false
		end)
	end
end

-- ============================================================
-- LE TELEPORTEUR UNIVERSEL FACEMOUSE (U-SHAPE SKY FLY)
-- ============================================================
-- ============================================================
-- TWEEN ANIMATION (played during every teleport)
-- ============================================================
local _tweenAnimTrack = nil

-- Animation disabled: Kaitun/teleport movement must stay invisible and not play the old tween animation.
local function playTweenAnim()
	if _tweenAnimTrack then
		pcall(function() _tweenAnimTrack:Stop() end)
		_tweenAnimTrack = nil
	end
end

local function stopTweenAnim()
	if _tweenAnimTrack then
		pcall(function() _tweenAnimTrack:Stop() end)
		_tweenAnimTrack = nil
	end
end

-- ============================================================
-- FISHMAN ISLAND ESCAPE ROUTE
-- ============================================================
local FISHMAN_ESCAPE_PATH = {
	Vector3.new(7748.483, -2176.832, -17238.244),
	Vector3.new(7768.235, -2176.832, -17172.229),
	Vector3.new(7893.623, -2153.832, -17161.494),
	Vector3.new(8162.354, -2148.832, -17099.150),
	Vector3.new(8236.417, -2141.832, -17150.012),
	Vector3.new(8530.771, -2140.832, -17145.730),
	Vector3.new(8579.463, -2138.860, -17088.359),
}

local function isOnFishmanIsland()
	local H = _G_Hub
	local char = H.lp and H.lp.Character
	local rp = char and char:FindFirstChild("HumanoidRootPart")
	if not rp then return false end
	-- Fishman island: Y below -1500 and Z below -15000
	return rp.Position.Y < -1500 and rp.Position.Z < -15000
end

local function fishmanEscape()
	local H = _G_Hub
	-- Enable noclip during the escape
	if Toggles and Toggles.NoclipToggle then Toggles.NoclipToggle:SetValue(true) end
	for _, wp in ipairs(FISHMAN_ESCAPE_PATH) do
		local char = H.lp and H.lp.Character
		local rp = char and char:FindFirstChild("HumanoidRootPart")
		if not rp then break end
		-- Direct waypoint-by-waypoint teleport (no arc)
		local reached = false
		local tpIdLocal = (H.tpId or 0) + 1
		H.tpId = tpIdLocal
		H.isTeleporting = true
		if H.activeTpConn then H.activeTpConn:Disconnect(); H.activeTpConn = nil end

		local floor = Instance.new("Part")
		floor.Size = Vector3.new(10,1,10); floor.Transparency = 1
		floor.Anchored = true; floor.CanCollide = true; floor.Parent = workspace
		H.invisibleFloor = floor

		H.VIM:SendKeyEvent(true, Enum.KeyCode.W, false, game)

		local conn
		conn = H.run_svc.Heartbeat:Connect(function(dt)
			if not rp or not rp.Parent or H.tpId ~= tpIdLocal then
				reached = true; if conn then conn:Disconnect() end; return
			end
			local d = (rp.Position - wp).Magnitude
			if d <= 8 then
				rp.CFrame = (rp.CFrame - rp.Position) + wp
				rp.AssemblyLinearVelocity = Vector3.zero
				reached = true
				if floor and floor.Parent then floor:Destroy() end
				H.isTeleporting = false
				if conn then conn:Disconnect() end
				return
			end
			local dir = (wp - rp.Position).Unit
			local step = math.min((H.teleportSpeed or 89) * dt, d * 0.98)
			rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * step)
			rp.AssemblyLinearVelocity = Vector3.zero
			if floor and floor.Parent then
				floor.CFrame = rp.CFrame * CFrame.new(0,-3.1,0)
			end
		end)
		H.activeTpConn = conn
		while not reached and H.tpId == tpIdLocal do task.wait(0.05) end
		task.wait(0.05)
	end
	H.VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
	if H.invisibleFloor then H.invisibleFloor:Destroy(); H.invisibleFloor = nil end
	H.isTeleporting = false
	-- Disable noclip after the escape
	if Toggles and Toggles.NoclipToggle then Toggles.NoclipToggle:SetValue(false) end
	task.wait(0.5)
end

_G_Hub.DoSafeTeleport = function(targetPos)
	local H = _G_Hub
	if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end

	local char = H.lp.Character
	local rp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")
	if not rp or not hum or hum.Health <= 0 then return end


	rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
	if not rp then return end

	local dist = (rp.Position - targetPos).Magnitude
	if dist < 5 then 
		rp.CFrame = (rp.CFrame - rp.Position) + targetPos
		return 
	end

	if H.activeTpConn then H.activeTpConn:Disconnect(); H.activeTpConn = nil end
	if H.invisibleFloor then H.invisibleFloor:Destroy(); H.invisibleFloor = nil end
	-- Supprimer tous les BodyVelocity farm pour que le tween puisse bouger librement
	for _, bvName in ipairs({"AF_BV", "S2_BV", "AH_BV"}) do
		local bv = rp:FindFirstChild(bvName)
		if bv then bv:Destroy() end
	end


	H.isTeleporting = true
	H.tpTarget = targetPos
	H.tpId = (H.tpId or 0) + 1
	local currentTpId = H.tpId

	local speed = H.teleportSpeed or 89 
	local reached = false

	local waypoints = {}
	if dist > 300 then
		local safeAlt = math.max(rp.Position.Y, targetPos.Y) + 2500
		table.insert(waypoints, Vector3.new(rp.Position.X, safeAlt, rp.Position.Z))
		table.insert(waypoints, Vector3.new(targetPos.X, safeAlt, targetPos.Z))
		-- If target is very low (e.g. Fishman cave), add a waypoint
		-- midpoint to avoid abrupt stop at height
		if targetPos.Y < -500 then
			local midY = (safeAlt + targetPos.Y) / 2
			table.insert(waypoints, Vector3.new(targetPos.X, midY, targetPos.Z))
		end
	end
	table.insert(waypoints, targetPos)

	local currentWp = 1

	local invisibleFloor = Instance.new("Part")
	invisibleFloor.Size = Vector3.new(10, 1, 10)
	invisibleFloor.Transparency = 1 
	invisibleFloor.Anchored = true
	invisibleFloor.CanCollide = true
	invisibleFloor.Parent = workspace
	H.invisibleFloor = invisibleFloor

	if not H.DisableForwardKey then
		H.VIM:SendKeyEvent(true, Enum.KeyCode.W, false, game)
	end
	playTweenAnim()

	task.spawn(function()
		local API = H.ReplicatedStorage and H.ReplicatedStorage:FindFirstChild("Events")
		local faceMouseRemote = API and API:FindFirstChild("faceMouse")

		while not reached and H.tpId == currentTpId do
			if faceMouseRemote then
				pcall(function() faceMouseRemote:FireServer(true) end)
				pcall(function() faceMouseRemote:FireServer(false) end)
			end
			task.wait(1) 
		end

		if H.tpId == currentTpId then
			H.VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
		end
	end)

	local conn
	conn = H.run_svc.Heartbeat:Connect(function(dt)
		if not rp or not rp.Parent or hum.Health <= 0 or H.tpId ~= currentTpId then
			reached = true
			if conn then conn:Disconnect() end
			return
		end

		local wp = waypoints[currentWp]
		local d = (rp.Position - wp).Magnitude

		if d <= 20 then
			-- Snap directly to waypoint to avoid oscillation
			rp.CFrame = (rp.CFrame - rp.Position) + wp
			rp.AssemblyLinearVelocity = Vector3.zero
			currentWp = currentWp + 1
			if currentWp > #waypoints then
				rp.CFrame = (rp.CFrame - rp.Position) + targetPos
				rp.AssemblyLinearVelocity = Vector3.zero
				reached = true
				if H.invisibleFloor then H.invisibleFloor:Destroy(); H.invisibleFloor = nil end
				H.isTeleporting = false
				stopTweenAnim()
				if conn then conn:Disconnect() end
				return
			end
			wp = waypoints[currentWp]
			d = (rp.Position - wp).Magnitude
		end

		local dir = (wp - rp.Position).Unit
		local moveStep = math.min(speed * dt, d * 0.9)

		rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * moveStep)
		rp.AssemblyLinearVelocity = Vector3.zero

		if H.invisibleFloor and H.invisibleFloor.Parent then
			H.invisibleFloor.CFrame = rp.CFrame * CFrame.new(0, -3.1, 0)
		end
	end)
	H.activeTpConn = conn

	while not reached and H.tpId == currentTpId do
		task.wait(0.1)
	end
end

-- ============================================================
-- ARC TELEPORT : monte toujours haut dans les airs puis descend
-- used for auto haki, regardless of distance
-- ============================================================
_G_Hub.DoArcTeleport = function(targetPos)
	local H = _G_Hub
	if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end

	local char = H.lp.Character
	local rp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")
	if not rp or not hum or hum.Health <= 0 then return end


	rp = H.lp.Character and H.lp.Character:FindFirstChild("HumanoidRootPart")
	if not rp then return end

	local dist = (rp.Position - targetPos).Magnitude
	if dist < 5 then
		rp.CFrame = (rp.CFrame - rp.Position) + targetPos
		return
	end

	if H.activeTpConn then H.activeTpConn:Disconnect(); H.activeTpConn = nil end
	if H.invisibleFloor then H.invisibleFloor:Destroy(); H.invisibleFloor = nil end
	-- Supprimer tous les BodyVelocity farm pour que le tween puisse bouger librement
	for _, bvName in ipairs({"AF_BV", "S2_BV", "AH_BV"}) do
		local bv = rp:FindFirstChild(bvName)
		if bv then bv:Destroy() end
	end


	H.isTeleporting = true
	H.tpTarget = targetPos
	H.tpId = (H.tpId or 0) + 1
	local currentTpId = H.tpId

	local speed = H.teleportSpeed or 89
	local reached = false

	-- always forces high arc mode
	local safeAlt = math.max(rp.Position.Y, targetPos.Y) + 2500
	local waypoints = {
		Vector3.new(rp.Position.X, safeAlt, rp.Position.Z),
		Vector3.new(targetPos.X, safeAlt, targetPos.Z),
	}
	-- Intermediate waypoint if target is very low (e.g. Fishman cave)
	if targetPos.Y < -500 then
		table.insert(waypoints, Vector3.new(targetPos.X, (safeAlt + targetPos.Y) / 2, targetPos.Z))
	end
	table.insert(waypoints, targetPos)

	local currentWp = 1

	local invisibleFloor = Instance.new("Part")
	invisibleFloor.Size = Vector3.new(10, 1, 10)
	invisibleFloor.Transparency = 1
	invisibleFloor.Anchored = true
	invisibleFloor.CanCollide = true
	invisibleFloor.Parent = workspace
	H.invisibleFloor = invisibleFloor

	if not H.DisableForwardKey then
		H.VIM:SendKeyEvent(true, Enum.KeyCode.W, false, game)
	end
	playTweenAnim()

	task.spawn(function()
		local API = H.ReplicatedStorage and H.ReplicatedStorage:FindFirstChild("Events")
		local faceMouseRemote = API and API:FindFirstChild("faceMouse")
		while not reached and H.tpId == currentTpId do
			if faceMouseRemote then
				pcall(function() faceMouseRemote:FireServer(true) end)
				pcall(function() faceMouseRemote:FireServer(false) end)
			end
			task.wait(1)
		end
		if H.tpId == currentTpId then
			H.VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
		end
	end)

	local conn
	conn = H.run_svc.Heartbeat:Connect(function(dt)
		if not rp or not rp.Parent or hum.Health <= 0 or H.tpId ~= currentTpId then
			reached = true
			if conn then conn:Disconnect() end
			return
		end
		local wp = waypoints[currentWp]
		local d = (rp.Position - wp).Magnitude
		if d <= 20 then
			-- Snap direct au waypoint
			rp.CFrame = (rp.CFrame - rp.Position) + wp
			rp.AssemblyLinearVelocity = Vector3.zero
			currentWp = currentWp + 1
			if currentWp > #waypoints then
				rp.CFrame = (rp.CFrame - rp.Position) + targetPos
				rp.AssemblyLinearVelocity = Vector3.zero
				reached = true
				if H.invisibleFloor then H.invisibleFloor:Destroy(); H.invisibleFloor = nil end
				H.isTeleporting = false
				stopTweenAnim()
				if conn then conn:Disconnect() end
				return
			end
			wp = waypoints[currentWp]
			d = (rp.Position - wp).Magnitude
		end
		local dir = (wp - rp.Position).Unit
		local moveStep = math.min(speed * dt, d * 0.9)
		rp.CFrame = (rp.CFrame - rp.Position) + (rp.Position + dir * moveStep)
		rp.AssemblyLinearVelocity = Vector3.zero
		if H.invisibleFloor and H.invisibleFloor.Parent then
			H.invisibleFloor.CFrame = rp.CFrame * CFrame.new(0, -3.1, 0)
		end
	end)
	H.activeTpConn = conn

	while not reached and H.tpId == currentTpId do
		task.wait(0.1)
	end
end

