			while task.wait(0.5) do
				if not AD.enabled then continue end
				local leo=findBossGlobal("Leo")
				if leo and hookedBossNPC~=leo then
					if hookedBossCleanup then hookedBossCleanup() end
					hookedBossCleanup=startBossHook(leo,LEO_ANIMS); hookedBossNPC=leo
				end
				local cupid=findBossGlobal("Cupid Queen")
				if cupid and hookedBossNPC~=cupid then
					if hookedBossCleanup then hookedBossCleanup() end
					hookedBossCleanup=startBossHook(cupid,CUPID_ANIMS); hookedBossNPC=cupid
				end
			end
		end)

		-- ---- STATUES ----
		local function statuesNeedKilling()
			local obj=_lp.PlayerGui:FindFirstChild("Objectives"); if not obj then return false end
			local main=obj:FindFirstChild("Main"); if not main then return false end
			return main:FindFirstChild("Take down the Statues")~=nil
		end

		task.spawn(function()
			local objectives=_lp.PlayerGui:WaitForChild("Objectives",30); if not objectives then return end
			local main=objectives:WaitForChild("Main",30); if not main then return end
			main.ChildAdded:Connect(function(child)
				if child.Name:lower():find("statue") then getgenv().adStatuePhaseActive=true end
			end)
		end)

		task.spawn(function()
			while true do
				task.wait(0.5)
				if not AD.enabled then continue end
				if getgenv().adStatuePhaseActive then continue end
				local sf=workspace:FindFirstChild("Env") and workspace.Env:FindFirstChild("Statues")
				if not sf then continue end
				for _,statue in pairs(sf:GetChildren()) do
					local b=statue:FindFirstChild("barrelHP")
					if b and b.Value>0 then getgenv().adStatuePhaseActive=true; break end
				end
			end
		end)

		local function killStatues(loopID)
			AD.status="statues"
			local isKraken=AD.weapon=="Kraken Blade"; local isKatana=AD.weapon=="Katana"; local isCupidAxe=AD.weapon=="Cupid's Battleaxe"; local isChakram=AD.weapon=="Cupid's Chakram"; local isBisento=AD.weapon=="Bisento"
			local wType=(isKraken or isKatana or isCupidAxe or isChakram or isBisento) and "Sword" or "Melee"
			local anims=isBisento and BisentoAnims or (isChakram and ChakramAnims or (isCupidAxe and CupidAxeAnims or (isKatana and KatanaAnims or (isKraken and KrakenAnims or CombatAnims))))
			local KatSp={1.6666666269302368,1.6666666269302368,1.6666666269302368,1.6666666269302368,2}
			local CAxSp={1.5196077823638916,1.470588207244873,1.470588207244873,1.470588207244873,1.470588207244873}
			local CkSp={1.2999999523162842,1.2999999523162842,1.2999999523162842,1.2999999523162842,1.2999999523162842}
			local BiSp={2.0512821674346924,1.7948716878890991,1.846153974533081,1.5384615659713745,1.5384615659713745}
			local sf=workspace:FindFirstChild("Env") and workspace.Env:FindFirstChild("Statues"); if not sf then return end
			local list={
				{statue=sf:FindFirstChild("Statue"),killIndex=1},
				{statue=sf:GetChildren()[2],killIndex=2},
				{statue=sf:GetChildren()[3],killIndex=3},
			}
			for _,entry in ipairs(list) do
				if not AD.enabled or AD.loopID~=loopID then break end
				if not statuesNeedKilling() then break end
				local statue=entry.statue; if not statue then continue end
				local hitbox=statue:FindFirstChild("hitbox"); if not hitbox then continue end
				local savedSpeed=getgenv().adTweenSpeed; getgenv().adTweenSpeed=70
				lockedPosition=nil; DoSafeTeleport(hitbox.Position)
				getgenv().adTweenSpeed=savedSpeed; lockedPosition=nil
				task.wait(0.3)
				local barrelHP=statue:FindFirstChild("barrelHP")
				while AD.enabled and AD.loopID==loopID and statuesNeedKilling() do
					if not barrelHP or barrelHP.Value<=0 then break end
					local rp=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart"); if not rp then break end
					if (rp.Position-hitbox.Position).Magnitude>5 then
						lockedPosition=nil; DoSafeTeleport(hitbox.Position); lockedPosition=nil; task.wait(0.1)
						rp=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart"); if not rp then break end
					end
					if not canAttack then task.wait(0.1) end
					canAttack=false; antiKBEnabled=true
					for combo=1,5 do
						if not AD.enabled or not barrelHP or barrelHP.Value<=0 then break end
						rp=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart"); if not rp then break end
						local sw=isBisento and BiSp[combo] or (isChakram and CkSp[combo] or (isCupidAxe and CAxSp[combo] or (isKatana and KatSp[combo] or (isKraken and 1.4583332538604736 or 1.75))))
						pcall(function()
							combatRegister:InvokeServer({[1]="swingsfx",[2]=wType,[3]=combo,[4]="Ground",[5]=false,[6]=anims[combo],[7]=sw,[8]=1.5})
							combatRegister:InvokeServer({[1]="damage",[2]={hitbox},[3]=wType,[4]={combo,"Ground",wType},[5]=true,[6]=rp.CFrame,aircombo="Ground"})
						end)
						task.wait(AD.comboDelayNPC)
					end
					task.wait(AD.fullComboWait); antiKBEnabled=false; canAttack=true
				end
			end
			getgenv().adStatuePhaseActive=false
		end

		-- ---- KILL ALL ----
		local function killAllNPCsAtPos(pos, radius)
			radius=radius or 120; local killed={}
			while AD.enabled do
				if getgenv().adStatuePhaseActive then lockedPosition=nil; break end
				local rp=_lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart"); if not rp then break end
				local allNPCs={}; local seen={}
				for _,d in ipairs(getAllNearbyNPCs(pos,radius)) do
					if not killed[d.npc] and not seen[d.npc] then seen[d.npc]=true; table.insert(allNPCs,d) end
				end
				for _,d in ipairs(getAllNearbyNPCs(rp.Position,radius)) do
					if not killed[d.npc] and not seen[d.npc] then seen[d.npc]=true; table.insert(allNPCs,d) end
				end
				if getgenv().adStatuePhaseActive or statuesNeedKilling() then
					lockedPosition=nil; getgenv().adStatuePhaseActive=true; break
				end
				if #allNPCs==0 then lockedPosition=nil; break end
				table.sort(allNPCs, function(a,b) return (rp.Position-a.hrp.Position).Magnitude<(rp.Position-b.hrp.Position).Magnitude end)
				local target=allNPCs[1]; local hrp=target.hrp
				if hrp then
					local tName=string.lower(target.npc.Name)
					local isCupidQueen=(tName=="cupid queen")
					if isCupidQueen then
						if hookedBossNPC~=target.npc then
							if hookedBossCleanup then hookedBossCleanup() end
							hookedBossCleanup=startBossHook(target.npc,CUPID_ANIMS); hookedBossNPC=target.npc
						end
					end
					local lockedY=hrp.Position.Y+AD.upHeight
					if getgenv().adSkipHit then
						if isCupidQueen then
							local ch=target.npc:FindFirstChild("Humanoid")
							if ch and ch.Health<=2500 then getgenv().adCupidPhase2Permanent=true end
							if getgenv().adCupidPhase2Permanent then
								cupidTrackTarget=target.npc; cupidTrackActive=true
							end
						else lockedPosition=nil end
						task.wait(0.05); continue
					end
					if isCupidQueen then
						local ch=target.npc:FindFirstChild("Humanoid")
						if ch and ch.Health<=2500 then getgenv().adCupidPhase2Permanent=true end
						cupidTrackTarget=target.npc; cupidTrackActive=true
					else
						local combatPos=Vector3.new(hrp.Position.X, lockedY, hrp.Position.Z)
						lockedPosition=nil
						if (rp.Position-combatPos).Magnitude>3 then DoSafeTeleport(combatPos) end
						lockedPosition=combatPos
					end
					if not isCupidQueen then task.wait(0.15) end
					attackNPC(target.npc)
					local humAfter=target.npc:FindFirstChild("Humanoid")
					if not humAfter or humAfter.Health<=0 then
						killed[target.npc]=true; AD.kills=AD.kills+1
					end
				end
				task.wait(0.05)
			end
		end

		-- ---- BOSS / CUPID ----
		local function fightBoss(loopID, bossName)
			AD.status="boss"; canAttack=true; getgenv().adSkipHit=false
			local searchStart=tick()
			while AD.enabled and AD.loopID==loopID do
				local boss=findBossGlobal(bossName)
				if not boss then
					if tick()-searchStart>30 then break end
					task.wait(1); continue
				end
				local bossHum=boss:FindFirstChild("Humanoid"); local bossHrp=boss:FindFirstChild("HumanoidRootPart")
				if not bossHum or bossHum.Health<=0 then break end
				killAllNPCsAtPos(bossHrp.Position,200); task.wait(0.05)
			end
		end

		local function fightCupidQueen(loopID)
			AD.status="boss"; canAttack=true
			getgenv().adSkipHit=false; getgenv().adCupidPhase2Permanent=false
			cupidTrackActive=false; cupidTrackTarget=nil
			if Toggles and Toggles.NoclipToggle then Toggles.NoclipToggle:SetValue(true) end
			local H2 = _G_Hub
			-- Keep animation playing throughout Cupid fight
			local _cupidAnimActive = true
			local _cupidAnimId = "rbxassetid://13630769186"
			task.spawn(function()
				while _cupidAnimActive and AD.enabled do
					pcall(function()
						local lp = game:GetService("Players").LocalPlayer
						local char = lp and lp.Character
						local hum = char and char:FindFirstChildWhichIsA("Humanoid")
						if not hum then return end
						local anim = Instance.new("Animation")
						anim.AnimationId = _cupidAnimId
						local track = hum:LoadAnimation(anim)
						track.Priority = Enum.AnimationPriority.Core
						track.Looped = true
						track:AdjustSpeed(1)
						track.TimePosition = 0.008333333767950535
						track:Play()
						anim:Destroy()
						task.wait(track.Length > 0 and track.Length or 1)
						track:Stop()
					end)
					task.wait(0.1)
				end
			end)
			local boss=nil
			while AD.enabled and AD.loopID==loopID do
				boss=findBossGlobal("Cupid Queen")
				if boss then local h=boss:FindFirstChild("Humanoid"); if h and h.Health>0 then break end end
				task.wait(0.5)
			end
			if not boss or not AD.enabled or AD.loopID~=loopID then return end
			if hookedBossNPC~=boss then
				if hookedBossCleanup then hookedBossCleanup() end
				hookedBossCleanup=startBossHook(boss,CUPID_ANIMS); hookedBossNPC=boss
			end
			cupidTrackTarget=boss; cupidTrackActive=true
			while AD.enabled and AD.loopID==loopID do
				if getgenv().adStatuePhaseActive or statuesNeedKilling() then
					getgenv().adStatuePhaseActive=false; cupidTrackActive=false; lockedPosition=nil
					killStatues(loopID)
					cupidTrackTarget=boss; cupidTrackActive=true; AD.status="boss"; continue
				end
				local bossHum=boss:FindFirstChild("Humanoid")
				if not bossHum or bossHum.Health<=0 then
					cupidTrackActive=false; cupidTrackTarget=nil; break
				end
				local bossHrp=boss:FindFirstChild("HumanoidRootPart"); if not bossHrp then break end
				killAllNPCsAtPos(bossHrp.Position,200); task.wait(0.05)
			end
			_cupidAnimActive = false
			if Toggles and Toggles.NoclipToggle then Toggles.NoclipToggle:SetValue(false) end
		end

