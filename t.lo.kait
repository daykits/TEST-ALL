		local function stopBlock()
			pcall(function() blockRemote:InvokeServer(false,"Melee",false) end)
		end

		local function startBossHook(bossModel, bossAnimsTable)
			local conns={}
			local function addConn(c) table.insert(conns,c) end
			local function cleanup()
				for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
				conns={}; stopBlock(); getgenv().adSkipHit=false
			end
			local humanoid = bossModel:FindFirstChildOfClass("Humanoid"); if not humanoid then return cleanup end
			local animator = humanoid:FindFirstChildOfClass("Animator");  if not animator  then return cleanup end
			local function onAnimPlayed(track)
				local rp     = _lp.Character and _lp.Character:FindFirstChild("HumanoidRootPart")
				local bossHrp= bossModel:FindFirstChild("HumanoidRootPart")
				if rp and bossHrp and (rp.Position-bossHrp.Position).Magnitude>200 then return end
				local animId = track.Animation and track.Animation.AnimationId
				if not animId then return end
				local reaction = bossAnimsTable[animId]; if not reaction then return end
				local act = reaction.action
				if act=="Block" then
					local wT = (AD.weapon=="Melee") and "Melee" or "Sword"
					pcall(function() blockRemote:InvokeServer(true,wT,true) end)
					getgenv().adSkipHit=true
					local released=false
					local function releaseBlock()
						if released then return end; released=true
						local p2=getgenv().adCupidPhase2Permanent
						task.wait(p2 and 0.05 or 0.15)
						pcall(function() blockRemote:InvokeServer(false,wT) end)
						getgenv().adSkipHit=false
					end
					addConn(track.Stopped:Connect(releaseBlock))
					task.delay(getgenv().adCupidPhase2Permanent and 1 or 3, releaseBlock)
				elseif act=="Pillar" then
					getgenv().adSkipHit=true
					if rp and bossHrp then
						local away=Vector3.new(rp.Position.X-bossHrp.Position.X,0,rp.Position.Z-bossHrp.Position.Z)
						if away.Magnitude>0 then away=away.Unit else away=Vector3.new(1,0,0) end
						local fleePos=rp.Position+away*AD.pillarFlee
						fleePos=Vector3.new(fleePos.X,bossHrp.Position.Y,fleePos.Z)
						task.spawn(function() lockedPosition=nil; DoSafeTeleport(fleePos); lockedPosition=fleePos end)
					end
					addConn(track.Stopped:Connect(function()
						task.wait(0.3); getgenv().adSkipHit=false; lockedPosition=nil
					end))
				elseif act=="PillarFixed" then
					getgenv().adSkipHit=true
					task.spawn(function()
						lockedPosition=nil
						DoSafeTeleport(Vector3.new(-1079.728,507.296,-3948.496))
						lockedPosition=Vector3.new(-1079.728,507.296,-3948.496)
						task.wait(3); getgenv().adSkipHit=false; lockedPosition=nil
					end)
				elseif act=="StatuePhase" then
					getgenv().adStatuePhaseActive=true
					task.delay(60, function() getgenv().adStatuePhaseActive=false end)
				end
			end
			addConn(animator.AnimationPlayed:Connect(onAnimPlayed))
			addConn(humanoid.Died:Connect(function() cleanup() end))
			return cleanup
		end

		-- Radar boss global
