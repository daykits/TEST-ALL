	_G_Hub.joinBattleRoyale = function()
		local H = _G_Hub
		local ok, err = pcall(function()
			local args = {
				"BattleRoyale"
			}
			game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("Queue"):InvokeServer(unpack(args))
		end)

