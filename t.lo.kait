	Tabs.ESP     = Window:AddTab('ESP')
	Tabs.Dungeon = Window:AddTab('Dungeon')
	Tabs.Sea2    = Window:AddTab('Farm')
	Tabs.Config  = Window:AddTab('Config')
end

