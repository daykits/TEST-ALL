-- Phím tắt dự phòng (1 = Aimbot, 2 = Target, 3 = Wallbang)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.One then
        isAiming = not isAiming
        UpdateAimbotUI()
    elseif input.KeyCode == Enum.KeyCode.Two then
        CONFIG.AimPart = (CONFIG.AimPart == "Head") and "Torso" or "Head"
        PartBtn.Text = "Target: " .. CONFIG.AimPart
    elseif input.KeyCode == Enum.KeyCode.Three then
        isWallbang = not isWallbang
        UpdateWallbangUI()
    end
end)

-- ==========================================
-- 3. AIMBOT + CAMERA FOLLOW
-- ==========================================
local function GetClosestTarget()
    local closestTarget = nil
    local shortestDistance = CONFIG.FOV
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local targetPart = character:FindFirstChild(CONFIG.AimPart)
            if not targetPart and CONFIG.AimPart == "Torso" then
                targetPart = character:FindFirstChild("HumanoidRootPart")
            end
            
            if humanoid and humanoid.Health > 0 and targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestTarget = targetPart
                    end
                end
            end
        end
    end
    return closestTarget
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 and isAiming then
        if CONFIG.LockCamera then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

RunService.RenderStepped:Connect(function()
    if not isAiming then return end
    currentTarget = GetClosestTarget()
    
    if currentTarget then
        local targetPos = currentTarget.Position
        local cameraPos = Camera.CFrame.Position
        local lookAtCFrame = CFrame.new(cameraPos, targetPos)
        
        if CONFIG.Smoothness > 0 then
            Camera.CFrame = Camera.CFrame:Lerp(lookAtCFrame, 1 - CONFIG.Smoothness)
        else
            Camera.CFrame = lookAtCFrame
        end
        
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local character = LocalPlayer.Character
            if character then
                local head = character:FindFirstChild("Head")
                if head then
                    local newCameraPos = head.Position + Vector3.new(0, CONFIG.CameraOffsetY, 0)
                    local finalCFrame = CFrame.new(newCameraPos, targetPos)
                    Camera.CFrame = Camera.CFrame:Lerp(finalCFrame, 0.3)
                end
            end
        end
    end
end)

-- ==========================================
-- 4. WALLBANG
-- ==========================================
local function CreateBeam(from, to)
    local beamPart = Instance.new("Part")
    beamPart.Anchored = true
    beamPart.CanCollide = false
    beamPart.CanQuery = false
    beamPart.CanTouch = false
    beamPart.Material = Enum.Material.Neon
    beamPart.Color = Color3.fromRGB(255, 50, 50)
    beamPart.Size = Vector3.new(0.1, 0.1, (from - to).Magnitude)
    beamPart.CFrame = CFrame.lookAt((from + to) / 2, to)
    beamPart.Parent = Workspace
    game:GetService("Debris"):AddItem(beamPart, 0.15)
end

local function FireWallbang(targetPart)
    local now = tick()
    if now - lastWallbangTime < CONFIG.WallbangCooldown then return end
    lastWallbangTime = now
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local originPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    local origin = originPart and originPart.Position or Camera.CFrame.Position
    local targetPos = targetPart.Position
    
    local distance = (targetPos - origin).Magnitude
    if distance > CONFIG.WallbangRange then return end
    
    local targetCharacter = targetPart.Parent
    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
    
    if targetHumanoid and targetHumanoid.Health > 0 then
        CreateBeam(origin, targetPos)
        pcall(function()
            targetHumanoid:TakeDamage(CONFIG.WallbangDamage)
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and isWallbang and isAiming then
        if currentTarget then
            FireWallbang(currentTarget)
        end
    end
end)

