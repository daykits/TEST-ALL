-- ==========================================
-- 2. AIMBOT + CAMERA FOLLOW (Giữ nguyên từ v1)
-- ==========================================
local function GetClosestTarget()
    local closestTarget = nil
    local shortestDistance = CONFIG.FOV
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local targetPart = character:FindFirstChild(CONFIG.AimPart)
            if not targetPart and CONFIG.AimPart == "Torso" then
                targetPart = character:FindFirstChild("HumanoidRootPart")
            end
            
            if humanoid and humanoid.Health > 0 and targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestTarget = targetPart
                    end
                end
            end
        end
    end
    return closestTarget
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 and isAiming then
        if CONFIG.LockCamera then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

RunService.RenderStepped:Connect(function()
    if not isAiming then return end
    currentTarget = GetClosestTarget()
    
    if currentTarget then
        local targetPos = currentTarget.Position
        local cameraPos = Camera.CFrame.Position
        local lookAtCFrame = CFrame.new(cameraPos, targetPos)
        
        if CONFIG.Smoothness > 0 then
            Camera.CFrame = Camera.CFrame:Lerp(lookAtCFrame, 1 - CONFIG.Smoothness)
        else
            Camera.CFrame = lookAtCFrame
        end
        
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local character = LocalPlayer.Character
            if character then
                local head = character:FindFirstChild("Head")
                if head then
                    local newCameraPos = head.Position + Vector3.new(0, CONFIG.CameraOffsetY, 0)
                    local finalCFrame = CFrame.new(newCameraPos, targetPos)
                    Camera.CFrame = Camera.CFrame:Lerp(finalCFrame, 0.3)
                end
            end
        end
    end
end)

-- ==========================================
-- 3. CHỨC NĂNG WALLBANG
-- ==========================================
-- Ý tưởng: Khi bật Wallbang và bấm chuột trái, script sẽ:
-- 1. Lấy vị trí camera hiện tại (hoặc vị trí súng của nhân vật).
-- 2. Raycast từ camera đến mục tiêu (currentTarget), BỎ QUA các part là tường/chướng ngại.
-- 3. Nếu trúng mục tiêu (hoặc part của đối thủ), gây sát thương trực tiếp lên Humanoid của đối thủ.
-- 4. Vẽ hiệu ứng tia đạn (beam) để trực quan.
--
-- Lưu ý: Cách này hoạt động độc lập với súng thật của game (nếu game dùng server-side raycast).
-- Nó chỉ hiệu quả trong các game cho phép client-side damage hoặc game custom không có anti-cheat.
-- Với game có anti-cheat mạnh (như Arsenal, Phantom Forces), cách này sẽ bị chặn hoặc không gây damage.

local function CreateBeam(from, to)
    local beamPart = Instance.new("Part")
    beamPart.Anchored = true
    beamPart.CanCollide = false
    beamPart.CanQuery = false
    beamPart.CanTouch = false
    beamPart.Material = Enum.Material.Neon
    beamPart.Color = Color3.fromRGB(255, 50, 50)
    beamPart.Size = Vector3.new(0.1, 0.1, (from - to).Magnitude)
    beamPart.CFrame = CFrame.lookAt((from + to) / 2, to)
    beamPart.Parent = Workspace
    
    -- Tự hủy sau 0.15s
    game:GetService("Debris"):AddItem(beamPart, 0.15)
end

local function FireWallbang(targetPart)
    local now = tick()
    if now - lastWallbangTime < CONFIG.WallbangCooldown then return end
    lastWallbangTime = now
    
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Lấy vị trí bắn: ưu tiên Head của mình, nếu không có thì dùng Camera
    local originPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    local origin = originPart and originPart.Position or Camera.CFrame.Position
    local targetPos = targetPart.Position
    
    -- Raycast xuyên tường: dùng RaycastParams lọc bỏ tường
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local excludeList = {}
    
    -- Bỏ qua tất cả part của chính mình
    if CONFIG.IgnoreLocalParts and character then
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") then table.insert(excludeList, v) end
        end
    end
    
    -- Bỏ qua mục tiêu (để raycast không dừng ở mục tiêu trước khi xuyên tường)
    -- Thực chất ta muốn raycast XUYÊN qua mọi thứ để đến mục tiêu,
    -- nên ta sẽ dùng Raycast trực tiếp đến vị trí mục tiêu, bỏ qua tường.
    raycastParams.FilterDescendantsInstances = excludeList
    
    -- Hướng bắn
    local direction = (targetPos - origin)
    local distance = direction.Magnitude
    if distance > CONFIG.WallbangRange then return end
    direction = direction.Unit * distance
    
    -- Raycast "xuyên thấu": ta không dùng Raycast để chặn, mà trực tiếp kiểm tra
    -- xem có part nào của đối thủ nằm trên đường đạn không (dùng WorldToScreenPoint hoặc kiểm tra vị trí).
    -- Đơn giản nhất: vì ta đã có targetPart, chỉ cần kiểm tra khoảng cách và gây damage.
    
    -- Tìm Humanoid của đối thủ từ targetPart
    local targetCharacter = targetPart.Parent
    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
    
    if targetHumanoid and targetHumanoid.Health > 0 then
        -- Vẽ beam xuyên tường
        CreateBeam(origin, targetPos)
        
        -- Gây sát thương (client-side, chỉ hoạt động nếu game cho phép)
        -- Cách 1: Gọi trực tiếp (chỉ có tác dụng nếu game không có anti-cheat server-side)
        pcall(function()
            targetHumanoid:TakeDamage(CONFIG.WallbangDamage)
        end)
        
        -- Cách 2: Nếu game có RemoteEvent damage, bạn cần tìm và fire nó.
        -- Ví dụ (không chắc chắn hoạt động với mọi game):
        -- local damageRemote = game:GetService("ReplicatedStorage"):FindFirstChild("DamageEvent")
        -- if damageRemote then damageRemote:FireServer(targetHumanoid, CONFIG.WallbangDamage) end
        
        -- Cách 3: Nếu game dùng tool/súng, ta có thể fire tool.
        -- Nhưng cách này phức tạp và phụ thuộc game cụ thể.
    end
end

-- Lắng nghe chuột trái để bắn wallbang
UserInputService.InputBegan:Connect(function(input, gameProcessed)
